-- THE ARCHIMEDEAN PROPERTY of ℚ: every positive rational dominates
-- one of the unit fractions 1/(k+1). Normalize the denominator to be
-- positive, read the numerator's sign off intNonZero's decision, and
-- the index is the denominator's own magnitude — (a+1)/(b+1) is at
-- least 1/(b+1) because the difference is ((b+1)·a)/(b+1)², whose
-- numerator is a NAT.
--
-- The index is SQUASHED: it depends on the representative (½ and 2/4
-- name 2 and 4), so a bare Σ would owe a well-definedness proof it
-- cannot have. The squash costs nothing downstream, because the fact
-- it is used to prove — leQOfArch — lands in a DECIDABLE type, and a
-- decidable goal can be reached from ⊥ (leQOfFalse).
--
-- leQOfArch is the closeness principle the constructive reals run on:
-- "a ≤ b + 1/(k+1) for every k" collapses to "a ≤ b".
-- ===== fractions with a natural numerator =====

import nat (+, *, multZeroId, plusZeroId, zeroPlusId, sucPlus, multComm, zeroMult, multSucId)
import integer (Int, intZero, intOne, intNeg)
import integerAdd (+)
import integerMul (*, intMulZeroL, intMulNegL, intMulNegR, intNegNeg)
import intOrder (intOfNat, intOfNatMul)
import intNonZero (nzOfInt)
import rational (NZ, nzPos, nzNeg, nzToInt, nzMul, Rat, mkRat, num, den, denInt, ratNeg, ratEta, intScale)
import rationalQ (Q, qcls, +, qNeg, qZero, RatR, clsEqOfRel, nzToIntMul, dInt, qAddAssoc, qAddComm, qAddZeroR, qAddNegR, qAddNegL)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, ratSgn, intSgn, intSgnZero, intSgnPos, intSgnNeg, NonNegS, ≤, sgnQCls, sgnQZero, sgnCases, sgnQNegFlip, qSubNeg, leQTrans, leQAntisym, sZeroNotPos, sZeroNotNeg, sNegNotPos, leQPlusMono, leQPlusMonoL, qNegAdd, qPairSwap)
import ratBound (Bnd, qSubFlip, leQSelfAdd, nonNegNotNeg)
import ratHalf (dbl, qInvHalf, leQInvDbl, leQZeroInvNat)
import real (qInvNat, qInvNatPos)
import prop (⊥, absurdP)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

def qFrac : ℕ → ℕ → El Q using (rationalQ.Q.unfold) ≔ λa. λb. qcls (mkRat (intOfNat a) (nzPos b))

-- 1/(b+1) is 1/(b+1) — the two spellings coincide on the nose
def qFracOne : (b : ℕ) → qFrac (S Z) b ≡ qInvNat b
  using (intOrder.intOfNat.eq,
    integer.intOne.eq,
    ratArch.qFrac.eq,
    rational.mkRat.eq,
    rational.nzPos.eq,
    rationalQ.Q.unfold,
    rationalQ.qcls.eq,
    real.qInvNat.eq) ≔
  λb. ⋆

-- the sign of a natural is never negative
def intSgnOfNatNonNeg : {k : ℕ} → El (NonNegS (intSgn (intOfNat k)))
  using (intOrder.intOfNatZero,
    integer.Int.unfold,
    ratHalf.nzPosInt,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.unfold) ≔
  λk. ℕ-elim
    (inj₁ (eqToId (intSgn (intOfNat Z)) sZero intSgnZero))
    (j ih. inj₂ (eqToId (intSgn (intOfNat (S j))) sPos (intSgnPos j)))
    k

-- ...so a fraction with a natural numerator over a positive
-- denominator is never negative: its sign is that of the natural a·(b+1)
def sgnQFrac : (a b : ℕ) → sgnQ (qFrac a b) ≡ intSgn (intOfNat (a * S b))
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    intOrder.intOfNat.eq,
    integer.Int.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerMul.*.eq,
    integerNormalize.normPair.eq,
    ratArch.qFrac.eq,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qcls.eq) ≔
  λa. λb. cong
    Int
    (λv. Sign)
    (λv. intSgn v)
    (intOfNat a * intOfNat (S b))
    (intOfNat (a * S b))
    (intOfNatMul a (S b))

def nonNegSgnFrac : {a b : ℕ} → El (NonNegS (sgnQ (qFrac a b)))
  using (rationalOrder.NonNegS.unfold) ≔
  λa. λb. transport
    Sign
    NonNegS
    (intSgn (intOfNat (a * S b)))
    (sgnQ (qFrac a b))
    (sym Sign (sgnQ (qFrac a b)) (intSgn (intOfNat (a * S b))) (sgnQFrac a b))
    intSgnOfNatNonNeg

-- ===== 1/(b+1) ≤ (a+1)/(b+1) =====
-- the difference is ((b+1)·a) / (b+1)²: the denominators are literally
-- equal (nzMul computes), so only the numerators have to be matched
def fracNumEq : {a b : ℕ}
  → intScale (nzPos b) (intOfNat (S a)) + intScale (nzPos b) (intNeg intOne) ≡ intOfNat (S b * a)
  using (multZeroId.rw,
    zeroPlusId.rw,
    plusZeroId.rw,
    multSucId.rw,
    integer.Int.eq,
    integer.IntR.eq,
    integer.intNeg.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    intOrder.intOfNat.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.nzPos.eq) ≔
  λa. λb. ⋆

def qDiffFracInv : (a b : ℕ) → qFrac (S a) b + qNeg (qInvNat b) ≡ qFrac (S b * a) (b * b + b + b)
  using (intOrder.intOfNat.eq,
    integer.intNeg.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    ratArch.qFrac.eq,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qcls.eq,
    real.qInvNat.eq) ≔
  λa. λb. cong
    Int
    (λv. Q)
    (λv. qcls (mkRat v (nzPos (b * b + b + b))))
    (intScale (nzPos b) (intOfNat (S a)) + intScale (nzPos b) (intNeg intOne))
    (intOfNat (S b * a))
    fracNumEq

def leQInvFrac : {a b : ℕ} → El (qInvNat b ≤ qFrac (S a) b)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. transport
    Q
    (λw. NonNegS (sgnQ w))
    (qFrac (S b * a) (b * b + b + b))
    (qFrac (S a) b + qNeg (qInvNat b))
    (sym Q (qFrac (S a) b + qNeg (qInvNat b)) (qFrac (S b * a) (b * b + b + b)) (qDiffFracInv a b))
    nonNegSgnFrac

-- ===== normalizing the denominator's sign =====
-- the cross-multiplication behind qNegDen, in folded vocabulary
def negDenCross : (N : El Int)
  (b : ℕ)
  → intNeg N * intNeg (nzToInt (nzPos b)) ≡ N * nzToInt (nzPos b)
  using (integer.Int.unfold) ≔
  λN. λb. intNeg N * intNeg (nzToInt (nzPos b))
      ≡⟨ intMulNegL N (intNeg (nzToInt (nzPos b))) ⟩ intNeg (N * intNeg (nzToInt (nzPos b)))
      ≡⟨ cong
        Int
        (λv. Int)
        (λv. intNeg v)
        (N * intNeg (nzToInt (nzPos b)))
        (intNeg (N * nzToInt (nzPos b)))
        (intMulNegR N (nzToInt (nzPos b))) ⟩ intNeg (intNeg (N * nzToInt (nzPos b)))
      ≡⟨ intNegNeg (N * nzToInt (nzPos b)) ⟩ N * nzToInt (nzPos b)

-- N/(−(b+1)) and (−N)/(b+1) are the same rational
def qNegDen : (N : El Int) (b : ℕ) → qcls (mkRat (intNeg N) (nzPos b)) ≡ qcls (mkRat N (nzNeg b))
  using (integer.Int.unfold,
    integer.intNeg.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.qcls.eq) ≔
  λN. λb. clsEqOfRel (mkRat (intNeg N) (nzPos b)) (mkRat N (nzNeg b)) (negDenCross N b)

-- every rational has a representative with a POSITIVE denominator
def PosDenView : El Q → 𝕌 ≔ λu. (M : Int) (b : ℕ) ⨯ Id Q (qcls (mkRat M (nzPos b))) u

def qPosDenView : (N : El Int) (d : El NZ) → El (PosDenView (qcls (mkRat N d)))
  using (id.Id.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    ratArch.PosDenView.unfold,
    rational.NZ.unfold,
    rational.mkRat.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rationalQ.Q.eq,
    rationalQ.qcls.eq) ≔
  λN. λd. ⊎-elim
    (b. N, b, eqToId (qcls (mkRat N (nzPos b))) (qcls (mkRat N (nzPos b))) ⋆)
    (b. intNeg
      N, b, eqToId (qcls (mkRat (intNeg N) (nzPos b))) (qcls (mkRat N (nzNeg b))) (qNegDen N b))
    d

-- ===== the sign of a fraction with a decided numerator =====
-- a negative numerator over a positive denominator is negative
def sgnNegOverPos : {a b : ℕ} → sgnQ (qcls (mkRat (nzToInt (nzNeg a)) (nzPos b))) ≡ sNeg
  using (eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    integerMul.*.eq,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qcls.eq) ≔
  λa. λb. trans
    Sign
    (intSgn (nzToInt (nzNeg a) * nzToInt (nzPos b)))
    (intSgn (nzToInt (nzMul (nzNeg a) (nzPos b))))
    sNeg
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (nzToInt (nzNeg a) * nzToInt (nzPos b))
      (nzToInt (nzMul (nzNeg a) (nzPos b)))
      (sym
        Int
        (nzToInt (nzMul (nzNeg a) (nzPos b)))
        (nzToInt (nzNeg a) * nzToInt (nzPos b))
        (nzToIntMul (nzNeg a) (nzPos b))))
    intSgnNeg

-- a zero numerator makes the fraction zero
def sgnZeroOverPos : {b : ℕ} → sgnQ (qcls (mkRat intZero (nzPos b))) ≡ sZero
  using (eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    integer.intZero.eq,
    integerMul.*.eq,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qcls.eq) ≔
  λb. trans
    Sign
    (intSgn (intZero * nzToInt (nzPos b)))
    (intSgn intZero)
    sZero
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (intZero * nzToInt (nzPos b))
      intZero
      (intMulZeroL (nzToInt (nzPos b))))
    intSgnZero

-- ===== the theorem =====
def ArchWit : El Q → 𝕌 ≔ λu. (k : ℕ) ⨯ qInvNat k ≤ u

-- with a positive denominator fixed, decide the numerator: positive
-- gives the index, zero and negative contradict positivity
def qArchPos : {M : El Int}
  {b : ℕ}
  → (sgnQ (qcls (mkRat M (nzPos b))) ≡ sPos) → El (ArchWit (qcls (mkRat M (nzPos b))))
  using (intOrder.intOfNat.eq,
    integer.Int.unfold,
    ratArch.ArchWit.unfold,
    ratArch.qFrac.eq,
    rational.NZ.unfold,
    rational.mkRat.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.qcls.eq) ≔
  λM. λb. λhp. ⊎-elim
    (u. (⊎-elim (w. Prf (nzToInt w ≡ M) → El (ArchWit (qcls (mkRat M (nzPos b)))))
      (a. λhe. b,
        transport
          Q
          (λv. qInvNat b ≤ v)
          (qFrac (S a) b)
          (qcls (mkRat M (nzPos b)))
          (cong Int (λv. Q) (λv. qcls (mkRat v (nzPos b))) (nzToInt (nzPos a)) M he)
          leQInvFrac)
      (a. λhe. 𝟘-elim (sNegNotPos
        (trans
          Sign
          sNeg
          (sgnQ (qcls (mkRat M (nzPos b))))
          sPos
          (sym
            Sign
            (sgnQ (qcls (mkRat M (nzPos b))))
            sNeg
            (trans
              Sign
              (sgnQ (qcls (mkRat M (nzPos b))))
              (sgnQ (qcls (mkRat (nzToInt (nzNeg a)) (nzPos b))))
              sNeg
              (cong
                Int
                (λv. Sign)
                (λv. sgnQ (qcls (mkRat v (nzPos b))))
                M
                (nzToInt (nzNeg a))
                (sym Int (nzToInt (nzNeg a)) M he))
              sgnNegOverPos))
          hp)))
      (u .π₁))
      (u .π₂))
    (hz. 𝟘-elim (sZeroNotPos
      (trans
        Sign
        sZero
        (sgnQ (qcls (mkRat M (nzPos b))))
        sPos
        (sym
          Sign
          (sgnQ (qcls (mkRat M (nzPos b))))
          sZero
          (trans
            Sign
            (sgnQ (qcls (mkRat M (nzPos b))))
            (sgnQ (qcls (mkRat intZero (nzPos b))))
            sZero
            (cong Int (λv. Sign) (λv. sgnQ (qcls (mkRat v (nzPos b)))) M intZero hz)
            sgnZeroOverPos))
        hp)))
    (nzOfInt M)

-- at a raw fraction: normalize the denominator, then decide
def qArchAt : (N : El Int)
  (d : El NZ)
  → (sgnQ (qcls (mkRat N d)) ≡ sPos) → El (ArchWit (qcls (mkRat N d)))
  using (ratArch.ArchWit.unfold, ratArch.PosDenView.unfold) ≔
  λN. λd. λhp. let v ≔ qPosDenView
    N
    d in let e : qcls
    (mkRat
      (v .π₁)
      (nzPos
        (v .π₂ .π₁))) ≡ qcls
    (mkRat
      N
      d) ≔ idToEq
    Q
    (qcls (mkRat (v .π₁) (nzPos (v .π₂ .π₁))))
    (qcls (mkRat N d))
    (v .π₂ .π₂) in transport
    Q
    ArchWit
    (qcls (mkRat (v .π₁) (nzPos (v .π₂ .π₁))))
    (qcls (mkRat N d))
    e
    (qArchPos
      (trans
        Sign
        (sgnQ (qcls (mkRat (v .π₁) (nzPos (v .π₂ .π₁)))))
        (sgnQ (qcls (mkRat N d)))
        sPos
        (cong
          Q
          (λw. Sign)
          (λw. sgnQ w)
          (qcls (mkRat (v .π₁) (nzPos (v .π₂ .π₁))))
          (qcls (mkRat N d))
          e)
        hp))

-- every positive rational dominates a unit fraction. The witness is
-- squashed: a bare Σ would ask the class to determine the index
def qArch : (u : El Q) → (sgnQ u ≡ sPos) → Prf ∥El (ArchWit u)∥
  using (id.Id.eq,
    integer.Int.unfold,
    ratArch.ArchWit.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qcls.eq,
    real.qInvNat.eq) ≔
  λu. quot-elim
    (p. λhp. ⋆ (transport
      Rat
      (λr. ArchWit (qcls r))
      (mkRat (num p) (den p))
      p
      ratEta
      (qArchAt
        (num p)
        (den p)
        (trans
          Sign
          (sgnQ (qcls (mkRat (num p) (den p))))
          (sgnQ (qcls p))
          sPos
          (cong Rat (λr. Sign) (λr. sgnQ (qcls r)) (mkRat (num p) (den p)) p ratEta)
          hp))))
    u

-- ===== the closeness principle =====
-- a decidable goal is reachable from ⊥ : an order fact is a SIGN
-- verdict, and ⊥ proves the equation that verdict needs
def leQOfFalse : {x y : El Q} → Prf ⊥ → El (x ≤ y)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λx. λy. λf. inj₁ (eqToId (sgnQ (y + qNeg x)) sZero (absurdP (sgnQ (y + qNeg x) ≡ sZero) f))

-- the difference's sign flips with the difference (leQTotal's core,
-- named)
def sgnQSubFlip : {x y : El Q} → sgnQ (x + qNeg y) ≡ sgnFlip (sgnQ (y + qNeg x)) ≔
  λx. λy. trans
    Sign
    (sgnQ (x + qNeg y))
    (sgnQ (qNeg (y + qNeg x)))
    (sgnFlip (sgnQ (y + qNeg x)))
    (cong Q (λw. Sign) (λw. sgnQ w) (x + qNeg y) (qNeg (y + qNeg x)) qSubNeg)
    sgnQNegFlip

-- (b + q) − a ≡ q − (a − b): moving a subtraction across the ≤
def qShiftEq : (a b q : El Q) → b + q + qNeg a ≡ q + qNeg (a + qNeg b) using (rationalQ.Q.unfold) ≔
  λa. λb. λq. b + q + qNeg a
      ≡⟨ cong Q (λw. Q) (λw. w + qNeg a) (b + q) (q + b) (qAddComm b q) ⟩ q + b + qNeg a
      ≡⟨ qAddAssoc q b (qNeg a) ⟩ q + (b + qNeg a)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. q + w)
        (b + qNeg a)
        (qNeg (a + qNeg b))
        (sym Q (qNeg (a + qNeg b)) (b + qNeg a) (qSubFlip a b)) ⟩ q + qNeg (a + qNeg b)

def leQSubShift : (a b : El Q) {q : El Q} → El (a ≤ b + q) → El (a + qNeg b ≤ q)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λa. λb. λq. transport
    Q
    (λw. NonNegS (sgnQ w))
    (b + q + qNeg a)
    (q + qNeg (a + qNeg b))
    (qShiftEq a b q)

-- h + h ≡ h forces h ≡ 0
def qAddSelfCancel : (h : El Q) → (h + h ≡ h) → h ≡ qZero ≔
  λh. λe. trans
    Q
    h
    (h + h + qNeg h)
    qZero
    (sym
      Q
      (h + h + qNeg h)
      h
      (trans
        Q
        (h + h + qNeg h)
        (h + (h + qNeg h))
        h
        (qAddAssoc h h (qNeg h))
        (trans
          Q
          (h + (h + qNeg h))
          (h + qZero)
          h
          (cong Q (λw. Q) (λw. h + w) (h + qNeg h) qZero (qAddNegR h))
          (qAddZeroR h))))
    (trans
      Q
      (h + h + qNeg h)
      (h + qNeg h)
      qZero
      (cong Q (λw. Q) (λw. w + qNeg h) (h + h) h e)
      (qAddNegR h))

-- no unit fraction is zero
def qInvNatNotZero : (k : ℕ) → (qInvNat k ≡ qZero) → 𝟘 ≔
  λk. λe. sZeroNotPos
    (trans
      Sign
      sZero
      (sgnQ (qInvNat k))
      sPos
      (sym
        Sign
        (sgnQ (qInvNat k))
        sZero
        (trans
          Sign
          (sgnQ (qInvNat k))
          (sgnQ qZero)
          sZero
          (cong Q (λw. Sign) (λw. sgnQ w) (qInvNat k) qZero e)
          sgnQZero))
      (qInvNatPos k))

-- a < b would give an index k with 1/(k+1) ≤ a − b ≤ 1/(2k+2), and
-- those two unit fractions are equal only if the smaller is zero
def archContra : (a b : El Q)
  → ((k : ℕ) → El (a ≤ b + qInvNat k)) → El (Id Sign (sgnQ (b + qNeg a)) sNeg) → Prf ⊥
  using (equality.cong.eq,
    equality.trans.eq,
    hyp.rw,
    id.Id.eq,
    id.Id.unfold,
    id.idToEq.eq,
    prop.⊥.unfold,
    ratArch.ArchWit.unfold,
    rationalOrder.≤.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnFlip.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.qInvNat.eq,
    sgnQSubFlip.eq) ≔
  λa. λb. λhyp. λhneg. let hpos : sgnQ
    (a
      + qNeg
        b) ≡ sPos ≔ trans
    Sign
    (sgnQ (a + qNeg b))
    (sgnFlip (sgnQ (b + qNeg a)))
    sPos
    sgnQSubFlip
    (trans
      Sign
      (sgnFlip (sgnQ (b + qNeg a)))
      (sgnFlip sNeg)
      sPos
      (cong
        Sign
        (λw. Sign)
        (λw. sgnFlip w)
        (sgnQ (b + qNeg a))
        sNeg
        (idToEq Sign (sgnQ (b + qNeg a)) sNeg hneg))
      ⋆) in squash-elim (qArch
    (a + qNeg b)
    hpos) (w. let hup : qInvNat
    (w .π₁) ≡ qInvNat
    (dbl
      (w .π₁)) ≔ leQAntisym
    (leQTrans
      (qInvNat (w .π₁))
      (a + qNeg b)
      (qInvNat (dbl (w .π₁)))
      (w .π₂)
      (leQSubShift a b (hyp (dbl (w .π₁)))))
    (leQInvDbl
      (w .π₁)) in ⋆ (qInvNatNotZero
    (dbl (w .π₁))
    (qAddSelfCancel
      (qInvNat (dbl (w .π₁)))
      (trans
        Q
        (qInvNat (dbl (w .π₁)) + qInvNat (dbl (w .π₁)))
        (qInvNat (w .π₁))
        (qInvNat (dbl (w .π₁)))
        (qInvHalf (w .π₁))
        hup))))

-- ...so "a ≤ b + 1/(k+1) for every k" collapses to "a ≤ b"
def leQOfArch : (a b : El Q) → ((k : ℕ) → El (a ≤ b + qInvNat k)) → El (a ≤ b)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λa. λb. λhyp. ⊎-elim
    (nn. nn)
    (hneg. leQOfFalse (archContra a b hyp hneg))
    (sgnCases (sgnQ (b + qNeg a)))

-- ===== closeness, in Bnd form =====
-- −(b + h) + h ≡ −b : the ε moves back out of a negated bound
def qNegAddCancel : {b h : El Q} → qNeg (b + h) + h ≡ qNeg b using (rationalQ.Q.unfold) ≔
  λb. λh. qNeg (b + h) + h
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w + h)
        (qNeg (b + h))
        (qNeg b + qNeg h)
        (qNegAdd b h) ⟩ qNeg b + qNeg h + h
      ≡⟨ qAddAssoc (qNeg b) (qNeg h) h ⟩ qNeg b + (qNeg h + h)
      ≡⟨ cong Q (λw. Q) (λw. qNeg b + w) (qNeg h + h) qZero (qAddNegL h) ⟩ qNeg b + qZero
      ≡⟨ qAddZeroR (qNeg b) ⟩ qNeg b

-- a bound that holds with EVERY slack 1/(k+1) holds without slack.
-- Both halves are leQOfArch; the lower one first moves the ε across
-- the negation
def bndOfArch : {b : El Q} (d : El Q) → ((k : ℕ) → El (Bnd (b + qInvNat k) d)) → El (Bnd b d)
  using (ratBound.Bnd.unfold) ≔
  λb. λd. λh. leQOfArch
    (qNeg b)
    d
    (λk. transport
      Q
      (λw. w ≤ d + qInvNat k)
      (qNeg (b + qInvNat k) + qInvNat k)
      (qNeg b)
      qNegAddCancel
      (leQPlusMono (qInvNat k) (h k .π₁))), leQOfArch d b (λk. h k .π₂)

-- ===== the four-leg sum a triangle chain produces =====
-- ((a+b) + y) + (b+a) ≡ (a+a) + ((b+b) + y): the two outer indices
-- collect, the two inner ones collect, and the middle stays put
def qFourSum : (a b y : El Q) → a + b + y + (b + a) ≡ a + a + (b + b + y)
  using (rationalQ.Q.unfold) ≔
  λa. λb. λy. a + b + y + (b + a)
      ≡⟨ qAddAssoc (a + b) y (b + a) ⟩ a + b + (y + (b + a))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. a + b + w)
        (y + (b + a))
        (b + a + y)
        (qAddComm y (b + a)) ⟩ a + b + (b + a + y)
      ≡⟨ sym
        Q
        (a + b + (b + a) + y)
        (a + b + (b + a + y))
        (qAddAssoc (a + b) (b + a) y) ⟩ a + b + (b + a) + y
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w + y)
        (a + b + (b + a))
        (a + a + (b + b))
        (trans
          Q
          (a + b + (b + a))
          (a + b + (a + b))
          (a + a + (b + b))
          (cong Q (λw. Q) (λw. a + b + w) (b + a) (a + b) (qAddComm b a))
          (qPairSwap a b a b)) ⟩ a + a + (b + b) + y
      ≡⟨ qAddAssoc (a + a) (b + b) y ⟩ a + a + (b + b + y)

-- three copies sit under four
def leQTripleQuad : {h : El Q} → El (qZero ≤ h) → El (h + (h + h) ≤ h + h + (h + h))
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λh. λnn. transport
    Q
    (λw. w ≤ h + h + (h + h))
    (h + h + h)
    (h + (h + h))
    (qAddAssoc h h h)
    (leQPlusMonoL h (h + h) (h + h) (leQSelfAdd h nn))

-- ...so three quarter-fractions fit inside one: 3/(4k+4) ≤ 1/(k+1)
def leQTripleInv : (k : ℕ)
  → El (qInvNat (dbl (dbl k)) + (qInvNat (dbl (dbl k)) + qInvNat (dbl (dbl k))) ≤ qInvNat k)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λk. transport
    Q
    (λw. qInvNat (dbl (dbl k)) + (qInvNat (dbl (dbl k)) + qInvNat (dbl (dbl k))) ≤ w)
    (qInvNat
      (dbl (dbl k)) + qInvNat (dbl (dbl k)) + (qInvNat (dbl (dbl k)) + qInvNat (dbl (dbl k))))
    (qInvNat k)
    (trans
      Q
      (qInvNat
        (dbl (dbl k)) + qInvNat (dbl (dbl k)) + (qInvNat (dbl (dbl k)) + qInvNat (dbl (dbl k))))
      (qInvNat (dbl k) + qInvNat (dbl k))
      (qInvNat k)
      (cong
        Q
        (λw. Q)
        (λw. w + w)
        (qInvNat (dbl (dbl k)) + qInvNat (dbl (dbl k)))
        (qInvNat (dbl k))
        (qInvHalf (dbl k)))
      (qInvHalf k))
    (leQTripleQuad (leQZeroInvNat (dbl (dbl k))))

-- the converse of leQSubShift: a bound on the difference is a shifted ≤
def leQAddShift : (a : El Q) {b q : El Q} → El (a + qNeg b ≤ q) → El (a ≤ b + q)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λa. λb. λq. transport
    Q
    (λw. NonNegS (sgnQ w))
    (q + qNeg (a + qNeg b))
    (b + q + qNeg a)
    (sym Q (b + q + qNeg a) (q + qNeg (a + qNeg b)) (qShiftEq a b q))

-- ===== ≤ is decidable, so its squash is faithful =====
--
-- A `quot-elim` landing in `El (LeQ x y)` owes a well-definedness
-- proof between two order verdicts, and no `using` candidate can
-- supply it: a subsingleton lemma's type-index is not determined by
-- the two sides, so matching leaves it unsolved (E-1). Landing in the
-- SQUASH instead makes the descent free — proof irrelevance closes it
-- — and this recovers the datum, by deciding and refuting.
def leQUnsquash : (x : El Q) {y : El Q} → Prf ∥El (x ≤ y)∥ → El (x ≤ y)
  using (id.Id.unfold,
    prop.⊥.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold) ≔
  λx. λy. λh. ⊎-elim
    (nn. nn)
    (hneg. leQOfFalse (squash-elim h (le. ⋆ (nonNegNotNeg (sgnQ (y + qNeg x)) le hneg))))
    (sgnCases (sgnQ (y + qNeg x)))
