import nat (+, zeroPlusId, sucPlus)
import integer (Int, IntR, intZero, intOne)
import integerNormalize (normPair, normSound, intNormalize)
import equality (sym, trans, cong)

import prop (↔, iffIntro, ∧, ¬, ⊥, andIntro, andFst, andSnd, impIntro, impApply)
import eqNat (EqN, eqNRefl, eqNSound, eqNComplete, predEq)

-- Observational equality of Int, and its logical equivalence with the
-- built-in ≡ ∈ El Int. Int is a quotient (ℕ ⨯ ℕ) / IntR, so its OWN
-- defining relation is already the natural "observational" candidate —
-- but lifting IntR to El Int × El Int directly (via a double quot-elim
-- landing in Ω) needs its well-definedness proved as an Ω-code
-- equality, i.e. propositional extensionality between two DIFFERENT
-- IntR-applications, and this elaborator's propext check only
-- discharges the evident (𝟙-/reflexive-≡-shaped) cases automatically —
-- it does not search for the mutual-implication witnesses even when
-- they're sitting in context (see the prop.nova-only bonus attempt in
-- the sibling eqNat.nova). So EqI instead compares CANONICAL
-- representatives (integerNormalize.nova's intNormalize), squashing an
-- ordinary EQUATION rather than an Ω-code — equations are
-- proof-irrelevant (every ≡-proof is ⋆ on the nose), so THIS
-- well-definedness is free.

-- IntR is Int's own quotient relation (integer.nova); a proof of it
-- gives equal classes directly (el-quot-eq, automatic given a term of
-- Prf (IntR p q) in context — no extra machinery needed).
def classEqOfRel : (p : ℕ ⨯ ℕ) (q : ℕ ⨯ ℕ) → Prf (IntR p q) → class p ≡ class q ∈ El Int ≔
  λp. λq. λh. ⋆

-- normPair's own representative is IntR-related to its input (that's
-- normSound), so its class is the same Int
def classNormPairEq : (p : ℕ ⨯ ℕ) → class (normPair (p .π₁) (p .π₂)) ≡ class p ∈ El Int using (integerNormalize.normClass, normSound) ≔
  λp. classEqOfRel (normPair (p .π₁) (p .π₂)) p (normSound (p .π₁) (p .π₂))

-- normalization doesn't change the value: intNormalize z is z. The
-- quot-elim's well-definedness goal here is an EQUATION (not an Ω
-- code), so it's discharged for free by proof irrelevance regardless
-- of how the representative varies.
def intNormalizeId : (z : El Int) → intNormalize z ≡ z ∈ El Int using (classNormPairEq, integerNormalize.normClass) ≔
  λz. quot-elim (w. intNormalize w ≡ w ∈ El Int) (p. classNormPairEq p) z

-- a squashed equality at any 𝕌-code reflects into a judgemental one —
-- prop.nova's reflectSquash generalized (that one is hardcoded to ℕ);
-- Int being a genuine 𝕌-code term (not a `type` item) is what makes
-- this reusable, generic combinator applicable to it at all
def reflectSquashAt : (A : 𝕌) (a : El A) (b : El A) (h : Prf (a ≡ b ∈ El A)) → a ≡ b ∈ El A ≔
  λA. λa. λb. λh. ⋆

def EqI : El Int → El Int → Ω ≔ λz1. λz2. (intNormalize z1 ≡ intNormalize z2 ∈ El Int)

def eqIRefl : (z : El Int) → Prf (EqI z z) using (intNormalizeId) ≔ λz. ⋆

-- soundness: z1 and z2 both equal their own normalizations, which
-- coincide whenever EqI holds
def eqISound : (z1 : El Int) (z2 : El Int) → Prf (EqI z1 z2) → z1 ≡ z2 ∈ El Int using (intNormalizeId) ≔
  λz1. λz2. λh.
    trans (integer.Int) (z1) (integerNormalize.intNormalize z1) (z2)
      (sym (integer.Int) (integerNormalize.intNormalize z1) (z1) (intNormalizeId z1))
      (trans (integer.Int) (integerNormalize.intNormalize z1) (integerNormalize.intNormalize z2) (z2)
        (reflectSquashAt (integer.Int) (integerNormalize.intNormalize z1) (integerNormalize.intNormalize z2) h)
        (intNormalizeId z2))

-- completeness: z1 ≡ z2 reflects, so intNormalize z1 and intNormalize
-- z2 are the same term — the evident-≡-shape squashee bare ⋆ handles
def eqIComplete : (z1 : El Int) (z2 : El Int) → (z1 ≡ z2 ∈ El Int) → Prf (EqI z1 z2) using (intNormalizeId) ≔
  λz1. λz2. λh. ⋆

-- the logical equivalence, packaged with prop.nova's ↔ against the
-- squashed built-in equality
def eqISoundP : (z1 : El Int) (z2 : El Int) → Prf (EqI z1 z2) → Prf (z1 ≡ z2 ∈ El Int) using (intNormalizeId) ≔
  λz1. λz2. λh. eqISound (z1) (z2) h

def eqICompleteP : (z1 : El Int) (z2 : El Int) → Prf (z1 ≡ z2 ∈ El Int) → Prf (EqI z1 z2) using (intNormalizeId) ≔
  -- ∥Prf p∥ ≜ p (code-squash-prf): h already proves the equation
  λz1. λz2. λh. eqIComplete (z1) (z2) h

def eqIIff : (z1 : El Int) (z2 : El Int) → Prf (EqI z1 z2 ↔ (z1 ≡ z2 ∈ El Int)) using (intNormalizeId) ≔
  λz1. λz2. iffIntro (EqI z1 z2) (z1 ≡ z2 ∈ El integer.Int) (eqISoundP (z1) (z2)) (eqICompleteP (z1) (z2))

-- ===== observational equality, the computing one =====
--
-- EqI above compares canonical representatives with the BUILT-IN
-- equality, so it never reduces to ⊤/⊥ and yields no disequalities.
-- The relation below does: it extracts the canonical representative as
-- a PAIR OF NATS and compares componentwise with eqNat.nova's EqN.
--
-- Extracting the representative is the whole difficulty. It is a
-- quot-elim landing in ℕ ⨯ ℕ, so its well-definedness is
--   normPair a b ≡ normPair c d  whenever  a + d ≡ b + c,
-- a NAT-level equation — no propositional extensionality anywhere,
-- which is what blocked the direct Ω-valued comparison (see the note
-- at the top of this file).
--
-- SINCE: prop.nova's propExt (supplied witnesses, e-star-propext) and
-- intEffective.nova have both landed, so the Ω-valued route is no
-- longer blocked, and a bare DISEQUALITY no longer needs any of this —
-- effectivity reads IntR straight off a class equation
-- (intNonZero.nova's intNeqOfNotRel). What survives the change is the
-- part effectivity cannot give: intCanon is a FUNCTION into data, and
-- that is what lets intNonZero.nova DECIDE zero-ness and hand back a
-- witness. Propositional effectivity is not a decision procedure.

-- normPair n Z ≡ (n , Z)
def normPairZR : (n : ℕ) → normPair n Z ≡ (n , Z) ∈ El (ℕ ⨯ ℕ) ≔
  λn. ℕ-elim (k. normPair k Z ≡ (k , Z) ∈ El (ℕ ⨯ ℕ)) ⋆ (k ih. ⋆) n

-- normPair c (b + c) ≡ (Z , b): the successors cancel pairwise
def normPairLeftZ : (b : ℕ) (c : ℕ) → normPair c (b + c) ≡ (Z , b) ∈ El (ℕ ⨯ ℕ) ≔
  λb. λc. ℕ-elim (k. normPair k (b + k) ≡ (Z , b) ∈ El (ℕ ⨯ ℕ)) ⋆ (k ih. ⋆) c

-- normPair (n + d) d ≡ (n , Z)
def normPairRightZ : (n : ℕ) (d : ℕ) → normPair (n + d) d ≡ (n , Z) ∈ El (ℕ ⨯ ℕ) using (normPairZR) ≔
  λn. λd. ℕ-elim (k. normPair (n + k) k ≡ (n , Z) ∈ El (ℕ ⨯ ℕ)) (normPairZR n) (k ih. ⋆) d

def normPairWD : (a : ℕ) (b : ℕ) (c : ℕ) (d : ℕ) (h : Prf (a + d ≡ b + c ∈ ℕ)) →
  normPair a b ≡ normPair c d ∈ El (ℕ ⨯ ℕ) using (normPairLeftZ, normPairRightZ, sucPlus, zeroPlusId) ≔
  λa.
    ℕ-elim (k. (b : ℕ) → (c : ℕ) → (d : ℕ) → (k + d ≡ b + c ∈ ℕ) →
              (normPair k b ≡ normPair c d ∈ El (ℕ ⨯ ℕ)))
      (λb. λc. λd. λh.
        trans (ℕ ⨯ ℕ) (normPair Z b) (Z , b) (normPair c d)
          ⋆
          (trans (ℕ ⨯ ℕ) (Z , b) (normPair c (b + c)) (normPair c d)
            (sym (ℕ ⨯ ℕ) (integerNormalize.normPair c ((nat.+) b c)) (Z, b) (normPairLeftZ b c))
            (cong ℕ (λu. (ℕ ⨯ ℕ)) (λx. normPair c x) (b + c) d
              (sym ℕ (d) ((nat.+) b c) (trans ℕ d (Z + d) (b + c) (sym ℕ ((nat.+) Z d) (d) (zeroPlusId d)) h)))))
      (a' ih. λb.
        ℕ-elim (j. (c : ℕ) → (d : ℕ) → (S a' + d ≡ j + c ∈ ℕ) →
                  (normPair (S a') j ≡ normPair c d ∈ El (ℕ ⨯ ℕ)))
          (λc. λd. λh.
            trans (ℕ ⨯ ℕ) (normPair (S a') Z) (S a' , Z) (normPair c d)
              ⋆
              (trans (ℕ ⨯ ℕ) (S a' , Z) (normPair (S a' + d) d) (normPair c d)
                (sym (ℕ ⨯ ℕ) (integerNormalize.normPair ((nat.+) (S a') d) d) (S a', Z) (normPairRightZ (S a') d))
                (cong ℕ (λu. (ℕ ⨯ ℕ)) (λx. normPair x d) (S a' + d) c
                  (trans ℕ (S a' + d) (Z + c) c h (zeroPlusId c)))))
          (b' ihb. λc. λd. λh.
            ih b' c d
              (predEq (a' + d) (b' + c)
                (trans ℕ (S (a' + d)) (S a' + d) (S (b' + c))
                  (sym ℕ ((nat.+) (S a') d) (S ((nat.+) a' d)) (sucPlus a' d))
                  (trans ℕ (S a' + d) (S b' + c) (S (b' + c))
                    h
                    (sucPlus b' c)))))
          b)
      a

-- the canonical representative of an integer
def intCanon : El Int → ℕ ⨯ ℕ using (normPairWD) ≔
  λz. quot-elim (w. ℕ ⨯ ℕ) (p. normPair (p .π₁) (p .π₂)) z

def intCanonClass : (z : El Int) → class (intCanon z) ≡ z ∈ El Int using (classNormPairEq, integerNormalize.normClass) ≔
  λz. quot-elim (w. (class (intCanon w) ≡ w ∈ El Int)) (p. classNormPairEq p) z

def intCanonOne : intCanon intOne ≡ (S Z , Z) ∈ El (ℕ ⨯ ℕ) ≔ ⋆
def intCanonZero : intCanon intZero ≡ (Z , Z) ∈ El (ℕ ⨯ ℕ) ≔ ⋆

-- Σ-η, generically (a ℕ ⨯ ℕ-specific version would be matched by the
-- engine at pairs of OTHER types and rejected by the kernel)
def pairEtaG : (A : 𝕌) (B : 𝕌) (p : El (A ⨯ B)) → (p .π₁ , p .π₂) ≡ p ∈ El (A ⨯ B) ≔
  λA. λB. λp. ⋆

-- componentwise pair equality — GENERIC for the same reason as
-- pairEtaG: a ℕ ⨯ ℕ-specific version matches (first-order, type-blind)
-- at pairs of any type, and the kernel then rejects the certificate
def pairEq2 : (A : 𝕌) (B : 𝕌) (x : El (A ⨯ B)) (y : El (A ⨯ B)) →
  (x .π₁ ≡ y .π₁ ∈ El A) → (x .π₂ ≡ y .π₂ ∈ El B) → x ≡ y ∈ El (A ⨯ B) ≔
  λA. λB. λx. λy. λh1. λh2.
    trans (A ⨯ B) x (y .π₁ , y .π₂) y
      (trans (A ⨯ B) x (x .π₁ , x .π₂) (y .π₁ , y .π₂)
        (sym (A ⨯ B) (x .π₁, x .π₂) (x) (pairEtaG A B x))
        ⋆)
      (pairEtaG A B y)

-- ===== EqZ: equality that computes =====

def EqZ : El Int → El Int → Ω ≔
  λz1. λz2. (EqN (intCanon z1 .π₁) (intCanon z2 .π₁))
          ∧ (EqN (intCanon z1 .π₂) (intCanon z2 .π₂))

def eqZRefl : (z : El Int) → Prf (EqZ z z) ≔
  λz. andIntro (eqNat.EqN (intCanon z .π₁) (intCanon z .π₁)) (eqNat.EqN (intCanon z .π₂) (intCanon z .π₂)) (eqNRefl (intCanon z .π₁)) (eqNRefl (intCanon z .π₂))

def eqZSound : (z1 : El Int) (z2 : El Int) → Prf (EqZ z1 z2) → z1 ≡ z2 ∈ El Int using (intCanonClass) ≔
  λz1. λz2. λh.
    trans Int z1 (class (intCanon z1)) z2
      (sym Int (class (intCanon z1)) (z1) (intCanonClass z1))
      (trans Int (class (intCanon z1)) (class (intCanon z2)) z2
        (cong (ℕ ⨯ ℕ) (λu. Int) (λr. class r) (intCanon z1) (intCanon z2)
          (pairEq2 ℕ ℕ (intCanon z1) (intCanon z2)
            (eqNSound (intCanon z1 .π₁) (intCanon z2 .π₁) (andFst (eqNat.EqN (intCanon z1 .π₁) (intCanon z2 .π₁)) (eqNat.EqN (intCanon z1 .π₂) (intCanon z2 .π₂)) h))
            (eqNSound (intCanon z1 .π₂) (intCanon z2 .π₂) (andSnd (eqNat.EqN (intCanon z1 .π₁) (intCanon z2 .π₁)) (eqNat.EqN (intCanon z1 .π₂) (intCanon z2 .π₂)) h))))
        (intCanonClass z2))

def eqZComplete : (z1 : El Int) (z2 : El Int) → (z1 ≡ z2 ∈ El Int) → Prf (EqZ z1 z2) ≔
  λz1. λz2. λh.
    andIntro (EqN (intCanon z1 .π₁) (intCanon z2 .π₁))
             (EqN (intCanon z1 .π₂) (intCanon z2 .π₂))
      (eqNComplete (intCanon z1 .π₁) (intCanon z2 .π₁)
        (cong Int (λu. ℕ) (λz. intCanon z .π₁) z1 z2 h))
      (eqNComplete (intCanon z1 .π₂) (intCanon z2 .π₂)
        (cong Int (λu. ℕ) (λz. intCanon z .π₂) z1 z2 h))

def eqZSoundP : (z1 : El Int) (z2 : El Int) → Prf (EqZ z1 z2) → Prf (z1 ≡ z2 ∈ El Int) ≔
  λz1. λz2. λh. eqZSound (z1) (z2) h

def eqZCompleteP : (z1 : El Int) (z2 : El Int) → Prf (z1 ≡ z2 ∈ El Int) → Prf (EqZ z1 z2) ≔
  λz1. λz2. λh. eqZComplete (z1) (z2) h

def eqZIff : (z1 : El Int) (z2 : El Int) → Prf (EqZ z1 z2 ↔ (z1 ≡ z2 ∈ El Int)) ≔
  λz1. λz2. iffIntro (EqZ z1 z2) (z1 ≡ z2 ∈ El integer.Int) (eqZSoundP (z1) (z2)) (eqZCompleteP (z1) (z2))

-- ===== NeqZ: disequality that computes =====

def NeqZ : El Int → El Int → Ω ≔ λz1. λz2. ¬ (EqZ z1 z2)

def neqZSound : (z1 : El Int) (z2 : El Int) →
  Prf (NeqZ z1 z2) → Prf (¬ (z1 ≡ z2 ∈ El Int)) ≔
  λz1. λz2. λh. impIntro (z1 ≡ z2 ∈ El integer.Int) (∥𝟘∥) (λe. impApply (EqZ z1 z2) ((prop.⊥)) h (eqZCompleteP (z1) (z2) e))

def neqZComplete : (z1 : El Int) (z2 : El Int) →
  Prf (¬ (z1 ≡ z2 ∈ El Int)) → Prf (NeqZ z1 z2) ≔
  λz1. λz2. λh. impIntro (EqZ z1 z2) (∥𝟘∥) (λe. impApply (z1 ≡ z2 ∈ El integer.Int) ((prop.⊥)) h (eqZSoundP (z1) (z2) e))

def neqZIff : (z1 : El Int) (z2 : El Int) →
  Prf (NeqZ z1 z2 ↔ ¬ (z1 ≡ z2 ∈ El Int)) ≔
  λz1. λz2. iffIntro (NeqZ z1 z2) ((prop.¬) (z1 ≡ z2 ∈ El integer.Int)) (neqZSound (z1) (z2)) (neqZComplete (z1) (z2))

-- ===== the payoff: an actual disequality =====
--
-- EqZ intOne intZero REDUCES: the canonical representatives are
-- (S Z, Z) and (Z, Z), so it is EqN (S Z) Z ∧ EqN Z Z, i.e. ⊥ ∧ ⊤.
-- Its first projection is already the absurdity.
def eqZOneZero : Prf (NeqZ intOne intZero) ≔ impIntro (EqZ integer.intOne integer.intZero) ((prop.⊥)) (λh. andFst ((prop.⊥)) (eqNat.EqN (intCanon integer.intOne .π₂) (intCanon integer.intZero .π₂)) h)

def intOneNotZero : Prf (¬ (intOne ≡ intZero ∈ El Int)) ≔
  neqZSound (integer.intOne) (integer.intZero) eqZOneZero

-- and a positive computation: 2 = 2 even spelled differently
def eqZTwo : Prf (EqZ (class (S (S Z) , Z)) (class (S (S (S Z)) , S Z))) ≔
  andIntro (∥𝟙∥) (∥𝟙∥) ⋆ ⋆
