-- Observational equality of Int, and its logical equivalence with the
-- built-in ≡ ∈ El Int. Int is a quotient (ℕ ⨯ ℕ) / IntR, so its OWN
-- defining relation is already the natural "observational" candidate —
-- but lifting IntR to El Int × El Int directly (via a double quot-elim
-- landing in Ω) needs its well-definedness proved as an Ω-code
-- equality, i.e. propositional extensionality between two DIFFERENT
-- IntR-applications, and this elaborator's propext check only
-- discharges the evident (𝟙-/reflexive-≡-shaped) cases automatically —
-- it does not search for the mutual-implication witnesses even when
-- they're sitting in context (see the prop.nova-only bonus attempt in
-- the sibling eqNat.nova). So EqI instead compares CANONICAL
-- representatives (integerNormalize.nova's intNormalize), squashing an
-- ordinary EQUATION rather than an Ω-code — equations are
-- proof-irrelevant (every ≡-proof is ⋆ on the nose), so THIS
-- well-definedness is free.
-- IntR is Int's own quotient relation (integer.nova); a proof of it
-- gives equal classes directly (el-quot-eq, automatic given a term of
-- Prf (IntR p q) in context — no extra machinery needed).

import nat (+, zeroPlusId, sucPlus)
import integer (Int, IntR, intZero, intOne, toInt)
import integerNormalize (normPair, normSound, intNormalize)
import equality (sym, trans, cong, pairext, pairextD)
import prop (↔, iffIntro, ∧, ¬, ⊥, andIntro, andFst, andSnd, impIntro, impApply)
import eqNat (EqN, eqNRefl, eqNSound, eqNComplete, predEq)

def classEqOfRel : {p q : ℕ ⨯ ℕ} → Prf (IntR p q) → class p ≡ class q ∈ El Int
  using (integer.Int.unfold, integer.IntR.unfold) ≔
  λp. λq. λh. ⋆

-- normPair's own representative is IntR-related to its input (that's
-- normSound), so its class is the same Int
def classNormPairEq : {p : ℕ ⨯ ℕ} → class (normPair (p .π₁) (p .π₂)) ≡ class p ∈ El Int
  using (integer.Int.unfold,
    integer.IntR.eq,
    integerNormalize.normClass,
    integerNormalize.normPair.eq,
    normSound) ≔
  λp. classEqOfRel (normSound (p .π₁) (p .π₂))

-- normalization doesn't change the value: intNormalize z is z. The
-- quot-elim's well-definedness goal here is an EQUATION (not an Ω
-- code), so it's discharged for free by proof irrelevance regardless
-- of how the representative varies.
def intNormalizeId : (z : El Int) → intNormalize z ≡ z
  using (classNormPairEq,
    integer.Int.unfold,
    integerNormalize.intNormalize.eq,
    integerNormalize.normClass,
    integerNormalize.normPair.eq) ≔
  λz. quot-elim (p. classNormPairEq) z

def EqI : El Int → El Int → Ω ≔ λz1. λz2. intNormalize z1 ≡ intNormalize z2

def eqIRefl : (z : El Int) → Prf (EqI z z) using (eqInt.EqI.unfold, intNormalizeId) ≔ λz. ⋆

-- soundness: z1 and z2 both equal their own normalizations, which
-- coincide whenever EqI holds
def eqISound : {z1 z2 : El Int} → Prf (EqI z1 z2) → z1 ≡ z2
  using (eqInt.EqI.eq,
    eqInt.EqI.unfold,
    intNormalizeId,
    integer.Int.eq,
    integer.Int.unfold,
    integerNormalize.intNormalize.eq) ≔
  λz1. λz2. λh. trans
    _
    _
    _
    (sym _ _ (intNormalizeId z1))
    (trans (intNormalize z1) _ _ h (intNormalizeId z2))

-- completeness: z1 ≡ z2 reflects, so intNormalize z1 and intNormalize
-- z2 are the same term — the evident-≡-shape squashee bare ⋆ handles
def eqIComplete : {z1 z2 : El Int} → (z1 ≡ z2) → Prf (EqI z1 z2)
  using (eqInt.EqI.unfold, intNormalizeId, integer.Int.unfold) ≔
  λz1. λz2. λh. ⋆

-- the logical equivalence, packaged with prop.nova's ↔ against the
-- squashed built-in equality
def eqISoundP : {z1 z2 : El Int} → Prf (EqI z1 z2) → Prf (z1 ≡ z2) using (intNormalizeId) ≔
  λz1. λz2. λh. eqISound h

-- ∥Prf p∥ ≜ p (code-squash-prf): h already proves the equation
def eqICompleteP : {z1 z2 : El Int} → Prf (z1 ≡ z2) → Prf (EqI z1 z2)
  using (eqInt.EqI.unfold, intNormalizeId) ≔
  λz1. λz2. λh. eqIComplete h

def eqIIff : {z1 z2 : El Int} → Prf (EqI z1 z2 ↔ (z1 ≡ z2))
  using (intNormalizeId, prop.↔.unfold, prop.∧.unfold) ≔
  λz1. λz2. iffIntro eqISoundP eqICompleteP

-- ===== observational equality, the computing one =====
--
-- EqI above compares canonical representatives with the BUILT-IN
-- equality, so it never reduces to ⊤/⊥ and yields no disequalities.
-- The relation below does: it extracts the canonical representative as
-- a PAIR OF NATS and compares componentwise with eqNat.nova's EqN.
--
-- Extracting the representative is the whole difficulty. It is a
-- quot-elim landing in ℕ ⨯ ℕ, so its well-definedness is
--   normPair a b ≡ normPair c d  whenever  a + d ≡ b + c,
-- a NAT-level equation — no propositional extensionality anywhere,
-- which is what blocked the direct Ω-valued comparison (see the note
-- at the top of this file).
--
-- SINCE: prop.nova's propExt (supplied witnesses, e-star-propext) and
-- intEffective.nova have both landed, so the Ω-valued route is no
-- longer blocked, and a bare DISEQUALITY no longer needs any of this —
-- effectivity reads IntR straight off a class equation
-- (intNonZero.nova's intNeqOfNotRel). What survives the change is the
-- part effectivity cannot give: intCanon is a FUNCTION into data, and
-- that is what lets intNonZero.nova DECIDE zero-ness and hand back a
-- witness. Propositional effectivity is not a decision procedure.
-- normPair n Z ≡ (n , Z)
def normPairZR : {n : ℕ} → normPair n Z ≡ (n, Z) ∈ El (ℕ ⨯ ℕ) using (integerNormalize.normPair.eq) ≔
  λn. ℕ-elim ⋆ (k ih. ⋆) n

-- normPair c (b + c) ≡ (Z , b): the successors cancel pairwise
def normPairLeftZ : (b c : ℕ) → normPair c (b + c) ≡ (Z, b) ∈ El (ℕ ⨯ ℕ)
  using (integerNormalize.normPair.eq, nat.+.eq, nat.plusZeroId) ≔
  λb. λc. ℕ-elim ⋆ (k ih. ⋆) c

-- normPair (n + d) d ≡ (n , Z)
def normPairRightZ : (n d : ℕ) → normPair (n + d) d ≡ (n, Z) ∈ El (ℕ ⨯ ℕ)
  using (integerNormalize.normPair.eq, nat.+.eq, normPairZR) ≔
  λn. λd. ℕ-elim normPairZR (k ih. ⋆) d

def normPairWD : (a b c d : ℕ) (h : Prf (a + d ≡ b + c)) → normPair a b ≡ normPair c d ∈ El (ℕ ⨯ ℕ)
  using (eqInt.normPairZR,
    integerNormalize.normPair.eq,
    normPairLeftZ,
    normPairRightZ,
    sucPlus,
    zeroPlusId) ≔
  λa. ℕ-elim
    (λb. λc. λd. λh. trans
      _
      _
      _
      ⋆
      (trans
        _
        _
        _
        (sym _ _ (normPairLeftZ b c))
        (cong (λu. ℕ ⨯ ℕ) (λx. normPair c x) (sym _ _ (trans _ _ _ (sym _ _ (zeroPlusId d)) h)))))
    (a' ih. λb. ℕ-elim
      (λc. λd. λh. trans
        _
        _
        _
        ⋆
        (trans
          _
          _
          _
          (sym _ _ (normPairRightZ (S a') d))
          (cong (λu. ℕ ⨯ ℕ) (λx. normPair x d) (trans _ _ _ h (zeroPlusId c)))))
      (b' ihb. λc. λd. λh. ih
        b'
        c
        d
        (predEq (trans _ _ _ (sym _ _ (sucPlus a' d)) (trans _ _ _ h (sucPlus b' c)))))
      b)
    a

-- the canonical representative of an integer
def intCanon : El Int → ℕ ⨯ ℕ using (integer.Int.unfold, normPairWD) ≔
  λz. quot-elim (p. normPair (p .π₁) (p .π₂)) z

def intCanonToInt : (z : El Int) → toInt (intCanon z) ≡ z
  using (classNormPairEq,
    eqInt.intCanon.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integer.toInt.unfold,
    integer.toInt.eq,
    integerNormalize.normClass,
    integerNormalize.normPair.eq) ≔
  λz. quot-elim (p. classNormPairEq) z

def intCanonClass : (z : El Int) → class (intCanon z) ≡ z
  using (classNormPairEq,
    eqInt.intCanon.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integerNormalize.normClass,
    integerNormalize.normPair.eq) ≔
  λz. quot-elim (p. classNormPairEq) z

def intCanonOne : intCanon intOne ≡ (S Z, Z) ∈ El (ℕ ⨯ ℕ)
  using (eqInt.intCanon.eq, integer.intOne.eq, integerNormalize.normPair.eq) ≔
  ⋆

def intCanonZero : intCanon intZero ≡ (Z, Z) ∈ El (ℕ ⨯ ℕ)
  using (eqInt.intCanon.eq, integer.intZero.eq, integerNormalize.normPair.eq) ≔
  ⋆

-- ===== EqZ: equality that computes =====
def EqZ : El Int → El Int → Ω ≔
  λz1. λz2. EqN (intCanon z1 .π₁) (intCanon z2 .π₁) ∧ EqN (intCanon z1 .π₂) (intCanon z2 .π₂)

def eqZRefl : (z : El Int) → Prf (EqZ z z)
  using (eqInt.EqZ.eq,
    eqInt.EqZ.unfold,
    eqInt.intCanon.eq,
    eqNat.EqN.eq,
    integer.Int.unfold,
    prop.∧.unfold) ≔
  λz. andIntro (eqNRefl (intCanon z .π₁)) (eqNRefl (intCanon z .π₂))

def eqZSound : {z1 z2 : El Int} → Prf (EqZ z1 z2) → z1 ≡ z2 using (eqInt.EqZ.eq) ≔
  λz1. λz2. λh. trans
    _
    _
    _
    (sym _ _ (intCanonToInt z1))
    (trans
      _
      _
      _
      (cong _ toInt (pairext (eqNSound (andFst h)) (eqNSound (andSnd h))))
      (intCanonToInt z2))

def eqZComplete : {z1 z2 : El Int} → (z1 ≡ z2) → Prf (EqZ z1 z2)
  using (eqInt.EqZ.eq,
    eqInt.EqZ.unfold,
    eqInt.intCanon.eq,
    eqNat.EqN.eq,
    integer.Int.unfold,
    prop.∧.unfold) ≔
  λz1. λz2. λh. andIntro
    (eqNComplete (cong (λu. ℕ) (λz. intCanon z .π₁) h))
    (eqNComplete (cong (λu. ℕ) (λz. intCanon z .π₂) h))

def eqZSoundP : {z1 z2 : El Int} → Prf (EqZ z1 z2) → Prf (z1 ≡ z2) ≔ λz1. λz2. λh. eqZSound h

def eqZCompleteP : {z1 z2 : El Int} → Prf (z1 ≡ z2) → Prf (EqZ z1 z2)
  using (eqInt.EqZ.unfold, prop.∧.unfold) ≔
  λz1. λz2. λh. eqZComplete h

def eqZIff : (z1 z2 : El Int) → Prf (EqZ z1 z2 ↔ (z1 ≡ z2)) using (prop.↔.unfold, prop.∧.unfold) ≔
  λz1. λz2. iffIntro eqZSoundP eqZCompleteP

-- ===== NeqZ: disequality that computes =====
def NeqZ : El Int → El Int → Ω ≔ λz1. λz2. ¬ (EqZ z1 z2)

def neqZSound : {z1 z2 : El Int} → Prf (NeqZ z1 z2) → Prf (¬ (z1 ≡ z2))
  using (eqInt.EqZ.eq,
    eqInt.NeqZ.eq,
    eqInt.NeqZ.unfold,
    eqInt.intCanon.eq,
    eqNat.EqN.eq,
    integer.Int.eq,
    integer.Int.unfold,
    nat.+.eq,
    prop.¬.eq,
    prop.¬.unfold,
    prop.∧.eq,
    prop.⊃.eq,
    prop.⊃.unfold,
    prop.⊥.eq) ≔
  λz1. λz2. λh. impIntro {z1 ≡ z2} {∥𝟘∥} (λe. impApply h (eqZCompleteP e))

def neqZComplete : {z1 z2 : El Int} → Prf (¬ (z1 ≡ z2)) → Prf (NeqZ z1 z2)
  using (eqInt.EqZ.eq,
    eqInt.EqZ.unfold,
    eqInt.NeqZ.eq,
    eqInt.NeqZ.unfold,
    eqInt.intCanon.eq,
    eqNat.EqN.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integerNormalize.normPair.eq,
    prop.¬.eq,
    prop.¬.unfold,
    prop.∧.eq,
    prop.∧.unfold,
    prop.⊃.eq,
    prop.⊃.unfold,
    prop.⊤.eq,
    prop.⊥.eq) ≔
  λz1. λz2. λh. impIntro {EqZ z1 z2} {∥𝟘∥} (λe. impApply h (eqZSoundP e))

def neqZIff : (z1 z2 : El Int) → Prf (NeqZ z1 z2 ↔ ¬ (z1 ≡ z2))
  using (prop.↔.unfold, prop.∧.unfold) ≔
  λz1. λz2. iffIntro neqZSound neqZComplete

-- ===== the payoff: an actual disequality =====
--
-- EqZ intOne intZero REDUCES: the canonical representatives are
-- (S Z, Z) and (Z, Z), so it is EqN (S Z) Z ∧ EqN Z Z, i.e. ⊥ ∧ ⊤.
-- Its first projection is already the absurdity.
def eqZOneZero : Prf (NeqZ intOne intZero)
  using (eqInt.EqZ.eq,
    eqInt.EqZ.unfold,
    eqInt.NeqZ.eq,
    eqInt.NeqZ.unfold,
    eqInt.intCanon.eq,
    eqNat.EqN.eq,
    integer.intOne.eq,
    integer.intZero.eq,
    integerNormalize.normPair.eq,
    prop.¬.eq,
    prop.¬.unfold,
    prop.∧.eq,
    prop.∧.unfold,
    prop.⊃.eq,
    prop.⊃.unfold,
    prop.⊥.eq) ≔
  impIntro
    {EqZ intOne intZero}
    {⊥}
    (λh. andFst {⊥} {EqN (intCanon intOne .π₂) (intCanon intZero .π₂)} h)

def intOneNotZero : Prf (¬ (intOne ≡ intZero)) using (prop.¬.unfold, prop.⊃.unfold) ≔
  neqZSound eqZOneZero

-- and a positive computation: 2 = 2 even spelled differently
def eqZTwo : Prf (EqZ (class (2, Z)) (class (3, S Z)))
  using (eqInt.EqZ.eq,
    eqInt.EqZ.unfold,
    eqInt.intCanon.eq,
    eqNat.EqN.eq,
    integer.Int.unfold,
    integerNormalize.normPair.eq,
    prop.∧.eq,
    prop.∧.unfold,
    prop.⊤.eq,
    prop.⊥.eq) ≔
  andIntro {∥𝟙∥} {∥𝟙∥} ⋆ ⋆
