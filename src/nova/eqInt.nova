import nat (+)
import integer (Int)
import integerNormalize (normPair, normSound, intNormalize)
import prop (Iff, iffIntro)

-- Observational equality of Int, and its logical equivalence with the
-- built-in ≡ ∈ Int. Int is a quotient (ℕ ⨯ ℕ) / IntR, so its OWN
-- defining relation is already the natural "observational" candidate —
-- but lifting IntR to Int × Int directly (via a double quot-elim
-- landing in Ω) needs its well-definedness proved as an Ω-code
-- equality, i.e. propositional extensionality between two DIFFERENT
-- IntR-applications, and this elaborator's propext check only
-- discharges the evident (𝟙-/reflexive-≡-shaped) cases automatically —
-- it does not search for the mutual-implication witnesses even when
-- they're sitting in context (see the prop.nova-only bonus attempt in
-- the sibling eqNat.nova). So EqI instead compares CANONICAL
-- representatives (integerNormalize.nova's intNormalize), squashing an
-- ordinary EQUATION rather than an Ω-code — equations are
-- proof-irrelevant (every ≡-proof is Refl on the nose), so THIS
-- well-definedness is free.

-- IntR is Int's own quotient relation, named for reuse; a proof of it
-- gives equal classes directly (el-quot-eq, automatic given a term of
-- Prf (IntR p q) in context — no extra machinery needed).
def IntR : (ℕ ⨯ ℕ) → (ℕ ⨯ ℕ) → Ω ≔ λp. λq. ∥ p .π₁ + q .π₂ ≡ p .π₂ + q .π₁ ∈ ℕ ∥

def classEqOfRel : (p : ℕ ⨯ ℕ) (q : ℕ ⨯ ℕ) → Prf (IntR p q) → class p ≡ class q ∈ Int ≔
  λp. λq. λh. Refl

-- normPair's own representative is IntR-related to its input (that's
-- normSound), so its class is the same Int
def classNormPairEq : (p : ℕ ⨯ ℕ) → class (normPair (p .π₁) (p .π₂)) ≡ class p ∈ Int ≔
  λp. classEqOfRel (normPair (p .π₁) (p .π₂)) p (⋆ (normSound (p .π₁) (p .π₂)))

-- normalization doesn't change the value: intNormalize z is z. The
-- quot-elim's well-definedness goal here is an EQUATION (not an Ω
-- code), so it's discharged for free by proof irrelevance regardless
-- of how the representative varies.
def intNormalizeId : (z : Int) → intNormalize z ≡ z ∈ Int ≔
  λz. quot-elim (w. intNormalize w ≡ w ∈ Int) (p. classNormPairEq p) z

-- a squashed equality at Int reflects into a judgemental one, exactly
-- like prop.nova's reflectSquash but monomorphic to Int — Int is a
-- `type` alias, not a 𝕌-code term, so it can't be passed to a generic
-- (A : 𝕌)-parameterized combinator (equality.nova's own sym/trans)
def reflectSquashInt : (a : Int) (b : Int) (h : Prf ∥ a ≡ b ∈ Int ∥) → a ≡ b ∈ Int ≔
  λa. λb. λh. Refl

def EqI : Int → Int → Ω ≔ λz1. λz2. ∥ intNormalize z1 ≡ intNormalize z2 ∈ Int ∥

def eqIRefl : (z : Int) → Prf (EqI z z) ≔ λz. ⋆

-- sym/trans monomorphized to Int, for the same reason as
-- reflectSquashInt above
def symInt : (a : Int) (b : Int) → (a ≡ b ∈ Int) → b ≡ a ∈ Int ≔
  λa. λb. λh. Refl
def transInt : (a : Int) (b : Int) (c : Int) → (a ≡ b ∈ Int) → (b ≡ c ∈ Int) → a ≡ c ∈ Int ≔
  λa. λb. λc. λh1. λh2. Refl

-- soundness: z1 and z2 both equal their own normalizations, which
-- coincide whenever EqI holds
def eqISound : (z1 : Int) (z2 : Int) → Prf (EqI z1 z2) → z1 ≡ z2 ∈ Int ≔
  λz1. λz2. λh.
    transInt z1 (intNormalize z1) z2
      (symInt (intNormalize z1) z1 (intNormalizeId z1))
      (transInt (intNormalize z1) (intNormalize z2) z2
        (reflectSquashInt (intNormalize z1) (intNormalize z2) h)
        (intNormalizeId z2))

-- completeness: z1 ≡ z2 reflects, so intNormalize z1 and intNormalize
-- z2 are the same term — the evident-≡-shape squashee bare ⋆ handles
def eqIComplete : (z1 : Int) (z2 : Int) → (z1 ≡ z2 ∈ Int) → Prf (EqI z1 z2) ≔
  λz1. λz2. λh. ⋆

-- the logical equivalence, packaged with prop.nova's Iff against the
-- squashed built-in equality
def eqISoundP : (z1 : Int) (z2 : Int) → Prf (EqI z1 z2) → Prf ∥ z1 ≡ z2 ∈ Int ∥ ≔
  λz1. λz2. λh. ⋆ (eqISound z1 z2 h)

def eqICompleteP : (z1 : Int) (z2 : Int) → Prf ∥ z1 ≡ z2 ∈ Int ∥ → Prf (EqI z1 z2) ≔
  λz1. λz2. λh. squash-elim h (e. eqIComplete z1 z2 e)

def eqIIff : (z1 : Int) (z2 : Int) → Prf (Iff (EqI z1 z2) ∥ z1 ≡ z2 ∈ Int ∥) ≔
  λz1. λz2. iffIntro (EqI z1 z2) ∥ z1 ≡ z2 ∈ Int ∥ (eqISoundP z1 z2) (eqICompleteP z1 z2)
