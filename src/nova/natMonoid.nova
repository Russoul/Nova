-- (ℕ, +, 0) is a monoid: the operations are data components, and each
-- law is an existing nat.nova ≡-lemma carried across the Id bridge by
-- eqToId, with both sides spelled so the component types meet the
-- expected ones exactly.

import nat (+, *, plusAssoc, zeroPlusId, plusZeroId, multAssoc, sucPlus)
import id (eqToId)
import monoid (IsMonoid)

def natAddMonoid : IsMonoid ℕ using (monoid.IsMonoid.unfold) ≔
  (+),
    Z,
      (λx. λy. λz. eqToId
        _
        _
        (plusAssoc x y z)), (λx. eqToId _ _ (zeroPlusId x)), λx. eqToId _ _ (plusZeroId x)

-- The unit laws for * at S Z. On the right the whole statement is a
-- δβ-computation (n * S Z unwinds through * and + to n); on the left
-- the elimination is stuck on n, so it is an induction.
def multOneR : (n : ℕ) → n * S Z ≡ n using (nat.*.eq, nat.+.eq) ≔ λn. ⋆

def oneMultL : (n : ℕ) → S Z * n ≡ n
  using (*.eq,
    hyp.rw,
    nat.multZeroId,
    nat.multZeroId.rw,
    sucPlus,
    sucPlus.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λn. ℕ-elim ⋆ (k ih. ⋆) n

-- (ℕ, *, 1) is a monoid.
def natMulMonoid : IsMonoid ℕ using (monoid.IsMonoid.unfold) ≔
  (*),
    S Z,
      (λx. λy. λz. eqToId
        _
        _
        (multAssoc x y z)), (λx. eqToId _ _ (oneMultL x)), λx. eqToId _ _ (multOneR x)
