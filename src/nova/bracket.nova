-- The bracket type [A] ≜ A / ⊤ (Awodey–Bauer), as a 𝕌-CODE.
--
-- Nova has two truncations. ∥T∥ : Ω is the irrelevant one: Ω compares
-- its elements by inhabitation alone (code-prop-eq), so Prf ∥T∥ has
-- the single canonical form ⋆ and there is no Prf-beta — the witness
-- is unrecoverable, and elimination is confined to props and equations
-- (NovaFoundation.txt:1267, :1296).
--
-- Br a ≜ a / (x y. ∥𝟙∥) is the other one. class x RETAINS x, so
-- el-quot-beta computes, and el-quot-e's motive ranges over arbitrary
-- TYPES: the eliminator lands wherever the method is constant. What it
-- gives up is Ω-membership — impredicativity, and iff-collapse.
--
-- It is nonetheless a DEFINITIONAL subsingleton: el-quot-eq concludes
-- ≐, not ≡. (Lean's Squash, the same quotient, is only a propositional
-- one — Quot.sound is not judgemental.)

import prop (propExt)
import equality (cong, sym, trans, sigmaEq2)
import id (Id, refl, idToEq)
import uip (uip, idCanon)

def Br : 𝕌 → 𝕌 ≔ λa. a / (x y. ∥𝟙∥)

def br : {a : 𝕌} → El a → El (Br a) using (Br.unfold) ≔ λa. λx. class x

-- Elimination into an ARBITRARY code, along any constant map.
def brElim : (a : 𝕌) {b : 𝕌} (f : El a → El b) (c : (x y : El a) → f x ≡ f y) (t : El (Br a)) → El b
  using (Br.unfold) ≔
  λa. λb. λf. λc. λt. quot-elim (x. f x) t

-- ...and it COMPUTES.
def brBeta : (a b : 𝕌)
  (f : El a → El b)
  (c : (x y : El a) → f x ≡ f y)
  (x : El a)
  → brElim a f c (br x) ≡ f x
  using (Br.unfold, br.eq, brElim.eq) ≔
  λa. λb. λf. λc. λx. ⋆

-- ---------------------------------------------------------------
-- [A] is a proposition — JUDGEMENTALLY (el-quot-eq concludes ≐)
def brIsProp : (a : 𝕌) (u v : El (Br a)) → u ≡ v using (Br.unfold) ≔
  λa. λu. λv. quot-elim (y. quot-elim (x. ⋆) u) v

-- Consequently EVERY map out of [A] is constant on representatives,
-- with no hypothesis at all: the coherence brElim asks for is free
-- whenever the function already factors through the bracket.
def brOutConst : (a b : 𝕌) (g : El (Br a) → El b) (x y : El a) → g (br x) ≡ g (br y) ≔
  λa. λb. λg. λx. λy. cong (Br a) (λw. b) g (br x) (br y) (brIsProp a (br x) (br y))

-- η / uniqueness: brElim is the ONLY map agreeing with g on classes.
def brEta : (a b : 𝕌)
  (g : El (Br a) → El b)
  (t : El (Br a))
  → brElim a (λx. g (br x)) (brOutConst a b g) t ≡ g t ∈ El b
  using (Br.unfold, br.eq, brElim.eq, brOutConst.eq) ≔
  λa. λb. λg. λt. quot-elim (x. ⋆) t

-- ---------------------------------------------------------------
-- br is surjective — merely, but that is all a bracket can say
def brSurj : (a : 𝕌) (t : El (Br a)) → Prf ∥(x : El a) ⨯ br x ≡ t∥ using (Br.unfold, br.eq) ≔
  λa. λt. quot-elim (x. ⋆ (x, ⋆)) t

-- ---------------------------------------------------------------
-- [A] and A have the same Ω-squash: the bracket is a REFINEMENT of
-- ∥·∥, carrying strictly more (it keeps the witness) and asserting
-- exactly the same thing.
def brToSquash : (a : 𝕌) → El (Br a) → Prf ∥El a∥ using (Br.unfold) ≔ λa. λt. quot-elim (x. ⋆ x) t

def brSquashEq : (a : 𝕌) → ∥El (Br a)∥ ≡ ∥El a∥ using (Br.unfold, br.eq, brToSquash.eq) ≔
  λa. propExt ∥El a∥ (λh. squash-elim h (t. brToSquash a t)) (λh. squash-elim h (x. ⋆ (br x)))

-- ---------------------------------------------------------------
-- [-] is an idempotent monad on 𝕌: unit br, multiplication brJoin,
-- functorial action brMap.
def brMap : (a : 𝕌) {b : 𝕌} (f : El a → El b) (t : El (Br a)) → El (Br b) using (Br.unfold, br.eq) ≔
  λa. λb. λf. λt. quot-elim (x. br (f x)) t

def brMapBeta : (a b : 𝕌) (f : El a → El b) (x : El a) → brMap a f (br x) ≡ br (f x)
  using (Br.unfold, br.eq, brMap.eq) ≔
  λa. λb. λf. λx. ⋆

-- the coherence brElim demands IS brIsProp, verbatim
def brJoin : {a : 𝕌} (s : El (Br (Br a))) → El (Br a) ≔ λa. λs. brElim (Br a) (λt. t) (brIsProp a) s

-- idempotence, both round trips
def brJoinUnit : (a : 𝕌) (t : El (Br a)) → brJoin (br t) ≡ t
  using (Br.unfold, br.eq, brJoin.eq, brElim.eq) ≔
  λa. λt. ⋆

def brUnitJoin : (a : 𝕌) (s : El (Br (Br a))) → br (brJoin s) ≡ s ≔
  λa. λs. brIsProp (Br a) (br (brJoin s)) s

-- ---------------------------------------------------------------
-- The bracket REFLECTS emptiness — by ordinary elimination.
--
-- Compare prop.absurdP: Prf ⊥ → 𝟘 is NOT available that way
-- (el-squash-e-prf reaches only further propositions); prop.absurd has
-- to detour through el-reflect on a false equation. Here quot-elim
-- lands in 𝟘 directly, because the scrutinee still holds its witness.
def zeroConst : (b : 𝕌) (f : 𝟘 → El b) (x y : 𝟘) → f x ≡ f y ≔ λb. λf. λx. λy. 𝟘-elim x

def brEmpty : El (Br 𝟘) → 𝟘 using (Br.unfold, zeroConst.eq) ≔ λt. quot-elim (x. 𝟘-elim x) t

-- ---------------------------------------------------------------
-- DESCRIPTION. On a subsingleton the bracket is the type itself: the
-- witness comes back out, as data, and it computes.
--
-- This is exactly what ∥·∥ : Ω must not have — unique choice is one of
-- the three prohibitions licensing Ω's impredicativity
-- (NovaFoundation.txt:1316, Chicli–Pottier–Simpson). The bracket may
-- have it precisely because it is NOT a proposition of Ω: nothing
-- coerces into El (Br a) from an iff-equal prop, so the only way to
-- hold one is to have built it from an element.
def brDescr : (a : 𝕌) (s : (x y : El a) → x ≡ y) (t : El (Br a)) → El a using (Br.unfold) ≔
  λa. λs. λt. quot-elim (x. x) t

def brDescrBeta : (a : 𝕌) (s : (x y : El a) → x ≡ y) (x : El a) → brDescr a s (br x) ≡ x
  using (Br.unfold, br.eq, brDescr.eq) ≔
  λa. λs. λx. ⋆

def brDescrEta : (a : 𝕌) (s : (x y : El a) → x ≡ y) (t : El (Br a)) → br (brDescr a s t) ≡ t ≔
  λa. λs. λt. brIsProp a (br (brDescr a s t)) t

-- ---------------------------------------------------------------
-- The payoff, in miniature: a truncated existential whose witness is
-- recovered AS DATA and evaluates.
--
-- ≡ is Ω-valued and has no 𝕌-code, so the subsingleton is built from
-- the Id QIIT instead: Fib n ≜ (m : ℕ) ⨯ Id ℕ m n, an "∃m. m = n"
-- that IS a code. uip makes it a subsingleton, brDescr opens it.
-- Its Ω twin, Prf ∥El (Fib n)∥, says exactly the same thing
-- (brSquashEq) and yields nothing.
def Fib : ℕ → 𝕌 ≔ λn. (m : ℕ) ⨯ Id ℕ m n

-- every element of Fib n is (n , refl): reflect the index equation
-- first, then uip finishes at the reflected type
def fibCanon : (n : ℕ) (u : El (Fib n)) → u ≡ (n, refl ℕ n)
  using (Fib.unfold, hyp.rw, sigma.eta, id.Id.unfold, id.Id.eq) ≔
  λn. λu. let h ≔ idToEq
    ℕ
    (u .π₁)
    n
    (u .π₂) in sigmaEq2 ℕ (λm. Id ℕ m n) u (n, refl ℕ n) h (idCanon (u .π₂) h)

def fibIsProp : (n : ℕ) (u v : El (Fib n)) → u ≡ v using (Fib.unfold, id.Id.unfold, id.Id.eq) ≔
  λn. λu. λv. trans
    (Fib n)
    u
    (n, refl ℕ n)
    v
    (fibCanon n u)
    (sym (Fib n) v (n, refl ℕ n) (fibCanon n v))

def fibWitness : (n : ℕ) (t : El (Br (Fib n))) → ℕ using (Fib.unfold) ≔
  λn. λt. brDescr (Fib n) (fibIsProp n) t .π₁

-- ⋆ means: this equation holds DEFINITIONALLY. The witness survived
-- the truncation and the projection reduced to a numeral.
def fibWitnessComputes : fibWitness 2 (br (2, refl ℕ 2)) ≡ 2
  using (Fib.unfold, br.eq, brDescr.eq, fibWitness.eq, id.Id.eq) ≔
  ⋆

-- ---------------------------------------------------------------
-- [-] preserves binary products: El (Br (a ⨯ b)) ≅ El (Br a ⨯ Br b).
--
-- All the work is in building the two maps; both round trips are FREE,
-- because every equation between elements of a bracket is (brIsProp).
-- That is the shape of every proof about this modality: propositions
-- are cheap, elimination is the content.
def brProdIsProp : {a b : 𝕌} (u v : El (Br a ⨯ Br b)) → u ≡ v using (sigma.eta) ≔
  λa. λb. λu. λv. sigmaEq2
    (Br a)
    (λw. Br b)
    u
    v
    (brIsProp a (u .π₁) (v .π₁))
    (brIsProp b (u .π₂) (v .π₂))

def brPairIn : {a b : 𝕌} (t : El (Br (a ⨯ b))) → El (Br a ⨯ Br b) ≔
  λa. λb. λt. brElim
    (a ⨯ b)
    (λp. br (p .π₁), br (p .π₂))
    (λp. λq. brProdIsProp (br (p .π₁), br (p .π₂)) (br (q .π₁), br (q .π₂)))
    t

def brPairOutAt : {a b : 𝕌} (x : El a) (v : El (Br b)) → El (Br (a ⨯ b)) ≔
  λa. λb. λx. λv. brElim b (λy. br (x, y)) (λy. λy'. brIsProp (a ⨯ b) (br (x, y)) (br (x, y'))) v

def brPairOut : {a b : 𝕌} (p : El (Br a ⨯ Br b)) → El (Br (a ⨯ b)) ≔
  λa. λb. λp. brElim
    a
    (λx. brPairOutAt x (p .π₂))
    (λx. λx'. brIsProp (a ⨯ b) (brPairOutAt x (p .π₂)) (brPairOutAt x' (p .π₂)))
    (p .π₁)

def brProdIso1 : (a b : 𝕌) (t : El (Br (a ⨯ b))) → brPairOut (brPairIn t) ≡ t ≔
  λa. λb. λt. brIsProp (a ⨯ b) (brPairOut (brPairIn t)) t

def brProdIso2 : (a b : 𝕌) (p : El (Br a ⨯ Br b)) → brPairIn (brPairOut p) ≡ p ≔
  λa. λb. λp. brProdIsProp (brPairIn (brPairOut p)) p
