-- THE INTEGER SQUARE ROOT, and the two facts that pin it down:
--
--   isqrt m * isqrt m ≤ m        (it is a lower approximant)
--   m < S (isqrt m) * S (isqrt m)   (it is the LARGEST one)
--
-- Everything ℝ's square root will need bottoms out here. The rational
-- approximation to √u at depth N is isqrt of ⌊u·N²⌋ divided by N, and
-- the two bounds above are exactly what turns into |r² − u| ≤ 2/N.
--
-- `isqrtAux m f` searches downwards from f for the largest k with
-- k² ≤ m, so `isqrt m ≔ isqrtAux m m` is correct because k² ≤ m
-- forces k ≤ m. The test is `S f * S f ∸ m ≡ Z`, decided by natCase:
-- monus is a FUNCTION, so the branch taken is unambiguous even when
-- the two sides are equal — using leTotal here would be wrong, since
-- at k² = m both disjuncts hold and the wrong one loses the answer.
-- ===== strict comparison =====
-- a ≤ b splits into "b ≤ a is an equality" and "b < a", by casing on
-- the witness LeN carries

import nat (+, *, plusZeroId, plusAssoc, plusComm, sucPlus, plusSucId, multComm, multDistrib, multSucId, sucMult)
import natOrder (LeN, leRefl, leOfEq, leZero, leZeroInv, leTrans, leSucSelf, leSucMono, leSucInv, leTotal, leMultMonoR, lePlusMonoL)
import natMore (∸, multDistribR)
import natDiv (natCase, natCaseElimEqD, leOfMonusZero, ltOfMonusSuc, leSucNotSelf, ltProdSuc)
import equality (trans, sym, cong, transport)
import id (Id, idToEq, eqToId)

def leSplit : {b a : ℕ} → El (LeN b a) → El (LeN a b) ⊎ El (LeN (S b) a)
  using (natOrder.LeN.unfold) ≔
  λb. λa. λh. (ℕ-elim (k. (b + k ≡ a) → El (LeN a b) ⊎ El (LeN (S b) a))
    (λe. inj₁ (leOfEq (sym ℕ b a (trans ℕ b (b + Z) a (sym ℕ (b + Z) b (plusZeroId b)) e))))
    (j rec. λe. inj₂ (j,
      eqToId
        (S b + j)
        a
        (trans
          ℕ
          (S b + j)
          (b + S j)
          a
          (trans
            ℕ
            (S b + j)
            (S (b + j))
            (b + S j)
            (sucPlus b j)
            (sym ℕ (b + S j) (S (b + j)) (plusSucId b j)))
          e)))
    (h .π₁))
    (idToEq ℕ (b + h .π₁) a (h .π₂))

def natCompare : (a b : ℕ) → El (LeN a b) ⊎ El (LeN (S b) a) ≔
  λa. λb. ⊎-elim (h. inj₁ h) (h. leSplit h) (leTotal a b)

-- ===== squares are monotone =====
def leMultMono : {a b c d : ℕ} → El (LeN a b) → El (LeN c d) → El (LeN (a * c) (b * d))
  using (natOrder.LeN.unfold) ≔
  λa. λb. λc. λd. λh1. λh2. leTrans
    (a * c)
    (b * c)
    (b * d)
    (leMultMonoR c h1)
    (transport
      ℕ
      (λw. LeN (b * c) w)
      (d * b)
      (b * d)
      (multComm b d)
      (transport ℕ (λw. LeN w (d * b)) (c * b) (b * c) (multComm b c) (leMultMonoR b h2)))

def leSquare : {a b : ℕ} → El (LeN a b) → El (LeN (a * a) (b * b)) ≔ λa. λb. λh. leMultMono h h

-- a positive number is at most its own square, which is why searching
-- up to m is enough
def leSelfSquare : (j : ℕ) → El (LeN (S j) (S j * S j)) using (natOrder.LeN.unfold) ≔
  λj. j
    * S j, eqToId (S j + j * S j) (S j * S j) (sym ℕ (S j * S j) (S j + j * S j) (sucMult j (S j)))

-- ===== the search =====
def isqrtAux : ℕ → ℕ → ℕ ≔ λm. λf. ℕ-elim Z (f' ih. natCase (S f') (λw. ih) (S f' * S f' ∸ m)) f

def isqrt : ℕ → ℕ ≔ λm. isqrtAux m m

-- ===== it is a lower approximant =====
def isqrtAuxLe : {m f : ℕ} → El (LeN (isqrtAux m f * isqrtAux m f) m)
  using (isqrtAux.eq, nat.*.eq) ≔
  λm. λf. ℕ-elim
    (leZero m)
    (f' ih. natCaseElimEqD
      ℕ
      (λr. LeN (r * r) m)
      (S f')
      (λw. isqrtAux m f')
      (S f' * S f' ∸ m)
      (λe. leOfMonusZero e)
      (λj. λe. ih))
    f

-- ===== ...and the largest one =====
def isqrtAuxMax : {m f k : ℕ} → El (LeN (k * k) m) → El (LeN k f) → El (LeN k (isqrtAux m f))
  using (isqrtAux.eq) ≔
  λm. λf. ℕ-elim
    (λk. λhk. λhf. hf)
    (f' ih. λk. λhk. λhf. natCaseElimEqD
      ℕ
      (λr. LeN k r)
      (S f')
      (λw. isqrtAux m f')
      (S f' * S f' ∸ m)
      (λe. hf)
      (λj. λe. ⊎-elim (w. El (LeN k (isqrtAux m f')))
        (h. ih k hk h)
        (h. 𝟘-elim (leSucNotSelf
          m
          (leTrans
            (S m)
            (S f' * S f')
            m
            (ltOfMonusSuc j e)
            (leTrans (S f' * S f') (k * k) m (leSquare h) hk))))
        (natCompare k f')))
    f

def isqrtLe : (m : ℕ) → El (LeN (isqrt m * isqrt m) m) using (isqrt.eq) ≔ λm. isqrtAuxLe

def isqrtMax : {m k : ℕ} → El (LeN (k * k) m) → El (LeN k m) → El (LeN k (isqrt m))
  using (isqrt.eq) ≔
  λm. λk. λh1. λh2. isqrtAuxMax h1 h2

-- the upper bound: if S (isqrt m) squared still fit under m, isqrt m
-- would have found it, and would be at least its own successor
def isqrtUpper : (m : ℕ) → El (LeN (S m) (S (isqrt m) * S (isqrt m))) ≔
  λm. ⊎-elim
    (h. 𝟘-elim (leSucNotSelf
      (isqrt m)
      (isqrtMax
        h
        (leTrans (S (isqrt m)) (S (isqrt m) * S (isqrt m)) m (leSelfSquare (isqrt m)) h))))
    (h. h)
    (natCompare (S (isqrt m) * S (isqrt m)) m)

-- ===== squares reflect the order =====
--
-- This is the fact ℝ's square root actually runs on. Comparing two
-- rational approximants r_m and r_n means comparing K_m/(D_m+1) with
-- (K_n+1)/(D_n+1), and cross-multiplying turns that into a comparison
-- of NATURALS — where "x² ≤ y² implies x ≤ y" is available (below)
-- and its ℚ counterpart is not: ℚ has no strict multiplication
-- monotonicity in the corpus, and getting it would mean sign
-- multiplicativity or division. At ℕ, natCompare settles it.
def ltSqSuc : (y : ℕ) → El (LeN (S (y * y)) (S y * S y)) ≔
  λy. leTrans
    (S (y * y))
    (S (y * S y))
    (S y * S y)
    (leSucMono (leMultMono (leRefl y) (leSucSelf y)))
    (ltProdSuc y y)

def leOfSqLe : {x y : ℕ} → El (LeN (x * x) (y * y)) → El (LeN x y) ≔
  λx. λy. λh. ⊎-elim
    (le. le)
    (lt. 𝟘-elim (leSucNotSelf
      (y * y)
      (leTrans
        (S (y * y))
        (x * x)
        (y * y)
        (leTrans (S (y * y)) (S y * S y) (x * x) (ltSqSuc y) (leSquare lt))
        h)))
    (natCompare x y)

-- ===== a square that overshoots by T overshoots by isqrt T =====
def plus4Swap : {a b p q : ℕ} → a + b + (p + q) ≡ a + p + (q + b) ≔
  λa. λb. λp. λq. a + b + (p + q)
      ≡⟨ plusAssoc a b (p + q) ⟩ a + (b + (p + q))
      ≡⟨ cong
        ℕ
        (λw. ℕ)
        (λw. a + w)
        (b + (p + q))
        (b + p + q)
        (sym ℕ (b + p + q) (b + (p + q)) (plusAssoc b p q)) ⟩ a + (b + p + q)
      ≡⟨ cong ℕ (λw. ℕ) (λw. a + (w + q)) (b + p) (p + b) (plusComm p b) ⟩ a + (p + b + q)
      ≡⟨ cong ℕ (λw. ℕ) (λw. a + w) (p + b + q) (p + (b + q)) (plusAssoc p b q) ⟩ a + (p + (b + q))
      ≡⟨ cong ℕ (λw. ℕ) (λw. a + (p + w)) (b + q) (q + b) (plusComm q b) ⟩ a + (p + (q + b))
      ≡⟨ sym ℕ (a + p + (q + b)) (a + (p + (q + b))) (plusAssoc a p (q + b)) ⟩ a + p + (q + b)

def sqExpand : (y c : ℕ) → (y + c) * (y + c) ≡ y * y + y * c + (y * c + c * c) ≔
  λy. λc. (y + c) * (y + c)
      ≡⟨ multDistribR (y + c) y c ⟩ y * (y + c) + c * (y + c)
      ≡⟨ cong
        ℕ
        (λw. ℕ)
        (λw. w + c * (y + c))
        (y * (y + c))
        (y * y + y * c)
        (multDistrib y y c) ⟩ y * y + y * c + c * (y + c)
      ≡⟨ cong
        ℕ
        (λw. ℕ)
        (λw. y * y + y * c + w)
        (c * (y + c))
        (c * y + c * c)
        (multDistrib c y c) ⟩ y * y + y * c + (c * y + c * c)
      ≡⟨ cong
        ℕ
        (λw. ℕ)
        (λw. y * y + y * c + (w + c * c))
        (c * y)
        (y * c)
        (multComm y c) ⟩ y * y + y * c + (y * c + c * c)

def sqSumLe : (y c : ℕ) → El (LeN (y * y + c * c) ((y + c) * (y + c))) using (natOrder.LeN.unfold) ≔
  λy. λc. y
    * c
    + y
      * c,
    eqToId
      (y * y + c * c + (y * c + y * c))
      ((y + c) * (y + c))
      (trans
        ℕ
        (y * y + c * c + (y * c + y * c))
        (y * y + y * c + (y * c + c * c))
        ((y + c) * (y + c))
        plus4Swap
        (sym ℕ ((y + c) * (y + c)) (y * y + y * c + (y * c + c * c)) (sqExpand y c)))

def sqrtStepN : {x y T : ℕ} → El (LeN (x * x) (y * y + T)) → El (LeN x (y + S (isqrt T))) ≔
  λx. λy. λT. λh. leOfSqLe
    (leTrans
      (x * x)
      (y * y + T)
      ((y + S (isqrt T)) * (y + S (isqrt T)))
      h
      (leTrans
        (y * y + T)
        (y * y + S (isqrt T) * S (isqrt T))
        ((y + S (isqrt T)) * (y + S (isqrt T)))
        (lePlusMonoL
          (y * y)
          (leTrans T (S T) (S (isqrt T) * S (isqrt T)) (leSucSelf T) (isqrtUpper T)))
        (sqSumLe y (S (isqrt T)))))

-- ===== isqrt is strictly under any c whose square overshoots =====
def isqrtLtOfLt : (T : ℕ) {c : ℕ} → El (LeN (S T) (c * c)) → El (LeN (S (isqrt T)) c) ≔
  λT. λc. λh. ⊎-elim
    (le. 𝟘-elim (leSucNotSelf
      T
      (leTrans
        (S T)
        (c * c)
        T
        h
        (leTrans (c * c) (isqrt T * isqrt T) T (leSquare le) (isqrtLe T)))))
    (lt. lt)
    (natCompare c (isqrt T))

-- ...and a sum of two POSITIVE squares is strictly under the square of
-- the sum, which is what makes isqrt of the error term fit
def plus4Mid : (a p q b : ℕ) → a + p + (q + b) ≡ a + b + (p + q) ≔
  λa. λp. λq. λb. a + p + (q + b)
      ≡⟨ plusAssoc a p (q + b) ⟩ a + (p + (q + b))
      ≡⟨ cong
        ℕ
        (λw. ℕ)
        (λw. a + w)
        (p + (q + b))
        (p + q + b)
        (sym ℕ (p + q + b) (p + (q + b)) (plusAssoc p q b)) ⟩ a + (p + q + b)
      ≡⟨ cong
        ℕ
        (λw. ℕ)
        (λw. a + w)
        (p + q + b)
        (b + (p + q))
        (plusComm b (p + q)) ⟩ a + (b + (p + q))
      ≡⟨ sym ℕ (a + b + (p + q)) (a + (b + (p + q))) (plusAssoc a b (p + q)) ⟩ a + b + (p + q)

def sucMultSuc : (x y : ℕ) → S x * S y ≡ S (x + S x * y) ≔
  λx. λy. S x * S y ≡⟨ multSucId (S x) y ⟩ S x + S x * y ≡⟨ sucPlus x (S x * y) ⟩ S (x + S x * y)

def sqSumStrict : (x y : ℕ) → El (LeN (S (S x * S x + S y * S y)) ((S x + S y) * (S x + S y)))
  using (natOrder.LeN.unfold) ≔
  λx. λy. x
    + S x
      * y
    + S (x
      + S x
        * y),
    eqToId
      (S (S x * S x + S y * S y) + (x + S x * y + S (x + S x * y)))
      ((S x + S y) * (S x + S y))
      (trans
        ℕ
        (S (S x * S x + S y * S y) + (x + S x * y + S (x + S x * y)))
        (S x * S x + S y * S y + (S x * S y + S x * S y))
        ((S x + S y) * (S x + S y))
        (trans
          ℕ
          (S (S x * S x + S y * S y) + (x + S x * y + S (x + S x * y)))
          (S (S x * S x + S y * S y + (x + S x * y + S (x + S x * y))))
          (S x * S x + S y * S y + (S x * S y + S x * S y))
          (sucPlus (S x * S x + S y * S y) (x + S x * y + S (x + S x * y)))
          (trans
            ℕ
            (S (S x * S x + S y * S y + (x + S x * y + S (x + S x * y))))
            (S x * S x + S y * S y + S (x + S x * y + S (x + S x * y)))
            (S x * S x + S y * S y + (S x * S y + S x * S y))
            (sym
              ℕ
              (S x * S x + S y * S y + S (x + S x * y + S (x + S x * y)))
              (S (S x * S x + S y * S y + (x + S x * y + S (x + S x * y))))
              (plusSucId (S x * S x + S y * S y) (x + S x * y + S (x + S x * y))))
            (cong
              ℕ
              (λw. ℕ)
              (λw. S x * S x + S y * S y + w)
              (S (x + S x * y + S (x + S x * y)))
              (S x * S y + S x * S y)
              (trans
                ℕ
                (S (x + S x * y + S (x + S x * y)))
                (S (x + S x * y) + S (x + S x * y))
                (S x * S y + S x * S y)
                (sym
                  ℕ
                  (S (x + S x * y) + S (x + S x * y))
                  (S (x + S x * y + S (x + S x * y)))
                  (sucPlus (x + S x * y) (S (x + S x * y))))
                (cong
                  ℕ
                  (λw. ℕ)
                  (λw. w + w)
                  (S (x + S x * y))
                  (S x * S y)
                  (sym ℕ (S x * S y) (S (x + S x * y)) (sucMultSuc x y)))))))
        (trans
          ℕ
          (S x * S x + S y * S y + (S x * S y + S x * S y))
          (S x * S x + S x * S y + (S x * S y + S y * S y))
          ((S x + S y) * (S x + S y))
          (sym
            ℕ
            (S x * S x + S x * S y + (S x * S y + S y * S y))
            (S x * S x + S y * S y + (S x * S y + S x * S y))
            (plus4Mid (S x * S x) (S x * S y) (S x * S y) (S y * S y)))
          (sym
            ℕ
            ((S x + S y) * (S x + S y))
            (S x * S x + S x * S y + (S x * S y + S y * S y))
            (sqExpand (S x) (S y)))))
