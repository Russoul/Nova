import nat (+, *, plusZeroId, sucPlus, plusSucId, multComm, sucMult)
import natOrder (LeN, leRefl, leOfEq, leZero, leZeroInv, leTrans, leSucMono,
                 leSucInv, leTotal, leMultMonoR)
import natMore (∸)
import natDiv (natCase, natCaseElimEqD, leOfMonusZero, ltOfMonusSuc,
                leSucNotSelf)
import equality (trans, sym, cong, transport)
import id (Id, idToEq, eqToId)

-- THE INTEGER SQUARE ROOT, and the two facts that pin it down:
--
--   isqrt m * isqrt m ≤ m        (it is a lower approximant)
--   m < S (isqrt m) * S (isqrt m)   (it is the LARGEST one)
--
-- Everything ℝ's square root will need bottoms out here. The rational
-- approximation to √u at depth N is isqrt of ⌊u·N²⌋ divided by N, and
-- the two bounds above are exactly what turns into |r² − u| ≤ 2/N.
--
-- `isqrtAux m f` searches downwards from f for the largest k with
-- k² ≤ m, so `isqrt m ≔ isqrtAux m m` is correct because k² ≤ m
-- forces k ≤ m. The test is `S f * S f ∸ m ≡ Z`, decided by natCase:
-- monus is a FUNCTION, so the branch taken is unambiguous even when
-- the two sides are equal — using leTotal here would be wrong, since
-- at k² = m both disjuncts hold and the wrong one loses the answer.

-- ===== strict comparison =====

-- a ≤ b splits into "b ≤ a is an equality" and "b < a", by casing on
-- the witness LeN carries
def leSplit : (b : ℕ) (a : ℕ) → El (LeN b a) →
  El (LeN a b) ⊎ El (LeN (S b) a) using (natOrder.LeN.unfold) ≔
  λb. λa. λh.
    (ℕ-elim (k. (b + k ≡ a ∈ ℕ) → El (LeN a b) ⊎ El (LeN (S b) a))
      (λe. inj₁ (leOfEq a b
                   (sym ℕ b a
                      (trans ℕ b (b + Z) a
                         (sym ℕ (b + Z) b (plusZeroId b)) e))))
      (j rec. λe.
        inj₂ (j , eqToId ℕ (S b + j) a
                    (trans ℕ (S b + j) (b + S j) a
                       (trans ℕ (S b + j) (S (b + j)) (b + S j)
                          (sucPlus b j)
                          (sym ℕ (b + S j) (S (b + j)) (plusSucId b j)))
                       e)))
      (h .π₁))
      (idToEq ℕ (b + h .π₁) a (h .π₂))

def natCompare : (a : ℕ) (b : ℕ) → El (LeN a b) ⊎ El (LeN (S b) a) ≔
  λa. λb.
    ⊎-elim (w. El (LeN a b) ⊎ El (LeN (S b) a))
      (h. inj₁ h)
      (h. leSplit b a h)
      (leTotal a b)

-- ===== squares are monotone =====

def leMultMono : (a : ℕ) (b : ℕ) (c : ℕ) (d : ℕ) →
  El (LeN a b) → El (LeN c d) → El (LeN (a * c) (b * d)) using (natOrder.LeN.unfold) ≔
  λa. λb. λc. λd. λh1. λh2.
    leTrans (a * c) (b * c) (b * d)
      (leMultMonoR a b c h1)
      (transport ℕ (λw. LeN (b * c) w) (d * b) (b * d) (multComm b d)
         (transport ℕ (λw. LeN w (d * b)) (c * b) (b * c) (multComm b c)
            (leMultMonoR c d b h2)))

def leSquare : (a : ℕ) (b : ℕ) → El (LeN a b) → El (LeN (a * a) (b * b)) ≔
  λa. λb. λh. leMultMono a b a b h h

-- a positive number is at most its own square, which is why searching
-- up to m is enough
def leSelfSquare : (j : ℕ) → El (LeN (S j) (S j * S j)) using (natOrder.LeN.unfold) ≔
  λj.
    (j * S j ,
     eqToId ℕ (S j + j * S j) (S j * S j)
       (sym ℕ (S j * S j) (S j + j * S j) (sucMult j (S j))))

-- ===== the search =====

def isqrtAux : ℕ → ℕ → ℕ ≔
  λm. λf.
    ℕ-elim (w. ℕ) Z
      (f' ih. natCase ℕ (S f') (λw. ih) (S f' * S f' ∸ m))
      f

def isqrt : ℕ → ℕ ≔ λm. isqrtAux m m

-- ===== it is a lower approximant =====

def isqrtAuxLe : (m : ℕ) (f : ℕ) →
  El (LeN (isqrtAux m f * isqrtAux m f) m) using (isqrtAux.eq, nat.*.eq) ≔
  λm. λf.
    ℕ-elim (f. El (LeN (isqrtAux m f * isqrtAux m f) m))
      (leZero m)
      (f' ih.
        natCaseElimEqD ℕ (λr. LeN (r * r) m) (S f') (λw. isqrtAux m f')
          (S f' * S f' ∸ m)
          (λe. leOfMonusZero (S f' * S f') m e)
          (λj. λe. ih))
      f

-- ===== ...and the largest one =====

def isqrtAuxMax : (m : ℕ) (f : ℕ) (k : ℕ) →
  El (LeN (k * k) m) → El (LeN k f) → El (LeN k (isqrtAux m f)) using (isqrtAux.eq) ≔
  λm. λf.
    ℕ-elim (f. (k : ℕ) → El (LeN (k * k) m) → El (LeN k f) →
                 El (LeN k (isqrtAux m f)))
      (λk. λhk. λhf. hf)
      (f' ih. λk. λhk. λhf.
        natCaseElimEqD ℕ (λr. LeN k r) (S f') (λw. isqrtAux m f')
          (S f' * S f' ∸ m)
          (λe. hf)
          (λj. λe.
            ⊎-elim (w. El (LeN k (isqrtAux m f')))
              (h. ih k hk h)
              (h. 𝟘-elim
                    (leSucNotSelf m
                       (leTrans (S m) (S f' * S f') m
                          (ltOfMonusSuc (S f' * S f') m j e)
                          (leTrans (S f' * S f') (k * k) m
                             (leSquare (S f') k h) hk))))
              (natCompare k f')))
      f

def isqrtLe : (m : ℕ) → El (LeN (isqrt m * isqrt m) m) using (isqrt.eq) ≔
  λm. isqrtAuxLe m m

def isqrtMax : (m : ℕ) (k : ℕ) →
  El (LeN (k * k) m) → El (LeN k m) → El (LeN k (isqrt m)) using (isqrt.eq) ≔
  λm. λk. λh1. λh2. isqrtAuxMax m m k h1 h2

-- the upper bound: if S (isqrt m) squared still fit under m, isqrt m
-- would have found it, and would be at least its own successor
def isqrtUpper : (m : ℕ) → El (LeN (S m) (S (isqrt m) * S (isqrt m))) ≔
  λm.
    ⊎-elim (w. El (LeN (S m) (S (isqrt m) * S (isqrt m))))
      (h. 𝟘-elim
            (leSucNotSelf (isqrt m)
               (isqrtMax m (S (isqrt m)) h
                  (leTrans (S (isqrt m)) (S (isqrt m) * S (isqrt m)) m
                     (leSelfSquare (isqrt m)) h))))
      (h. h)
      (natCompare (S (isqrt m) * S (isqrt m)) m)
