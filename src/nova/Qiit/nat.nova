-- ℕ as a QIIT (docs/NovaFoundation.txt, SUBSUMPTION): a one-line
-- signature, with the derived eliminator computing by el-qiit-beta.

data
  N : U
  z : El N
  s : El N → El N

plusQ : N → N → N using (Qiit.nat.N.unfold)
plusQ = λa b. NElim (λn. N) b (λn ih. s ih) a

plusQzl : (b : N) → plusQ z b ≡ b
  using (Qiit.nat.N.eq,
    Qiit.nat.N.unfold,
    Qiit.nat.NElim.eq,
    Qiit.nat.plusQ.eq,
    Qiit.nat.s.eq,
    Qiit.nat.z.eq)
plusQzl = λb. ⋆

plusQsl : (a b : N) → plusQ (s a) b ≡ s (plusQ a b)
  using (Qiit.nat.N.eq, Qiit.nat.N.unfold, Qiit.nat.NElim.eq, Qiit.nat.plusQ.eq, Qiit.nat.s.eq)
plusQsl = λa b. ⋆

-- induction: plusQ a z ≡ a, by NElimP at the equality PROP motive
-- (equality is Ω-valued: the prop-flavored eliminator carries Ω-valued
-- motives and, by proof irrelevance, needs no coherence arguments)
plusQzr : (a : N) → plusQ a z ≡ a
  using (hyp.rw,
    Qiit.nat.N.eq,
    Qiit.nat.N.unfold,
    Qiit.nat.NElim.eq,
    Qiit.nat.plusQ.eq,
    Qiit.nat.s.eq,
    Qiit.nat.z.eq)
plusQzr = λa. NElimP (λn. plusQ n z ≡ n) ⋆ (λn ih. let claim1 = ih in ⋆) a
