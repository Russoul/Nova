import nat (+, *, plusZeroId, zeroPlusId, plusComm, multZeroId, multSucId,
            multAssoc)
import natOrder (LeN, leTrans, leMultMonoR, lePlusMonoR)
import natSqrt (isqrt, isqrtLe, isqrtUpper, sqrtStepN)
import integer (Int, intOne)
import integerMul (intMul, intMulOneL)
import rational (NZ, nzOne, nzPos, nzMul, Rat, mkRat)
import rationalQ (Q, qcls, qAdd, qMul, qNeg, qZero, qOne, qAddZeroR, qMulCls,
                  ratMul, qMulAssoc, qMulComm, qMulOneR, qDistribR)
import rationalOrder (LeQ, leQTrans, leQMulMono)
import ratBound (Bnd, leQAdd)
import natMore (multLeftComm)
import ratHalf (leQZeroInvNat)
import ratAbs (leQZeroMul)
import ratNat (qOfNat, leQOfNat, leNOfQ, qOfNatAdd, qOfNatMul, qMulSucNat)
import ratCeil (qFloor, qNatBound, leQBound, leQZeroNat)
import ratFloor (leQFloor)
import real (qInvNat, rBound)
import realMul (mulIdx, qMulInvIdx)
import equality (trans, sym, cong, transport, transportP)

-- THE RATIONAL APPROXIMANT to √u, and the four facts about it that
-- everything downstream uses.
--
--   qSqrtAt u D  ≔  isqrt ⌊u⁺·(D+1)²⌋ / (D+1)
--
-- Written on the POSITIVE PART u⁺ = max u 0, so it is total: no
-- hypothesis is needed to form it, and on nonnegative u it is what it
-- should be. That matters because a positivity witness on ℝ lives in
-- a squash and cannot be eliminated into data (B-15) — a square root
-- that demanded one could not be defined at all.
--
-- The interface is deliberately small. Downstream never unfolds
-- qSqrtAt; it uses
--
--   leQFlBelow : ⌊w⌋ ≤ w                  (ratFloor)
--   leQFlAbove : w ≤ ⌊w⌋ + 1              (ratCeil)
--   isqrtLe    : K² ≤ ⌊w⌋                 (natSqrt)
--   isqrtUpper : ⌊w⌋ < (K+1)²             (natSqrt)
--
-- and the two bridges below that turn a ℕ comparison into a ℚ one.

-- ===== the approximant =====

def sqNat : ℕ → ℕ ≔ λD. S D * S D

def qScaled : El Q → ℕ → El Q ≔
  λu. λD. qMul u (qOfNat (sqNat D))

def leQZeroScaled : (u : El Q) (D : ℕ) → El (LeQ qZero u) →
  El (LeQ qZero (qScaled u D)) using (qScaled.eq) ≔
  λu. λD. λnn.
    leQZeroMul u (qOfNat (sqNat D)) nn (leQZeroNat (sqNat D))

-- ⌊u⁺·(D+1)²⌋, the natural the root is taken of
def qFl : El Q → ℕ → ℕ ≔ λu. λD. qFloor (qScaled u D)

def qSqrtNum : El Q → ℕ → ℕ ≔ λu. λD. isqrt (qFl u D)

def qSqrtAt : El Q → ℕ → El Q ≔
  λu. λD. qMul (qOfNat (qSqrtNum u D)) (qInvNat D)

-- ===== the four facts =====

def leQFlBelow : (u : El Q) (D : ℕ) → El (LeQ qZero u) →
  El (LeQ (qOfNat (qFl u D)) (qScaled u D)) using (qFl.eq) ≔
  λu. λD. λnn. leQFloor (qScaled u D) (leQZeroScaled u D nn)

def leQFlAbove : (u : El Q) (D : ℕ) →
  El (LeQ (qScaled u D) (qOfNat (S (qFl u D)))) using (qFl.eq, qScaled.eq, ratCeil.qNatBound.eq) ≔
  λu. λD. leQBound (qScaled u D)

def sqrtNumLe : (u : El Q) (D : ℕ) →
  El (LeN (qSqrtNum u D * qSqrtNum u D) (qFl u D)) using (qSqrtNum.eq) ≔
  λu. λD. isqrtLe (qFl u D)

def sqrtNumUpper : (u : El Q) (D : ℕ) →
  El (LeN (S (qFl u D)) (S (qSqrtNum u D) * S (qSqrtNum u D))) using (qSqrtNum.eq) ≔
  λu. λD. isqrtUpper (qFl u D)

-- ===== the two bridges =====

-- (D+1)·(1/(D+1)) is one, on the nose
def qMulInvNat : (D : ℕ) →
  qMul (qOfNat (S D)) (qInvNat D) ≡ qOne ∈ El Q using (integer.intOne.eq, rational.mkRat.eq, rational.nzOne.eq, rational.nzPos.eq, rational.ratOfInt.eq, rational.ratOne.eq, rationalQ.qOne.eq, rationalQ.qcls.eq, real.qInvNat.eq, realMul.mulIdx.eq) ≔
  λD.
    transportP ℕ (λw. qMul (qOfNat (S D)) (qInvNat w) ≡ qOne ∈ El Q)
      (mulIdx D Z) D
      (trans ℕ (mulIdx D Z) (Z + D) D
         (cong ℕ (λw. ℕ) (λw. Z + w) (D * S Z) D
            (trans ℕ (D * S Z) (D + D * Z) D
               (multSucId D Z)
               (trans ℕ (D + D * Z) (D + Z) D
                  (cong ℕ (λw. ℕ) (λw. D + w) (D * Z) Z (multZeroId D))
                  (plusZeroId D))))
         (zeroPlusId D))
      (transportP Q (λw. qMul (qOfNat (S D)) (qInvNat (mulIdx D Z)) ≡ w ∈ El Q)
         (qInvNat Z) qOne ⋆
         (qMulInvIdx D Z))

-- 1/((c+1)(m+1)) is 1/(c+1) times 1/(m+1). nzMul on two positive
-- denominators lands on c*m + c + m, which is mulIdx c m written the
-- other way round
def mulIdxNz : (c : ℕ) (m : ℕ) → c * m + c + m ≡ mulIdx c m ∈ ℕ
  using (realMul.mulIdx.eq) ≔
  λc. λm.
    ((c * m + c) + m
       ≡⟨ plusComm m (c * m + c) ⟩
     m + (c * m + c)
       ≡⟨ cong ℕ (λw. ℕ) (λw. m + w) (c * m + c) (c + c * m)
            (plusComm c (c * m)) ⟩
     m + (c + c * m)
       ≡⟨ cong ℕ (λw. ℕ) (λw. m + w) (c + c * m) (c * S m)
            (sym ℕ (c * S m) (c + c * m) (multSucId c m)) ⟩
     m + c * S m)

def nzPosMul : (c : ℕ) (m : ℕ) →
  nzMul (nzPos c) (nzPos m) ≡ nzPos (mulIdx c m) ∈ El NZ using (rational.nzMul.eq, rational.nzPos.eq) ≔
  λc. λm.
    cong ℕ (λw. NZ) (λw. nzPos w) (c * m + c + m) (mulIdx c m) (mulIdxNz c m)

def ratMulInv : (c : ℕ) (m : ℕ) →
  ratMul (mkRat intOne (nzPos c)) (mkRat intOne (nzPos m))
    ≡ mkRat (intMul intOne intOne) (nzMul (nzPos c) (nzPos m)) ∈ El Rat
  using (rationalQ.ratMul.eq, rational.mkRat.eq, rational.num.eq,
         rational.den.eq) ≔
  λc. λm. ⋆

def qInvNatCls : (k : ℕ) → qInvNat k ≡ qcls (mkRat intOne (nzPos k)) ∈ El Q
  using (real.qInvNat.eq) ≔ λk. ⋆

def qInvNatMulIdx : (c : ℕ) (m : ℕ) →
  qInvNat (mulIdx c m) ≡ qMul (qInvNat c) (qInvNat m) ∈ El Q ≔
  λc. λm.
    (qInvNat (mulIdx c m)
       ≡⟨ qInvNatCls (mulIdx c m) ⟩
     qcls (mkRat intOne (nzPos (mulIdx c m)))
       ≡⟨ cong NZ (λw. Q) (λw. qcls (mkRat intOne w))
            (nzPos (mulIdx c m)) (nzMul (nzPos c) (nzPos m))
            (sym NZ (nzMul (nzPos c) (nzPos m)) (nzPos (mulIdx c m))
               (nzPosMul c m)) ⟩
     qcls (mkRat intOne (nzMul (nzPos c) (nzPos m)))
       ≡⟨ cong Int (λw. Q) (λw. qcls (mkRat w (nzMul (nzPos c) (nzPos m))))
            intOne (intMul intOne intOne)
            (sym Int (intMul intOne intOne) intOne (intMulOneL intOne)) ⟩
     qcls (mkRat (intMul intOne intOne) (nzMul (nzPos c) (nzPos m)))
       ≡⟨ cong Rat (λw. Q) (λw. qcls w)
            (mkRat (intMul intOne intOne) (nzMul (nzPos c) (nzPos m)))
            (ratMul (mkRat intOne (nzPos c)) (mkRat intOne (nzPos m)))
            (sym Rat (ratMul (mkRat intOne (nzPos c)) (mkRat intOne (nzPos m)))
                     (mkRat (intMul intOne intOne)
                            (nzMul (nzPos c) (nzPos m)))
               (ratMulInv c m)) ⟩
     qcls (ratMul (mkRat intOne (nzPos c)) (mkRat intOne (nzPos m)))
       ≡⟨ sym Q (qMul (qcls (mkRat intOne (nzPos c)))
                      (qcls (mkRat intOne (nzPos m))))
            (qcls (ratMul (mkRat intOne (nzPos c)) (mkRat intOne (nzPos m))))
            (qMulCls (mkRat intOne (nzPos c)) (mkRat intOne (nzPos m))) ⟩
     qMul (qcls (mkRat intOne (nzPos c))) (qcls (mkRat intOne (nzPos m)))
       ≡⟨ cong Q (λw. Q) (λw. qMul w (qcls (mkRat intOne (nzPos m))))
            (qcls (mkRat intOne (nzPos c))) (qInvNat c)
            (sym Q (qInvNat c) (qcls (mkRat intOne (nzPos c)))
               (qInvNatCls c)) ⟩
     qMul (qInvNat c) (qcls (mkRat intOne (nzPos m)))
       ≡⟨ cong Q (λw. Q) (λw. qMul (qInvNat c) w)
            (qcls (mkRat intOne (nzPos m))) (qInvNat m)
            (sym Q (qInvNat m) (qcls (mkRat intOne (nzPos m)))
               (qInvNatCls m)) ⟩
     qMul (qInvNat c) (qInvNat m))

-- ===== comparing two approximants =====
--
-- The heart. Two approximants of DIFFERENT arguments at DIFFERENT
-- depths are compared by cross-multiplying to naturals, where
-- natSqrt's leOfSqLe applies. The rational work is only to produce
-- the ℕ inequality
--
--   ⌊u⁺(Dm+1)²⌋·(Dn+1)² ≤ (⌊v⁺(Dn+1)²⌋+1)·(Dm+1)² + T
--
-- from u⁺ ≤ v⁺ + d and d·(Dm+1)²(Dn+1)² ≤ T. Everything in it is a
-- chain of ≤; no strict order and no division appear.

def qMulSwap3 : (x : El Q) (y : El Q) (z : El Q) →
  qMul (qMul x y) z ≡ qMul (qMul x z) y ∈ El Q ≔
  λx. λy. λz.
    (qMul (qMul x y) z
       ≡⟨ qMulAssoc x y z ⟩
     qMul x (qMul y z)
       ≡⟨ cong Q (λw. Q) (λw. qMul x w) (qMul y z) (qMul z y) (qMulComm y z) ⟩
     qMul x (qMul z y)
       ≡⟨ sym Q (qMul (qMul x z) y) (qMul x (qMul z y)) (qMulAssoc x z y) ⟩
     qMul (qMul x z) y)

def qDistrib3 : (x : El Q) (y : El Q) (z : El Q) (w : El Q) →
  qMul (qMul (qAdd x y) z) w
    ≡ qAdd (qMul (qMul x z) w) (qMul (qMul y z) w) ∈ El Q ≔
  λx. λy. λz. λw.
    (qMul (qMul (qAdd x y) z) w
       ≡⟨ cong Q (λt. Q) (λt. qMul t w) (qMul (qAdd x y) z)
            (qAdd (qMul x z) (qMul y z)) (qDistribR z x y) ⟩
     qMul (qAdd (qMul x z) (qMul y z)) w
       ≡⟨ qDistribR w (qMul x z) (qMul y z) ⟩
     qAdd (qMul (qMul x z) w) (qMul (qMul y z) w))

def qNatSumEq : (a : ℕ) (b : ℕ) (T : ℕ) →
  qAdd (qMul (qOfNat a) (qOfNat b)) (qOfNat T) ≡ qOfNat (a * b + T) ∈ El Q ≔
  λa. λb. λT.
    (qAdd (qMul (qOfNat a) (qOfNat b)) (qOfNat T)
       ≡⟨ cong Q (λw. Q) (λw. qAdd w (qOfNat T))
            (qMul (qOfNat a) (qOfNat b)) (qOfNat (a * b)) (qOfNatMul a b) ⟩
     qAdd (qOfNat (a * b)) (qOfNat T)
       ≡⟨ qOfNatAdd (a * b) T ⟩
     qOfNat (a * b + T))

def flCompare : (u : El Q) (v : El Q) (Dm : ℕ) (Dn : ℕ) (T : ℕ) (d : El Q) →
  El (LeQ qZero u) →
  El (LeQ u (qAdd v d)) →
  El (LeQ (qMul (qMul d (qOfNat (sqNat Dm))) (qOfNat (sqNat Dn))) (qOfNat T)) →
  El (LeN (qFl u Dm * sqNat Dn) (S (qFl v Dn) * sqNat Dm + T)) using (qScaled.eq) ≔
  λu. λv. λDm. λDn. λT. λd. λnnu. λh1. λh2.
    leNOfQ (qFl u Dm * sqNat Dn) (S (qFl v Dn) * sqNat Dm + T)
      (transport Q
         (λw. LeQ w (qOfNat (S (qFl v Dn) * sqNat Dm + T)))
         (qMul (qOfNat (qFl u Dm)) (qOfNat (sqNat Dn)))
         (qOfNat (qFl u Dm * sqNat Dn))
         (qOfNatMul (qFl u Dm) (sqNat Dn))
         (transport Q
            (λw. LeQ (qMul (qOfNat (qFl u Dm)) (qOfNat (sqNat Dn))) w)
            (qAdd (qMul (qOfNat (S (qFl v Dn))) (qOfNat (sqNat Dm)))
                  (qOfNat T))
            (qOfNat (S (qFl v Dn) * sqNat Dm + T))
            (qNatSumEq (S (qFl v Dn)) (sqNat Dm) T)
            (leQTrans (qMul (qOfNat (qFl u Dm)) (qOfNat (sqNat Dn)))
                      (qMul (qMul u (qOfNat (sqNat Dm)))
                            (qOfNat (sqNat Dn)))
                      (qAdd (qMul (qOfNat (S (qFl v Dn))) (qOfNat (sqNat Dm)))
                            (qOfNat T))
               (leQMulMono (qOfNat (qFl u Dm))
                           (qMul u (qOfNat (sqNat Dm)))
                           (qOfNat (sqNat Dn))
                  (leQFlBelow u Dm nnu) (leQZeroNat (sqNat Dn)))
               (leQTrans (qMul (qMul u (qOfNat (sqNat Dm)))
                               (qOfNat (sqNat Dn)))
                         (qMul (qMul (qAdd v d) (qOfNat (sqNat Dm)))
                               (qOfNat (sqNat Dn)))
                         (qAdd (qMul (qOfNat (S (qFl v Dn)))
                                     (qOfNat (sqNat Dm)))
                               (qOfNat T))
                  (leQMulMono (qMul u (qOfNat (sqNat Dm)))
                              (qMul (qAdd v d) (qOfNat (sqNat Dm)))
                              (qOfNat (sqNat Dn))
                     (leQMulMono u (qAdd v d)
                                 (qOfNat (sqNat Dm))
                        h1 (leQZeroNat (sqNat Dm)))
                     (leQZeroNat (sqNat Dn)))
                  (transport Q
                     (λw. LeQ w (qAdd (qMul (qOfNat (S (qFl v Dn)))
                                            (qOfNat (sqNat Dm)))
                                      (qOfNat T)))
                     (qAdd (qMul (qMul v (qOfNat (sqNat Dm)))
                                 (qOfNat (sqNat Dn)))
                           (qMul (qMul d (qOfNat (sqNat Dm)))
                                 (qOfNat (sqNat Dn))))
                     (qMul (qMul (qAdd v d) (qOfNat (sqNat Dm)))
                           (qOfNat (sqNat Dn)))
                     (sym Q (qMul (qMul (qAdd v d) (qOfNat (sqNat Dm)))
                                  (qOfNat (sqNat Dn)))
                            (qAdd (qMul (qMul v (qOfNat (sqNat Dm)))
                                        (qOfNat (sqNat Dn)))
                                  (qMul (qMul d (qOfNat (sqNat Dm)))
                                        (qOfNat (sqNat Dn))))
                        (qDistrib3 v d (qOfNat (sqNat Dm))
                                   (qOfNat (sqNat Dn))))
                     (leQAdd (qMul (qMul v (qOfNat (sqNat Dm)))
                                   (qOfNat (sqNat Dn)))
                             (qMul (qOfNat (S (qFl v Dn)))
                                   (qOfNat (sqNat Dm)))
                             (qMul (qMul d (qOfNat (sqNat Dm)))
                                   (qOfNat (sqNat Dn)))
                             (qOfNat T)
                        (transport Q
                           (λw. LeQ w (qMul (qOfNat (S (qFl v Dn)))
                                            (qOfNat (sqNat Dm))))
                           (qMul (qMul v (qOfNat (sqNat Dn)))
                                 (qOfNat (sqNat Dm)))
                           (qMul (qMul v (qOfNat (sqNat Dm)))
                                 (qOfNat (sqNat Dn)))
                           (sym Q (qMul (qMul v (qOfNat (sqNat Dm)))
                                        (qOfNat (sqNat Dn)))
                                  (qMul (qMul v (qOfNat (sqNat Dn)))
                                        (qOfNat (sqNat Dm)))
                              (qMulSwap3 v (qOfNat (sqNat Dm))
                                         (qOfNat (sqNat Dn))))
                           (leQMulMono (qMul v (qOfNat (sqNat Dn)))
                                       (qOfNat (S (qFl v Dn)))
                                       (qOfNat (sqNat Dm))
                              (leQFlAbove v Dn) (leQZeroNat (sqNat Dm))))
                        h2))))))

-- ===== ...and back to a comparison of approximants =====

-- (a·b)² = a²·b², so cross-multiplying commutes with squaring
def mulSq : (a : ℕ) (b : ℕ) → (a * b) * (a * b) ≡ (a * a) * (b * b) ∈ ℕ ≔
  λa. λb.
    ((a * b) * (a * b)
       ≡⟨ multAssoc a b (a * b) ⟩
     a * (b * (a * b))
       ≡⟨ cong ℕ (λw. ℕ) (λw. a * w) (b * (a * b)) (a * (b * b))
            (multLeftComm b a b) ⟩
     a * (a * (b * b))
       ≡⟨ sym ℕ ((a * a) * (b * b)) (a * (a * (b * b)))
            (multAssoc a a (b * b)) ⟩
     (a * a) * (b * b))

def sqrtCompareN : (u : El Q) (v : El Q) (Dm : ℕ) (Dn : ℕ) (T : ℕ) (d : El Q) →
  El (LeQ qZero u) →
  El (LeQ u (qAdd v d)) →
  El (LeQ (qMul (qMul d (qOfNat (sqNat Dm))) (qOfNat (sqNat Dn))) (qOfNat T)) →
  El (LeN (qSqrtNum u Dm * S Dn)
          (S (qSqrtNum v Dn) * S Dm + S (isqrt T))) using (sqNat.eq) ≔
  λu. λv. λDm. λDn. λT. λd. λnnu. λh1. λh2.
    sqrtStepN (qSqrtNum u Dm * S Dn) (S (qSqrtNum v Dn) * S Dm) T
      (transport ℕ
         (λw. LeN w ((S (qSqrtNum v Dn) * S Dm) * (S (qSqrtNum v Dn) * S Dm) + T))
         ((qSqrtNum u Dm * qSqrtNum u Dm) * (S Dn * S Dn))
         ((qSqrtNum u Dm * S Dn) * (qSqrtNum u Dm * S Dn))
         (sym ℕ ((qSqrtNum u Dm * S Dn) * (qSqrtNum u Dm * S Dn))
                ((qSqrtNum u Dm * qSqrtNum u Dm) * (S Dn * S Dn))
            (mulSq (qSqrtNum u Dm) (S Dn)))
         (transport ℕ
            (λw. LeN ((qSqrtNum u Dm * qSqrtNum u Dm) * (S Dn * S Dn)) (w + T))
            ((S (qSqrtNum v Dn) * S (qSqrtNum v Dn)) * (S Dm * S Dm))
            ((S (qSqrtNum v Dn) * S Dm) * (S (qSqrtNum v Dn) * S Dm))
            (sym ℕ ((S (qSqrtNum v Dn) * S Dm) * (S (qSqrtNum v Dn) * S Dm))
                   ((S (qSqrtNum v Dn) * S (qSqrtNum v Dn)) * (S Dm * S Dm))
               (mulSq (S (qSqrtNum v Dn)) (S Dm)))
            (leTrans ((qSqrtNum u Dm * qSqrtNum u Dm) * (S Dn * S Dn))
                     (qFl u Dm * sqNat Dn)
                     ((S (qSqrtNum v Dn) * S (qSqrtNum v Dn)) * (S Dm * S Dm)
                        + T)
               (leMultMonoR (qSqrtNum u Dm * qSqrtNum u Dm) (qFl u Dm)
                            (sqNat Dn) (sqrtNumLe u Dm))
               (leTrans (qFl u Dm * sqNat Dn)
                        (S (qFl v Dn) * sqNat Dm + T)
                        ((S (qSqrtNum v Dn) * S (qSqrtNum v Dn))
                           * (S Dm * S Dm) + T)
                  (flCompare u v Dm Dn T d nnu h1 h2)
                  (lePlusMonoR (S (qFl v Dn) * sqNat Dm)
                               ((S (qSqrtNum v Dn) * S (qSqrtNum v Dn))
                                  * (S Dm * S Dm))
                               T
                     (leMultMonoR (S (qFl v Dn))
                                  (S (qSqrtNum v Dn) * S (qSqrtNum v Dn))
                                  (sqNat Dm) (sqrtNumUpper v Dn)))))))

-- ===== ...and back to a comparison of approximants =====

def qMulLeftComm : (x : El Q) (y : El Q) (z : El Q) →
  qMul x (qMul y z) ≡ qMul y (qMul x z) ∈ El Q ≔
  λx. λy. λz.
    (qMul x (qMul y z)
       ≡⟨ sym Q (qMul (qMul x y) z) (qMul x (qMul y z)) (qMulAssoc x y z) ⟩
     qMul (qMul x y) z
       ≡⟨ cong Q (λw. Q) (λw. qMul w z) (qMul x y) (qMul y x) (qMulComm x y) ⟩
     qMul (qMul y x) z
       ≡⟨ qMulAssoc y x z ⟩
     qMul y (qMul x z))

-- the denominator cancels its own numeral, exactly
def cancelDen : (A : El Q) (D : ℕ) (e : El Q) →
  qMul (qMul A (qOfNat (S D))) (qMul e (qInvNat D)) ≡ qMul A e ∈ El Q ≔
  λA. λD. λe.
    (qMul (qMul A (qOfNat (S D))) (qMul e (qInvNat D))
       ≡⟨ qMulAssoc A (qOfNat (S D)) (qMul e (qInvNat D)) ⟩
     qMul A (qMul (qOfNat (S D)) (qMul e (qInvNat D)))
       ≡⟨ cong Q (λw. Q) (λw. qMul A w)
            (qMul (qOfNat (S D)) (qMul e (qInvNat D)))
            (qMul e (qMul (qOfNat (S D)) (qInvNat D)))
            (qMulLeftComm (qOfNat (S D)) e (qInvNat D)) ⟩
     qMul A (qMul e (qMul (qOfNat (S D)) (qInvNat D)))
       ≡⟨ cong Q (λw. Q) (λw. qMul A (qMul e w))
            (qMul (qOfNat (S D)) (qInvNat D)) qOne (qMulInvNat D) ⟩
     qMul A (qMul e qOne)
       ≡⟨ cong Q (λw. Q) (λw. qMul A w) (qMul e qOne) e (qMulOneR e) ⟩
     qMul A e)

-- a ℕ inequality between cross-multiplied numerators IS a ℚ
-- inequality between the fractions
def crossToQ : (a : ℕ) (b : ℕ) (e : ℕ) (Dm : ℕ) (Dn : ℕ) →
  El (LeN (a * S Dn) (b * S Dm + e)) →
  El (LeQ (qMul (qOfNat a) (qInvNat Dm))
          (qAdd (qMul (qOfNat b) (qInvNat Dn))
                (qMul (qOfNat e) (qMul (qInvNat Dm) (qInvNat Dn))))) ≔
  λa. λb. λe. λDm. λDn. λle.
    transport Q
      (λw. LeQ w (qAdd (qMul (qOfNat b) (qInvNat Dn))
                       (qMul (qOfNat e) (qMul (qInvNat Dm) (qInvNat Dn)))))
      (qMul (qMul (qOfNat a) (qOfNat (S Dn)))
            (qMul (qInvNat Dm) (qInvNat Dn)))
      (qMul (qOfNat a) (qInvNat Dm))
      (cancelDen (qOfNat a) Dn (qInvNat Dm))
      (transport Q
         (λw. LeQ (qMul (qMul (qOfNat a) (qOfNat (S Dn)))
                        (qMul (qInvNat Dm) (qInvNat Dn))) w)
         (qAdd (qMul (qMul (qOfNat b) (qOfNat (S Dm)))
                     (qMul (qInvNat Dm) (qInvNat Dn)))
               (qMul (qOfNat e) (qMul (qInvNat Dm) (qInvNat Dn))))
         (qAdd (qMul (qOfNat b) (qInvNat Dn))
               (qMul (qOfNat e) (qMul (qInvNat Dm) (qInvNat Dn))))
         (cong Q (λw. Q)
            (λw. qAdd w (qMul (qOfNat e) (qMul (qInvNat Dm) (qInvNat Dn))))
            (qMul (qMul (qOfNat b) (qOfNat (S Dm)))
                  (qMul (qInvNat Dm) (qInvNat Dn)))
            (qMul (qOfNat b) (qInvNat Dn))
            (trans Q (qMul (qMul (qOfNat b) (qOfNat (S Dm)))
                           (qMul (qInvNat Dm) (qInvNat Dn)))
                     (qMul (qMul (qOfNat b) (qOfNat (S Dm)))
                           (qMul (qInvNat Dn) (qInvNat Dm)))
                     (qMul (qOfNat b) (qInvNat Dn))
               (cong Q (λw. Q)
                  (λw. qMul (qMul (qOfNat b) (qOfNat (S Dm))) w)
                  (qMul (qInvNat Dm) (qInvNat Dn))
                  (qMul (qInvNat Dn) (qInvNat Dm))
                  (qMulComm (qInvNat Dm) (qInvNat Dn)))
               (cancelDen (qOfNat b) Dm (qInvNat Dn))))
         (transport Q
            (λw. LeQ (qMul (qMul (qOfNat a) (qOfNat (S Dn)))
                           (qMul (qInvNat Dm) (qInvNat Dn))) w)
            (qMul (qAdd (qMul (qOfNat b) (qOfNat (S Dm))) (qOfNat e))
                  (qMul (qInvNat Dm) (qInvNat Dn)))
            (qAdd (qMul (qMul (qOfNat b) (qOfNat (S Dm)))
                        (qMul (qInvNat Dm) (qInvNat Dn)))
                  (qMul (qOfNat e) (qMul (qInvNat Dm) (qInvNat Dn))))
            (qDistribR (qMul (qInvNat Dm) (qInvNat Dn))
                       (qMul (qOfNat b) (qOfNat (S Dm))) (qOfNat e))
            (leQMulMono (qMul (qOfNat a) (qOfNat (S Dn)))
                        (qAdd (qMul (qOfNat b) (qOfNat (S Dm))) (qOfNat e))
                        (qMul (qInvNat Dm) (qInvNat Dn))
               (transport Q
                  (λw. LeQ w (qAdd (qMul (qOfNat b) (qOfNat (S Dm)))
                                   (qOfNat e)))
                  (qOfNat (a * S Dn))
                  (qMul (qOfNat a) (qOfNat (S Dn)))
                  (sym Q (qMul (qOfNat a) (qOfNat (S Dn))) (qOfNat (a * S Dn))
                     (qOfNatMul a (S Dn)))
                  (transport Q (λw. LeQ (qOfNat (a * S Dn)) w)
                     (qOfNat (b * S Dm + e))
                     (qAdd (qMul (qOfNat b) (qOfNat (S Dm))) (qOfNat e))
                     (sym Q (qAdd (qMul (qOfNat b) (qOfNat (S Dm))) (qOfNat e))
                            (qOfNat (b * S Dm + e))
                        (qNatSumEq b (S Dm) e))
                     (leQOfNat (a * S Dn) (b * S Dm + e) le)))
               (leQZeroMul (qInvNat Dm) (qInvNat Dn)
                  (leQZeroInvNat Dm) (leQZeroInvNat Dn)))))

-- ===== THE comparison, in ℚ =====
--
--   √u at depth Dm  ≤  √v at depth Dn  +  1/(Dn+1)  +  (isqrt T + 1)/((Dm+1)(Dn+1))
--
-- given u⁺ ≤ v⁺ + d and d·(Dm+1)²(Dn+1)² ≤ T. The first slack term is
-- the approximation error at n; the second is √ of the gap d, and it
-- is where "√ is not Lipschitz" is paid for.
def leQSqrtStep : (u : El Q) (v : El Q) (Dm : ℕ) (Dn : ℕ) (T : ℕ) (d : El Q) →
  El (LeQ qZero u) →
  El (LeQ u (qAdd v d)) →
  El (LeQ (qMul (qMul d (qOfNat (sqNat Dm))) (qOfNat (sqNat Dn))) (qOfNat T)) →
  El (LeQ (qSqrtAt u Dm)
          (qAdd (qAdd (qSqrtAt v Dn) (qInvNat Dn))
                (qMul (qOfNat (S (isqrt T)))
                      (qMul (qInvNat Dm) (qInvNat Dn))))) using (qSqrtAt.eq) ≔
  λu. λv. λDm. λDn. λT. λd. λnnu. λh1. λh2.
    transport Q
      (λw. LeQ (qSqrtAt u Dm)
               (qAdd w (qMul (qOfNat (S (isqrt T)))
                             (qMul (qInvNat Dm) (qInvNat Dn)))))
      (qMul (qOfNat (S (qSqrtNum v Dn))) (qInvNat Dn))
      (qAdd (qSqrtAt v Dn) (qInvNat Dn))
      (qMulSucNat (qSqrtNum v Dn) (qInvNat Dn))
      (crossToQ (qSqrtNum u Dm) (S (qSqrtNum v Dn)) (S (isqrt T)) Dm Dn
         (sqrtCompareN u v Dm Dn T d nnu h1 h2))
