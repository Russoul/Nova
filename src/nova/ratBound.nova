-- Two-sided bounds on ℚ, stated WITHOUT an absolute value: `Bnd b u`
-- says −b ≤ u ≤ b. This is the shape every regularity/closeness
-- condition in real.nova already has, and the shape the triangle
-- inequality wants — |u + v| ≤ |u| + |v| becomes bndAdd, with no
-- case split on signs anywhere, because the two halves of a two-sided
-- bound add independently.
--
-- Everything here is order algebra over rationalOrder.nova; nothing
-- below inspects a representative.
-- ===== order lemmas the bound algebra needs =====
-- negation reverses ≤ : the two differences are the same rational

import rationalQ (Q, +, qNeg, qZero, qAddComm, qAddAssoc, qAddZeroL, qAddZeroR, qAddNegL, qAddNegR, qNegNeg)
import rationalOrder (Sign, sPos, sNeg, sZero, sgnQ, NonNegS, ≤, leQRefl, leQOfEq, leQTrans, sZeroNotNeg, sPosNotNeg, sZeroNotPos, leQPlusMono, leQPlusMonoL, qNegAdd, qPairSwap, qSubSplit, qSubPlusCancel)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)
import uip (uip)
import eqInt (pairEq2)

def leQNegFlip : (x y : El Q) → El (x ≤ y) → El (qNeg y ≤ qNeg x)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λh. transport
    Q
    (λw. NonNegS (sgnQ w))
    (y + qNeg x)
    (qNeg x + qNeg (qNeg y))
    (y + qNeg x
        ≡⟨ qAddComm y (qNeg x) ⟩ qNeg x + y
        ≡⟨ cong
          Q
          (λw. Q)
          (λw. qNeg x + w)
          y
          (qNeg (qNeg y))
          (sym Q (qNeg (qNeg y)) y (qNegNeg y)) ⟩ qNeg x + qNeg (qNeg y))
    h

-- ...and back: (−y) ≤ (−x) gives x ≤ y, by flipping once more
def leQNegFlipBack : (x y : El Q) → El (qNeg y ≤ qNeg x) → El (x ≤ y)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λx. λy. λh. transport
    Q
    (λw. w ≤ y)
    (qNeg (qNeg x))
    x
    (qNegNeg x)
    (transport
      Q
      (λw. qNeg (qNeg x) ≤ w)
      (qNeg (qNeg y))
      y
      (qNegNeg y)
      (leQNegFlip (qNeg y) (qNeg x) h))

-- ≤ adds in BOTH arguments — two monotonicity steps and a hop
def leQAdd : (x y z w : El Q) → El (x ≤ y) → El (z ≤ w) → El (x + z ≤ y + w)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λx. λy. λz. λw. λh1. λh2. leQTrans
    (x + z)
    (y + z)
    (y + w)
    (leQPlusMono z h1)
    (leQPlusMonoL z w y h2)

-- ===== the bound relation =====
def Bnd : El Q → El Q → 𝕌 ≔ λb. λu. qNeg b ≤ u ⨯ u ≤ b

def bndLo : (b u : El Q) → El (Bnd b u) → El (qNeg b ≤ u)
  using (ratBound.Bnd.unfold, rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λb. λu. λh. h .π₁

def bndHi : (b u : El Q) → El (Bnd b u) → El (u ≤ b)
  using (ratBound.Bnd.unfold, rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λb. λu. λh. h .π₂

-- the triangle inequality, in two-sided form
def bndAdd : {a b u v : El Q} → El (Bnd a u) → El (Bnd b v) → El (Bnd (a + b) (u + v))
  using (ratBound.Bnd.unfold) ≔
  λa. λb. λu. λv. λhu. λhv. transport
    Q
    (λw. w ≤ u + v)
    (qNeg a + qNeg b)
    (qNeg (a + b))
    (sym Q (qNeg (a + b)) (qNeg a + qNeg b) (qNegAdd a b))
    (leQAdd (qNeg a) u (qNeg b) v (hu .π₁) (hv .π₁)), leQAdd u a v b (hu .π₂) (hv .π₂)

-- a bound on u bounds −u, with the same b
def bndNeg : (b u : El Q) → El (Bnd b u) → El (Bnd b (qNeg u)) using (ratBound.Bnd.unfold) ≔
  λb. λu. λh. leQNegFlip
    u
    b
    (h .π₂),
    transport Q (λw. qNeg u ≤ w) (qNeg (qNeg b)) b (qNegNeg b) (leQNegFlip (qNeg b) u (h .π₁))

-- a bound transports along an equality of the bounded rational
def bndEq : {b : El Q} (u v : El Q) → (u ≡ v) → El (Bnd b u) → El (Bnd b v)
  using (ratBound.Bnd.unfold) ≔
  λb. λu. λv. λe. λh. transport Q (λw. Bnd b w) u v e h

-- ...and along an equality of the bound
def bndEqB : (a b u : El Q) → (a ≡ b) → El (Bnd a u) → El (Bnd b u) using (ratBound.Bnd.unfold) ≔
  λa. λb. λu. λe. λh. transport Q (λw. Bnd w u) a b e h

-- a bound weakens to any larger bound
def bndWeaken : (a b u : El Q) → El (a ≤ b) → El (Bnd a u) → El (Bnd b u)
  using (ratBound.Bnd.unfold) ≔
  λa. λb. λu. λle. λh. leQTrans
    (qNeg b)
    (qNeg a)
    u
    (leQNegFlip a b le)
    (h .π₁), leQTrans u a b (h .π₂) le

-- ===== zero =====
def qNegZeroQ : qNeg qZero ≡ qZero
  using (integer.intNeg.eq,
    integer.intZero.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.ratNeg.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- 0 is bounded by every nonnegative b
def bndZero : (b : El Q) → El (qZero ≤ b) → El (Bnd b qZero) using (ratBound.Bnd.unfold) ≔
  λb. λle. transport Q (λw. qNeg b ≤ w) (qNeg qZero) qZero qNegZeroQ (leQNegFlip qZero b le), le

-- a difference of EQUAL rationals is bounded by every nonnegative b
def bndSubEq : (b u v : El Q) → El (qZero ≤ b) → (u ≡ v) → El (Bnd b (u + qNeg v))
  using (ratBound.Bnd.unfold) ≔
  λb. λu. λv. λle. λe. bndEq
    qZero
    (u + qNeg v)
    (sym
      Q
      (u + qNeg v)
      qZero
      (trans
        Q
        (u + qNeg v)
        (v + qNeg v)
        qZero
        (cong Q (λw. Q) (λw. w + qNeg v) u v e)
        (qAddNegR v)))
    (bndZero b le)

-- ===== reassociating a difference =====
-- (u − w) ≡ (u − v) + (v − w): the standard three-term split, so a
-- bound on a difference follows from bounds on the two legs
def qSubVia : (u v w : El Q) → u + qNeg v + (v + qNeg w) ≡ u + qNeg w ≔ λu. λv. λw. qSubSplit w v u

-- the triangle inequality for differences, through a midpoint
def bndVia : (a b u v w : El Q)
  → El (Bnd a (u + qNeg v)) → El (Bnd b (v + qNeg w)) → El (Bnd (a + b) (u + qNeg w))
  using (ratBound.Bnd.unfold) ≔
  λa. λb. λu. λv. λw. λh1. λh2. bndEq
    (u + qNeg v + (v + qNeg w))
    (u + qNeg w)
    (qSubVia u v w)
    (bndAdd h1 h2)

-- −(u − v) ≡ v − u, so a bound on one difference bounds the other
def qSubFlip : (u v : El Q) → qNeg (u + qNeg v) ≡ v + qNeg u using (rationalQ.Q.unfold) ≔
  λu. λv. qNeg (u + qNeg v)
      ≡⟨ qNegAdd u (qNeg v) ⟩ qNeg u + qNeg (qNeg v)
      ≡⟨ cong Q (λz. Q) (λz. qNeg u + z) (qNeg (qNeg v)) v (qNegNeg v) ⟩ qNeg u + v
      ≡⟨ qAddComm (qNeg u) v ⟩ v + qNeg u

def bndSubSym : (b u v : El Q) → El (Bnd b (u + qNeg v)) → El (Bnd b (v + qNeg u))
  using (ratBound.Bnd.unfold) ≔
  λb. λu. λv. λh. bndEq (qNeg (u + qNeg v)) (v + qNeg u) (qSubFlip u v) (bndNeg b (u + qNeg v) h)

-- ===== differences of sums =====
-- (a − b) + (c − d) ≡ (a + c) − (b + d): the two differences of a
-- componentwise sum add. This is what makes bndAdd applicable to a
-- difference of SUMS, which is every well-definedness goal for +.
def qSubAdd : (a b c d : El Q) → a + qNeg b + (c + qNeg d) ≡ a + c + qNeg (b + d)
  using (rationalQ.Q.unfold) ≔
  λa. λb. λc. λd. a + qNeg b + (c + qNeg d)
      ≡⟨ qPairSwap a (qNeg b) c (qNeg d) ⟩ a + c + (qNeg b + qNeg d)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. a + c + w)
        (qNeg b + qNeg d)
        (qNeg (b + d))
        (sym Q (qNeg (b + d)) (qNeg b + qNeg d) (qNegAdd b d)) ⟩ a + c + qNeg (b + d)

-- a common LEFT summand cancels from a difference (rationalOrder has
-- the right-summand version)
def qSubPlusCancelL : (x y w : El Q) → w + y + qNeg (w + x) ≡ y + qNeg x
  using (rationalQ.Q.unfold) ≔
  λx. λy. λw. w + y + qNeg (w + x)
      ≡⟨ cong Q (λv. Q) (λv. v + qNeg (w + x)) (w + y) (y + w) (qAddComm w y) ⟩ y + w + qNeg (w + x)
      ≡⟨ cong Q (λv. Q) (λv. y + w + qNeg v) (w + x) (x + w) (qAddComm w x) ⟩ y + w + qNeg (x + w)
      ≡⟨ qSubPlusCancel x y w ⟩ y + qNeg x

-- ===== nonnegativity from a positive sign =====
-- u − 0 is u : the one rewriting step every 0 ≤ u proof needs
def qSubZeroR : {u : El Q} → u + qNeg qZero ≡ u ≔
  λu. trans
    Q
    (u + qNeg qZero)
    (u + qZero)
    u
    (cong Q (λv. Q) (λv. u + v) (qNeg qZero) qZero qNegZeroQ)
    (qAddZeroR u)

-- 0 ≤ u whenever u's sign is nonnegative
def leQZeroOfNonNeg : (u : El Q) → El (NonNegS (sgnQ u)) → El (qZero ≤ u)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λu. λh. transport
    Sign
    NonNegS
    (sgnQ u)
    (sgnQ (u + qNeg qZero))
    (sym
      Sign
      (sgnQ (u + qNeg qZero))
      (sgnQ u)
      (cong Q (λv. Sign) (λv. sgnQ v) (u + qNeg qZero) u qSubZeroR))
    h

-- 0 ≤ u whenever u's sign is positive: the difference u − 0 is u
def leQZeroOfPos : (u : El Q) → (sgnQ u ≡ sPos) → El (qZero ≤ u)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λh. inj₂ (eqToId
    (sgnQ (u + qNeg qZero))
    sPos
    (trans
      Sign
      (sgnQ (u + qNeg qZero))
      (sgnQ u)
      sPos
      (cong Q (λv. Sign) (λv. sgnQ v) (u + qNeg qZero) u qSubZeroR)
      h))

-- ===== growing a bound by a nonnegative amount =====
def leQSelfAdd : (a : El Q) {b : El Q} → El (qZero ≤ b) → El (a ≤ a + b)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λle. transport Q (λw. w ≤ a + b) (a + qZero) a (qAddZeroR a) (leQPlusMonoL qZero b a le)

def leQSelfAddL : {a b : El Q} → El (qZero ≤ b) → El (a ≤ b + a)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λle. transport Q (λw. a ≤ w) (a + b) (b + a) (qAddComm a b) (leQSelfAdd a le)

-- the ONE-SIDED triangle inequality: a difference splits through a
-- midpoint and the two upper bounds add
def leQVia : {a b u : El Q}
  (v : El Q)
  {w : El Q}
  → El (u + qNeg v ≤ a) → El (v + qNeg w ≤ b) → El (u + qNeg w ≤ a + b)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λu. λv. λw. λh1. λh2. transport
    Q
    (λz. z ≤ a + b)
    (u + qNeg v + (v + qNeg w))
    (u + qNeg w)
    (qSubVia u v w)
    (leQAdd (u + qNeg v) a (v + qNeg w) b h1 h2)

-- an upper bound on the reversed difference is a lower bound on it
def bndOfBothLe : {b : El Q}
  (u v : El Q)
  → El (u + qNeg v ≤ b) → El (v + qNeg u ≤ b) → El (Bnd b (u + qNeg v))
  using (ratBound.Bnd.unfold) ≔
  λb. λu. λv. λh1. λh2. transport
    Q
    (λw. qNeg b ≤ w)
    (qNeg (v + qNeg u))
    (u + qNeg v)
    (qSubFlip v u)
    (leQNegFlip (v + qNeg u) b h2), h1

-- a nonnegative sign is not the negative one — the refutation every
-- decision branch needs
def nonNegNotNeg : (s : El Sign) → El (NonNegS s) → El (Id Sign s sNeg) → 𝟘
  using (rationalOrder.NonNegS.unfold) ≔
  λs. λnn. λhn. ⊎-elim
    (h0. sZeroNotNeg
      (trans Sign sZero s sNeg (sym Sign s sZero (idToEq Sign s sZero h0)) (idToEq Sign s sNeg hn)))
    (hp. sPosNotNeg
      (trans Sign sPos s sNeg (sym Sign s sPos (idToEq Sign s sPos hp)) (idToEq Sign s sNeg hn)))
    nn

-- ===== order verdicts are unique =====
--
-- `LeQ x y` is DATA — a `⊎` of two `Id`s — but it carries no
-- information: `sgnQ` is a function, so which injection is inhabited
-- is determined by x and y, and `uip` says the `Id` payload is unique.
-- So ≤ behaves like a proposition after all, and anything built from
-- it (a `Bnd`, a regularity witness) inherits that.
def nonNegIsProp : (s : El Sign) (p q : El (NonNegS s)) → p ≡ q
  using (id.Id.unfold, rationalOrder.NonNegS.unfold, rationalOrder.Sign.unfold) ≔
  λs. λp. λq. ⊎-elim
    (a. ⊎-elim
      (b. cong (Id Sign s sZero) (λv. NonNegS s) (λw. inj₁ w) a b uip)
      (b. 𝟘-elim (sZeroNotPos
        (trans
          Sign
          sZero
          s
          sPos
          (sym Sign s sZero (idToEq Sign s sZero a))
          (idToEq Sign s sPos b))))
      q)
    (a. ⊎-elim
      (b. 𝟘-elim (sZeroNotPos
        (trans
          Sign
          sZero
          s
          sPos
          (sym Sign s sZero (idToEq Sign s sZero b))
          (idToEq Sign s sPos a))))
      (b. cong (Id Sign s sPos) (λv. NonNegS s) (λw. inj₂ w) a b uip)
      q)
    p

def leQIsProp : (x y : El Q) (p q : El (x ≤ y)) → p ≡ q
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λx. λy. nonNegIsProp (sgnQ (y + qNeg x))

def bndIsProp : (b u : El Q) (p q : El (Bnd b u)) → p ≡ q
  using (ratBound.Bnd.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold) ≔
  λb. λu. λp. λq. pairEq2 (leQIsProp (qNeg b) u (p .π₁) (q .π₁)) (leQIsProp u b (p .π₂) (q .π₂))
