import rationalQ (Q, qAdd, qNeg, qZero, qAddComm, qAddAssoc, qAddZeroL, qAddZeroR,
                  qAddNegL, qAddNegR, qNegNeg)
import rationalOrder (Sign, sPos, sgnQ, NonNegS, LeQ, leQRefl, leQOfEq, leQTrans,
                      leQPlusMono, leQPlusMonoL, qNegAdd, qPairSwap, qSubSplit,
                      qSubPlusCancel)
import equality (trans, sym, cong, transport)
import id (Id, eqToId)

-- Two-sided bounds on ℚ, stated WITHOUT an absolute value: `Bnd b u`
-- says −b ≤ u ≤ b. This is the shape every regularity/closeness
-- condition in real.nova already has, and the shape the triangle
-- inequality wants — |u + v| ≤ |u| + |v| becomes bndAdd, with no
-- case split on signs anywhere, because the two halves of a two-sided
-- bound add independently.
--
-- Everything here is order algebra over rationalOrder.nova; nothing
-- below inspects a representative.

-- ===== order lemmas the bound algebra needs =====

-- negation reverses ≤ : the two differences are the same rational
def leQNegFlip : (x : El Q) (y : El Q) → El (LeQ x y) → El (LeQ (qNeg y) (qNeg x)) ≔
  λx. λy. λh.
    transport Q (λw. NonNegS (sgnQ w))
      (qAdd y (qNeg x)) (qAdd (qNeg x) (qNeg (qNeg y)))
      (qAdd y (qNeg x)
         ≡⟨ qAddComm y (qNeg x) ⟩
       qAdd (qNeg x) y
         ≡⟨ cong Q (λw. Q) (λw. qAdd (qNeg x) w) y (qNeg (qNeg y))
              (sym Q (qNeg (qNeg y)) y (qNegNeg y)) ⟩
       qAdd (qNeg x) (qNeg (qNeg y)))
      h

-- ...and back: (−y) ≤ (−x) gives x ≤ y, by flipping once more
def leQNegFlipBack : (x : El Q) (y : El Q) →
  El (LeQ (qNeg y) (qNeg x)) → El (LeQ x y) ≔
  λx. λy. λh.
    transport Q (λw. LeQ w y) (qNeg (qNeg x)) x (qNegNeg x)
      (transport Q (λw. LeQ (qNeg (qNeg x)) w) (qNeg (qNeg y)) y (qNegNeg y)
         (leQNegFlip (qNeg y) (qNeg x) h))

-- ≤ adds in BOTH arguments — two monotonicity steps and a hop
def leQAdd : (x : El Q) (y : El Q) (z : El Q) (w : El Q) →
  El (LeQ x y) → El (LeQ z w) → El (LeQ (qAdd x z) (qAdd y w)) ≔
  λx. λy. λz. λw. λh1. λh2.
    leQTrans (qAdd x z) (qAdd y z) (qAdd y w)
      (leQPlusMono x y z h1)
      (leQPlusMonoL z w y h2)

-- ===== the bound relation =====

def Bnd : El Q → El Q → 𝕌 ≔ λb. λu. (LeQ (qNeg b) u ⨯ LeQ u b)

def bndLo : (b : El Q) (u : El Q) → El (Bnd b u) → El (LeQ (qNeg b) u) ≔
  λb. λu. λh. h .π₁
def bndHi : (b : El Q) (u : El Q) → El (Bnd b u) → El (LeQ u b) ≔
  λb. λu. λh. h .π₂

-- the triangle inequality, in two-sided form
def bndAdd : (a : El Q) (b : El Q) (u : El Q) (v : El Q) →
  El (Bnd a u) → El (Bnd b v) → El (Bnd (qAdd a b) (qAdd u v)) ≔
  λa. λb. λu. λv. λhu. λhv.
    (transport Q (λw. LeQ w (qAdd u v))
       (qAdd (qNeg a) (qNeg b)) (qNeg (qAdd a b))
       (sym Q (qNeg (qAdd a b)) (qAdd (qNeg a) (qNeg b)) (qNegAdd a b))
       (leQAdd (qNeg a) u (qNeg b) v (hu .π₁) (hv .π₁)) ,
     leQAdd u a v b (hu .π₂) (hv .π₂))

-- a bound on u bounds −u, with the same b
def bndNeg : (b : El Q) (u : El Q) →
  El (Bnd b u) → El (Bnd b (qNeg u)) ≔
  λb. λu. λh.
    (leQNegFlip u b (h .π₂) ,
     transport Q (λw. LeQ (qNeg u) w) (qNeg (qNeg b)) b (qNegNeg b)
       (leQNegFlip (qNeg b) u (h .π₁)))

-- a bound transports along an equality of the bounded rational
def bndEq : (b : El Q) (u : El Q) (v : El Q) →
  (u ≡ v ∈ El Q) → El (Bnd b u) → El (Bnd b v) ≔
  λb. λu. λv. λe. λh. transport Q (λw. Bnd b w) u v e h

-- ...and along an equality of the bound
def bndEqB : (a : El Q) (b : El Q) (u : El Q) →
  (a ≡ b ∈ El Q) → El (Bnd a u) → El (Bnd b u) ≔
  λa. λb. λu. λe. λh. transport Q (λw. Bnd w u) a b e h

-- a bound weakens to any larger bound
def bndWeaken : (a : El Q) (b : El Q) (u : El Q) →
  El (LeQ a b) → El (Bnd a u) → El (Bnd b u) ≔
  λa. λb. λu. λle. λh.
    (leQTrans (qNeg b) (qNeg a) u (leQNegFlip a b le) (h .π₁) ,
     leQTrans u a b (h .π₂) le)

-- ===== zero =====

def qNegZeroQ : qNeg qZero ≡ qZero ∈ El Q ≔ ⋆

-- 0 is bounded by every nonnegative b
def bndZero : (b : El Q) → El (LeQ qZero b) → El (Bnd b qZero) ≔
  λb. λle.
    (transport Q (λw. LeQ (qNeg b) w) (qNeg qZero) qZero qNegZeroQ
       (leQNegFlip qZero b le) ,
     le)

-- a difference of EQUAL rationals is bounded by every nonnegative b
def bndSubEq : (b : El Q) (u : El Q) (v : El Q) →
  El (LeQ qZero b) → (u ≡ v ∈ El Q) → El (Bnd b (qAdd u (qNeg v))) ≔
  λb. λu. λv. λle. λe.
    bndEq b qZero (qAdd u (qNeg v))
      (sym Q (qAdd u (qNeg v)) qZero
         (trans Q (qAdd u (qNeg v)) (qAdd v (qNeg v)) qZero
            (cong Q (λw. Q) (λw. qAdd w (qNeg v)) u v e)
            (qAddNegR v)))
      (bndZero b le)

-- ===== reassociating a difference =====

-- (u − w) ≡ (u − v) + (v − w): the standard three-term split, so a
-- bound on a difference follows from bounds on the two legs
def qSubVia : (u : El Q) (v : El Q) (w : El Q) →
  qAdd (qAdd u (qNeg v)) (qAdd v (qNeg w)) ≡ qAdd u (qNeg w) ∈ El Q ≔
  λu. λv. λw. qSubSplit w v u

-- the triangle inequality for differences, through a midpoint
def bndVia : (a : El Q) (b : El Q) (u : El Q) (v : El Q) (w : El Q) →
  El (Bnd a (qAdd u (qNeg v))) → El (Bnd b (qAdd v (qNeg w))) →
  El (Bnd (qAdd a b) (qAdd u (qNeg w))) ≔
  λa. λb. λu. λv. λw. λh1. λh2.
    bndEq (qAdd a b) (qAdd (qAdd u (qNeg v)) (qAdd v (qNeg w)))
      (qAdd u (qNeg w)) (qSubVia u v w)
      (bndAdd a b (qAdd u (qNeg v)) (qAdd v (qNeg w)) h1 h2)

-- −(u − v) ≡ v − u, so a bound on one difference bounds the other
def qSubFlip : (u : El Q) (v : El Q) →
  qNeg (qAdd u (qNeg v)) ≡ qAdd v (qNeg u) ∈ El Q ≔
  λu. λv.
    (qNeg (qAdd u (qNeg v))
       ≡⟨ qNegAdd u (qNeg v) ⟩
     qAdd (qNeg u) (qNeg (qNeg v))
       ≡⟨ cong Q (λz. Q) (λz. qAdd (qNeg u) z) (qNeg (qNeg v)) v (qNegNeg v) ⟩
     qAdd (qNeg u) v
       ≡⟨ qAddComm (qNeg u) v ⟩
     qAdd v (qNeg u))

def bndSubSym : (b : El Q) (u : El Q) (v : El Q) →
  El (Bnd b (qAdd u (qNeg v))) → El (Bnd b (qAdd v (qNeg u))) ≔
  λb. λu. λv. λh.
    bndEq b (qNeg (qAdd u (qNeg v))) (qAdd v (qNeg u)) (qSubFlip u v)
      (bndNeg b (qAdd u (qNeg v)) h)

-- ===== differences of sums =====

-- (a − b) + (c − d) ≡ (a + c) − (b + d): the two differences of a
-- componentwise sum add. This is what makes bndAdd applicable to a
-- difference of SUMS, which is every well-definedness goal for +.
def qSubAdd : (a : El Q) (b : El Q) (c : El Q) (d : El Q) →
  qAdd (qAdd a (qNeg b)) (qAdd c (qNeg d))
    ≡ qAdd (qAdd a c) (qNeg (qAdd b d)) ∈ El Q ≔
  λa. λb. λc. λd.
    (qAdd (qAdd a (qNeg b)) (qAdd c (qNeg d))
       ≡⟨ qPairSwap a (qNeg b) c (qNeg d) ⟩
     qAdd (qAdd a c) (qAdd (qNeg b) (qNeg d))
       ≡⟨ cong Q (λw. Q) (λw. qAdd (qAdd a c) w) (qAdd (qNeg b) (qNeg d))
            (qNeg (qAdd b d))
            (sym Q (qNeg (qAdd b d)) (qAdd (qNeg b) (qNeg d)) (qNegAdd b d)) ⟩
     qAdd (qAdd a c) (qNeg (qAdd b d)))

-- a common LEFT summand cancels from a difference (rationalOrder has
-- the right-summand version)
def qSubPlusCancelL : (x : El Q) (y : El Q) (w : El Q) →
  qAdd (qAdd w y) (qNeg (qAdd w x)) ≡ qAdd y (qNeg x) ∈ El Q ≔
  λx. λy. λw.
    (qAdd (qAdd w y) (qNeg (qAdd w x))
       ≡⟨ cong Q (λv. Q) (λv. qAdd v (qNeg (qAdd w x))) (qAdd w y) (qAdd y w)
            (qAddComm w y) ⟩
     qAdd (qAdd y w) (qNeg (qAdd w x))
       ≡⟨ cong Q (λv. Q) (λv. qAdd (qAdd y w) (qNeg v)) (qAdd w x) (qAdd x w)
            (qAddComm w x) ⟩
     qAdd (qAdd y w) (qNeg (qAdd x w))
       ≡⟨ qSubPlusCancel x y w ⟩
     qAdd y (qNeg x))

-- ===== nonnegativity from a positive sign =====

-- 0 ≤ u whenever u's sign is positive: the difference u − 0 is u
def leQZeroOfPos : (u : El Q) → (sgnQ u ≡ sPos ∈ El Sign) → El (LeQ qZero u) ≔
  λu. λh.
    inj₂ (eqToId Sign (sgnQ (qAdd u (qNeg qZero))) sPos
      (trans Sign (sgnQ (qAdd u (qNeg qZero))) (sgnQ u) sPos
         (cong Q (λv. Sign) (λv. sgnQ v) (qAdd u (qNeg qZero)) u
            (trans Q (qAdd u (qNeg qZero)) (qAdd u qZero) u
               (cong Q (λv. Q) (λv. qAdd u v) (qNeg qZero) qZero qNegZeroQ)
               (qAddZeroR u)))
         h))

-- ===== growing a bound by a nonnegative amount =====

def leQSelfAdd : (a : El Q) (b : El Q) →
  El (LeQ qZero b) → El (LeQ a (qAdd a b)) ≔
  λa. λb. λle.
    transport Q (λw. LeQ w (qAdd a b)) (qAdd a qZero) a (qAddZeroR a)
      (leQPlusMonoL qZero b a le)

def leQSelfAddL : (a : El Q) (b : El Q) →
  El (LeQ qZero b) → El (LeQ a (qAdd b a)) ≔
  λa. λb. λle.
    transport Q (λw. LeQ a w) (qAdd a b) (qAdd b a) (qAddComm a b)
      (leQSelfAdd a b le)

-- the ONE-SIDED triangle inequality: a difference splits through a
-- midpoint and the two upper bounds add
def leQVia : (a : El Q) (b : El Q) (u : El Q) (v : El Q) (w : El Q) →
  El (LeQ (qAdd u (qNeg v)) a) → El (LeQ (qAdd v (qNeg w)) b) →
  El (LeQ (qAdd u (qNeg w)) (qAdd a b)) ≔
  λa. λb. λu. λv. λw. λh1. λh2.
    transport Q (λz. LeQ z (qAdd a b))
      (qAdd (qAdd u (qNeg v)) (qAdd v (qNeg w))) (qAdd u (qNeg w))
      (qSubVia u v w)
      (leQAdd (qAdd u (qNeg v)) a (qAdd v (qNeg w)) b h1 h2)

-- an upper bound on the reversed difference is a lower bound on it
def bndOfBothLe : (b : El Q) (u : El Q) (v : El Q) →
  El (LeQ (qAdd u (qNeg v)) b) → El (LeQ (qAdd v (qNeg u)) b) →
  El (Bnd b (qAdd u (qNeg v))) ≔
  λb. λu. λv. λh1. λh2.
    (transport Q (λw. LeQ (qNeg b) w) (qNeg (qAdd v (qNeg u)))
       (qAdd u (qNeg v)) (qSubFlip v u)
       (leQNegFlip (qAdd v (qNeg u)) b h2) ,
     h1)
