-- The bracket type [A] ≜ A / ⊤ (Awodey–Bauer), as a 𝕌-CODE.
--
-- Nova has two truncations. ∥T∥ : Ω is the irrelevant one: Ω compares
-- its elements by inhabitation alone (code-prop-eq), so ∥T∥ has
-- the single canonical form ⋆ and a prop never exposes it — the witness
-- is unrecoverable, and elimination is confined to props and equations
-- (NovaFoundation.txt:1267, :1296).
--
-- Br a ≜ a / (x y. ∥𝟙∥) is the other one. class x RETAINS x, so
-- el-quot-beta computes, and el-quot-e's motive ranges over arbitrary
-- TYPES: the eliminator lands wherever the method is constant. What it
-- gives up is Ω-membership — impredicativity, and iff-collapse.
--
-- It is nonetheless a DEFINITIONAL subsingleton: el-quot-eq concludes
-- ≐, not ≡. (Lean's Squash, the same quotient, is only a propositional
-- one — Quot.sound is not judgemental.)

import Core.prop (propExt)
import Core.equality (cong, sym, trans, pairext)
import Core.id (Id, refl, idToEq)
import Core.uip (uip, idCanon)

Br : 𝕌 → 𝕌
Br = λa. a / (x y. ∥𝟙∥)

br : {a : 𝕌} → a → Br a using (Br.unfold)
br = λa x. class x

-- Elimination into an ARBITRARY code, along any constant map.
brElim : {a b : 𝕌} (f : a → b) (c : (x y : a) → f x ≡ f y) (t : Br a) → b using (Br.unfold)
brElim = λa b f c t. quot-elim (x. f x) t

-- ...and it COMPUTES.
brBeta : {a b : 𝕌} (f : a → b) (c : (x y : a) → f x ≡ f y) (x : a) → brElim f c (br x) ≡ f x
  using (Br.unfold, br.eq, brElim.eq)
brBeta f c x = ⋆

-- ---------------------------------------------------------------
-- [A] is a proposition — JUDGEMENTALLY (el-quot-eq concludes ≐)
brIsProp : {a : 𝕌} (u v : Br a) → u ≡ v using (Br.unfold)
brIsProp u v = quot-elim (y. quot-elim (x. ⋆) u) v

-- Consequently EVERY map out of [A] is constant on representatives,
-- with no hypothesis at all: the coherence brElim asks for is free
-- whenever the function already factors through the bracket.
brOutConst : {a b : 𝕌} (g : Br a → b) (x y : a) → g (br x) ≡ g (br y)
brOutConst = λa b g x y. cong (λw. b) g (brIsProp (br x) (br y))

-- η / uniqueness: brElim is the ONLY map agreeing with g on classes.
brEta : {a b : 𝕌} (g : Br a → b) (t : Br a) → brElim (λx. g (br x)) (brOutConst g) t ≡ g t
  using (Br.unfold, br.eq, brElim.eq, brOutConst.eq)
brEta = λa b g t. quot-elim (x. ⋆) t

-- ---------------------------------------------------------------
-- br is surjective — merely, but that is all a bracket can say
brSurj : {a : 𝕌} (t : Br a) → ∥(x : a) × br x ≡ t∥ using (Br.unfold, br.eq)
brSurj = λa t. quot-elim (x. ⋆ (x, ⋆)) t

-- ---------------------------------------------------------------
-- [A] and A have the same Ω-squash: the bracket is a REFINEMENT of
-- ∥·∥, carrying strictly more (it keeps the witness) and asserting
-- exactly the same thing.
brToSquash : {a : 𝕌} → Br a → ∥a∥ using (Br.unfold)
brToSquash = λa t. quot-elim (x. ⋆ x) t

brSquashEq : {a : 𝕌} → ∥Br a∥ ≡ ∥a∥ using (Br.unfold, br.eq, brToSquash.eq)
brSquashEq = λa. propExt (λh. squash-elim h (t. brToSquash t)) (λh. squash-elim h (x. ⋆ (br x)))

-- ---------------------------------------------------------------
-- [-] is an idempotent monad on 𝕌: unit br, multiplication brJoin,
-- functorial action brMap.
brMap : {a b : 𝕌} (f : a → b) (t : Br a) → Br b using (Br.unfold, br.eq)
brMap = λa b f t. quot-elim (x. br (f x)) t

brMapBeta : (a b : 𝕌) (f : a → b) (x : a) → brMap f (br x) ≡ br (f x)
  using (Br.unfold, br.eq, brMap.eq)
brMapBeta = λa b f x. ⋆

-- the coherence brElim demands IS brIsProp, verbatim
brJoin : {a : 𝕌} (s : Br (Br a)) → Br a
brJoin s = brElim (λt. t) brIsProp s

-- idempotence, both round trips
brJoinUnit : {a : 𝕌} (t : Br a) → brJoin (br t) ≡ t using (Br.unfold, br.eq, brJoin.eq, brElim.eq)
brJoinUnit t = ⋆

brUnitJoin : {a : 𝕌} (s : Br (Br a)) → br (brJoin s) ≡ s
brUnitJoin s = brIsProp _ _

-- ---------------------------------------------------------------
-- The bracket REFLECTS emptiness — by ordinary elimination.
--
-- Compare Core.prop.absurdP: a ⊥-proof → 𝟘 is NOT available that way
-- (el-squash-e-prf reaches only further propositions); Core.prop.absurd
-- has to detour through el-reflect on a false equation. Here quot-elim
-- lands in 𝟘 directly, because the scrutinee still holds its witness.
zeroConst : {b : 𝕌} (f : 𝟘 → b) (x y : 𝟘) → f x ≡ f y
zeroConst f x y = 𝟘-elim x

brEmpty : Br 𝟘 → 𝟘 using (Br.unfold, zeroConst.eq)
brEmpty t = quot-elim (x. 𝟘-elim x) t

-- ---------------------------------------------------------------
-- DESCRIPTION. On a subsingleton the bracket is the type itself: the
-- witness comes back out, as data, and it computes.
--
-- This is exactly what ∥·∥ : Ω must not have — unique choice is one of
-- the three prohibitions licensing Ω's impredicativity
-- (NovaFoundation.txt:1316, Chicli–Pottier–Simpson). The bracket may
-- have it precisely because it is NOT a proposition of Ω: nothing
-- coerces into (Br a) from an iff-equal prop, so the only way to
-- hold one is to have built it from an element.
brDescr : {a : 𝕌} (s : (x y : a) → x ≡ y) (t : Br a) → a using (Br.unfold)
brDescr s t = quot-elim (x. x) t

brDescrBeta : {a : 𝕌} (s : (x y : a) → x ≡ y) (x : a) → brDescr s (br x) ≡ x
  using (Br.unfold, br.eq, brDescr.eq)
brDescrBeta = λa s x. ⋆

brDescrEta' : {a : 𝕌} (s : (x y : a) → x ≡ y) (t : Br a) → br (brDescr s t) ≡ t
brDescrEta' s t = brIsProp _ _

-- ---------------------------------------------------------------
-- The payoff, in miniature: a truncated existential whose witness is
-- recovered AS DATA and evaluates.
--
-- ≡ is Ω-valued and has no 𝕌-code, so the subsingleton is built from
-- the Id QIIT instead: Fib n ≜ (m : ℕ) × Id ℕ m n, an "∃m. m = n"
-- that IS a code. uip makes it a subsingleton, brDescr opens it.
-- Its Ω twin, ∥(Fib n)∥, says exactly the same thing
-- (brSquashEq) and yields nothing.
Fib : ℕ → 𝕌
Fib n = (m : ℕ) × Id _ m n

-- every element of Fib n is (n , refl): reflect the index equation
-- first, then uip finishes at the reflected type
fibCanon : {n : ℕ} (u : Fib n) → u ≡ (n, refl ℕ n)
  using (Fib.unfold, hyp.rw, sigma.eta, Core.id.Id.unfold, Core.id.Id.eq)
fibCanon =
  λn u. let h = idToEq _ _ _ (u .π₂)
            pairext {ℕ} {λm. Id _ m n} {_} {n, refl ℕ n} h (idCanon (u .π₂) h)

fibIsProp : (n : ℕ) (u v : Fib n) → u ≡ v using (Fib.unfold, Core.id.Id.unfold, Core.id.Id.eq)
fibIsProp = λn u v. trans _ _ _ (fibCanon u) (sym _ _ (fibCanon v))

fibWitness : (n : ℕ) (t : Br (Fib n)) → ℕ using (Fib.unfold)
fibWitness = λn t. brDescr (fibIsProp n) t .π₁

-- ⋆ means: this equation holds DEFINITIONALLY. The witness survived
-- the truncation and the projection reduced to a numeral.
fibWitnessComputes : fibWitness 2 (br (2, refl ℕ 2)) ≡ 2
  using (Fib.unfold, br.eq, brDescr.eq, fibWitness.eq, Core.id.Id.eq)
fibWitnessComputes = ⋆

-- ---------------------------------------------------------------
-- [-] preserves binary products: (Br (a × b)) ≅ (Br a × Br b).
--
-- All the work is in building the two maps; both round trips are FREE,
-- because every equation between elements of a bracket is (brIsProp).
-- That is the shape of every proof about this modality: propositions
-- are cheap, elimination is the content.
brProdIsProp : {a b : 𝕌} (u v : Br a × Br b) → u ≡ v using (sigma.eta)
brProdIsProp = λa b u v. pairext (brIsProp (u .π₁) (v .π₁)) (brIsProp (u .π₂) (v .π₂))

brPairIn : {a b : 𝕌} (t : Br (a × b)) → Br a × Br b
brPairIn =
  λa b t. brElim
    λp. br (p .π₁), br (p .π₂)
    λp q. brProdIsProp (br (p .π₁), br (p .π₂)) (br (q .π₁), br (q .π₂))
    t

brPairOutAt : {a b : 𝕌} (x : a) (v : Br b) → Br (a × b)
brPairOutAt = λa b x v. brElim (λy. br (x, y)) (λy y'. brIsProp (br (x, y)) (br (x, y'))) v

brPairOut : {a b : 𝕌} (p : Br a × Br b) → Br (a × b)
brPairOut =
  λa b p. brElim
    λx. brPairOutAt x (p .π₂)
    λx x'. brIsProp (brPairOutAt x (p .π₂)) (brPairOutAt x' (p .π₂))
    p .π₁

brProdIso1 : {a b : 𝕌} (t : Br (a × b)) → brPairOut (brPairIn t) ≡ t
brProdIso1 = λa b t. brIsProp _ _

brProdIso2 : {a b : 𝕌} (p : Br a × Br b) → brPairIn (brPairOut p) ≡ p
brProdIso2 = λa b p. brProdIsProp _ _
