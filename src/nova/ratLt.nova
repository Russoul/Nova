-- The STRICT order on ℚ. `LeQ` reads the difference's sign as
-- "nonnegative"; `LtQ` reads it as "positive". Everything is a
-- statement about that one sign, so every proof below is a chain in
-- `Sign` — no representative is ever opened.

import rationalQ (Q, +, qNeg, qZero, qAddComm, qAddZeroR, qAddNegR, qNegNeg)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, sgnQZero, sgnCases, sgnQAddPos, sgnQZeroView, sgnQNegFlip, NonNegS, ≤, leQTrans, qSubSplit, qDiffZero, qSubPlusCancel, sZeroNotPos, sNegNotPos, sPosNotNeg, qSubNeg)
import ratBound (leQZeroOfPos, qSubPlusCancelL)
import ratArch (sgnQSubFlip)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

infixl 4 <
def < : Q → Q → 𝕌 ≔ λx. λy. Id _ (sgnQ (y + qNeg x)) sPos

def ltQOfSgn : (x y : Q) → (sgnQ (y + qNeg x) ≡ sPos) → x < y
  using (id.Id.unfold, ratLt.<.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λh. eqToId _ _ h

def sgnOfLtQ : {x y : Q} → x < y → sgnQ (y + qNeg x) ≡ sPos
  using (id.Id.unfold, ratLt.<.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λh. idToEq _ _ _ h

-- strict implies non-strict, on the nose: a positive sign IS a
-- nonnegative one
def leQOfLtQ : {x y : Q} → x < y → x ≤ y
  using (id.Id.unfold,
    ratLt.<.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold) ≔
  λx. λy. λh. inj₂ h

def ltQZero : (u : Q) → qZero < u → qZero ≤ u
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λh. leQOfLtQ h

-- ===== irreflexivity and asymmetry =====
def ltQIrrefl : (x : Q) → x < x → 𝟘 ≔
  λx. λh. sZeroNotPos
    (trans
      _
      _
      _
      (sym _ _ (trans _ _ _ (cong (λw. Sign) (λw. sgnQ w) (qAddNegR x)) sgnQZero))
      (sgnOfLtQ h))

def ltQAsym : (x y : Q) → x < y → y < x → 𝟘
  using (id.Id.unfold,
    ratLt.<.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnFlip.eq,
    rationalQ.Q.unfold) ≔
  λx. λy. λh1. λh2. sNegNotPos
    (trans
      _
      _
      _
      (sym
        _
        _
        (trans
          (sgnQ (x + qNeg y))
          _
          _
          sgnQSubFlip
          (trans _ _ sNeg (cong (λw. Sign) (λw. sgnFlip w) (sgnOfLtQ h1)) ⋆)))
      (sgnOfLtQ h2))

-- ===== transitivity, in all four mixed forms =====
-- a positive plus a NONNEGATIVE is positive: the zero case collapses
def sgnQAddPosNonNeg : {a b : Q} → (sgnQ a ≡ sPos) → NonNegS (sgnQ b) → sgnQ (a + b) ≡ sPos
  using (rationalOrder.NonNegS.unfold) ≔
  λa. λb. λha. λhb. ⊎-elim
    (h0. trans
      _
      _
      _
      (cong
        (λw. Sign)
        (λw. sgnQ w)
        (trans _ _ _ (cong (λw. Q) (λw. a + w) (sgnQZeroView _ (idToEq _ _ _ h0))) (qAddZeroR a)))
      ha)
    (hp. sgnQAddPos _ _ ha (idToEq _ _ _ hp))
    hb

def ltQTrans : (x y z : Q) → x < y → y < z → x < z using (id.Id.unfold, ratLt.<.unfold) ≔
  λx. λy. λz. λh1. λh2. ltQOfSgn
    _
    _
    (trans
      _
      _
      _
      (cong (λw. Sign) (λw. sgnQ w) (sym _ _ (qSubSplit x y z)))
      (sgnQAddPos _ _ (sgnOfLtQ h2) (sgnOfLtQ h1)))

def leQLtTrans : (x y z : Q) → x ≤ y → y < z → x < z
  using (id.Id.unfold,
    ratLt.<.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold) ≔
  λx. λy. λz. λh1. λh2. ltQOfSgn
    _
    _
    (trans
      {Sign}
      _
      _
      _
      (cong (λw. Sign) (λw. sgnQ w) (sym _ _ (qSubSplit x y z)))
      (sgnQAddPosNonNeg (sgnOfLtQ h2) h1))

def ltQLeTrans : (x y z : Q) → x < y → y ≤ z → x < z
  using (id.Id.unfold,
    ratLt.<.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold) ≔
  λx. λy. λz. λh1. λh2. ltQOfSgn
    _
    _
    (trans
      {Sign}
      _
      _
      _
      (cong
        (λw. Sign)
        (λw. sgnQ w)
        (trans _ _ _ (sym _ _ (qSubSplit x y z)) (qAddComm (z + qNeg y) (y + qNeg x))))
      (sgnQAddPosNonNeg (sgnOfLtQ h1) h2))

-- ===== trichotomy =====
def ltQTrichotomy : (x y : Q) → x < y ⊎ Id _ x y ⊎ y < x
  using (id.Id.eq,
    id.Id.unfold,
    ratLt.<.eq,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnFlip.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λx. λy. ⊎-elim
    (nn. ⊎-elim
      (h0. inj₂ (inj₁ (eqToId _ _ (sym _ _ (qDiffZero (sgnQZeroView _ (idToEq _ _ _ h0)))))))
      (hp. inj₁ hp)
      nn)
    (hneg. inj₂ (inj₂ (ltQOfSgn
      _
      _
      (trans
        (sgnQ (x + qNeg y))
        _
        _
        sgnQSubFlip
        (trans _ _ sPos (cong (λw. Sign) (λw. sgnFlip w) (idToEq _ _ _ hneg)) ⋆)))))
    (sgnCases (sgnQ (y + qNeg x)))

-- ===== compatibility with addition =====
def ltQPlusMono : (x y w : Q) → x < y → x + w < y + w
  using (id.Id.unfold, ratLt.<.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λw. λh. transport
    (λs. Id _ s sPos)
    (sym _ _ (cong (λv. Sign) (λv. sgnQ v) (qSubPlusCancel x y w)))
    h

def ltQPlusMonoL : (x y w : Q) → x < y → w + x < w + y
  using (id.Id.unfold, ratLt.<.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λw. λh. transport
    (λs. Id _ s sPos)
    (sym _ _ (cong (λv. Sign) (λv. sgnQ v) (qSubPlusCancelL x y w)))
    h
