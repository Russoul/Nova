-- Order on ℚ via the SIGN: a three-valued small code, computed for an
-- integer by intNonZero's decision (an honest function — no new
-- well-definedness), for a raw fraction as the sign of num·den, and
-- for a class by quot-elim whose well-definedness is the one real
-- theorem here: multiplying by a nonzero SQUARE preserves sign.

import nat (+, *, plusComm, plusAssoc, swapLeft, zeroPlusId, plusZeroId)
import integer (Int, intZero, intNeg, intNegZero)
import integerAdd (+)
import integerMul (*, intMulComm, intMulAssoc, intMulZeroL, intMulZeroR)
import rational (NZ, nzPos, nzNeg, nzToInt, nzMul, Rat, mkRat, num, den, denInt, ratNeg, ratZero, ratAdd, intScale)
import rationalQ (Q, RatR, qcls, +, qNeg, qZero, qAddComm, qAddAssoc, qAddZeroL, qAddZeroR, qAddNegL, qAddNegR, qNegNeg, nzToIntMul, *, qMulComm, qMulZeroL, qDistribR, ratMul, intScaleIsMul)
import intNonZero (nzOfInt, nzToIntNonZero, intNoZeroDiv)
import intOrder (intMulDistribR)
import equality (trans, sym, cong, transport)
import rationalInv (ratZeroOfNumZero)
import id (Id, idToEq, eqToId)

def Sign : 𝕌 ≔ 𝟙 ⊎ 𝟙 ⊎ 𝟙

def sZero : El Sign using (rationalOrder.Sign.unfold) ≔ inj₁ ()

def sPos : El Sign using (rationalOrder.Sign.unfold) ≔ inj₂ (inj₁ ())

def sNeg : El Sign using (rationalOrder.Sign.unfold) ≔ inj₂ (inj₂ ())

def sgnFlip : El Sign → El Sign using (rationalOrder.Sign.unfold) ≔
  λs. ⊎-elim (u. sZero) (v. ⊎-elim (u. sNeg) (u. sPos) v) s

def nzSgn : El NZ → El Sign using (rational.NZ.unfold, rationalOrder.Sign.unfold) ≔
  λe. ⊎-elim (n. sPos) (n. sNeg) e

def intSgn : El Int → El Sign using (rationalOrder.Sign.unfold) ≔
  λz. ⊎-elim (u. nzSgn (u .π₁)) (u. sZero) (nzOfInt z)

-- computation: intSgn evaluates on the three shapes, magnitude open
def intSgnZero : intSgn intZero ≡ sZero
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq) ≔
  ⋆

def intSgnPos : (k : ℕ) → intSgn (nzToInt (nzPos k)) ≡ sPos
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq) ≔
  λk. ⋆

def intSgnNeg : {k : ℕ} → intSgn (nzToInt (nzNeg k)) ≡ sNeg
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    rational.nzNeg.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq) ≔
  λk. ⋆

def intSgnNz : (e : El NZ) → intSgn (nzToInt e) ≡ nzSgn e
  using (rational.NZ.unfold,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq) ≔
  λe. ⊎-elim (n. intSgnPos n) (n. intSgnNeg) e

-- ===== sign multiplicativity: the well-definedness core =====
-- squares in NZ are positive, so scaling by one preserves the sign —
-- all four constructor cases compute (nzMul's sign table is its body)
def nzSgnMulSq : {a b : El NZ} → nzSgn (nzMul a (nzMul b b)) ≡ nzSgn a
  using (rational.NZ.unfold,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq) ≔
  λa. λb. ⊎-elim
    (m. ⊎-elim (v. nzSgn (nzMul (nzPos m) (nzMul v v)) ≡ nzSgn (nzPos m)) (k. ⋆) (k. ⋆) b)
    (m. ⊎-elim (v. nzSgn (nzMul (nzNeg m) (nzMul v v)) ≡ nzSgn (nzNeg m)) (k. ⋆) (k. ⋆) b)
    a

-- multiplying an integer by a nonzero square preserves its sign:
-- decide z, then either both sides are sZero or everything lands in
-- NZ where nzSgnMulSq computes
def intSgnMulSq : (z : El Int) (e : El NZ) → intSgn (z * (nzToInt e * nzToInt e)) ≡ intSgn z ≔
  λz. λe. ⊎-elim
    (u. trans
      Sign
      (intSgn (z * (nzToInt e * nzToInt e)))
      (intSgn (nzToInt (u .π₁) * (nzToInt e * nzToInt e)))
      (intSgn z)
      (cong
        Int
        (λv. Sign)
        (λv. intSgn (v * (nzToInt e * nzToInt e)))
        z
        (nzToInt (u .π₁))
        (sym Int (nzToInt (u .π₁)) z (u .π₂)))
      (trans
        Sign
        (intSgn (nzToInt (u .π₁) * (nzToInt e * nzToInt e)))
        (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
        (intSgn z)
        (trans
          Sign
          (intSgn (nzToInt (u .π₁) * (nzToInt e * nzToInt e)))
          (intSgn (nzToInt (u .π₁) * nzToInt (nzMul e e)))
          (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
          (cong
            Int
            (λv. Sign)
            (λv. intSgn (nzToInt (u .π₁) * v))
            (nzToInt e * nzToInt e)
            (nzToInt (nzMul e e))
            (sym Int (nzToInt (nzMul e e)) (nzToInt e * nzToInt e) (nzToIntMul e e)))
          (cong
            Int
            (λv. Sign)
            (λv. intSgn v)
            (nzToInt (u .π₁) * nzToInt (nzMul e e))
            (nzToInt (nzMul (u .π₁) (nzMul e e)))
            (sym
              Int
              (nzToInt (nzMul (u .π₁) (nzMul e e)))
              (nzToInt (u .π₁) * nzToInt (nzMul e e))
              (nzToIntMul (u .π₁) (nzMul e e)))))
        (trans
          Sign
          (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
          (nzSgn (u .π₁))
          (intSgn z)
          (trans
            Sign
            (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
            (nzSgn (nzMul (u .π₁) (nzMul e e)))
            (nzSgn (u .π₁))
            (intSgnNz (nzMul (u .π₁) (nzMul e e)))
            nzSgnMulSq)
          (trans
            Sign
            (nzSgn (u .π₁))
            (intSgn (nzToInt (u .π₁)))
            (intSgn z)
            (sym Sign (intSgn (nzToInt (u .π₁))) (nzSgn (u .π₁)) (intSgnNz (u .π₁)))
            (cong Int (λv. Sign) (λv. intSgn v) (nzToInt (u .π₁)) z (u .π₂))))))
    (hz. trans
      Sign
      (intSgn (z * (nzToInt e * nzToInt e)))
      sZero
      (intSgn z)
      (trans
        Sign
        (intSgn (z * (nzToInt e * nzToInt e)))
        (intSgn (intZero * (nzToInt e * nzToInt e)))
        sZero
        (cong Int (λv. Sign) (λv. intSgn (v * (nzToInt e * nzToInt e))) z intZero hz)
        (trans
          Sign
          (intSgn (intZero * (nzToInt e * nzToInt e)))
          (intSgn intZero)
          sZero
          (cong
            Int
            (λv. Sign)
            (λv. intSgn v)
            (intZero * (nzToInt e * nzToInt e))
            intZero
            (intMulZeroL (nzToInt e * nzToInt e)))
          intSgnZero))
      (sym
        Sign
        (intSgn z)
        sZero
        (trans
          Sign
          (intSgn z)
          (intSgn intZero)
          sZero
          (cong Int (λv. Sign) (λv. intSgn v) z intZero hz)
          intSgnZero)))
    (nzOfInt z)

-- ===== interchange, hypothesis-free =====
def mulLeftSwap : (b c d : El Int) → b * (c * d) ≡ c * (b * d) using (integer.Int.unfold) ≔
  λb. λc. λd. b * (c * d)
      ≡⟨ sym Int (b * c * d) (b * (c * d)) (intMulAssoc b c d) ⟩ b * c * d
      ≡⟨ cong Int (λv. Int) (λv. v * d) (b * c) (c * b) (intMulComm b c) ⟩ c * b * d
      ≡⟨ intMulAssoc c b d ⟩ c * (b * d)

def mulPairSwap : (a b c d : El Int) → a * b * (c * d) ≡ a * c * (b * d)
  using (integer.Int.unfold) ≔
  λa. λb. λc. λd. a * b * (c * d)
      ≡⟨ intMulAssoc a b (c * d) ⟩ a * (b * (c * d))
      ≡⟨ cong
        Int
        (λv. Int)
        (λv. a * v)
        (b * (c * d))
        (c * (b * d))
        (mulLeftSwap b c d) ⟩ a * (c * (b * d))
      ≡⟨ sym Int (a * c * (b * d)) (a * (c * (b * d))) (intMulAssoc a c (b * d)) ⟩ a * c * (b * d)

def mulPairSwapR : (a b c d : El Int) → a * b * (c * d) ≡ a * d * (c * b)
  using (integer.Int.unfold) ≔
  λa. λb. λc. λd. a * b * (c * d)
      ≡⟨ cong Int (λv. Int) (λv. a * b * v) (c * d) (d * c) (intMulComm c d) ⟩ a * b * (d * c)
      ≡⟨ mulPairSwap a b d c ⟩ a * d * (b * c)
      ≡⟨ cong Int (λv. Int) (λv. a * d * v) (b * c) (c * b) (intMulComm b c) ⟩ a * d * (c * b)

-- ===== the sign of a fraction, and its well-definedness =====
def ratSgn : El Rat → El Sign using (rationalOrder.Sign.unfold) ≔ λp. intSgn (num p * denInt p)

-- RatR p q cross-multiplies; scale each side's num·den by the OTHER
-- side's den², interchange, and rewrite across the relation — signs
-- survive because squares do (intSgnMulSq)
def ratSgnWD : (p q : El Rat) → Prf (RatR p q) → ratSgn p ≡ ratSgn q
  using (integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λq. λh. trans
    Sign
    (intSgn (num p * denInt p))
    (intSgn (num p * denInt p * (denInt q * denInt q)))
    (intSgn (num q * denInt q))
    (sym
      Sign
      (intSgn (num p * denInt p * (denInt q * denInt q)))
      (intSgn (num p * denInt p))
      (intSgnMulSq (num p * denInt p) (den q)))
    (trans
      Sign
      (intSgn (num p * denInt p * (denInt q * denInt q)))
      (intSgn (num p * denInt q * (denInt p * denInt q)))
      (intSgn (num q * denInt q))
      (cong
        Int
        (λv. Sign)
        (λv. intSgn v)
        (num p * denInt p * (denInt q * denInt q))
        (num p * denInt q * (denInt p * denInt q))
        (mulPairSwap (num p) (denInt p) (denInt q) (denInt q)))
      (trans
        Sign
        (intSgn (num p * denInt q * (denInt p * denInt q)))
        (intSgn (num q * denInt p * (denInt p * denInt q)))
        (intSgn (num q * denInt q))
        (cong
          Int
          (λv. Sign)
          (λv. intSgn (v * (denInt p * denInt q)))
          (num p * denInt q)
          (num q * denInt p)
          h)
        (trans
          Sign
          (intSgn (num q * denInt p * (denInt p * denInt q)))
          (intSgn (num q * denInt q * (denInt p * denInt p)))
          (intSgn (num q * denInt q))
          (cong
            Int
            (λv. Sign)
            (λv. intSgn v)
            (num q * denInt p * (denInt p * denInt q))
            (num q * denInt q * (denInt p * denInt p))
            (mulPairSwapR (num q) (denInt p) (denInt p) (denInt q)))
          (intSgnMulSq (num q * denInt q) (den p)))))

-- the sign of a rational: quot-elim, well-defined by ratSgnWD
def sgnQ : El Q → El Sign
  using (integer.Int.unfold,
    ratSgnWD,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalOrder.Sign.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λu. quot-elim (p. ratSgn p) u

def sgnQCls : (p : El Rat) → sgnQ (qcls p) ≡ ratSgn p
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.ratSgn.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qcls.eq) ≔
  λp. ⋆

def sgnQZero : sgnQ qZero ≡ sZero
  using (intMulZeroL.rw,
    intSgnZero.rw,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.ratSgn.eq,
    rationalQ.qZero.eq,
    sgnQCls.rw) ≔
  ⋆

-- ===== negation and the sign flip =====
-- (−z)·w ≡ −(z·w): both sides compute on classes to plusComm-related
-- pairs
def intMulNegL : {z w : El Int} → intNeg z * w ≡ intNeg (z * w)
  using (intEffective.intRRefl,
    integer.Int.unfold,
    integerMul.distribBackR,
    integerMul.intMulNegL,
    integerMul.sum4Distrib,
    plusAssoc,
    rational.plusSwapRight) ≔
  λz. λw. quot-elim (u. quot-elim (v. ⋆) w) z

-- negating flips the decided sign, shape by shape
def intSgnNegNz : {e : El NZ} → intSgn (intNeg (nzToInt e)) ≡ sgnFlip (nzSgn e)
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.intNeg.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    rational.NZ.unfold,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnFlip.eq) ≔
  λe. ⊎-elim (n. ⋆) (n. ⋆) e

def intSgnNegFlip : (z : El Int) → intSgn (intNeg z) ≡ sgnFlip (intSgn z)
  using (integer.Int.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.sZero.eq,
    rationalOrder.sgnFlip.eq) ≔
  λz. ⊎-elim
    (u. trans
      Sign
      (intSgn (intNeg z))
      (intSgn (intNeg (nzToInt (u .π₁))))
      (sgnFlip (intSgn z))
      (cong
        Int
        (λv. Sign)
        (λv. intSgn (intNeg v))
        z
        (nzToInt (u .π₁))
        (sym Int (nzToInt (u .π₁)) z (u .π₂)))
      (trans
        Sign
        (intSgn (intNeg (nzToInt (u .π₁))))
        (sgnFlip (nzSgn (u .π₁)))
        (sgnFlip (intSgn z))
        intSgnNegNz
        (trans
          Sign
          (sgnFlip (nzSgn (u .π₁)))
          (sgnFlip (intSgn (nzToInt (u .π₁))))
          (sgnFlip (intSgn z))
          (cong
            Sign
            (λv. Sign)
            (λv. sgnFlip v)
            (nzSgn (u .π₁))
            (intSgn (nzToInt (u .π₁)))
            (sym Sign (intSgn (nzToInt (u .π₁))) (nzSgn (u .π₁)) (intSgnNz (u .π₁))))
          (cong Int (λv. Sign) (λv. sgnFlip (intSgn v)) (nzToInt (u .π₁)) z (u .π₂)))))
    (hz. trans
      Sign
      (intSgn (intNeg z))
      sZero
      (sgnFlip (intSgn z))
      (trans
        Sign
        (intSgn (intNeg z))
        (intSgn (intNeg intZero))
        sZero
        (cong Int (λv. Sign) (λv. intSgn (intNeg v)) z intZero hz)
        (trans
          Sign
          (intSgn (intNeg intZero))
          (intSgn intZero)
          sZero
          (cong Int (λv. Sign) (λv. intSgn v) (intNeg intZero) intZero intNegZero)
          intSgnZero))
      (sym
        Sign
        (sgnFlip (intSgn z))
        sZero
        (trans
          Sign
          (sgnFlip (intSgn z))
          (sgnFlip sZero)
          sZero
          (cong
            Sign
            (λv. Sign)
            (λv. sgnFlip v)
            (intSgn z)
            sZero
            (trans
              Sign
              (intSgn z)
              (intSgn intZero)
              sZero
              (cong Int (λv. Sign) (λv. intSgn v) z intZero hz)
              intSgnZero))
          ⋆)))
    (nzOfInt z)

-- ===== ℚ additive-group algebra, hypothesis-free =====
def qLeftSwap : (b c d : El Q) → b + (c + d) ≡ c + (b + d) using (rationalQ.Q.unfold) ≔
  λb. λc. λd. b + (c + d)
      ≡⟨ sym Q (b + c + d) (b + (c + d)) (qAddAssoc b c d) ⟩ b + c + d
      ≡⟨ cong Q (λv. Q) (λv. v + d) (b + c) (c + b) (qAddComm b c) ⟩ c + b + d
      ≡⟨ qAddAssoc c b d ⟩ c + (b + d)

def qPairSwap : (a b c d : El Q) → a + b + (c + d) ≡ a + c + (b + d) using (rationalQ.Q.unfold) ≔
  λa. λb. λc. λd. a + b + (c + d)
      ≡⟨ qAddAssoc a b (c + d) ⟩ a + (b + (c + d))
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. a + v)
        (b + (c + d))
        (c + (b + d))
        (qLeftSwap b c d) ⟩ a + (c + (b + d))
      ≡⟨ sym Q (a + c + (b + d)) (a + (c + (b + d))) (qAddAssoc a c (b + d)) ⟩ a + c + (b + d)

-- −u + (u + v) ≡ v, then inverse uniqueness, then −(a+b) ≡ (−a)+(−b)
def qNegPlusCancel : (u v : El Q) → qNeg u + (u + v) ≡ v using (rationalQ.Q.unfold) ≔
  λu. λv. qNeg u + (u + v)
      ≡⟨ sym Q (qNeg u + u + v) (qNeg u + (u + v)) (qAddAssoc (qNeg u) u v) ⟩ qNeg u + u + v
      ≡⟨ cong Q (λw. Q) (λw. w + v) (qNeg u + u) (u + qNeg u) (qAddComm (qNeg u) u) ⟩ u + qNeg u + v
      ≡⟨ cong Q (λw. Q) (λw. w + v) (u + qNeg u) qZero (qAddNegR u) ⟩ qZero + v
      ≡⟨ qAddZeroL v ⟩ v

def qNegUnique : {u v : El Q} → (u + v ≡ qZero) → v ≡ qNeg u ≔
  λu. λv. λh. trans
    Q
    v
    (qNeg u + (u + v))
    (qNeg u)
    (sym Q (qNeg u + (u + v)) v (qNegPlusCancel u v))
    (trans
      Q
      (qNeg u + (u + v))
      (qNeg u + qZero)
      (qNeg u)
      (cong Q (λw. Q) (λw. qNeg u + w) (u + v) qZero h)
      (trans
        Q
        (qNeg u + qZero)
        (qZero + qNeg u)
        (qNeg u)
        (qAddComm (qNeg u) qZero)
        (qAddZeroL (qNeg u))))

def qNegAdd : (a b : El Q) → qNeg (a + b) ≡ qNeg a + qNeg b ≔
  λa. λb. sym
    Q
    (qNeg a + qNeg b)
    (qNeg (a + b))
    (qNegUnique
      (trans
        Q
        (a + b + (qNeg a + qNeg b))
        (a + qNeg a + (b + qNeg b))
        qZero
        (qPairSwap a b (qNeg a) (qNeg b))
        (trans
          Q
          (a + qNeg a + (b + qNeg b))
          (qZero + (b + qNeg b))
          qZero
          (cong Q (λw. Q) (λw. w + (b + qNeg b)) (a + qNeg a) qZero (qAddNegR a))
          (trans
            Q
            (qZero + (b + qNeg b))
            (b + qNeg b)
            qZero
            (qAddZeroL (b + qNeg b))
            (qAddNegR b)))))

def qSubNeg : {x y : El Q} → x + qNeg y ≡ qNeg (y + qNeg x) ≔
  λx. λy. sym
    Q
    (qNeg (y + qNeg x))
    (x + qNeg y)
    (trans
      Q
      (qNeg (y + qNeg x))
      (qNeg y + qNeg (qNeg x))
      (x + qNeg y)
      (qNegAdd y (qNeg x))
      (trans
        Q
        (qNeg y + qNeg (qNeg x))
        (qNeg y + x)
        (x + qNeg y)
        (cong Q (λw. Q) (λw. qNeg y + w) (qNeg (qNeg x)) x (qNegNeg x))
        (qAddComm (qNeg y) x)))

-- the flip, lifted to ℚ (representative abstract: D-3)
def sgnQNegFlip : {u : El Q} → sgnQ (qNeg u) ≡ sgnFlip (sgnQ u)
  using (eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rational.ratNeg.eq,
    rationalInv.intCanonProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.qNeg.eq) ≔
  λu. quot-elim
    (p. trans
      Sign
      (sgnQ (qNeg (class p)))
      (intSgn (intNeg (num p * denInt p)))
      (sgnFlip (sgnQ (class p)))
      (trans
        Sign
        (sgnQ (qNeg (class p)))
        (intSgn (intNeg (num p) * denInt p))
        (intSgn (intNeg (num p * denInt p)))
        ⋆
        (cong
          Int
          (λv. Sign)
          (λv. intSgn v)
          (intNeg (num p) * denInt p)
          (intNeg (num p * denInt p))
          intMulNegL))
      (intSgnNegFlip (num p * denInt p)))
    u

-- ===== the order =====
def NonNegS : El Sign → 𝕌 ≔ λs. Id Sign s sZero ⊎ Id Sign s sPos

infixl 4 ≤
def ≤ : El Q → El Q → 𝕌 ≔ λx. λy. NonNegS (sgnQ (y + qNeg x))

def leQRefl : (x : El Q) → El (x ≤ x) using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λx. inj₁ (eqToId
    (sgnQ (x + qNeg x))
    sZero
    (trans
      Sign
      (sgnQ (x + qNeg x))
      (sgnQ qZero)
      sZero
      (cong Q (λu. Sign) (λu. sgnQ u) (x + qNeg x) qZero (qAddNegR x))
      sgnQZero))

def leQOfEq : (x y : El Q) → (x ≡ y) → El (x ≤ y)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λx. λy. λh. inj₁ (eqToId
    (sgnQ (y + qNeg x))
    sZero
    (trans
      Sign
      (sgnQ (y + qNeg x))
      (sgnQ qZero)
      sZero
      (cong
        Q
        (λu. Sign)
        (λu. sgnQ u)
        (y + qNeg x)
        qZero
        (trans
          Q
          (y + qNeg x)
          (y + qNeg y)
          qZero
          (cong Q (λu. Q) (λu. y + qNeg u) x y h)
          (qAddNegR y)))
      sgnQZero))

-- every sign is nonneg or negative — the DECISION, as data
def sgnCases : (s : El Sign) → El (NonNegS s) ⊎ El (Id Sign s sNeg)
  using (Sign.eq,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.unfold,
    sNeg.eq,
    sPos.eq,
    sZero.eq) ≔
  λs. ⊎-elim
    (u. inj₁ (inj₁ (eqToId (inj₁ u) sZero ⋆)))
    (v. ⊎-elim
      (u. inj₁ (inj₂ (eqToId (inj₂ (inj₁ u)) sPos ⋆)))
      (u. inj₂ (eqToId (inj₂ (inj₂ u)) sNeg ⋆))
      v)
    s

-- totality: decide the difference's sign; a negative difference flips
def leQTotal : (x y : El Q) → El (x ≤ y) ⊎ El (y ≤ x)
  using (id.Id.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnFlip.eq,
    rationalQ.Q.unfold) ≔
  λx. λy. ⊎-elim
    (nn. inj₁ nn)
    (hneg. inj₂ (inj₂ (eqToId
      (sgnQ (x + qNeg y))
      sPos
      (trans
        Sign
        (sgnQ (x + qNeg y))
        (sgnFlip (sgnQ (y + qNeg x)))
        sPos
        (trans
          Sign
          (sgnQ (x + qNeg y))
          (sgnQ (qNeg (y + qNeg x)))
          (sgnFlip (sgnQ (y + qNeg x)))
          (cong Q (λu. Sign) (λu. sgnQ u) (x + qNeg y) (qNeg (y + qNeg x)) qSubNeg)
          sgnQNegFlip)
        (trans
          Sign
          (sgnFlip (sgnQ (y + qNeg x)))
          (sgnFlip sNeg)
          sPos
          (cong
            Sign
            (λu. Sign)
            (λu. sgnFlip u)
            (sgnQ (y + qNeg x))
            sNeg
            (idToEq Sign (sgnQ (y + qNeg x)) sNeg hneg))
          ⋆)))))
    (sgnCases (sgnQ (y + qNeg x)))

-- ===== sign discrimination (transport along a discriminating family) =====
def sIsNeg : El Sign → 𝕌 using (rationalOrder.Sign.unfold) ≔
  λs. ⊎-elim (u. 𝟘) (v. ⊎-elim (u. 𝟘) (u. 𝟙) v) s

def sIsPos : El Sign → 𝕌 using (rationalOrder.Sign.unfold) ≔
  λs. ⊎-elim (u. 𝟘) (v. ⊎-elim (u. 𝟙) (u. 𝟘) v) s

def sZeroNotNeg : (sZero ≡ sNeg) → 𝟘
  using (rationalOrder.sIsNeg.unfold, rationalOrder.sNeg.unfold, rationalOrder.sZero.unfold) ≔
  λh. transport Sign sIsNeg sNeg sZero (sym Sign sZero sNeg h) ()

def sPosNotNeg : (sPos ≡ sNeg) → 𝟘
  using (rationalOrder.sIsNeg.unfold, rationalOrder.sNeg.unfold, rationalOrder.sPos.unfold) ≔
  λh. transport Sign sIsNeg sNeg sPos (sym Sign sPos sNeg h) ()

def sZeroNotPos : (sZero ≡ sPos) → 𝟘
  using (rationalOrder.sIsPos.unfold, rationalOrder.sPos.unfold, rationalOrder.sZero.unfold) ≔
  λh. transport Sign sIsPos sPos sZero (sym Sign sZero sPos h) ()

def sNegNotPos : (sNeg ≡ sPos) → 𝟘
  using (rationalOrder.sIsPos.unfold, rationalOrder.sNeg.unfold, rationalOrder.sPos.unfold) ≔
  λh. transport Sign sIsPos sPos sNeg (sym Sign sNeg sPos h) ()

-- ===== views: a sign verdict names the integer's shape =====
def intSgnPosView : (z : El Int) → (intSgn z ≡ sPos) → (k : ℕ) ⨯ Prf (nzToInt (nzPos k) ≡ z)
  using (integer.Int.unfold, rational.NZ.unfold, rational.nzNeg.eq, rational.nzPos.eq) ≔
  λz. λh. ⊎-elim
    (u. (⊎-elim (w. Prf (nzToInt w ≡ z) → (k : ℕ) ⨯ Prf (nzToInt (nzPos k) ≡ z))
      (k. λhe. k, he)
      (k. λhe. 𝟘-elim (sNegNotPos
        (trans
          Sign
          sNeg
          (intSgn z)
          sPos
          (sym
            Sign
            (intSgn z)
            sNeg
            (trans
              Sign
              (intSgn z)
              (intSgn (nzToInt (nzNeg k)))
              sNeg
              (cong
                Int
                (λv. Sign)
                (λv. intSgn v)
                z
                (nzToInt (nzNeg k))
                (sym Int (nzToInt (nzNeg k)) z he))
              intSgnNeg))
          h)))
      (u .π₁))
      (u .π₂))
    (hz. 𝟘-elim (sZeroNotPos
      (trans
        Sign
        sZero
        (intSgn z)
        sPos
        (sym
          Sign
          (intSgn z)
          sZero
          (trans
            Sign
            (intSgn z)
            (intSgn intZero)
            sZero
            (cong Int (λv. Sign) (λv. intSgn v) z intZero hz)
            intSgnZero))
        h)))
    (nzOfInt z)

def intSgnZeroView : (z : El Int) → (intSgn z ≡ sZero) → z ≡ intZero
  using (integer.Int.unfold, rational.NZ.unfold, rational.nzNeg.eq, rational.nzPos.eq) ≔
  λz. λh. ⊎-elim
    (u. (⊎-elim (w. Prf (nzToInt w ≡ z) → z ≡ intZero)
      (k. λhe. 𝟘-elim (sZeroNotPos
        (trans
          Sign
          sZero
          (intSgn z)
          sPos
          (sym Sign (intSgn z) sZero h)
          (trans
            Sign
            (intSgn z)
            (intSgn (nzToInt (nzPos k)))
            sPos
            (cong
              Int
              (λv. Sign)
              (λv. intSgn v)
              z
              (nzToInt (nzPos k))
              (sym Int (nzToInt (nzPos k)) z he))
            (intSgnPos k)))))
      (k. λhe. 𝟘-elim (sZeroNotNeg
        (trans
          Sign
          sZero
          (intSgn z)
          sNeg
          (sym Sign (intSgn z) sZero h)
          (trans
            Sign
            (intSgn z)
            (intSgn (nzToInt (nzNeg k)))
            sNeg
            (cong
              Int
              (λv. Sign)
              (λv. intSgn v)
              z
              (nzToInt (nzNeg k))
              (sym Int (nzToInt (nzNeg k)) z he))
            intSgnNeg))))
      (u .π₁))
      (u .π₂))
    (hz. hz)
    (nzOfInt z)

-- ===== positivity algebra =====
-- positives multiply to a positive: view both, drop to the NZ layer,
-- where nzMul computes its own sign table
def intSgnPosMul : {a b : El Int} → (intSgn a ≡ sPos) → (intSgn b ≡ sPos) → intSgn (a * b) ≡ sPos
  using (integer.Int.unfold,
    rational.nzMul.eq,
    rational.nzPos.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.nzSgn.eq,
    rationalOrder.sPos.eq) ≔
  λa. λb. λha. λhb. let va ≔ intSgnPosView
    a
    ha in let vb ≔ intSgnPosView
    b
    hb in trans
    Sign
    (intSgn (a * b))
    (intSgn (nzToInt (nzPos (va .π₁)) * nzToInt (nzPos (vb .π₁))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (a * b)
      (nzToInt (nzPos (va .π₁)) * nzToInt (nzPos (vb .π₁)))
      (trans
        Int
        (a * b)
        (nzToInt (nzPos (va .π₁)) * b)
        (nzToInt (nzPos (va .π₁)) * nzToInt (nzPos (vb .π₁)))
        (cong
          Int
          (λv. Int)
          (λv. v * b)
          a
          (nzToInt (nzPos (va .π₁)))
          (sym Int (nzToInt (nzPos (va .π₁))) a (va .π₂)))
        (cong
          Int
          (λv. Int)
          (λv. nzToInt (nzPos (va .π₁)) * v)
          b
          (nzToInt (nzPos (vb .π₁)))
          (sym Int (nzToInt (nzPos (vb .π₁))) b (vb .π₂)))))
    (trans
      Sign
      (intSgn (nzToInt (nzPos (va .π₁)) * nzToInt (nzPos (vb .π₁))))
      (intSgn (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁)))))
      sPos
      (cong
        Int
        (λv. Sign)
        (λv. intSgn v)
        (nzToInt (nzPos (va .π₁)) * nzToInt (nzPos (vb .π₁)))
        (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
        (sym
          Int
          (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
          (nzToInt (nzPos (va .π₁)) * nzToInt (nzPos (vb .π₁)))
          (nzToIntMul (nzPos (va .π₁)) (nzPos (vb .π₁)))))
      (trans
        Sign
        (intSgn (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁)))))
        (nzSgn (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
        sPos
        (intSgnNz (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
        ⋆))

-- positives add to a positive: both views land on class (S j , Z)
-- forms, whose sum computes to another one
def intSgnPosAdd : {a b : El Int} → (intSgn a ≡ sPos) → (intSgn b ≡ sPos) → intSgn (a + b) ≡ sPos
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    integerAdd.+.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    nat.+.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq) ≔
  λa. λb. λha. λhb. let va ≔ intSgnPosView
    a
    ha in let vb ≔ intSgnPosView
    b
    hb in trans
    Sign
    (intSgn (a + b))
    (intSgn (nzToInt (nzPos (va .π₁)) + nzToInt (nzPos (vb .π₁))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (a + b)
      (nzToInt (nzPos (va .π₁)) + nzToInt (nzPos (vb .π₁)))
      (trans
        Int
        (a + b)
        (nzToInt (nzPos (va .π₁)) + b)
        (nzToInt (nzPos (va .π₁)) + nzToInt (nzPos (vb .π₁)))
        (cong
          Int
          (λv. Int)
          (λv. v + b)
          a
          (nzToInt (nzPos (va .π₁)))
          (sym Int (nzToInt (nzPos (va .π₁))) a (va .π₂)))
        (cong
          Int
          (λv. Int)
          (λv. nzToInt (nzPos (va .π₁)) + v)
          b
          (nzToInt (nzPos (vb .π₁)))
          (sym Int (nzToInt (nzPos (vb .π₁))) b (vb .π₂)))))
    ⋆

-- ratSgn, spelled in the nzToInt∘den vocabulary the shuffling lemmas
-- speak (denInt is its definitional alias)
def ratSgnIs : (p : El Rat) → ratSgn p ≡ intSgn (num p * nzToInt (den p))
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.ratSgn.eq) ≔
  λp. ⋆

-- the two cross terms of a fraction sum, scaled by the common
-- denominator, carry their fraction's sign: shuffle to
-- (num·den)·(den'·den') and drop the square
def ratCrossPosL : {p : El Rat}
  (q : El Rat)
  → (ratSgn p ≡ sPos) → intSgn (intScale (den q) (num p) * nzToInt (nzMul (den p) (den q))) ≡ sPos
  using (integer.Int.unfold,
    ratSgnIs.rw,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalOrder.Sign.unfold) ≔
  λp. λq. λhp. trans
    Sign
    (intSgn (intScale (den q) (num p) * nzToInt (nzMul (den p) (den q))))
    (intSgn (num p * nzToInt (den p) * (nzToInt (den q) * nzToInt (den q))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (intScale (den q) (num p) * nzToInt (nzMul (den p) (den q)))
      (num p * nzToInt (den p) * (nzToInt (den q) * nzToInt (den q)))
      (intScale (den q) (num p) * nzToInt (nzMul (den p) (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. v * nzToInt (nzMul (den p) (den q)))
            (intScale (den q) (num p))
            (nzToInt (den q) * num p)
            (intScaleIsMul
              (den q)
              (num p)) ⟩ nzToInt (den q) * num p * nzToInt (nzMul (den p) (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. nzToInt (den q) * num p * v)
            (nzToInt (nzMul (den p) (den q)))
            (nzToInt (den p) * nzToInt (den q))
            (nzToIntMul
              (den p)
              (den q)) ⟩ nzToInt (den q) * num p * (nzToInt (den p) * nzToInt (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. v * (nzToInt (den p) * nzToInt (den q)))
            (nzToInt (den q) * num p)
            (num p * nzToInt (den q))
            (intMulComm
              (nzToInt (den q))
              (num p)) ⟩ num p * nzToInt (den q) * (nzToInt (den p) * nzToInt (den q))
          ≡⟨ mulPairSwap
            (num p)
            (nzToInt (den q))
            (nzToInt (den p))
            (nzToInt (den q)) ⟩ num p * nzToInt (den p) * (nzToInt (den q) * nzToInt (den q))))
    (trans
      Sign
      (intSgn (num p * nzToInt (den p) * (nzToInt (den q) * nzToInt (den q))))
      (intSgn (num p * nzToInt (den p)))
      sPos
      (intSgnMulSq (num p * nzToInt (den p)) (den q))
      hp)

def ratCrossPosR : (p : El Rat)
  {q : El Rat}
  → (ratSgn q ≡ sPos) → intSgn (intScale (den p) (num q) * nzToInt (nzMul (den p) (den q))) ≡ sPos
  using (integer.Int.unfold,
    ratSgnIs.rw,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalOrder.Sign.unfold) ≔
  λp. λq. λhq. trans
    Sign
    (intSgn (intScale (den p) (num q) * nzToInt (nzMul (den p) (den q))))
    (intSgn (num q * nzToInt (den q) * (nzToInt (den p) * nzToInt (den p))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (intScale (den p) (num q) * nzToInt (nzMul (den p) (den q)))
      (num q * nzToInt (den q) * (nzToInt (den p) * nzToInt (den p)))
      (intScale (den p) (num q) * nzToInt (nzMul (den p) (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. v * nzToInt (nzMul (den p) (den q)))
            (intScale (den p) (num q))
            (nzToInt (den p) * num q)
            (intScaleIsMul
              (den p)
              (num q)) ⟩ nzToInt (den p) * num q * nzToInt (nzMul (den p) (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. nzToInt (den p) * num q * v)
            (nzToInt (nzMul (den p) (den q)))
            (nzToInt (den p) * nzToInt (den q))
            (nzToIntMul
              (den p)
              (den q)) ⟩ nzToInt (den p) * num q * (nzToInt (den p) * nzToInt (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. v * (nzToInt (den p) * nzToInt (den q)))
            (nzToInt (den p) * num q)
            (num q * nzToInt (den p))
            (intMulComm
              (nzToInt (den p))
              (num q)) ⟩ num q * nzToInt (den p) * (nzToInt (den p) * nzToInt (den q))
          ≡⟨ mulPairSwapR
            (num q)
            (nzToInt (den p))
            (nzToInt (den p))
            (nzToInt (den q)) ⟩ num q * nzToInt (den q) * (nzToInt (den p) * nzToInt (den p))))
    (trans
      Sign
      (intSgn (num q * nzToInt (den q) * (nzToInt (den p) * nzToInt (den p))))
      (intSgn (num q * nzToInt (den q)))
      sPos
      (intSgnMulSq (num q * nzToInt (den q)) (den p))
      hq)

-- positive fractions add to a positive fraction
def ratAddPos : {p q : El Rat} → (ratSgn p ≡ sPos) → (ratSgn q ≡ sPos) → ratSgn (ratAdd p q) ≡ sPos
  using (intNonZero.nzOfInt.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sZero.eq) ≔
  λp. λq. λhp. λhq. trans
    Sign
    (ratSgn (ratAdd p q))
    (intSgn
      (intScale
        (den q)
        (num
          p)
        * nzToInt
          (nzMul (den p) (den q)) + intScale (den p) (num q) * nzToInt (nzMul (den p) (den q))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      ((intScale (den q) (num p) + intScale (den p) (num q)) * nzToInt (nzMul (den p) (den q)))
      (intScale
        (den q)
        (num
          p)
        * nzToInt
          (nzMul (den p) (den q)) + intScale (den p) (num q) * nzToInt (nzMul (den p) (den q)))
      (intMulDistribR
        (intScale (den q) (num p))
        (intScale (den p) (num q))
        (nzToInt (nzMul (den p) (den q)))))
    (intSgnPosAdd (ratCrossPosL q hp) (ratCrossPosR p hq))

-- ===== lifting to ℚ =====
-- positivity adds (representatives abstract, hypotheses as Π's in the
-- motive — the qMulInvR pattern)
def sgnQAddPos : (u v : El Q) → (sgnQ u ≡ sPos) → (sgnQ v ≡ sPos) → sgnQ (u + v) ≡ sPos
  using (equality.cong.eq,
    equality.trans.eq,
    intOrder.intMulDistribR.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integerAdd.+.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalOrder.Sign.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.intSgnPosAdd.eq,
    rationalOrder.ratAddPos.eq,
    rationalOrder.ratCrossPosL.eq,
    rationalOrder.ratCrossPosR.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.+.eq) ≔
  λu. λv. quot-elim (p. quot-elim (q. λhp. λhq. ratAddPos hp hq) v) u

-- a zero sign names the zero class
def sgnQZeroView : (u : El Q) → (sgnQ u ≡ sZero) → u ≡ qZero
  using (eqNat.zNotS.eq,
    equality.cong.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.intNeqOfNotRel.eq,
    intNonZero.intNoZeroDiv.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzToIntNonZero.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    integerMul.*.eq,
    integerMul.intMulCong2.eq,
    integerMul.intMulOneR.eq,
    integerMul.intMulZeroL.eq,
    prop.absurdP.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratZero.eq,
    rationalInv.notApply.eq,
    rationalInv.ratZeroOfNumZero.eq,
    rationalOrder.Sign.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.intSgnNeg.eq,
    rationalOrder.intSgnPos.eq,
    rationalOrder.intSgnZeroView.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sZeroNotNeg.eq,
    rationalOrder.sZeroNotPos.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.clsEqOfRel.eq,
    rationalQ.dInt.eq,
    rationalQ.nzToIntMul.eq) ≔
  λu. quot-elim
    (p. λh. ratZeroOfNumZero
      p
      (intNoZeroDiv (denInt p) (intSgnZeroView (num p * denInt p) h) (nzToIntNonZero (den p))))
    u

-- (z − y) + (y − x) ≡ z − x
def qSubSplit : (x y z : El Q) → z + qNeg y + (y + qNeg x) ≡ z + qNeg x using (rationalQ.Q.unfold) ≔
  λx. λy. λz. z + qNeg y + (y + qNeg x)
      ≡⟨ qAddAssoc z (qNeg y) (y + qNeg x) ⟩ z + (qNeg y + (y + qNeg x))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. z + w)
        (qNeg y + (y + qNeg x))
        (qNeg x)
        (qNegPlusCancel y (qNeg x)) ⟩ z + qNeg x

-- (a − b) + b ≡ a, hypothesis-free
def qPlusNegCancelR : (a b : El Q) → a + qNeg b + b ≡ a using (rationalQ.Q.unfold) ≔
  λa. λb. a + qNeg b + b
      ≡⟨ qAddAssoc a (qNeg b) b ⟩ a + (qNeg b + b)
      ≡⟨ cong Q (λw. Q) (λw. a + w) (qNeg b + b) qZero (qAddNegL b) ⟩ a + qZero
      ≡⟨ qAddZeroR a ⟩ a

-- a zero difference names an equality
def qDiffZero : {a b : El Q} → (a + qNeg b ≡ qZero) → a ≡ b ≔
  λa. λb. λh. trans
    Q
    a
    (a + qNeg b + b)
    b
    (sym Q (a + qNeg b + b) a (qPlusNegCancelR a b))
    (trans
      Q
      (a + qNeg b + b)
      (qZero + b)
      b
      (cong Q (λw. Q) (λw. w + b) (a + qNeg b) qZero h)
      (qAddZeroL b))

-- ===== transitivity and antisymmetry =====
def leQTrans : (x y z : El Q) → El (x ≤ y) → El (y ≤ z) → El (x ≤ z)
  using (id.Id.unfold, rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λz. λl1. λl2. let comb : sgnQ
    (z
      + qNeg
        x) ≡ sgnQ
    (z
      + qNeg
        y
      + (y
        + qNeg
          x)) ≔ cong
    Q
    (λw. Sign)
    (λw. sgnQ w)
    (z + qNeg x)
    (z + qNeg y + (y + qNeg x))
    (sym
      Q
      (z + qNeg y + (y + qNeg x))
      (z + qNeg x)
      (qSubSplit
        x
        y
        z)) in ⊎-elim
    (h10. let e0 ≔ sgnQZeroView
      (y + qNeg x)
      (idToEq
        Sign
        (sgnQ (y + qNeg x))
        sZero
        h10) in let eq : sgnQ
      (z
        + qNeg
          x) ≡ sgnQ
      (z
        + qNeg
          y) ≔ trans
      Sign
      (sgnQ (z + qNeg x))
      (sgnQ (z + qNeg y + (y + qNeg x)))
      (sgnQ (z + qNeg y))
      comb
      (cong
        Q
        (λw. Sign)
        (λw. sgnQ w)
        (z + qNeg y + (y + qNeg x))
        (z + qNeg y)
        (trans
          Q
          (z + qNeg y + (y + qNeg x))
          (z + qNeg y + qZero)
          (z + qNeg y)
          (cong Q (λw. Q) (λw. z + qNeg y + w) (y + qNeg x) qZero e0)
          (qAddZeroR
            (z
              + qNeg
                y)))) in transport
      Sign
      NonNegS
      (sgnQ (z + qNeg y))
      (sgnQ (z + qNeg x))
      (sym Sign (sgnQ (z + qNeg x)) (sgnQ (z + qNeg y)) eq)
      l2)
    (h1p. ⊎-elim
      (h20. let e0 ≔ sgnQZeroView
        (z + qNeg y)
        (idToEq
          Sign
          (sgnQ (z + qNeg y))
          sZero
          h20) in let eq : sgnQ
        (z
          + qNeg
            x) ≡ sgnQ
        (y
          + qNeg
            x) ≔ trans
        Sign
        (sgnQ (z + qNeg x))
        (sgnQ (z + qNeg y + (y + qNeg x)))
        (sgnQ (y + qNeg x))
        comb
        (cong
          Q
          (λw. Sign)
          (λw. sgnQ w)
          (z + qNeg y + (y + qNeg x))
          (y + qNeg x)
          (trans
            Q
            (z + qNeg y + (y + qNeg x))
            (qZero + (y + qNeg x))
            (y + qNeg x)
            (cong Q (λw. Q) (λw. w + (y + qNeg x)) (z + qNeg y) qZero e0)
            (qAddZeroL
              (y
                + qNeg
                  x)))) in transport
        Sign
        NonNegS
        (sgnQ (y + qNeg x))
        (sgnQ (z + qNeg x))
        (sym Sign (sgnQ (z + qNeg x)) (sgnQ (y + qNeg x)) eq)
        (inj₂ h1p))
      (h2p. inj₂ (eqToId
        (sgnQ (z + qNeg x))
        sPos
        (trans
          Sign
          (sgnQ (z + qNeg x))
          (sgnQ (z + qNeg y + (y + qNeg x)))
          sPos
          comb
          (sgnQAddPos
            (z + qNeg y)
            (y + qNeg x)
            (idToEq Sign (sgnQ (z + qNeg y)) sPos h2p)
            (idToEq Sign (sgnQ (y + qNeg x)) sPos h1p)))))
      l2)
    l1

def leQAntisym : {x y : El Q} → El (x ≤ y) → El (y ≤ x) → x ≡ y
  using (id.Id.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnFlip.eq,
    rationalQ.Q.unfold) ≔
  λx. λy. λl1. λl2. let fl : sgnQ
    (x
      + qNeg
        y) ≡ sgnFlip
    (sgnQ
      (y
        + qNeg
          x)) ≔ trans
    Sign
    (sgnQ (x + qNeg y))
    (sgnQ (qNeg (y + qNeg x)))
    (sgnFlip (sgnQ (y + qNeg x)))
    (cong Q (λw. Sign) (λw. sgnQ w) (x + qNeg y) (qNeg (y + qNeg x)) qSubNeg)
    sgnQNegFlip in ⊎-elim
    (h10. sym
      Q
      y
      x
      (qDiffZero (sgnQZeroView (y + qNeg x) (idToEq Sign (sgnQ (y + qNeg x)) sZero h10))))
    (h1p. let en : sgnQ
      (x
        + qNeg
          y) ≡ sNeg ≔ trans
      Sign
      (sgnQ (x + qNeg y))
      (sgnFlip (sgnQ (y + qNeg x)))
      sNeg
      fl
      (trans
        Sign
        (sgnFlip (sgnQ (y + qNeg x)))
        (sgnFlip sPos)
        sNeg
        (cong
          Sign
          (λw. Sign)
          (λw. sgnFlip w)
          (sgnQ (y + qNeg x))
          sPos
          (idToEq Sign (sgnQ (y + qNeg x)) sPos h1p))
        ⋆) in ⊎-elim
      (h20. 𝟘-elim (sZeroNotNeg
        (trans
          Sign
          sZero
          (sgnQ (x + qNeg y))
          sNeg
          (sym Sign (sgnQ (x + qNeg y)) sZero (idToEq Sign (sgnQ (x + qNeg y)) sZero h20))
          en)))
      (h2p. 𝟘-elim (sPosNotNeg
        (trans
          Sign
          sPos
          (sgnQ (x + qNeg y))
          sNeg
          (sym Sign (sgnQ (x + qNeg y)) sPos (idToEq Sign (sgnQ (x + qNeg y)) sPos h2p))
          en)))
      l2)
    l1

-- ===== compatibility with the operations =====
-- (y + w) − (x + w) ≡ y − x, hypothesis-free
def qSubPlusCancel : (x y w : El Q) → y + w + qNeg (x + w) ≡ y + qNeg x using (rationalQ.Q.unfold) ≔
  λx. λy. λw. y + w + qNeg (x + w)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. y + w + v)
        (qNeg (x + w))
        (qNeg x + qNeg w)
        (qNegAdd x w) ⟩ y + w + (qNeg x + qNeg w)
      ≡⟨ qPairSwap y w (qNeg x) (qNeg w) ⟩ y + qNeg x + (w + qNeg w)
      ≡⟨ cong Q (λv. Q) (λv. y + qNeg x + v) (w + qNeg w) qZero (qAddNegR w) ⟩ y + qNeg x + qZero
      ≡⟨ qAddZeroR (y + qNeg x) ⟩ y + qNeg x

-- monotonicity of + : one transport along the cancelled difference
def leQPlusMono : {x y : El Q} (w : El Q) → El (x ≤ y) → El (x + w ≤ y + w)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold, rationalQ.Q.unfold) ≔
  λx. λy. λw. λle. transport
    Sign
    NonNegS
    (sgnQ (y + qNeg x))
    (sgnQ (y + w + qNeg (x + w)))
    (sym
      Sign
      (sgnQ (y + w + qNeg (x + w)))
      (sgnQ (y + qNeg x))
      (cong Q (λv. Sign) (λv. sgnQ v) (y + w + qNeg (x + w)) (y + qNeg x) (qSubPlusCancel x y w)))
    le

def leQPlusMonoL : (x y w : El Q) → El (x ≤ y) → El (w + x ≤ w + y)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λx. λy. λw. λle. transport
    Q
    (λv. v ≤ w + y)
    (x + w)
    (w + x)
    (qAddComm x w)
    (transport Q (λv. x + w ≤ v) (y + w) (w + y) (qAddComm y w) (leQPlusMono w le))

-- the sign of a product, spelled on the components
def ratSgnMulIs : (p q : El Rat)
  → ratSgn (ratMul p q) ≡ intSgn (num p * num q * nzToInt (nzMul (den p) (den q)))
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.ratSgn.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. ⋆

-- positive fractions multiply to a positive fraction: interchange
-- num·num · den·den into (num·den)·(num·den)
def ratMulPos : {p q : El Rat} → (ratSgn p ≡ sPos) → (ratSgn q ≡ sPos) → ratSgn (ratMul p q) ≡ sPos
  using (integer.Int.unfold,
    ratSgnIs.rw,
    ratSgnMulIs,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalOrder.Sign.unfold) ≔
  λp. λq. λhp. λhq. trans
    Sign
    (ratSgn (ratMul p q))
    (intSgn (num p * nzToInt (den p) * (num q * nzToInt (den q))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (num p * num q * nzToInt (nzMul (den p) (den q)))
      (num p * nzToInt (den p) * (num q * nzToInt (den q)))
      (num p * num q * nzToInt (nzMul (den p) (den q))
          ≡⟨ cong
            Int
            (λv. Int)
            (λv. num p * num q * v)
            (nzToInt (nzMul (den p) (den q)))
            (nzToInt (den p) * nzToInt (den q))
            (nzToIntMul (den p) (den q)) ⟩ num p * num q * (nzToInt (den p) * nzToInt (den q))
          ≡⟨ mulPairSwap
            (num p)
            (num q)
            (nzToInt (den p))
            (nzToInt (den q)) ⟩ num p * nzToInt (den p) * (num q * nzToInt (den q))))
    (intSgnPosMul hp hq)

def sgnQMulPos : {u v : El Q} → (sgnQ u ≡ sPos) → (sgnQ v ≡ sPos) → sgnQ (u * v) ≡ sPos
  using (equality.cong.eq,
    equality.trans.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.denInt.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzToInt.eq,
    rationalOrder.Sign.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.intSgnPosMul.eq,
    rationalOrder.ratMulPos.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.*.eq,
    rationalQ.ratMul.eq) ≔
  λu. λv. quot-elim (p. quot-elim (q. λhp. λhq. ratMulPos hp hq) v) u

-- (−x)·c ≡ −(x·c) on ℚ, by inverse uniqueness
def qNegMulL : (x c : El Q) → qNeg x * c ≡ qNeg (x * c) ≔
  λx. λc. qNegUnique
    (trans
      Q
      (x * c + qNeg x * c)
      ((x + qNeg x) * c)
      qZero
      (sym Q ((x + qNeg x) * c) (x * c + qNeg x * c) (qDistribR c x (qNeg x)))
      (trans
        Q
        ((x + qNeg x) * c)
        (qZero * c)
        qZero
        (cong Q (λv. Q) (λv. v * c) (x + qNeg x) qZero (qAddNegR x))
        qMulZeroL))

-- (y − x)·c ≡ y·c − x·c, hypothesis-free
def qSubDistribR : (x y c : El Q) → (y + qNeg x) * c ≡ y * c + qNeg (x * c)
  using (rationalQ.Q.unfold) ≔
  λx. λy. λc. (y + qNeg x) * c
      ≡⟨ qDistribR c y (qNeg x) ⟩ y * c + qNeg x * c
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. y * c + v)
        (qNeg x * c)
        (qNeg (x * c))
        (qNegMulL x c) ⟩ y * c + qNeg (x * c)

-- monotonicity of · by a NONNEGATIVE scalar: case the scalar's sign —
-- a zero scalar collapses both sides, a positive one cases the
-- difference's own sign
-- c ≡ 0: both products are zero, difference too
-- c positive: case the difference's sign
-- y − x ≡ 0: products differ by zero
def leQMulMono : (x y : El Q) {c : El Q} → El (x ≤ y) → El (qZero ≤ c) → El (x * c ≤ y * c)
  using (integer.intNeg.eq,
    integer.intZero.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.ratNeg.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  λx. λy. λc. λle. λlc. let dEq : sgnQ
    (y
      * c
      + qNeg
        (x
          * c)) ≡ sgnQ
    ((y
      + qNeg
        x)
      * c) ≔ cong
    Q
    (λv. Sign)
    (λv. sgnQ v)
    (y * c + qNeg (x * c))
    ((y + qNeg x) * c)
    (sym
      Q
      ((y + qNeg x) * c)
      (y * c + qNeg (x * c))
      (qSubDistribR
        x
        y
        c)) in let cEq : sgnQ
    (c
      + qNeg
        qZero) ≡ sgnQ
    c ≔ cong
    Q
    (λv. Sign)
    (λv. sgnQ v)
    (c + qNeg qZero)
    c
    (trans
      Q
      (c + qNeg qZero)
      (c + qZero)
      c
      (cong Q (λv. Q) (λv. c + v) (qNeg qZero) qZero ⋆)
      (qAddZeroR
        c)) in ⊎-elim
    (hc0. let c0 : c ≡ qZero ≔ sgnQZeroView
      c
      (trans
        Sign
        (sgnQ c)
        (sgnQ (c + qNeg qZero))
        sZero
        (sym Sign (sgnQ (c + qNeg qZero)) (sgnQ c) cEq)
        (idToEq
          Sign
          (sgnQ (c + qNeg qZero))
          sZero
          hc0)) in inj₁ (eqToId
      (sgnQ (y * c + qNeg (x * c)))
      sZero
      (trans
        Sign
        (sgnQ (y * c + qNeg (x * c)))
        (sgnQ ((y + qNeg x) * c))
        sZero
        dEq
        (trans
          Sign
          (sgnQ ((y + qNeg x) * c))
          (sgnQ qZero)
          sZero
          (cong
            Q
            (λv. Sign)
            (λv. sgnQ v)
            ((y + qNeg x) * c)
            qZero
            (trans
              Q
              ((y + qNeg x) * c)
              ((y + qNeg x) * qZero)
              qZero
              (cong Q (λv. Q) (λv. (y + qNeg x) * v) c qZero c0)
              (trans
                Q
                ((y + qNeg x) * qZero)
                (qZero * (y + qNeg x))
                qZero
                (qMulComm (y + qNeg x) qZero)
                qMulZeroL)))
          sgnQZero))))
    (hcp. let hcs : sgnQ
      c ≡ sPos ≔ trans
      Sign
      (sgnQ c)
      (sgnQ (c + qNeg qZero))
      sPos
      (sym Sign (sgnQ (c + qNeg qZero)) (sgnQ c) cEq)
      (idToEq
        Sign
        (sgnQ (c + qNeg qZero))
        sPos
        hcp) in ⊎-elim
      (hd0. let d0 : y
        + qNeg
          x ≡ qZero ≔ sgnQZeroView
        (y + qNeg x)
        (idToEq
          Sign
          (sgnQ (y + qNeg x))
          sZero
          hd0) in inj₁ (eqToId
        (sgnQ (y * c + qNeg (x * c)))
        sZero
        (trans
          Sign
          (sgnQ (y * c + qNeg (x * c)))
          (sgnQ ((y + qNeg x) * c))
          sZero
          dEq
          (trans
            Sign
            (sgnQ ((y + qNeg x) * c))
            (sgnQ qZero)
            sZero
            (cong
              Q
              (λv. Sign)
              (λv. sgnQ v)
              ((y + qNeg x) * c)
              qZero
              (trans
                Q
                ((y + qNeg x) * c)
                (qZero * c)
                qZero
                (cong Q (λv. Q) (λv. v * c) (y + qNeg x) qZero d0)
                qMulZeroL))
            sgnQZero))))
      (hdp. inj₂ (eqToId
        (sgnQ (y * c + qNeg (x * c)))
        sPos
        (trans
          Sign
          (sgnQ (y * c + qNeg (x * c)))
          (sgnQ ((y + qNeg x) * c))
          sPos
          dEq
          (sgnQMulPos (idToEq Sign (sgnQ (y + qNeg x)) sPos hdp) hcs))))
      le)
    lc
