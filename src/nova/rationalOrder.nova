import nat (+, *, plusComm, plusAssoc, swapLeft, zeroPlusId, plusZeroId)
import integer (Int, intZero, intNeg, intNegZero)
import integerAdd (intAdd)
import integerMul (intMul, intMulComm, intMulAssoc, intMulZeroL, intMulZeroR)
import rational (NZ, nzPos, nzNeg, nzToInt, nzMul, Rat, mkRat, num, den, denInt,
                 ratNeg, ratZero, ratAdd, intScale)
import rationalQ (Q, RatR, qcls, qAdd, qNeg, qZero, qAddComm, qAddAssoc,
                  qAddZeroL, qAddZeroR, qAddNegL, qAddNegR, qNegNeg, nzToIntMul,
                  qMul, qMulComm, qMulZeroL, qDistribR, ratMul,
                  intScaleIsMul)
import intNonZero (nzOfInt, nzToIntNonZero, intNoZeroDiv)
import intOrder (intMulDistribR)
import equality (trans, sym, cong, transport)
import rationalInv (ratZeroOfNumZero)
import id (Id, idToEq, eqToId)

-- Order on ℚ via the SIGN: a three-valued small code, computed for an
-- integer by intNonZero's decision (an honest function — no new
-- well-definedness), for a raw fraction as the sign of num·den, and
-- for a class by quot-elim whose well-definedness is the one real
-- theorem here: multiplying by a nonzero SQUARE preserves sign.
def Sign : 𝕌 ≔ 𝟙 ⊎ (𝟙 ⊎ 𝟙)
def sZero : El Sign ≔ inj₁ ()
def sPos : El Sign ≔ inj₂ (inj₁ ())
def sNeg : El Sign ≔ inj₂ (inj₂ ())

def sgnFlip : El Sign → El Sign ≔
  λs. ⊎-elim (w. El Sign) (u. sZero)
        (v. ⊎-elim (w. El Sign) (u. sNeg) (u. sPos) v) s

def nzSgn : El NZ → El Sign ≔
  λe. ⊎-elim (w. El Sign) (n. sPos) (n. sNeg) e

def intSgn : El Int → El Sign ≔
  λz. ⊎-elim (w. El Sign) (u. nzSgn (u .π₁)) (u. sZero) (nzOfInt z)

-- computation: intSgn evaluates on the three shapes, magnitude open
def intSgnZero : intSgn intZero ≡ sZero ∈ El Sign ≔ ⋆
def intSgnPos : (k : ℕ) → intSgn (nzToInt (nzPos k)) ≡ sPos ∈ El Sign ≔ λk. ⋆
def intSgnNeg : (k : ℕ) → intSgn (nzToInt (nzNeg k)) ≡ sNeg ∈ El Sign ≔ λk. ⋆

def intSgnNz : (e : El NZ) → intSgn (nzToInt e) ≡ nzSgn e ∈ El Sign ≔
  λe. ⊎-elim (w. intSgn (nzToInt w) ≡ nzSgn w ∈ El Sign)
        (n. intSgnPos n) (n. intSgnNeg n) e

-- ===== sign multiplicativity: the well-definedness core =====

-- squares in NZ are positive, so scaling by one preserves the sign —
-- all four constructor cases compute (nzMul's sign table is its body)
def nzSgnMulSq : (a : El NZ) (b : El NZ) →
  nzSgn (nzMul a (nzMul b b)) ≡ nzSgn a ∈ El Sign ≔
  λa. λb.
    ⊎-elim (w. nzSgn (nzMul w (nzMul b b)) ≡ nzSgn w ∈ El Sign)
      (m. ⊎-elim (v. nzSgn (nzMul (nzPos m) (nzMul v v)) ≡ nzSgn (nzPos m) ∈ El Sign)
            (k. ⋆) (k. ⋆) b)
      (m. ⊎-elim (v. nzSgn (nzMul (nzNeg m) (nzMul v v)) ≡ nzSgn (nzNeg m) ∈ El Sign)
            (k. ⋆) (k. ⋆) b)
      a

-- multiplying an integer by a nonzero square preserves its sign:
-- decide z, then either both sides are sZero or everything lands in
-- NZ where nzSgnMulSq computes
def intSgnMulSq : (z : El Int) (e : El NZ) →
  intSgn (intMul z (intMul (nzToInt e) (nzToInt e))) ≡ intSgn z ∈ El Sign ≔
  λz. λe.
    ⊎-elim (w. intSgn (intMul z (intMul (nzToInt e) (nzToInt e))) ≡ intSgn z ∈ El Sign)
      (u.
        trans Sign (intSgn (intMul z (intMul (nzToInt e) (nzToInt e))))
              (intSgn (intMul (nzToInt (u .π₁)) (intMul (nzToInt e) (nzToInt e))))
              (intSgn z)
          (cong Int (λv. Sign) (λv. intSgn (intMul v (intMul (nzToInt e) (nzToInt e))))
             z (nzToInt (u .π₁))
             (sym Int (nzToInt (u .π₁)) z (u .π₂)))
          (trans Sign (intSgn (intMul (nzToInt (u .π₁)) (intMul (nzToInt e) (nzToInt e))))
                 (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
                 (intSgn z)
             (trans Sign (intSgn (intMul (nzToInt (u .π₁)) (intMul (nzToInt e) (nzToInt e))))
                    (intSgn (intMul (nzToInt (u .π₁)) (nzToInt (nzMul e e))))
                    (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
                (cong Int (λv. Sign) (λv. intSgn (intMul (nzToInt (u .π₁)) v))
                   (intMul (nzToInt e) (nzToInt e)) (nzToInt (nzMul e e))
                   (sym Int (nzToInt (nzMul e e)) (intMul (nzToInt e) (nzToInt e))
                      (nzToIntMul e e)))
                (cong Int (λv. Sign) (λv. intSgn v)
                   (intMul (nzToInt (u .π₁)) (nzToInt (nzMul e e)))
                   (nzToInt (nzMul (u .π₁) (nzMul e e)))
                   (sym Int (nzToInt (nzMul (u .π₁) (nzMul e e)))
                        (intMul (nzToInt (u .π₁)) (nzToInt (nzMul e e)))
                        (nzToIntMul (u .π₁) (nzMul e e)))))
             (trans Sign (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
                    (nzSgn (u .π₁))
                    (intSgn z)
                (trans Sign (intSgn (nzToInt (nzMul (u .π₁) (nzMul e e))))
                       (nzSgn (nzMul (u .π₁) (nzMul e e)))
                       (nzSgn (u .π₁))
                   (intSgnNz (nzMul (u .π₁) (nzMul e e)))
                   (nzSgnMulSq (u .π₁) e))
                (trans Sign (nzSgn (u .π₁)) (intSgn (nzToInt (u .π₁))) (intSgn z)
                   (sym Sign (intSgn (nzToInt (u .π₁))) (nzSgn (u .π₁))
                      (intSgnNz (u .π₁)))
                   (cong Int (λv. Sign) (λv. intSgn v) (nzToInt (u .π₁)) z (u .π₂))))))
      (hz.
        trans Sign (intSgn (intMul z (intMul (nzToInt e) (nzToInt e))))
              sZero (intSgn z)
          (trans Sign (intSgn (intMul z (intMul (nzToInt e) (nzToInt e))))
                 (intSgn (intMul intZero (intMul (nzToInt e) (nzToInt e))))
                 sZero
             (cong Int (λv. Sign) (λv. intSgn (intMul v (intMul (nzToInt e) (nzToInt e))))
                z intZero hz)
             (trans Sign (intSgn (intMul intZero (intMul (nzToInt e) (nzToInt e))))
                    (intSgn intZero) sZero
                (cong Int (λv. Sign) (λv. intSgn v)
                   (intMul intZero (intMul (nzToInt e) (nzToInt e))) intZero
                   (intMulZeroL (intMul (nzToInt e) (nzToInt e))))
                intSgnZero))
          (sym Sign (intSgn z) sZero
             (trans Sign (intSgn z) (intSgn intZero) sZero
                (cong Int (λv. Sign) (λv. intSgn v) z intZero hz)
                intSgnZero)))
      (nzOfInt z)

-- ===== interchange, hypothesis-free =====

def mulLeftSwap : (b : El Int) (c : El Int) (d : El Int) →
  intMul b (intMul c d) ≡ intMul c (intMul b d) ∈ El Int ≔
  λb. λc. λd.
    (intMul b (intMul c d)
       ≡⟨ sym Int (intMul (intMul b c) d) (intMul b (intMul c d))
            (intMulAssoc b c d) ⟩
     intMul (intMul b c) d
       ≡⟨ cong Int (λv. Int) (λv. intMul v d) (intMul b c) (intMul c b)
            (intMulComm b c) ⟩
     intMul (intMul c b) d
       ≡⟨ intMulAssoc c b d ⟩
     intMul c (intMul b d))

def mulPairSwap : (a : El Int) (b : El Int) (c : El Int) (d : El Int) →
  intMul (intMul a b) (intMul c d) ≡ intMul (intMul a c) (intMul b d) ∈ El Int ≔
  λa. λb. λc. λd.
    (intMul (intMul a b) (intMul c d)
       ≡⟨ intMulAssoc a b (intMul c d) ⟩
     intMul a (intMul b (intMul c d))
       ≡⟨ cong Int (λv. Int) (λv. intMul a v) (intMul b (intMul c d))
            (intMul c (intMul b d)) (mulLeftSwap b c d) ⟩
     intMul a (intMul c (intMul b d))
       ≡⟨ sym Int (intMul (intMul a c) (intMul b d)) (intMul a (intMul c (intMul b d)))
            (intMulAssoc a c (intMul b d)) ⟩
     intMul (intMul a c) (intMul b d))

def mulPairSwapR : (a : El Int) (b : El Int) (c : El Int) (d : El Int) →
  intMul (intMul a b) (intMul c d) ≡ intMul (intMul a d) (intMul c b) ∈ El Int ≔
  λa. λb. λc. λd.
    (intMul (intMul a b) (intMul c d)
       ≡⟨ cong Int (λv. Int) (λv. intMul (intMul a b) v) (intMul c d) (intMul d c)
            (intMulComm c d) ⟩
     intMul (intMul a b) (intMul d c)
       ≡⟨ mulPairSwap a b d c ⟩
     intMul (intMul a d) (intMul b c)
       ≡⟨ cong Int (λv. Int) (λv. intMul (intMul a d) v) (intMul b c) (intMul c b)
            (intMulComm b c) ⟩
     intMul (intMul a d) (intMul c b))

-- ===== the sign of a fraction, and its well-definedness =====

def ratSgn : El Rat → El Sign ≔ λp. intSgn (intMul (num p) (denInt p))

-- RatR p q cross-multiplies; scale each side's num·den by the OTHER
-- side's den², interchange, and rewrite across the relation — signs
-- survive because squares do (intSgnMulSq)
def ratSgnWD : (p : El Rat) (q : El Rat) → Prf (RatR p q) →
  ratSgn p ≡ ratSgn q ∈ El Sign ≔
  λp. λq. λh.
    trans Sign (intSgn (intMul (num p) (denInt p)))
          (intSgn (intMul (intMul (num p) (denInt p))
                          (intMul (denInt q) (denInt q))))
          (intSgn (intMul (num q) (denInt q)))
      (sym Sign
         (intSgn (intMul (intMul (num p) (denInt p))
                         (intMul (denInt q) (denInt q))))
         (intSgn (intMul (num p) (denInt p)))
         (intSgnMulSq (intMul (num p) (denInt p)) (den q)))
      (trans Sign
         (intSgn (intMul (intMul (num p) (denInt p))
                         (intMul (denInt q) (denInt q))))
         (intSgn (intMul (intMul (num p) (denInt q))
                         (intMul (denInt p) (denInt q))))
         (intSgn (intMul (num q) (denInt q)))
         (cong Int (λv. Sign) (λv. intSgn v)
            (intMul (intMul (num p) (denInt p)) (intMul (denInt q) (denInt q)))
            (intMul (intMul (num p) (denInt q)) (intMul (denInt p) (denInt q)))
            (mulPairSwap (num p) (denInt p) (denInt q) (denInt q)))
         (trans Sign
            (intSgn (intMul (intMul (num p) (denInt q))
                            (intMul (denInt p) (denInt q))))
            (intSgn (intMul (intMul (num q) (denInt p))
                            (intMul (denInt p) (denInt q))))
            (intSgn (intMul (num q) (denInt q)))
            (cong Int (λv. Sign)
               (λv. intSgn (intMul v (intMul (denInt p) (denInt q))))
               (intMul (num p) (denInt q)) (intMul (num q) (denInt p)) h)
            (trans Sign
               (intSgn (intMul (intMul (num q) (denInt p))
                               (intMul (denInt p) (denInt q))))
               (intSgn (intMul (intMul (num q) (denInt q))
                               (intMul (denInt p) (denInt p))))
               (intSgn (intMul (num q) (denInt q)))
               (cong Int (λv. Sign) (λv. intSgn v)
                  (intMul (intMul (num q) (denInt p)) (intMul (denInt p) (denInt q)))
                  (intMul (intMul (num q) (denInt q)) (intMul (denInt p) (denInt p)))
                  (mulPairSwapR (num q) (denInt p) (denInt p) (denInt q)))
               (intSgnMulSq (intMul (num q) (denInt q)) (den p)))))

-- the sign of a rational: quot-elim, well-defined by ratSgnWD
def sgnQ : El Q → El Sign using (ratSgnWD) ≔
  λu. quot-elim (w. El Sign) (p. ratSgn p) u

def sgnQCls : (p : El Rat) → sgnQ (qcls p) ≡ ratSgn p ∈ El Sign ≔ λp. ⋆
def sgnQZero : sgnQ qZero ≡ sZero ∈ El Sign ≔ ⋆

-- ===== negation and the sign flip =====

-- (−z)·w ≡ −(z·w): both sides compute on classes to plusComm-related
-- pairs
def intMulNegL : (z : El Int) (w : El Int) →
  intMul (intNeg z) w ≡ intNeg (intMul z w) ∈ El Int
  using (plusAssoc, rational.plusSwapRight, integerMul.sum4Distrib,
         integerMul.distribBackR, intEffective.intRRefl) ≔
  λz. λw.
    quot-elim (a. intMul (intNeg a) w ≡ intNeg (intMul a w) ∈ El Int)
      (u. quot-elim (b. intMul (intNeg (class u)) b ≡ intNeg (intMul (class u) b) ∈ El Int)
            (v. ⋆) w)
      z

-- negating flips the decided sign, shape by shape
def intSgnNegNz : (e : El NZ) →
  intSgn (intNeg (nzToInt e)) ≡ sgnFlip (nzSgn e) ∈ El Sign ≔
  λe. ⊎-elim (w. intSgn (intNeg (nzToInt w)) ≡ sgnFlip (nzSgn w) ∈ El Sign)
        (n. ⋆) (n. ⋆) e

def intSgnNegFlip : (z : El Int) →
  intSgn (intNeg z) ≡ sgnFlip (intSgn z) ∈ El Sign ≔
  λz.
    ⊎-elim (w. intSgn (intNeg z) ≡ sgnFlip (intSgn z) ∈ El Sign)
      (u.
        trans Sign (intSgn (intNeg z)) (intSgn (intNeg (nzToInt (u .π₁))))
              (sgnFlip (intSgn z))
          (cong Int (λv. Sign) (λv. intSgn (intNeg v)) z (nzToInt (u .π₁))
             (sym Int (nzToInt (u .π₁)) z (u .π₂)))
          (trans Sign (intSgn (intNeg (nzToInt (u .π₁)))) (sgnFlip (nzSgn (u .π₁)))
                 (sgnFlip (intSgn z))
             (intSgnNegNz (u .π₁))
             (trans Sign (sgnFlip (nzSgn (u .π₁))) (sgnFlip (intSgn (nzToInt (u .π₁))))
                    (sgnFlip (intSgn z))
                (cong Sign (λv. Sign) (λv. sgnFlip v) (nzSgn (u .π₁))
                   (intSgn (nzToInt (u .π₁)))
                   (sym Sign (intSgn (nzToInt (u .π₁))) (nzSgn (u .π₁))
                      (intSgnNz (u .π₁))))
                (cong Int (λv. Sign) (λv. sgnFlip (intSgn v)) (nzToInt (u .π₁)) z
                   (u .π₂)))))
      (hz.
        trans Sign (intSgn (intNeg z)) sZero (sgnFlip (intSgn z))
          (trans Sign (intSgn (intNeg z)) (intSgn (intNeg intZero)) sZero
             (cong Int (λv. Sign) (λv. intSgn (intNeg v)) z intZero hz)
             (trans Sign (intSgn (intNeg intZero)) (intSgn intZero) sZero
                (cong Int (λv. Sign) (λv. intSgn v) (intNeg intZero) intZero
                   intNegZero)
                intSgnZero))
          (sym Sign (sgnFlip (intSgn z)) sZero
             (trans Sign (sgnFlip (intSgn z)) (sgnFlip sZero) sZero
                (cong Sign (λv. Sign) (λv. sgnFlip v) (intSgn z) sZero
                   (trans Sign (intSgn z) (intSgn intZero) sZero
                      (cong Int (λv. Sign) (λv. intSgn v) z intZero hz)
                      intSgnZero))
                ⋆)))
      (nzOfInt z)

-- ===== ℚ additive-group algebra, hypothesis-free =====

def qLeftSwap : (b : El Q) (c : El Q) (d : El Q) →
  qAdd b (qAdd c d) ≡ qAdd c (qAdd b d) ∈ El Q ≔
  λb. λc. λd.
    (qAdd b (qAdd c d)
       ≡⟨ sym Q (qAdd (qAdd b c) d) (qAdd b (qAdd c d)) (qAddAssoc b c d) ⟩
     qAdd (qAdd b c) d
       ≡⟨ cong Q (λv. Q) (λv. qAdd v d) (qAdd b c) (qAdd c b) (qAddComm b c) ⟩
     qAdd (qAdd c b) d
       ≡⟨ qAddAssoc c b d ⟩
     qAdd c (qAdd b d))

def qPairSwap : (a : El Q) (b : El Q) (c : El Q) (d : El Q) →
  qAdd (qAdd a b) (qAdd c d) ≡ qAdd (qAdd a c) (qAdd b d) ∈ El Q ≔
  λa. λb. λc. λd.
    (qAdd (qAdd a b) (qAdd c d)
       ≡⟨ qAddAssoc a b (qAdd c d) ⟩
     qAdd a (qAdd b (qAdd c d))
       ≡⟨ cong Q (λv. Q) (λv. qAdd a v) (qAdd b (qAdd c d)) (qAdd c (qAdd b d))
            (qLeftSwap b c d) ⟩
     qAdd a (qAdd c (qAdd b d))
       ≡⟨ sym Q (qAdd (qAdd a c) (qAdd b d)) (qAdd a (qAdd c (qAdd b d)))
            (qAddAssoc a c (qAdd b d)) ⟩
     qAdd (qAdd a c) (qAdd b d))

-- −u + (u + v) ≡ v, then inverse uniqueness, then −(a+b) ≡ (−a)+(−b)
def qNegPlusCancel : (u : El Q) (v : El Q) →
  qAdd (qNeg u) (qAdd u v) ≡ v ∈ El Q ≔
  λu. λv.
    (qAdd (qNeg u) (qAdd u v)
       ≡⟨ sym Q (qAdd (qAdd (qNeg u) u) v) (qAdd (qNeg u) (qAdd u v))
            (qAddAssoc (qNeg u) u v) ⟩
     qAdd (qAdd (qNeg u) u) v
       ≡⟨ cong Q (λw. Q) (λw. qAdd w v) (qAdd (qNeg u) u) (qAdd u (qNeg u))
            (qAddComm (qNeg u) u) ⟩
     qAdd (qAdd u (qNeg u)) v
       ≡⟨ cong Q (λw. Q) (λw. qAdd w v) (qAdd u (qNeg u)) qZero (qAddNegR u) ⟩
     qAdd qZero v
       ≡⟨ qAddZeroL v ⟩
     v)

def qNegUnique : (u : El Q) (v : El Q) → (qAdd u v ≡ qZero ∈ El Q) →
  v ≡ qNeg u ∈ El Q ≔
  λu. λv. λh.
    trans Q v (qAdd (qNeg u) (qAdd u v)) (qNeg u)
      (sym Q (qAdd (qNeg u) (qAdd u v)) v (qNegPlusCancel u v))
      (trans Q (qAdd (qNeg u) (qAdd u v)) (qAdd (qNeg u) qZero) (qNeg u)
         (cong Q (λw. Q) (λw. qAdd (qNeg u) w) (qAdd u v) qZero h)
         (trans Q (qAdd (qNeg u) qZero) (qAdd qZero (qNeg u)) (qNeg u)
            (qAddComm (qNeg u) qZero)
            (qAddZeroL (qNeg u))))

def qNegAdd : (a : El Q) (b : El Q) →
  qNeg (qAdd a b) ≡ qAdd (qNeg a) (qNeg b) ∈ El Q ≔
  λa. λb.
    sym Q (qAdd (qNeg a) (qNeg b)) (qNeg (qAdd a b))
      (qNegUnique (qAdd a b) (qAdd (qNeg a) (qNeg b))
         (trans Q (qAdd (qAdd a b) (qAdd (qNeg a) (qNeg b)))
                (qAdd (qAdd a (qNeg a)) (qAdd b (qNeg b))) qZero
            (qPairSwap a b (qNeg a) (qNeg b))
            (trans Q (qAdd (qAdd a (qNeg a)) (qAdd b (qNeg b)))
                   (qAdd qZero (qAdd b (qNeg b))) qZero
               (cong Q (λw. Q) (λw. qAdd w (qAdd b (qNeg b)))
                  (qAdd a (qNeg a)) qZero (qAddNegR a))
               (trans Q (qAdd qZero (qAdd b (qNeg b))) (qAdd b (qNeg b)) qZero
                  (qAddZeroL (qAdd b (qNeg b)))
                  (qAddNegR b)))))

def qSubNeg : (x : El Q) (y : El Q) →
  qAdd x (qNeg y) ≡ qNeg (qAdd y (qNeg x)) ∈ El Q ≔
  λx. λy.
    sym Q (qNeg (qAdd y (qNeg x))) (qAdd x (qNeg y))
      (trans Q (qNeg (qAdd y (qNeg x))) (qAdd (qNeg y) (qNeg (qNeg x)))
             (qAdd x (qNeg y))
         (qNegAdd y (qNeg x))
         (trans Q (qAdd (qNeg y) (qNeg (qNeg x))) (qAdd (qNeg y) x)
                (qAdd x (qNeg y))
            (cong Q (λw. Q) (λw. qAdd (qNeg y) w) (qNeg (qNeg x)) x (qNegNeg x))
            (qAddComm (qNeg y) x)))

-- the flip, lifted to ℚ (representative abstract: D-3)
def sgnQNegFlip : (u : El Q) → sgnQ (qNeg u) ≡ sgnFlip (sgnQ u) ∈ El Sign ≔
  λu.
    quot-elim (w. sgnQ (qNeg w) ≡ sgnFlip (sgnQ w) ∈ El Sign)
      (p.
        trans Sign (sgnQ (qNeg (class p)))
              (intSgn (intNeg (intMul (num p) (denInt p))))
              (sgnFlip (sgnQ (class p)))
          (trans Sign (sgnQ (qNeg (class p)))
                 (intSgn (intMul (intNeg (num p)) (denInt p)))
                 (intSgn (intNeg (intMul (num p) (denInt p))))
             ⋆
             (cong Int (λv. Sign) (λv. intSgn v)
                (intMul (intNeg (num p)) (denInt p))
                (intNeg (intMul (num p) (denInt p)))
                (intMulNegL (num p) (denInt p))))
          (intSgnNegFlip (intMul (num p) (denInt p))))
      u

-- ===== the order =====

def NonNegS : El Sign → 𝕌 ≔ λs. (Id Sign s sZero ⊎ Id Sign s sPos)

def LeQ : El Q → El Q → 𝕌 ≔ λx. λy. NonNegS (sgnQ (qAdd y (qNeg x)))

def leQRefl : (x : El Q) → El (LeQ x x) ≔
  λx. inj₁ (eqToId Sign (sgnQ (qAdd x (qNeg x))) sZero
              (trans Sign (sgnQ (qAdd x (qNeg x))) (sgnQ qZero) sZero
                 (cong Q (λu. Sign) (λu. sgnQ u) (qAdd x (qNeg x)) qZero
                    (qAddNegR x))
                 sgnQZero))

def leQOfEq : (x : El Q) (y : El Q) → (x ≡ y ∈ El Q) → El (LeQ x y) ≔
  λx. λy. λh.
    inj₁ (eqToId Sign (sgnQ (qAdd y (qNeg x))) sZero
            (trans Sign (sgnQ (qAdd y (qNeg x))) (sgnQ qZero) sZero
               (cong Q (λu. Sign) (λu. sgnQ u) (qAdd y (qNeg x)) qZero
                  (trans Q (qAdd y (qNeg x)) (qAdd y (qNeg y)) qZero
                     (cong Q (λu. Q) (λu. qAdd y (qNeg u)) x y h)
                     (qAddNegR y)))
               sgnQZero))

-- every sign is nonneg or negative — the DECISION, as data
def sgnCases : (s : El Sign) → El (NonNegS s) ⊎ El (Id Sign s sNeg) ≔
  λs.
    ⊎-elim (w. El (NonNegS w) ⊎ El (Id Sign w sNeg))
      (u. inj₁ (inj₁ (eqToId Sign (inj₁ u) sZero ⋆)))
      (v. ⊎-elim (w. El (NonNegS (inj₂ w)) ⊎ El (Id Sign (inj₂ w) sNeg))
            (u. inj₁ (inj₂ (eqToId Sign (inj₂ (inj₁ u)) sPos ⋆)))
            (u. inj₂ (eqToId Sign (inj₂ (inj₂ u)) sNeg ⋆))
            v)
      s

-- totality: decide the difference's sign; a negative difference flips
def leQTotal : (x : El Q) (y : El Q) → El (LeQ x y) ⊎ El (LeQ y x) ≔
  λx. λy.
    ⊎-elim (w. El (LeQ x y) ⊎ El (LeQ y x))
      (nn. inj₁ nn)
      (hneg.
        inj₂ (inj₂ (eqToId Sign (sgnQ (qAdd x (qNeg y))) sPos
          (trans Sign (sgnQ (qAdd x (qNeg y)))
                 (sgnFlip (sgnQ (qAdd y (qNeg x)))) sPos
             (trans Sign (sgnQ (qAdd x (qNeg y)))
                    (sgnQ (qNeg (qAdd y (qNeg x))))
                    (sgnFlip (sgnQ (qAdd y (qNeg x))))
                (cong Q (λu. Sign) (λu. sgnQ u) (qAdd x (qNeg y))
                   (qNeg (qAdd y (qNeg x))) (qSubNeg x y))
                (sgnQNegFlip (qAdd y (qNeg x))))
             (trans Sign (sgnFlip (sgnQ (qAdd y (qNeg x)))) (sgnFlip sNeg) sPos
                (cong Sign (λu. Sign) (λu. sgnFlip u) (sgnQ (qAdd y (qNeg x))) sNeg
                   (idToEq Sign (sgnQ (qAdd y (qNeg x))) sNeg hneg))
                ⋆)))))
      (sgnCases (sgnQ (qAdd y (qNeg x))))

-- ===== sign discrimination (transport along a discriminating family) =====

def sIsNeg : El Sign → 𝕌 ≔
  λs. ⊎-elim (w. 𝕌) (u. 𝟘) (v. ⊎-elim (w. 𝕌) (u. 𝟘) (u. 𝟙) v) s
def sIsPos : El Sign → 𝕌 ≔
  λs. ⊎-elim (w. 𝕌) (u. 𝟘) (v. ⊎-elim (w. 𝕌) (u. 𝟙) (u. 𝟘) v) s

def sZeroNotNeg : (sZero ≡ sNeg ∈ El Sign) → 𝟘 ≔
  λh. transport Sign sIsNeg sNeg sZero (sym Sign sZero sNeg h) ()
def sPosNotNeg : (sPos ≡ sNeg ∈ El Sign) → 𝟘 ≔
  λh. transport Sign sIsNeg sNeg sPos (sym Sign sPos sNeg h) ()
def sZeroNotPos : (sZero ≡ sPos ∈ El Sign) → 𝟘 ≔
  λh. transport Sign sIsPos sPos sZero (sym Sign sZero sPos h) ()
def sNegNotPos : (sNeg ≡ sPos ∈ El Sign) → 𝟘 ≔
  λh. transport Sign sIsPos sPos sNeg (sym Sign sNeg sPos h) ()

-- ===== views: a sign verdict names the integer's shape =====

def intSgnPosView : (z : El Int) → (intSgn z ≡ sPos ∈ El Sign) →
  ((k : ℕ) ⨯ Prf (nzToInt (nzPos k) ≡ z ∈ El Int)) ≔
  λz. λh.
    ⊎-elim (w. ((k : ℕ) ⨯ Prf (nzToInt (nzPos k) ≡ z ∈ El Int)))
      (u.
        (⊎-elim (w. Prf (nzToInt w ≡ z ∈ El Int) →
                    ((k : ℕ) ⨯ Prf (nzToInt (nzPos k) ≡ z ∈ El Int)))
          (k. λhe. (k , he))
          (k. λhe.
            𝟘-elim (sNegNotPos
              (trans Sign sNeg (intSgn z) sPos
                 (sym Sign (intSgn z) sNeg
                    (trans Sign (intSgn z) (intSgn (nzToInt (nzNeg k))) sNeg
                       (cong Int (λv. Sign) (λv. intSgn v) z (nzToInt (nzNeg k))
                          (sym Int (nzToInt (nzNeg k)) z he))
                       (intSgnNeg k)))
                 h)))
          (u .π₁)) (u .π₂))
      (hz.
        𝟘-elim (sZeroNotPos
          (trans Sign sZero (intSgn z) sPos
             (sym Sign (intSgn z) sZero
                (trans Sign (intSgn z) (intSgn intZero) sZero
                   (cong Int (λv. Sign) (λv. intSgn v) z intZero hz)
                   intSgnZero))
             h)))
      (nzOfInt z)

def intSgnZeroView : (z : El Int) → (intSgn z ≡ sZero ∈ El Sign) →
  z ≡ intZero ∈ El Int ≔
  λz. λh.
    ⊎-elim (w. z ≡ intZero ∈ El Int)
      (u.
        (⊎-elim (w. Prf (nzToInt w ≡ z ∈ El Int) → (z ≡ intZero ∈ El Int))
          (k. λhe.
            𝟘-elim (sZeroNotPos
              (trans Sign sZero (intSgn z) sPos
                 (sym Sign (intSgn z) sZero h)
                 (trans Sign (intSgn z) (intSgn (nzToInt (nzPos k))) sPos
                    (cong Int (λv. Sign) (λv. intSgn v) z (nzToInt (nzPos k))
                       (sym Int (nzToInt (nzPos k)) z he))
                    (intSgnPos k)))))
          (k. λhe.
            𝟘-elim (sZeroNotNeg
              (trans Sign sZero (intSgn z) sNeg
                 (sym Sign (intSgn z) sZero h)
                 (trans Sign (intSgn z) (intSgn (nzToInt (nzNeg k))) sNeg
                    (cong Int (λv. Sign) (λv. intSgn v) z (nzToInt (nzNeg k))
                       (sym Int (nzToInt (nzNeg k)) z he))
                    (intSgnNeg k)))))
          (u .π₁)) (u .π₂))
      (hz. hz)
      (nzOfInt z)

-- ===== positivity algebra =====

-- positives multiply to a positive: view both, drop to the NZ layer,
-- where nzMul computes its own sign table
def intSgnPosMul : (a : El Int) (b : El Int) →
  (intSgn a ≡ sPos ∈ El Sign) → (intSgn b ≡ sPos ∈ El Sign) →
  intSgn (intMul a b) ≡ sPos ∈ El Sign ≔
  λa. λb. λha. λhb.
    let va ≔ intSgnPosView a ha in
    let vb ≔ intSgnPosView b hb in
    trans Sign (intSgn (intMul a b))
          (intSgn (intMul (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁)))))
          sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intMul a b)
         (intMul (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁))))
         (trans Int (intMul a b) (intMul (nzToInt (nzPos (va .π₁))) b)
                (intMul (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁))))
            (cong Int (λv. Int) (λv. intMul v b) a (nzToInt (nzPos (va .π₁)))
               (sym Int (nzToInt (nzPos (va .π₁))) a (va .π₂)))
            (cong Int (λv. Int) (λv. intMul (nzToInt (nzPos (va .π₁))) v)
               b (nzToInt (nzPos (vb .π₁)))
               (sym Int (nzToInt (nzPos (vb .π₁))) b (vb .π₂)))))
      (trans Sign (intSgn (intMul (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁)))))
             (intSgn (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁)))))
             sPos
         (cong Int (λv. Sign) (λv. intSgn v)
            (intMul (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁))))
            (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
            (sym Int (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
                 (intMul (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁))))
                 (nzToIntMul (nzPos (va .π₁)) (nzPos (vb .π₁)))))
         (trans Sign (intSgn (nzToInt (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁)))))
                (nzSgn (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
                sPos
            (intSgnNz (nzMul (nzPos (va .π₁)) (nzPos (vb .π₁))))
            ⋆))

-- positives add to a positive: both views land on class (S j , Z)
-- forms, whose sum computes to another one
def intSgnPosAdd : (a : El Int) (b : El Int) →
  (intSgn a ≡ sPos ∈ El Sign) → (intSgn b ≡ sPos ∈ El Sign) →
  intSgn (intAdd a b) ≡ sPos ∈ El Sign ≔
  λa. λb. λha. λhb.
    let va ≔ intSgnPosView a ha in
    let vb ≔ intSgnPosView b hb in
    trans Sign (intSgn (intAdd a b))
          (intSgn (intAdd (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁)))))
          sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intAdd a b)
         (intAdd (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁))))
         (trans Int (intAdd a b) (intAdd (nzToInt (nzPos (va .π₁))) b)
                (intAdd (nzToInt (nzPos (va .π₁))) (nzToInt (nzPos (vb .π₁))))
            (cong Int (λv. Int) (λv. intAdd v b) a (nzToInt (nzPos (va .π₁)))
               (sym Int (nzToInt (nzPos (va .π₁))) a (va .π₂)))
            (cong Int (λv. Int) (λv. intAdd (nzToInt (nzPos (va .π₁))) v)
               b (nzToInt (nzPos (vb .π₁)))
               (sym Int (nzToInt (nzPos (vb .π₁))) b (vb .π₂)))))
      ⋆

-- the two cross terms of a fraction sum, scaled by the common
-- denominator, carry their fraction's sign: shuffle to
-- (num·den)·(den'·den') and drop the square
def ratCrossPosL : (p : El Rat) (q : El Rat) →
  (ratSgn p ≡ sPos ∈ El Sign) →
  intSgn (intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q))))
    ≡ sPos ∈ El Sign ≔
  λp. λq. λhp.
    trans Sign
      (intSgn (intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q)))))
      (intSgn (intMul (intMul (num p) (denInt p)) (intMul (denInt q) (denInt q))))
      sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q))))
         (intMul (intMul (num p) (denInt p)) (intMul (denInt q) (denInt q)))
         ((intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q)))
             ≡⟨ cong Int (λv. Int) (λv. intMul v (nzToInt (nzMul (den p) (den q))))
                  (intScale (den q) (num p)) (intMul (nzToInt (den q)) (num p))
                  (intScaleIsMul (den q) (num p)) ⟩
           intMul (intMul (nzToInt (den q)) (num p)) (nzToInt (nzMul (den p) (den q)))
             ≡⟨ cong Int (λv. Int)
                  (λv. intMul (intMul (nzToInt (den q)) (num p)) v)
                  (nzToInt (nzMul (den p) (den q)))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
                  (nzToIntMul (den p) (den q)) ⟩
           intMul (intMul (nzToInt (den q)) (num p))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
             ≡⟨ cong Int (λv. Int)
                  (λv. intMul v (intMul (nzToInt (den p)) (nzToInt (den q))))
                  (intMul (nzToInt (den q)) (num p)) (intMul (num p) (nzToInt (den q)))
                  (intMulComm (nzToInt (den q)) (num p)) ⟩
           intMul (intMul (num p) (nzToInt (den q)))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
             ≡⟨ mulPairSwap (num p) (nzToInt (den q)) (nzToInt (den p)) (nzToInt (den q)) ⟩
           intMul (intMul (num p) (nzToInt (den p)))
                  (intMul (nzToInt (den q)) (nzToInt (den q))))))
      (trans Sign
         (intSgn (intMul (intMul (num p) (denInt p)) (intMul (denInt q) (denInt q))))
         (intSgn (intMul (num p) (denInt p)))
         sPos
         (intSgnMulSq (intMul (num p) (denInt p)) (den q))
         hp)

def ratCrossPosR : (p : El Rat) (q : El Rat) →
  (ratSgn q ≡ sPos ∈ El Sign) →
  intSgn (intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q))))
    ≡ sPos ∈ El Sign ≔
  λp. λq. λhq.
    trans Sign
      (intSgn (intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q)))))
      (intSgn (intMul (intMul (num q) (denInt q)) (intMul (denInt p) (denInt p))))
      sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q))))
         (intMul (intMul (num q) (denInt q)) (intMul (denInt p) (denInt p)))
         ((intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q)))
             ≡⟨ cong Int (λv. Int) (λv. intMul v (nzToInt (nzMul (den p) (den q))))
                  (intScale (den p) (num q)) (intMul (nzToInt (den p)) (num q))
                  (intScaleIsMul (den p) (num q)) ⟩
           intMul (intMul (nzToInt (den p)) (num q)) (nzToInt (nzMul (den p) (den q)))
             ≡⟨ cong Int (λv. Int)
                  (λv. intMul (intMul (nzToInt (den p)) (num q)) v)
                  (nzToInt (nzMul (den p) (den q)))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
                  (nzToIntMul (den p) (den q)) ⟩
           intMul (intMul (nzToInt (den p)) (num q))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
             ≡⟨ cong Int (λv. Int)
                  (λv. intMul v (intMul (nzToInt (den p)) (nzToInt (den q))))
                  (intMul (nzToInt (den p)) (num q)) (intMul (num q) (nzToInt (den p)))
                  (intMulComm (nzToInt (den p)) (num q)) ⟩
           intMul (intMul (num q) (nzToInt (den p)))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
             ≡⟨ mulPairSwapR (num q) (nzToInt (den p)) (nzToInt (den p)) (nzToInt (den q)) ⟩
           intMul (intMul (num q) (nzToInt (den q)))
                  (intMul (nzToInt (den p)) (nzToInt (den p))))))
      (trans Sign
         (intSgn (intMul (intMul (num q) (denInt q)) (intMul (denInt p) (denInt p))))
         (intSgn (intMul (num q) (denInt q)))
         sPos
         (intSgnMulSq (intMul (num q) (denInt q)) (den p))
         hq)

-- positive fractions add to a positive fraction
def ratAddPos : (p : El Rat) (q : El Rat) →
  (ratSgn p ≡ sPos ∈ El Sign) → (ratSgn q ≡ sPos ∈ El Sign) →
  ratSgn (ratAdd p q) ≡ sPos ∈ El Sign ≔
  λp. λq. λhp. λhq.
    trans Sign (ratSgn (ratAdd p q))
          (intSgn (intAdd
             (intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q))))
             (intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q))))))
          sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intMul (intAdd (intScale (den q) (num p)) (intScale (den p) (num q)))
                 (nzToInt (nzMul (den p) (den q))))
         (intAdd
            (intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q))))
            (intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q)))))
         (intMulDistribR (intScale (den q) (num p)) (intScale (den p) (num q))
            (nzToInt (nzMul (den p) (den q)))))
      (intSgnPosAdd
         (intMul (intScale (den q) (num p)) (nzToInt (nzMul (den p) (den q))))
         (intMul (intScale (den p) (num q)) (nzToInt (nzMul (den p) (den q))))
         (ratCrossPosL p q hp)
         (ratCrossPosR p q hq))

-- ===== lifting to ℚ =====

-- positivity adds (representatives abstract, hypotheses as Π's in the
-- motive — the qMulInvR pattern)
def sgnQAddPos : (u : El Q) (v : El Q) →
  (sgnQ u ≡ sPos ∈ El Sign) → (sgnQ v ≡ sPos ∈ El Sign) →
  sgnQ (qAdd u v) ≡ sPos ∈ El Sign ≔
  λu. λv.
    (quot-elim (w. (sgnQ w ≡ sPos ∈ El Sign) → (sgnQ v ≡ sPos ∈ El Sign) →
                   (sgnQ (qAdd w v) ≡ sPos ∈ El Sign))
       (p. (quot-elim (w. (sgnQ (class p) ≡ sPos ∈ El Sign) →
                          (sgnQ w ≡ sPos ∈ El Sign) →
                          (sgnQ (qAdd (class p) w) ≡ sPos ∈ El Sign))
              (q. λhp. λhq. ratAddPos p q hp hq)
              v))
       u)

-- a zero sign names the zero class
def sgnQZeroView : (u : El Q) → (sgnQ u ≡ sZero ∈ El Sign) →
  u ≡ qZero ∈ El Q ≔
  λu.
    (quot-elim (w. (sgnQ w ≡ sZero ∈ El Sign) → (w ≡ qZero ∈ El Q))
       (p. λh.
         ratZeroOfNumZero p
           (intNoZeroDiv (num p) (denInt p)
              (intSgnZeroView (intMul (num p) (denInt p)) h)
              (nzToIntNonZero (den p))))
       u)

-- (z − y) + (y − x) ≡ z − x
def qSubSplit : (x : El Q) (y : El Q) (z : El Q) →
  qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x)) ≡ qAdd z (qNeg x) ∈ El Q ≔
  λx. λy. λz.
    (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))
       ≡⟨ qAddAssoc z (qNeg y) (qAdd y (qNeg x)) ⟩
     qAdd z (qAdd (qNeg y) (qAdd y (qNeg x)))
       ≡⟨ cong Q (λw. Q) (λw. qAdd z w) (qAdd (qNeg y) (qAdd y (qNeg x))) (qNeg x)
            (qNegPlusCancel y (qNeg x)) ⟩
     qAdd z (qNeg x))

-- (a − b) + b ≡ a, hypothesis-free
def qPlusNegCancelR : (a : El Q) (b : El Q) →
  qAdd (qAdd a (qNeg b)) b ≡ a ∈ El Q ≔
  λa. λb.
    (qAdd (qAdd a (qNeg b)) b
       ≡⟨ qAddAssoc a (qNeg b) b ⟩
     qAdd a (qAdd (qNeg b) b)
       ≡⟨ cong Q (λw. Q) (λw. qAdd a w) (qAdd (qNeg b) b) qZero (qAddNegL b) ⟩
     qAdd a qZero
       ≡⟨ qAddZeroR a ⟩
     a)

-- a zero difference names an equality
def qDiffZero : (a : El Q) (b : El Q) →
  (qAdd a (qNeg b) ≡ qZero ∈ El Q) → a ≡ b ∈ El Q ≔
  λa. λb. λh.
    trans Q a (qAdd (qAdd a (qNeg b)) b) b
      (sym Q (qAdd (qAdd a (qNeg b)) b) a (qPlusNegCancelR a b))
      (trans Q (qAdd (qAdd a (qNeg b)) b) (qAdd qZero b) b
         (cong Q (λw. Q) (λw. qAdd w b) (qAdd a (qNeg b)) qZero h)
         (qAddZeroL b))

-- ===== transitivity and antisymmetry =====

def leQTrans : (x : El Q) (y : El Q) (z : El Q) →
  El (LeQ x y) → El (LeQ y z) → El (LeQ x z) ≔
  λx. λy. λz. λl1. λl2.
    let comb : sgnQ (qAdd z (qNeg x))
                 ≡ sgnQ (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))) ∈ El Sign ≔
      cong Q (λw. Sign) (λw. sgnQ w) (qAdd z (qNeg x))
        (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x)))
        (sym Q (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))) (qAdd z (qNeg x))
           (qSubSplit x y z)) in
    ⊎-elim (w. El (LeQ x z))
      (h10.
        let e0 ≔ sgnQZeroView (qAdd y (qNeg x))
                   (idToEq Sign (sgnQ (qAdd y (qNeg x))) sZero h10) in
        let eq : sgnQ (qAdd z (qNeg x)) ≡ sgnQ (qAdd z (qNeg y)) ∈ El Sign ≔
          trans Sign (sgnQ (qAdd z (qNeg x)))
                (sgnQ (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))))
                (sgnQ (qAdd z (qNeg y)))
            comb
            (cong Q (λw. Sign) (λw. sgnQ w)
               (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))) (qAdd z (qNeg y))
               (trans Q (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x)))
                      (qAdd (qAdd z (qNeg y)) qZero) (qAdd z (qNeg y))
                  (cong Q (λw. Q) (λw. qAdd (qAdd z (qNeg y)) w)
                     (qAdd y (qNeg x)) qZero e0)
                  (qAddZeroR (qAdd z (qNeg y))))) in
        transport Sign NonNegS (sgnQ (qAdd z (qNeg y))) (sgnQ (qAdd z (qNeg x)))
          (sym Sign (sgnQ (qAdd z (qNeg x))) (sgnQ (qAdd z (qNeg y))) eq)
          l2)
      (h1p.
        ⊎-elim (w. El (LeQ x z))
          (h20.
            let e0 ≔ sgnQZeroView (qAdd z (qNeg y))
                       (idToEq Sign (sgnQ (qAdd z (qNeg y))) sZero h20) in
            let eq : sgnQ (qAdd z (qNeg x)) ≡ sgnQ (qAdd y (qNeg x)) ∈ El Sign ≔
              trans Sign (sgnQ (qAdd z (qNeg x)))
                    (sgnQ (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))))
                    (sgnQ (qAdd y (qNeg x)))
                comb
                (cong Q (λw. Sign) (λw. sgnQ w)
                   (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x))) (qAdd y (qNeg x))
                   (trans Q (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x)))
                          (qAdd qZero (qAdd y (qNeg x))) (qAdd y (qNeg x))
                      (cong Q (λw. Q) (λw. qAdd w (qAdd y (qNeg x)))
                         (qAdd z (qNeg y)) qZero e0)
                      (qAddZeroL (qAdd y (qNeg x))))) in
            transport Sign NonNegS (sgnQ (qAdd y (qNeg x))) (sgnQ (qAdd z (qNeg x)))
              (sym Sign (sgnQ (qAdd z (qNeg x))) (sgnQ (qAdd y (qNeg x))) eq)
              (inj₂ h1p))
          (h2p.
            inj₂ (eqToId Sign (sgnQ (qAdd z (qNeg x))) sPos
              (trans Sign (sgnQ (qAdd z (qNeg x)))
                     (sgnQ (qAdd (qAdd z (qNeg y)) (qAdd y (qNeg x)))) sPos
                 comb
                 (sgnQAddPos (qAdd z (qNeg y)) (qAdd y (qNeg x))
                    (idToEq Sign (sgnQ (qAdd z (qNeg y))) sPos h2p)
                    (idToEq Sign (sgnQ (qAdd y (qNeg x))) sPos h1p)))))
          l2)
      l1

def leQAntisym : (x : El Q) (y : El Q) →
  El (LeQ x y) → El (LeQ y x) → x ≡ y ∈ El Q ≔
  λx. λy. λl1. λl2.
    let fl : sgnQ (qAdd x (qNeg y)) ≡ sgnFlip (sgnQ (qAdd y (qNeg x))) ∈ El Sign ≔
      trans Sign (sgnQ (qAdd x (qNeg y))) (sgnQ (qNeg (qAdd y (qNeg x))))
            (sgnFlip (sgnQ (qAdd y (qNeg x))))
        (cong Q (λw. Sign) (λw. sgnQ w) (qAdd x (qNeg y))
           (qNeg (qAdd y (qNeg x))) (qSubNeg x y))
        (sgnQNegFlip (qAdd y (qNeg x))) in
    ⊎-elim (w. x ≡ y ∈ El Q)
      (h10.
        sym Q y x
          (qDiffZero y x
             (sgnQZeroView (qAdd y (qNeg x))
                (idToEq Sign (sgnQ (qAdd y (qNeg x))) sZero h10))))
      (h1p.
        let en : sgnQ (qAdd x (qNeg y)) ≡ sNeg ∈ El Sign ≔
          trans Sign (sgnQ (qAdd x (qNeg y)))
                (sgnFlip (sgnQ (qAdd y (qNeg x)))) sNeg
            fl
            (trans Sign (sgnFlip (sgnQ (qAdd y (qNeg x)))) (sgnFlip sPos) sNeg
               (cong Sign (λw. Sign) (λw. sgnFlip w) (sgnQ (qAdd y (qNeg x))) sPos
                  (idToEq Sign (sgnQ (qAdd y (qNeg x))) sPos h1p))
               ⋆) in
        ⊎-elim (w. x ≡ y ∈ El Q)
          (h20.
            𝟘-elim (sZeroNotNeg
              (trans Sign sZero (sgnQ (qAdd x (qNeg y))) sNeg
                 (sym Sign (sgnQ (qAdd x (qNeg y))) sZero
                    (idToEq Sign (sgnQ (qAdd x (qNeg y))) sZero h20))
                 en)))
          (h2p.
            𝟘-elim (sPosNotNeg
              (trans Sign sPos (sgnQ (qAdd x (qNeg y))) sNeg
                 (sym Sign (sgnQ (qAdd x (qNeg y))) sPos
                    (idToEq Sign (sgnQ (qAdd x (qNeg y))) sPos h2p))
                 en)))
          l2)
      l1

-- ===== compatibility with the operations =====

-- (y + w) − (x + w) ≡ y − x, hypothesis-free
def qSubPlusCancel : (x : El Q) (y : El Q) (w : El Q) →
  qAdd (qAdd y w) (qNeg (qAdd x w)) ≡ qAdd y (qNeg x) ∈ El Q ≔
  λx. λy. λw.
    (qAdd (qAdd y w) (qNeg (qAdd x w))
       ≡⟨ cong Q (λv. Q) (λv. qAdd (qAdd y w) v) (qNeg (qAdd x w))
            (qAdd (qNeg x) (qNeg w)) (qNegAdd x w) ⟩
     qAdd (qAdd y w) (qAdd (qNeg x) (qNeg w))
       ≡⟨ qPairSwap y w (qNeg x) (qNeg w) ⟩
     qAdd (qAdd y (qNeg x)) (qAdd w (qNeg w))
       ≡⟨ cong Q (λv. Q) (λv. qAdd (qAdd y (qNeg x)) v) (qAdd w (qNeg w)) qZero
            (qAddNegR w) ⟩
     qAdd (qAdd y (qNeg x)) qZero
       ≡⟨ qAddZeroR (qAdd y (qNeg x)) ⟩
     qAdd y (qNeg x))

-- monotonicity of + : one transport along the cancelled difference
def leQPlusMono : (x : El Q) (y : El Q) (w : El Q) →
  El (LeQ x y) → El (LeQ (qAdd x w) (qAdd y w)) ≔
  λx. λy. λw. λle.
    transport Sign NonNegS
      (sgnQ (qAdd y (qNeg x)))
      (sgnQ (qAdd (qAdd y w) (qNeg (qAdd x w))))
      (sym Sign (sgnQ (qAdd (qAdd y w) (qNeg (qAdd x w)))) (sgnQ (qAdd y (qNeg x)))
         (cong Q (λv. Sign) (λv. sgnQ v)
            (qAdd (qAdd y w) (qNeg (qAdd x w))) (qAdd y (qNeg x))
            (qSubPlusCancel x y w)))
      le

def leQPlusMonoL : (x : El Q) (y : El Q) (w : El Q) →
  El (LeQ x y) → El (LeQ (qAdd w x) (qAdd w y)) ≔
  λx. λy. λw. λle.
    transport Q (λv. LeQ v (qAdd w y)) (qAdd x w) (qAdd w x) (qAddComm x w)
      (transport Q (λv. LeQ (qAdd x w) v) (qAdd y w) (qAdd w y) (qAddComm y w)
         (leQPlusMono x y w le))

-- positive fractions multiply to a positive fraction: interchange
-- num·num · den·den into (num·den)·(num·den)
def ratMulPos : (p : El Rat) (q : El Rat) →
  (ratSgn p ≡ sPos ∈ El Sign) → (ratSgn q ≡ sPos ∈ El Sign) →
  ratSgn (ratMul p q) ≡ sPos ∈ El Sign ≔
  λp. λq. λhp. λhq.
    trans Sign (ratSgn (ratMul p q))
          (intSgn (intMul (intMul (num p) (denInt p)) (intMul (num q) (denInt q))))
          sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intMul (intMul (num p) (num q)) (nzToInt (nzMul (den p) (den q))))
         (intMul (intMul (num p) (denInt p)) (intMul (num q) (denInt q)))
         ((intMul (intMul (num p) (num q)) (nzToInt (nzMul (den p) (den q)))
             ≡⟨ cong Int (λv. Int) (λv. intMul (intMul (num p) (num q)) v)
                  (nzToInt (nzMul (den p) (den q)))
                  (intMul (nzToInt (den p)) (nzToInt (den q)))
                  (nzToIntMul (den p) (den q)) ⟩
           intMul (intMul (num p) (num q)) (intMul (nzToInt (den p)) (nzToInt (den q)))
             ≡⟨ mulPairSwap (num p) (num q) (nzToInt (den p)) (nzToInt (den q)) ⟩
           intMul (intMul (num p) (nzToInt (den p)))
                  (intMul (num q) (nzToInt (den q))))))
      (intSgnPosMul (intMul (num p) (denInt p)) (intMul (num q) (denInt q)) hp hq)

def sgnQMulPos : (u : El Q) (v : El Q) →
  (sgnQ u ≡ sPos ∈ El Sign) → (sgnQ v ≡ sPos ∈ El Sign) →
  sgnQ (qMul u v) ≡ sPos ∈ El Sign ≔
  λu. λv.
    (quot-elim (w. (sgnQ w ≡ sPos ∈ El Sign) → (sgnQ v ≡ sPos ∈ El Sign) →
                   (sgnQ (qMul w v) ≡ sPos ∈ El Sign))
       (p. (quot-elim (w. (sgnQ (class p) ≡ sPos ∈ El Sign) →
                          (sgnQ w ≡ sPos ∈ El Sign) →
                          (sgnQ (qMul (class p) w) ≡ sPos ∈ El Sign))
              (q. λhp. λhq. ratMulPos p q hp hq)
              v))
       u)

-- (−x)·c ≡ −(x·c) on ℚ, by inverse uniqueness
def qNegMulL : (x : El Q) (c : El Q) →
  qMul (qNeg x) c ≡ qNeg (qMul x c) ∈ El Q ≔
  λx. λc.
    qNegUnique (qMul x c) (qMul (qNeg x) c)
      (trans Q (qAdd (qMul x c) (qMul (qNeg x) c))
             (qMul (qAdd x (qNeg x)) c) qZero
         (sym Q (qMul (qAdd x (qNeg x)) c)
              (qAdd (qMul x c) (qMul (qNeg x) c))
              (qDistribR c x (qNeg x)))
         (trans Q (qMul (qAdd x (qNeg x)) c) (qMul qZero c) qZero
            (cong Q (λv. Q) (λv. qMul v c) (qAdd x (qNeg x)) qZero (qAddNegR x))
            (qMulZeroL c)))

-- (y − x)·c ≡ y·c − x·c, hypothesis-free
def qSubDistribR : (x : El Q) (y : El Q) (c : El Q) →
  qMul (qAdd y (qNeg x)) c ≡ qAdd (qMul y c) (qNeg (qMul x c)) ∈ El Q ≔
  λx. λy. λc.
    (qMul (qAdd y (qNeg x)) c
       ≡⟨ qDistribR c y (qNeg x) ⟩
     qAdd (qMul y c) (qMul (qNeg x) c)
       ≡⟨ cong Q (λv. Q) (λv. qAdd (qMul y c) v) (qMul (qNeg x) c)
            (qNeg (qMul x c)) (qNegMulL x c) ⟩
     qAdd (qMul y c) (qNeg (qMul x c)))

-- monotonicity of · by a NONNEGATIVE scalar: case the scalar's sign —
-- a zero scalar collapses both sides, a positive one cases the
-- difference's own sign
def leQMulMono : (x : El Q) (y : El Q) (c : El Q) →
  El (LeQ x y) → El (LeQ qZero c) →
  El (LeQ (qMul x c) (qMul y c)) ≔
  λx. λy. λc. λle. λlc.
    let dEq : sgnQ (qAdd (qMul y c) (qNeg (qMul x c)))
                ≡ sgnQ (qMul (qAdd y (qNeg x)) c) ∈ El Sign ≔
      cong Q (λv. Sign) (λv. sgnQ v)
        (qAdd (qMul y c) (qNeg (qMul x c))) (qMul (qAdd y (qNeg x)) c)
        (sym Q (qMul (qAdd y (qNeg x)) c) (qAdd (qMul y c) (qNeg (qMul x c)))
           (qSubDistribR x y c)) in
    let cEq : sgnQ (qAdd c (qNeg qZero)) ≡ sgnQ c ∈ El Sign ≔
      cong Q (λv. Sign) (λv. sgnQ v) (qAdd c (qNeg qZero)) c
        (trans Q (qAdd c (qNeg qZero)) (qAdd c qZero) c
           (cong Q (λv. Q) (λv. qAdd c v) (qNeg qZero) qZero ⋆)
           (qAddZeroR c)) in
    ⊎-elim (w. El (LeQ (qMul x c) (qMul y c)))
      (hc0.
        -- c ≡ 0: both products are zero, difference too
        let c0 : c ≡ qZero ∈ El Q ≔
          sgnQZeroView c
            (trans Sign (sgnQ c) (sgnQ (qAdd c (qNeg qZero))) sZero
               (sym Sign (sgnQ (qAdd c (qNeg qZero))) (sgnQ c) cEq)
               (idToEq Sign (sgnQ (qAdd c (qNeg qZero))) sZero hc0)) in
        inj₁ (eqToId Sign (sgnQ (qAdd (qMul y c) (qNeg (qMul x c)))) sZero
          (trans Sign (sgnQ (qAdd (qMul y c) (qNeg (qMul x c))))
                 (sgnQ (qMul (qAdd y (qNeg x)) c)) sZero
             dEq
             (trans Sign (sgnQ (qMul (qAdd y (qNeg x)) c)) (sgnQ qZero) sZero
                (cong Q (λv. Sign) (λv. sgnQ v) (qMul (qAdd y (qNeg x)) c) qZero
                   (trans Q (qMul (qAdd y (qNeg x)) c) (qMul (qAdd y (qNeg x)) qZero) qZero
                      (cong Q (λv. Q) (λv. qMul (qAdd y (qNeg x)) v) c qZero c0)
                      (trans Q (qMul (qAdd y (qNeg x)) qZero) (qMul qZero (qAdd y (qNeg x))) qZero
                         (qMulComm (qAdd y (qNeg x)) qZero)
                         (qMulZeroL (qAdd y (qNeg x))))))
                sgnQZero))))
      (hcp.
        -- c positive: case the difference's sign
        let hcs : sgnQ c ≡ sPos ∈ El Sign ≔
          trans Sign (sgnQ c) (sgnQ (qAdd c (qNeg qZero))) sPos
            (sym Sign (sgnQ (qAdd c (qNeg qZero))) (sgnQ c) cEq)
            (idToEq Sign (sgnQ (qAdd c (qNeg qZero))) sPos hcp) in
        ⊎-elim (w. El (LeQ (qMul x c) (qMul y c)))
          (hd0.
            -- y − x ≡ 0: products differ by zero
            let d0 : qAdd y (qNeg x) ≡ qZero ∈ El Q ≔
              sgnQZeroView (qAdd y (qNeg x))
                (idToEq Sign (sgnQ (qAdd y (qNeg x))) sZero hd0) in
            inj₁ (eqToId Sign (sgnQ (qAdd (qMul y c) (qNeg (qMul x c)))) sZero
              (trans Sign (sgnQ (qAdd (qMul y c) (qNeg (qMul x c))))
                     (sgnQ (qMul (qAdd y (qNeg x)) c)) sZero
                 dEq
                 (trans Sign (sgnQ (qMul (qAdd y (qNeg x)) c)) (sgnQ qZero) sZero
                    (cong Q (λv. Sign) (λv. sgnQ v) (qMul (qAdd y (qNeg x)) c) qZero
                       (trans Q (qMul (qAdd y (qNeg x)) c) (qMul qZero c) qZero
                          (cong Q (λv. Q) (λv. qMul v c) (qAdd y (qNeg x)) qZero d0)
                          (qMulZeroL c)))
                    sgnQZero))))
          (hdp.
            inj₂ (eqToId Sign (sgnQ (qAdd (qMul y c) (qNeg (qMul x c)))) sPos
              (trans Sign (sgnQ (qAdd (qMul y c) (qNeg (qMul x c))))
                     (sgnQ (qMul (qAdd y (qNeg x)) c)) sPos
                 dEq
                 (sgnQMulPos (qAdd y (qNeg x)) c
                    (idToEq Sign (sgnQ (qAdd y (qNeg x))) sPos hdp)
                    hcs))))
          le)
      lc
