-- EVERY REGULAR SEQUENCE IS BOUNDED, by a natural computed from it:
--
--   |x_n|  ≤  |x_0| + |x_n − x_0|  ≤  ⌈|x_0|⌉ + 2
--
-- and ⌈|x_0|⌉ is ratCeil's qNatBound, a genuine function on ℚ. This is
-- what ℝ's product needs: the sampling depth for x·y is proportional
-- to a bound on both factors, so the bound has to be data computed
-- from the representative — and it is.
-- ===== 1/(k+1) ≤ 1, hence rBound n 0 ≤ 2 =====

import nat (+, *, plusZeroId, zeroPlusId)
import natOrder (≤, leZero, leSucMono)
import rational (oneMult)
import rationalQ (Q, +, qNeg, qZero, qAddComm, qAddAssoc, qAddNegR, qAddZeroL)
import rationalOrder (≤, leQRefl, leQTrans)
import ratBound (Bnd, bndAdd, bndEq, bndWeaken, leQAdd)
import ratNat (qOfNat, qOfNatAdd, leQOfNat)
import ratCeil (qNatBound, bndNatBound, leQFracOfNat)
import real (qInvNat, rBound, RSeq, Regular)
import realNeg (seqOf, regOf, regBnd)
import equality (trans, sym, cong, transport)

def leQInvOne : (k : ℕ) → El (qInvNat k ≤ qOfNat (S Z))
  using (id.Id.eq,
    intOrder.intOfNat.eq,
    integer.intOne.eq,
    ratNat.qOfNat.eq,
    rational.mkRat.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qcls.eq,
    real.qInvNat.eq) ≔
  λk. leQFracOfNat
    (transport _ (λw. S Z ≤ w) _ _ (sym _ _ _ (oneMult (S k))) (leSucMono (leZero k)))

def leQBoundTwo : (n : ℕ) → El (rBound n Z ≤ qOfNat 2)
  using (id.Id.eq,
    nat.+.eq,
    ratNat.qOfNat.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.qInvNat.eq,
    real.rBound.eq) ≔
  λn. transport
    _
    (λw. rBound n Z ≤ w)
    (qOfNat (S Z) + qOfNat (S Z))
    (qOfNat 2)
    (qOfNatAdd (S Z) (S Z))
    (leQAdd _ _ _ _ (leQInvOne n) (leQInvOne Z))

-- ===== a + (b − a) ≡ b =====
def qAddSubCancelL : (a b : El Q) → a + (b + qNeg a) ≡ b using (rationalQ.Q.unfold) ≔
  λa. λb. a + (b + qNeg a)
      ≡⟨ cong _ (λw. Q) (λw. a + w) _ _ (qAddComm b (qNeg a)) ⟩ a + (qNeg a + b)
      ≡⟨ sym _ _ _ (qAddAssoc a (qNeg a) b) ⟩ a + qNeg a + b
      ≡⟨ cong _ (λw. Q) (λw. w + b) _ _ (qAddNegR a) ⟩ qZero + b
      ≡⟨ qAddZeroL b ⟩ b

-- ===== the bound =====
def seqBound : El RSeq → ℕ ≔ λp. S (S (qNatBound (seqOf p Z)))

def bndSeqBound : (p : El RSeq) (n : ℕ) → El (Bnd (qOfNat (seqBound p)) (seqOf p n))
  using (nat.+.eq,
    ratBound.Bnd.unfold,
    ratCeil.qNatBound.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    realBound.seqBound.eq,
    realNeg.seqOf.eq) ≔
  λp. λn. bndWeaken
    _
    _
    _
    (transport
      _
      (λw. qOfNat (qNatBound (seqOf p Z)) + rBound n Z ≤ w)
      (qOfNat (qNatBound (seqOf p Z)) + qOfNat 2)
      (qOfNat (seqBound p))
      (qOfNatAdd (qNatBound (seqOf p Z)) 2)
      (leQAdd _ _ _ _ (leQRefl (qOfNat (qNatBound (seqOf p Z)))) (leQBoundTwo n)))
    (bndEq
      _
      _
      (qAddSubCancelL (seqOf p Z) (seqOf p n))
      (bndAdd (bndNatBound (seqOf p Z)) (regBnd _ (regOf p) n Z)))

-- the bound is a successor, and in fact at least 2 — which is what
-- lets the product's sampling index be written without a predecessor
def seqBoundPos : {p : El RSeq} → El (qZero ≤ qOfNat (seqBound p))
  using (ratNat.qOfNatZero,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold,
    real.RSeq.unfold,
    real.Regular.unfold) ≔
  λp. transport _ (λw. w ≤ qOfNat (seqBound p)) (qOfNat Z) qZero ⋆ (leQOfNat (leZero (seqBound p)))
