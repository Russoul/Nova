import nat (+, *)
import eqNat (zNotS)
import equality (sym)
import rational (ratZero, ratOne)
import rationalQ (Q, qAdd, qMul, qNeg, qZero, qOne,
                  qAddAssoc, qAddComm, qAddZeroL, qAddZeroR, qAddNegL, qAddNegR,
                  qMulAssoc, qMulComm, qMulOneL, qMulOneR, qDistribL, qDistribR)
import rationalInv (notIntro)
import rationalAlgInv (qInv, qMulInvR)
import intEffective (intEffective)
import rationalEffective (qEffective)
import id (Id, idToEq, eqToId)
import monoid (IsMonoid)
import group (IsGroup)
import field (IsField)

-- (ℚ, +, -, 0) is a group and (ℚ, *, 1) a monoid — the two layers of
-- the field structure, each law an existing rationalQ lemma across
-- the Id bridge.
def ratAddGroup : El (IsGroup Q) ≔
  ((qAdd , qZero ,
    λx. λy. λz. eqToId Q (qAdd (qAdd x y) z) (qAdd x (qAdd y z)) (qAddAssoc x y z) ,
    λx. eqToId Q (qAdd qZero x) x (qAddZeroL x) ,
    λx. eqToId Q (qAdd x qZero) x (qAddZeroR x)) ,
   qNeg ,
   λx. eqToId Q (qAdd (qNeg x) x) qZero (qAddNegL x) ,
   λx. eqToId Q (qAdd x (qNeg x)) qZero (qAddNegR x))

def ratMulMonoid : El (IsMonoid Q) ≔
  (qMul , qOne ,
   λx. λy. λz. eqToId Q (qMul (qMul x y) z) (qMul x (qMul y z)) (qMulAssoc x y z) ,
   λx. eqToId Q (qMul qOne x) x (qMulOneL x) ,
   λx. eqToId Q (qMul x qOne) x (qMulOneR x))

-- Nontriviality at the DATA level: an element of 𝟘 from Id Q 1 0.
-- Prf ⊥ could never produce one — the route is the effectivity chain
-- down to ℕ, where a 𝕌-valued discriminator exists: reflect the Id to
-- a class equation, qEffective turns it into the cross-multiplied Int
-- relation (which δβ-computes to class (S Z , Z) ≡ class (Z , Z)),
-- intEffective turns THAT into its ℕ relation (which computes to
-- S Z ≡ Z), and zNotS transports () across it into 𝟘.
def qOneNotZeroD : El (Id Q qOne qZero) → 𝟘 ≔
  λp.
    let h ≔ idToEq Q qOne qZero p in
    let r ≔ qEffective ratOne ratZero h in
    let e ≔ intEffective (S Z , Z) (Z , Z) r in
    zNotS Z (sym ℕ (S Z) Z e)

-- ℚ is a field. The inverse component is UNSQUASHED: qInv is an
-- honest operation (rationalAlgInv), so the witness is (qInv x, law).
-- Its nonzero hypothesis arrives as an Id-refutation k; the Ω-side
-- negation qMulInvR needs is one bridge away — an Ω-equality would
-- give an Id (eqToId), k would give 𝟘, and ⋆ witnesses ⊥ from it.
def ratField : El (IsField Q) ≔
  (ratAddGroup , ratMulMonoid ,
   λx. λy. eqToId Q (qAdd x y) (qAdd y x) (qAddComm x y) ,
   λx. λy. eqToId Q (qMul x y) (qMul y x) (qMulComm x y) ,
   λx. λy. λz. eqToId Q (qMul x (qAdd y z)) (qAdd (qMul x y) (qMul x z))
                 (qDistribL x y z) ,
   λx. λy. λz. eqToId Q (qMul (qAdd y z) x) (qAdd (qMul y x) (qMul z x))
                 (qDistribR x y z) ,
   qOneNotZeroD ,
   λx. λk. (qInv x ,
            eqToId Q (qMul x (qInv x)) qOne
              (qMulInvR x (notIntro (x ≡ qZero ∈ El Q)
                            (λe. ⋆ (k (eqToId Q x qZero e)))))))
