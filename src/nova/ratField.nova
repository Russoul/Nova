-- (ℚ, +, -, 0) is a group and (ℚ, *, 1) a monoid — the two layers of
-- the field structure, each law an existing rationalQ lemma across
-- the Id bridge.

import nat (+, *)
import eqNat (zNotS)
import equality (sym)
import rational (ratZero, ratOne)
import rationalQ (Q, +, *, qNeg, qZero, qOne, qAddAssoc, qAddComm, qAddZeroL, qAddZeroR, qAddNegL, qAddNegR, qMulAssoc, qMulComm, qMulOneL, qMulOneR, qDistribL, qDistribR)
import rationalInv (notIntro)
import rationalAlgInv (qInv, qMulInvR)
import intEffective (intEffective)
import rationalEffective (qEffective)
import id (Id, idToEq, eqToId)
import monoid (IsMonoid)
import group (IsGroup)
import field (IsField)

def ratAddGroup : IsGroup Q using (group.IsGroup.unfold, monoid.IsMonoid.unfold) ≔
  ((+),
    qZero,
      (λx. λy. λz. eqToId
        _
        _
        (qAddAssoc
          x
          y
          z)),
        (λx. eqToId
          _
          _
          (qAddZeroL
            x)),
          λx. eqToId
            _
            _
            (qAddZeroR x)), qNeg, (λx. eqToId _ _ (qAddNegL x)), λx. eqToId _ _ (qAddNegR x)

def ratMulMonoid : IsMonoid Q using (monoid.IsMonoid.unfold) ≔
  (*),
    qOne,
      (λx. λy. λz. eqToId
        _
        _
        (qMulAssoc x y z)), (λx. eqToId _ _ (qMulOneL x)), λx. eqToId _ _ (qMulOneR x)

-- Nontriviality at the DATA level: an element of 𝟘 from Id Q 1 0.
-- Prf ⊥ could never produce one — the route is the effectivity chain
-- down to ℕ, where a 𝕌-valued discriminator exists: reflect the Id to
-- a class equation, qEffective turns it into the cross-multiplied Int
-- relation (which δβ-computes to class (S Z , Z) ≡ class (Z , Z)),
-- intEffective turns THAT into its ℕ relation (which computes to
-- S Z ≡ Z), and zNotS transports () across it into 𝟘.
def qOneNotZeroD : Id _ qOne qZero → 𝟘
  using (id.Id.unfold,
    integer.Int.eq,
    integer.IntR.eq,
    integer.IntR.unfold,
    integer.intOne.eq,
    integer.intZero.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    nat.plusZeroId,
    nat.zeroPlusId,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rational.ratZero.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.qOne.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  λp. let h ≔ idToEq
    _
    _
    _
    p in let r ≔ qEffective ratOne ratZero h in let e ≔ intEffective r in zNotS (sym _ _ e)

-- ℚ is a field. The inverse component is UNSQUASHED: qInv is an
-- honest operation (rationalAlgInv), so the witness is (qInv x, law).
-- Its nonzero hypothesis arrives as an Id-refutation k; the Ω-side
-- negation qMulInvR needs is one bridge away — an Ω-equality would
-- give an Id (eqToId), k would give 𝟘, and ⋆ witnesses ⊥ from it.
def ratField : IsField Q
  using (field.IsField.unfold,
    id.Id.eq,
    prop.⊥.unfold,
    ratField.ratAddGroup.eq,
    ratField.ratMulMonoid.eq,
    rationalAlgInv.qInv.eq,
    rationalQ.Q.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.*.eq,
    rationalQ.qOne.eq,
    rationalQ.qZero.eq) ≔
  ratAddGroup,
    ratMulMonoid,
      (λx. λy. eqToId
        _
        _
        (qAddComm
          x
          y)),
        (λx. λy. eqToId
          _
          _
          (qMulComm
            x
            y)),
          (λx. λy. λz. eqToId
            _
            _
            (qDistribL
              x
              y
              z)),
            (λx. λy. λz. eqToId
              _
              _
              (qDistribR
                x
                y
                z)),
              qOneNotZeroD,
                λx. λk. qInv
                  x, eqToId _ _ (qMulInvR (notIntro (x ≡ qZero) (λe. ⋆ (k (eqToId _ qZero e)))))
