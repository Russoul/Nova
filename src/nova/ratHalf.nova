-- The HALVING law for the harmonic bounds: 1/(2n+2) + 1/(2n+2) is
-- 1/(n+1). This is the one arithmetic fact that makes addition on ℝ
-- possible — Bishop's regular sequences carry their modulus in the
-- type, so a sum has to be SAMPLED at doubled indices, and the
-- doubling is paid for exactly here.
--
-- `dbl n` is the index whose bound halves n's: qInvNat k denotes
-- 1/(k+1), so qInvNat (dbl n) is 1/(2n+2).
--
-- The proof never touches a difference-pair representative. Both
-- fractions are 1/·, so cross-multiplication reduces to a RING
-- identity in Int — ((g+g)+(g+g))·g ≡ (g+g)·(g+g), two
-- distributivities — once the denominators are pushed through
-- nzToInt.

import nat (+, *, sucPlus, plusSucId)
import integer (Int, intOne)
import integerAdd (+)
import integerMul (*, intMulOneL, intMulDistribL, intMulDistribR)
import intOrder (intOfNat, intOfNatPlus)
import rational (NZ, nzPos, nzMul, nzToInt, Rat, mkRat, num, den, ratAdd, intScale, intScaleToInt)
import rationalQ (Q, qcls, +, qZero, qAddCls, RatR, dInt, clsEqOfRel, nzToIntMul)
import rationalOrder (≤)
import ratBound (leQSelfAdd, leQZeroOfPos)
import real (qInvNat, qInvNatPos)
import equality (trans, sym, cong, transport)

def dbl : ℕ → ℕ ≔ λn. S (n + n)

-- ===== the Int identity behind it =====
-- 4g² two ways: distribute right, then collect left
def intDblSquare : (g : El Int) → (g + g + (g + g)) * g ≡ (g + g) * (g + g)
  using (integer.Int.unfold) ≔
  λg. (g + g + (g + g)) * g
      ≡⟨ intMulDistribR (g + g) (g + g) g ⟩ (g + g) * g + (g + g) * g
      ≡⟨ sym _ _ _ (intMulDistribL (g + g) g g) ⟩ (g + g) * (g + g)

-- ===== pushing the doubled index through nzToInt =====
def nzPosInt : (k : ℕ) → nzToInt (nzPos k) ≡ intOfNat (S k)
  using (intOrder.intOfNat.eq, integer.Int.unfold, rational.nzPos.eq, rational.nzToInt.eq) ≔
  λk. ⋆

-- S (dbl n) is 2·(n+1) — one successor moved across a sum
def sucDbl : (n : ℕ) → S (dbl n) ≡ S n + S n using (sucPlus.rw, plusSucId.rw, ratHalf.dbl.eq) ≔
  λn. ⋆

-- the doubled denominator IS the original one, doubled in Int
def nzPosDbl : (n : ℕ) → nzToInt (nzPos (dbl n)) ≡ nzToInt (nzPos n) + nzToInt (nzPos n)
  using (integer.Int.unfold) ≔
  λn. nzToInt (nzPos (dbl n))
      ≡⟨ nzPosInt (dbl n) ⟩ intOfNat (S (dbl n))
      ≡⟨ cong _ (λw. Int) (λw. intOfNat w) _ _ (sucDbl n) ⟩ intOfNat (S n + S n)
      ≡⟨ sym _ _ _ (intOfNatPlus (S n) (S n)) ⟩ intOfNat (S n) + intOfNat (S n)
      ≡⟨ sym
        _
        _
        (intOfNat (S n) + intOfNat (S n))
        (cong _ (λw. Int) (λw. w + w) _ _ (nzPosInt n)) ⟩ nzToInt (nzPos n) + nzToInt (nzPos n)

-- ===== the cross-multiplication =====
-- the unit fraction at index k, as a raw fraction
def unitRat : ℕ → El Rat using (rational.Rat.unfold) ≔ λk. mkRat intOne (nzPos k)

-- scaling 1 by d is just d
def scaleOne : {d : El NZ} → intScale d intOne ≡ nzToInt d
  using (integer.intOne.eq, rational.NZ.unfold) ≔
  λd. intScaleToInt

-- the numerator of 1/d + 1/d is d + d
def unitAddNum : {d : El NZ}
  → num (ratAdd (mkRat intOne d) (mkRat intOne d)) ≡ nzToInt d + nzToInt d
  using (integer.intNeg.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    rational.NZ.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.ratAdd.eq) ≔
  λd. cong Int (λw. Int) (λw. w + w) (intScale d intOne) (nzToInt d) scaleOne

-- ...and its denominator is d·d
def unitAddDen : {d : El NZ}
  → dInt (ratAdd (mkRat intOne d) (mkRat intOne d)) ≡ nzToInt d * nzToInt d
  using (integer.intOne.eq,
    integerAdd.+.eq,
    rational.NZ.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalQ.dInt.eq) ≔
  λd. nzToIntMul d d

-- the unit fraction's numerator and denominator, computed
def unitNum : (k : ℕ) → num (unitRat k) ≡ intOne
  using (integer.Int.unfold, ratHalf.unitRat.eq, rational.mkRat.eq, rational.num.eq) ≔
  λk. ⋆

def unitDen : (k : ℕ) → dInt (unitRat k) ≡ nzToInt (nzPos k)
  using (integer.Int.unfold,
    ratHalf.unitRat.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rationalQ.dInt.eq) ≔
  λk. ⋆

-- unitAddNum/unitAddDen, respelled at unitRat
def unitAddNumU : (k : ℕ)
  → num (ratAdd (unitRat k) (unitRat k)) ≡ nzToInt (nzPos k) + nzToInt (nzPos k)
  using (ratHalf.unitRat.eq) ≔
  λk. unitAddNum

def unitAddDenU : (k : ℕ)
  → dInt (ratAdd (unitRat k) (unitRat k)) ≡ nzToInt (nzPos k) * nzToInt (nzPos k)
  using (ratHalf.unitRat.eq) ≔
  λk. unitAddDen

-- the cross-multiplication itself, as one chain in folded vocabulary
def halfCross : {n : ℕ}
  → num
    (ratAdd
      (unitRat (dbl n))
      (unitRat
        (dbl
          n)))
    * dInt (unitRat n) ≡ num (unitRat n) * dInt (ratAdd (unitRat (dbl n)) (unitRat (dbl n)))
  using (integer.Int.unfold) ≔
  λn. num (ratAdd (unitRat (dbl n)) (unitRat (dbl n))) * dInt (unitRat n)
      ≡⟨ cong
        _
        (λw. Int)
        (λw. num (ratAdd (unitRat (dbl n)) (unitRat (dbl n))) * w)
        _
        _
        (unitDen n) ⟩ num (ratAdd (unitRat (dbl n)) (unitRat (dbl n))) * nzToInt (nzPos n)
      ≡⟨ cong
        _
        (λw. Int)
        (λw. w * nzToInt (nzPos n))
        _
        _
        (unitAddNumU
          (dbl n)) ⟩ (nzToInt (nzPos (dbl n)) + nzToInt (nzPos (dbl n))) * nzToInt (nzPos n)
      ≡⟨ cong
        _
        (λw. Int)
        (λw. (w + w) * nzToInt (nzPos n))
        _
        _
        (nzPosDbl
          n) ⟩ (nzToInt
        (nzPos n) + nzToInt (nzPos n) + (nzToInt (nzPos n) + nzToInt (nzPos n))) * nzToInt (nzPos n)
      ≡⟨ intDblSquare
        (nzToInt
          (nzPos
            n)) ⟩ (nzToInt (nzPos n) + nzToInt (nzPos n)) * (nzToInt (nzPos n) + nzToInt (nzPos n))
      ≡⟨ sym
        _
        _
        ((nzToInt (nzPos n) + nzToInt (nzPos n)) * (nzToInt (nzPos n) + nzToInt (nzPos n)))
        (cong
          _
          (λw. Int)
          (λw. w * w)
          _
          _
          (nzPosDbl n)) ⟩ nzToInt (nzPos (dbl n)) * nzToInt (nzPos (dbl n))
      ≡⟨ sym _ _ _ (unitAddDenU (dbl n)) ⟩ dInt (ratAdd (unitRat (dbl n)) (unitRat (dbl n)))
      ≡⟨ sym
        _
        _
        _
        (intMulOneL
          (dInt
            (ratAdd
              (unitRat (dbl n))
              (unitRat (dbl n))))) ⟩ intOne * dInt (ratAdd (unitRat (dbl n)) (unitRat (dbl n)))
      ≡⟨ cong
        _
        (λw. Int)
        (λw. w * dInt (ratAdd (unitRat (dbl n)) (unitRat (dbl n))))
        _
        _
        (unitNum n) ⟩ num (unitRat n) * dInt (ratAdd (unitRat (dbl n)) (unitRat (dbl n)))

-- 1/(2n+2) + 1/(2n+2) ~ 1/(n+1): the relation is halfCross, decoded
def halfRel : (n : ℕ) → Prf (RatR (ratAdd (unitRat (dbl n)) (unitRat (dbl n))) (unitRat n))
  using (rationalQ.RatR.eq, rationalQ.RatR.unfold) ≔
  λn. halfCross

-- ===== the halving law =====
def qInvHalf : (n : ℕ) → qInvNat (dbl n) + qInvNat (dbl n) ≡ qInvNat n
  using (integer.intOne.eq,
    ratHalf.dbl.eq,
    ratHalf.unitRat.eq,
    rational.mkRat.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rationalQ.+.eq,
    rationalQ.qcls.eq,
    real.qInvNat.eq) ≔
  λn. trans
    _
    _
    (qcls (ratAdd (unitRat (dbl n)) (unitRat (dbl n))))
    _
    (qAddCls (unitRat (dbl n)) (unitRat (dbl n)))
    (clsEqOfRel _ _ (halfRel n))

-- ===== the halved bound, as an inequality =====
def leQZeroInvNat : (n : ℕ) → El (qZero ≤ qInvNat n)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λn. leQZeroOfPos _ (qInvNatPos n)

-- 1/(2n+2) ≤ 1/(n+1): the halved bound is at most the original,
-- because the other half is nonnegative
def leQInvDbl : (n : ℕ) → El (qInvNat (dbl n) ≤ qInvNat n)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λn. transport
    _
    (λw. qInvNat (dbl n) ≤ w)
    _
    _
    (qInvHalf n)
    (leQSelfAdd (qInvNat (dbl n)) (leQZeroInvNat (dbl n)))
