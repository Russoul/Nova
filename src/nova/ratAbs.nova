-- ABSOLUTE VALUE on ℚ. The order is decidable (`sgnCases`), so this is
-- an honest function, not a squashed existence claim — and because
-- `sgnQ` is already a function on the QUOTIENT, no well-definedness
-- obligation arises anywhere below.
--
-- The organising fact is that |u| is the LEAST two-sided bound of u:
--
--   bndAbs      :  Bnd (qAbs u) u          -- it IS a bound
--   absLeOfBnd  :  Bnd b u → qAbs u ≤ b    -- and the least one
--
-- Every other law — involutivity under negation, the triangle
-- inequality, the reverse triangle inequality — follows from those two
-- by antisymmetry, with no further case analysis. This is the payoff
-- of ratBound.nova's decision to make two-sided bounds primitive
-- (D-7): |·| is defined in terms of Bnd rather than the other way
-- round.

import rationalQ (Q, +, *, qNeg, qZero, qAddComm, qAddAssoc, qAddZeroR, qAddNegR, qNegNeg, qMulComm, qMulZeroL)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, sgnQNegFlip, sgnCases, NonNegS, ≤, leQRefl, leQTrans, leQPlusMono, leQAntisym, qPlusNegCancelR, leQMulMono, qNegMulL)
import ratBound (Bnd, bndAdd, bndNeg, bndEq, bndZero, bndWeaken, bndOfBothLe, qNegZeroQ, leQZeroOfPos, leQZeroOfNonNeg, leQNegFlip)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

def qAbs : Q → Q using (rationalQ.Q.unfold) ≔ λu. ⊎-elim (nn. u) (hn. qNeg u) (sgnCases (sgnQ u))

-- ===== the two characterising facts =====
-- a negative sign flips to a positive one, so −u is nonnegative there
def sgnQNegOfNeg : {u : Q} → Id _ (sgnQ u) sNeg → sgnQ (qNeg u) ≡ sPos
  using (id.Id.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnFlip.eq,
    rationalQ.Q.unfold) ≔
  λu. λhn. trans
    _
    _
    _
    sgnQNegFlip
    (trans _ _ sPos (cong (λw. Sign) (λw. sgnFlip w) (idToEq _ _ _ hn)) ⋆)

def bndAbs : (u : Q) → Bnd (qAbs u) u
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratBound.Bnd.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. ⊎-elim (w. Bnd (⊎-elim (nn. u) (hn. qNeg u) w) u)
    (nn. leQTrans _ _ _ (bndZero _ (leQZeroOfNonNeg _ nn) .π₁) (leQZeroOfNonNeg _ nn), leQRefl _)
    (hn. transport
      (λw. w ≤ u)
      (sym _ _ (qNegNeg u))
      (leQRefl
        u),
      leQTrans
        _
        _
        _
        (transport (λw. w ≤ qZero) (qNegNeg u) (bndZero _ (leQZeroOfPos _ (sgnQNegOfNeg hn)) .π₁))
        (leQZeroOfPos _ (sgnQNegOfNeg hn)))
    (sgnCases (sgnQ u))

def absLeOfBnd : {b u : Q} → Bnd b u → qAbs u ≤ b
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratBound.Bnd.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λb. λu. λh. ⊎-elim (w. ⊎-elim (nn. u) (hn. qNeg u) w ≤ b)
    (nn. h .π₂)
    (hn. bndNeg _ _ h .π₂)
    (sgnCases (sgnQ u))

-- ...and the converse: a bound on |u| is a two-sided bound on u
def bndOfAbsLe : {b u : Q} → qAbs u ≤ b → Bnd b u using (ratBound.Bnd.unfold) ≔
  λb. λu. λle. bndWeaken _ _ _ le (bndAbs u)

-- ===== the laws =====
def leQZeroAbs : (u : Q) → qZero ≤ qAbs u
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq) ≔
  λu. ⊎-elim (w. qZero ≤ ⊎-elim (nn. u) (hn. qNeg u) w)
    (nn. leQZeroOfNonNeg _ nn)
    (hn. leQZeroOfPos _ (sgnQNegOfNeg hn))
    (sgnCases (sgnQ u))

def qAbsNeg : (u : Q) → qAbs (qNeg u) ≡ qAbs u ≔
  λu. leQAntisym
    (absLeOfBnd (bndNeg _ _ (bndAbs u)))
    (absLeOfBnd (bndEq _ _ (qNegNeg u) (bndNeg _ _ (bndAbs (qNeg u)))))

-- the triangle inequality is bndAdd, read through leastness
def qAbsTriangle : (u v : Q) → qAbs (u + v) ≤ qAbs u + qAbs v
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λv. absLeOfBnd (bndAdd (bndAbs u) (bndAbs v))

-- (a + b) − b ≡ a — the mirror of rationalOrder's qPlusNegCancelR
def qAddSubCancel : {a b : Q} → a + b + qNeg b ≡ a using (rationalQ.Q.unfold) ≔
  λa. λb. a + b + qNeg b
      ≡⟨ qAddAssoc a b (qNeg b) ⟩ a + (b + qNeg b)
      ≡⟨ cong (λw. Q) (λw. a + w) (qAddNegR b) ⟩ a + qZero
      ≡⟨ qAddZeroR a ⟩ a

-- a ≤ b + c gives a − c ≤ b
def leQSubOfLeAdd : {a b c : Q} → a ≤ b + c → a + qNeg c ≤ b
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λc. λle. transport
    (λw. a + qNeg c ≤ w)
    {b + c + qNeg c}
    {b}
    qAddSubCancel
    (leQPlusMono (qNeg c) le)

-- ===== the reverse triangle inequality =====
-- |u| − |v| ≤ |u − v| : split u as (u − v) + v and use leastness
def qAbsSubLe : (u v : Q) → qAbs u + qNeg (qAbs v) ≤ qAbs (u + qNeg v)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λv. leQSubOfLeAdd
    (transport
      (λw. qAbs w ≤ qAbs (u + qNeg v) + qAbs v)
      (qPlusNegCancelR u v)
      (qAbsTriangle (u + qNeg v) v))

-- ...so | |u| − |v| | ≤ |u − v|, and a bound on u − v bounds the
-- difference of the absolute values
def bndAbsSub : (b u v : Q) → Bnd b (u + qNeg v) → Bnd b (qAbs u + qNeg (qAbs v))
  using (ratBound.Bnd.unfold) ≔
  λb. λu. λv. λh. bndWeaken
    _
    _
    _
    (absLeOfBnd h)
    (bndOfBothLe
      _
      _
      (qAbsSubLe u v)
      (transport
        (λw. qAbs v + qNeg (qAbs u) ≤ w)
        (trans
          _
          _
          _
          (sym _ _ (qAbsNeg (v + qNeg u)))
          (cong (λw. Q) (λw. qAbs w) (ratBound.qSubFlip v u)))
        (qAbsSubLe v u)))

-- ===== a nonnegative rational is its own absolute value =====
def bndSelfOfNonNeg : {u : Q} → qZero ≤ u → Bnd u u using (ratBound.Bnd.unfold) ≔
  λu. λnn. leQTrans _ _ _ (bndZero _ nn .π₁) nn, leQRefl _

def qAbsOfNonNeg : {u : Q} → qZero ≤ u → qAbs u ≡ u using (ratBound.Bnd.unfold) ≔
  λu. λnn. leQAntisym (absLeOfBnd (bndSelfOfNonNeg nn)) (bndAbs u .π₂)

def qAbsAbs : (u : Q) → qAbs (qAbs u) ≡ qAbs u ≔ λu. qAbsOfNonNeg (leQZeroAbs u)

def qAbsZero : qAbs qZero ≡ qZero ≔ qAbsOfNonNeg (leQRefl qZero)

-- ===== |·| is multiplicative =====
--
-- |u| is characterised by being nonnegative and being ±u, so it is
-- enough to show that |u|·|v| is nonnegative and is ±(u·v) — the sign
-- case analysis then happens once, on the two factors, and never on
-- the product.
def qAbsEqOfNonNeg : {z : Q} (w : Q) → qZero ≤ w → (w ≡ z) → qAbs z ≡ w ≔
  λz. λw. λnn. λe. trans _ _ _ (cong (λt. Q) (λt. qAbs t) (sym _ _ e)) (qAbsOfNonNeg nn)

def qAbsEqOfNonNegNeg : {z : Q} (w : Q) → qZero ≤ w → (w ≡ qNeg z) → qAbs z ≡ w ≔
  λz. λw. λnn. λe. trans _ _ _ (sym _ _ (qAbsNeg z)) (qAbsEqOfNonNeg _ nn e)

def leQZeroMul : {a b : Q} → qZero ≤ a → qZero ≤ b → qZero ≤ a * b
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λha. λhb. transport (λw. w ≤ a * b) {qZero * b} {qZero} qMulZeroL (leQMulMono _ _ ha hb)

def qNegMulR : (x c : Q) → x * qNeg c ≡ qNeg (x * c) ≔
  λx. λc. trans
    _
    _
    _
    (trans _ _ _ (qMulComm x (qNeg c)) (qNegMulL c x))
    (cong (λw. Q) (λw. qNeg w) (qMulComm c x))

def qAbsMul : (u v : Q) → qAbs (u * v) ≡ qAbs u * qAbs v
  using (id.Id.unfold,
    ratAbs.qAbs.eq,
    rationalOrder.NonNegS.unfold,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.*.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. ⊎-elim (w. qAbs (u * v) ≡ ⊎-elim (nn. u) (hn. qNeg u) w * qAbs v)
    (nu. ⊎-elim (w. qAbs (u * v) ≡ u * ⊎-elim (nn. v) (hn. qNeg v) w)
      (nv. qAbsEqOfNonNeg _ (leQZeroMul (leQZeroOfNonNeg _ nu) (leQZeroOfNonNeg _ nv)) ⋆)
      (hv. qAbsEqOfNonNegNeg
        _
        (leQZeroMul (leQZeroOfNonNeg _ nu) (leQZeroOfPos _ (sgnQNegOfNeg hv)))
        (qNegMulR u v))
      (sgnCases (sgnQ v)))
    (hu. ⊎-elim (w. qAbs (u * v) ≡ qNeg u * ⊎-elim (nn. v) (hn. qNeg v) w)
      (nv. qAbsEqOfNonNegNeg
        _
        (leQZeroMul (leQZeroOfPos _ (sgnQNegOfNeg hu)) (leQZeroOfNonNeg _ nv))
        (qNegMulL u v))
      (hv. qAbsEqOfNonNeg
        _
        (leQZeroMul (leQZeroOfPos _ (sgnQNegOfNeg hu)) (leQZeroOfPos _ (sgnQNegOfNeg hv)))
        (trans
          _
          _
          _
          (trans _ _ _ (qNegMulL u (qNeg v)) (cong (λw. Q) (λw. qNeg w) (qNegMulR u v)))
          (qNegNeg (u * v))))
      (sgnCases (sgnQ v)))
    (sgnCases (sgnQ u))

-- ===== the product of two bounds =====
def bndMul : {a b u v : Q} → qZero ≤ a → qZero ≤ b → Bnd a u → Bnd b v → Bnd (a * b) (u * v)
  using (ratBound.Bnd.unfold) ≔
  λa. λb. λu. λv. λha. λhb. λhu. λhv. bndOfAbsLe
    (transport
      (λw. w ≤ a * b)
      (sym _ _ (qAbsMul u v))
      (leQTrans
        _
        _
        _
        (leQMulMono _ _ (absLeOfBnd hu) (leQZeroAbs v))
        (transport
          (λw. w ≤ a * b)
          (qMulComm (qAbs v) a)
          (transport (λw. qAbs v * a ≤ w) (qMulComm b a) (leQMulMono _ _ (absLeOfBnd hv) ha)))))
