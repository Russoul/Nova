-- ABSOLUTE VALUE on ℚ. The order is decidable (`sgnCases`), so this is
-- an honest function, not a squashed existence claim — and because
-- `sgnQ` is already a function on the QUOTIENT, no well-definedness
-- obligation arises anywhere below.
--
-- The organising fact is that |u| is the LEAST two-sided bound of u:
--
--   bndAbs      :  Bnd (qAbs u) u          -- it IS a bound
--   absLeOfBnd  :  Bnd b u → qAbs u ≤ b    -- and the least one
--
-- Every other law — involutivity under negation, the triangle
-- inequality, the reverse triangle inequality — follows from those two
-- by antisymmetry, with no further case analysis. This is the payoff
-- of ratBound.nova's decision to make two-sided bounds primitive
-- (D-7): |·| is defined in terms of Bnd rather than the other way
-- round.

import rationalQ (Q, +, *, qNeg, qZero, qAddComm, qAddAssoc, qAddZeroR, qAddNegR, qNegNeg, qMulComm, qMulZeroL)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, sgnQNegFlip, sgnCases, NonNegS, ≤, leQRefl, leQTrans, leQPlusMono, leQAntisym, qPlusNegCancelR, leQMulMono, qNegMulL)
import ratBound (Bnd, bndAdd, bndNeg, bndEq, bndZero, bndWeaken, bndOfBothLe, qNegZeroQ, leQZeroOfPos, leQZeroOfNonNeg, leQNegFlip)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

def qAbs : El Q → El Q using (rationalQ.Q.unfold) ≔
  λu. ⊎-elim (nn. u) (hn. qNeg u) (sgnCases (sgnQ u))

-- ===== the two characterising facts =====
-- a negative sign flips to a positive one, so −u is nonnegative there
def sgnQNegOfNeg : {u : El Q} → El (Id Sign (sgnQ u) sNeg) → sgnQ (qNeg u) ≡ sPos
  using (id.Id.unfold,
    rationalOrder.Sign.unfold,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sgnFlip.eq,
    rationalQ.Q.unfold) ≔
  λu. λhn. trans
    Sign
    (sgnQ (qNeg u))
    (sgnFlip (sgnQ u))
    sPos
    sgnQNegFlip
    (trans
      Sign
      (sgnFlip (sgnQ u))
      (sgnFlip sNeg)
      sPos
      (cong Sign (λw. Sign) (λw. sgnFlip w) (sgnQ u) sNeg (idToEq Sign (sgnQ u) sNeg hn))
      ⋆)

def bndAbs : (u : El Q) → El (Bnd (qAbs u) u)
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratBound.Bnd.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. ⊎-elim (w. El (Bnd (⊎-elim (nn. u) (hn. qNeg u) w) u))
    (nn. leQTrans
      (qNeg u)
      qZero
      u
      (bndZero u (leQZeroOfNonNeg u nn) .π₁)
      (leQZeroOfNonNeg u nn), leQRefl u)
    (hn. transport
      Q
      (λw. w ≤ u)
      u
      (qNeg (qNeg u))
      (sym Q (qNeg (qNeg u)) u (qNegNeg u))
      (leQRefl
        u),
      leQTrans
        u
        qZero
        (qNeg u)
        (transport
          Q
          (λw. w ≤ qZero)
          (qNeg (qNeg u))
          u
          (qNegNeg u)
          (bndZero (qNeg u) (leQZeroOfPos (qNeg u) (sgnQNegOfNeg hn)) .π₁))
        (leQZeroOfPos (qNeg u) (sgnQNegOfNeg hn)))
    (sgnCases (sgnQ u))

def absLeOfBnd : {b u : El Q} → El (Bnd b u) → El (qAbs u ≤ b)
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratBound.Bnd.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λb. λu. λh. ⊎-elim (w. El (⊎-elim (nn. u) (hn. qNeg u) w ≤ b))
    (nn. h .π₂)
    (hn. bndNeg b u h .π₂)
    (sgnCases (sgnQ u))

-- ...and the converse: a bound on |u| is a two-sided bound on u
def bndOfAbsLe : {b u : El Q} → El (qAbs u ≤ b) → El (Bnd b u) using (ratBound.Bnd.unfold) ≔
  λb. λu. λle. bndWeaken (qAbs u) b u le (bndAbs u)

-- ===== the laws =====
def leQZeroAbs : (u : El Q) → El (qZero ≤ qAbs u)
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq) ≔
  λu. ⊎-elim (w. El (qZero ≤ ⊎-elim (nn. u) (hn. qNeg u) w))
    (nn. leQZeroOfNonNeg u nn)
    (hn. leQZeroOfPos (qNeg u) (sgnQNegOfNeg hn))
    (sgnCases (sgnQ u))

def qAbsNeg : (u : El Q) → qAbs (qNeg u) ≡ qAbs u ≔
  λu. leQAntisym
    (absLeOfBnd (bndNeg (qAbs u) u (bndAbs u)))
    (absLeOfBnd
      (bndEq (qNeg (qNeg u)) u (qNegNeg u) (bndNeg (qAbs (qNeg u)) (qNeg u) (bndAbs (qNeg u)))))

-- the triangle inequality is bndAdd, read through leastness
def qAbsTriangle : (u v : El Q) → El (qAbs (u + v) ≤ qAbs u + qAbs v)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λv. absLeOfBnd (bndAdd (bndAbs u) (bndAbs v))

-- (a + b) − b ≡ a — the mirror of rationalOrder's qPlusNegCancelR
def qAddSubCancel : {a b : El Q} → a + b + qNeg b ≡ a using (rationalQ.Q.unfold) ≔
  λa. λb. a + b + qNeg b
      ≡⟨ qAddAssoc a b (qNeg b) ⟩ a + (b + qNeg b)
      ≡⟨ cong Q (λw. Q) (λw. a + w) (b + qNeg b) qZero (qAddNegR b) ⟩ a + qZero
      ≡⟨ qAddZeroR a ⟩ a

-- a ≤ b + c gives a − c ≤ b
def leQSubOfLeAdd : {a b c : El Q} → El (a ≤ b + c) → El (a + qNeg c ≤ b)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λc. λle. transport
    Q
    (λw. a + qNeg c ≤ w)
    (b + c + qNeg c)
    b
    qAddSubCancel
    (leQPlusMono (qNeg c) le)

-- ===== the reverse triangle inequality =====
-- |u| − |v| ≤ |u − v| : split u as (u − v) + v and use leastness
def qAbsSubLe : (u v : El Q) → El (qAbs u + qNeg (qAbs v) ≤ qAbs (u + qNeg v))
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λv. leQSubOfLeAdd
    (transport
      Q
      (λw. qAbs w ≤ qAbs (u + qNeg v) + qAbs v)
      (u + qNeg v + v)
      u
      (qPlusNegCancelR u v)
      (qAbsTriangle (u + qNeg v) v))

-- ...so | |u| − |v| | ≤ |u − v|, and a bound on u − v bounds the
-- difference of the absolute values
def bndAbsSub : (b u v : El Q) → El (Bnd b (u + qNeg v)) → El (Bnd b (qAbs u + qNeg (qAbs v)))
  using (ratBound.Bnd.unfold) ≔
  λb. λu. λv. λh. bndWeaken
    (qAbs (u + qNeg v))
    b
    (qAbs u + qNeg (qAbs v))
    (absLeOfBnd h)
    (bndOfBothLe
      (qAbs u)
      (qAbs v)
      (qAbsSubLe u v)
      (transport
        Q
        (λw. qAbs v + qNeg (qAbs u) ≤ w)
        (qAbs (v + qNeg u))
        (qAbs (u + qNeg v))
        (trans
          Q
          (qAbs (v + qNeg u))
          (qAbs (qNeg (v + qNeg u)))
          (qAbs (u + qNeg v))
          (sym Q (qAbs (qNeg (v + qNeg u))) (qAbs (v + qNeg u)) (qAbsNeg (v + qNeg u)))
          (cong Q (λw. Q) (λw. qAbs w) (qNeg (v + qNeg u)) (u + qNeg v) (ratBound.qSubFlip v u)))
        (qAbsSubLe v u)))

-- ===== a nonnegative rational is its own absolute value =====
def bndSelfOfNonNeg : {u : El Q} → El (qZero ≤ u) → El (Bnd u u) using (ratBound.Bnd.unfold) ≔
  λu. λnn. leQTrans (qNeg u) qZero u (bndZero u nn .π₁) nn, leQRefl u

def qAbsOfNonNeg : {u : El Q} → El (qZero ≤ u) → qAbs u ≡ u using (ratBound.Bnd.unfold) ≔
  λu. λnn. leQAntisym (absLeOfBnd (bndSelfOfNonNeg nn)) (bndAbs u .π₂)

def qAbsAbs : (u : El Q) → qAbs (qAbs u) ≡ qAbs u ≔ λu. qAbsOfNonNeg (leQZeroAbs u)

def qAbsZero : qAbs qZero ≡ qZero ≔ qAbsOfNonNeg (leQRefl qZero)

-- ===== |·| is multiplicative =====
--
-- |u| is characterised by being nonnegative and being ±u, so it is
-- enough to show that |u|·|v| is nonnegative and is ±(u·v) — the sign
-- case analysis then happens once, on the two factors, and never on
-- the product.
def qAbsEqOfNonNeg : {z : El Q} (w : El Q) → El (qZero ≤ w) → (w ≡ z) → qAbs z ≡ w ≔
  λz. λw. λnn. λe. trans
    Q
    (qAbs z)
    (qAbs w)
    w
    (cong Q (λt. Q) (λt. qAbs t) z w (sym Q w z e))
    (qAbsOfNonNeg nn)

def qAbsEqOfNonNegNeg : {z : El Q} (w : El Q) → El (qZero ≤ w) → (w ≡ qNeg z) → qAbs z ≡ w ≔
  λz. λw. λnn. λe. trans
    Q
    (qAbs z)
    (qAbs (qNeg z))
    w
    (sym Q (qAbs (qNeg z)) (qAbs z) (qAbsNeg z))
    (qAbsEqOfNonNeg w nn e)

def leQZeroMul : {a b : El Q} → El (qZero ≤ a) → El (qZero ≤ b) → El (qZero ≤ a * b)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λha. λhb. transport
    Q
    (λw. w ≤ a * b)
    (qZero * b)
    qZero
    qMulZeroL
    (leQMulMono qZero a ha hb)

def qNegMulR : (x c : El Q) → x * qNeg c ≡ qNeg (x * c) ≔
  λx. λc. trans
    Q
    (x * qNeg c)
    (qNeg (c * x))
    (qNeg (x * c))
    (trans Q (x * qNeg c) (qNeg c * x) (qNeg (c * x)) (qMulComm x (qNeg c)) (qNegMulL c x))
    (cong Q (λw. Q) (λw. qNeg w) (c * x) (x * c) (qMulComm c x))

def qAbsMul : (u v : El Q) → qAbs (u * v) ≡ qAbs u * qAbs v
  using (id.Id.unfold,
    ratAbs.qAbs.eq,
    rationalOrder.NonNegS.unfold,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.*.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. ⊎-elim (w. qAbs (u * v) ≡ ⊎-elim (nn. u) (hn. qNeg u) w * qAbs v)
    (nu. ⊎-elim (w. qAbs (u * v) ≡ u * ⊎-elim (nn. v) (hn. qNeg v) w)
      (nv. qAbsEqOfNonNeg (u * v) (leQZeroMul (leQZeroOfNonNeg u nu) (leQZeroOfNonNeg v nv)) ⋆)
      (hv. qAbsEqOfNonNegNeg
        (u * qNeg v)
        (leQZeroMul (leQZeroOfNonNeg u nu) (leQZeroOfPos (qNeg v) (sgnQNegOfNeg hv)))
        (qNegMulR u v))
      (sgnCases (sgnQ v)))
    (hu. ⊎-elim (w. qAbs (u * v) ≡ qNeg u * ⊎-elim (nn. v) (hn. qNeg v) w)
      (nv. qAbsEqOfNonNegNeg
        (qNeg u * v)
        (leQZeroMul (leQZeroOfPos (qNeg u) (sgnQNegOfNeg hu)) (leQZeroOfNonNeg v nv))
        (qNegMulL u v))
      (hv. qAbsEqOfNonNeg
        (qNeg u * qNeg v)
        (leQZeroMul
          (leQZeroOfPos (qNeg u) (sgnQNegOfNeg hu))
          (leQZeroOfPos (qNeg v) (sgnQNegOfNeg hv)))
        (trans
          Q
          (qNeg u * qNeg v)
          (qNeg (qNeg (u * v)))
          (u * v)
          (trans
            Q
            (qNeg u * qNeg v)
            (qNeg (u * qNeg v))
            (qNeg (qNeg (u * v)))
            (qNegMulL u (qNeg v))
            (cong Q (λw. Q) (λw. qNeg w) (u * qNeg v) (qNeg (u * v)) (qNegMulR u v)))
          (qNegNeg (u * v))))
      (sgnCases (sgnQ v)))
    (sgnCases (sgnQ u))

-- ===== the product of two bounds =====
def bndMul : {a b u v : El Q}
  → El (qZero ≤ a) → El (qZero ≤ b) → El (Bnd a u) → El (Bnd b v) → El (Bnd (a * b) (u * v))
  using (ratBound.Bnd.unfold) ≔
  λa. λb. λu. λv. λha. λhb. λhu. λhv. bndOfAbsLe
    (transport
      Q
      (λw. w ≤ a * b)
      (qAbs u * qAbs v)
      (qAbs (u * v))
      (sym Q (qAbs (u * v)) (qAbs u * qAbs v) (qAbsMul u v))
      (leQTrans
        (qAbs u * qAbs v)
        (a * qAbs v)
        (a * b)
        (leQMulMono (qAbs u) a (absLeOfBnd hu) (leQZeroAbs v))
        (transport
          Q
          (λw. w ≤ a * b)
          (qAbs v * a)
          (a * qAbs v)
          (qMulComm (qAbs v) a)
          (transport
            Q
            (λw. qAbs v * a ≤ w)
            (b * a)
            (a * b)
            (qMulComm b a)
            (leQMulMono (qAbs v) b (absLeOfBnd hv) ha)))))
