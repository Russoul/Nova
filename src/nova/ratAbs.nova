import rationalQ (Q, qAdd, qMul, qNeg, qZero, qAddComm, qAddAssoc, qAddZeroR,
                  qAddNegR, qNegNeg, qMulComm, qMulZeroL)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, sgnQNegFlip, sgnCases,
                      NonNegS, LeQ, leQRefl, leQTrans, leQPlusMono, leQAntisym,
                      qPlusNegCancelR, leQMulMono, qNegMulL)
import ratBound (Bnd, bndAdd, bndNeg, bndEq, bndZero, bndWeaken, bndOfBothLe,
                 qNegZeroQ, leQZeroOfPos, leQZeroOfNonNeg, leQNegFlip)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

-- ABSOLUTE VALUE on ℚ. The order is decidable (`sgnCases`), so this is
-- an honest function, not a squashed existence claim — and because
-- `sgnQ` is already a function on the QUOTIENT, no well-definedness
-- obligation arises anywhere below.
--
-- The organising fact is that |u| is the LEAST two-sided bound of u:
--
--   bndAbs      :  Bnd (qAbs u) u          -- it IS a bound
--   absLeOfBnd  :  Bnd b u → qAbs u ≤ b    -- and the least one
--
-- Every other law — involutivity under negation, the triangle
-- inequality, the reverse triangle inequality — follows from those two
-- by antisymmetry, with no further case analysis. This is the payoff
-- of ratBound.nova's decision to make two-sided bounds primitive
-- (D-7): |·| is defined in terms of Bnd rather than the other way
-- round.

def qAbs : El Q → El Q ≔
  λu. ⊎-elim (w. El Q) (nn. u) (hn. qNeg u) (sgnCases (sgnQ u))

-- ===== the two characterising facts =====

-- a negative sign flips to a positive one, so −u is nonnegative there
def sgnQNegOfNeg : (u : El Q) →
  El (Id Sign (sgnQ u) sNeg) → sgnQ (qNeg u) ≡ sPos ∈ El Sign
  using (rationalOrder.sNeg.eq, rationalOrder.sPos.eq, rationalOrder.sgnFlip.eq) ≔
  λu. λhn.
    trans Sign (sgnQ (qNeg u)) (sgnFlip (sgnQ u)) sPos
      (sgnQNegFlip u)
      (trans Sign (sgnFlip (sgnQ u)) (sgnFlip sNeg) sPos
         (cong Sign (λw. Sign) (λw. sgnFlip w) (sgnQ u) sNeg
            (idToEq Sign (sgnQ u) sNeg hn))
         ⋆)

def bndAbs : (u : El Q) → El (Bnd (qAbs u) u) using (id.Id.eq, ratAbs.qAbs.eq, rationalOrder.Sign.eq, rationalOrder.sPos.eq, rationalOrder.sZero.eq, rationalOrder.sgnCases.eq, rationalOrder.sgnQ.eq, rationalQ.qAdd.eq, rationalQ.qNeg.eq) ≔
  λu.
    ⊎-elim (w. El (Bnd (⊎-elim (v. El Q) (nn. u) (hn. qNeg u) w) u))
      (nn.
        (leQTrans (qNeg u) qZero u
           ((bndZero u (leQZeroOfNonNeg u nn)) .π₁)
           (leQZeroOfNonNeg u nn) ,
         leQRefl u))
      (hn.
        (transport Q (λw. LeQ w u) u (qNeg (qNeg u))
           (sym Q (qNeg (qNeg u)) u (qNegNeg u)) (leQRefl u) ,
         leQTrans u qZero (qNeg u)
           (transport Q (λw. LeQ w qZero) (qNeg (qNeg u)) u (qNegNeg u)
              ((bndZero (qNeg u) (leQZeroOfPos (qNeg u) (sgnQNegOfNeg u hn))) .π₁))
           (leQZeroOfPos (qNeg u) (sgnQNegOfNeg u hn))))
      (sgnCases (sgnQ u))

def absLeOfBnd : (b : El Q) (u : El Q) →
  El (Bnd b u) → El (LeQ (qAbs u) b) using (id.Id.eq, ratAbs.qAbs.eq, rationalOrder.Sign.eq, rationalOrder.sPos.eq, rationalOrder.sZero.eq, rationalOrder.sgnCases.eq, rationalOrder.sgnQ.eq, rationalQ.qAdd.eq, rationalQ.qNeg.eq) ≔
  λb. λu. λh.
    ⊎-elim (w. El (LeQ (⊎-elim (v. El Q) (nn. u) (hn. qNeg u) w) b))
      (nn. h .π₂)
      (hn. (bndNeg b u h) .π₂)
      (sgnCases (sgnQ u))

-- ...and the converse: a bound on |u| is a two-sided bound on u
def bndOfAbsLe : (b : El Q) (u : El Q) →
  El (LeQ (qAbs u) b) → El (Bnd b u) ≔
  λb. λu. λle. bndWeaken (qAbs u) b u le (bndAbs u)

-- ===== the laws =====

def leQZeroAbs : (u : El Q) → El (LeQ qZero (qAbs u)) using (id.Id.eq, ratAbs.qAbs.eq, rationalOrder.Sign.eq, rationalOrder.sPos.eq, rationalOrder.sZero.eq, rationalOrder.sgnCases.eq, rationalOrder.sgnQ.eq, rationalQ.qAdd.eq, rationalQ.qNeg.eq, rationalQ.qZero.eq) ≔
  λu.
    ⊎-elim (w. El (LeQ qZero (⊎-elim (v. El Q) (nn. u) (hn. qNeg u) w)))
      (nn. leQZeroOfNonNeg u nn)
      (hn. leQZeroOfPos (qNeg u) (sgnQNegOfNeg u hn))
      (sgnCases (sgnQ u))

def qAbsNeg : (u : El Q) → qAbs (qNeg u) ≡ qAbs u ∈ El Q ≔
  λu.
    leQAntisym (qAbs (qNeg u)) (qAbs u)
      (absLeOfBnd (qAbs u) (qNeg u) (bndNeg (qAbs u) u (bndAbs u)))
      (absLeOfBnd (qAbs (qNeg u)) u
         (bndEq (qAbs (qNeg u)) (qNeg (qNeg u)) u (qNegNeg u)
            (bndNeg (qAbs (qNeg u)) (qNeg u) (bndAbs (qNeg u)))))

-- the triangle inequality is bndAdd, read through leastness
def qAbsTriangle : (u : El Q) (v : El Q) →
  El (LeQ (qAbs (qAdd u v)) (qAdd (qAbs u) (qAbs v))) ≔
  λu. λv.
    absLeOfBnd (qAdd (qAbs u) (qAbs v)) (qAdd u v)
      (bndAdd (qAbs u) (qAbs v) u v (bndAbs u) (bndAbs v))

-- (a + b) − b ≡ a — the mirror of rationalOrder's qPlusNegCancelR
def qAddSubCancel : (a : El Q) (b : El Q) →
  qAdd (qAdd a b) (qNeg b) ≡ a ∈ El Q ≔
  λa. λb.
    (qAdd (qAdd a b) (qNeg b)
       ≡⟨ qAddAssoc a b (qNeg b) ⟩
     qAdd a (qAdd b (qNeg b))
       ≡⟨ cong Q (λw. Q) (λw. qAdd a w) (qAdd b (qNeg b)) qZero (qAddNegR b) ⟩
     qAdd a qZero
       ≡⟨ qAddZeroR a ⟩
     a)

-- a ≤ b + c gives a − c ≤ b
def leQSubOfLeAdd : (a : El Q) (b : El Q) (c : El Q) →
  El (LeQ a (qAdd b c)) → El (LeQ (qAdd a (qNeg c)) b) ≔
  λa. λb. λc. λle.
    transport Q (λw. LeQ (qAdd a (qNeg c)) w)
      (qAdd (qAdd b c) (qNeg c)) b (qAddSubCancel b c)
      (leQPlusMono a (qAdd b c) (qNeg c) le)

-- ===== the reverse triangle inequality =====

-- |u| − |v| ≤ |u − v| : split u as (u − v) + v and use leastness
def qAbsSubLe : (u : El Q) (v : El Q) →
  El (LeQ (qAdd (qAbs u) (qNeg (qAbs v))) (qAbs (qAdd u (qNeg v)))) ≔
  λu. λv.
    leQSubOfLeAdd (qAbs u) (qAbs (qAdd u (qNeg v))) (qAbs v)
      (transport Q (λw. LeQ (qAbs w) (qAdd (qAbs (qAdd u (qNeg v))) (qAbs v)))
         (qAdd (qAdd u (qNeg v)) v) u (qPlusNegCancelR u v)
         (qAbsTriangle (qAdd u (qNeg v)) v))

-- ...so | |u| − |v| | ≤ |u − v|, and a bound on u − v bounds the
-- difference of the absolute values
def bndAbsSub : (b : El Q) (u : El Q) (v : El Q) →
  El (Bnd b (qAdd u (qNeg v))) →
  El (Bnd b (qAdd (qAbs u) (qNeg (qAbs v)))) ≔
  λb. λu. λv. λh.
    bndWeaken (qAbs (qAdd u (qNeg v))) b
      (qAdd (qAbs u) (qNeg (qAbs v)))
      (absLeOfBnd b (qAdd u (qNeg v)) h)
      (bndOfBothLe (qAbs (qAdd u (qNeg v))) (qAbs u) (qAbs v)
         (qAbsSubLe u v)
         (transport Q (λw. LeQ (qAdd (qAbs v) (qNeg (qAbs u))) w)
            (qAbs (qAdd v (qNeg u))) (qAbs (qAdd u (qNeg v)))
            (trans Q (qAbs (qAdd v (qNeg u))) (qAbs (qNeg (qAdd v (qNeg u))))
                   (qAbs (qAdd u (qNeg v)))
               (sym Q (qAbs (qNeg (qAdd v (qNeg u)))) (qAbs (qAdd v (qNeg u)))
                  (qAbsNeg (qAdd v (qNeg u))))
               (cong Q (λw. Q) (λw. qAbs w) (qNeg (qAdd v (qNeg u)))
                  (qAdd u (qNeg v)) (ratBound.qSubFlip v u)))
            (qAbsSubLe v u)))

-- ===== a nonnegative rational is its own absolute value =====

def bndSelfOfNonNeg : (u : El Q) → El (LeQ qZero u) → El (Bnd u u) ≔
  λu. λnn.
    (leQTrans (qNeg u) qZero u ((bndZero u nn) .π₁) nn , leQRefl u)

def qAbsOfNonNeg : (u : El Q) → El (LeQ qZero u) → qAbs u ≡ u ∈ El Q ≔
  λu. λnn.
    leQAntisym (qAbs u) u
      (absLeOfBnd u u (bndSelfOfNonNeg u nn))
      ((bndAbs u) .π₂)

def qAbsAbs : (u : El Q) → qAbs (qAbs u) ≡ qAbs u ∈ El Q ≔
  λu. qAbsOfNonNeg (qAbs u) (leQZeroAbs u)

def qAbsZero : qAbs qZero ≡ qZero ∈ El Q ≔ ⋆

-- ===== |·| is multiplicative =====
--
-- |u| is characterised by being nonnegative and being ±u, so it is
-- enough to show that |u|·|v| is nonnegative and is ±(u·v) — the sign
-- case analysis then happens once, on the two factors, and never on
-- the product.

def qAbsEqOfNonNeg : (z : El Q) (w : El Q) →
  El (LeQ qZero w) → (w ≡ z ∈ El Q) → qAbs z ≡ w ∈ El Q ≔
  λz. λw. λnn. λe.
    trans Q (qAbs z) (qAbs w) w
      (cong Q (λt. Q) (λt. qAbs t) z w (sym Q w z e))
      (qAbsOfNonNeg w nn)

def qAbsEqOfNonNegNeg : (z : El Q) (w : El Q) →
  El (LeQ qZero w) → (w ≡ qNeg z ∈ El Q) → qAbs z ≡ w ∈ El Q ≔
  λz. λw. λnn. λe.
    trans Q (qAbs z) (qAbs (qNeg z)) w
      (sym Q (qAbs (qNeg z)) (qAbs z) (qAbsNeg z))
      (qAbsEqOfNonNeg (qNeg z) w nn e)

def leQZeroMul : (a : El Q) (b : El Q) →
  El (LeQ qZero a) → El (LeQ qZero b) → El (LeQ qZero (qMul a b)) ≔
  λa. λb. λha. λhb.
    transport Q (λw. LeQ w (qMul a b)) (qMul qZero b) qZero (qMulZeroL b)
      (leQMulMono qZero a b ha hb)

def qNegMulR : (x : El Q) (c : El Q) →
  qMul x (qNeg c) ≡ qNeg (qMul x c) ∈ El Q ≔
  λx. λc.
    trans Q (qMul x (qNeg c)) (qNeg (qMul c x)) (qNeg (qMul x c))
      (trans Q (qMul x (qNeg c)) (qMul (qNeg c) x) (qNeg (qMul c x))
         (qMulComm x (qNeg c))
         (qNegMulL c x))
      (cong Q (λw. Q) (λw. qNeg w) (qMul c x) (qMul x c) (qMulComm c x))

def qAbsMul : (u : El Q) (v : El Q) →
  qAbs (qMul u v) ≡ qMul (qAbs u) (qAbs v) ∈ El Q using (ratAbs.qAbs.eq, rationalOrder.sgnCases.eq, rationalOrder.sgnQ.eq, rationalQ.qMul.eq, rationalQ.qNeg.eq) ≔
  λu. λv.
    ⊎-elim (w. qAbs (qMul u v)
                 ≡ qMul (⊎-elim (t. El Q) (nn. u) (hn. qNeg u) w) (qAbs v)
                 ∈ El Q)
      (nu.
        ⊎-elim (w. qAbs (qMul u v)
                     ≡ qMul u (⊎-elim (t. El Q) (nn. v) (hn. qNeg v) w) ∈ El Q)
          (nv. qAbsEqOfNonNeg (qMul u v) (qMul u v)
                 (leQZeroMul u v (leQZeroOfNonNeg u nu) (leQZeroOfNonNeg v nv))
                 ⋆)
          (hv. qAbsEqOfNonNegNeg (qMul u v) (qMul u (qNeg v))
                 (leQZeroMul u (qNeg v) (leQZeroOfNonNeg u nu)
                    (leQZeroOfPos (qNeg v) (sgnQNegOfNeg v hv)))
                 (qNegMulR u v))
          (sgnCases (sgnQ v)))
      (hu.
        ⊎-elim (w. qAbs (qMul u v)
                     ≡ qMul (qNeg u)
                            (⊎-elim (t. El Q) (nn. v) (hn. qNeg v) w) ∈ El Q)
          (nv. qAbsEqOfNonNegNeg (qMul u v) (qMul (qNeg u) v)
                 (leQZeroMul (qNeg u) v
                    (leQZeroOfPos (qNeg u) (sgnQNegOfNeg u hu))
                    (leQZeroOfNonNeg v nv))
                 (qNegMulL u v))
          (hv. qAbsEqOfNonNeg (qMul u v) (qMul (qNeg u) (qNeg v))
                 (leQZeroMul (qNeg u) (qNeg v)
                    (leQZeroOfPos (qNeg u) (sgnQNegOfNeg u hu))
                    (leQZeroOfPos (qNeg v) (sgnQNegOfNeg v hv)))
                 (trans Q (qMul (qNeg u) (qNeg v)) (qNeg (qNeg (qMul u v)))
                        (qMul u v)
                    (trans Q (qMul (qNeg u) (qNeg v)) (qNeg (qMul u (qNeg v)))
                           (qNeg (qNeg (qMul u v)))
                       (qNegMulL u (qNeg v))
                       (cong Q (λw. Q) (λw. qNeg w) (qMul u (qNeg v))
                          (qNeg (qMul u v)) (qNegMulR u v)))
                    (qNegNeg (qMul u v))))
          (sgnCases (sgnQ v)))
      (sgnCases (sgnQ u))

-- ===== the product of two bounds =====

def bndMul : (a : El Q) (b : El Q) (u : El Q) (v : El Q) →
  El (LeQ qZero a) → El (LeQ qZero b) →
  El (Bnd a u) → El (Bnd b v) → El (Bnd (qMul a b) (qMul u v)) ≔
  λa. λb. λu. λv. λha. λhb. λhu. λhv.
    bndOfAbsLe (qMul a b) (qMul u v)
      (transport Q (λw. LeQ w (qMul a b))
         (qMul (qAbs u) (qAbs v)) (qAbs (qMul u v))
         (sym Q (qAbs (qMul u v)) (qMul (qAbs u) (qAbs v)) (qAbsMul u v))
         (leQTrans (qMul (qAbs u) (qAbs v)) (qMul a (qAbs v)) (qMul a b)
            (leQMulMono (qAbs u) a (qAbs v)
               (absLeOfBnd a u hu) (leQZeroAbs v))
            (transport Q (λw. LeQ w (qMul a b))
               (qMul (qAbs v) a) (qMul a (qAbs v)) (qMulComm (qAbs v) a)
               (transport Q (λw. LeQ (qMul (qAbs v) a) w)
                  (qMul b a) (qMul a b) (qMulComm b a)
                  (leQMulMono (qAbs v) b a (absLeOfBnd b v hv) ha)))))
