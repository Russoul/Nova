-- intNonZero first, to fix the elaboration order of the transitive
-- imports (docs/ProvingFeedback.md B-8)
-- ℚ IS EFFECTIVE: equal classes give cross-multiplication back.
--
-- quotEffective.nova asks for one thing — that the relation be an
-- equivalence. For RatR only transitivity is real work, and it is the
-- usual argument: multiply through by the middle denominator and
-- CANCEL it. Cancellation in ℤ is where intNonZero.nova's
-- no-zero-divisors finally pays off a second time.
--
-- The corollary is the converse that was out of reach before: a
-- rational built from a non-zero numerator is not zero, so qOfNzq's
-- image is exactly the non-zero rationals.
-- ===== cancellation in ℤ =====

import intNonZero (nzOfInt, nzToIntNonZero, intNoZeroDiv)
import integer (Int, intZero, intOne, intNeg)
import integerAdd (+, intAddAssoc)
import integerMul (*, intMulComm, intMulAssoc, intMulOneR, intMulZeroL, intMulDistribR, intMulNegL, intAddNegL, intAddNegR, intAddCong2, intMulCong2)
import prop (¬, ⊥, ↔, iffIntro, absurdP)
import rational (NZ, nzToInt, nzOne, Rat, mkRat, num, den, ratZero, ratOne, intAddZeroL, intAddZeroR)
import rationalQ (Q, qcls, qZero, qOne, *, qMulZeroL, RatR, dInt, clsEqOfRel, mulCongL, mulCongR, NZQ, qOfNzq, nzqToRat, nzToIntMul)
import rationalInv (notIntro, notApply, numNonZero, ratZeroOfNumZero, qNonZeroIsNzq, qInvExists)
import quotEffective (effectiveAtEquiv)
import equality (trans, sym, cong)

def addCongL : {x y z : El Int} → (x ≡ y) → x + z ≡ y + z
  using (integer.Int.unfold, integerMul.intAddCong2) ≔
  λx. λy. λz. λh. ⋆

def addCongR : {x y z : El Int} → (y ≡ z) → x + y ≡ x + z
  using (integer.Int.unfold, integerMul.intAddCong2) ≔
  λx. λy. λz. λh. ⋆

-- x·d ≡ y·d with d ≠ 0 gives x ≡ y: the difference times d is zero,
-- so the difference is zero
def intMulCancel : (x y d : El Int) (h : Prf (x * d ≡ y * d)) (hd : Prf (¬ (d ≡ intZero))) → x ≡ y
  using (intAddNegL, intMulNegL, intAddZeroL, intAddZeroR) ≔
  λx. λy. λd. λh. λhd. sym
    _
    _
    _
    (trans
      _
      _
      _
      _
      (sym _ _ _ (intAddZeroL y))
      (trans
        Int
        (intZero + y)
        (x + intNeg y + y)
        _
        (addCongL
          (sym
            _
            _
            _
            (intNoZeroDiv
              _
              (trans
                _
                _
                _
                _
                (intMulDistribR x (intNeg y) d)
                (trans _ _ _ _ (intAddCong2 _ _ _ _ h (intMulNegL y d)) (intAddNegR (y * d))))
              hd)))
        (trans
          _
          _
          _
          _
          (intAddAssoc x (intNeg y) y)
          (trans
            Int
            (x + (intNeg y + y))
            (x + intZero)
            _
            (addCongR (intAddNegL y))
            (intAddZeroR x)))))

-- ===== RatR is an equivalence =====
-- (a·b)·c ≡ (a·c)·b, the one rearrangement transitivity needs
-- (a·b)·c ≡ (a·c)·b, the one rearrangement transitivity needs — a
-- calc chain: only tier-0/½ conversion is implicit, every step a
-- named link, no holes
def mulSwapRight : {a b c : El Int} → a * b * c ≡ a * c * b using (integer.Int.unfold) ≔
  λa. λb. λc. a * b * c
      ≡⟨ intMulAssoc a b c ⟩ a * (b * c)
      ≡⟨ mulCongR a _ _ (intMulComm b c) ⟩ a * (c * b)
      ≡⟨ intMulAssoc a c b ⟩ a * c * b

def ratRRefl : (p : El Rat) → Prf (RatR p p) using (rationalQ.RatR.unfold) ≔ λp. ⋆

def ratRSymm : (p q : El Rat) → Prf (RatR p q) → Prf (RatR q p)
  using (integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λq. λh. sym _ (num p * dInt q) (num q * dInt p) h

-- multiply the goal through by the middle denominator, walk it across
-- the two hypotheses, and cancel — the middle denominator is non-zero
-- because it is the image of an NZ
def ratRTrans : (p q r : El Rat) → Prf (RatR p q) → Prf (RatR q r) → Prf (RatR p r)
  using (intMulAssoc,
    integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λq. λr. λh1. λh2. intMulCancel
    _
    _
    _
    (trans
      Int
      (num p * dInt r * dInt q)
      (num p * dInt q * dInt r)
      _
      mulSwapRight
      (trans
        _
        _
        _
        _
        (mulCongL (num p * dInt q) (num q * dInt p) (dInt r) h1)
        (trans
          Int
          (num q * dInt p * dInt r)
          (num q * dInt r * dInt p)
          _
          mulSwapRight
          (trans
            Int
            _
            (num r * dInt q * dInt p)
            (num r * dInt p * dInt q)
            (mulCongL (num q * dInt r) (num r * dInt q) (dInt p) h2)
            mulSwapRight))))
    (nzToIntNonZero (den q))

-- ===== effectivity =====
def qEffective : (p q : El Rat) → Prf (class p ≡ class q ∈ El Q) → Prf (RatR p q)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  effectiveAtEquiv _ RatR ratRRefl ratRTrans ratRSymm

-- the converse of rationalInv.nova's ratZeroOfNumZero, which needed
-- effectivity and so could not be stated until now
def numZeroOfRatZero : (p : El Rat) (h : Prf (class p ≡ qZero)) → num p ≡ intZero
  using (intMulOneR,
    intMulZeroL,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intOne.eq,
    integer.intZero.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  λp. λh. trans
    _
    _
    (num p * dInt ratZero)
    _
    (sym _ _ _ (intMulOneR (num p)))
    (trans
      _
      (num p * dInt ratZero)
      (num ratZero * dInt p)
      intZero
      (qEffective _ ratZero h)
      (intMulZeroL (dInt p)))

def numZeroIff : (p : El Rat) → Prf ((class p ≡ qZero) ↔ (num p ≡ intZero))
  using (prop.↔.unfold, prop.∧.unfold, rationalQ.Q.unfold) ≔
  λp. iffIntro _ (numZeroOfRatZero p) (ratZeroOfNumZero p)

-- ===== the image of NZQ is exactly the non-zero rationals =====
def qOfNzqNonZero : (x : El NZQ) → Prf (¬ (qOfNzq x ≡ qZero))
  using (prop.¬.unfold,
    prop.⊃.unfold,
    rational.NZ.unfold,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rationalQ.NZQ.unfold,
    rationalQ.nzqToRat.eq,
    rationalQ.qOfNzq.eq,
    rationalQ.qcls.eq) ≔
  λx. notIntro _ (λh. notApply _ (nzToIntNonZero (x .π₁)) (numZeroOfRatZero (nzqToRat x) h))

-- so "non-zero" and "of the form qOfNzq x" coincide — the classical
-- description of ℚ's units, with the structural one
def qNonZeroIffNzq : (u : El Q) → Prf (¬ (u ≡ qZero) ↔ ∥(x : El NZQ) ⨯ Prf (qOfNzq x ≡ u)∥)
  using (prop.↔.unfold, prop.∧.unfold) ≔
  λu. iffIntro
    _
    (λh. qNonZeroIsNzq h)
    (λh. squash-elim h (w. notIntro
      (u ≡ qZero)
      (λe. notApply _ (qOfNzqNonZero (w .π₁)) (trans _ _ _ _ (w .π₂) e))))

-- ===== the field axiom, classically =====
-- 1 ≠ 0: nzToInt nzOne IS intOne, and the image of an NZ misses zero
def qOneNotZero : Prf (¬ (qOne ≡ qZero))
  using (integer.intOne.eq,
    prop.¬.unfold,
    prop.⊃.unfold,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq) ≔
  notIntro _ (λh. notApply (intOne ≡ intZero) (nzToIntNonZero nzOne) (numZeroOfRatZero ratOne h))

-- INVERTIBLE ⟺ NON-ZERO. Forwards is the inverse theorem; backwards,
-- a zero u would make 1 = u·v = 0·v = 0
def qInvertibleIffNonZero : (u : El Q) → Prf (¬ (u ≡ qZero) ↔ ∥(v : El Q) ⨯ Prf (u * v ≡ qOne)∥)
  using (integer.Int.unfold,
    prop.↔.unfold,
    prop.∧.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold) ≔
  λu. iffIntro
    _
    (λh. qInvExists h)
    (λh. squash-elim h (w. notIntro
      (u ≡ qZero)
      (λe. notApply
        _
        qOneNotZero
        (trans
          _
          qOne
          _
          _
          (sym Q (class (class (S Z, Z), inj₁ Z)) (class (class (S Z, Z), inj₁ Z)) (w .π₂))
          (trans Q _ (qZero * w .π₁) qZero (cong Q (λt. Q) (λx. x * w .π₁) _ _ e) qMulZeroL)))))
