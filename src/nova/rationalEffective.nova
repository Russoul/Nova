-- intNonZero first, to fix the elaboration order of the transitive
-- imports (docs/ProvingFeedback.md B-8)
import intNonZero (nzOfInt, nzToIntNonZero, intNoZeroDiv)
import integer (Int, intZero, intOne, intNeg)
import integerAdd (intAdd, intAddAssoc)
import integerMul (intMul, intMulComm, intMulAssoc, intMulOneR, intMulZeroL,
                   intMulDistribR, intMulNegL, intAddNegL, intAddNegR,
                   intAddCong2, intMulCong2)
import prop (¬, ⊥, ↔, iffIntro, absurdP)
import rational (NZ, nzToInt, nzOne, Rat, mkRat, num, den, ratZero, ratOne,
                 intAddZeroL, intAddZeroR)
import rationalQ (Q, qcls, qZero, qOne, qMul, qMulZeroL, RatR, dInt, clsEqOfRel,
                  mulCongL, mulCongR, NZQ, qOfNzq, nzqToRat, nzToIntMul)
import rationalInv (notIntro, notApply, numNonZero, ratZeroOfNumZero,
                    qNonZeroIsNzq, qInvExists)
import quotEffective (effectiveAtEquiv)
import equality (trans, sym, cong)

-- ℚ IS EFFECTIVE: equal classes give cross-multiplication back.
--
-- quotEffective.nova asks for one thing — that the relation be an
-- equivalence. For RatR only transitivity is real work, and it is the
-- usual argument: multiply through by the middle denominator and
-- CANCEL it. Cancellation in ℤ is where intNonZero.nova's
-- no-zero-divisors finally pays off a second time.
--
-- The corollary is the converse that was out of reach before: a
-- rational built from a non-zero numerator is not zero, so qOfNzq's
-- image is exactly the non-zero rationals.

-- ===== cancellation in ℤ =====

def addCongL : (x : El Int) (y : El Int) (z : El Int) →
  (x ≡ y ∈ El Int) → intAdd x z ≡ intAdd y z ∈ El Int ≔
  λx. λy. λz. λh. ⋆
def addCongR : (x : El Int) (y : El Int) (z : El Int) →
  (y ≡ z ∈ El Int) → intAdd x y ≡ intAdd x z ∈ El Int ≔
  λx. λy. λz. λh. ⋆

-- x·d ≡ y·d with d ≠ 0 gives x ≡ y: the difference times d is zero,
-- so the difference is zero
def intMulCancel : (x : El Int) (y : El Int) (d : El Int)
  (h : Prf (intMul x d ≡ intMul y d ∈ El Int))
  (hd : Prf (¬ (d ≡ intZero ∈ El Int))) →
  x ≡ y ∈ El Int ≔
  λx. λy. λd. λh. λhd.
    sym _ _ _
      (trans _ _ _ _
        (sym _ _ _ (intAddZeroL y))
        (trans _ _ _ _
          (addCongL _ _ _
            (sym Int _ _
              (intNoZeroDiv _ _
                (trans _
                  _
                  _
                  _
                  (intMulDistribR x (intNeg y) d)
                  (trans _
                    _
                    _
                    _
                    (intAddCong2 _ _
                                 _ _
                       h (intMulNegL y d))
                    (intAddNegR (intMul y d))))
                hd)))
          (trans _ _ _ _
            (intAddAssoc x (intNeg y) y)
            (trans _ _ _ _
              (addCongR x _ _ (intAddNegL y))
              (intAddZeroR x)))))

-- ===== RatR is an equivalence =====

-- (a·b)·c ≡ (a·c)·b, the one rearrangement transitivity needs
def mulSwapRight : (a : El Int) (b : El Int) (c : El Int) →
  intMul (intMul a b) c ≡ intMul (intMul a c) b ∈ El Int ≔
  λa. λb. λc.
    trans _ _ _ _
      (intMulAssoc _ b _)
      (trans _ _ _ _
        (mulCongR _ _ _ (intMulComm b c))
        (sym _ _ _ (intMulAssoc a c b)))

def ratRRefl : (p : El Rat) → Prf (RatR p p) ≔ λp. ⋆

def ratRSymm : (p : El Rat) (q : El Rat) → Prf (RatR p q) → Prf (RatR q p) ≔
  λp. λq. λh. sym Int _ _ h

-- multiply the goal through by the middle denominator, walk it across
-- the two hypotheses, and cancel — the middle denominator is non-zero
-- because it is the image of an NZ
def ratRTrans : (p : El Rat) (q : El Rat) (r : El Rat) →
  Prf (RatR p q) → Prf (RatR q r) → Prf (RatR p r) ≔
  λp. λq. λr. λh1. λh2.
    intMulCancel _ _ _
      (trans _
        _
        _
        _
        (mulSwapRight (num p) (dInt r) (dInt q))
        (trans _
          _
          _
          _
          (mulCongL _ _ (dInt r) h1)
          (trans _
            _
            _
            _
            (mulSwapRight (num q) (dInt p) (dInt r))
            (trans _
              _
              _
              _
              (mulCongL _ _ (dInt p) h2)
              (mulSwapRight (num r) (dInt q) (dInt p))))))
      (nzToIntNonZero (den q))

-- ===== effectivity =====

def qEffective : (p : El Rat) (q : El Rat) →
  Prf (class p ≡ class q ∈ El Q) → Prf (RatR p q) ≔
  effectiveAtEquiv Rat RatR ratRRefl ratRTrans ratRSymm

-- the converse of rationalInv.nova's ratZeroOfNumZero, which needed
-- effectivity and so could not be stated until now
def numZeroOfRatZero : (p : El Rat) (h : Prf (class p ≡ qZero ∈ El Q)) →
  num p ≡ intZero ∈ El Int ≔
  λp. λh.
    trans _ _ _ _
      (sym Int _ _ (intMulOneR (num p)))
      (trans _ _ _ _ (qEffective p ratZero h) (intMulZeroL (dInt p)))

def numZeroIff : (p : El Rat) →
  Prf ((class p ≡ qZero ∈ El Q) ↔ (num p ≡ intZero ∈ El Int)) ≔
  λp. iffIntro _ _ (numZeroOfRatZero p) (ratZeroOfNumZero p)

-- ===== the image of NZQ is exactly the non-zero rationals =====

def qOfNzqNonZero : (x : El NZQ) → Prf (¬ (qOfNzq x ≡ qZero ∈ El Q)) ≔
  λx.
    notIntro (qOfNzq x ≡ qZero ∈ El Q) (λh.
      notApply (nzToInt (x .π₁) ≡ intZero ∈ El Int)
        (nzToIntNonZero (x .π₁))
        (numZeroOfRatZero (nzqToRat x) h))

-- so "non-zero" and "of the form qOfNzq x" coincide — the classical
-- description of ℚ's units, with the structural one
def qNonZeroIffNzq : (u : El Q) →
  Prf ((¬ (u ≡ qZero ∈ El Q)) ↔ ∥(x : El NZQ) ⨯ Prf (qOfNzq x ≡ u ∈ El Q)∥) ≔
  λu.
    iffIntro _ _
      (λh. qNonZeroIsNzq u h)
      (λh. squash-elim h (w.
        notIntro (u ≡ qZero ∈ El Q) (λe.
          notApply (qOfNzq (w .π₁) ≡ qZero ∈ El Q)
            (qOfNzqNonZero (w .π₁))
            (trans Q (qOfNzq (w .π₁)) u qZero (w .π₂) e))))

-- ===== the field axiom, classically =====

-- 1 ≠ 0: nzToInt nzOne IS intOne, and the image of an NZ misses zero
def qOneNotZero : Prf (¬ (qOne ≡ qZero ∈ El Q)) ≔
  notIntro (qOne ≡ qZero ∈ El Q) (λh.
    notApply (intOne ≡ intZero ∈ El Int)
      (nzToIntNonZero nzOne)
      (numZeroOfRatZero ratOne h))

-- INVERTIBLE ⟺ NON-ZERO. Forwards is the inverse theorem; backwards,
-- a zero u would make 1 = u·v = 0·v = 0
def qInvertibleIffNonZero : (u : El Q) →
  Prf ((¬ (u ≡ qZero ∈ El Q)) ↔ ∥(v : El Q) ⨯ Prf (qMul u v ≡ qOne ∈ El Q)∥) ≔
  λu.
    iffIntro _ _
      (λh. qInvExists u h)
      (λh. squash-elim h (w.
        notIntro (u ≡ qZero ∈ El Q) (λe.
          notApply (qOne ≡ qZero ∈ El Q)
            qOneNotZero
            (trans Q qOne (qMul u (w .π₁)) qZero
              (sym Q _ _ (w .π₂))
              (trans Q (qMul u (w .π₁)) (qMul qZero (w .π₁)) qZero
                (cong Q (λt. Q) (λx. qMul x (w .π₁)) u qZero e)
                (qMulZeroL (w .π₁)))))))
