-- SUBGROUPS, NORMALITY, and the coset relation.
--
-- A subgroup of (G , g) is a PREDICATE N : El G → Ω together with the
-- three closure proofs. Ω-valued is not a stylistic choice: ty-quot
-- quantifies over Ω-valued relations only, and the whole point of a
-- subgroup here is to be quotiented by. It also means membership is
-- PROOF-IRRELEVANT, so none of the closure witnesses can leak into the
-- quotient's data — which is what lets every well-definedness goal
-- below be discharged by supplying a witness and nothing else.
--
-- The closure conditions are themselves propositions of Ω, quantified
-- over El G. That is only possible because Ω is IMPREDICATIVE: ∥·∥
-- squashes a Π out of an arbitrary type back into Ω (NovaFoundation,
-- Ω block). A 𝕌-coded subgroup structure would not have been available
-- — El G → Ω is large — and would have been the wrong thing anyway.

import prop (∧, andIntro, andFst, andSnd)
import group (IsGroup)
import (groupTheory g) (·, e, ⁻¹, gAssoc, gUnitL, gUnitR, gInvL, gInvR, gCancelInner, gCancelInnerInv, gCancelOuter, gInvUniq, gInvInv, gInvUnit, gOpInv, gCancelL, gCancelR)
import equality (transportP, sym, trans, cong)

module {G : 𝕌} (g : El (IsGroup G))

def hasUnit : (N : El G → Ω) → Ω ≔ λN. N e

def closedOp : (N : El G → Ω) → Ω ≔ λN. ∥(x y : El G) → Prf (N x) → Prf (N y) → Prf (N (x · y))∥

def closedInv : (N : El G → Ω) → Ω ≔ λN. ∥(x : El G) → Prf (N x) → Prf (N (x ⁻¹))∥

def IsSubgroup : (N : El G → Ω) → Ω ≔ λN. hasUnit N ∧ closedOp N ∧ closedInv N

-- ===== intro and the three eliminations =====
def sgIntro : {N : El G → Ω}
  → Prf (N
    e)
    → ((x y : El G)
      → Prf (N
        x)
        → Prf (N
          y) → Prf (N (x · y))) → ((x : El G) → Prf (N x) → Prf (N (x ⁻¹))) → Prf (IsSubgroup N)
  using (IsSubgroup.eq, hasUnit.eq, closedOp.eq, closedInv.eq) ≔
  λN. λu. λo. λi. andIntro u (andIntro {} (closedOp N) (closedInv N) (⋆ o) (⋆ i))

def sgUnit : {N : El G → Ω} → Prf (IsSubgroup N) → Prf (N e) using (IsSubgroup.eq, hasUnit.eq) ≔
  λN. λh. andFst h

def sgOp : {N : El G → Ω}
  → Prf (IsSubgroup N) → (x y : El G) → Prf (N x) → Prf (N y) → Prf (N (x · y))
  using (IsSubgroup.eq, closedOp.unfold) ≔
  λN. λh. λx. λy. λhx. λhy. squash-elim (andFst (andSnd h)) (u. u x y hx hy)

def sgInv : {N : El G → Ω} → Prf (IsSubgroup N) → (x : El G) → Prf (N x) → Prf (N (x ⁻¹))
  using (IsSubgroup.eq, closedInv.unfold) ≔
  λN. λh. λx. λhx. squash-elim (andSnd (andSnd h)) (u. u x hx)

-- ===== normality =====
--
-- Stated as closure under CONJUGATION, x · n · x⁻¹ ∈ N for every x.
-- This is the form the quotient's inner well-definedness proof needs
-- verbatim, and (unlike "xN = Nx") it never mentions a coset.
def IsNormal : (N : El G → Ω) → Ω ≔ λN. ∥(x n : El G) → Prf (N n) → Prf (N (x · (n · x ⁻¹)))∥

def nmIntro : {N : El G → Ω}
  → ((x n : El G) → Prf (N n) → Prf (N (x · (n · x ⁻¹)))) → Prf (IsNormal N)
  using (IsNormal.eq) ≔
  λN. λk. ⋆ k

def nmConj : (N : El G → Ω) → Prf (IsNormal N) → (x n : El G) → Prf (N n) → Prf (N (x · (n · x ⁻¹)))
  using (IsNormal.unfold) ≔
  λN. λh. λx. λn. λhn. squash-elim h (u. u x n hn)

-- conjugation by the INVERSE, the shape the quotient's inverse descent
-- wants: x⁻¹ · n · x ∈ N. One gInvInv away from nmConj
def nmConjInv : (N : El G → Ω)
  → Prf (IsNormal N) → (x n : El G) → Prf (N n) → Prf (N (x ⁻¹ · (n · x))) ≔
  λN. λh. λx. λn. λhn. transportP
    N
    (cong (λw. G) (λw. x ⁻¹ · (n · w)) (gInvInv x))
    (nmConj _ h (x ⁻¹) n hn)

-- In an ABELIAN group conjugation is the identity, so normality is
-- automatic — the single most common way a normal subgroup arises, and
-- the reason the corpus's numerical quotients never had to mention it.
def abelianConj : ((x y : El G) → x · y ≡ y · x) → (x n : El G) → x · (n · x ⁻¹) ≡ n ≔
  λcomm. λx. λn. x · (n · x ⁻¹)
      ≡⟨ cong (λw. G) (λw. x · w) (comm n (x ⁻¹)) ⟩ x · (x ⁻¹ · n)
      ≡⟨ gCancelInner x n ⟩ n

def abelianNormal : ((x y : El G) → x · y ≡ y · x) → {N : El G → Ω} → Prf (IsNormal N) ≔
  λcomm. λN. nmIntro (λx. λn. λhn. transportP N (sym _ _ (abelianConj comm x n)) hn)

-- ===== the coset relation =====
--
--   x ~ y  ≜  x · y⁻¹ ∈ N
--
-- Ω-valued by construction, since N is. The three equivalence proofs
-- need only that N is a SUBGROUP — normality is what makes the group
-- operation descend, not what makes the relation an equivalence.
def cosetRel : (N : El G → Ω) → El G → El G → Ω ≔ λN. λx. λy. N (x · y ⁻¹)

def cosetRefl : {N : El G → Ω} → Prf (IsSubgroup N) → (x : El G) → Prf (cosetRel N x x)
  using (cosetRel.eq) ≔
  λN. λs. λx. transportP N (sym _ _ (gInvR x)) (sgUnit s)

-- (x · y⁻¹)⁻¹ = y · x⁻¹ — the algebra behind symmetry
def cosetFlip : {x y : El G} → (x · y ⁻¹) ⁻¹ ≡ y · x ⁻¹ ≔
  λx. λy. (x · y ⁻¹) ⁻¹
      ≡⟨ gOpInv x (y ⁻¹) ⟩ y ⁻¹ ⁻¹ · x ⁻¹
      ≡⟨ cong (λw. G) (λw. w · x ⁻¹) (gInvInv y) ⟩ y · x ⁻¹

def cosetSymm : {N : El G → Ω}
  → Prf (IsSubgroup N) → (x y : El G) → Prf (cosetRel N x y) → Prf (cosetRel N y x)
  using (cosetRel.eq) ≔
  λN. λs. λx. λy. λh. transportP N cosetFlip (sgInv s (x · y ⁻¹) h)

-- (x · y⁻¹) · (y · z⁻¹) = x · z⁻¹ — the algebra behind transitivity
def cosetSplice : {x y z : El G} → x · y ⁻¹ · (y · z ⁻¹) ≡ x · z ⁻¹ ≔
  λx. λy. λz. x · y ⁻¹ · (y · z ⁻¹)
      ≡⟨ gAssoc x (y ⁻¹) (y · z ⁻¹) ⟩ x · (y ⁻¹ · (y · z ⁻¹))
      ≡⟨ cong (λw. G) (λw. x · w) (gCancelInnerInv y (z ⁻¹)) ⟩ x · z ⁻¹

def cosetTrans : {N : El G → Ω}
  → Prf (IsSubgroup
    N) → (x y z : El G) → Prf (cosetRel N x y) → Prf (cosetRel N y z) → Prf (cosetRel N x z)
  using (cosetRel.eq) ≔
  λN. λs. λx. λy. λz. λhxy. λhyz. transportP N cosetSplice (sgOp s (x · y ⁻¹) (y · z ⁻¹) hxy hyz)
