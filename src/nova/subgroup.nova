-- SUBGROUPS, NORMALITY, and the coset relation.
--
-- A subgroup of (G , g) is a PREDICATE N : El G → Ω together with the
-- three closure proofs. Ω-valued is not a stylistic choice: ty-quot
-- quantifies over Ω-valued relations only, and the whole point of a
-- subgroup here is to be quotiented by. It also means membership is
-- PROOF-IRRELEVANT, so none of the closure witnesses can leak into the
-- quotient's data — which is what lets every well-definedness goal
-- below be discharged by supplying a witness and nothing else.
--
-- The closure conditions are themselves propositions of Ω, quantified
-- over El G. That is only possible because Ω is IMPREDICATIVE: ∥·∥
-- squashes a Π out of an arbitrary type back into Ω (NovaFoundation,
-- Ω block). A 𝕌-coded subgroup structure would not have been available
-- — El G → Ω is large — and would have been the wrong thing anyway.

import prop (∧, andIntro, andFst, andSnd)
import group (IsGroup)
import groupTheory (· as gop, e as ge, ⁻¹ as ginv, gAssoc, gUnitL, gUnitR, gInvL, gInvR, gCancelInner, gCancelInnerInv, gCancelOuter, gInvUniq, gInvInv, gInvUnit, gOpInv, gCancelL, gCancelR)
import equality (transportP, sym, trans, cong)

def hasUnit : {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω) → Ω ≔ λG. λg. λN. N (ge g)

def closedOp : {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω) → Ω ≔
  λG. λg. λN. ∥(x y : El G) → Prf (N x) → Prf (N y) → Prf (N (gop g x y))∥

def closedInv : {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω) → Ω ≔
  λG. λg. λN. ∥(x : El G) → Prf (N x) → Prf (N (ginv g x))∥

def IsSubgroup : {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω) → Ω ≔
  λG. λg. λN. hasUnit g N ∧ closedOp g N ∧ closedInv g N

-- ===== intro and the three eliminations =====
def sgIntro : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (N
    (ge
      g))
    → ((x y : El G)
      → Prf (N
        x)
        → Prf (N
          y)
          → Prf (N
            (gop g x y))) → ((x : El G) → Prf (N x) → Prf (N (ginv g x))) → Prf (IsSubgroup g N)
  using (IsSubgroup.eq, hasUnit.eq, closedOp.eq, closedInv.eq) ≔
  λG. λg. λN. λu. λo. λi. andIntro u (andIntro {} (closedOp g N) (closedInv g N) (⋆ o) (⋆ i))

def sgUnit : {G : 𝕌} {g : El (IsGroup G)} {N : El G → Ω} → Prf (IsSubgroup g N) → Prf (N (ge g))
  using (IsSubgroup.eq, hasUnit.eq) ≔
  λG. λg. λN. λh. andFst h

def sgOp : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup g N) → (x y : El G) → Prf (N x) → Prf (N y) → Prf (N (gop g x y))
  using (IsSubgroup.eq, closedOp.unfold) ≔
  λG. λg. λN. λh. λx. λy. λhx. λhy. squash-elim (andFst (andSnd h)) (u. u x y hx hy)

def sgInv : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup g N) → (x : El G) → Prf (N x) → Prf (N (ginv g x))
  using (IsSubgroup.eq, closedInv.unfold) ≔
  λG. λg. λN. λh. λx. λhx. squash-elim (andSnd (andSnd h)) (u. u x hx)

-- ===== normality =====
--
-- Stated as closure under CONJUGATION, x · n · x⁻¹ ∈ N for every x.
-- This is the form the quotient's inner well-definedness proof needs
-- verbatim, and (unlike "xN = Nx") it never mentions a coset.
def IsNormal : {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω) → Ω ≔
  λG. λg. λN. ∥(x n : El G) → Prf (N n) → Prf (N (gop g x (gop g n (ginv g x))))∥

def nmIntro : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → ((x n : El G) → Prf (N n) → Prf (N (gop g x (gop g n (ginv g x))))) → Prf (IsNormal g N)
  using (IsNormal.eq) ≔
  λG. λg. λN. λk. ⋆ k

def nmConj : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsNormal g N) → (x n : El G) → Prf (N n) → Prf (N (gop g x (gop g n (ginv g x))))
  using (IsNormal.unfold) ≔
  λG. λg. λN. λh. λx. λn. λhn. squash-elim h (u. u x n hn)

-- conjugation by the INVERSE, the shape the quotient's inverse descent
-- wants: x⁻¹ · n · x ∈ N. One gInvInv away from nmConj
def nmConjInv : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsNormal g N) → (x n : El G) → Prf (N n) → Prf (N (gop g (ginv g x) (gop g n x))) ≔
  λG. λg. λN. λh. λx. λn. λhn. transportP
    N
    (cong (λw. G) (λw. gop g (ginv g x) (gop g n w)) (gInvInv g x))
    (nmConj _ _ _ h (ginv g x) n hn)

-- In an ABELIAN group conjugation is the identity, so normality is
-- automatic — the single most common way a normal subgroup arises, and
-- the reason the corpus's numerical quotients never had to mention it.
def abelianConj : {G : 𝕌}
  {g : El (IsGroup G)}
  → ((x y : El G) → gop g x y ≡ gop g y x) → (x n : El G) → gop g x (gop g n (ginv g x)) ≡ n ≔
  λG. λg. λcomm. λx. λn. gop g x (gop g n (ginv g x))
      ≡⟨ cong (λw. G) (λw. gop g x w) (comm n (ginv g x)) ⟩ gop g x (gop g (ginv g x) n)
      ≡⟨ gCancelInner g x n ⟩ n

def abelianNormal : {G : 𝕌}
  {g : El (IsGroup G)}
  → ((x y : El G) → gop g x y ≡ gop g y x) → {N : El G → Ω} → Prf (IsNormal g N) ≔
  λG. λg. λcomm. λN. nmIntro (λx. λn. λhn. transportP N (sym _ _ (abelianConj comm x n)) hn)

-- ===== the coset relation =====
--
--   x ~ y  ≜  x · y⁻¹ ∈ N
--
-- Ω-valued by construction, since N is. The three equivalence proofs
-- need only that N is a SUBGROUP — normality is what makes the group
-- operation descend, not what makes the relation an equivalence.
def cosetRel : {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω) → El G → El G → Ω ≔
  λG. λg. λN. λx. λy. N (gop g x (ginv g y))

def cosetRefl : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup g N) → (x : El G) → Prf (cosetRel g N x x)
  using (cosetRel.eq) ≔
  λG. λg. λN. λs. λx. transportP N (sym _ _ (gInvR g x)) (sgUnit s)

-- (x · y⁻¹)⁻¹ = y · x⁻¹ — the algebra behind symmetry
def cosetFlip : {G : 𝕌}
  {g : El (IsGroup G)}
  {x y : El G}
  → ginv g (gop g x (ginv g y)) ≡ gop g y (ginv g x) ≔
  λG. λg. λx. λy. ginv g (gop g x (ginv g y))
      ≡⟨ gOpInv g x (ginv g y) ⟩ gop g (ginv g (ginv g y)) (ginv g x)
      ≡⟨ cong (λw. G) (λw. gop g w (ginv g x)) (gInvInv g y) ⟩ gop g y (ginv g x)

def cosetSymm : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup g N) → (x y : El G) → Prf (cosetRel g N x y) → Prf (cosetRel g N y x)
  using (cosetRel.eq) ≔
  λG. λg. λN. λs. λx. λy. λh. transportP N cosetFlip (sgInv s (gop g x (ginv g y)) h)

-- (x · y⁻¹) · (y · z⁻¹) = x · z⁻¹ — the algebra behind transitivity
def cosetSplice : {G : 𝕌}
  {g : El (IsGroup G)}
  {x y z : El G}
  → gop g (gop g x (ginv g y)) (gop g y (ginv g z)) ≡ gop g x (ginv g z) ≔
  λG. λg. λx. λy. λz. gop g (gop g x (ginv g y)) (gop g y (ginv g z))
      ≡⟨ gAssoc
        g
        x
        (ginv g y)
        (gop g y (ginv g z)) ⟩ gop g x (gop g (ginv g y) (gop g y (ginv g z)))
      ≡⟨ cong (λw. G) (λw. gop g x w) (gCancelInnerInv g y (ginv g z)) ⟩ gop g x (ginv g z)

def cosetTrans : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup
    g
    N) → (x y z : El G) → Prf (cosetRel g N x y) → Prf (cosetRel g N y z) → Prf (cosetRel g N x z)
  using (cosetRel.eq) ≔
  λG. λg. λN. λs. λx. λy. λz. λhxy. λhyz. transportP
    N
    cosetSplice
    (sgOp s (gop g x (ginv g y)) (gop g y (ginv g z)) hxy hyz)
