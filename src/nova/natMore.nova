-- Arithmetic ℕ owes the rest of the corpus: right distributivity,
-- cancellation on the left and by a non-zero factor, truncated
-- subtraction with max/min, and exponentiation. Each of these was
-- either re-derived ad hoc downstream (`distribBackR` lives in
-- integerMul.nova, `oneMult` in rational.nova) or simply unavailable.
-- ===== distributivity on the right =====

import nat (+, *, plusZeroId, plusSucId, zeroPlusId, sucPlus, plusComm, plusAssoc, plusCancel, sucInj, multZeroId, multSucId, zeroMult, sucMult, multComm, multDistrib, multAssoc)
import natOrder (≤, leRefl, leTrans, leTotal, sumZeroL, sumZeroR, leAntisym)
import equality (trans, sym, cong)
import id (Id, idToEq, eqToId)

def multDistribR : (n m k : ℕ) → (m + k) * n ≡ m * n + k * n ≔
  λn. λm. λk. (m + k) * n
      ≡⟨ multComm (m + k) n ⟩ n * (m + k)
      ≡⟨ multDistrib n m k ⟩ n * m + n * k
      ≡⟨ cong (λu. ℕ) (λw. w + n * k) (multComm m n) ⟩ m * n + n * k
      ≡⟨ cong (λu. ℕ) (λw. m * n + w) (multComm k n) ⟩ m * n + k * n

-- ===== cancellation =====
def plusCancelL : (k n m : ℕ) → (k + n ≡ k + m) → n ≡ m ≔
  λk. λn. λm. λh. plusCancel _ _ _ (trans _ _ _ (plusComm k n) (trans _ _ _ h (plusComm m k)))

-- a product with a SUCCESSOR is zero only if the other factor is
def multZeroInv : (j k : ℕ) → (j * S k ≡ Z) → j ≡ Z ≔
  λj. λk. λh. sumZeroL _ _ (trans _ _ _ (sym _ _ (multSucId j k)) h)

-- cancellation by S k, under the assumption that the smaller side is
-- known: the surplus times S k is zero, hence zero
def multCancelLe : {n m : ℕ} (k : ℕ) → (n ≤ m) → (n * S k ≡ m * S k) → n ≡ m
  using (id.Id.unfold, nat.plusZeroId, natOrder.≤.unfold) ≔
  λn. λm. λk. λle. λh. let e : n
    + le .π₁ ≡ m ≔ idToEq
    _
    _
    _
    (le .π₂) in let split : n
    * S k ≡ n
    * S k
    + le .π₁
      * S k ≔ trans
    _
    _
    _
    h
    (trans
      _
      _
      _
      (cong (λu. ℕ) (λw. w * S k) (sym _ _ e))
      (multDistribR
        (S k)
        n
        (le .π₁))) in let jz : le .π₁ ≡ Z ≔ multZeroInv
    _
    _
    (sym
      _
      _
      (plusCancelL
        (n * S k)
        Z
        (le .π₁ * S k)
        split)) in trans
    _
    _
    _
    (sym _ _ (trans _ _ _ (cong (λu. ℕ) (λw. n + w) jz) (plusZeroId n)))
    e

def multCancelR : (n m k : ℕ) → (n * S k ≡ m * S k) → n ≡ m ≔
  λn. λm. λk. λh. ⊎-elim
    (le. multCancelLe _ le h)
    (le. sym _ _ (multCancelLe _ le (sym _ _ h)))
    (leTotal n m)

-- ===== truncated subtraction =====
def pred : ℕ → ℕ ≔ λn. ℕ-elim Z (k ih. k) n

infixl 6 ∸
def ∸ : ℕ → ℕ → ℕ ≔ λa. λb. ℕ-elim a (k ih. pred ih) b

def monusZeroR : {a : ℕ} → a ∸ Z ≡ a using (natMore.∸.eq) ≔ λa. ⋆

def monusSucR : (a b : ℕ) → a ∸ S b ≡ pred (a ∸ b) using (natMore.pred.eq, natMore.∸.eq) ≔ λa. λb. ⋆

def zeroMonus : (b : ℕ) → Z ∸ b ≡ Z
  using (hyp.rw,
    natMore.monusZeroR,
    natMore.monusZeroR.rw,
    natMore.monusSucR,
    natMore.monusSucR.rw,
    natMore.pred.eq) ≔
  λb. ℕ-elim ⋆ (k ih. ⋆) b

def sucMonusSuc : (a b : ℕ) → S a ∸ S b ≡ a ∸ b using (natMore.pred.eq, natMore.∸.eq) ≔
  λa. λb. ℕ-elim ⋆ (k ih. ⋆) b

-- (a + b) − b is a, on the nose
def plusMonus : (a b : ℕ) → a + b ∸ b ≡ a
  using (hyp.rw,
    plusZeroId,
    plusZeroId.rw,
    plusSucId,
    plusSucId.rw,
    natMore.monusZeroR,
    natMore.monusZeroR.rw,
    sucMonusSuc,
    sucMonusSuc.rw) ≔
  λa. λb. ℕ-elim ⋆ (k ih. ⋆) b

-- subtracting a sum is subtracting twice
def monusPlus : (a b c : ℕ) → a ∸ (b + c) ≡ a ∸ b ∸ c using (nat.+.eq, natMore.∸.eq) ≔
  λa. λb. λc. ℕ-elim ⋆ (k ih. ⋆) c

def monusSelf : {a : ℕ} → a ∸ a ≡ Z
  using (hyp.rw, natMore.zeroMonus, natMore.zeroMonus.rw, sucMonusSuc, sucMonusSuc.rw) ≔
  λa. ℕ-elim ⋆ (k ih. ⋆) a

-- ...so a ≤ b makes a − b vanish
def monusZeroOfLe : (a b : ℕ) → (a ≤ b) → a ∸ b ≡ Z using (id.Id.unfold, natOrder.≤.unfold) ≔
  λa. λb. λle. a ∸ b
      ≡⟨ cong (λu. ℕ) (λw. a ∸ w) (sym _ _ (idToEq _ _ _ (le .π₂))) ⟩ a ∸ (a + le .π₁)
      ≡⟨ monusPlus a a (le .π₁) ⟩ a ∸ a ∸ le .π₁
      ≡⟨ cong (λu. ℕ) (λw. w ∸ le .π₁) {a ∸ a} {Z} monusSelf ⟩ Z ∸ le .π₁
      ≡⟨ zeroMonus (le .π₁) ⟩ Z

-- ...and a ≤ b makes the difference add back
def leMonusPlus : {a b : ℕ} → (a ≤ b) → a + (b ∸ a) ≡ b using (id.Id.unfold, natOrder.≤.unfold) ≔
  λa. λb. λle. let e : a
    + le .π₁ ≡ b ≔ idToEq
    _
    _
    _
    (le .π₂) in a + (b ∸ a)
      ≡⟨ cong (λu. ℕ) (λw. a + (w ∸ a)) (sym _ _ e) ⟩ a + (a + le .π₁ ∸ a)
      ≡⟨ cong (λu. ℕ) (λw. a + (w ∸ a)) (plusComm (le .π₁) a) ⟩ a + (le .π₁ + a ∸ a)
      ≡⟨ cong (λu. ℕ) (λw. a + w) (plusMonus (le .π₁) a) ⟩ a + le .π₁
      ≡⟨ e ⟩ b

-- ===== max and min =====
def natMax : ℕ → ℕ → ℕ ≔ λa. λb. a + (b ∸ a)

def natMin : ℕ → ℕ → ℕ ≔ λa. λb. a ∸ (a ∸ b)

-- a sits under the max by construction: the witness is the difference
def leMaxL : (a b : ℕ) → (a ≤ natMax a b) using (natMore.natMax.eq, natOrder.≤.unfold) ≔
  λa. λb. b ∸ a, eqToId _ _ ⋆

-- and so does b, once the two cases are settled
-- a ≤ b : the max IS b
-- b ≤ a : the max is a, and b ≤ a
def leMaxR : (a b : ℕ) → (b ≤ natMax a b)
  using (id.Id.unfold, natMore.natMax.eq, natOrder.≤.unfold) ≔
  λa. λb. ⊎-elim
    (le. Z, eqToId _ _ (trans _ _ _ (plusZeroId b) (sym (natMax a b) _ (leMonusPlus le))))
    (le. le .π₁
      + (b
        ∸ a),
      eqToId
        _
        _
        (trans
          _
          _
          (natMax a b)
          (trans
            _
            _
            _
            (sym _ _ (plusAssoc b (le .π₁) (b ∸ a)))
            (cong (λu. ℕ) (λw. w + (b ∸ a)) (idToEq _ _ _ (le .π₂))))
          ⋆))
    (leTotal a b)

def natMaxSelf : (a : ℕ) → natMax a a ≡ a using (natMore.natMax.eq) ≔
  λa. trans _ _ _ (cong (λu. ℕ) (λw. a + w) {a ∸ a} {Z} monusSelf) (plusZeroId a)

def natMinSelf : (a : ℕ) → natMin a a ≡ a using (natMore.natMin.eq) ≔
  λa. trans _ _ _ (cong (λu. ℕ) (λw. a ∸ w) {a ∸ a} {Z} monusSelf) monusZeroR

-- ===== exponentiation =====
infixr 8 ^
def ^ : ℕ → ℕ → ℕ ≔ λa. λn. ℕ-elim (S Z) (k ih. a * ih) n

def expZero : (a : ℕ) → a ^ Z ≡ S Z using (natMore.^.eq) ≔ λa. ⋆

def expSuc : (a n : ℕ) → a ^ S n ≡ a * a ^ n using (nat.*.eq, natMore.^.eq) ≔ λa. λn. ⋆

def oneExp : (n : ℕ) → S Z ^ n ≡ S Z
  using (hyp.rw,
    natMore.expZero,
    natMore.expZero.rw,
    natMore.expSuc,
    natMore.expSuc.rw,
    multSucId,
    multSucId.rw,
    multZeroId,
    multZeroId.rw,
    plusZeroId,
    plusZeroId.rw) ≔
  λn. ℕ-elim ⋆ (k ih. ⋆) n

-- x * (y * z) ≡ y * (x * z): the left-swap under associativity,
-- stated in the exact shape expPlus's step case needs
def multLeftComm : (x y z : ℕ) → x * (y * z) ≡ y * (x * z) ≔
  λx. λy. λz. x * (y * z)
      ≡⟨ multAssoc x y z ⟩ x * y * z
      ≡⟨ cong (λu. ℕ) (λw. w * z) (multComm y x) ⟩ y * x * z
      ≡⟨ multAssoc y x z ⟩ y * (x * z)

def expPlus : (a m n : ℕ) → a ^ (m + n) ≡ a ^ m * a ^ n
  using (hyp.rw,
    plusZeroId,
    plusZeroId.rw,
    natMore.expZero,
    natMore.expZero.rw,
    multSucId,
    multSucId.rw,
    multZeroId,
    multZeroId.rw) ≔
  λa. λm. λn. ℕ-elim
    ⋆
    (k ih. a ^ (m + S k)
        ≡⟨ plusSucId m k ⟩ a ^ S (m + k)
        ≡⟨ expSuc a (m + k) ⟩ a * a ^ (m + k)
        ≡⟨ ih ⟩ a * (a ^ m * a ^ k)
        ≡⟨ multLeftComm a (a ^ m) (a ^ k) ⟩ a ^ m * (a * a ^ k)
        ≡⟨ expSuc a k ⟩ a ^ m * a ^ S k)
    n

-- ===== monus and a common summand =====
def monusPlusR : (a b k : ℕ) → a + k ∸ (b + k) ≡ a ∸ b
  using (hyp.rw, plusZeroId, plusZeroId.rw, plusSucId, plusSucId.rw, sucMonusSuc, sucMonusSuc.rw) ≔
  λa. λb. λk. ℕ-elim ⋆ (j ih. ⋆) k

def monusPlusL : {k a b : ℕ} → k + a ∸ (k + b) ≡ a ∸ b ≔
  λk. λa. λb. trans
    _
    _
    _
    (trans
      _
      _
      _
      (cong (λu. ℕ) (λw. w ∸ (k + b)) (plusComm a k))
      (cong (λu. ℕ) (λw. a + k ∸ w) (plusComm b k)))
    (monusPlusR a b k)

-- the difference-pair reading: a + d ≡ b + c makes a − b and c − d
-- the same truncated difference
def monusEqOfSum : {a b c d : ℕ} → (a + d ≡ b + c) → a ∸ b ≡ c ∸ d ≔
  λa. λb. λc. λd. λh. trans
    _
    _
    _
    (sym _ _ (monusPlusR a b d))
    (trans _ _ (c ∸ d) (cong (λu. ℕ) (λw. w ∸ (b + d)) h) monusPlusL)
