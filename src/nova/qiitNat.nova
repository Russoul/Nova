-- ℕ as a QIIT (docs/NovaFoundation.txt, SUBSUMPTION): a one-line
-- signature, with the derived eliminator computing by el-qiit-beta.
data ( N : U
     ; z : El N
     ; s : (n : El N) → El N )

def plusQ : El N → El N → El N ≔
  λa. λb. NElim (λn. N) b (λn. λih. s ih) a

def plusQzl : (b : El N) → plusQ z b ≡ b ∈ El N ≔ λb. Refl

def plusQsl : (a : El N) (b : El N) → plusQ (s a) b ≡ s (plusQ a b) ∈ El N ≔
  λa. λb. Refl

-- induction: plusQ a z ≡ a, by NElim at an equality motive
def plusQzr : (a : El N) → plusQ a z ≡ a ∈ El N ≔
  λa. NElim (λn. (plusQ n z ≡ n ∈ N)) Refl (λn. λih. Refl) a
