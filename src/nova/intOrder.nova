-- Order on ℤ, same shape as natOrder's LeN: the difference between
-- two integers in the right order is a NATURAL, so x ≤ y is a nat
-- witness k with an Id-proof that x + k closes the gap. No quot-elim
-- into 𝕌 is ever needed (𝕌-equality is structural, so a code family
-- BY REPRESENTATIVES has no well-definedness proof): the family is
-- built by COMPOSITION — intAdd, intOfNat, Id — and the one place
-- representatives must be touched (deciding the order) goes through
-- the honest function intCanon.

import nat (+, *, plusComm, zeroPlusId, zeroMult)
import natOrder (≤, leTotal, sumZeroL)
import integer (Int, intZero, intNeg)
import integerAdd (+, intAddComm, intAddAssoc)
import integerMul (*, intMulComm, intMulDistribL, intAddNegL, intAddNegR, intNegNeg, classPairEta)
import rational (intAddZeroL, intAddZeroR)
import eqInt (intCanon, intCanonClass)
import intEffective (intEffective)
import equality (trans, sym, cong, transport)
import id (Id, idToEq, eqToId)

def intOfNat : ℕ → El Int using (integer.Int.unfold) ≔ λn. class (n, Z)

infixl 4 ≤
def ≤ : El Int → El Int → 𝕌 ≔ λx. λy. (k : ℕ) ⨯ Id Int (x + intOfNat k) y

-- ===== glue: intOfNat is an order-embedding-ready map =====
def intOfNatZero : intOfNat Z ≡ intZero
  using (intOrder.intOfNat.eq, integer.Int.unfold, integer.intZero.eq) ≔
  ⋆

def intOfNatPlus : (a b : ℕ) → intOfNat a + intOfNat b ≡ intOfNat (a + b)
  using (intOrder.intOfNat.eq, integer.Int.unfold, integerAdd.+.eq, nat.+.eq) ≔
  λa. λb. ⋆

def intOfNatInjZ : {k : ℕ} → (intOfNat k ≡ intZero) → k ≡ Z
  using (hyp.rw,
    intOrder.intOfNat.eq,
    integer.IntR.unfold,
    integer.intZero.eq,
    nat.plusZeroId,
    nat.plusZeroId.rw) ≔
  λk. λh. let r ≔ intEffective (k, Z) (Z, Z) h in ⋆

-- x + ofNat (a + b) ≡ (x + ofNat a) + ofNat b, hypothesis-free
def intOfNatSplit : {x : El Int} {a b : ℕ} → x + intOfNat (a + b) ≡ x + intOfNat a + intOfNat b
  using (integer.Int.unfold) ≔
  λx. λa. λb. x + intOfNat (a + b)
      ≡⟨ cong
        Int
        (λu. Int)
        (λu. x + u)
        (intOfNat (a + b))
        (intOfNat a + intOfNat b)
        (sym
          Int
          (intOfNat a + intOfNat b)
          (intOfNat (a + b))
          (intOfNatPlus a b)) ⟩ x + (intOfNat a + intOfNat b)
      ≡⟨ sym
        Int
        (x + intOfNat a + intOfNat b)
        (x + (intOfNat a + intOfNat b))
        (intAddAssoc x (intOfNat a) (intOfNat b)) ⟩ x + intOfNat a + intOfNat b

-- ===== additive-group plumbing =====
def intNegAdd : (z w : El Int) → intNeg (z + w) ≡ intNeg z + intNeg w
  using (integer.Int.unfold, integer.intNeg.eq, integerAdd.+.eq) ≔
  λz. λw. quot-elim (p. quot-elim (q. ⋆) w) z

-- −x + (x + a) ≡ a, hypothesis-free
def intNegPlusCancel : (x a : El Int) → intNeg x + (x + a) ≡ a using (integer.Int.unfold) ≔
  λx. λa. intNeg x + (x + a)
      ≡⟨ sym
        Int
        (intNeg x + x + a)
        (intNeg x + (x + a))
        (intAddAssoc (intNeg x) x a) ⟩ intNeg x + x + a
      ≡⟨ cong Int (λu. Int) (λu. u + a) (intNeg x + x) intZero (intAddNegL x) ⟩ intZero + a
      ≡⟨ intAddZeroL a ⟩ a

def intCancelL : (x a b : El Int) → (x + a ≡ x + b) → a ≡ b ≔
  λx. λa. λb. λh. trans
    Int
    a
    (intNeg x + (x + a))
    b
    (sym Int (intNeg x + (x + a)) a (intNegPlusCancel x a))
    (trans
      Int
      (intNeg x + (x + a))
      (intNeg x + (x + b))
      b
      (cong Int (λu. Int) (λu. intNeg x + u) (x + a) (x + b) h)
      (intNegPlusCancel x b))

-- x + (y − x) ≡ y, and y − (y − x) ≡ x: the two rearrangements the
-- order decision below hangs on
def intPlusDiff : (x y : El Int) → x + (y + intNeg x) ≡ y using (integer.Int.unfold) ≔
  λx. λy. x + (y + intNeg x)
      ≡⟨ cong
        Int
        (λu. Int)
        (λu. x + u)
        (y + intNeg x)
        (intNeg x + y)
        (intAddComm y (intNeg x)) ⟩ x + (intNeg x + y)
      ≡⟨ sym
        Int
        (x + intNeg x + y)
        (x + (intNeg x + y))
        (intAddAssoc x (intNeg x) y) ⟩ x + intNeg x + y
      ≡⟨ cong Int (λu. Int) (λu. u + y) (x + intNeg x) intZero (intAddNegR x) ⟩ intZero + y
      ≡⟨ intAddZeroL y ⟩ y

def intPlusNegDiff : (x y : El Int) → y + intNeg (y + intNeg x) ≡ x using (integer.Int.unfold) ≔
  λx. λy. y + intNeg (y + intNeg x)
      ≡⟨ cong
        Int
        (λu. Int)
        (λu. y + u)
        (intNeg (y + intNeg x))
        (intNeg y + intNeg (intNeg x))
        (intNegAdd y (intNeg x)) ⟩ y + (intNeg y + intNeg (intNeg x))
      ≡⟨ cong
        Int
        (λu. Int)
        (λu. y + (intNeg y + u))
        (intNeg (intNeg x))
        x
        (intNegNeg x) ⟩ y + (intNeg y + x)
      ≡⟨ sym
        Int
        (y + intNeg y + x)
        (y + (intNeg y + x))
        (intAddAssoc y (intNeg y) x) ⟩ y + intNeg y + x
      ≡⟨ cong Int (λu. Int) (λu. u + x) (y + intNeg y) intZero (intAddNegR y) ⟩ intZero + x
      ≡⟨ intAddZeroL x ⟩ x

-- ===== the order =====
def leZRefl : (x : El Int) → El (x ≤ x)
  using (intOrder.≤.unfold, intOrder.intOfNatZero, integer.Int.unfold) ≔
  λx. Z, eqToId (x + intOfNat Z) x (intAddZeroR x)

def leZOfEq : {x y : El Int} → (x ≡ y) → El (x ≤ y)
  using (intOrder.≤.unfold, intOrder.intOfNatZero, integer.Int.unfold) ≔
  λx. λy. λh. Z, eqToId (x + intOfNat Z) y (trans Int (x + intOfNat Z) x y (intAddZeroR x) h)

def leZTrans : {x : El Int} (y : El Int) {z : El Int} → El (x ≤ y) → El (y ≤ z) → El (x ≤ z)
  using (intOrder.≤.unfold) ≔
  λx. λy. λz. λl1. λl2. l1 .π₁
    + l2 .π₁,
    eqToId
      (x + intOfNat (l1 .π₁ + l2 .π₁))
      z
      (trans
        Int
        (x + intOfNat (l1 .π₁ + l2 .π₁))
        (x + intOfNat (l1 .π₁) + intOfNat (l2 .π₁))
        z
        intOfNatSplit
        (trans
          Int
          (x + intOfNat (l1 .π₁) + intOfNat (l2 .π₁))
          (y + intOfNat (l2 .π₁))
          z
          (cong
            Int
            (λu. Int)
            (λu. u + intOfNat (l2 .π₁))
            (x + intOfNat (l1 .π₁))
            y
            (idToEq Int (x + intOfNat (l1 .π₁)) y (l1 .π₂)))
          (idToEq Int (y + intOfNat (l2 .π₁)) z (l2 .π₂))))

def leZAntisym : (x y : El Int) → El (x ≤ y) → El (y ≤ x) → x ≡ y using (intOrder.≤.unfold) ≔
  λx. λy. λl1. λl2. let h1 ≔ idToEq
    Int
    (x + intOfNat (l1 .π₁))
    y
    (l1 .π₂) in let h2 ≔ idToEq
    Int
    (y + intOfNat (l2 .π₁))
    x
    (l2 .π₂) in let loop : x
    + intOfNat
      (l1 .π₁
        + l2 .π₁) ≡ x ≔ trans
    Int
    (x + intOfNat (l1 .π₁ + l2 .π₁))
    (x + intOfNat (l1 .π₁) + intOfNat (l2 .π₁))
    x
    intOfNatSplit
    (trans
      Int
      (x + intOfNat (l1 .π₁) + intOfNat (l2 .π₁))
      (y + intOfNat (l2 .π₁))
      x
      (cong Int (λu. Int) (λu. u + intOfNat (l2 .π₁)) (x + intOfNat (l1 .π₁)) y h1)
      h2) in let sumz : intOfNat
    (l1 .π₁
      + l2 .π₁) ≡ intZero ≔ intCancelL
    x
    (intOfNat (l1 .π₁ + l2 .π₁))
    intZero
    (trans
      Int
      (x + intOfNat (l1 .π₁ + l2 .π₁))
      x
      (x + intZero)
      loop
      (sym
        Int
        (x + intZero)
        x
        (intAddZeroR
          x))) in let k1z ≔ sumZeroL
    (l1 .π₁)
    (l2 .π₁)
    (intOfNatInjZ
      sumz) in trans
    Int
    x
    (x + intOfNat (l1 .π₁))
    y
    (trans
      Int
      x
      (x + intZero)
      (x + intOfNat (l1 .π₁))
      (sym Int (x + intZero) x (intAddZeroR x))
      (cong
        Int
        (λu. Int)
        (λu. x + u)
        intZero
        (intOfNat (l1 .π₁))
        (sym
          Int
          (intOfNat (l1 .π₁))
          intZero
          (trans
            Int
            (intOfNat (l1 .π₁))
            (intOfNat Z)
            intZero
            (cong ℕ (λu. Int) (λu. intOfNat u) (l1 .π₁) Z k1z)
            intOfNatZero))))
    h1

-- ===== monotonicity =====
-- the shuffle, HYPOTHESIS-FREE (an equation hypothesis in scope can
-- rewrite inside a stuck-scrutinee position of both chain sides at
-- once; such lockstep steps are unreplayable, so keep the shuffle in
-- a helper and use the hypothesis only through cong)
def intAddShiftR : {x w v : El Int} → x + w + v ≡ x + v + w using (integer.Int.unfold) ≔
  λx. λw. λv. x + w + v
      ≡⟨ intAddAssoc x w v ⟩ x + (w + v)
      ≡⟨ cong Int (λu. Int) (λu. x + u) (w + v) (v + w) (intAddComm w v) ⟩ x + (v + w)
      ≡⟨ sym Int (x + v + w) (x + (v + w)) (intAddAssoc x v w) ⟩ x + v + w

def leZPlusMonoR : {x y : El Int} (w : El Int) → El (x ≤ y) → El (x + w ≤ y + w)
  using (intOrder.≤.unfold) ≔
  λx. λy. λw. λle. le .π₁,
    eqToId
      (x + w + intOfNat (le .π₁))
      (y + w)
      (trans
        Int
        (x + w + intOfNat (le .π₁))
        (x + intOfNat (le .π₁) + w)
        (y + w)
        intAddShiftR
        (cong
          Int
          (λu. Int)
          (λu. u + w)
          (x + intOfNat (le .π₁))
          y
          (idToEq Int (x + intOfNat (le .π₁)) y (le .π₂))))

def leZPlusMonoL : (x y w : El Int) → El (x ≤ y) → El (w + x ≤ w + y) using (intOrder.≤.unfold) ≔
  λx. λy. λw. λle. leZTrans
    (x + w)
    (leZOfEq (intAddComm w x))
    (leZTrans (y + w) (leZPlusMonoR w le) (leZOfEq (intAddComm y w)))

-- again the shuffle first, hypothesis-free
def intNegAddCancel : {x v : El Int} → intNeg (x + v) + v ≡ intNeg x using (integer.Int.unfold) ≔
  λx. λv. intNeg (x + v) + v
      ≡⟨ cong
        Int
        (λu. Int)
        (λu. u + v)
        (intNeg (x + v))
        (intNeg x + intNeg v)
        (intNegAdd x v) ⟩ intNeg x + intNeg v + v
      ≡⟨ intAddAssoc (intNeg x) (intNeg v) v ⟩ intNeg x + (intNeg v + v)
      ≡⟨ cong
        Int
        (λu. Int)
        (λu. intNeg x + u)
        (intNeg v + v)
        intZero
        (intAddNegL v) ⟩ intNeg x + intZero
      ≡⟨ intAddZeroR (intNeg x) ⟩ intNeg x

def leZNegFlip : (x y : El Int) → El (x ≤ y) → El (intNeg y ≤ intNeg x) using (intOrder.≤.unfold) ≔
  λx. λy. λle. le .π₁,
    eqToId
      (intNeg y + intOfNat (le .π₁))
      (intNeg x)
      (trans
        Int
        (intNeg y + intOfNat (le .π₁))
        (intNeg (x + intOfNat (le .π₁)) + intOfNat (le .π₁))
        (intNeg x)
        (cong
          Int
          (λu. Int)
          (λu. intNeg u + intOfNat (le .π₁))
          y
          (x + intOfNat (le .π₁))
          (sym Int (x + intOfNat (le .π₁)) y (idToEq Int (x + intOfNat (le .π₁)) y (le .π₂))))
        intNegAddCancel)

-- ===== the ℕ bridge =====
def leZOfNat : (a b : ℕ) → El (a ≤ b) → El (intOfNat a ≤ intOfNat b)
  using (intOrder.≤.unfold, natOrder.≤.unfold) ≔
  λa. λb. λle. le .π₁,
    eqToId
      (intOfNat a + intOfNat (le .π₁))
      (intOfNat b)
      (trans
        Int
        (intOfNat a + intOfNat (le .π₁))
        (intOfNat (a + le .π₁))
        (intOfNat b)
        (intOfNatPlus a (le .π₁))
        (cong ℕ (λu. Int) (λu. intOfNat u) (a + le .π₁) b (idToEq ℕ (a + le .π₁) b (le .π₂))))

-- ===== totality: decide by the canonical form of the difference =====
-- The class-equation legs, kept ABSTRACT in the pair components
-- (ProvingFeedback D-3): instantiated at intCanon's projections the
-- engine would match against the δ-UNFOLDED canon — a bare quot-elim
-- that proof-spine inference cannot type.
-- the represented relation behind clsOfRelGe's class equation, as its
-- own lemma: k + b ≡ Z + a from b + k ≡ a
def sumSwapZL : (a b k : ℕ) → (b + k ≡ a) → k + b ≡ Z + a ≔
  λa. λb. λk. λh. k + b ≡⟨ plusComm b k ⟩ b + k ≡⟨ h ⟩ a ≡⟨ zeroPlusId a ⟩ Z + a

def clsOfRelGe : (a b k : ℕ) → (b + k ≡ a) → class (k, Z) ≡ class (a, b) ∈ El Int
  using (integer.Int.unfold, plusComm, sumSwapZL, zeroPlusId) ≔
  λa. λb. λk. λh. ⋆

def clsOfRelLe : (a b k : ℕ) → (a + k ≡ b) → class (k, Z) ≡ class (b, a) ∈ El Int
  using (intOrder.clsOfRelGe, integer.Int.unfold, plusComm, zeroPlusId) ≔
  λa. λb. λk. λh. ⋆

def intNegClass : (p : ℕ ⨯ ℕ) → intNeg (class p) ≡ class (p .π₂, p .π₁)
  using (integer.Int.unfold, integer.intNeg.eq) ≔
  λp. ⋆

def leZTotal : (x y : El Int) → El (x ≤ y) ⊎ El (y ≤ x)
  using (id.Id.unfold,
    intOrder.≤.unfold,
    intOrder.intOfNat.eq,
    integer.Int.unfold,
    integerMul.intAddCong2,
    natOrder.≤.unfold) ≔
  λx. λy. let d ≔ y
    + intNeg
      x in let hd ≔ intCanonClass
    d in ⊎-elim
    (nn. let hb ≔ idToEq
      ℕ
      (intCanon d .π₂ + nn .π₁)
      (intCanon d .π₁)
      (nn .π₂) in let e1 : intOfNat
      (nn .π₁) ≡ class (intCanon
      d) ≔ intOfNat (nn .π₁)
        ≡⟨ clsOfRelGe
          (intCanon d .π₁)
          (intCanon d .π₂)
          (nn .π₁)
          hb ⟩ class (intCanon d .π₁, intCanon d .π₂)
        ≡⟨ classPairEta
          (intCanon
            d) ⟩ class (intCanon
          d) in inj₁ (nn .π₁,
      eqToId
        (x + intOfNat (nn .π₁))
        y
        (trans
          Int
          (x + intOfNat (nn .π₁))
          (x + d)
          y
          (cong
            Int
            (λu. Int)
            (λu. x + u)
            (intOfNat (nn .π₁))
            d
            (trans Int (intOfNat (nn .π₁)) (class (intCanon d)) d e1 hd))
          (intPlusDiff x y))))
    (nn. let ha ≔ idToEq
      ℕ
      (intCanon d .π₁ + nn .π₁)
      (intCanon d .π₂)
      (nn .π₂) in let e2 : intOfNat
      (nn .π₁) ≡ intNeg
      (class (intCanon
        d)) ≔ intOfNat (nn .π₁)
        ≡⟨ clsOfRelLe
          (intCanon d .π₁)
          (intCanon d .π₂)
          (nn .π₁)
          ha ⟩ class (intCanon d .π₂, intCanon d .π₁)
        ≡⟨ sym
          Int
          (intNeg (class (intCanon d)))
          (class (intCanon d .π₂, intCanon d .π₁))
          (intNegClass
            (intCanon
              d)) ⟩ intNeg
          (class (intCanon
            d)) in inj₂ (nn .π₁,
      eqToId
        (y + intOfNat (nn .π₁))
        x
        (trans
          Int
          (y + intOfNat (nn .π₁))
          (y + intNeg d)
          x
          (cong
            Int
            (λu. Int)
            (λu. y + u)
            (intOfNat (nn .π₁))
            (intNeg d)
            (trans
              Int
              (intOfNat (nn .π₁))
              (intNeg (class (intCanon d)))
              (intNeg d)
              e2
              (cong Int (λu. Int) (λu. intNeg u) (class (intCanon d)) d hd)))
          (intPlusNegDiff x y))))
    (leTotal (intCanon d .π₂) (intCanon d .π₁))

-- ===== multiplicative order =====
-- intOfNat is multiplicative (Z·b needs one zeroMult rewrite)
def intOfNatMul : (a b : ℕ) → intOfNat a * intOfNat b ≡ intOfNat (a * b)
  using (intOrder.intOfNat.eq,
    integerMul.*.eq,
    integer.Int.eq,
    zeroMult,
    zeroMult.rw,
    nat.multZeroId,
    nat.multZeroId.rw,
    nat.plusZeroId,
    nat.plusZeroId.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λa. λb. ⋆

-- right distributivity, from the left one by commutativity
def intMulDistribR : (a b c : El Int) → (a + b) * c ≡ a * c + b * c using (integer.Int.unfold) ≔
  λa. λb. λc. (a + b) * c
      ≡⟨ intMulComm (a + b) c ⟩ c * (a + b)
      ≡⟨ intMulDistribL c a b ⟩ c * a + c * b
      ≡⟨ cong Int (λv. Int) (λv. v + c * b) (c * a) (a * c) (intMulComm c a) ⟩ a * c + c * b
      ≡⟨ cong Int (λv. Int) (λv. a * c + v) (c * b) (b * c) (intMulComm c b) ⟩ a * c + b * c

-- scaling by a NATURAL preserves the order: the witness scales
def leZMultMonoNat : {x y : El Int} {m : ℕ} → El (x ≤ y) → El (x * intOfNat m ≤ y * intOfNat m)
  using (intOrder.≤.unfold) ≔
  λx. λy. λm. λle. le .π₁
    * m,
    eqToId
      (x * intOfNat m + intOfNat (le .π₁ * m))
      (y * intOfNat m)
      (trans
        Int
        (x * intOfNat m + intOfNat (le .π₁ * m))
        (x * intOfNat m + intOfNat (le .π₁) * intOfNat m)
        (y * intOfNat m)
        (cong
          Int
          (λv. Int)
          (λv. x * intOfNat m + v)
          (intOfNat (le .π₁ * m))
          (intOfNat (le .π₁) * intOfNat m)
          (sym
            Int
            (intOfNat (le .π₁) * intOfNat m)
            (intOfNat (le .π₁ * m))
            (intOfNatMul (le .π₁) m)))
        (trans
          Int
          (x * intOfNat m + intOfNat (le .π₁) * intOfNat m)
          ((x + intOfNat (le .π₁)) * intOfNat m)
          (y * intOfNat m)
          (sym
            Int
            ((x + intOfNat (le .π₁)) * intOfNat m)
            (x * intOfNat m + intOfNat (le .π₁) * intOfNat m)
            (intMulDistribR x (intOfNat (le .π₁)) (intOfNat m)))
          (cong
            Int
            (λv. Int)
            (λv. v * intOfNat m)
            (x + intOfNat (le .π₁))
            y
            (idToEq Int (x + intOfNat (le .π₁)) y (le .π₂)))))

-- a nonneg integer is a natural, witnessed
def leZNonNegView : (c : El Int) → El (intZero ≤ c) → (m : ℕ) ⨯ Prf (intOfNat m ≡ c)
  using (intOrder.≤.unfold) ≔
  λc. λle. le .π₁,
    trans
      Int
      (intOfNat (le .π₁))
      (intZero + intOfNat (le .π₁))
      c
      (sym Int (intZero + intOfNat (le .π₁)) (intOfNat (le .π₁)) (intAddZeroL (intOfNat (le .π₁))))
      (idToEq Int (intZero + intOfNat (le .π₁)) c (le .π₂))

-- scaling by a NONNEGATIVE integer preserves the order: view the
-- scalar as a natural and TRANSPORT the scaled inequality along the
-- view — LeZ is a 𝕌-family, so transport applies to it directly
def leZMultMono : (x y c : El Int) → El (x ≤ y) → El (intZero ≤ c) → El (x * c ≤ y * c)
  using (intOrder.≤.unfold) ≔
  λx. λy. λc. λle. λlc. transport
    Int
    (λu. x * u ≤ y * u)
    (intOfNat (leZNonNegView c lc .π₁))
    c
    (leZNonNegView c lc .π₂)
    (leZMultMonoNat le)
