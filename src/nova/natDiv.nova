import nat (+, *, plusZeroId, plusSucId, zeroPlusId, sucPlus, plusComm, plusAssoc,
            sucInj, multZeroId, multSucId, zeroMult, sucMult, multComm, multAssoc)
import natOrder (LeN, leRefl, leOfEq, leZero, leZeroInv, leSucMono, leTrans,
                 leTotal, leMultMonoR, leStep)
import natMore (∸, pred, plusCancelL, multDistribR, monusZeroR, monusSucR, zeroMonus, sucMonusSuc, plusMonus,
                monusPlus, monusSelf, monusZeroOfLe, leMonusPlus)
import eqNat (zNotS)
import equality (trans, sym, cong, transport)
import id (Id, idToEq, eqToId)

-- EUCLIDEAN DIVISION on ℕ, by a successor (so the divisor is never
-- zero and no side condition is needed). The recursion is on FUEL —
-- `a ∸ S b` is smaller than `a` but not structurally so — and `a`
-- itself is always enough fuel.
--
-- This is the arithmetic ℚ needs in order to have a CEILING, and the
-- ceiling is what ℝ needs in order to have multiplication: the product
-- of two regular sequences must be sampled at a depth proportional to
-- a bound on both, and a bound has to be a natural, computed from a
-- rational, by a function — i.e. by something the quotient respects.

-- ===== casing on a natural, with the equation in hand =====

def natCase : (C : 𝕌) → El C → (ℕ → El C) → ℕ → El C ≔
  λC. λz. λs. λn. ℕ-elim (k. El C) z (m rec. s m) n

-- the eliminator for it: each branch may use the equation that put it
-- there, which is what lets a division step know a > b. Two copies,
-- because a motive into Ω and a motive into 𝕌 are different rules and
-- the division spec needs one of each (the quotient equation is a
-- Prf, the remainder bound is data).
def natCaseElimEqD : (C : 𝕌) (P : El C → 𝕌) (z : El C) (s : ℕ → El C) (n : ℕ) →
  ((n ≡ Z ∈ ℕ) → El (P z)) →
  ((m : ℕ) → (n ≡ S m ∈ ℕ) → El (P (s m))) →
  El (P (natCase C z s n)) using (natDiv.natCase.eq) ≔
  λC. λP. λz. λs. λn.
    ℕ-elim (k. ((k ≡ Z ∈ ℕ) → El (P z)) →
             ((m : ℕ) → (k ≡ S m ∈ ℕ) → El (P (s m))) →
             El (P (natCase C z s k)))
      (λh0. λh1. h0 ⋆)
      (k' rec. λh0. λh1. h1 k' ⋆)
      n

def natCaseElimEq : (C : 𝕌) (P : El C → Ω) (z : El C) (s : ℕ → El C) (n : ℕ) →
  ((n ≡ Z ∈ ℕ) → Prf (P z)) →
  ((m : ℕ) → (n ≡ S m ∈ ℕ) → Prf (P (s m))) →
  Prf (P (natCase C z s n)) using (natDiv.natCase.eq) ≔
  λC. λP. λz. λs. λn.
    ℕ-elim (k. ((k ≡ Z ∈ ℕ) → Prf (P z)) →
             ((m : ℕ) → (k ≡ S m ∈ ℕ) → Prf (P (s m))) →
             Prf (P (natCase C z s k)))
      (λh0. λh1. h0 ⋆)
      (k' rec. λh0. λh1. h1 k' ⋆)
      n

-- ===== comparison, read off monus =====

def leOfMonusZero : (a : ℕ) (b : ℕ) → (a ∸ b ≡ Z ∈ ℕ) → El (LeN a b)
  using (natMore.monusZeroR, natOrder.LeN.unfold) ≔
  λa.
    ℕ-elim (k. (b : ℕ) → (k ∸ b ≡ Z ∈ ℕ) → El (LeN k b))
      (λb. λh. leZero b)
      (a' ih.
        λb.
          ℕ-elim (m. (S a' ∸ m ≡ Z ∈ ℕ) → El (LeN (S a') m))
            (λh. 𝟘-elim (zNotS a' (sym ℕ (S a') Z h)))
            (b' rec. λh.
              leSucMono a' b'
                (ih b'
                   (trans ℕ (a' ∸ b') (S a' ∸ S b') Z
                      (sym ℕ (S a' ∸ S b') (a' ∸ b') (sucMonusSuc a' b'))
                      h)))
            b)
      a

def ltOfMonusSuc : (a : ℕ) (b : ℕ) (m : ℕ) →
  (a ∸ b ≡ S m ∈ ℕ) → El (LeN (S b) a) using (natOrder.LeN.unfold) ≔
  λa.
    ℕ-elim (k. (b : ℕ) (m : ℕ) → (k ∸ b ≡ S m ∈ ℕ) → El (LeN (S b) k))
      (λb. λm. λh.
        𝟘-elim (zNotS m
          (trans ℕ Z (Z ∸ b) (S m) (sym ℕ (Z ∸ b) Z (zeroMonus b)) h)))
      (a' ih.
        λb.
          ℕ-elim (w. (m : ℕ) → (S a' ∸ w ≡ S m ∈ ℕ) → El (LeN (S w) (S a')))
            (λm. λh. leSucMono Z a' (leZero a'))
            (b' rec. λm. λh.
              leSucMono (S b') a'
                (ih b' m
                   (trans ℕ (a' ∸ b') (S a' ∸ S b') (S m)
                      (sym ℕ (S a' ∸ S b') (a' ∸ b') (sucMonusSuc a' b'))
                      h)))
            b)
      a

-- ===== the fuel decreases =====

-- if a ≤ S f' and b < a then a − (b+1) ≤ f' : peel the successor off
-- both sides of (b+1) + (a − (b+1)) + k ≡ S f'
def fuelStep : (a : ℕ) (b : ℕ) (f' : ℕ) →
  El (LeN a (S f')) → El (LeN (S b) a) → El (LeN (a ∸ S b) f') using (id.Id.unfold, natOrder.LeN.unfold) ≔
  λa. λb. λf'. λle. λlt.
    (b + le .π₁ ,
     eqToId ℕ ((a ∸ S b) + (b + le .π₁)) f'
       (sucInj ((a ∸ S b) + (b + le .π₁)) f'
          (S ((a ∸ S b) + (b + le .π₁))
              ≡⟨ sym ℕ (S ((a ∸ S b) + b) + le .π₁)
                       (S ((a ∸ S b) + (b + le .π₁)))
                   (trans ℕ (S ((a ∸ S b) + b) + le .π₁)
                          (S (((a ∸ S b) + b) + le .π₁))
                          (S ((a ∸ S b) + (b + le .π₁)))
                      (sucPlus ((a ∸ S b) + b) (le .π₁))
                      (cong ℕ (λu. ℕ) (λw. S w)
                         (((a ∸ S b) + b) + le .π₁)
                         ((a ∸ S b) + (b + le .π₁))
                         (plusAssoc (a ∸ S b) b (le .π₁)))) ⟩
            S ((a ∸ S b) + b) + le .π₁
              ≡⟨ cong ℕ (λu. ℕ) (λw. w + le .π₁)
                   (S ((a ∸ S b) + b)) (S b + (a ∸ S b))
                   (trans ℕ (S ((a ∸ S b) + b)) (S (b + (a ∸ S b)))
                          (S b + (a ∸ S b))
                      (cong ℕ (λu. ℕ) (λw. S w)
                         ((a ∸ S b) + b) (b + (a ∸ S b))
                         (plusComm b (a ∸ S b)))
                      (sym ℕ (S b + (a ∸ S b)) (S (b + (a ∸ S b)))
                         (sucPlus b (a ∸ S b)))) ⟩
            (S b + (a ∸ S b)) + le .π₁
              ≡⟨ cong ℕ (λu. ℕ) (λw. w + le .π₁) (S b + (a ∸ S b)) a
                   (leMonusPlus (S b) a lt) ⟩
            a + le .π₁
              ≡⟨ idToEq ℕ (a + le .π₁) (S f') (le .π₂) ⟩
            S f')))

-- ===== division =====

-- dmAux f a b = (q , r) with a ≡ q·(b+1) + r and r ≤ b, whenever a ≤ f
def dmAux : ℕ → ℕ → ℕ → (ℕ ⨯ ℕ) ≔
  λf.
    ℕ-elim (k. ℕ → ℕ → (ℕ ⨯ ℕ))
      (λa. λb. (Z , a))
      (f' ih. λa. λb.
        natCase (ℕ ⨯ ℕ) (Z , a)
          (λm. (S ((ih (a ∸ S b) b) .π₁) , (ih (a ∸ S b) b) .π₂))
          (a ∸ b))
      f

def divN : ℕ → ℕ → ℕ ≔ λa. λb. (dmAux a a b) .π₁
def modN : ℕ → ℕ → ℕ ≔ λa. λb. (dmAux a a b) .π₂

-- ===== the specification =====

def dmAuxEq : (f : ℕ) (a : ℕ) (b : ℕ) → El (LeN a f) →
  a ≡ (dmAux f a b) .π₁ * S b + (dmAux f a b) .π₂ ∈ ℕ
  using (hyp.rw, id.Id.unfold, natDiv.dmAux.eq, natDiv.natCase.eq, natOrder.LeN.unfold, zeroMult, zeroMult.rw, zeroPlusId, zeroPlusId.rw) ≔
  λf.
    ℕ-elim (k. (a : ℕ) (b : ℕ) → El (LeN a k) →
             (a ≡ (dmAux k a b) .π₁ * S b + (dmAux k a b) .π₂ ∈ ℕ))
      (λa. λb. λle. ⋆)
      (f' ih. λa. λb. λle.
        natCaseElimEq (ℕ ⨯ ℕ)
          (λp. (a ≡ p .π₁ * S b + p .π₂ ∈ ℕ))
          (Z , a)
          (λm. (S ((dmAux f' (a ∸ S b) b) .π₁) , (dmAux f' (a ∸ S b) b) .π₂))
          (a ∸ b)
          (λh0. ⋆)
          (λm. λhm.
            trans ℕ a (S b + (a ∸ S b))
                  (S ((dmAux f' (a ∸ S b) b) .π₁) * S b
                     + (dmAux f' (a ∸ S b) b) .π₂)
              (sym ℕ (S b + (a ∸ S b)) a
                 (leMonusPlus (S b) a (ltOfMonusSuc a b m hm)))
              (trans ℕ (S b + (a ∸ S b))
                     (S b + ((dmAux f' (a ∸ S b) b) .π₁ * S b
                               + (dmAux f' (a ∸ S b) b) .π₂))
                     (S ((dmAux f' (a ∸ S b) b) .π₁) * S b
                        + (dmAux f' (a ∸ S b) b) .π₂)
                 (cong ℕ (λu. ℕ) (λw. S b + w) (a ∸ S b)
                    ((dmAux f' (a ∸ S b) b) .π₁ * S b
                       + (dmAux f' (a ∸ S b) b) .π₂)
                    (ih (a ∸ S b) b
                       (fuelStep a b f' le (ltOfMonusSuc a b m hm))))
                 (trans ℕ (S b + ((dmAux f' (a ∸ S b) b) .π₁ * S b
                                    + (dmAux f' (a ∸ S b) b) .π₂))
                        ((S b + (dmAux f' (a ∸ S b) b) .π₁ * S b)
                           + (dmAux f' (a ∸ S b) b) .π₂)
                        (S ((dmAux f' (a ∸ S b) b) .π₁) * S b
                           + (dmAux f' (a ∸ S b) b) .π₂)
                    (sym ℕ ((S b + (dmAux f' (a ∸ S b) b) .π₁ * S b)
                              + (dmAux f' (a ∸ S b) b) .π₂)
                           (S b + ((dmAux f' (a ∸ S b) b) .π₁ * S b
                                     + (dmAux f' (a ∸ S b) b) .π₂))
                       (plusAssoc (S b) ((dmAux f' (a ∸ S b) b) .π₁ * S b)
                                  ((dmAux f' (a ∸ S b) b) .π₂)))
                    (cong ℕ (λu. ℕ) (λw. w + (dmAux f' (a ∸ S b) b) .π₂)
                       (S b + (dmAux f' (a ∸ S b) b) .π₁ * S b)
                       (S ((dmAux f' (a ∸ S b) b) .π₁) * S b)
                       (sym ℕ (S ((dmAux f' (a ∸ S b) b) .π₁) * S b)
                              (S b + (dmAux f' (a ∸ S b) b) .π₁ * S b)
                          (sucMult ((dmAux f' (a ∸ S b) b) .π₁) (S b))))))))
      f

def dmAuxLe : (f : ℕ) (a : ℕ) (b : ℕ) → El (LeN a f) →
  El (LeN ((dmAux f a b) .π₂) b) using (id.Id.eq, id.Id.unfold, natDiv.dmAux.eq, natDiv.natCase.eq, natOrder.LeN.unfold) ≔
  λf.
    ℕ-elim (k. (a : ℕ) (b : ℕ) → El (LeN a k) →
             El (LeN ((dmAux k a b) .π₂) b))
      (λa. λb. λle.
        transport ℕ (λw. LeN w b) Z a (sym ℕ a Z (leZeroInv a le)) (leZero b))
      (f' ih. λa. λb. λle.
        natCaseElimEqD (ℕ ⨯ ℕ)
          (λp. LeN (p .π₂) b)
          (Z , a)
          (λm. (S ((dmAux f' (a ∸ S b) b) .π₁) , (dmAux f' (a ∸ S b) b) .π₂))
          (a ∸ b)
          (λh0. leOfMonusZero a b h0)
          (λm. λhm.
            ih (a ∸ S b) b (fuelStep a b f' le (ltOfMonusSuc a b m hm))))
      f

-- ===== division, specified =====

-- a itself is always enough fuel, so the two halves of the Euclidean
-- specification hold unconditionally
def divModEq : (a : ℕ) (b : ℕ) → a ≡ divN a b * S b + modN a b ∈ ℕ
  using (natDiv.divN.eq, natDiv.dmAux.eq, natDiv.modN.eq) ≔
  λa. λb. dmAuxEq a a b (leRefl a)

def modLe : (a : ℕ) (b : ℕ) → El (LeN (modN a b) b) using (id.Id.eq, natDiv.dmAux.eq, natDiv.modN.eq, natOrder.LeN.unfold) ≔
  λa. λb. dmAuxLe a a b (leRefl a)

-- and it computes: 7 = 3·2 + 1
def divTest : divN (S (S (S (S (S (S (S Z))))))) (S Z) ≡ S (S (S Z)) ∈ ℕ using (natDiv.divN.eq, natDiv.dmAux.eq, natDiv.natCase.eq, natMore.pred.eq, natMore.∸.eq) ≔ ⋆
def modTest : modN (S (S (S (S (S (S (S Z))))))) (S Z) ≡ S Z ∈ ℕ using (natDiv.dmAux.eq, natDiv.modN.eq, natDiv.natCase.eq, natMore.pred.eq, natMore.∸.eq) ≔ ⋆

-- ===== uniqueness of the quotient =====

-- no natural is below its own successor's floor
def leSucNotSelf : (a : ℕ) → El (LeN (S a) a) → 𝟘 using (id.Id.unfold, nat.plusSucId, natOrder.LeN.unfold) ≔
  λa. λle.
    zNotS (le .π₁)
      (sym ℕ (S (le .π₁)) Z
         (plusCancelL a (S (le .π₁)) Z
            (trans ℕ (a + S (le .π₁)) a (a + Z)
               (trans ℕ (a + S (le .π₁)) (S a + le .π₁) a
                  (sym ℕ (S a + le .π₁) (a + S (le .π₁))
                     (trans ℕ (S a + le .π₁) (S (a + le .π₁)) (a + S (le .π₁))
                        (sucPlus a (le .π₁))
                        ⋆))
                  (idToEq ℕ (S a + le .π₁) a (le .π₂)))
               (sym ℕ (a + Z) a (plusZeroId a)))))

-- d·(d'+1) is strictly below (d+1)·(d'+1)
def ltProdSuc : (d : ℕ) (d' : ℕ) →
  El (LeN (S (d * S d')) (S d * S d')) using (nat.plusSucId, natOrder.LeN.unfold) ≔
  λd. λd'.
    (d' ,
     eqToId ℕ (S (d * S d') + d') (S d * S d')
       (trans ℕ (S (d * S d') + d') (d * S d' + S d') (S d * S d')
          (trans ℕ (S (d * S d') + d') (S (d * S d' + d')) (d * S d' + S d')
             (sucPlus (d * S d') d')
             ⋆)
          (trans ℕ (d * S d' + S d') (S d' + d * S d') (S d * S d')
             (plusComm (S d') (d * S d'))
             (sym ℕ (S d * S d') (S d' + d * S d') (sucMult d (S d'))))))

-- the two quotients' common part cancels, leaving the remainders
-- against a whole multiple of (d+1)(d'+1)
def divCancel : (q : ℕ) (r : ℕ) (k : ℕ) (r' : ℕ) (d : ℕ) (d' : ℕ) →
  ((q * S d + r) * S d' ≡ ((q + k) * S d' + r') * S d ∈ ℕ) →
  r * S d' ≡ k * (S d' * S d) + r' * S d ∈ ℕ ≔
  λq. λr. λk. λr'. λd. λd'. λh.
    plusCancelL (q * (S d' * S d)) (r * S d')
                (k * (S d' * S d) + r' * S d)
      (trans ℕ (q * (S d' * S d) + r * S d')
               ((q * S d + r) * S d')
               (q * (S d' * S d) + (k * (S d' * S d) + r' * S d))
         (sym ℕ ((q * S d + r) * S d') (q * (S d' * S d) + r * S d')
            (trans ℕ ((q * S d + r) * S d')
                     (q * S d * S d' + r * S d')
                     (q * (S d' * S d) + r * S d')
               (multDistribR (S d') (q * S d) r)
               (cong ℕ (λu. ℕ) (λw. w + r * S d')
                  (q * S d * S d') (q * (S d' * S d))
                  (trans ℕ (q * S d * S d') (q * (S d * S d'))
                           (q * (S d' * S d))
                     (multAssoc q (S d) (S d'))
                     (cong ℕ (λu. ℕ) (λw. q * w) (S d * S d') (S d' * S d)
                        (multComm (S d') (S d)))))))
         (trans ℕ ((q * S d + r) * S d')
                  (((q + k) * S d' + r') * S d)
                  (q * (S d' * S d) + (k * (S d' * S d) + r' * S d))
            h
            (trans ℕ (((q + k) * S d' + r') * S d)
                     ((q + k) * S d' * S d + r' * S d)
                     (q * (S d' * S d) + (k * (S d' * S d) + r' * S d))
               (multDistribR (S d) ((q + k) * S d') r')
               (trans ℕ ((q + k) * S d' * S d + r' * S d)
                        ((q * (S d' * S d) + k * (S d' * S d)) + r' * S d)
                        (q * (S d' * S d) + (k * (S d' * S d) + r' * S d))
                  (cong ℕ (λu. ℕ) (λw. w + r' * S d)
                     ((q + k) * S d' * S d)
                     (q * (S d' * S d) + k * (S d' * S d))
                     (trans ℕ ((q + k) * S d' * S d)
                              ((q + k) * (S d' * S d))
                              (q * (S d' * S d) + k * (S d' * S d))
                        (multAssoc (q + k) (S d') (S d))
                        (multDistribR (S d' * S d) q k)))
                  (plusAssoc (q * (S d' * S d)) (k * (S d' * S d))
                             (r' * S d))))))

-- ...and that multiple has to be zero: one more copy of (d+1)(d'+1)
-- would already exceed r·(d'+1), which r ≤ d keeps strictly below it
def divKZero : (r : ℕ) (d : ℕ) (r' : ℕ) (d' : ℕ) (k : ℕ) →
  El (LeN r d) →
  (r * S d' ≡ k * (S d' * S d) + r' * S d ∈ ℕ) →
  k ≡ Z ∈ ℕ using (natOrder.LeN.unfold) ≔
  λr. λd. λr'. λd'. λk.
    ℕ-elim (w. El (LeN r d) →
             (r * S d' ≡ w * (S d' * S d) + r' * S d ∈ ℕ) → (w ≡ Z ∈ ℕ))
      (λb. λh. ⋆)
      (k' rec. λb. λh.
        𝟘-elim (leSucNotSelf (d * S d')
          (leTrans (S (d * S d')) (S d * S d') (d * S d')
             (ltProdSuc d d')
             (leTrans (S d * S d') (r * S d') (d * S d')
                (k' * (S d' * S d) + r' * S d ,
                 eqToId ℕ (S d * S d' + (k' * (S d' * S d) + r' * S d))
                          (r * S d')
                   (sym ℕ (r * S d')
                          (S d * S d' + (k' * (S d' * S d) + r' * S d))
                      (trans ℕ (r * S d')
                               (S k' * (S d' * S d) + r' * S d)
                               (S d * S d' + (k' * (S d' * S d) + r' * S d))
                         h
                         (trans ℕ (S k' * (S d' * S d) + r' * S d)
                                  ((S d' * S d + k' * (S d' * S d)) + r' * S d)
                                  (S d * S d' + (k' * (S d' * S d) + r' * S d))
                            (cong ℕ (λu. ℕ) (λw. w + r' * S d)
                               (S k' * (S d' * S d))
                               (S d' * S d + k' * (S d' * S d))
                               (sucMult k' (S d' * S d)))
                            (trans ℕ ((S d' * S d + k' * (S d' * S d)) + r' * S d)
                                     (S d' * S d + (k' * (S d' * S d) + r' * S d))
                                     (S d * S d' + (k' * (S d' * S d) + r' * S d))
                               (plusAssoc (S d' * S d) (k' * (S d' * S d))
                                          (r' * S d))
                               (cong ℕ (λu. ℕ)
                                  (λw. w + (k' * (S d' * S d) + r' * S d))
                                  (S d' * S d) (S d * S d')
                                  (multComm (S d) (S d'))))))))
                (leMultMonoR r d (S d') b)))))
      k

-- ===== equal rationals have equal floors =====

def divNUniqueLe : (m : ℕ) (d : ℕ) (m' : ℕ) (d' : ℕ) →
  (m * S d' ≡ m' * S d ∈ ℕ) →
  El (LeN (divN m d) (divN m' d')) →
  divN m d ≡ divN m' d' ∈ ℕ using (natOrder.LeN.unfold) ≔
  λm. λd. λm'. λd'. λh. λle.
    trans ℕ (divN m d) (divN m d + le .π₁) (divN m' d')
      (sym ℕ (divN m d + le .π₁) (divN m d)
         (trans ℕ (divN m d + le .π₁) (divN m d + Z) (divN m d)
            (cong ℕ (λu. ℕ) (λw. divN m d + w) (le .π₁) Z
               (divKZero (modN m d) d (modN m' d') d' (le .π₁) (modLe m d)
                  (divCancel (divN m d) (modN m d) (le .π₁) (modN m' d') d d'
                     (trans ℕ ((divN m d * S d + modN m d) * S d')
                              (m' * S d)
                              (((divN m d + le .π₁) * S d' + modN m' d') * S d)
                        (trans ℕ ((divN m d * S d + modN m d) * S d')
                                 (m * S d')
                                 (m' * S d)
                           (cong ℕ (λu. ℕ) (λw. w * S d')
                              (divN m d * S d + modN m d) m
                              (sym ℕ m (divN m d * S d + modN m d)
                                 (divModEq m d)))
                           h)
                        (cong ℕ (λu. ℕ) (λw. w * S d)
                           m' ((divN m d + le .π₁) * S d' + modN m' d')
                           (trans ℕ m'
                                    (divN m' d' * S d' + modN m' d')
                                    ((divN m d + le .π₁) * S d' + modN m' d')
                              (divModEq m' d')
                              (cong ℕ (λu. ℕ) (λw. w * S d' + modN m' d')
                                 (divN m' d') (divN m d + le .π₁)
                                 (sym ℕ (divN m d + le .π₁) (divN m' d')
                                    (idToEq ℕ (divN m d + le .π₁) (divN m' d')
                                       (le .π₂))))))))))
            (plusZeroId (divN m d))))
      (idToEq ℕ (divN m d + le .π₁) (divN m' d') (le .π₂))

def divNUnique : (m : ℕ) (d : ℕ) (m' : ℕ) (d' : ℕ) →
  (m * S d' ≡ m' * S d ∈ ℕ) → divN m d ≡ divN m' d' ∈ ℕ ≔
  λm. λd. λm'. λd'. λh.
    ⊎-elim (w. divN m d ≡ divN m' d' ∈ ℕ)
      (le. divNUniqueLe m d m' d' h le)
      (le. sym ℕ (divN m' d') (divN m d)
             (divNUniqueLe m' d' m d (sym ℕ (m * S d') (m' * S d) h) le))
      (leTotal (divN m d) (divN m' d'))

-- a is strictly below (a div (b+1) + 1)·(b+1): the remainder is at
-- most b, so one more divisor overshoots
def leDivSuc : (m : ℕ) (b : ℕ) → El (LeN m (S (divN m b) * S b)) using (natOrder.LeN.unfold) ≔
  λm. λb.
    (S b ∸ modN m b ,
     eqToId ℕ (m + (S b ∸ modN m b)) (S (divN m b) * S b)
       (trans ℕ (m + (S b ∸ modN m b))
                (divN m b * S b + (modN m b + (S b ∸ modN m b)))
                (S (divN m b) * S b)
          (trans ℕ (m + (S b ∸ modN m b))
                   ((divN m b * S b + modN m b) + (S b ∸ modN m b))
                   (divN m b * S b + (modN m b + (S b ∸ modN m b)))
             (cong ℕ (λu. ℕ) (λw. w + (S b ∸ modN m b))
                m (divN m b * S b + modN m b) (divModEq m b))
             (plusAssoc (divN m b * S b) (modN m b) (S b ∸ modN m b)))
          (trans ℕ (divN m b * S b + (modN m b + (S b ∸ modN m b)))
                   (divN m b * S b + S b)
                   (S (divN m b) * S b)
             (cong ℕ (λu. ℕ) (λw. divN m b * S b + w)
                (modN m b + (S b ∸ modN m b)) (S b)
                (leMonusPlus (modN m b) (S b) (leStep (modN m b) b (modLe m b))))
             (trans ℕ (divN m b * S b + S b) (S b + divN m b * S b)
                      (S (divN m b) * S b)
                (plusComm (S b) (divN m b * S b))
                (sym ℕ (S (divN m b) * S b) (S b + divN m b * S b)
                   (sucMult (divN m b) (S b)))))))
