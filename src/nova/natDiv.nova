-- EUCLIDEAN DIVISION on ℕ, by a successor (so the divisor is never
-- zero and no side condition is needed). The recursion is on FUEL —
-- `a ∸ S b` is smaller than `a` but not structurally so — and `a`
-- itself is always enough fuel.
--
-- This is the arithmetic ℚ needs in order to have a CEILING, and the
-- ceiling is what ℝ needs in order to have multiplication: the product
-- of two regular sequences must be sampled at a depth proportional to
-- a bound on both, and a bound has to be a natural, computed from a
-- rational, by a function — i.e. by something the quotient respects.
-- ===== casing on a natural, with the equation in hand =====

import nat (+, *, plusZeroId, plusSucId, zeroPlusId, sucPlus, plusComm, plusAssoc, sucInj, multZeroId, multSucId, zeroMult, sucMult, multComm, multAssoc)
import natOrder (≤, leRefl, leOfEq, leZero, leZeroInv, leSucMono, leTrans, leTotal, leMultMonoR, leStep)
import natMore (∸, pred, plusCancelL, multDistribR, monusZeroR, monusSucR, zeroMonus, sucMonusSuc, plusMonus, monusPlus, monusSelf, monusZeroOfLe, leMonusPlus)
import eqNat (zNotS)
import equality (trans, sym, cong, transport)
import id (Id, idToEq, eqToId)

def natCase : {C : 𝕌} → C → (ℕ → C) → ℕ → C ≔ λC. λz. λs. λn. ℕ-elim z (m rec. s m) n

-- the eliminator for it: each branch may use the equation that put it
-- there, which is what lets a division step know a > b. Two copies,
-- because a motive into Ω and a motive into 𝕌 are different rules and
-- the division spec needs one of each (the quotient equation is a
-- a prop, the remainder bound is data).
def natCaseElimEqD : (C : 𝕌)
  (P : C → 𝕌)
  (z : C)
  (s : ℕ → C)
  (n : ℕ)
  → ((n ≡ Z) → P z) → ((m : ℕ) → (n ≡ S m) → P (s m)) → P (natCase z s n)
  using (natDiv.natCase.eq) ≔
  λC. λP. λz. λs. λn. ℕ-elim (λh0. λh1. h0 ⋆) (k' rec. λh0. λh1. h1 k' ⋆) n

def natCaseElimEq : (C : 𝕌)
  (P : C → Ω)
  (z : C)
  (s : ℕ → C)
  (n : ℕ)
  → ((n ≡ Z) → P z) → ((m : ℕ) → (n ≡ S m) → P (s m)) → P (natCase z s n)
  using (natDiv.natCase.eq) ≔
  λC. λP. λz. λs. λn. ℕ-elim (λh0. λh1. h0 ⋆) (k' rec. λh0. λh1. h1 k' ⋆) n

-- ===== comparison, read off monus =====
def leOfMonusZero : {a b : ℕ} → (a ∸ b ≡ Z) → (a ≤ b)
  using (natMore.monusZeroR, natOrder.≤.unfold) ≔
  λa. ℕ-elim
    (λb. λh. leZero _)
    (a' ih. λb. ℕ-elim
      (λh. 𝟘-elim (zNotS (sym (S a') Z h)))
      (b' rec. λh. leSucMono (ih b' (trans _ _ _ (sym _ _ (sucMonusSuc a' b')) h)))
      b)
    a

def ltOfMonusSuc : {a b : ℕ} (m : ℕ) → (a ∸ b ≡ S m) → (S b ≤ a) using (natOrder.≤.unfold) ≔
  λa. ℕ-elim
    (λb. λm. λh. 𝟘-elim (zNotS (trans _ _ _ (sym _ _ (zeroMonus b)) h)))
    (a' ih. λb. ℕ-elim
      (λm. λh. leSucMono (leZero a'))
      (b' rec. λm. λh. leSucMono (ih b' m (trans _ _ _ (sym _ _ (sucMonusSuc a' b')) h)))
      b)
    a

-- ===== the fuel decreases =====
-- if a ≤ S f' and b < a then a − (b+1) ≤ f' : peel the successor off
-- both sides of (b+1) + (a − (b+1)) + k ≡ S f'
def fuelStep : {a b f' : ℕ} → (a ≤ S f') → (S b ≤ a) → (a ∸ S b ≤ f')
  using (id.Id.unfold, natOrder.≤.unfold) ≔
  λa. λb. λf'. λle. λlt. b
    + le .π₁,
    eqToId
      _
      _
      (sucInj
        (a ∸ S b + (b + le .π₁))
        f'
        (S (a ∸ S b + (b + le .π₁))
            ≡⟨ sym
              _
              _
              (trans
                _
                _
                _
                (sucPlus (a ∸ S b + b) (le .π₁))
                (cong
                  (λu. ℕ)
                  (λw. S w)
                  (plusAssoc (a ∸ S b) b (le .π₁)))) ⟩ S (a ∸ S b + b) + le .π₁
            ≡⟨ cong
              (λu. ℕ)
              (λw. w + le .π₁)
              (trans
                _
                _
                _
                (cong (λu. ℕ) (λw. S w) (plusComm b (a ∸ S b)))
                (sym _ _ (sucPlus b (a ∸ S b)))) ⟩ S b + (a ∸ S b) + le .π₁
            ≡⟨ cong (λu. ℕ) (λw. w + le .π₁) (leMonusPlus lt) ⟩ a + le .π₁
            ≡⟨ idToEq _ _ _ (le .π₂) ⟩ S f'))

-- ===== division =====
-- dmAux f a b = (q , r) with a ≡ q·(b+1) + r and r ≤ b, whenever a ≤ f
def dmAux : ℕ → ℕ → ℕ → ℕ × ℕ ≔
  λf. ℕ-elim
    (λa. λb. Z, a)
    (f' ih. λa. λb. natCase (Z, a) (λm. S (ih (a ∸ S b) b .π₁), ih (a ∸ S b) b .π₂) (a ∸ b))
    f

def divN : ℕ → ℕ → ℕ ≔ λa. λb. dmAux a a b .π₁

def modN : ℕ → ℕ → ℕ ≔ λa. λb. dmAux a a b .π₂

-- ===== the specification =====
def dmAuxEq : {f a b : ℕ} → (a ≤ f) → a ≡ dmAux f a b .π₁ * S b + dmAux f a b .π₂
  using (hyp.rw,
    id.Id.unfold,
    natDiv.dmAux.eq,
    natDiv.natCase.eq,
    natOrder.≤.unfold,
    zeroMult,
    zeroMult.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λf. ℕ-elim
    (λa. λb. λle. ⋆)
    (f' ih. λa. λb. λle. natCaseElimEq
      (ℕ × ℕ)
      (λp. a ≡ p .π₁ * S b + p .π₂)
      (Z, a)
      (λm. S (dmAux f' (a ∸ S b) b .π₁), dmAux f' (a ∸ S b) b .π₂)
      (a ∸ b)
      (λh0. ⋆)
      (λm. λhm. trans
        _
        _
        _
        (sym _ _ (leMonusPlus (ltOfMonusSuc _ hm)))
        (trans
          _
          _
          _
          (cong (λu. ℕ) (λw. S b + w) (ih (a ∸ S b) b (fuelStep le (ltOfMonusSuc _ hm))))
          (trans
            _
            _
            _
            (sym _ _ (plusAssoc (S b) (dmAux f' (a ∸ S b) b .π₁ * S b) (dmAux f' (a ∸ S b) b .π₂)))
            (cong
              (λu. ℕ)
              (λw. w + dmAux f' (a ∸ S b) b .π₂)
              (sym _ _ (sucMult (dmAux f' (a ∸ S b) b .π₁) (S b))))))))
    f

def dmAuxLe : {f a b : ℕ} → (a ≤ f) → (dmAux f a b .π₂ ≤ b)
  using (id.Id.eq, id.Id.unfold, natDiv.dmAux.eq, natDiv.natCase.eq, natOrder.≤.unfold) ≔
  λf. ℕ-elim
    (λa. λb. λle. transport (λw. w ≤ b) (sym _ _ (leZeroInv le)) (leZero b))
    (f' ih. λa. λb. λle. natCaseElimEqD
      (ℕ × ℕ)
      (λp. p .π₂ ≤ b)
      (Z, a)
      (λm. S (dmAux f' (a ∸ S b) b .π₁), dmAux f' (a ∸ S b) b .π₂)
      (a ∸ b)
      (λh0. leOfMonusZero h0)
      (λm. λhm. ih (a ∸ S b) b (fuelStep le (ltOfMonusSuc _ hm))))
    f

-- ===== division, specified =====
-- a itself is always enough fuel, so the two halves of the Euclidean
-- specification hold unconditionally
def divModEq : (a b : ℕ) → a ≡ divN a b * S b + modN a b
  using (natDiv.divN.eq, natDiv.dmAux.eq, natDiv.modN.eq) ≔
  λa. λb. dmAuxEq (leRefl a)

def modLe : (a b : ℕ) → (modN a b ≤ b)
  using (id.Id.eq, natDiv.dmAux.eq, natDiv.modN.eq, natOrder.≤.unfold) ≔
  λa. λb. dmAuxLe (leRefl a)

-- and it computes: 7 = 3·2 + 1
def divTest : divN 7 (S Z) ≡ 3
  using (natDiv.divN.eq, natDiv.dmAux.eq, natDiv.natCase.eq, natMore.pred.eq, natMore.∸.eq) ≔
  ⋆

def modTest : modN 7 (S Z) ≡ S Z
  using (natDiv.dmAux.eq, natDiv.modN.eq, natDiv.natCase.eq, natMore.pred.eq, natMore.∸.eq) ≔
  ⋆

-- ===== uniqueness of the quotient =====
-- no natural is below its own successor's floor
def leSucNotSelf : (a : ℕ) → (S a ≤ a) → 𝟘 using (id.Id.unfold, nat.plusSucId, natOrder.≤.unfold) ≔
  λa. λle. zNotS
    (sym
      _
      _
      (plusCancelL
        _
        _
        _
        (trans
          _
          _
          _
          (trans
            _
            _
            _
            (sym _ _ (trans _ _ (a + S (le .π₁)) (sucPlus a (le .π₁)) ⋆))
            (idToEq _ _ _ (le .π₂)))
          (sym _ _ (plusZeroId a)))))

-- d·(d'+1) is strictly below (d+1)·(d'+1)
def ltProdSuc : (d d' : ℕ) → (S (d * S d') ≤ S d * S d') using (nat.plusSucId, natOrder.≤.unfold) ≔
  λd. λd'. d',
    eqToId
      _
      _
      (trans
        _
        _
        _
        (trans _ _ (d * S d' + S d') (sucPlus (d * S d') d') ⋆)
        (trans _ _ _ (plusComm (S d') (d * S d')) (sym _ _ (sucMult d (S d')))))

-- the two quotients' common part cancels, leaving the remainders
-- against a whole multiple of (d+1)(d'+1)
def divCancel : (q : ℕ)
  {r k r' d d' : ℕ}
  → ((q * S d + r) * S d' ≡ ((q + k) * S d' + r') * S d) → r * S d' ≡ k * (S d' * S d) + r' * S d ≔
  λq. λr. λk. λr'. λd. λd'. λh. plusCancelL
    _
    _
    _
    (trans
      _
      _
      _
      (sym
        _
        _
        (trans
          _
          _
          _
          (multDistribR (S d') (q * S d) r)
          (cong
            (λu. ℕ)
            (λw. w + r * S d')
            (trans
              _
              _
              _
              (multAssoc q (S d) (S d'))
              (cong (λu. ℕ) (λw. q * w) (multComm (S d') (S d)))))))
      (trans
        _
        _
        _
        h
        (trans
          _
          _
          _
          (multDistribR (S d) ((q + k) * S d') r')
          (trans
            _
            _
            _
            (cong
              (λu. ℕ)
              (λw. w + r' * S d)
              (trans _ _ _ (multAssoc (q + k) (S d') (S d)) (multDistribR (S d' * S d) q k)))
            (plusAssoc (q * (S d' * S d)) (k * (S d' * S d)) (r' * S d))))))

-- ...and that multiple has to be zero: one more copy of (d+1)(d'+1)
-- would already exceed r·(d'+1), which r ≤ d keeps strictly below it
def divKZero : (r d r' d' : ℕ) {k : ℕ} → (r ≤ d) → (r * S d' ≡ k * (S d' * S d) + r' * S d) → k ≡ Z
  using (natOrder.≤.unfold) ≔
  λr. λd. λr'. λd'. λk. ℕ-elim
    (λb. λh. ⋆)
    (k' rec. λb. λh. 𝟘-elim (leSucNotSelf
      _
      (leTrans
        _
        _
        _
        (ltProdSuc d d')
        (leTrans
          (S d * S d')
          _
          _
          (k'
            * (S d'
              * S d)
            + r'
              * S d,
            eqToId
              _
              _
              (sym
                _
                _
                (trans
                  _
                  _
                  _
                  h
                  (trans
                    _
                    _
                    _
                    (cong (λu. ℕ) (λw. w + r' * S d) (sucMult k' (S d' * S d)))
                    (trans
                      _
                      _
                      _
                      (plusAssoc (S d' * S d) (k' * (S d' * S d)) (r' * S d))
                      (cong
                        (λu. ℕ)
                        (λw. w + (k' * (S d' * S d) + r' * S d))
                        (multComm (S d) (S d'))))))))
          (leMultMonoR (S d') b)))))
    k

-- ===== equal rationals have equal floors =====
def divNUniqueLe : {m d m' d' : ℕ}
  → (m * S d' ≡ m' * S d) → (divN m d ≤ divN m' d') → divN m d ≡ divN m' d'
  using (natOrder.≤.unfold) ≔
  λm. λd. λm'. λd'. λh. λle. trans
    _
    _
    _
    (sym
      _
      _
      (trans
        _
        _
        _
        (cong
          (λu. ℕ)
          (λw. divN m d + w)
          (divKZero
            _
            _
            _
            _
            (modLe m d)
            (divCancel
              _
              (trans
                _
                _
                _
                (trans _ _ _ (cong (λu. ℕ) (λw. w * S d') (sym _ _ (divModEq m d))) h)
                (cong
                  (λu. ℕ)
                  (λw. w * S d)
                  (trans
                    _
                    _
                    _
                    (divModEq m' d')
                    (cong
                      (λu. ℕ)
                      (λw. w * S d' + modN m' d')
                      (sym _ _ (idToEq _ _ _ (le .π₂))))))))))
        (plusZeroId (divN m d))))
    (idToEq _ _ _ (le .π₂))

def divNUnique : {m d m' d' : ℕ} → (m * S d' ≡ m' * S d) → divN m d ≡ divN m' d' ≔
  λm. λd. λm'. λd'. λh. ⊎-elim
    (le. divNUniqueLe h le)
    (le. sym _ _ (divNUniqueLe (sym _ _ h) le))
    (leTotal (divN m d) (divN m' d'))

-- a is strictly below (a div (b+1) + 1)·(b+1): the remainder is at
-- most b, so one more divisor overshoots
def leDivSuc : (m b : ℕ) → (m ≤ S (divN m b) * S b) using (natOrder.≤.unfold) ≔
  λm. λb. S b
    ∸ modN
      m
      b,
    eqToId
      _
      _
      (trans
        _
        _
        _
        (trans
          _
          _
          _
          (cong (λu. ℕ) (λw. w + (S b ∸ modN m b)) (divModEq m b))
          (plusAssoc (divN m b * S b) (modN m b) (S b ∸ modN m b)))
        (trans
          _
          _
          _
          (cong (λu. ℕ) (λw. divN m b * S b + w) (leMonusPlus (leStep (modLe m b))))
          (trans _ _ _ (plusComm (S b) (divN m b * S b)) (sym _ _ (sucMult (divN m b) (S b))))))
