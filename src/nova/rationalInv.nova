import nat (+, *, zeroMult, multSucId, sucPlus, plusZeroId, zeroPlusId, plusComm, plusAssoc)
import integer (Int, intZero, intOne)
import integerNormalize (normPair)
import integerMul (intMul, intMulOneR, intMulZeroL, classPairEta)
import eqNat (zNotS)
import eqInt (intCanon, intCanonClass, pairEtaG)
import prop (¬, ⊥, impIntro, impApply, absurdP)
import rational (NZ, nzPos, nzNeg, nzToInt, Rat, mkRat, num, den, ratEta, ratZero)
import rationalQ (Q, qcls, qZero, qOne, qMul, qMulInv, NZQ, qOfNzq, nzqInv,
                  clsEqOfRel, dInt)
import equality (trans, sym, cong)

-- Every non-zero rational has an inverse — the classical statement,
-- recovered from the structural one.
--
-- rationalQ.nova's qMulInv inverts elements of NZQ, where BOTH
-- components are structurally non-zero. That is the constructive
-- shape: no function can read a proof of u ≢ 0 (proofs are
-- irrelevant), so inversion cannot be a map out of the non-zero
-- rationals themselves. What CAN be proved is that the two agree
-- propositionally: every u with u ≢ 0 is qOfNzq of some x. The
-- existential lives in Ω as a squash, and squash-elim unpacks it
-- because the goal is itself a proposition.

-- ===== canonical representatives are canonical =====

-- one component of normPair a b is Z; stated as a single equation
-- (a*b ≡ Z in ℕ says exactly "a is Z or b is Z") rather than a
-- disjunction, so the case analysis below stays first-order
def normProdZero : (a : ℕ) (b : ℕ) →
  normPair a b .π₁ * normPair a b .π₂ ≡ Z ∈ ℕ ≔
  λa. ℕ-elim (k. (b : ℕ) → (normPair k b .π₁ * normPair k b .π₂ ≡ Z ∈ ℕ))
        (λb. ⋆)
        (k ih. λb.
          ℕ-elim (j. (normPair (S k) j .π₁ * normPair (S k) j .π₂ ≡ Z ∈ ℕ))
            ⋆
            (j ihb. ih j)
            b)
        a

def intCanonProdZero : (z : El Int) → intCanon z .π₁ * intCanon z .π₂ ≡ Z ∈ ℕ ≔
  λz. quot-elim (w. (intCanon w .π₁ * intCanon w .π₂ ≡ Z ∈ ℕ))
        (p. normProdZero (p .π₁) (p .π₂))
        z

-- ===== a non-zero integer is the image of an NZ =====

-- on a pair with one component Z, non-zeroness leaves exactly the two
-- productive cases; the (Z,Z) case contradicts the hypothesis and the
-- (S,S) case contradicts canonicity
def nzOfPair : (a : ℕ) (b : ℕ) (hab : Prf (a * b ≡ Z ∈ ℕ))
  (hnz : Prf (¬ (class (a , b) ≡ intZero ∈ El Int))) →
  Prf ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ class (a , b) ∈ El Int)∥ ≔
  λa.
    ℕ-elim (k. (b : ℕ) → Prf (k * b ≡ Z ∈ ℕ) →
              Prf (¬ (class (k , b) ≡ intZero ∈ El Int)) →
              Prf ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ class (k , b) ∈ El Int)∥)
      (λb.
        ℕ-elim (j. Prf (Z * j ≡ Z ∈ ℕ) →
                  Prf (¬ (class (Z , j) ≡ intZero ∈ El Int)) →
                  Prf ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ class (Z , j) ∈ El Int)∥)
          (λhab. λhnz.
             absurdP ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ class (Z , Z) ∈ El Int)∥
               (impApply (class (Z , Z) ≡ intZero ∈ El Int) ⊥ hnz ⋆))
          (j ihb. λhab. λhnz. ⋆ (nzNeg j , ⋆))
          b)
      (k ih. λb.
        ℕ-elim (j. Prf (S k * j ≡ Z ∈ ℕ) →
                  Prf (¬ (class (S k , j) ≡ intZero ∈ El Int)) →
                  Prf ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ class (S k , j) ∈ El Int)∥)
          (λhab. λhnz. ⋆ (nzPos k , ⋆))
          (j ihb. λhab. λhnz.
            𝟘-elim (zNotS (k + S k * j)
              (trans ℕ Z (S k * S j) (S (k + S k * j))
                (sym ℕ _ _ hab)
                (trans ℕ (S k * S j) (S k + S k * j) (S (k + S k * j))
                  (multSucId (S k) j)
                  (sucPlus k (S k * j))))))
          b)
      a

-- ¬ introduction/elimination stated AT ¬, so callers never have to
-- convert between ¬ p and p ⊃ ⊥ (the engine handles that conversion
-- badly once the terms get large)
def notIntro : (p : Ω) → (Prf p → Prf ⊥) → Prf (¬ p) ≔ λp. λf. ⋆ f
def notApply : (p : Ω) → Prf (¬ p) → Prf p → Prf ⊥ ≔
  λp. λh. λe. squash-elim h (g. g e)

-- The view, with the representative kept ABSTRACT — and taken as a
-- PAIR, not as two projections. Both matter: inside this lemma every
-- term is a variable, so the class-equation conversions the elaborator
-- performs stay small and their certificates stay kernel-checkable. At
-- the instantiation below the representative is `intCanon z`, a
-- quot-elim spine; a type mentioning `class (intCanon z .π₁ ,
-- intCanon z .π₂)` makes the checker route through the quotient
-- relation and the kernel then refuses the step (the eliminee is not
-- ⇒ᴺ-inferable).
def intNZViewAt : (z : El Int) (p : ℕ ⨯ ℕ)
  (hz : Prf (class p ≡ z ∈ El Int))
  (hab : Prf (p .π₁ * p .π₂ ≡ Z ∈ ℕ))
  (hnz : Prf (¬ (z ≡ intZero ∈ El Int))) →
  Prf ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ z ∈ El Int)∥ ≔
  λz. λp. λhz. λhab. λhnz.
    squash-elim
      (nzOfPair (p .π₁) (p .π₂) hab
        (notIntro (class (p .π₁ , p .π₂) ≡ intZero ∈ El Int) (λe.
          notApply (z ≡ intZero ∈ El Int) hnz
            (trans Int z (class (p .π₁ , p .π₂)) intZero
              (sym Int _ _
                (trans Int (class (p .π₁ , p .π₂)) (class p) z (classPairEta p) hz))
              e))))
      (w. ⋆ (w .π₁ ,
             trans Int (nzToInt (w .π₁)) (class (p .π₁ , p .π₂)) z
               (w .π₂)
               (trans Int (class (p .π₁ , p .π₂)) (class p) z (classPairEta p) hz)))

def intNZView : (z : El Int) (hnz : Prf (¬ (z ≡ intZero ∈ El Int))) →
  Prf ∥(e : El NZ) ⨯ Prf (nzToInt e ≡ z ∈ El Int)∥ ≔
  λz. λhnz. intNZViewAt z (intCanon z) (intCanonClass z) (intCanonProdZero z) hnz

-- ===== transferring non-zeroness to the numerator =====

-- the easy direction of effectivity (el-quot-eq): a zero numerator
-- makes the class zero
def ratZeroOfNumZero : (p : El Rat) (h : Prf (num p ≡ intZero ∈ El Int)) →
  class p ≡ qZero ∈ El Q ≔
  λp. λh.
    clsEqOfRel p ratZero
      (trans Int
        (intMul (num p) (dInt ratZero))
        intZero
        (intMul (num ratZero) (dInt p))
        (trans Int (intMul (num p) (dInt ratZero)) (num p) intZero
          (intMulOneR (num p))
          h)
        (sym Int _ _ (intMulZeroL (dInt p))))

def numNonZero : (p : El Rat) (h : Prf (¬ (class p ≡ qZero ∈ El Q))) →
  Prf (¬ (num p ≡ intZero ∈ El Int)) ≔
  λp. λh. notIntro (num p ≡ intZero ∈ El Int)
            (λe. notApply (class p ≡ qZero ∈ El Q) h (ratZeroOfNumZero p e))

-- ===== every non-zero rational is qOfNzq of something =====

def qNonZeroIsNzq : (u : El Q) (h : Prf (¬ (u ≡ qZero ∈ El Q))) →
  Prf ∥(x : El NZQ) ⨯ Prf (qOfNzq x ≡ u ∈ El Q)∥ ≔
  λu.
    quot-elim (w. Prf (¬ (w ≡ qZero ∈ El Q)) →
                 Prf ∥(x : El NZQ) ⨯ Prf (qOfNzq x ≡ w ∈ El Q)∥)
      (p. λh.
        squash-elim (intNZView (num p) (numNonZero p h))
          (w. ⋆ ((w .π₁ , den p) ,
                 trans Q (class (mkRat (nzToInt (w .π₁)) (den p)))
                         (class (mkRat (num p) (den p)))
                         (class p)
                   (cong Int (λv. Q) (λx. class (mkRat x (den p))) _ _ (w .π₂))
                   (cong Rat (λv. Q) (λt. class t) _ _ (ratEta p)))))
      u

-- ===== the theorem =====

def qInvExists : (u : El Q) (h : Prf (¬ (u ≡ qZero ∈ El Q))) →
  Prf ∥(v : El Q) ⨯ Prf (qMul u v ≡ qOne ∈ El Q)∥ ≔
  λu. λh.
    squash-elim (qNonZeroIsNzq u h)
      (w. ⋆ (qOfNzq (nzqInv (w .π₁)) ,
             trans Q
               (qMul u (qOfNzq (nzqInv (w .π₁))))
               (qMul (qOfNzq (w .π₁)) (qOfNzq (nzqInv (w .π₁))))
               qOne
               (sym Q _ _
                 (cong Q (λv. Q) (λx. qMul x (qOfNzq (nzqInv (w .π₁)))) _ _ (w .π₂)))
               (qMulInv (w .π₁))))
