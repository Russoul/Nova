-- ℚ: rational.nova's Rat quotiented by CROSS-MULTIPLICATION,
-- n₁/d₁ ~ n₂/d₂ iff n₁·d₂ ≡ n₂·d₁ in Int. The relation is stated with
-- integerMul.nova's intMul on the denominators' images under nzToInt;
-- code-quot takes an arbitrary Ω relation, so nothing has to be proved
-- about it up front (it IS an equivalence — denominators are non-zero
-- and Int is a domain — but the quotient does not ask).
-- ===== the bridge from scaling to multiplication =====
-- intScale d z is multiplication by d's image: on representatives the
-- two differ only by a Z*x summand

import nat (+, *, plusZeroId, zeroPlusId, plusComm, plusAssoc, sucPlus, multZeroId, multSucId, zeroMult, sucMult, multComm, multDistrib, multAssoc)
import integer (Int, intZero, intOne, intNeg)
import integerAdd (+, intAddComm, intAddAssoc)
import integerMul (*, intMulComm, intMulAssoc, intMulOneL, intMulOneR, intMulZeroL, intMulZeroR, intMulDistribL, intMulDistribR, intAddCong2, intMulCong2, classCong2, oneMult, intNegNeg, intAddNegR, intMulNegL, pairEta)
import rational (NZ, nzPos, nzNeg, nzOne, nzMul, nzMulComm, nzMulOneL, nzMulOneR, nzToInt, intScale, intScaleOne, Rat, mkRat, num, den, denInt, ratAdd, ratAddComm, ratAddZeroL, ratAddZeroR, ratNeg, ratZero, ratOne, ratEta, half, third)
import eqNat (predEq)
import equality (trans, cong, sym)

def intScaleIsMul : (d : El NZ) (z : El Int) → intScale d z ≡ nzToInt d * z
  using (integer.Int.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integerMul.*.eq,
    plusZeroId.rw,
    rational.NZ.unfold,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    zeroMult.rw,
    zeroPlusId.rw) ≔
  λd. λz. ⊎-elim
    (n. quot-elim (v. intScale (nzPos n) v ≡ nzToInt (nzPos n) * v) (p. ⋆) z)
    (n. quot-elim (v. intScale (nzNeg n) v ≡ nzToInt (nzNeg n) * v) (p. ⋆) z)
    d

-- (m+1)(k+1) = mk + m + k + 1: the magnitude law behind nzMul
-- a + (b + c) ≡ c + (a + b), the rotation strict-mode descent needs
def addRot : (a b c : ℕ) → a + (b + c) ≡ c + (a + b) ≔
  λa. λb. λc. trans _ _ _ _ (sym _ _ _ (plusAssoc a b c)) (plusComm c (a + b))

def sucMulSuc : (m k : ℕ) → S m * S k ≡ S (m * k + m + k) ≔
  λm. λk. S m * S k
      ≡⟨ multSucId (S m) k ⟩ S m + S m * k
      ≡⟨ sucMult m k ⟩ S m + (k + m * k)
      ≡⟨ sucPlus m (k + m * k) ⟩ S (m + (k + m * k))
      ≡⟨ addRot m k (m * k) ⟩ S (m * k + (m + k))
      ≡⟨ plusAssoc (m * k) m k ⟩ S (m * k + m + k)

-- nzToInt is multiplicative
def nzToIntMul : (d e : El NZ) → nzToInt (nzMul d e) ≡ nzToInt d * nzToInt e
  using (integer.Int.eq,
    integerMul.*.eq,
    multZeroId.rw,
    nat.sucPlus,
    plusAssoc,
    plusZeroId.rw,
    rational.NZ.unfold,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    sucMulSuc,
    zeroMult,
    zeroMult.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λd. λe. ⊎-elim
    (m. ⊎-elim (v. nzToInt (nzMul (nzPos m) v) ≡ nzToInt (nzPos m) * nzToInt v) (k. ⋆) (k. ⋆) e)
    (m. ⊎-elim (v. nzToInt (nzMul (nzNeg m) v) ≡ nzToInt (nzNeg m) * nzToInt v) (k. ⋆) (k. ⋆) e)
    d

-- ===== rearranging four-fold products =====
--
-- intMulComm and intMulAssoc are both permutative, so they never
-- rewrite; every rearrangement has to be a chain of explicit
-- congruences. These three build the one permutation the descent
-- needs: swapping the outer two factors of (a·b)·(c·d).
def mulCongL : (x y z : El Int) → (x ≡ y) → x * z ≡ y * z
  using (integer.Int.unfold, integerMul.intMulCong2) ≔
  λx. λy. λz. λh. ⋆

def mulCongR : (x y z : El Int) → (y ≡ z) → x * y ≡ x * z
  using (integer.Int.unfold, integerMul.intMulCong2) ≔
  λx. λy. λz. λh. ⋆

-- x·(y·z) ≡ y·(x·z)
def mulSwapHead : (x y z : El Int) → x * (y * z) ≡ y * (x * z) using (intMulAssoc) ≔
  λx. λy. λz. trans
    _
    _
    _
    _
    (sym _ _ _ (intMulAssoc x y z))
    (trans _ _ _ _ (mulCongL _ _ z (intMulComm x y)) (intMulAssoc y x z))

-- a·(c·d) ≡ d·(c·a)
def mulSwapInner : (a c d : El Int) → a * (c * d) ≡ d * (c * a) ≔
  λa. λc. λd. trans
    _
    _
    _
    _
    (mulSwapHead a c d)
    (trans _ _ _ _ (mulCongR c _ _ (intMulComm a d)) (sym _ _ _ (mulSwapHead d c a)))

-- (a·b)·(c·d) ≡ (d·b)·(c·a)
def mulSwapOuter : (a b c d : El Int) → a * b * (c * d) ≡ d * b * (c * a) ≔
  λa. λb. λc. λd. trans
    _
    _
    _
    _
    (intMulAssoc a b (c * d))
    (trans
      _
      _
      _
      _
      (mulSwapHead a b (c * d))
      (trans
        _
        _
        _
        _
        (mulCongR b _ _ (mulSwapInner a c d))
        (trans _ _ _ _ (mulSwapHead b d (c * a)) (sym _ _ _ (intMulAssoc d b (c * a))))))

-- ===== the quotient =====
def dInt : El Rat → El Int using (integer.Int.unfold) ≔ λp. nzToInt (den p)

def RatR : El Rat → El Rat → Ω ≔ λp. λq. num p * dInt q ≡ num q * dInt p

def Q : 𝕌 ≔ Rat / (x y. RatR x y)

def qcls : El Rat → El Q using (rationalQ.Q.unfold) ≔ λp. class p

-- ½ and 2/4 are the same rational
def qHalfTest : qcls half ≡ qcls (mkRat (class (2, Z)) (nzPos 3))
  using (integer.Int.eq,
    integer.Int.unfold,
    integer.intOne.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.eq,
    rational.den.eq,
    rational.half.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.Q.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ===== well-definedness of addition on ℚ =====
-- the arithmetic heart, stated purely in Int: cross-multiplying the
-- two sums and cancelling. Expand both products by right
-- distributivity; the n₁-terms are the SAME four factors rearranged,
-- and the n₂-terms differ exactly by the hypothesis.
def crossAddWD : {n1 d1 n2 d2 n3 d3 : El Int}
  (h : Prf (n2 * d3 ≡ n3 * d2))
  → (d2 * n1 + d1 * n2) * (d1 * d3) ≡ (d3 * n1 + d1 * n3) * (d1 * d2) ≔
  λn1. λd1. λn2. λd2. λn3. λd3. λh. trans
    _
    _
    _
    _
    (intMulDistribR (d2 * n1) (d1 * n2) (d1 * d3))
    (trans
      _
      _
      _
      _
      (intAddCong2
        _
        _
        _
        _
        (mulSwapOuter d2 n1 d1 d3)
        (trans
          _
          _
          _
          _
          (mulSwapOuter d1 n2 d1 d3)
          (trans
            _
            _
            _
            _
            (mulCongL
              _
              _
              (d1 * d1)
              (trans _ _ _ _ (intMulComm d3 n2) (trans _ _ _ _ h (intMulComm n3 d2))))
            (sym _ _ _ (mulSwapOuter d1 n3 d1 d2)))))
      (sym _ _ _ (intMulDistribR (d3 * n1) (d1 * n3) (d1 * d2))))

-- ratAdd's two components, in intMul form
def ratAddNumMul : (p q : El Rat) → num (ratAdd p q) ≡ dInt q * num p + dInt p * num q
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalQ.dInt.eq) ≔
  λp. λq. intAddCong2 _ _ _ _ (intScaleIsMul (den q) (num p)) (intScaleIsMul (den p) (num q))

def ratAddDenMul : (p q : El Rat) → dInt (ratAdd p q) ≡ dInt p * dInt q
  using (integer.Int.unfold,
    integerAdd.+.eq,
    integerMul.*.eq,
    nzToIntMul,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalQ.dInt.eq) ≔
  λp. λq. nzToIntMul (den p) (den q)

-- the relation instance the inner well-definedness goal reduces to
-- inner well-definedness of ratAdd — explicit trans (a calc chain's
-- steps rewrite inside quot-elim scrutinees, which strict replay
-- rejects; the same route as lemma applications is unconstrained)
def qAddWDInner : (p : El Rat)
  {q q' : El Rat}
  (h : Prf (RatR q q'))
  → num (ratAdd p q) * dInt (ratAdd p q') ≡ num (ratAdd p q') * dInt (ratAdd p q)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold) ≔
  λp. λq. λq'. λh. trans
    _
    _
    _
    _
    (intMulCong2 _ _ _ _ (ratAddNumMul p q) (ratAddDenMul p q'))
    (trans
      Int
      ((dInt q * num p + dInt p * num q) * (dInt p * dInt q'))
      ((dInt q' * num p + dInt p * num q') * (dInt p * dInt q))
      _
      (crossAddWD h)
      (sym _ _ _ (intMulCong2 _ _ _ _ (ratAddNumMul p q') (ratAddDenMul p q))))

-- el-quot-eq: a proof of the relation gives equal classes
def clsEqOfRel : (p q : El Rat) → Prf (RatR p q) → class p ≡ class q ∈ El Q
  using (Q.eq,
    RatR.eq,
    integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.eq,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λp. λq. λh. ⋆

def qAddWDInnerCls : {p q q' : El Rat}
  (h : Prf (RatR q q'))
  → class (ratAdd p q) ≡ class (ratAdd p q') ∈ El Q
  using (integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rational.ratAdd.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λq. λq'. λh. clsEqOfRel _ _ (qAddWDInner p h)

-- the OUTER case needs no new arithmetic: ratAddComm turns it into
-- the inner one with the arguments swapped
def qAddWDOuterCls : {p p' c : El Rat}
  (h : Prf (RatR p p'))
  → class (ratAdd p c) ≡ class (ratAdd p' c) ∈ El Q
  using (rationalQ.Q.unfold) ≔
  λp. λp'. λc. λh. trans
    _
    _
    _
    _
    (cong (λu. Q) (λr. class r) (ratAddComm p c))
    (trans
      Q
      (class (ratAdd c p))
      (class (ratAdd c p'))
      _
      (qAddWDInnerCls h)
      (cong (λu. Q) (λr. class r) (sym _ _ _ (ratAddComm p' c))))

-- ...in the quot-elim shape the elaborator asks for
def qAddWDOuter : (p p' : El Rat)
  (h : Prf (RatR p p'))
  (v : El Q)
  → quot-elim (w. El Q) (x. class (ratAdd p x)) v ≡ quot-elim (x. class (ratAdd p' x)) v
  using (integer.Int.unfold,
    qAddWDInnerCls,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λp. λp'. λh. λv. quot-elim (w. quot-elim (z. El Q)
    (x. class (ratAdd p x))
    w ≡ quot-elim (x. class (ratAdd p' x)) w)
    (c. qAddWDOuterCls h)
    v

infixl 6 +
def + : El Q → El Q → El Q
  using (integer.Int.unfold,
    qAddWDInnerCls,
    qAddWDOuter,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λu. λv. quot-elim (p. quot-elim (q. class (ratAdd p q)) v) u

-- ===== ℚ, at last =====
def qZero : El Q using (rationalQ.Q.unfold) ≔ qcls ratZero

def qOne : El Q using (rationalQ.Q.unfold) ≔ qcls ratOne

-- β: addition on ℚ is ratAdd on representatives
def qAddCls : (p q : El Rat) → qcls p + qcls q ≡ qcls (ratAdd p q)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.ratAdd.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qcls.eq) ≔
  λp. λq. ⋆

-- ½ + ½ = 1. On Rat this was 4/4; the quotient identifies it with 1/1
def qAddHalves : qcls half + qcls half ≡ qOne
  using (clsEqOfRel,
    integer.Int.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.eq,
    rational.den.eq,
    rational.half.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.Q.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.+.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ⅓ + ⅓ = ⅔
def qAddThirds : qcls third + qcls third ≡ qcls (mkRat (class (2, Z)) (nzPos 2))
  using (clsEqOfRel,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intOne.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.eq,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rational.third.eq,
    rationalQ.Q.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.+.eq,
    rationalQ.qcls.eq) ≔
  ⋆

def qAddComm : (u v : El Q) → u + v ≡ v + u
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.ratAdd.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.+.eq) ≔
  λu. λv. quot-elim (p. quot-elim (q. cong (λx. Q) (λr. class r) (ratAddComm p q)) v) u

def qAddZeroL : (u : El Q) → qZero + u ≡ u
  using (integer.Int.unfold,
    integer.intZero.eq,
    integerAdd.+.eq,
    nzMulOneL,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.ratAdd.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.+.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  λu. quot-elim (p. cong (λx. Q) (λr. class r) {ratAdd ratZero p} {p} ratAddZeroL) u

def qAddZeroR : (u : El Q) → u + qZero ≡ u
  using (integer.Int.unfold,
    integer.intZero.eq,
    integerAdd.+.eq,
    nzMulOneR,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.ratAdd.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.+.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  λu. quot-elim (p. cong (λx. Q) (λr. class r) {ratAdd p ratZero} {p} ratAddZeroR) u

-- ===== associativity =====
-- The magnitudes of nzMul associate. Rather than permute the seven
-- monomials of ((mk+m+k)l + (mk+m+k) + l) by hand, go through the
-- SUCCESSORS: S of each side is a product of S m, S k, S l by
-- sucMulSuc, multAssoc equates those, and S is injective (eqNat.nova's
-- predEq).
def magAssoc : {m k l : ℕ}
  → (m * k + m + k) * l + (m * k + m + k) + l ≡ m * (k * l + k + l) + m + (k * l + k + l)
  using (plusAssoc, nat.sucPlus, zeroPlusId) ≔
  λm. λk. λl. predEq
    (Z + ((m * k + m + k) * l + (m * k + m + k) + l))
    (Z + (m * (k * l + k + l) + m + (k * l + k + l)))
    (trans
      _
      (S ((m * k + m + k) * l + (m * k + m + k) + l))
      _
      (S (m * (k * l + k + l) + m + (k * l + k + l)))
      (sym _ _ _ (sucMulSuc (m * k + m + k) l))
      (trans
        _
        _
        _
        _
        (trans
          _
          _
          _
          (S m * (S k * S l))
          (cong (λu. ℕ) (λw. w * S l) (sym _ _ _ (sucMulSuc m k)))
          (multAssoc (S m) (S k) (S l)))
        (trans
          _
          _
          _
          (S (m * (k * l + k + l) + m + (k * l + k + l)))
          (cong (λu. ℕ) (λw. S m * w) (sucMulSuc k l))
          (sucMulSuc m (k * l + k + l)))))

-- eight sign cases, one magnitude law
def nzMulAssoc : (x y z : El NZ) → nzMul (nzMul x y) z ≡ nzMul x (nzMul y z)
  using (magAssoc,
    plusAssoc,
    rational.NZ.unfold,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq) ≔
  λx. λy. λz. ⊎-elim
    (m. ⊎-elim (b. nzMul (nzMul (nzPos m) b) z ≡ nzMul (nzPos m) (nzMul b z))
      (k. ⊎-elim (c. nzMul (nzMul (nzPos m) (nzPos k)) c ≡ nzMul (nzPos m) (nzMul (nzPos k) c))
        (l. cong
          (λu. NZ)
          nzPos
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        (l. cong
          (λu. NZ)
          nzNeg
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        z)
      (k. ⊎-elim (c. nzMul (nzMul (nzPos m) (nzNeg k)) c ≡ nzMul (nzPos m) (nzMul (nzNeg k) c))
        (l. cong
          (λu. NZ)
          nzNeg
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        (l. cong
          (λu. NZ)
          nzPos
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        z)
      y)
    (m. ⊎-elim (b. nzMul (nzMul (nzNeg m) b) z ≡ nzMul (nzNeg m) (nzMul b z))
      (k. ⊎-elim (c. nzMul (nzMul (nzNeg m) (nzPos k)) c ≡ nzMul (nzNeg m) (nzMul (nzPos k) c))
        (l. cong
          (λu. NZ)
          nzNeg
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        (l. cong
          (λu. NZ)
          nzPos
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        z)
      (k. ⊎-elim (c. nzMul (nzMul (nzNeg m) (nzNeg k)) c ≡ nzMul (nzNeg m) (nzMul (nzNeg k) c))
        (l. cong
          (λu. NZ)
          nzPos
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        (l. cong
          (λu. NZ)
          nzNeg
          {(m * k + m + k) * l + (m * k + m + k) + l}
          {m * (k * l + k + l) + m + (k * l + k + l)}
          magAssoc)
        z)
      y)
    x

-- the numerator identity behind associativity, in Int: distribute the
-- outer factor on both sides and match the three monomials
def crossAssocNum : {n1 d1 n2 d2 n3 d3 : El Int}
  → d3 * (d2 * n1 + d1 * n2) + d1 * d2 * n3 ≡ d2 * d3 * n1 + d1 * (d3 * n2 + d2 * n3)
  using (intMulAssoc) ≔
  λn1. λd1. λn2. λd2. λn3. λd3. trans
    _
    _
    _
    _
    (intAddCong2 _ (d1 * d2 * n3) _ (d1 * d2 * n3) (intMulDistribL d3 (d2 * n1) (d1 * n2)) ⋆)
    (trans
      _
      _
      _
      _
      (intAddAssoc (d3 * (d2 * n1)) (d3 * (d1 * n2)) (d1 * d2 * n3))
      (trans
        _
        _
        _
        _
        (intAddCong2
          _
          _
          _
          _
          (trans _ _ _ _ (sym _ _ _ (intMulAssoc d3 d2 n1)) (mulCongL _ _ n1 (intMulComm d3 d2)))
          (intAddCong2 _ _ _ _ (mulSwapHead d3 d1 n2) (intMulAssoc d1 d2 n3)))
        (intAddCong2
          (d2 * d3 * n1)
          _
          (d2 * d3 * n1)
          _
          ⋆
          (sym _ _ _ (intMulDistribL d1 (d3 * n2) (d2 * n3))))))

-- the two composite numerators, expanded into intMul form
def ratAddNumMulL : {p q r : El Rat}
  → num
    (ratAdd (ratAdd p q) r) ≡ dInt r * (dInt q * num p + dInt p * num q) + dInt p * dInt q * num r
  using (intMulAssoc, nzToIntMul) ≔
  λp. λq. λr. trans
    _
    _
    _
    _
    (ratAddNumMul (ratAdd p q) r)
    (intAddCong2
      _
      _
      _
      _
      (intMulCong2 (dInt r) _ (dInt r) _ ⋆ (ratAddNumMul p q))
      (intMulCong2 _ (num r) _ (num r) (ratAddDenMul p q) ⋆))

def ratAddNumMulR : (p q r : El Rat)
  → num
    (ratAdd p (ratAdd q r)) ≡ dInt q * dInt r * num p + dInt p * (dInt r * num q + dInt q * num r)
  using (intMulAssoc, nzToIntMul) ≔
  λp. λq. λr. trans
    _
    _
    _
    _
    (ratAddNumMul p (ratAdd q r))
    (intAddCong2
      _
      _
      _
      _
      (intMulCong2 _ (num p) _ (num p) (ratAddDenMul q r) ⋆)
      (intMulCong2 (dInt p) _ (dInt p) _ ⋆ (ratAddNumMul q r)))

def ratAddAssocNum : {p q r : El Rat} → num (ratAdd (ratAdd p q) r) ≡ num (ratAdd p (ratAdd q r)) ≔
  λp. λq. λr. trans
    _
    _
    _
    _
    ratAddNumMulL
    (trans
      _
      (dInt r * (dInt q * num p + dInt p * num q) + dInt p * dInt q * num r)
      _
      _
      crossAssocNum
      (sym _ _ _ (ratAddNumMulR p q r)))

-- the denominators associate on the nose, by nzMulAssoc
def ratAddAssocDen : {p q r : El Rat} → den (ratAdd (ratAdd p q) r) ≡ den (ratAdd p (ratAdd q r))
  using (integer.Int.unfold,
    integerAdd.+.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq) ≔
  λp. λq. λr. nzMulAssoc (den p) (den q) (den r)

-- so addition is associative already on Rat — no quotient needed
def ratAddAssoc : {p q r : El Rat} → ratAdd (ratAdd p q) r ≡ ratAdd p (ratAdd q r)
  using (integer.Int.unfold, rational.NZ.unfold, rational.Rat.unfold, rational.ratEta) ≔
  λp. λq. λr. trans
    _
    _
    (mkRat (num (ratAdd p (ratAdd q r))) (den (ratAdd (ratAdd p q) r)))
    _
    (cong
      (λu. Rat)
      (λx. mkRat x (den (ratAdd (ratAdd p q) r)))
      {num (ratAdd (ratAdd p q) r)}
      {num (ratAdd p (ratAdd q r))}
      ratAddAssocNum)
    (cong
      (λu. Rat)
      (λd. mkRat (num (ratAdd p (ratAdd q r))) d)
      {den (ratAdd (ratAdd p q) r)}
      {den (ratAdd p (ratAdd q r))}
      ratAddAssocDen)

def qAddAssoc : (u v w : El Q) → u + v + w ≡ u + (v + w)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.ratAdd.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.+.eq) ≔
  λu. λv. λw. quot-elim
    (p. quot-elim
      (q. quot-elim
        (r. cong (λx. Q) (λt. class t) {ratAdd (ratAdd p q) r} {ratAdd p (ratAdd q r)} ratAddAssoc)
        w)
      v)
    u

-- ⅓ + (⅓ + ⅓) = 1, the associated way round
def qAddThirdsAssoc : qcls third + (qcls third + qcls third) ≡ qOne
  using (clsEqOfRel,
    integer.Int.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.eq,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rational.third.eq,
    rationalQ.Q.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.+.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ===== negation: ℚ is a group =====
-- negation respects the relation: (−n₁)·d₁′ ≡ −(n₁·d₁′) ≡ −(n₁′·d₁)
def ratNegWD : {p p' : El Rat}
  (h : Prf (RatR p p'))
  → num (ratNeg p) * dInt (ratNeg p') ≡ num (ratNeg p') * dInt (ratNeg p)
  using (intMulNegL,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rational.ratNeg.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λp'. λh. trans
    _
    _
    (intNeg (num p * dInt p'))
    _
    (intMulNegL (num p) (dInt p'))
    (trans
      _
      _
      _
      (num (ratNeg p') * dInt (ratNeg p))
      (cong (λu. Int) intNeg {num p * dInt p'} {num p' * dInt p} h)
      (sym _ _ _ (intMulNegL (num p') (dInt p))))

def ratNegWDCls : (p p' : El Rat)
  (h : Prf (RatR p p'))
  → class (ratNeg p) ≡ class (ratNeg p') ∈ El Q
  using (intMulNegL,
    integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rational.ratNeg.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λp'. λh. clsEqOfRel _ _ (ratNegWD h)

def qNeg : El Q → El Q
  using (integer.Int.unfold,
    ratNegWDCls,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λu. quot-elim (p. class (ratNeg p)) u

def qNegCls : (p : El Rat) → qNeg (qcls p) ≡ qcls (ratNeg p)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.ratNeg.eq,
    rationalQ.Q.unfold,
    rationalQ.qNeg.eq,
    rationalQ.qcls.eq) ≔
  λp. ⋆

-- p + (−p) has numerator zero: collect the common denominator and use
-- z + (−z) ≡ 0 in Int
def ratAddNegNum : (p : El Rat) → num (ratAdd p (ratNeg p)) ≡ intZero
  using (intAddNegR,
    intMulZeroR,
    integer.Int.unfold,
    integer.intNeg.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rational.ratNeg.eq,
    rationalQ.dInt.eq) ≔
  λp. trans
    _
    _
    (dInt p * num p + dInt p * intNeg (num p))
    _
    (ratAddNumMul p (ratNeg p))
    (trans
      _
      _
      _
      _
      (sym _ _ _ (intMulDistribL (dInt p) (num p) (intNeg (num p))))
      (trans _ _ _ intZero (mulCongR (dInt p) _ _ (intAddNegR (num p))) intMulZeroR))

-- ...so p + (−p) is 0/(d²), which the quotient identifies with 0/1.
-- This is the first law that is NOT already true on Rat.
def ratAddNegRel : (p : El Rat)
  → num (ratAdd p (ratNeg p)) * dInt ratZero ≡ num ratZero * dInt (ratAdd p (ratNeg p))
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    ratAddNegNum,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.dInt.eq) ≔
  λp. trans
    _
    _
    _
    _
    (trans _ _ _ _ (mulCongL _ _ (dInt ratZero) (ratAddNegNum p)) (intMulZeroL (dInt ratZero)))
    (sym _ _ _ (intMulZeroL (dInt (ratAdd p (ratNeg p)))))

def qAddNegR : (u : El Q) → u + qNeg u ≡ qZero
  using (integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    integerMul.*.eq,
    ratAddNegNum,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  λu. quot-elim (p. clsEqOfRel (ratAdd p (ratNeg p)) ratZero (ratAddNegRel p)) u

def qAddNegL : (u : El Q) → qNeg u + u ≡ qZero using (qAddNegR) ≔
  λu. trans _ _ _ _ (qAddComm (qNeg u) u) (qAddNegR u)

-- negation is involutive, and ½ − ⅓ = ⅙
def qNegNeg : (u : El Q) → qNeg (qNeg u) ≡ u
  using (intNegNeg,
    integer.Int.unfold,
    integer.intNeg.eq,
    ratEta,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.ratNeg.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.qNeg.eq) ≔
  λu. quot-elim
    (p. cong
      (λx. Q)
      (λt. class t)
      (trans _ _ _ p (cong (λu2. Rat) (λx. mkRat x (den p)) (intNegNeg (num p))) ratEta))
    u

def qHalfMinusThird : qcls half + qNeg (qcls third) ≡ qcls (mkRat intOne (nzPos 5))
  using (integer.Int.eq,
    integer.intNeg.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.eq,
    rational.den.eq,
    rational.half.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rational.third.eq,
    rationalQ.Q.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ===== multiplication =====
def ratMul : El Rat → El Rat → El Rat using (rational.Rat.unfold) ≔
  λp. λq. mkRat (num p * num q) (nzMul (den p) (den q))

-- like addition, multiplication is already commutative and
-- associative on Rat, and 1/1 is already a unit there
def ratMulComm : (p q : El Rat) → ratMul p q ≡ ratMul q p
  using (integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. trans
    _
    _
    (mkRat (num q * num p) (nzMul (den p) (den q)))
    _
    (cong (λu. Rat) (λx. mkRat x (nzMul (den p) (den q))) (intMulComm (num p) (num q)))
    (cong
      (λu. Rat)
      (λd. mkRat (num q * num p) d)
      {nzMul (den p) (den q)}
      {nzMul (den q) (den p)}
      nzMulComm)

def ratMulAssoc : {p q r : El Rat} → ratMul (ratMul p q) r ≡ ratMul p (ratMul q r)
  using (intMulAssoc,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. λr. trans
    _
    _
    (mkRat (num p * (num q * num r)) (nzMul (nzMul (den p) (den q)) (den r)))
    _
    (cong
      (λu. Rat)
      (λx. mkRat x (nzMul (nzMul (den p) (den q)) (den r)))
      (intMulAssoc (num p) (num q) (num r)))
    (cong (λu. Rat) (λd. mkRat (num p * (num q * num r)) d) (nzMulAssoc (den p) (den q) (den r)))

def ratMulOneR : {p : El Rat} → ratMul p ratOne ≡ p
  using (intMulOneR,
    integer.Int.unfold,
    integer.intOne.eq,
    integerMul.*.eq,
    nzMulOneR,
    ratEta,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.ratMul.eq) ≔
  λp. trans
    _
    _
    _
    _
    (trans
      _
      (ratMul p ratOne)
      (mkRat (num p) (nzMul (den p) nzOne))
      _
      (cong (λu. Rat) (λx. mkRat x (nzMul (den p) nzOne)) (intMulOneR (num p)))
      (cong (λu. Rat) (λd. mkRat (num p) d) {nzMul (den p) nzOne} {den p} nzMulOneR))
    ratEta

-- d₃·n₂ ≡ d₂·n₃, the relatedness hypothesis with both products
-- commuted; it comes up in every well-definedness proof
def relFlip : (n2 d2 n3 d3 : El Int) (h : Prf (n2 * d3 ≡ n3 * d2)) → d3 * n2 ≡ d2 * n3 ≔
  λn2. λd2. λn3. λd3. λh. trans _ _ _ _ (intMulComm d3 n2) (trans _ _ _ _ h (intMulComm n3 d2))

-- inner well-definedness of ratMul — explicit trans (see qAddWDInner:
-- strict replay rejects chain steps under quot-elim scrutinees)
def qMulWDInner : (p : El Rat)
  {q q' : El Rat}
  (h : Prf (RatR q q'))
  → num (ratMul p q) * dInt (ratMul p q') ≡ num (ratMul p q') * dInt (ratMul p q)
  using (integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. λq'. λh. trans
    _
    _
    (num p * num q * (dInt p * dInt q'))
    _
    (mulCongR (num p * num q) (dInt (ratMul p q')) (dInt p * dInt q') (nzToIntMul (den p) (den q')))
    (trans
      _
      _
      _
      _
      (mulSwapOuter (num p) (num q) (dInt p) (dInt q'))
      (trans
        _
        _
        _
        _
        (mulCongL _ _ (dInt p * num p) (relFlip (num q) (dInt q) (num q') (dInt q') h))
        (trans
          _
          _
          _
          _
          (sym _ _ _ (mulSwapOuter (num p) (num q') (dInt p) (dInt q)))
          (sym
            _
            (num (ratMul p q') * dInt (ratMul p q))
            (num p * num q' * (dInt p * dInt q))
            (mulCongR
              (num p * num q')
              (dInt (ratMul p q))
              (dInt p * dInt q)
              (nzToIntMul (den p) (den q)))))))

def qMulWDInnerCls : {p q q' : El Rat}
  (h : Prf (RatR q q'))
  → class (ratMul p q) ≡ class (ratMul p q') ∈ El Q
  using (integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. λq'. λh. clsEqOfRel _ _ (qMulWDInner p h)

def qMulWDOuterCls : {p p' c : El Rat}
  (h : Prf (RatR p p'))
  → class (ratMul p c) ≡ class (ratMul p' c) ∈ El Q
  using (rationalQ.Q.unfold) ≔
  λp. λp'. λc. λh. trans
    _
    _
    _
    _
    (cong (λu. Q) (λr. class r) (ratMulComm p c))
    (trans
      Q
      (class (ratMul c p))
      (class (ratMul c p'))
      _
      (qMulWDInnerCls h)
      (cong (λu. Q) (λr. class r) (sym _ _ _ (ratMulComm p' c))))

def qMulWDOuter : (p p' : El Rat)
  (h : Prf (RatR p p'))
  (v : El Q)
  → quot-elim (w. El Q) (x. class (ratMul p x)) v ≡ quot-elim (x. class (ratMul p' x)) v
  using (integer.Int.unfold,
    qMulWDInnerCls,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λp. λp'. λh. λv. quot-elim (w. quot-elim (z. El Q)
    (x. class (ratMul p x))
    w ≡ quot-elim (x. class (ratMul p' x)) w)
    (c. qMulWDOuterCls h)
    v

infixl 7 *
def * : El Q → El Q → El Q
  using (integer.Int.unfold,
    qMulWDInnerCls,
    qMulWDOuter,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λu. λv. quot-elim (p. quot-elim (q. class (ratMul p q)) v) u

def qMulCls : (p q : El Rat) → qcls p * qcls q ≡ qcls (ratMul p q)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.*.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. ⋆

def qMulComm : (u v : El Q) → u * v ≡ v * u
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.*.eq,
    rationalQ.ratMul.eq) ≔
  λu. λv. quot-elim (p. quot-elim (q. cong (λx. Q) (λt. class t) (ratMulComm p q)) v) u

def qMulAssoc : (u v w : El Q) → u * v * w ≡ u * (v * w)
  using (intMulAssoc,
    integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.*.eq,
    rationalQ.ratMul.eq) ≔
  λu. λv. λw. quot-elim
    (p. quot-elim
      (q. quot-elim
        (r. cong (λx. Q) (λt. class t) {ratMul (ratMul p q) r} {ratMul p (ratMul q r)} ratMulAssoc)
        w)
      v)
    u

def qMulOneR : (u : El Q) → u * qOne ≡ u
  using (intMulOneR,
    integer.Int.unfold,
    integer.intOne.eq,
    integerMul.*.eq,
    nzMulOneR,
    ratEta,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.*.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq) ≔
  λu. quot-elim (p. cong (λx. Q) (λt. class t) {ratMul p ratOne} {p} ratMulOneR) u

def qMulOneL : (u : El Q) → qOne * u ≡ u using (qMulOneR) ≔
  λu. trans _ _ _ _ (qMulComm qOne u) (qMulOneR u)

-- ⅓ · ½ = ⅙
def qMulTest : qcls third * qcls half ≡ qcls (mkRat intOne (nzPos 5))
  using (integer.intOne.eq,
    integerMul.*.eq,
    nat.*.eq,
    nat.+.eq,
    rational.den.eq,
    rational.half.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzPos.eq,
    rational.third.eq,
    rationalQ.Q.unfold,
    rationalQ.*.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq) ≔
  ⋆

-- ===== distributivity =====
--
-- The first law that needs the quotient for its DENOMINATOR: p·(q+r)
-- has denominator d₁d₂d₃ while p·q + p·r has d₁²d₂d₃. Both numerator
-- and denominator of the right-hand side are the left-hand side's,
-- scaled by d₁ — so the cross-multiplication relation collapses to
-- moving that one factor across.
-- (a·b)·(c·d) ≡ a·(c·(b·d))
def mulHoist : (a b c d : El Int) → a * b * (c * d) ≡ a * (c * (b * d)) ≔
  λa. λb. λc. λd. trans _ _ _ _ (intMulAssoc a b (c * d)) (mulCongR a _ _ (mulSwapHead b c d))

-- x·(a·y) ≡ (a·x)·y
def mulShiftL : {x a y : El Int} → x * (a * y) ≡ a * x * y using (intMulAssoc) ≔
  λx. λa. λy. trans _ _ _ _ (sym _ _ _ (intMulAssoc x a y)) (mulCongL _ _ y (intMulComm x a))

-- dInt of the product-of-sums denominator, expanded
def dIntMul3 : (p q r : El Rat) → dInt (ratMul p (ratAdd q r)) ≡ dInt p * (dInt q * dInt r)
  using (integer.Int.unfold,
    integerAdd.+.eq,
    integerMul.*.eq,
    nzToIntMul,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. λr. trans
    _
    _
    (dInt p * dInt (ratAdd q r))
    _
    (nzToIntMul (den p) (nzMul (den q) (den r)))
    (mulCongR (dInt p) (dInt (ratAdd q r)) (dInt q * dInt r) (nzToIntMul (den q) (den r)))

def distribDen : (p q r : El Rat)
  → dInt (ratAdd (ratMul p q) (ratMul p r)) ≡ dInt p * dInt (ratMul p (ratAdd q r))
  using (integer.Int.unfold,
    integerAdd.+.eq,
    integerMul.*.eq,
    nzToIntMul,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. λr. trans
    _
    _
    _
    _
    (trans
      _
      (dInt (ratAdd (ratMul p q) (ratMul p r)))
      (dInt (ratMul p q) * dInt (ratMul p r))
      (dInt p * dInt q * (dInt p * dInt r))
      (nzToIntMul (nzMul (den p) (den q)) (nzMul (den p) (den r)))
      (intMulCong2 _ _ _ _ (nzToIntMul (den p) (den q)) (nzToIntMul (den p) (den r))))
    (trans
      _
      _
      _
      _
      (mulHoist (dInt p) (dInt q) (dInt p) (dInt r))
      (mulCongR (dInt p) _ _ (sym _ _ _ (dIntMul3 p q r))))

-- six joins, midpoints once, congruences spelled, explicit trans
-- (see qAddWDInner: strict replay rejects chain steps under quot-elim
-- scrutinees); sym supplies the orientations the chain engine used
-- to pick silently
def distribNum : (p q r : El Rat)
  → num (ratAdd (ratMul p q) (ratMul p r)) ≡ dInt p * num (ratMul p (ratAdd q r))
  using (integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. λq. λr. trans
    _
    _
    _
    _
    (ratAddNumMul (ratMul p q) (ratMul p r))
    (trans
      _
      _
      _
      _
      (intAddCong2
        (dInt (ratMul p r) * num (ratMul p q))
        (dInt (ratMul p q) * num (ratMul p r))
        (dInt p * dInt r * (num p * num q))
        (dInt p * dInt q * (num p * num r))
        (mulCongL
          (dInt (ratMul p r))
          (dInt p * dInt r)
          (num p * num q)
          (nzToIntMul (den p) (den r)))
        (mulCongL
          (dInt (ratMul p q))
          (dInt p * dInt q)
          (num p * num r)
          (nzToIntMul (den p) (den q))))
      (trans
        _
        _
        _
        _
        (intAddCong2
          _
          _
          _
          _
          (mulHoist (dInt p) (dInt r) (num p) (num q))
          (mulHoist (dInt p) (dInt q) (num p) (num r)))
        (trans
          _
          _
          _
          _
          (sym
            _
            _
            _
            (intMulDistribL (dInt p) (num p * (dInt r * num q)) (num p * (dInt q * num r))))
          (trans
            _
            _
            _
            _
            (sym
              _
              _
              _
              (mulCongR (dInt p) _ _ (intMulDistribL (num p) (dInt r * num q) (dInt q * num r))))
            (sym
              _
              (dInt p * num (ratMul p (ratAdd q r)))
              (dInt p * (num p * (dInt r * num q + dInt q * num r)))
              (mulCongR (dInt p) _ _ (mulCongR (num p) _ _ (ratAddNumMul q r))))))))

def qDistribRel : (p q r : El Rat)
  → num
    (ratMul
      p
      (ratAdd
        q
        r))
    * dInt
      (ratAdd
        (ratMul p q)
        (ratMul p r)) ≡ num (ratAdd (ratMul p q) (ratMul p r)) * dInt (ratMul p (ratAdd q r))
  using (distribNum) ≔
  λp. λq. λr. trans
    _
    _
    _
    _
    (mulCongR (num (ratMul p (ratAdd q r))) _ _ (distribDen p q r))
    (trans
      _
      (num (ratMul p (ratAdd q r)) * (dInt p * dInt (ratMul p (ratAdd q r))))
      _
      _
      mulShiftL
      (mulCongL _ _ (dInt (ratMul p (ratAdd q r))) (sym _ _ _ (distribNum p q r))))

def qDistribL : (u v w : El Q) → u * (v + w) ≡ u * v + u * w
  using (distribNum,
    integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rational.ratAdd.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.+.eq,
    rationalQ.*.eq,
    rationalQ.ratMul.eq) ≔
  λu. λv. λw. quot-elim
    (p. quot-elim
      (q. quot-elim
        (r. clsEqOfRel
          (ratMul p (ratAdd q r))
          (ratAdd (ratMul p q) (ratMul p r))
          (qDistribRel p q r))
        w)
      v)
    u

def qDistribR : (u v w : El Q) → (v + w) * u ≡ v * u + w * u ≔
  λu. λv. λw. trans
    _
    _
    _
    _
    (qMulComm (v + w) u)
    (trans
      _
      _
      _
      _
      (qDistribL u v w)
      (trans
        _
        _
        _
        (v * u + w * u)
        (cong (λx. Q) (λx. x + u * w) (qMulComm u v))
        (cong (λx. Q) (λx. v * u + x) (qMulComm u w))))

-- ===== zero and reciprocals =====
-- 0 · u = 0. On Rat this is 0/d, which only the quotient identifies
-- with 0/1
def ratMulZeroRel : (p : El Rat)
  → num (ratMul ratZero p) * dInt ratZero ≡ num ratZero * dInt (ratMul ratZero p)
  using (intMulZeroL,
    integer.Int.unfold,
    integer.intZero.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. trans
    _
    _
    _
    _
    (trans
      _
      _
      _
      _
      (mulCongL (num (ratMul ratZero p)) intZero (dInt ratZero) (intMulZeroL (num p)))
      (intMulZeroL (dInt ratZero)))
    (sym _ _ _ (intMulZeroL (dInt (ratMul ratZero p))))

def qMulZeroL : {u : El Q} → qZero * u ≡ qZero
  using (intMulZeroL,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    integerMul.*.eq,
    nzMulOneL,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.*.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq) ≔
  λu. quot-elim (p. clsEqOfRel (ratMul ratZero p) ratZero (ratMulZeroRel p)) u

def qMulZeroR : (u : El Q) → u * qZero ≡ qZero using (qMulZeroL) ≔
  λu. trans _ _ _ _ (qMulComm u qZero) qMulZeroL

-- Reciprocals. A rational has an inverse exactly when its NUMERATOR is
-- non-zero, and — as with denominators — that cannot be carried as a
-- proof: Prf has no 𝕌-code, realizers are irrelevant, so no function
-- could dispatch on such a proof to build the inverse. So the non-zero
-- rationals get their own code, with BOTH components drawn from NZ;
-- inversion is then total, and is just the swap.
def NZQ : 𝕌 ≔ NZ ⨯ NZ

def nzqToRat : El NZQ → El Rat using (rational.Rat.unfold, rationalQ.NZQ.unfold) ≔
  λx. mkRat (nzToInt (x .π₁)) (x .π₂)

def qOfNzq : El NZQ → El Q using (rationalQ.Q.unfold) ≔ λx. qcls (nzqToRat x)

def nzqInv : El NZQ → El NZQ using (rationalQ.NZQ.unfold) ≔ λx. x .π₂, x .π₁

def nzqInvInv : (x : El NZQ) → nzqInv (nzqInv x) ≡ x
  using (rational.NZ.unfold, rationalQ.NZQ.unfold, rationalQ.nzqInv.eq) ≔
  λx. pairEta NZ NZ x

-- x · x⁻¹ = 1: the product is (N·D)/(d·n), and cross-multiplying
-- against 1/1 leaves exactly N·D ≡ D·N
def nzqInvRel : (x : El NZQ)
  → num
    (ratMul
      (nzqToRat x)
      (nzqToRat
        (nzqInv x))) * dInt ratOne ≡ num ratOne * dInt (ratMul (nzqToRat x) (nzqToRat (nzqInv x)))
  using (integer.intOne.eq,
    integerMul.*.eq,
    nzToIntMul,
    rational.NZ.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.NZQ.unfold,
    rationalQ.dInt.eq,
    rationalQ.nzqInv.eq,
    rationalQ.nzqToRat.eq,
    rationalQ.ratMul.eq) ≔
  λx. trans
    _
    _
    (nzToInt (x .π₁) * nzToInt (x .π₂))
    _
    (intMulOneR (nzToInt (x .π₁) * nzToInt (x .π₂)))
    (trans
      _
      _
      _
      _
      (intMulComm (nzToInt (x .π₁)) (nzToInt (x .π₂)))
      (trans
        _
        (nzToInt (x .π₂) * nzToInt (x .π₁))
        (dInt (ratMul (nzqToRat x) (nzqToRat (nzqInv x))))
        (num ratOne * dInt (ratMul (nzqToRat x) (nzqToRat (nzqInv x))))
        (sym _ _ _ (nzToIntMul (x .π₂) (x .π₁)))
        (sym _ _ _ (intMulOneL (dInt (ratMul (nzqToRat x) (nzqToRat (nzqInv x))))))))

def qMulInv : {x : El NZQ} → qOfNzq x * qOfNzq (nzqInv x) ≡ qOne
  using (integer.Int.eq,
    integer.intOne.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.NZQ.unfold,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.nzqInv.eq,
    rationalQ.nzqToRat.eq,
    rationalQ.*.eq,
    rationalQ.qOfNzq.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq) ≔
  λx. clsEqOfRel (ratMul (nzqToRat x) (nzqToRat (nzqInv x))) ratOne (nzqInvRel x)

def qMulInvL : (x : El NZQ) → qOfNzq (nzqInv x) * qOfNzq x ≡ qOne ≔
  λx. trans _ _ _ _ (qMulComm (qOfNzq (nzqInv x)) (qOfNzq x)) qMulInv

-- ⅓ as a non-zero rational, and 3 = (⅓)⁻¹
def nzqThird : El NZQ using (rationalQ.NZQ.unfold) ≔ nzPos Z, nzPos 2

def nzqThirdIsThird : qOfNzq nzqThird ≡ qcls third
  using (integer.intOne.eq,
    rational.mkRat.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.third.eq,
    rationalQ.Q.unfold,
    rationalQ.nzqThird.eq,
    rationalQ.nzqToRat.eq,
    rationalQ.qOfNzq.eq,
    rationalQ.qcls.eq) ≔
  ⋆

def nzqInvThird : qOfNzq (nzqInv nzqThird) ≡ qcls (mkRat (class (3, Z)) nzOne)
  using (integer.Int.unfold,
    rational.mkRat.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.Q.unfold,
    rationalQ.nzqInv.eq,
    rationalQ.nzqThird.eq,
    rationalQ.nzqToRat.eq,
    rationalQ.qOfNzq.eq,
    rationalQ.qcls.eq) ≔
  ⋆

def qMulInvThird : qOfNzq nzqThird * qOfNzq (nzqInv nzqThird) ≡ qOne
  using (clsEqOfRel, rationalQ.Q.unfold, rationalQ.qMulInv) ≔
  ⋆
