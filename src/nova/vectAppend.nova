import nat (plus, plusZeroId, zeroPlusId, sucPlus)
import vect (vect)

def vappend : (n : ℕ) → (A : 𝕌) → (m : ℕ) → El (vect n A) → El (vect m A) → El (vect (plus n m) A) ≔
  λn. λA. λm.
    ℕ-elim (k. El (vect k A) → El (vect m A) → El (vect (plus k m) A))
      (λv. λw. w)
      (k ih. λv. λw. (v .π₁ , ih (v .π₂) w))
      n

def vappendZ : (A : 𝕌) (n : ℕ) (v : El (vect Z A)) (w : El (vect n A)) → vappend Z A n v w ≡ w ∈ El (vect n A) ≔ λA. λn. λv. λw. Refl
def vappendS : (n : ℕ) (A : 𝕌) (m : ℕ) (v : El (vect (S n) A)) (w : El (vect m A)) →
  vappend (S n) A m v w ≡ (v .π₁ , vappend n A m (v .π₂) w) ∈ El (vect (plus (S n) m) A) ≔
  λn. λA. λm. λv. λw. Refl
