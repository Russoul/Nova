-- The quotient, SUBSUMED GENERICALLY (docs/NovaFoundation.txt,
-- IDENTITY note): the signature for A / R over its full ambient
-- Γ = [a : 𝕌][r : a → a → Ω] — an arbitrary carrier and an
-- arbitrary Ω-valued relation, cls x ≡ cls y imposed under Prf (r x y).

data [a : 𝕌] [r : a → a → Ω] ( Q : U
     ; cls : a → El Q
     ; qeq : (x : a) (y : a) → Prf (r x y) → cls x ≡ cls y ∈ El Q )

-- the GENERIC QUOTIENT LIFT: a function out of the quotient, from a
-- function on the carrier plus a respect proof — quot-elim's f/f⁼ at
-- full generality. Coherences are hypotheses, so the coherence
-- argument IS the caller's respect proof, passed straight through.
def qlift : (a : 𝕌)
  (r : a → a → Ω)
  {b : 𝕌}
  (f : a → b)
  (resp : (x y : a) → Prf (r x y) → f x ≡ f y)
  → Q _ r → b
  using (qiitQuot.Q.unfold) ≔
  λa. λr. λb. λf. λresp. λq. QElim a r (λw. b) (λx. f x) (λx. λy. λh. resp x y h) q

def qliftBeta : (a : 𝕌)
  (r : a → a → Ω)
  (b : 𝕌)
  (f : a → b)
  (resp : (x y : a) → Prf (r x y) → f x ≡ f y)
  (x : a)
  → qlift _ (λy. λz. r y z) f resp (cls a r x) ≡ f x
  using (qiitQuot.Q.eq, qiitQuot.QElim.eq, qiitQuot.cls.eq, qiitQuot.qlift.eq) ≔
  λa. λr. λb. λf. λresp. λx. ⋆

-- instance: ℕ quotiented by squashed equality; toNat is one qlift
def eqN : ℕ → ℕ → Ω ≔ λx. λy. x ≡ y

def toNat : Q _ eqN → ℕ using (qiitQuot.Q.unfold, qiitQuot.eqN.unfold) ≔
  λq. qlift _ _ (λx. x) (λx. λy. λh. ⋆) q

def toNatCls : toNat (cls ℕ eqN (S Z)) ≡ S Z
  using (qiitQuot.Q.eq,
    qiitQuot.QElim.eq,
    qiitQuot.cls.eq,
    qiitQuot.eqN.eq,
    qiitQuot.qlift.eq,
    qiitQuot.toNat.eq) ≔
  ⋆
