-- Rationals over integer.nova's Int, with a STRUCTURALLY non-zero
-- denominator.
--
-- Why not `(d : El Int) ⨯ Prf (d ≢ 0)`: Prf has no 𝕌-code (there is no
-- code for Ω or for Prf p in 𝕌 — NovaFoundation.txt's Ω section says
-- so outright), so a Σ carrying a proof cannot be a code and Rat would
-- be a large `type`: no El Rat, no generic (A : 𝕌) combinators, no use
-- as a code anywhere. Worse, it would be practically uninhabited —
-- writing ½ needs a proof of an Int DISEQUALITY. (When this was
-- written nothing inverted el-quot-eq at all; intEffective.nova now
-- gives IntR back from a class equation, so the disequality is cheap —
-- but the encoding below is still the one that keeps Rat a 𝕌-code.)
--
-- So the denominator ranges over NZ, whose elements ARE the non-zero
-- integers by construction: inj₁ n and inj₂ n denote +(n+1) and
-- -(n+1). Everything stays small, elements are free, and nzToInt
-- embeds NZ back into Int.
-- ===== the non-zero integers =====

import nat (+, *, plusZeroId, zeroPlusId, plusComm, plusAssoc, swapLeft, multZeroId, zeroMult, sucMult, multComm, multDistrib)
import integer (Int, intZero, intOne, intNeg)
import integerAdd (+, intAddComm)
import equality (trans, cong)

def NZ : 𝕌 ≔ ℕ ⊎ ℕ

-- +(n+1)
def nzPos : ℕ → El NZ using (rational.NZ.unfold) ≔ λn. inj₁ n

-- -(n+1)
def nzNeg : ℕ → El NZ using (rational.NZ.unfold) ≔ λn. inj₂ n

def nzOne : El NZ using (rational.NZ.unfold) ≔ nzPos Z

def nzToInt : El NZ → El Int using (integer.Int.unfold, rational.NZ.unfold) ≔
  λd. ⊎-elim (n. class (S n, Z)) (n. class (Z, S n)) d

-- the magnitudes multiply: (m+1)(k+1) = m*k + m + k + 1, so the stored
-- (magnitude − 1) of the product is m*k + m + k; the sign is the usual
-- product of signs. Closure of NZ under multiplication is therefore
-- definitional — there is no side condition to discharge.
def nzMul : El NZ → El NZ → El NZ using (rational.NZ.unfold) ≔
  λx. λy. ⊎-elim
    (m. ⊎-elim (k. nzPos (m * k + m + k)) (k. nzNeg (m * k + m + k)) y)
    (m. ⊎-elim (k. nzNeg (m * k + m + k)) (k. nzPos (m * k + m + k)) y)
    x

def nzMulOneL : {y : El NZ} → nzMul nzOne y ≡ y
  using (nzMul.eq,
    nzNeg.eq,
    nzOne.eq,
    nzPos.eq,
    plusZeroId.rw,
    rational.NZ.unfold,
    zeroMult,
    zeroMult.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λy. ⊎-elim (k. ⋆) (k. ⋆) y

def nzMulOneR : {x : El NZ} → nzMul x nzOne ≡ x
  using (multZeroId.rw,
    nzMul.eq,
    nzNeg.eq,
    nzOne.eq,
    nzPos.eq,
    plusZeroId.rw,
    rational.NZ.unfold,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λx. ⊎-elim (m. ⋆) (m. ⋆) x

-- ===== nat lemmas, in the orientation the engine can use =====
--
-- Rewriting is ORIENTED and size-decreasing, so nat.nova's
-- distributivity and successor-multiplication laws — both stated in
-- the size-INCREASING direction — never fire as rewrite rules. Their
-- flips do; each is proved by ⋆, the original firing by
-- whole-equation match on the flipped goal.
def distribBack : (n m k : ℕ) → n * m + n * k ≡ n * (m + k) using (multDistrib) ≔ λn. λm. λk. ⋆

def sucMultBack : (n m : ℕ) → m + n * m ≡ S n * m using (sucMult) ≔ λn. λm. ⋆

def oneMult : (m : ℕ) → S Z * m ≡ m using (multComm) ≔
  λm. S Z * m ≡⟨ sucMult Z m ⟩ m + Z * m ≡⟨ zeroMult m ⟩ m + Z ≡⟨ plusZeroId m ⟩ m

-- ===== scaling an integer by a non-zero integer =====
--
-- Rational addition needs num · den, i.e. multiplication in Int. A
-- general intMul owes a quotient well-definedness proof in BOTH
-- arguments (the (a₁−a₂)(b₁−b₂) cross-sum identity). But one factor is
-- always a DENOMINATOR — an NZ, i.e. a SIGN and a NAT — so it suffices
-- to scale by a nat and negate: n · (a, b) ≔ (n*a, n*b), whose
-- well-definedness is one application of distributivity.
def intAddZeroL : (z : El Int) → intZero + z ≡ z
  using (hyp.rw,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    integerAdd.+.eq,
    plusComm,
    plusComm.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λz. quot-elim (p. ⋆) z

def intAddZeroR : (z : El Int) → z + intZero ≡ z
  using (hyp.rw,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    integerAdd.+.eq,
    plusComm,
    plusComm.rw,
    plusZeroId,
    plusZeroId.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λz. quot-elim (p. ⋆) z

def intScaleN : ℕ → El Int → El Int
  using (distribBack, distribBack.rw, hyp.rw, integer.Int.unfold) ≔
  λn. λz. quot-elim (p. class (n * p .π₁, n * p .π₂)) z

def intScaleNZero : (n : ℕ) → intScaleN n intZero ≡ intZero
  using (integer.Int.unfold, integer.intZero.eq, rational.intScaleN.eq) ≔
  λn. ⋆

def intScaleNOne : (z : El Int) → intScaleN (S Z) z ≡ z
  using (hyp.rw,
    intScaleN.eq,
    integer.Int.eq,
    integer.Int.unfold,
    oneMult,
    oneMult.rw,
    plusComm,
    plusComm.rw) ≔
  λz. quot-elim (p. ⋆) z

-- scaling by n+1 really is n+1 iterated additions — the definition by
-- representatives agrees with the recursive one
def intScaleNSuc : (n : ℕ) (z : El Int) → intScaleN (S n) z ≡ z + intScaleN n z
  using (hyp.rw,
    intScaleN.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integerAdd.+.eq,
    sucMultBack,
    sucMultBack.rw) ≔
  λn. λz. quot-elim (p. ⋆) z

def intScale : El NZ → El Int → El Int using (integer.Int.unfold, rational.NZ.unfold) ≔
  λd. λz. ⊎-elim (n. intScaleN (S n) z) (n. intNeg (intScaleN (S n) z)) d

def intScaleOne : {z : El Int} → intScale nzOne z ≡ z
  using (intScale.eq, intScaleNOne, integer.Int.unfold, nzOne.eq, nzPos.eq) ≔
  λz. ⋆

def intScaleZero : (d : El NZ) → intScale d intZero ≡ intZero
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    rational.NZ.unfold,
    rational.intScale.eq,
    rational.intScaleN.eq) ≔
  λd. ⊎-elim (n. ⋆) (n. ⋆) d

-- Adding a scaled zero. Both arguments of intAdd are quot-elim
-- SCRUTINEE positions, and a rewrite may not land in one unless the
-- subterm is ⇒ᴺ-inferable (NovaKernel.txt §6, the neutral-subterm
-- rule) — which a stuck ⊎-elim like `intScale d intZero` is not. So
-- the ⊎-elim on d is done here, where each branch closes at the ROOT
-- (a type-determined position) against intAddZeroL/R, and the other
-- summand is kept a VARIABLE so there is nothing to rewrite in it.
-- Callers compose with trans rather than ask the engine to rewrite
-- these in place.
def intAddScaleZeroL : {d : El NZ} {y : El Int} → intScale d intZero + y ≡ y
  using (intAddZeroL,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    integerAdd.+.eq,
    nat.*.eq,
    nat.+.eq,
    rational.NZ.unfold,
    rational.intScale.eq,
    rational.intScaleN.eq) ≔
  λd. λy. ⊎-elim (n. intAddZeroL y) (n. intAddZeroL y) d

def intAddScaleZeroR : {d : El NZ} {y : El Int} → y + intScale d intZero ≡ y
  using (intAddZeroR, integer.Int.unfold, rational.NZ.unfold, rational.intScaleZero) ≔
  λd. λy. ⊎-elim (n. intAddZeroR y) (n. intAddZeroR y) d

-- scaling by d agrees with multiplying by d's image in Int
def intScaleToInt : {d : El NZ} → intScale d (class (S Z, Z)) ≡ nzToInt d
  using (integer.Int.unfold,
    integer.intNeg.eq,
    nat.*.eq,
    nat.+.eq,
    rational.NZ.unfold,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.nzToInt.eq) ≔
  λd. ⊎-elim (n. ⋆) (n. ⋆) d

-- ===== the rationals =====
def Rat : 𝕌 ≔ Int ⨯ NZ

def mkRat : El Int → El NZ → El Rat using (rational.Rat.unfold) ≔ λn. λd. n, d

def num : El Rat → El Int using (integer.Int.unfold, rational.Rat.unfold) ≔ λq. q .π₁

def den : El Rat → El NZ using (rational.NZ.unfold, rational.Rat.unfold) ≔ λq. q .π₂

def denInt : El Rat → El Int using (integer.Int.unfold, rational.Rat.unfold) ≔ λq. nzToInt (q .π₂)

def ratOfInt : El Int → El Rat using (rational.Rat.unfold) ≔ λz. mkRat z nzOne

def ratZero : El Rat using (rational.Rat.unfold) ≔ ratOfInt intZero

def ratOne : El Rat using (rational.Rat.unfold) ≔ ratOfInt intOne

-- n₁/d₁ + n₂/d₂ ≔ (n₁·d₂ + n₂·d₁) / (d₁·d₂). Rat is a plain Σ-code —
-- pair construction, nothing to discharge. (Once Rat is quotiented by
-- cross-multiplication, ratAdd will owe a descent proof; that is the
-- next step, not this one.)
def ratAdd : El Rat → El Rat → El Rat using (rational.Rat.unfold) ≔
  λp. λq. mkRat (intScale (den q) (num p) + intScale (den p) (num q)) (nzMul (den p) (den q))

-- ½ + ½ = 4/4, unreduced, as the raw representation demands
def half : El Rat using (rational.Rat.unfold) ≔ mkRat intOne (nzPos (S Z))

def ratAddTest : ratAdd half half ≡ mkRat (class (4, Z)) (nzPos 3)
  using (integer.Int.unfold,
    integer.intOne.eq,
    integerAdd.+.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.unfold,
    rational.den.eq,
    rational.half.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq) ≔
  ⋆

-- ⅓ + (−⅓) = 0/(−9): numerator cancels, denominator keeps its sign
def third : El Rat using (rational.Rat.unfold) ≔ mkRat intOne (nzPos 2)

def negThird : El Rat using (rational.Rat.unfold) ≔ mkRat intOne (nzNeg 2)

-- the numerator's cancellation, at the root where the quotient join is
-- available (under the test's pair it is a component position, which
-- the strict engine reaches only by whole-equation match)
def threeCancel : class (3, 3) ≡ intZero using (integer.Int.unfold, integer.intZero.eq) ≔ ⋆

def ratAddTest2 : ratAdd third negThird ≡ mkRat intZero (nzNeg 8)
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intOne.eq,
    integerAdd.+.eq,
    nat.*.eq,
    nat.+.eq,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.negThird.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rational.third.eq,
    threeCancel) ≔
  trans _ _ _ _ ⋆ (cong _ (λu. Rat) (λx. mkRat x (nzNeg 8)) _ _ threeCancel)

-- ===== 0/1 is a unit =====
-- componentwise first: the numerator collapses by the scaled-zero
-- unit followed by intScaleOne, the denominator by nzMulOne
def ratAddZeroLNum : {q : El Rat} → intScale (den q) intZero + intScale nzOne (num q) ≡ num q
  using (intScaleNOne) ≔
  λq. trans _ _ (intScale nzOne (num q)) _ intAddScaleZeroL intScaleOne

def ratAddZeroRNum : {q : El Rat} → intScale nzOne (num q) + intScale (den q) intZero ≡ num q
  using (intScaleNOne) ≔
  λq. trans _ _ (intScale nzOne (num q)) _ intAddScaleZeroR intScaleOne

-- Σ-η, as a step of its own: el-sigma-eta is judgemental in the
-- theory but the kernel's normal forms do not contract (t.π₁ , t.π₂),
-- so the last hop has to be named
def ratEta : {q : El Rat} → mkRat (num q) (den q) ≡ q
  using (den.eq,
    integer.Int.unfold,
    mkRat.eq,
    num.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    sigma.eta) ≔
  λq. ⋆

-- and then the pair, one component at a time
def ratAddZeroL : {q : El Rat} → ratAdd ratZero q ≡ q
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    integerAdd.+.eq,
    nzMulOneL,
    ratEta,
    rational.NZ.unfold,
    rational.Rat.eq,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq) ≔
  λq. trans
    _
    _
    (q .π₁, q .π₂)
    _
    (trans
      _
      (ratAdd ratZero q)
      (mkRat (num q) (nzMul nzOne (den q)))
      (q .π₁, q .π₂)
      (cong
        Int
        (λw. Rat)
        (λx. mkRat x (nzMul nzOne (den q)))
        (intScale (den q) intZero + intScale nzOne (num q))
        (num q)
        ratAddZeroLNum)
      (cong NZ (λw. Rat) (λd. mkRat (num q) d) (nzMul nzOne (den q)) (den q) nzMulOneL))
    ratEta

def ratAddZeroR : {q : El Rat} → ratAdd q ratZero ≡ q
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    integerAdd.+.eq,
    nzMulOneR,
    ratEta,
    rational.NZ.unfold,
    rational.Rat.eq,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq) ≔
  λq. trans
    _
    _
    (q .π₁, q .π₂)
    _
    (trans
      _
      (ratAdd q ratZero)
      (mkRat (num q) (nzMul (den q) nzOne))
      (q .π₁, q .π₂)
      (cong
        Int
        (λw. Rat)
        (λx. mkRat x (nzMul (den q) nzOne))
        (intScale nzOne (num q) + intScale (den q) intZero)
        (num q)
        ratAddZeroRNum)
      (cong NZ (λw. Rat) (λd. mkRat (num q) d) (nzMul (den q) nzOne) (den q) nzMulOneR))
    ratEta

-- ===== commutativity =====
-- (x + m) + k ≡ (x + k) + m: the addends the cross-sum needs swapped
def plusSwapRight : {x m k : ℕ} → x + m + k ≡ x + k + m
  using (hyp.rw, plusAssoc, plusAssoc.rw, plusComm, plusComm.rw, swapLeft, swapLeft.rw) ≔
  λx. λm. λk. ⋆

-- the magnitude arithmetic of nzMul is symmetric: multComm on the
-- product, then the swap above on the two summands
def mulPlusComm : {m k : ℕ} → m * k + m + k ≡ k * m + k + m using (plusAssoc) ≔
  λm. λk. trans
    _
    _
    (k * m + m + k)
    _
    (cong _ (λu. ℕ) (λw. w + m + k) _ _ (multComm k m))
    plusSwapRight

def nzMulComm : {x y : El NZ} → nzMul x y ≡ nzMul y x
  using (plusAssoc, rational.NZ.unfold, rational.nzMul.eq, rational.nzNeg.eq, rational.nzPos.eq) ≔
  λx. λy. ⊎-elim
    (m. ⊎-elim (w. nzMul (nzPos m) w ≡ nzMul w (nzPos m))
      (k. cong ℕ (λu. NZ) nzPos (m * k + m + k) (k * m + k + m) mulPlusComm)
      (k. cong ℕ (λu. NZ) nzNeg (m * k + m + k) (k * m + k + m) mulPlusComm)
      y)
    (m. ⊎-elim (w. nzMul (nzNeg m) w ≡ nzMul w (nzNeg m))
      (k. cong ℕ (λu. NZ) nzNeg (m * k + m + k) (k * m + k + m) mulPlusComm)
      (k. cong ℕ (λu. NZ) nzPos (m * k + m + k) (k * m + k + m) mulPlusComm)
      y)
    x

-- p + q ≡ q + p: intAddComm on the numerator, nzMulComm on the
-- denominator (the middle term of the trans spelled out — the
-- elaborator has nothing else to pin it against)
def ratAddComm : (p q : El Rat) → ratAdd p q ≡ ratAdd q p
  using (integer.Int.unfold,
    integerAdd.+.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.intScale.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.ratAdd.eq) ≔
  λp. λq. trans
    _
    _
    (mkRat (intScale (den p) (num q) + intScale (den q) (num p)) (nzMul (den p) (den q)))
    _
    (cong
      _
      (λu. Rat)
      (λx. mkRat x (nzMul (den p) (den q)))
      _
      _
      (intAddComm (intScale (den q) (num p)) (intScale (den p) (num q))))
    (cong
      NZ
      (λu. Rat)
      (λd. mkRat (intScale (den p) (num q) + intScale (den q) (num p)) d)
      (nzMul (den p) (den q))
      (nzMul (den q) (den p))
      nzMulComm)

-- ===== negation =====
-- negate the numerator, keep the denominator
def ratNeg : El Rat → El Rat using (rational.Rat.unfold) ≔ λp. mkRat (intNeg (num p)) (den p)

def ratNegHalf : ratNeg half ≡ mkRat (class (Z, S Z)) (nzPos (S Z))
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intOne.eq,
    rational.Rat.unfold,
    rational.den.eq,
    rational.half.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzPos.eq,
    rational.ratNeg.eq) ≔
  ⋆
