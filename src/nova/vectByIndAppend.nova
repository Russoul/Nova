import nat (+, plusZeroId, plusSucId, zeroPlusId, sucPlus, plusAssoc)
import vectByInd (vect)

def vappend : (n : ℕ) {A : 𝕌} (m : ℕ) → El (vect n A) → El (vect m A) → El (vect (n + m) A)
  using (nat.+.unfold, sucPlus.rw, vect.eq, vectByInd.vect.unfold, zeroPlusId.rw) ≔
  λn. λA. λm. ℕ-elim (k. El (vect k A) → El (vect m A) → El (vect (k + m) A))
    (λv. λw. w)
    (k ih. λv. λw. v .π₁, ih (v .π₂) w)
    n

-- This equation holds by direct computation
def vappendZ : (A : 𝕌)
  (n : ℕ)
  (v : El (vect Z A))
  (w : El (vect n A))
  → vappend Z n v w ≡ w ∈ El (vect n A)
  using (hyp.rw,
    sucPlus.rw,
    vappend.eq,
    vect.eq,
    vectByInd.vect.unfold,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λA. λn. λv. λw. ⋆

--  ^^^^^^^^^ FIXME: Can't be synthesised
def vappendS : (n : ℕ)
  (A : 𝕌)
  (m : ℕ)
  (v : El (vect (S n) A))
  (w : El (vect m A))
  → vappend (S n) m v w ≡ (v .π₁, vappend n m (v .π₂) w) ∈ El (vect (S n + m) A)
  using (hyp.rw,
    nat.+.unfold,
    sucPlus,
    sucPlus.rw,
    vappend.eq,
    vect.eq,
    vectByInd.vect.unfold,
    zeroPlusId.rw) ≔
  λn. λA. λm. λv. λw. ⋆

-- the associativity step case, packaged: with the tail instance of
-- the induction hypothesis supplied as an equation, both sides
-- compute (sucPlus + one vappend unfolding each) to cons cells whose
-- tails the hypothesis relates
def vappendAssocS : {A : 𝕌}
  {m k p : ℕ}
  {v : El (vect m A)}
  {w : El (vect k A)}
  {q : El (vect (S p) A)}
  → (vappend
    (p + m)
    k
    (vappend p m (q .π₂) v)
    w ≡ vappend
    p
    (m + k)
    (q .π₂)
    (vappend
      m
      k
      v
      w) ∈ El (vect
    (p + (m + k))
    A))
    → vappend
      (S p + m)
      k
      (vappend (S p) m q v)
      w ≡ vappend (S p) (m + k) q (vappend m k v w) ∈ El (vect (S p + (m + k)) A)
  using (hyp.rw,
    nat.+.unfold,
    plusAssoc.rw,
    sucPlus.rw,
    vappend.eq,
    vect.eq,
    vectByInd.vect.unfold,
    zeroPlusId.rw) ≔
  λA. λm. λk. λp. λv. λw. λq. λhih. ⋆

-- Associativity: the statement itself only type-checks up to
-- plus-associativity (the two sides' lengths differ intensionally)
-- — the extensional mismatch the imported plus lemmas discharge.
--  ^^^^^^^^^^^^^ FIXME: Can't be synthesised
def vappendAssoc : (n : ℕ)
  (A : 𝕌)
  (m k : ℕ)
  (v : El (vect m A))
  (w : El (vect k A))
  (u : El (vect n A))
  → vappend
    (n + m)
    k
    (vappend n m u v)
    w ≡ vappend n (m + k) u (vappend m k v w) ∈ El (vect (n + m + k) A)
  using (hyp.rw,
    nat.+.unfold,
    plusAssoc,
    plusAssoc.rw,
    sucPlus,
    sucPlus.rw,
    vappendS.rw,
    vappendZ.rw,
    vect.eq,
    vectByInd.vect.unfold,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λn. λA. λm. λk. λv. λw. λu. (ℕ-elim (p. (q : El (vect p A))
    → vappend
      (p + m)
      k
      (vappend p m q v)
      w ≡ vappend p (m + k) q (vappend m k v w) ∈ El (vect (p + (m + k)) A))
    (λq. ⋆ using (vappend.eq, vect.eq, zeroPlusId.rw, sucPlus.rw, hyp.rw))
    (p ih. λq. vappendAssocS (ih (q .π₂)))
    n)
    u
