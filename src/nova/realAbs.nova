-- ABSOLUTE VALUE on ℝ, defined POINTWISE. It works pointwise — with no
-- index shift and no Archimedean argument — for one reason: the
-- reverse triangle inequality in ℚ,
--
--   | |a| − |b| |  ≤  |a − b|          (ratAbs.nova's bndAbsSub)
--
-- says |·| is 1-Lipschitz, so it preserves BOTH the regularity modulus
-- and the closeness relation on the nose. The same accident makes the
-- triangle inequality for ℝ a pointwise fact: |x ⊕ y| and |x| ⊕ |y|
-- sample at the SAME doubled index, so the ℚ-level inequality is all
-- that is needed.

import rationalQ (Q, qAdd, qNeg, qZero, qOne)
import rationalOrder (LeQ, leQTrans)
import ratBound (Bnd)
import ratAbs (qAbs, qAbsNeg, qAbsAbs, qAbsZero, qAbsTriangle, leQZeroAbs, bndAbsSub, qAbsOfNonNeg)
import ratHalf (dbl)
import real (rBound, leQZeroBound, Regular, RSeq, REq, Real, constReg, realOfQ, realZero, realOne)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, realEqOfREq, realEqOfPointwise, rNeg, realNeg)
import realAdd (rAdd, realAdd)
import realSeq (realEqOfSeqEq)
import realOrder (RLeP, rleOf, LeR, leQSubZero)
import equality (trans, sym, cong, transport)

def absSeq : El (ℕ → Q) → El (ℕ → Q) using (rationalQ.Q.unfold) ≔ λf. λn. qAbs (f n)

def absReg : {f : El (ℕ → Q)} → El (Regular f) → El (Regular (absSeq f))
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratBound.Bnd.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.qAdd.eq,
    rationalQ.qNeg.eq,
    real.Regular.unfold,
    real.rBound.eq,
    realAbs.absSeq.eq) ≔
  λf. λh. bndReg (λm. λn. bndAbsSub (rBound m n) (f m) (f n) (regBnd f h m n))

def rAbs : El RSeq → El RSeq using (real.RSeq.unfold) ≔ λx. absSeq (seqOf x), absReg (regOf x)

def rAbsWD : {x y : El RSeq} → Prf (REq x y) → Prf (REq (rAbs x) (rAbs y))
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratBound.Bnd.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.LeQ.eq,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qAdd.eq,
    rationalQ.qNeg.eq,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realNeg.seqOf.eq) ≔
  λx. λy. λh. squash-elim h (u. reqOf
    (rAbs x)
    (rAbs y)
    (λn. bndAbsSub (rBound n n) (seqOf x n) (seqOf y n) (u n)))

def rAbsWDCls : (x y : El RSeq) (h : Prf (REq x y)) → class (rAbs x) ≡ class (rAbs y) ∈ El Real
  using (real.Real.unfold) ≔
  λx. λy. λh. realEqOfREq (rAbs x) (rAbs y) (rAbsWD h)

def realAbs : El Real → El Real
  using (rAbsWDCls, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold) ≔
  λu. quot-elim (w. El Real) (p. class (rAbs p)) u

def realAbsCls : {x : El RSeq} → realAbs (class x) ≡ class (rAbs x) ∈ El Real
  using (real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq) ≔
  λx. ⋆

-- ===== the laws =====
def realAbsNeg : (u : El Real) → realAbs (realNeg u) ≡ realAbs u ∈ El Real
  using (ratAbs.qAbs.eq,
    rational.ratNeg.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qNeg.eq,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq,
    realAbs.realAbsCls,
    realNeg.negSeq.eq,
    realNeg.rNeg.eq,
    realNeg.realNeg.eq,
    realNeg.seqOf.eq) ≔
  λu. quot-elim (w. realAbs (realNeg w) ≡ realAbs w ∈ El Real)
    (p. realEqOfSeqEq (rAbs (rNeg p)) (rAbs p) (λn. qAbsNeg (seqOf p n)))
    u

def realAbsAbs : (u : El Real) → realAbs (realAbs u) ≡ realAbs u ∈ El Real
  using (ratAbs.qAbs.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qNeg.eq,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq,
    realNeg.seqOf.eq) ≔
  λu. quot-elim (w. realAbs (realAbs w) ≡ realAbs w ∈ El Real)
    (p. realEqOfSeqEq (rAbs (rAbs p)) (rAbs p) (λn. qAbsAbs (seqOf p n)))
    u

def realAbsOfQ : (q : El Q) → realAbs (realOfQ q) ≡ realOfQ (qAbs q) ∈ El Real
  using (ratAbs.qAbs.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.constReg.eq,
    real.realOfQ.eq,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq,
    realNeg.seqOf.eq) ≔
  λq. realEqOfSeqEq (rAbs ((λn. q), constReg)) ((λn. qAbs q), constReg) (λn. ⋆)

def realAbsZero : realAbs realZero ≡ realZero ∈ El Real
  using (equality.sym.eq,
    equality.transport.eq,
    qAbsZero,
    rationalOrder.LeQ.eq,
    rationalQ.Q.eq,
    rationalQ.qAdd.eq,
    rationalQ.qAddNegR.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.constReg.eq,
    real.leQNegBoundZero.eq,
    real.leQZeroBound.eq,
    real.rBound.eq,
    real.realOfQ.eq,
    real.realZero.eq,
    realAbs.absReg.eq,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq,
    realNeg.regOf.eq,
    realNeg.seqOf.eq) ≔
  realEqOfSeqEq (rAbs ((λn. qZero), constReg)) ((λn. qZero), constReg) (λn. ⋆)

-- ===== nonnegativity and the triangle inequality =====
-- 0 ≤ |x| : pointwise, since 0 − |x_n| ≤ 0 ≤ 2/(n+1)
def rleZeroAbs : {x : El RSeq} → Prf (RLeP ((λn. qZero), constReg) (rAbs x))
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rational.ratZero.eq,
    rationalOrder.LeQ.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qAdd.eq,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.constReg.eq,
    real.qInvNat.eq,
    real.rBound.eq,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. rleOf
    ((λn. qZero), constReg)
    (rAbs x)
    (λn. leQTrans
      (qAdd qZero (qNeg (qAbs (seqOf x n))))
      qZero
      (rBound n n)
      (leQSubZero (leQZeroAbs (seqOf x n)))
      (leQZeroBound n n))

def leRZeroAbs : (u : El Real) → Prf (LeR realZero (realAbs u))
  using (equality.sym.eq,
    equality.transport.eq,
    rational.ratZero.eq,
    rationalOrder.LeQ.eq,
    rationalQ.Q.eq,
    rationalQ.qAdd.eq,
    rationalQ.qAddNegR.eq,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    real.constReg.eq,
    real.leQNegBoundZero.eq,
    real.leQZeroBound.eq,
    real.rBound.eq,
    real.realOfQ.eq,
    real.realOfQ.unfold,
    real.realZero.eq,
    real.realZero.unfold,
    realAbs.absReg.eq,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq,
    realAbs.realAbs.unfold,
    realNeg.regOf.eq,
    realNeg.seqOf.eq,
    realOrder.LeR.eq,
    realOrder.LeR.unfold,
    realOrder.RLeP.eq) ≔
  λu. quot-elim (w. Prf (LeR realZero (realAbs w))) (x. rleZeroAbs) u

-- |x + y| ≤ |x| + |y| : both sides sample at the SAME doubled index,
-- so this is ℚ's triangle inequality, pointwise
def rleAbsTriangle : {x y : El RSeq} → Prf (RLeP (rAbs (rAdd x y)) (rAdd (rAbs x) (rAbs y)))
  using (id.Id.eq,
    ratAbs.qAbs.eq,
    ratHalf.dbl.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.LeQ.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qAdd.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realAbs.absSeq.eq,
    realAbs.rAbs.eq,
    realAdd.addSeq.eq,
    realAdd.rAdd.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. rleOf
    (rAbs (rAdd x y))
    (rAdd (rAbs x) (rAbs y))
    (λn. leQTrans
      (qAdd
        (qAbs (qAdd (seqOf x (dbl n)) (seqOf y (dbl n))))
        (qNeg (qAdd (qAbs (seqOf x (dbl n))) (qAbs (seqOf y (dbl n))))))
      qZero
      (rBound n n)
      (leQSubZero (qAbsTriangle (seqOf x (dbl n)) (seqOf y (dbl n))))
      (leQZeroBound n n))

def leRAbsTriangle : {u v : El Real}
  → Prf (LeR (realAbs (realAdd u v)) (realAdd (realAbs u) (realAbs v)))
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realAbs.rAbs.eq,
    realAbs.realAbs.eq,
    realAbs.realAbs.unfold,
    realAdd.rAdd.eq,
    realAdd.realAdd.eq,
    realAdd.realAdd.unfold,
    realOrder.LeR.eq,
    realOrder.LeR.unfold,
    realOrder.RLeP.eq) ≔
  λu. λv. quot-elim (t. Prf (LeR (realAbs (realAdd t v)) (realAdd (realAbs t) (realAbs v))))
    (x. quot-elim (t. Prf (LeR
      (realAbs (realAdd (class x) t))
      (realAdd (realAbs (class x)) (realAbs t))))
      (y. rleAbsTriangle)
      v)
    u
