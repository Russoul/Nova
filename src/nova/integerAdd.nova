import nat (+, plusZeroId, plusSucId, zeroPlusId, sucPlus, plusComm, plusAssoc, swapLeft)
import integer (Int)

-- ===== helpers for the well-definedness obligations =====

-- addition of pairs is well-defined in its second argument: the
-- cross-sum equation, conditional on the relation hypothesis
def intAddWD : (a1 : ℕ) (a2 : ℕ) (b1 : ℕ) (b2 : ℕ) (c1 : ℕ) (c2 : ℕ) (h : b1 + c2 ≡ b2 + c1 ∈ ℕ) →
  (a1 + b1) + (a2 + c2) ≡ (a2 + b2) + (a1 + c1) ∈ ℕ ≔
  λa1. λa2. λb1. λb2. λc1. λc2. λh. ℕ-elim (k. (a1 + b1) + (k + c2) ≡ (k + b2) + (a1 + c1) ∈ ℕ)
    Refl (k ih. Refl) a2

-- cross-sum well-definedness in the OUTER argument, conditional on h
def intAddCross : (a1 : ℕ) (a2 : ℕ) (b1 : ℕ) (b2 : ℕ) (c1 : ℕ) (c2 : ℕ) (h : a1 + b2 ≡ a2 + b1 ∈ ℕ) →
  (a1 + c1) + (b2 + c2) ≡ (a2 + c2) + (b1 + c1) ∈ ℕ ≔
  λa1. λa2. λb1. λb2. λc1. λc2. λh. ℕ-elim (k. (a1 + c1) + (b2 + k) ≡ (a2 + k) + (b1 + c1) ∈ ℕ)
    Refl (k ih. Refl) c2

-- the same, one level up: the inner elimination is well-defined in the
-- OUTER argument — proven by quotient elimination with an ≡-motive
def intAddWDOuter : (a : ℕ ⨯ ℕ) (b : ℕ ⨯ ℕ) (h : a .π₁ + b .π₂ ≡ a .π₂ + b .π₁ ∈ ℕ) (zy : Int) →
  quot-elim (z. Int) (x. class (a .π₁ + x .π₁ , a .π₂ + x .π₂)) zy
    ≡ quot-elim (z. Int) (x. class (b .π₁ + x .π₁ , b .π₂ + x .π₂)) zy
    ∈ Int ≔
  λa. λb. λh. λzy. quot-elim
    (q. quot-elim (z. Int) (x. class (a .π₁ + x .π₁ , a .π₂ + x .π₂)) q
          ≡ quot-elim (z. Int) (x. class (b .π₁ + x .π₁ , b .π₂ + x .π₂)) q
          ∈ Int)
    (c. Refl)
    zy

def intAdd : Int → Int → Int ≔
  λzx. λzy.
    quot-elim (z. Int)
      (a. quot-elim (z. Int)
            (b. class (a .π₁ + b .π₁ , a .π₂ + b .π₂))
            zy)
      zx

def intAddTest : intAdd (class (Z , Z)) (class (S Z , S Z)) ≡ class (S Z , S Z) ∈ Int ≔ Refl

-- ===== the algebra =====

-- commutativity: two quotient eliminations at ≡-motives reduce to the
-- representative-level cross-sum permutation
def intAddComm : (x : Int) (y : Int) → intAdd x y ≡ intAdd y x ∈ Int ≔
  λx. λy. quot-elim
    (q. intAdd q y ≡ intAdd y q ∈ Int)
    (a. quot-elim
          (q. intAdd (class a) q ≡ intAdd q (class a) ∈ Int)
          (b. Refl)
          y)
    x

-- associativity: three eliminations; the representatives reassociate
-- by plusAssoc and close by commutativity of the cross sum
def intAddAssoc : (x : Int) (y : Int) (z : Int) →
  intAdd (intAdd x y) z ≡ intAdd x (intAdd y z) ∈ Int ≔
  λx. λy. λz. quot-elim
    (q. intAdd (intAdd q y) z ≡ intAdd q (intAdd y z) ∈ Int)
    (a. quot-elim
          (q. intAdd (intAdd (class a) q) z ≡ intAdd (class a) (intAdd q z) ∈ Int)
          (b. quot-elim
                (q. intAdd (intAdd (class a) (class b)) q
                      ≡ intAdd (class a) (intAdd (class b) q) ∈ Int)
                (c. Refl)
                z)
          y)
    x
