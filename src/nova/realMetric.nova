import rationalQ (Q, qAdd, qNeg, qZero)
import rationalOrder (LeQ, leQTrans)
import ratHalf (dbl)
import ratAbs (qAbs, bndAbs)
import ratBound (Bnd)
import ratArch (leQSubShift)
import real (rBound, leQZeroBound, RSeq, Real, constReg, realOfQ, realZero,
             realOne)
import realNeg (seqOf, rNeg, realNeg, realNegZero, realNegCls)
import realAdd (rAdd, realAdd, realAddCls)
import realAbs (rAbs, realAbs, realAbsCls, realAbsNeg, realAbsZero, leRZeroAbs,
                leRAbsTriangle)
import realOrder (RLeP, rleOf, LeR, leRAntisym, leRTrans, leQSubZero)
import realGroup (realSub, realSubSelf, realSubVia, realNegSub, realSubZeroInv)
import equality (trans, sym, cong, transport, transportP)

-- ℝ AS A METRIC SPACE, with the distance valued in ℝ itself:
--
--   d u v ≔ |u − v|
--
-- symmetric, vanishing exactly on the diagonal, and satisfying the
-- triangle inequality. Every proof is one rewrite of realGroup.nova's
-- algebra composed with a fact about |·| that realAbs.nova already
-- has — the metric axioms carry no analysis of their own.

-- ===== |u| bounds u on both sides, at the level of ℝ =====

def leRAbsSelf : (u : El Real) → Prf (LeR u (realAbs u)) using (id.Id.eq, ratAbs.qAbs.eq, ratBound.Bnd.unfold, rational.ratAdd.eq, rational.ratNeg.eq, rationalOrder.LeQ.unfold, rationalOrder.NonNegS.unfold, rationalOrder.Sign.eq, rationalOrder.ratSgn.eq, rationalOrder.sPos.eq, rationalOrder.sZero.eq, rationalOrder.sgnCases.eq, rationalOrder.sgnQ.eq, rationalQ.qAdd.eq, rationalQ.qNeg.eq, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, real.qInvNat.eq, real.rBound.eq, realAbs.absSeq.eq, realAbs.rAbs.eq, realAbs.realAbs.eq, realNeg.seqOf.eq, realOrder.LeR.eq, realOrder.LeR.unfold, realOrder.RLeP.eq) ≔
  λu.
    quot-elim (w. Prf (LeR w (realAbs w)))
      (x. rleOf x (rAbs x)
            (λn.
              leQTrans (qAdd (seqOf x n) (qNeg (qAbs (seqOf x n)))) qZero
                       (rBound n n)
                (leQSubZero (seqOf x n) (qAbs (seqOf x n))
                   ((bndAbs (seqOf x n)) .π₂))
                (leQZeroBound n n)))
      u

def leRNegAbsSelf : (u : El Real) → Prf (LeR (realNeg (realAbs u)) u)
  using (id.Id.eq, ratAbs.qAbs.eq, ratBound.Bnd.unfold, rational.ratAdd.eq, rational.ratNeg.eq, rationalOrder.LeQ.unfold, rationalOrder.NonNegS.unfold, rationalOrder.Sign.eq, rationalOrder.ratSgn.eq, rationalOrder.sPos.eq, rationalOrder.sZero.eq, rationalOrder.sgnCases.eq, rationalOrder.sgnQ.eq, rationalQ.qAdd.eq, rationalQ.qNeg.eq, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, real.qInvNat.eq, real.rBound.eq, realAbs.absSeq.eq, realAbs.rAbs.eq, realAbs.realAbs.eq, realAbs.realAbs.unfold, realNeg.negSeq.eq, realNeg.rNeg.eq, realNeg.realNeg.eq, realNeg.realNeg.unfold, realNeg.seqOf.eq, realOrder.LeR.eq, realOrder.LeR.unfold, realOrder.RLeP.eq) ≔
  λu.
    quot-elim (w. Prf (LeR (realNeg (realAbs w)) w))
      (x. rleOf (rNeg (rAbs x)) x
            (λn.
              leQTrans (qAdd (qNeg (qAbs (seqOf x n))) (qNeg (seqOf x n))) qZero
                       (rBound n n)
                (leQSubZero (qNeg (qAbs (seqOf x n))) (seqOf x n)
                   ((bndAbs (seqOf x n)) .π₁))
                (leQZeroBound n n)))
      u

-- ...so a vanishing absolute value names zero
def realAbsZeroInv : (u : El Real) →
  (realAbs u ≡ realZero ∈ El Real) → u ≡ realZero ∈ El Real ≔
  λu. λh.
    leRAntisym u realZero
      (transportP Real (λw. LeR u w) (realAbs u) realZero h (leRAbsSelf u))
      (transportP Real (λw. LeR w u) (realNeg (realAbs u)) realZero
         (trans Real (realNeg (realAbs u)) (realNeg realZero) realZero
            (cong Real (λw. Real) (λw. realNeg w) (realAbs u) realZero h)
            realNegZero)
         (leRNegAbsSelf u))

-- ===== the distance =====

def realDist : El Real → El Real → El Real using (real.Real.unfold) ≔ λu. λv. realAbs (realSub u v)

-- THE BRIDGE. d on classes IS the representative-level |p − q|, and
-- naming it once is what keeps its users cheap.
--
-- Without this, a proof that states its goal at the ℝ level while
-- working at the representative level asks the kernel to see through
-- realDist → realSub → realAdd/realNeg → rAdd/rNeg → addSeq/negSeq →
-- qAdd/qNeg → mkRat → … inside a SINGLE type conversion, and the
-- licensed join has to redo that at every use. Here each layer is one
-- named lemma — realNegCls, realAddCls, realAbsCls — so the deep walk
-- happens once, at a statement small enough to be cheap.
def realDistCls : (p : El RSeq) (q : El RSeq) →
  realDist (class p) (class q) ≡ class (rAbs (rAdd p (rNeg q))) ∈ El Real
  using (realMetric.realDist.eq, realGroup.realSub.eq, real.Real.unfold,
         real.RSeq.unfold, real.Regular.unfold) ≔
  λp. λq.
    trans Real (realAbs (realAdd (class p) (realNeg (class q))))
               (realAbs (realAdd (class p) (class (rNeg q))))
               (class (rAbs (rAdd p (rNeg q))))
      (cong Real (λw. Real) (λw. realAbs (realAdd (class p) w))
         (realNeg (class q)) (class (rNeg q)) (realNegCls q))
      (trans Real (realAbs (realAdd (class p) (class (rNeg q))))
                  (realAbs (class (rAdd p (rNeg q))))
                  (class (rAbs (rAdd p (rNeg q))))
         (cong Real (λw. Real) (λw. realAbs w)
            (realAdd (class p) (class (rNeg q))) (class (rAdd p (rNeg q)))
            (realAddCls p (rNeg q)))
         (realAbsCls (rAdd p (rNeg q))))

-- THE SECOND BRIDGE, for the element side. rleOf's argument type
-- mentions seqOf of the whole |p − q| construction, so supplying it
-- directly makes the kernel walk rAbs → rAdd/rNeg → absSeq/addSeq/
-- negSeq → seqOf at every use. Here that walk happens once, with p, q
-- and the bound ABSTRACT (D-3), and callers hand over a statement in
-- which no construction appears at all.
def rleOfAbsSub : (p : El RSeq) (q : El RSeq) (b : El Q) →
  ((j : ℕ) →
     El (LeQ (qAbs (qAdd (seqOf p (dbl j)) (qNeg (seqOf q (dbl j)))))
             (qAdd b (rBound j j)))) →
  Prf (RLeP (rAbs (rAdd p (rNeg q))) ((λk. b) , constReg b))
  using (real.RSeq.unfold, real.Regular.unfold, realAbs.rAbs.eq,
         realAbs.absSeq.eq, realAdd.rAdd.eq, realAdd.addSeq.eq,
         realNeg.rNeg.eq, realNeg.negSeq.eq, realNeg.seqOf.eq,
         realOrder.RLeP.eq) ≔
  λp. λq. λb. λf.
    rleOf (rAbs (rAdd p (rNeg q))) ((λk. b) , constReg b)
      (λj.
        leQSubShift
          (qAbs (qAdd (seqOf p (dbl j)) (qNeg (seqOf q (dbl j)))))
          b (rBound j j) (f j))

def realDistSelf : (u : El Real) → realDist u u ≡ realZero ∈ El Real
  using (real.Real.unfold, realAbs.realAbs.eq, realGroup.realSub.eq, realMetric.realDist.eq) ≔
  λu.
    trans Real (realDist u u) (realAbs realZero) realZero
      (cong Real (λw. Real) (λw. realAbs w) (realSub u u) realZero
         (realSubSelf u))
      realAbsZero

def realDistSym : (u : El Real) (v : El Real) →
  realDist u v ≡ realDist v u ∈ El Real using (real.Real.unfold, realAbs.realAbs.eq, realGroup.realSub.eq, realMetric.realDist.eq) ≔
  λu. λv.
    trans Real (realDist u v) (realAbs (realNeg (realSub u v))) (realDist v u)
      (sym Real (realAbs (realNeg (realSub u v))) (realAbs (realSub u v))
         (realAbsNeg (realSub u v)))
      (cong Real (λw. Real) (λw. realAbs w) (realNeg (realSub u v))
         (realSub v u) (realNegSub u v))

def leRZeroDist : (u : El Real) (v : El Real) →
  Prf (LeR realZero (realDist u v)) using (real.Real.unfold, real.realOfQ.unfold, real.realZero.eq, real.realZero.unfold, realAbs.realAbs.eq, realAbs.realAbs.unfold, realAdd.realAdd.unfold, realGroup.realSub.eq, realGroup.realSub.unfold, realMetric.realDist.eq, realMetric.realDist.unfold, realOrder.LeR.eq, realOrder.LeR.unfold) ≔
  λu. λv. leRZeroAbs (realSub u v)

-- identity of indiscernibles, via realAbsZeroInv and the group law
def realDistZeroInv : (u : El Real) (v : El Real) →
  (realDist u v ≡ realZero ∈ El Real) → u ≡ v ∈ El Real using (real.Real.unfold, realAbs.realAbs.eq, realGroup.realSub.eq, realMetric.realDist.eq) ≔
  λu. λv. λh. realSubZeroInv u v (realAbsZeroInv (realSub u v) h)

-- the triangle inequality: |·| adds along the three-term split
def realDistTriangle : (u : El Real) (v : El Real) (w : El Real) →
  Prf (LeR (realDist u w) (realAdd (realDist u v) (realDist v w)))
  using (real.Real.unfold, realAbs.realAbs.eq, realAbs.realAbs.unfold, realAdd.realAdd.eq, realAdd.realAdd.unfold, realGroup.realSub.eq, realGroup.realSub.unfold, realMetric.realDist.eq, realMetric.realDist.unfold, realOrder.LeR.unfold) ≔
  λu. λv. λw.
    transportP Real
      (λt. LeR t (realAdd (realAbs (realSub u v)) (realAbs (realSub v w))))
      (realAbs (realAdd (realSub u v) (realSub v w)))
      (realDist u w)
      (cong Real (λt. Real) (λt. realAbs t)
         (realAdd (realSub u v) (realSub v w)) (realSub u w)
         (realSubVia u v w))
      (leRAbsTriangle (realSub u v) (realSub v w))
