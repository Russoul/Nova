-- THE QUOTIENT GROUP G/N — carrier and operation.
--
-- The carrier is the plain quotient of G by the coset relation. What
-- takes work is the OPERATION, and this module is where the corpus's
-- quotient machinery is finally exercised on a NON-COMMUTATIVE
-- structure.
--
-- A binary operation on a quotient descends by a NESTED quot-elim and
-- so owes TWO well-definedness proofs: an inner one (the second
-- argument moves) and an outer one (the first argument moves). Every
-- other instance in this corpus — realAdd, realMul, realLattice,
-- realSeq, rationalQ — discharges the outer one by COMMUTING, through
-- realSeq.wdOuterOfComm or its ℚ-level twin: prove the inner case,
-- then swap. A group has no commutativity to swap with, so both halves
-- are proved here directly, and the two turn out to be genuinely
-- different statements:
--
--   INNER   b ~ b' ⟹ a·b ~ a·b'   is   (a·b)·(a·b')⁻¹ = a·(b·b'⁻¹)·a⁻¹,
--           the hypothesis CONJUGATED by a. It holds exactly because N
--           is NORMAL, and this is the only place normality is used.
--
--   OUTER   a ~ a' ⟹ a·b ~ a'·b   is   (a·b)·(a'·b)⁻¹ = a·a'⁻¹,
--           the hypothesis UNCHANGED — b and b⁻¹ annihilate in the
--           middle. It needs no normality at all, and would hold for
--           any subgroup.
--
-- So the half the rest of the corpus gets for free is here the half
-- that is free for a different reason, and the half that looks routine
-- is the one carrying the mathematical content. Commuting had been
-- hiding the asymmetry, not exploiting it.

import id (Id, eqToId)
import monoid (IsMonoid)
import group (IsGroup)
import groupTheory (· as gop, e as ge, ⁻¹ as ginv)
import (groupTheory g) (·, e, ⁻¹, gAssoc, gUnitL, gUnitR, gInvL, gInvR, gCancelInner, gCancelInnerInv, gCancelOuter, gCancelOuterInv, gInvUniq, gInvInv, gInvUnit, gOpInv, gCancelL, gCancelR)
import (subgroup g) (IsSubgroup, IsNormal, sgUnit, sgOp, sgInv, nmConj, nmConjInv, cosetRel, cosetRefl, cosetSymm, cosetTrans, cosetFlip, cosetSplice)
import quotEffective (classEqOfRel, effectiveAtEquiv)
import equality (transportP, sym, trans, cong)

module {G : 𝕌} (g : El (IsGroup G)) (N : El G → Ω)

def QGroup : 𝕌 ≔ G / (x y. cosetRel N x y)

-- The class map, NAMED. It is `class` and nothing else, and one could
-- write `class` everywhere instead — except in the well-definedness
-- lemmas below, where the name is load-bearing.
--
-- A discharge candidate binds its parameters by matching its two
-- SIDES; the equation's type is not matched (there is no type slot on
-- a candidate). A lemma stated as
--
--   class (gop G g a b) ≡ class (gop G g a b') ∈ El (QGroup)
--
-- therefore binds G, g, a, b, b' — and never N, which occurs only in
-- the type. An unbound parameter that is not ≡-, 𝟙- or Prf-typed
-- cannot be completed, so the candidate is unusable and the descent's
-- well-definedness obligation is reported with no hint. Routing the
-- two sides through `qcls` puts N back where the matcher can
-- see it, and the same lemma then fires.
--
-- The mirror image holds one step later: a quot-elim substitutes the
-- BARE `class a` for its method binder, so the lemmas that say what
-- the descended operations DO on classes (qMulCls, qInvCls) have to be
-- stated with bare `class`. Both spellings are needed, for opposite
-- reasons.
def qcls : El G → El QGroup using (QGroup.unfold) ≔ λa. class a

-- EFFECTIVITY. quotEffective.nova's point is that class equality gives
-- back the equivalence CLOSURE of the relation, not the relation —
-- unless the relation already is an equivalence. subgroup.nova proved
-- that the coset relation is one, so here effectivity holds on the
-- nose and the quotient's equality IS "differ by an element of N".
def qclsEq : Prf (IsSubgroup N) → (a b : El G) → Prf (cosetRel N a b) → qcls a ≡ qcls b
  using (qcls.eq) ≔
  λs. λa. λb. λh. classEqOfRel (cosetRel N) _ _ h

def qclsEffective : Prf (IsSubgroup N) → (a b : El G) → Prf (qcls a ≡ qcls b) → Prf (cosetRel N a b)
  using (qcls.eq) ≔
  λs. effectiveAtEquiv (cosetRel N) (cosetRefl s) (cosetTrans s) (cosetSymm s)

-- ===== the algebra behind the two halves =====
-- INNER:  (a·b)·(a·b')⁻¹  =  a · ((b·b'⁻¹) · a⁻¹)
def qMulInnerAlg : {a b b' : El G} → a · (b · b' ⁻¹ · a ⁻¹) ≡ a · b · (a · b') ⁻¹ ≔
  λa. λb. λb'. a · (b · b' ⁻¹ · a ⁻¹)
      ≡⟨ cong (λw. G) (λw. a · w) (gAssoc b (b' ⁻¹) (a ⁻¹)) ⟩ a · (b · (b' ⁻¹ · a ⁻¹))
      ≡⟨ sym _ _ (gAssoc a b (b' ⁻¹ · a ⁻¹)) ⟩ a · b · (b' ⁻¹ · a ⁻¹)
      ≡⟨ cong (λw. G) (λw. a · b · w) (sym _ _ (gOpInv a b')) ⟩ a · b · (a · b') ⁻¹

-- OUTER:  (a·b)·(a'·b)⁻¹  =  a·a'⁻¹
def qMulOuterAlg : (a a' b : El G) → a · b · (a' · b) ⁻¹ ≡ a · a' ⁻¹ ≔
  λa. λa'. λb. a · b · (a' · b) ⁻¹
      ≡⟨ cong (λw. G) (λw. a · b · w) (gOpInv a' b) ⟩ a · b · (b ⁻¹ · a' ⁻¹)
      ≡⟨ gAssoc a b (b ⁻¹ · a' ⁻¹) ⟩ a · (b · (b ⁻¹ · a' ⁻¹))
      ≡⟨ cong (λw. G) (λw. a · w) (gCancelInner b (a' ⁻¹)) ⟩ a · a' ⁻¹

-- ===== the two well-definedness proofs, at relation level =====
def qMulWDInner : Prf (IsNormal
  N) → {a b b' : El G} → Prf (cosetRel N b b') → Prf (cosetRel N (a · b) (a · b'))
  using (cosetRel.eq) ≔
  λnn. λa. λb. λb'. λh. transportP
    N
    {a · (b · b' ⁻¹ · a ⁻¹)}
    {a · b · (a · b') ⁻¹}
    qMulInnerAlg
    (nmConj _ nn a (b · b' ⁻¹) h)

def qMulWDOuter : {a a' b : El G} → Prf (cosetRel N a a') → Prf (cosetRel N (a · b) (a' · b))
  using (cosetRel.eq) ≔
  λa. λa'. λb. λh. transportP N (sym _ _ (qMulOuterAlg a a' b)) h

-- ===== the same two, at class level =====
def qMulWDInnerCls : Prf (IsNormal
  N) → (a b b' : El G) → Prf (cosetRel N b b') → qcls (a · b) ≡ qcls (a · b')
  using (qcls.eq) ≔
  λnn. λa. λb. λb'. λh. classEqOfRel (cosetRel N) (a · b) (a · b') (qMulWDInner nn h)

def qMulWDOuterCls : {a a' b : El G} → Prf (cosetRel N a a') → qcls (a · b) ≡ qcls (a' · b)
  using (qcls.eq) ≔
  λa. λa'. λb. λh. classEqOfRel (cosetRel N) (a · b) (a' · b) (qMulWDOuter h)

-- the outer half as the descent itself asks for it: the two inner
-- eliminations agree on every element of the quotient. Where realMul
-- writes `wdOuterOfComm rMul rMulComm rMulWDInnerCls`, this is the
-- honest version — a quot-elim at an ≡-motive whose method is the
-- class-level outer proof
def qMulWDOuterElim : Prf (IsNormal
  N)
  → (x x' : El G)
    → Prf (cosetRel
      N
      x
      x')
      → (v : El QGroup)
        → quot-elim (w. El QGroup) (q. qcls (x · q)) v ≡ quot-elim (q. qcls (x' · q)) v
  using (QGroup.unfold, qMulWDInnerCls) ≔
  λnn. λx. λx'. λh. λv. quot-elim (w. quot-elim (z. El QGroup)
    (q. qcls (x · q))
    w ≡ quot-elim (q. qcls (x' · q)) w)
    (c. qMulWDOuterCls h)
    v

-- ===== the descended operation =====
def qMul : Prf (IsNormal N) → El QGroup → El QGroup → El QGroup
  using (QGroup.unfold, qMulWDInnerCls, qMulWDOuterElim) ≔
  λnn. λu. λv. quot-elim (p. quot-elim (q. qcls (p · q)) v) u

-- β on classes. Stated with the BARE `class`, not with qcls: a
-- quot-elim substitutes `class a` for its method binder, so this is
-- the spelling every goal below is actually in. (The well-definedness
-- lemmas above must go the other way — see the note at qcls.)
def qMulCls : (nn : Prf (IsNormal N)) (a b : El G) → qMul nn (class a) (class b) ≡ class (a · b)
  using (QGroup.unfold, qcls.eq, qMul.eq) ≔
  λnn. λa. λb. ⋆

-- ===== the inverse descends =====
--
-- The relation-level statement is  a ~ a' ⟹ a⁻¹ ~ a'⁻¹,  i.e.
-- a·a'⁻¹ ∈ N ⟹ a⁻¹·a' ∈ N. Read the second as the FIRST turned round
-- (a'·a⁻¹ ∈ N, by symmetry of the coset relation) and then conjugated
-- by a⁻¹: normality again, in nmConjInv's inverse-side spelling.
def qInvAlg : {a a' : El G} → a ⁻¹ · (a' · a ⁻¹ · a) ≡ a ⁻¹ · a' ⁻¹ ⁻¹ ≔
  λa. λa'. a ⁻¹ · (a' · a ⁻¹ · a)
      ≡⟨ cong (λw. G) (λw. a ⁻¹ · w) (gCancelOuterInv a a') ⟩ a ⁻¹ · a'
      ≡⟨ cong (λw. G) (λw. a ⁻¹ · w) (sym _ _ (gInvInv a')) ⟩ a ⁻¹ · a' ⁻¹ ⁻¹

def qInvWD : Prf (IsSubgroup
  N) → Prf (IsNormal N) → {a a' : El G} → Prf (cosetRel N a a') → Prf (cosetRel N (a ⁻¹) (a' ⁻¹))
  using (cosetRel.eq) ≔
  λs. λnn. λa. λa'. λh. transportP
    N
    {a ⁻¹ · (a' · a ⁻¹ · a)}
    {a ⁻¹ · a' ⁻¹ ⁻¹}
    qInvAlg
    (nmConjInv _ nn a (a' · a ⁻¹) (cosetSymm s _ _ h))

def qInvWDCls : Prf (IsSubgroup
  N) → Prf (IsNormal N) → (a a' : El G) → Prf (cosetRel N a a') → qcls (a ⁻¹) ≡ qcls (a' ⁻¹)
  using (qcls.eq) ≔
  λs. λnn. λa. λa'. λh. classEqOfRel (cosetRel N) _ _ (qInvWD s nn h)

def qInv : Prf (IsSubgroup N) → Prf (IsNormal N) → El QGroup → El QGroup
  using (QGroup.unfold, qInvWDCls) ≔
  λs. λnn. λu. quot-elim (a. qcls (a ⁻¹)) u

def qInvCls : (s : Prf (IsSubgroup N))
  (nn : Prf (IsNormal N))
  (a : El G)
  → qInv s nn (class a) ≡ class (a ⁻¹)
  using (QGroup.unfold, qcls.eq, qInv.eq) ≔
  λs. λnn. λa. ⋆

def qUnit : El QGroup using (QGroup.unfold) ≔ class e

-- ===== the group laws, each a descent into an Ω-valued motive =====
--
-- These are the corpus's first uses of the `<lemma>.rw` license. The
-- discharge engine does NOT rewrite with store lemmas by default: a
-- cited lemma is available for WHOLE-EQUATION match and for hops, and
-- rwNfElem only runs at all when the site cites `hyp.rw` or some
-- `<lemma>.rw`. Everything in groupTheory.nova and subgroup.nova gets
-- by on whole-equation match plus congruence descent, which is why no
-- .rw appears before this point. Here it is unavoidable: the base case
-- of every law has qMul applied to two classes NESTED inside another
-- qMul, and only a rewrite reaches the inner one. `qMulCls.rw` does
-- exactly that and nothing else.
--
-- The last step of each base case is an explicit `cong` rather than a
-- ⋆. Class-congruence in the engine (spCongC) accepts only STEP-FREE
-- evidence — pure computation — because the component's type is not
-- known there, so `class X ≐ class Y` never closes by a lemma about
-- X and Y. Naming the congruence is the whole fix, and it is the same
-- move groupTheory.nova needed against gAssoc.
--
-- Every law below is an EQUATION, hence Ω-valued, hence its quot-elim
-- owes no well-definedness proof at all: proof irrelevance closes the
-- coherence outright (el-prf-prop). That is the whole difference
-- between milestone 2 and this one — descending DATA costs two honest
-- proofs, descending a PROPOSITION costs nothing, and the corpus's
-- Ω/𝕌 split is what makes the second half free.
def qAssoc : (nn : Prf (IsNormal N))
  (u v w : El QGroup)
  → qMul nn (qMul nn u v) w ≡ qMul nn u (qMul nn v w)
  using (QGroup.unfold, qMulCls.rw) ≔
  λnn. λu. λv. λw. quot-elim
    (a. quot-elim
      (b. quot-elim
        (c. trans
          _
          _
          _
          ⋆
          (trans
            _
            _
            (qMul nn (class a) (qMul nn (class b) (class c)))
            (cong (λw. QGroup) (λw. class w) (gAssoc a b c))
            ⋆))
        w)
      v)
    u

def qUnitL : (nn : Prf (IsNormal N)) (u : El QGroup) → qMul nn qUnit u ≡ u
  using (QGroup.unfold, qUnit.eq, qMulCls.rw) ≔
  λnn. λu. quot-elim (a. trans _ _ _ ⋆ (cong (λw. QGroup) (λw. class w) (gUnitL a))) u

def qUnitR : (nn : Prf (IsNormal N)) (u : El QGroup) → qMul nn u qUnit ≡ u
  using (QGroup.unfold, qUnit.eq, qMulCls.rw) ≔
  λnn. λu. quot-elim (a. trans _ _ _ ⋆ (cong (λw. QGroup) (λw. class w) (gUnitR a))) u

def qInvLaw : (s : Prf (IsSubgroup N))
  (nn : Prf (IsNormal N))
  (u : El QGroup)
  → qMul nn (qInv s nn u) u ≡ qUnit
  using (QGroup.unfold, qUnit.eq, qInvCls.rw, qMulCls.rw) ≔
  λs. λnn. λu. quot-elim (a. trans _ _ _ ⋆ (cong (λw. QGroup) (λw. class w) (gInvL a))) u

def qInvLawR : (s : Prf (IsSubgroup N))
  (nn : Prf (IsNormal N))
  (u : El QGroup)
  → qMul nn u (qInv s nn u) ≡ qUnit
  using (QGroup.unfold, qUnit.eq, qInvCls.rw, qMulCls.rw) ≔
  λs. λnn. λu. quot-elim (a. trans _ _ _ ⋆ (cong (λw. QGroup) (λw. class w) (gInvR a))) u

-- ===== G/N is a group =====
def qIsGroup : Prf (IsSubgroup N) → Prf (IsNormal N) → El (IsGroup QGroup)
  using (group.IsGroup.unfold, monoid.IsMonoid.unfold) ≔
  λs. λnn. (qMul
    nn,
    qUnit,
      (λx. λy. λz. eqToId
        _
        _
        (qAssoc
          nn
          x
          y
          z)),
        (λx. eqToId
          _
          _
          (qUnitL
            nn
            x)),
          λx. eqToId
            _
            _
            (qUnitR
              nn
              x)), qInv s nn, (λx. eqToId _ _ (qInvLaw s nn x)), λx. eqToId _ _ (qInvLawR s nn x)

def qMonoid : Prf (IsSubgroup N) → Prf (IsNormal N) → El (IsMonoid QGroup)
  using (group.IsGroup.unfold) ≔
  λs. λnn. qIsGroup s nn .π₁

-- ===== the quotient's universal property, at FUNCTION level =====
--
-- Before any homomorphism: a map out of G/N is exactly a map out of G
-- that is constant on cosets. This is bracket.nova's brElim with a
-- non-trivial relation in place of ∥𝟙∥, and it is stated here because
-- it is where the constancy proof is CHEAPEST to discharge — `c` is a
-- context hypothesis of the very shape the quot-elim's well-definedness
-- goal has, so the engine finds it without any of B-21's parameter
-- bookkeeping. Every later factorisation goes through this one and
-- never writes a quot-elim of its own.
def qFactor : {H : 𝕌}
  (k : El G → El H)
  (c : (a a' : El G) → Prf (cosetRel N a a') → k a ≡ k a')
  (u : El QGroup)
  → El H
  using (QGroup.unfold) ≔
  λH. λk. λc. λu. quot-elim (a. k a) u

def qFactorCls : (H : 𝕌)
  (k : El G → El H)
  (c : (a a' : El G) → Prf (cosetRel N a a') → k a ≡ k a')
  (a : El G)
  → qFactor k c (class a) ≡ k a
  using (QGroup.unfold, qFactor.eq) ≔
  λH. λk. λc. λa. ⋆

-- UNIQUENESS: qFactor is the ONLY map agreeing with k on classes.
-- Stated as an η-rule, exactly as bracket.brEta is: any phi out of the
-- quotient is recovered from its own restriction along the class map.
def qFactorEta : (H : 𝕌)
  (phi : El QGroup → El H)
  (c : (a a' : El G) → Prf (cosetRel N a a') → phi (class a) ≡ phi (class a'))
  (u : El QGroup)
  → qFactor (λa. phi (class a)) c u ≡ phi u
  using (QGroup.unfold, qFactor.eq) ≔
  λH. λphi. λc. λu. quot-elim (a. ⋆) u

-- and the form uniqueness is usually wanted in: two maps out of G/N
-- that agree on every class are equal
def qFactorUnique : (H : 𝕌)
  (phi psi : El QGroup → El H)
  → ((a : El G) → phi (class a) ≡ psi (class a)) → (u : El QGroup) → phi u ≡ psi u
  using (QGroup.unfold) ≔
  λH. λphi. λpsi. λe. λu. quot-elim (a. e a) u

-- ===== the abstract structure on the quotient IS the quotient structure =====
def qopIsQMul : (s : Prf (IsSubgroup N))
  (nn : Prf (IsNormal N))
  (u v : El QGroup)
  → gop (qIsGroup s nn) u v ≡ qMul nn u v
  using (groupTheory.·.eq, qIsGroup.eq) ≔
  λs. λnn. λu. λv. ⋆

def qeIsQUnit : (s : Prf (IsSubgroup N)) (nn : Prf (IsNormal N)) → ge (qIsGroup s nn) ≡ qUnit
  using (groupTheory.e.eq, qIsGroup.eq) ≔
  λs. λnn. ⋆

def qinvIsQInv : (s : Prf (IsSubgroup N))
  (nn : Prf (IsNormal N))
  (u : El QGroup)
  → ginv (qIsGroup s nn) u ≡ qInv s nn u
  using (groupTheory.⁻¹.eq, qIsGroup.eq) ≔
  λs. λnn. λu. ⋆

-- ===== the quotient homomorphism π : G → G/N =====
def qProjLaw : (s : Prf (IsSubgroup N))
  (nn : Prf (IsNormal N))
  (x y : El G)
  → qcls (x · y) ≡ gop (qIsGroup s nn) (qcls x) (qcls y)
  using (quotGroup.qcls.eq) ≔
  λs. λnn. λx. λy. trans
    _
    _
    _
    (sym (qMul nn (qcls x) (qcls y)) (qcls (x · y)) (qMulCls nn x y))
    (sym _ _ (qopIsQMul s nn (qcls x) (qcls y)))
