-- THE QUOTIENT GROUP G/N — carrier and operation.
--
-- The carrier is the plain quotient of G by the coset relation. What
-- takes work is the OPERATION, and this module is where the corpus's
-- quotient machinery is finally exercised on a NON-COMMUTATIVE
-- structure.
--
-- A binary operation on a quotient descends by a NESTED quot-elim and
-- so owes TWO well-definedness proofs: an inner one (the second
-- argument moves) and an outer one (the first argument moves). Every
-- other instance in this corpus — realAdd, realMul, realLattice,
-- realSeq, rationalQ — discharges the outer one by COMMUTING, through
-- realSeq.wdOuterOfComm or its ℚ-level twin: prove the inner case,
-- then swap. A group has no commutativity to swap with, so both halves
-- are proved here directly, and the two turn out to be genuinely
-- different statements:
--
--   INNER   b ~ b' ⟹ a·b ~ a·b'   is   (a·b)·(a·b')⁻¹ = a·(b·b'⁻¹)·a⁻¹,
--           the hypothesis CONJUGATED by a. It holds exactly because N
--           is NORMAL, and this is the only place normality is used.
--
--   OUTER   a ~ a' ⟹ a·b ~ a'·b   is   (a·b)·(a'·b)⁻¹ = a·a'⁻¹,
--           the hypothesis UNCHANGED — b and b⁻¹ annihilate in the
--           middle. It needs no normality at all, and would hold for
--           any subgroup.
--
-- So the half the rest of the corpus gets for free is here the half
-- that is free for a different reason, and the half that looks routine
-- is the one carrying the mathematical content. Commuting had been
-- hiding the asymmetry, not exploiting it.

import id (Id, eqToId)
import monoid (IsMonoid)
import group (IsGroup)
import groupTheory (gop, ge, ginv, gAssoc, gUnitL, gUnitR, gInvL, gInvR, gCancelInner, gCancelInnerInv, gCancelOuter, gCancelOuterInv, gInvUniq, gInvInv, gInvUnit, gOpInv, gCancelL, gCancelR)
import subgroup (IsSubgroup, IsNormal, sgUnit, sgOp, sgInv, nmConj, nmConjInv, cosetRel, cosetRefl, cosetSymm, cosetTrans, cosetFlip, cosetSplice)
import quotEffective (classEqOfRel, effectiveAtEquiv)
import equality (transportP, sym, trans, cong)

def QGroup : (G : 𝕌) (g : El (IsGroup G)) (N : El G → Ω) → 𝕌 ≔
  λG. λg. λN. G / (x y. cosetRel _ g N x y)

-- The class map, NAMED. It is `class` and nothing else, and one could
-- write `class` everywhere instead — except in the well-definedness
-- lemmas below, where the name is load-bearing.
--
-- A discharge candidate binds its parameters by matching its two
-- SIDES; the equation's type is not matched (there is no type slot on
-- a candidate). A lemma stated as
--
--   class (gop G g a b) ≡ class (gop G g a b') ∈ El (QGroup G g N)
--
-- therefore binds G, g, a, b, b' — and never N, which occurs only in
-- the type. An unbound parameter that is not ≡-, 𝟙- or Prf-typed
-- cannot be completed, so the candidate is unusable and the descent's
-- well-definedness obligation is reported with no hint. Routing the
-- two sides through `qcls G g N` puts N back where the matcher can
-- see it, and the same lemma then fires.
--
-- The mirror image holds one step later: a quot-elim substitutes the
-- BARE `class a` for its method binder, so the lemmas that say what
-- the descended operations DO on classes (qMulCls, qInvCls) have to be
-- stated with bare `class`. Both spellings are needed, for opposite
-- reasons.
def qcls : (G : 𝕌) (g : El (IsGroup G)) (N : El G → Ω) → El G → El (QGroup _ g N)
  using (QGroup.unfold) ≔
  λG. λg. λN. λa. class a

-- EFFECTIVITY. quotEffective.nova's point is that class equality gives
-- back the equivalence CLOSURE of the relation, not the relation —
-- unless the relation already is an equivalence. subgroup.nova proved
-- that the coset relation is one, so here effectivity holds on the
-- nose and the quotient's equality IS "differ by an element of N".
def qclsEq : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup _ g N) → (a b : El G) → Prf (cosetRel _ g N a b) → qcls _ g N a ≡ qcls _ _ _ b
  using (qcls.eq) ≔
  λG. λg. λN. λs. λa. λb. λh. classEqOfRel _ (cosetRel _ g N) _ _ h

def qclsEffective : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsSubgroup
    _
    g
    N) → (a b : El G) → Prf (qcls _ g N a ≡ qcls _ _ _ b) → Prf (cosetRel _ g N a b)
  using (qcls.eq) ≔
  λG. λg. λN. λs. effectiveAtEquiv
    _
    (cosetRel _ g N)
    (cosetRefl _ _ _ s)
    (cosetTrans _ _ _ s)
    (cosetSymm _ _ _ s)

-- ===== the algebra behind the two halves =====
-- INNER:  (a·b)·(a·b')⁻¹  =  a · ((b·b'⁻¹) · a⁻¹)
def qMulInnerAlg : {G : 𝕌}
  {g : El (IsGroup G)}
  {a b b' : El G}
  → gop
    _
    g
    a
    (gop
      _
      g
      (gop _ g b (ginv _ g b'))
      (ginv _ g a)) ≡ gop _ g (gop _ g a b) (ginv _ g (gop _ g a b')) ≔
  λG. λg. λa. λb. λb'. gop _ g a (gop _ g (gop _ g b (ginv _ g b')) (ginv _ g a))
      ≡⟨ cong
        (λw. G)
        (λw. gop G g a w)
        (gAssoc
          _
          g
          b
          (ginv _ g b')
          (ginv _ g a)) ⟩ gop _ g a (gop _ g b (gop _ g (ginv _ g b') (ginv _ g a)))
      ≡⟨ sym
        _
        _
        _
        (gAssoc
          _
          g
          a
          b
          (gop
            _
            g
            (ginv _ g b')
            (ginv _ g a))) ⟩ gop _ g (gop _ g a b) (gop _ g (ginv _ g b') (ginv _ g a))
      ≡⟨ cong
        (λw. G)
        (λw. gop G g (gop _ g a b) w)
        (sym _ _ _ (gOpInv _ g a b')) ⟩ gop _ g (gop _ g a b) (ginv _ g (gop _ g a b'))

-- OUTER:  (a·b)·(a'·b)⁻¹  =  a·a'⁻¹
def qMulOuterAlg : (G : 𝕌)
  (g : El (IsGroup G))
  (a a' b : El G)
  → gop _ g (gop _ g a b) (ginv _ g (gop _ g a' b)) ≡ gop _ g a (ginv _ g a') ≔
  λG. λg. λa. λa'. λb. gop _ g (gop _ g a b) (ginv _ g (gop _ g a' b))
      ≡⟨ cong
        (λw. G)
        (λw. gop G g (gop _ g a b) w)
        (gOpInv _ g a' b) ⟩ gop _ g (gop _ g a b) (gop _ g (ginv _ g b) (ginv _ g a'))
      ≡⟨ gAssoc
        _
        g
        a
        b
        (gop
          _
          g
          (ginv _ g b)
          (ginv _ g a')) ⟩ gop _ g a (gop _ g b (gop _ g (ginv _ g b) (ginv _ g a')))
      ≡⟨ cong (λw. G) (λw. gop G g a w) (gCancelInner _ g b (ginv _ g a')) ⟩ gop _ g a (ginv _ g a')

-- ===== the two well-definedness proofs, at relation level =====
def qMulWDInner : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsNormal
    _
    g
    N)
    → {a b b' : El G}
      → Prf (cosetRel _ g N b b') → Prf (cosetRel _ g N (gop _ g a b) (gop _ g a b'))
  using (cosetRel.eq) ≔
  λG. λg. λN. λnn. λa. λb. λb'. λh. transportP
    _
    N
    _
    (gop _ g (gop _ g a b) (ginv _ g (gop _ g a b')))
    qMulInnerAlg
    (nmConj _ _ _ nn a (gop _ g b (ginv _ g b')) h)

def qMulWDOuter : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  {a a' b : El G}
  → Prf (cosetRel _ g N a a') → Prf (cosetRel _ g N (gop _ g a b) (gop _ g a' b))
  using (cosetRel.eq) ≔
  λG. λg. λN. λa. λa'. λb. λh. transportP _ N _ _ (sym _ _ _ (qMulOuterAlg _ g a a' b)) h

-- ===== the same two, at class level =====
def qMulWDInnerCls : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsNormal
    _
    g
    N)
    → (a b b' : El G)
      → Prf (cosetRel _ g N b b') → qcls _ g N (gop _ g a b) ≡ qcls _ _ _ (gop _ g a b')
  using (qcls.eq) ≔
  λG. λg. λN. λnn. λa. λb. λb'. λh. classEqOfRel
    _
    (cosetRel _ g N)
    (gop _ g a b)
    (gop _ g a b')
    (qMulWDInner nn h)

def qMulWDOuterCls : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  {a a' b : El G}
  → Prf (cosetRel _ g N a a') → qcls _ g N (gop _ g a b) ≡ qcls _ _ _ (gop _ g a' b)
  using (qcls.eq) ≔
  λG. λg. λN. λa. λa'. λb. λh. classEqOfRel
    _
    (cosetRel _ g N)
    (gop _ g a b)
    (gop _ g a' b)
    (qMulWDOuter h)

-- the outer half as the descent itself asks for it: the two inner
-- eliminations agree on every element of the quotient. Where realMul
-- writes `wdOuterOfComm rMul rMulComm rMulWDInnerCls`, this is the
-- honest version — a quot-elim at an ≡-motive whose method is the
-- class-level outer proof
def qMulWDOuterElim : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsNormal
    _
    g
    N)
    → (x x' : El G)
      → Prf (cosetRel
        _
        g
        N
        x
        x')
        → (v : El (QGroup _ g N))
          → quot-elim (w. El (QGroup _ g N))
            (q. qcls _ _ _ (gop _ g x q))
            v ≡ quot-elim (q. qcls _ _ _ (gop _ g x' q)) v
  using (QGroup.unfold, qMulWDInnerCls) ≔
  λG. λg. λN. λnn. λx. λx'. λh. λv. quot-elim (w. quot-elim (z. El (QGroup _ g N))
    (q. qcls _ _ _ (gop _ g x q))
    w ≡ quot-elim (q. qcls _ _ _ (gop _ g x' q)) w)
    (c. qMulWDOuterCls h)
    v

-- ===== the descended operation =====
def qMul : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsNormal _ g N) → El (QGroup _ g N) → El (QGroup _ g N) → El (QGroup _ g N)
  using (QGroup.unfold, qMulWDInnerCls, qMulWDOuterElim) ≔
  λG. λg. λN. λnn. λu. λv. quot-elim (p. quot-elim (q. qcls _ _ _ (gop _ g p q)) v) u

-- β on classes. Stated with the BARE `class`, not with qcls: a
-- quot-elim substitutes `class a` for its method binder, so this is
-- the spelling every goal below is actually in. (The well-definedness
-- lemmas above must go the other way — see the note at qcls.)
def qMulCls : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (nn : Prf (IsNormal _ g N))
  (a b : El G)
  → qMul _ _ _ nn (class a) (class b) ≡ class (gop _ g a b)
  using (QGroup.unfold, qcls.eq, qMul.eq) ≔
  λG. λg. λN. λnn. λa. λb. ⋆

-- ===== the inverse descends =====
--
-- The relation-level statement is  a ~ a' ⟹ a⁻¹ ~ a'⁻¹,  i.e.
-- a·a'⁻¹ ∈ N ⟹ a⁻¹·a' ∈ N. Read the second as the FIRST turned round
-- (a'·a⁻¹ ∈ N, by symmetry of the coset relation) and then conjugated
-- by a⁻¹: normality again, in nmConjInv's inverse-side spelling.
def qInvAlg : {G : 𝕌}
  {g : El (IsGroup G)}
  {a a' : El G}
  → gop
    _
    g
    (ginv _ g a)
    (gop _ g (gop _ g a' (ginv _ g a)) a) ≡ gop _ g (ginv _ g a) (ginv _ g (ginv _ g a')) ≔
  λG. λg. λa. λa'. gop _ g (ginv _ g a) (gop _ g (gop _ g a' (ginv _ g a)) a)
      ≡⟨ cong
        (λw. G)
        (λw. gop G g (ginv _ g a) w)
        (gCancelOuterInv _ g a a') ⟩ gop _ g (ginv _ g a) a'
      ≡⟨ cong
        (λw. G)
        (λw. gop G g (ginv _ g a) w)
        (sym _ _ _ (gInvInv _ g a')) ⟩ gop _ g (ginv _ g a) (ginv _ g (ginv _ g a'))

def qInvWD : {G : 𝕌}
  {g : El (IsGroup G)}
  {N : El G → Ω}
  → Prf (IsSubgroup
    _
    g
    N)
    → Prf (IsNormal
      _
      g
      N)
      → {a a' : El G} → Prf (cosetRel _ g N a a') → Prf (cosetRel _ g N (ginv _ g a) (ginv _ g a'))
  using (cosetRel.eq) ≔
  λG. λg. λN. λs. λnn. λa. λa'. λh. transportP
    _
    N
    _
    (gop _ g (ginv _ g a) (ginv _ g (ginv _ g a')))
    qInvAlg
    (nmConjInv _ _ _ nn a (gop _ g a' (ginv _ g a)) (cosetSymm _ _ _ s _ _ h))

def qInvWDCls : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsSubgroup
    _
    g
    N)
    → Prf (IsNormal
      _
      g
      N)
      → (a a' : El G)
        → Prf (cosetRel _ g N a a') → qcls _ g N (ginv _ g a) ≡ qcls _ _ _ (ginv _ g a')
  using (qcls.eq) ≔
  λG. λg. λN. λs. λnn. λa. λa'. λh. classEqOfRel _ (cosetRel _ g N) _ _ (qInvWD s nn h)

def qInv : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsSubgroup _ g N) → Prf (IsNormal _ g N) → El (QGroup _ g N) → El (QGroup _ g N)
  using (QGroup.unfold, qInvWDCls) ≔
  λG. λg. λN. λs. λnn. λu. quot-elim (a. qcls _ _ _ (ginv _ g a)) u

def qInvCls : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (s : Prf (IsSubgroup _ g N))
  (nn : Prf (IsNormal _ g N))
  (a : El G)
  → qInv _ _ _ s nn (class a) ≡ class (ginv _ g a)
  using (QGroup.unfold, qcls.eq, qInv.eq) ≔
  λG. λg. λN. λs. λnn. λa. ⋆

def qUnit : (G : 𝕌) (g : El (IsGroup G)) (N : El G → Ω) → El (QGroup _ g N) using (QGroup.unfold) ≔
  λG. λg. λN. class (ge g)

-- ===== the group laws, each a descent into an Ω-valued motive =====
--
-- These are the corpus's first uses of the `<lemma>.rw` license. The
-- discharge engine does NOT rewrite with store lemmas by default: a
-- cited lemma is available for WHOLE-EQUATION match and for hops, and
-- rwNfElem only runs at all when the site cites `hyp.rw` or some
-- `<lemma>.rw`. Everything in groupTheory.nova and subgroup.nova gets
-- by on whole-equation match plus congruence descent, which is why no
-- .rw appears before this point. Here it is unavoidable: the base case
-- of every law has qMul applied to two classes NESTED inside another
-- qMul, and only a rewrite reaches the inner one. `qMulCls.rw` does
-- exactly that and nothing else.
--
-- The last step of each base case is an explicit `cong` rather than a
-- ⋆. Class-congruence in the engine (spCongC) accepts only STEP-FREE
-- evidence — pure computation — because the component's type is not
-- known there, so `class X ≐ class Y` never closes by a lemma about
-- X and Y. Naming the congruence is the whole fix, and it is the same
-- move groupTheory.nova needed against gAssoc.
--
-- Every law below is an EQUATION, hence Ω-valued, hence its quot-elim
-- owes no well-definedness proof at all: proof irrelevance closes the
-- coherence outright (el-prf-prop). That is the whole difference
-- between milestone 2 and this one — descending DATA costs two honest
-- proofs, descending a PROPOSITION costs nothing, and the corpus's
-- Ω/𝕌 split is what makes the second half free.
def qAssoc : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (nn : Prf (IsNormal _ g N))
  (u v w : El (QGroup _ g N))
  → qMul _ _ _ nn (qMul _ _ _ nn u v) w ≡ qMul _ _ _ nn u (qMul _ _ _ nn v w)
  using (QGroup.unfold, qMulCls.rw) ≔
  λG. λg. λN. λnn. λu. λv. λw. quot-elim
    (a. quot-elim
      (b. quot-elim
        (c. trans
          _
          _
          _
          _
          ⋆
          (trans
            _
            _
            _
            (qMul _ _ _ nn (class a) (qMul _ _ _ nn (class b) (class c)))
            (cong (λw. QGroup _ g N) (λw. class w) (gAssoc _ g a b c))
            ⋆))
        w)
      v)
    u

def qUnitL : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (nn : Prf (IsNormal _ g N))
  (u : El (QGroup _ g N))
  → qMul _ _ _ nn (qUnit _ g N) u ≡ u
  using (QGroup.unfold, qUnit.eq, qMulCls.rw) ≔
  λG. λg. λN. λnn. λu. quot-elim
    (a. trans _ _ _ _ ⋆ (cong (λw. QGroup _ g N) (λw. class w) (gUnitL _ g a)))
    u

def qUnitR : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (nn : Prf (IsNormal _ g N))
  (u : El (QGroup _ g N))
  → qMul _ _ _ nn u (qUnit _ g N) ≡ u
  using (QGroup.unfold, qUnit.eq, qMulCls.rw) ≔
  λG. λg. λN. λnn. λu. quot-elim
    (a. trans _ _ _ _ ⋆ (cong (λw. QGroup _ g N) (λw. class w) (gUnitR _ g a)))
    u

def qInvLaw : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (s : Prf (IsSubgroup _ g N))
  (nn : Prf (IsNormal _ g N))
  (u : El (QGroup _ g N))
  → qMul _ _ _ nn (qInv _ _ _ s nn u) u ≡ qUnit _ _ _
  using (QGroup.unfold, qUnit.eq, qInvCls.rw, qMulCls.rw) ≔
  λG. λg. λN. λs. λnn. λu. quot-elim
    (a. trans _ _ _ _ ⋆ (cong (λw. QGroup _ g N) (λw. class w) (gInvL _ g a)))
    u

def qInvLawR : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (s : Prf (IsSubgroup _ g N))
  (nn : Prf (IsNormal _ g N))
  (u : El (QGroup _ g N))
  → qMul _ _ _ nn u (qInv _ _ _ s nn u) ≡ qUnit _ _ _
  using (QGroup.unfold, qUnit.eq, qInvCls.rw, qMulCls.rw) ≔
  λG. λg. λN. λs. λnn. λu. quot-elim
    (a. trans _ _ _ _ ⋆ (cong (λw. QGroup _ g N) (λw. class w) (gInvR _ g a)))
    u

-- ===== G/N is a group =====
def qIsGroup : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsSubgroup _ g N) → Prf (IsNormal _ g N) → El (IsGroup (QGroup _ g N))
  using (group.IsGroup.unfold, monoid.IsMonoid.unfold) ≔
  λG. λg. λN. λs. λnn. (qMul
    _
    _
    _
    nn,
    qUnit
      _
      _
      _,
      (λx. λy. λz. eqToId
        _
        _
        (qAssoc
          _
          _
          _
          nn
          x
          y
          z)),
        (λx. eqToId
          _
          _
          (qUnitL
            _
            _
            _
            nn
            x)),
          λx. eqToId
            _
            _
            (qUnitR
              _
              _
              _
              nn
              x)),
    qInv
      _
      _
      _
      s
      nn,
      (λx. eqToId
        (qMul _ _ _ nn (qInv _ _ _ s nn x) x)
        (qUnit _ g N)
        (qInvLaw
          _
          _
          _
          s
          nn
          x)),
        λx. eqToId (qMul _ _ _ nn x (qInv _ _ _ s nn x)) (qUnit _ g N) (qInvLawR _ _ _ s nn x)

def qMonoid : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  → Prf (IsSubgroup _ g N) → Prf (IsNormal _ g N) → El (IsMonoid (QGroup _ g N))
  using (group.IsGroup.unfold) ≔
  λG. λg. λN. λs. λnn. qIsGroup _ _ _ s nn .π₁

-- ===== the quotient's universal property, at FUNCTION level =====
--
-- Before any homomorphism: a map out of G/N is exactly a map out of G
-- that is constant on cosets. This is bracket.nova's brElim with a
-- non-trivial relation in place of ∥𝟙∥, and it is stated here because
-- it is where the constancy proof is CHEAPEST to discharge — `c` is a
-- context hypothesis of the very shape the quot-elim's well-definedness
-- goal has, so the engine finds it without any of B-21's parameter
-- bookkeeping. Every later factorisation goes through this one and
-- never writes a quot-elim of its own.
def qFactor : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  {H : 𝕌}
  (k : El G → El H)
  (c : (a a' : El G) → Prf (cosetRel _ g N a a') → k a ≡ k a')
  (u : El (QGroup _ g N))
  → El H
  using (QGroup.unfold) ≔
  λG. λg. λN. λH. λk. λc. λu. quot-elim (a. k a) u

def qFactorCls : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (H : 𝕌)
  (k : El G → El H)
  (c : (a a' : El G) → Prf (cosetRel _ g N a a') → k a ≡ k a')
  (a : El G)
  → qFactor _ _ _ k c (class a) ≡ k a
  using (QGroup.unfold, qFactor.eq) ≔
  λG. λg. λN. λH. λk. λc. λa. ⋆

-- UNIQUENESS: qFactor is the ONLY map agreeing with k on classes.
-- Stated as an η-rule, exactly as bracket.brEta is: any phi out of the
-- quotient is recovered from its own restriction along the class map.
def qFactorEta : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (H : 𝕌)
  (phi : El (QGroup _ g N) → El H)
  (c : (a a' : El G) → Prf (cosetRel _ g N a a') → phi (class a) ≡ phi (class a'))
  (u : El (QGroup _ g N))
  → qFactor _ _ _ (λa. phi (class a)) c u ≡ phi u ∈ El H
  using (QGroup.unfold, qFactor.eq) ≔
  λG. λg. λN. λH. λphi. λc. λu. quot-elim (a. ⋆) u

-- and the form uniqueness is usually wanted in: two maps out of G/N
-- that agree on every class are equal
def qFactorUnique : (G : 𝕌)
  (g : El (IsGroup G))
  (N : El G → Ω)
  (H : 𝕌)
  (phi psi : El (QGroup _ g N) → El H)
  → ((a : El G) → phi (class a) ≡ psi (class a)) → (u : El (QGroup _ g N)) → phi u ≡ psi u
  using (QGroup.unfold) ≔
  λG. λg. λN. λH. λphi. λpsi. λe. λu. quot-elim (a. e a) u
