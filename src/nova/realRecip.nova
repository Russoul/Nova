-- THE RECIPROCAL of a POSITIVE real.
--
--   realRecip : (x : El Real) → El (PosR x) → El Real
--
-- This is where the MODULUS is unavoidable. √ could make do with a
-- nonnegative presentation, because its estimate only needed the
-- samples to be ≥ 0. 1/x needs them bounded AWAY from zero — a rate —
-- and a rate is exactly what PosR carries and what Prf (LtR 0 x)
-- cannot give up.
--
-- With modulus k, sample at
--
--   ψ n ≔ mulIdx C n,   C ≔ mulIdx (dbl k) (dbl k),  so ψ n + 1 = (2k+2)²(n+1)
--
-- Two things land exactly, and they are the same two facts:
--
--   * rBound (ψ m) (ψ n) = 1/(2k+2)² · rBound m n, so multiplying by
--     the bound (2k+2) twice — once for each reciprocal in the
--     difference identity — returns rBound m n on the nose.
--   * rBound (ψ n) (ψ n) ≤ 1/(2k+2), which is what makes every sample
--     at least 1/(2k+2) and hence invertible.

import nat (+, *)
import rationalQ (Q, +, *, qNeg, qZero, qOne, qAddComm, qAddAssoc, qAddNegR, qAddZeroR, qMulComm, qMulAssoc, qMulOneL, qMulOneR, qDistribL, qDistribR)
import rationalOrder (Sign, sPos, sgnQ, ≤, leQTrans, leQMulMono, leQPlusMonoL)
import ratBound (Bnd, bndEq, bndEqB, bndSubSym, bndVia, bndWeaken, bndOfBothLe, leQAdd, leQNegFlip, leQZeroOfNonNeg, qNegZeroQ)
import ratHalf (dbl, qInvHalf, leQZeroInvNat)
import ratNat (qOfNat, qOfNatAdd, qOfNatMul)
import ratCeil (leQZeroNat)
import ratArch (leQSubShift, leQAddShift, leQUnsquash)
import ratAbs (bndMul, leQZeroMul)
import ratSqrt (qMulInvNat, qInvNatMulIdx, qMulSwap3, qMulLeftComm)
import rationalAlgInv (qInv)
import ratInv (qInvDiff, leQInvBound, leQZeroInv, sgnQPosOfLe)
import real (Real, RSeq, REq, Regular, qInvNat, qInvNatPos, rBound, leQZeroBound, realOfQ, realZero)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, realEqOfREq)
import bracket (br, brElim)
import realOrder (≤)
import realMul (mulIdx, sucMulIdx, *)
import realPos (leQOneInv, PosR, PosPayload, posRep, posK, posBoundRep, posRepEq, reqOfClassEq)
import realRing (leQInvIdx, reqOfClose, bndDeep, leQZeroAdd)
import equality (trans, sym, cong, transport, transportP)

def recipC : ℕ → ℕ ≔ λk. mulIdx (dbl k) (dbl k)

def recipIdx : ℕ → ℕ → ℕ ≔ λk. λn. mulIdx (recipC k) n

def recipM : ℕ → El Q ≔ λk. qOfNat (S (dbl k))

def recipLo : ℕ → El Q ≔ λk. qInvNat (dbl k)

def recipLoPos : (k : ℕ) → sgnQ (recipLo k) ≡ sPos using (recipLo.eq) ≔ λk. qInvNatPos (dbl k)

def recipLoM : (k : ℕ) → recipLo k * recipM k ≡ qOne using (recipLo.eq, recipM.eq) ≔
  λk. trans
    Q
    (qInvNat (dbl k) * qOfNat (S (dbl k)))
    (qOfNat (S (dbl k)) * qInvNat (dbl k))
    qOne
    (qMulComm (qInvNat (dbl k)) (qOfNat (S (dbl k))))
    qMulInvNat

def leQZeroRecipM : (k : ℕ) → El (qZero ≤ recipM k) using (recipM.eq) ≔ λk. leQZeroNat (S (dbl k))

-- (2k+2)² is S C, so 1/(C+1) cancels it
def recipMSq : (k : ℕ) → recipM k * recipM k ≡ qOfNat (S (recipC k)) using (recipM.eq, recipC.eq) ≔
  λk. trans
    Q
    (qOfNat (S (dbl k)) * qOfNat (S (dbl k)))
    (qOfNat (S (dbl k) * S (dbl k)))
    (qOfNat (S (mulIdx (dbl k) (dbl k))))
    (qOfNatMul (S (dbl k)) (S (dbl k)))
    (cong
      ℕ
      (λw. Q)
      (λw. qOfNat w)
      (S (dbl k) * S (dbl k))
      (S (mulIdx (dbl k) (dbl k)))
      (sym ℕ (S (mulIdx (dbl k) (dbl k))) (S (dbl k) * S (dbl k)) (sucMulIdx (dbl k) (dbl k))))

-- ===== the scaling, exactly =====
def leQMulMonoL : {x y c : El Q} → El (x ≤ y) → El (qZero ≤ c) → El (c * x ≤ c * y) ≔
  λx. λy. λc. λh. λhc. transport
    Q
    (λw. w ≤ c * y)
    (x * c)
    (c * x)
    (qMulComm x c)
    (transport Q (λw. x * c ≤ w) (y * c) (c * y) (qMulComm y c) (leQMulMono x y h hc))

def rBoundRecipEq : (k m n : ℕ)
  → rBound (recipIdx k m) (recipIdx k n) ≡ qInvNat (recipC k) * rBound m n
  using (real.rBound.eq, recipIdx.eq) ≔
  λk. λm. λn. trans
    Q
    (qInvNat (mulIdx (recipC k) m) + qInvNat (mulIdx (recipC k) n))
    (qInvNat (recipC k) * qInvNat m + qInvNat (recipC k) * qInvNat n)
    (qInvNat (recipC k) * (qInvNat m + qInvNat n))
    (trans
      Q
      (qInvNat (mulIdx (recipC k) m) + qInvNat (mulIdx (recipC k) n))
      (qInvNat (recipC k) * qInvNat m + qInvNat (mulIdx (recipC k) n))
      (qInvNat (recipC k) * qInvNat m + qInvNat (recipC k) * qInvNat n)
      (cong
        Q
        (λw. Q)
        (λw. w + qInvNat (mulIdx (recipC k) n))
        (qInvNat (mulIdx (recipC k) m))
        (qInvNat (recipC k) * qInvNat m)
        qInvNatMulIdx)
      (cong
        Q
        (λw. Q)
        (λw. qInvNat (recipC k) * qInvNat m + w)
        (qInvNat (mulIdx (recipC k) n))
        (qInvNat (recipC k) * qInvNat n)
        qInvNatMulIdx))
    (sym
      Q
      (qInvNat (recipC k) * (qInvNat m + qInvNat n))
      (qInvNat (recipC k) * qInvNat m + qInvNat (recipC k) * qInvNat n)
      (qDistribL (qInvNat (recipC k)) (qInvNat m) (qInvNat n)))

def recipScaleEq : (k m n : ℕ)
  → rBound (recipIdx k m) (recipIdx k n) * recipM k * recipM k ≡ rBound m n ≔
  λk. λm. λn. rBound (recipIdx k m) (recipIdx k n) * recipM k * recipM k
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * recipM k * recipM k)
        (rBound (recipIdx k m) (recipIdx k n))
        (qInvNat (recipC k) * rBound m n)
        (rBoundRecipEq k m n) ⟩ qInvNat (recipC k) * rBound m n * recipM k * recipM k
      ≡⟨ qMulAssoc
        (qInvNat (recipC k) * rBound m n)
        (recipM k)
        (recipM k) ⟩ qInvNat (recipC k) * rBound m n * (recipM k * recipM k)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qInvNat (recipC k) * rBound m n * w)
        (recipM k * recipM k)
        (qOfNat (S (recipC k)))
        (recipMSq k) ⟩ qInvNat (recipC k) * rBound m n * qOfNat (S (recipC k))
      ≡⟨ qMulSwap3
        (qInvNat (recipC k))
        (rBound m n)
        (qOfNat (S (recipC k))) ⟩ qInvNat (recipC k) * qOfNat (S (recipC k)) * rBound m n
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * rBound m n)
        (qInvNat (recipC k) * qOfNat (S (recipC k)))
        qOne
        (trans
          Q
          (qInvNat (recipC k) * qOfNat (S (recipC k)))
          (qOfNat (S (recipC k)) * qInvNat (recipC k))
          qOne
          (qMulComm (qInvNat (recipC k)) (qOfNat (S (recipC k))))
          qMulInvNat) ⟩ qOne * rBound m n
      ≡⟨ qMulOneL (rBound m n) ⟩ rBound m n

-- ===== every sample is at least 1/(2k+2) =====
def sqSumRearr : (A N : El Q) → A * A * (N + N) ≡ (A + A) * (A * N) ≔
  λA. λN. A * A * (N + N)
      ≡⟨ qDistribL (A * A) N N ⟩ A * A * N + A * A * N
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w + w)
        (A * A * N)
        (A * (A * N))
        (qMulAssoc A A N) ⟩ A * (A * N) + A * (A * N)
      ≡⟨ sym
        Q
        ((A + A) * (A * N))
        (A * (A * N) + A * (A * N))
        (qDistribR (A * N) A A) ⟩ (A + A) * (A * N)

def rBoundSelfEq : (n : ℕ) → rBound n n ≡ qInvNat n + qInvNat n using (real.rBound.eq) ≔ λn. ⋆

def recipCInv : (k : ℕ) → qInvNat (recipC k) ≡ qInvNat (dbl k) * qInvNat (dbl k) using (recipC.eq) ≔
  λk. qInvNatMulIdx

def rBoundRecipSelf : (k n : ℕ)
  → rBound (recipIdx k n) (recipIdx k n) ≡ qInvNat k * (recipLo k * qInvNat n)
  using (recipLo.eq) ≔
  λk. λn. rBound (recipIdx k n) (recipIdx k n)
      ≡⟨ rBoundRecipEq k n n ⟩ qInvNat (recipC k) * rBound n n
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qInvNat (recipC k) * w)
        (rBound n n)
        (qInvNat n + qInvNat n)
        (rBoundSelfEq n) ⟩ qInvNat (recipC k) * (qInvNat n + qInvNat n)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * (qInvNat n + qInvNat n))
        (qInvNat (recipC k))
        (qInvNat (dbl k) * qInvNat (dbl k))
        (recipCInv k) ⟩ qInvNat (dbl k) * qInvNat (dbl k) * (qInvNat n + qInvNat n)
      ≡⟨ sqSumRearr
        (qInvNat (dbl k))
        (qInvNat n) ⟩ (qInvNat (dbl k) + qInvNat (dbl k)) * (qInvNat (dbl k) * qInvNat n)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * (qInvNat (dbl k) * qInvNat n))
        (qInvNat (dbl k) + qInvNat (dbl k))
        (qInvNat k)
        (qInvHalf k) ⟩ qInvNat k * (qInvNat (dbl k) * qInvNat n)

def leQRBoundRecip : (k n : ℕ) → El (rBound (recipIdx k n) (recipIdx k n) ≤ recipLo k)
  using (recipLo.eq) ≔
  λk. λn. transport
    Q
    (λw. w ≤ qInvNat (dbl k))
    (qInvNat k * (qInvNat (dbl k) * qInvNat n))
    (rBound (recipIdx k n) (recipIdx k n))
    (sym
      Q
      (rBound (recipIdx k n) (recipIdx k n))
      (qInvNat k * (qInvNat (dbl k) * qInvNat n))
      (rBoundRecipSelf k n))
    (leQTrans
      (qInvNat k * (qInvNat (dbl k) * qInvNat n))
      (qInvNat k * qInvNat (dbl k))
      (qInvNat (dbl k))
      (leQMulMonoL
        (transport
          Q
          (λw. qInvNat (dbl k) * qInvNat n ≤ w)
          (qInvNat (dbl k) * qOne)
          (qInvNat (dbl k))
          (qMulOneR (qInvNat (dbl k)))
          (leQMulMonoL (leQOneInv n) (leQZeroInvNat (dbl k))))
        (leQZeroInvNat k))
      (transport
        Q
        (λw. qInvNat k * qInvNat (dbl k) ≤ w)
        (qOne * qInvNat (dbl k))
        (qInvNat (dbl k))
        (qMulOneL (qInvNat (dbl k)))
        (leQMulMono (qInvNat k) qOne (leQOneInv k) (leQZeroInvNat (dbl k)))))

-- ===== the modulus, spent =====
--
-- 1/(k+1) is TWICE 1/(2k+2), and the harmonic bound at the sampled
-- index is at most 1/(2k+2), so the sample keeps at least the other
-- half. That half is the whole point of the modulus.
def halfSubEq : (A : El Q) → A + A + qNeg A ≡ A ≔
  λA. trans
    Q
    (A + A + qNeg A)
    (A + (A + qNeg A))
    A
    (qAddAssoc A A (qNeg A))
    (trans
      Q
      (A + (A + qNeg A))
      (A + qZero)
      A
      (cong Q (λw. Q) (λw. A + w) (A + qNeg A) qZero (qAddNegR A))
      (qAddZeroR A))

def posSampleLo : {p : El RSeq}
  {k : ℕ}
  → Prf (realOfQ (qInvNat k) ≤ class p) → (n : ℕ) → El (recipLo k ≤ seqOf p (recipIdx k n))
  using (real.Real.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.realOfQ.eq,
    real.constReg.eq,
    realOrder.≤.eq,
    realOrder.RLeP.eq,
    realNeg.seqOf.eq,
    recipLo.eq) ≔
  λp. λk. λh. λn. leQUnsquash
    (qInvNat (dbl k))
    (squash-elim h (u. ⋆ (transport
      Q
      (λw. w ≤ seqOf p (recipIdx k n))
      (qInvNat (dbl k) + qInvNat (dbl k) + qNeg (qInvNat (dbl k)))
      (qInvNat (dbl k))
      (halfSubEq (qInvNat (dbl k)))
      (transport
        Q
        (λw. w + qNeg (qInvNat (dbl k)) ≤ seqOf p (recipIdx k n))
        (qInvNat k)
        (qInvNat (dbl k) + qInvNat (dbl k))
        (sym Q (qInvNat (dbl k) + qInvNat (dbl k)) (qInvNat k) (qInvHalf k))
        (leQSubShift
          (qInvNat k)
          (qInvNat (dbl k))
          (transport
            Q
            (λw. qInvNat k ≤ w)
            (seqOf p (recipIdx k n) + qInvNat (dbl k))
            (qInvNat (dbl k) + seqOf p (recipIdx k n))
            (qAddComm (seqOf p (recipIdx k n)) (qInvNat (dbl k)))
            (leQTrans
              (qInvNat k)
              (seqOf p (recipIdx k n) + rBound (recipIdx k n) (recipIdx k n))
              (seqOf p (recipIdx k n) + qInvNat (dbl k))
              (leQAddShift (qInvNat k) (u (recipIdx k n)))
              (leQPlusMonoL
                (rBound (recipIdx k n) (recipIdx k n))
                (qInvNat (dbl k))
                (seqOf p (recipIdx k n))
                (leQRBoundRecip k n)))))))))

def posSampleSgn : (p : El RSeq)
  (k : ℕ)
  (h : Prf (realOfQ (qInvNat k) ≤ class p))
  (n : ℕ)
  → sgnQ (seqOf p (recipIdx k n)) ≡ sPos
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold) ≔
  λp. λk. λh. λn. sgnQPosOfLe (recipLo k) (recipLoPos k) (posSampleLo h n)

-- ===== the estimate =====
def bndOfNonNegLe : {M u : El Q} → El (qZero ≤ M) → El (qZero ≤ u) → El (u ≤ M) → El (Bnd M u)
  using (ratBound.Bnd.unfold) ≔
  λM. λu. λhM0. λh0. λhM. leQTrans
    (qNeg M)
    qZero
    u
    (transport Q (λw. qNeg M ≤ w) (qNeg qZero) qZero qNegZeroQ (leQNegFlip qZero M hM0))
    h0, hM

-- |1/a − 1/b| ≤ d·Ma·Mb, when a ≥ ca, b ≥ cb and each c inverts its M.
-- The two bounds are kept SEPARATE because the modulus-independence
-- proof compares samples taken with different moduli.
def bndRecipDiff : {a b : El Q}
  (ca cb : El Q)
  {Ma Mb d : El Q}
  → (sgnQ
    ca ≡ sPos)
    → (sgnQ
      cb ≡ sPos)
      → El (ca
        ≤ a)
        → El (cb
          ≤ b)
          → (ca
            * Ma ≡ qOne)
            → (cb
              * Mb ≡ qOne)
              → El (qZero
                ≤ Ma)
                → El (qZero
                  ≤ Mb)
                  → El (qZero
                    ≤ d)
                    → El (Bnd d (b + qNeg a)) → El (Bnd (d * Ma * Mb) (qInv a + qNeg (qInv b))) ≔
  λa. λb. λca. λcb. λMa. λMb. λd. λhca. λhcb. λha. λhb. λhcMa. λhcMb. λhMa0. λhMb0. λhd0. λgap. bndEq
    ((b + qNeg a) * qInv a * qInv b)
    (qInv a + qNeg (qInv b))
    (qInvDiff (sgnQPosOfLe ca hca ha) (sgnQPosOfLe cb hcb hb))
    (bndMul
      (leQZeroMul hd0 hMa0)
      hMb0
      (bndMul
        hd0
        hMa0
        gap
        (bndOfNonNegLe hMa0 (leQZeroInv (sgnQPosOfLe ca hca ha)) (leQInvBound ca hca ha hcMa)))
      (bndOfNonNegLe hMb0 (leQZeroInv (sgnQPosOfLe cb hcb hb)) (leQInvBound cb hcb hb hcMb)))

-- ===== the sequence, and its regularity =====
def recipSeq : El RSeq → ℕ → El (ℕ → Q) ≔ λp. λk. λn. qInv (seqOf p (recipIdx k n))

def recipRegAt : (p : El RSeq)
  (k : ℕ)
  (h : Prf (realOfQ (qInvNat k) ≤ class p))
  (m n : ℕ)
  → El (Bnd (rBound m n) (recipSeq p k m + qNeg (recipSeq p k n)))
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold, recipSeq.eq) ≔
  λp. λk. λh. λm. λn. bndEqB
    (rBound (recipIdx k m) (recipIdx k n) * recipM k * recipM k)
    (rBound m n)
    (qInv (seqOf p (recipIdx k m)) + qNeg (qInv (seqOf p (recipIdx k n))))
    (recipScaleEq k m n)
    (bndRecipDiff
      (recipLo k)
      (recipLo k)
      (recipLoPos k)
      (recipLoPos k)
      (posSampleLo h m)
      (posSampleLo h n)
      (recipLoM k)
      (recipLoM k)
      (leQZeroRecipM k)
      (leQZeroRecipM k)
      (leQZeroBound (recipIdx k m) (recipIdx k n))
      (bndSubSym
        (rBound (recipIdx k m) (recipIdx k n))
        (seqOf p (recipIdx k m))
        (seqOf p (recipIdx k n))
        (regBnd (seqOf p) (regOf p) (recipIdx k m) (recipIdx k n))))

def rRecip : (p : El RSeq) (k : ℕ) → Prf (realOfQ (qInvNat k) ≤ class p) → El RSeq
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold) ≔
  λp. λk. λh. recipSeq p k, bndReg (recipRegAt p k h)

-- ===== well-definedness and independence, in one =====
--
-- Two payloads for the same x differ in BOTH representative and
-- modulus. The samples then sit at different depths, so the gap is
-- bounded by twice rBound n n rather than once, and the constant that
-- comes out is 2·(2k+2)(2k'+2). reqOfClose absorbs any constant, which
-- is exactly why the exact scaling is needed only for regularity.
def recipK : ℕ → ℕ → ℕ ≔ λk. λk'. S (dbl k) * S (dbl k') + S (dbl k) * S (dbl k')

def recipMM : (k k' : ℕ) → recipM k * recipM k' ≡ qOfNat (S (dbl k) * S (dbl k'))
  using (recipM.eq) ≔
  λk. λk'. qOfNatMul (S (dbl k)) (S (dbl k'))

def recipKEq : (k k' : ℕ)
  → qOfNat (S (dbl k) * S (dbl k')) + qOfNat (S (dbl k) * S (dbl k')) ≡ qOfNat (recipK k k')
  using (recipK.eq) ≔
  λk. λk'. qOfNatAdd (S (dbl k) * S (dbl k')) (S (dbl k) * S (dbl k'))

def recipBoundEq : (k k' : ℕ)
  (R : El Q)
  → (R + R) * recipM k * recipM k' ≡ qOfNat (recipK k k') * R ≔
  λk. λk'. λR. (R + R) * recipM k * recipM k'
      ≡⟨ qMulAssoc (R + R) (recipM k) (recipM k') ⟩ (R + R) * (recipM k * recipM k')
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. (R + R) * w)
        (recipM k * recipM k')
        (qOfNat (S (dbl k) * S (dbl k')))
        (recipMM k k') ⟩ (R + R) * qOfNat (S (dbl k) * S (dbl k'))
      ≡⟨ qDistribR
        (qOfNat (S (dbl k) * S (dbl k')))
        R
        R ⟩ R * qOfNat (S (dbl k) * S (dbl k')) + R * qOfNat (S (dbl k) * S (dbl k'))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w + w)
        (R * qOfNat (S (dbl k) * S (dbl k')))
        (qOfNat (S (dbl k) * S (dbl k')) * R)
        (qMulComm
          R
          (qOfNat
            (S (dbl
              k)
              * S (dbl
                k')))) ⟩ qOfNat (S (dbl k) * S (dbl k')) * R + qOfNat (S (dbl k) * S (dbl k')) * R
      ≡⟨ sym
        Q
        ((qOfNat (S (dbl k) * S (dbl k')) + qOfNat (S (dbl k) * S (dbl k'))) * R)
        (qOfNat (S (dbl k) * S (dbl k')) * R + qOfNat (S (dbl k) * S (dbl k')) * R)
        (qDistribR
          R
          (qOfNat (S (dbl k) * S (dbl k')))
          (qOfNat
            (S (dbl
              k)
              * S (dbl
                k')))) ⟩ (qOfNat (S (dbl k) * S (dbl k')) + qOfNat (S (dbl k) * S (dbl k'))) * R
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * R)
        (qOfNat (S (dbl k) * S (dbl k')) + qOfNat (S (dbl k) * S (dbl k')))
        (qOfNat (recipK k k'))
        (recipKEq k k') ⟩ qOfNat (recipK k k') * R

def recipCloseAt : (p p' : El RSeq)
  (k k' n : ℕ)
  → El (recipLo
    k
    ≤ seqOf
      p
      (recipIdx
        k
        n))
    → El (recipLo
      k'
      ≤ seqOf
        p'
        (recipIdx
          k'
          n))
      → El (Bnd
        (rBound n n + rBound n n)
        (seqOf
          p'
          (recipIdx
            k'
            n)
          + qNeg
            (seqOf
              p
              (recipIdx
                k
                n))))
        → El (Bnd (qOfNat (recipK k k') * rBound n n) (recipSeq p k n + qNeg (recipSeq p' k' n)))
  using (recipSeq.eq) ≔
  λp. λp'. λk. λk'. λn. λlo. λlo'. λgap. bndEqB
    ((rBound n n + rBound n n) * recipM k * recipM k')
    (qOfNat (recipK k k') * rBound n n)
    (qInv (seqOf p (recipIdx k n)) + qNeg (qInv (seqOf p' (recipIdx k' n))))
    (recipBoundEq k k' (rBound n n))
    (bndRecipDiff
      (recipLo k)
      (recipLo k')
      (recipLoPos k)
      (recipLoPos k')
      lo
      lo'
      (recipLoM k)
      (recipLoM k')
      (leQZeroRecipM k)
      (leQZeroRecipM k')
      (leQZeroAdd (leQZeroBound n n) (leQZeroBound n n))
      gap)

def deepR : (k n : ℕ) → El (qInvNat (recipIdx k n) ≤ qInvNat n) using (recipIdx.eq) ≔
  λk. λn. leQInvIdx (recipC k) n

def recipWDGen : {p p' : El RSeq}
  (k k' : ℕ)
  (h : Prf (realOfQ (qInvNat k) ≤ class p))
  (h' : Prf (realOfQ (qInvNat k') ≤ class p'))
  → Prf (REq p p') → Prf (REq (rRecip p k h) (rRecip p' k' h'))
  using (rRecip.eq,
    ratBound.Bnd.unfold,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    real.rBound.eq,
    realNeg.seqOf.eq,
    recipIdx.eq,
    recipSeq.eq) ≔
  λp. λp'. λk. λk'. λh. λh'. λhe. squash-elim he (u. reqOfClose
    (recipK k k')
    (λn. recipCloseAt
      p
      p'
      k
      k'
      n
      (posSampleLo h n)
      (posSampleLo h' n)
      (bndVia
        (rBound n n)
        (rBound n n)
        (seqOf p' (recipIdx k' n))
        (seqOf p' (recipIdx k n))
        (seqOf p (recipIdx k n))
        (bndDeep
          (seqOf p')
          (regBnd (seqOf p') (regOf p'))
          (recipIdx k' n)
          (recipIdx k n)
          n
          (deepR k' n)
          (deepR k n))
        (bndWeaken
          (rBound (recipIdx k n) (recipIdx k n))
          (rBound n n)
          (seqOf p' (recipIdx k n) + qNeg (seqOf p (recipIdx k n)))
          (leQAdd
            (qInvNat (recipIdx k n))
            (qInvNat n)
            (qInvNat (recipIdx k n))
            (qInvNat n)
            (deepR k n)
            (deepR k n))
          (bndSubSym
            (rBound (recipIdx k n) (recipIdx k n))
            (seqOf p (recipIdx k n))
            (seqOf p' (recipIdx k n))
            (u (recipIdx k n)))))))

-- ===== the descent, and division =====
def recipFromPayload : (x : El Real) → El (PosPayload x) → El Real
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold) ≔
  λx. λd. class (rRecip (posRep x d) (posK x d) (posBoundRep x d))

def recipPayloadConst : (x : El Real)
  (d d' : El (PosPayload x))
  → recipFromPayload x d ≡ recipFromPayload x d'
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold, recipFromPayload.eq) ≔
  λx. λd. λd'. realEqOfREq
    (rRecip (posRep x d) (posK x d) (posBoundRep x d))
    (rRecip (posRep x d') (posK x d') (posBoundRep x d'))
    (recipWDGen
      (posK x d)
      (posK x d')
      (posBoundRep x d)
      (posBoundRep x d')
      (reqOfClassEq
        (trans
          Real
          (class (posRep x d))
          x
          (class (posRep x d'))
          (posRepEq x d)
          (sym Real (class (posRep x d')) x (posRepEq x d')))))

def realRecip : (x : El Real) → El (PosR x) → El Real using (PosR.eq) ≔
  λx. λw. brElim (PosPayload x) (recipFromPayload x) (recipPayloadConst x) w

def realRecipRep : (x : El Real)
  (d : El (PosPayload x))
  → realRecip x (br d) ≡ class (rRecip (posRep x d) (posK x d) (posBoundRep x d))
  using (real.Real.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    PosR.eq,
    bracket.br.eq,
    bracket.brElim.eq,
    recipFromPayload.eq,
    realRecip.realRecip.eq) ≔
  λx. λd. ⋆

-- ...and division is multiplication by the reciprocal
def realDiv : (u x : El Real) → El (PosR x) → El Real ≔ λu. λx. λw. u * realRecip x w
