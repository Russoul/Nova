-- KERNEL, IMAGE, AND THE FIRST ISOMORPHISM THEOREM.
--
-- The kernel is an Ω-valued predicate — it has to be, to be quotiented
-- by — and it is an EQUATION, which is the cheapest kind of Ω-valued
-- predicate there is: every membership proof is ⋆ and every membership
-- fact is reflected into a judgemental equality on the spot.

import id (Id, idToEq, eqToId, refl)
import prelude (funext)
import bracket (Br, br, brElim, brIsProp)
import monoid (IsMonoid)
import group (IsGroup)
import groupTheory (· as gop, e as ge, ⁻¹ as ginv)
import (groupTheory g) (·, e, ⁻¹)
import (groupTheory h) (· as ∙, e as eH, ⁻¹ as invH, gUnitL as gUnitLH, gUnitR as gUnitRH, gInvL as gInvLH, gInvR as gInvRH, gInvUnit as gInvUnitH, gAssoc as gAssocH)
import (subgroup g) (IsSubgroup, IsNormal, sgIntro, sgUnit, sgOp, sgInv, nmIntro, nmConj, nmConjInv, cosetRel, cosetRefl, cosetSymm, cosetTrans)
import quotGroup (QGroup, qcls, qclsEq, qclsEffective, qMul, qMulCls, qInv, qInvCls, qUnit, qIsGroup, qFactor, qFactorCls, qFactorUnique, qopIsQMul, qeIsQUnit, qinvIsQInv)
import groupHom (Hom as HomRaw)
import (groupHom g h) (IsHom, Hom, homAp, homIntro, homLaw, homIntroAp, homUnit, homInv, homOpInv, homKillConst, homQuotMap, homQuotMapCls, homQuot, homQuotFactors, homQuotUnique)
import qProj (qProj, qProjAp)
import equality (transportP, transport, sym, trans, cong, pairext)

module {G : 𝕌} (g : El (IsGroup G)) {H : 𝕌} (h : El (IsGroup H)) (p : El (HomRaw g h))

infixl 7 ∙
def ker : El G → Ω ≔ λx. homAp p x ≡ eH

def kerOp : (x y : El G) → Prf (ker x) → Prf (ker y) → Prf (ker (x · y)) using (ker.eq) ≔
  λx. λy. λhx. λhy. homAp p (x · y)
      ≡⟨ homLaw p x y ⟩ homAp p x ∙ homAp p y
      ≡⟨ cong (λw. H) (λw. w ∙ homAp p y) hx ⟩ eH ∙ homAp p y
      ≡⟨ cong (λw. H) (λw. eH ∙ w) hy ⟩ eH ∙ eH
      ≡⟨ gUnitLH eH ⟩ eH

def kerInv : (x : El G) → Prf (ker x) → Prf (ker (x ⁻¹)) using (ker.eq) ≔
  λx. λhx. homAp p (x ⁻¹)
      ≡⟨ homInv p x ⟩ invH (homAp p x)
      ≡⟨ cong (λw. H) (λw. invH w) hx ⟩ invH eH
      ≡⟨ gInvUnitH ⟩ eH

def kerIsSubgroup : Prf (IsSubgroup ker) using (ker.eq) ≔ sgIntro (homUnit p) kerOp kerInv

-- normality, with no case analysis at all: f (x·n·x⁻¹) = f x · e · f x⁻¹
-- and the two outer factors annihilate
def kerIsNormal : Prf (IsNormal ker) using (ker.eq) ≔
  nmIntro
    (λx. λn. λhn. homAp p (x · (n · x ⁻¹))
        ≡⟨ homLaw p x (n · x ⁻¹) ⟩ homAp p x ∙ homAp p (n · x ⁻¹)
        ≡⟨ cong
          (λw. H)
          (λw. homAp p x ∙ w)
          (homLaw p n (x ⁻¹)) ⟩ homAp p x ∙ (homAp p n ∙ homAp p (x ⁻¹))
        ≡⟨ cong
          (λw. H)
          (λw. homAp p x ∙ (w ∙ homAp p (x ⁻¹)))
          hn ⟩ homAp p x ∙ (eH ∙ homAp p (x ⁻¹))
        ≡⟨ cong (λw. H) (λw. homAp p x ∙ w) (gUnitLH (homAp p (x ⁻¹))) ⟩ homAp p x ∙ homAp p (x ⁻¹)
        ≡⟨ cong (λw. H) (λw. homAp p x ∙ w) (homInv p x) ⟩ homAp p x ∙ invH (homAp p x)
        ≡⟨ gInvRH (homAp p x) ⟩ eH)

-- ===== the image, with the BRACKET =====
--
-- This is the choice the whole theorem turns on. The obvious spelling
--
--   im p ≜ ((y : El H) ⨯ ∥(x : El G) ⨯ Id H (p x) y∥)
--
-- is unusable: ∥·∥ lives in Ω, el-squash-e-prf reaches only further
-- PROPOSITIONS, and the inverse map G/ker p ← im p has to land in
-- DATA. With that definition the first isomorphism theorem is simply
-- not provable, and that is not a defect — it is the constructive
-- content of the statement.
--
-- bracket.nova's Br is the other truncation: Br a ≜ a / (x y. ∥𝟙∥),
-- a 𝕌-CODE whose `class` RETAINS its representative, so brElim lands
-- in an arbitrary type at the price of a constancy proof. Defining
--
--   Im p ≜ ((y : H) ⨯ Br ((x : G) ⨯ Id H (p x) y))
--
-- makes the inverse map writable, and the constancy obligation brElim
-- charges for it is EXACTLY "any two preimages of y agree modulo
-- ker p" — the mathematical content of the theorem, paid at the point
-- where it is used rather than assumed at the point where the image is
-- defined. See fromImAt below; that one obligation is the proof.
--
-- Br is also a DEFINITIONAL subsingleton (brIsProp concludes ≐), so
-- two elements of Im with equal first components are equal outright,
-- and every law of Im reduces to the corresponding law of H.
def imFib : (y : El H) → 𝕌 ≔ λy. (x : G) ⨯ Id _ (homAp p x) y

def Im : 𝕌 ≔ (y : H) ⨯ Br (imFib y)

-- an element of the image is determined by its H-component
def imEq : (u v : El Im) → (u .π₁ ≡ v .π₁) → u ≡ v using (Im.unfold) ≔
  λu. λv. λe. pairext e (brIsProp (u .π₂) (v .π₂))

def imIn : (x : El G) → El Im using (Im.unfold, imFib.unfold, id.Id.eq) ≔
  λx. homAp p x, br (x, refl H (homAp p x))

-- ===== the fibres are closed under the group operations =====
def imFibOp : {y1 y2 : El H} (f1 : El (imFib y1)) (f2 : El (imFib y2)) → El (imFib (y1 ∙ y2))
  using (imFib.unfold) ≔
  λy1. λy2. λf1. λf2. gop
    g
    (f1 .π₁)
    (f2 .π₁),
    eqToId
      _
      _
      (homAp p (f1 .π₁ · f2 .π₁)
          ≡⟨ homLaw p (f1 .π₁) (f2 .π₁) ⟩ homAp p (f1 .π₁) ∙ homAp p (f2 .π₁)
          ≡⟨ cong (λw. H) (λw. w ∙ homAp p (f2 .π₁)) (idToEq _ _ _ (f1 .π₂)) ⟩ y1 ∙ homAp p (f2 .π₁)
          ≡⟨ cong (λw. H) (λw. y1 ∙ w) (idToEq _ _ _ (f2 .π₂)) ⟩ y1 ∙ y2)

def imFibInv : {y : El H} (f : El (imFib y)) → El (imFib (invH y)) using (imFib.unfold) ≔
  λy. λf. ginv
    g
    (f .π₁),
    eqToId
      _
      _
      (homAp p (f .π₁ ⁻¹)
          ≡⟨ homInv p (f .π₁) ⟩ invH (homAp p (f .π₁))
          ≡⟨ cong (λw. H) (λw. invH w) (idToEq _ _ _ (f .π₂)) ⟩ invH y)

-- ...and the same, one bracket up. Every constancy proof here is
-- brIsProp: the target is itself a bracket, so nothing is owed
def imOpBrAt : {y1 y2 : El H}
  (f1 : El (imFib y1))
  (w2 : El (Br (imFib y2)))
  → El (Br (imFib (y1 ∙ y2))) ≔
  λy1. λy2. λf1. λw2. brElim
    (λf2. br (imFibOp f1 f2))
    (λf2. λf2'. brIsProp (br (imFibOp f1 f2)) (br (imFibOp f1 f2')))
    w2

def imOpBr : {y1 y2 : El H}
  (w1 : El (Br (imFib y1)))
  (w2 : El (Br (imFib y2)))
  → El (Br (imFib (y1 ∙ y2))) ≔
  λy1. λy2. λw1. λw2. brElim
    (λf1. imOpBrAt f1 w2)
    (λf1. λf1'. brIsProp (imOpBrAt f1 w2) (imOpBrAt f1' w2))
    w1

def imInvBr : {y : El H} (w : El (Br (imFib y))) → El (Br (imFib (invH y))) ≔
  λy. λw. brElim (λf. br (imFibInv f)) (λf. λf'. brIsProp (br (imFibInv f)) (br (imFibInv f'))) w

-- ===== the image is a group =====
def imOp : El Im → El Im → El Im using (Im.unfold) ≔ λu. λv. u .π₁ ∙ v .π₁, imOpBr (u .π₂) (v .π₂)

def imUnit : El Im using (Im.unfold, imFib.unfold) ≔ eH, br (e, eqToId _ _ (homUnit p))

def imInv : El Im → El Im using (Im.unfold) ≔ λu. invH (u .π₁), imInvBr (u .π₂)

def imIsGroup : El (IsGroup Im)
  using (group.IsGroup.unfold, monoid.IsMonoid.unfold, Im.unfold, imOp.eq, imUnit.eq, imInv.eq) ≔
  (imOp,
    imUnit,
      (λx. λy. λz. eqToId
        _
        _
        (imEq
          (imOp (imOp x y) z)
          (imOp x (imOp y z))
          (gAssocH
            (x .π₁)
            (y .π₁)
            (z .π₁)))),
        (λx. eqToId
          _
          _
          (imEq
            (imOp imUnit x)
            _
            (gUnitLH
              (x .π₁)))),
          λx. eqToId
            _
            _
            (imEq
              (imOp x imUnit)
              _
              (gUnitRH
                (x .π₁)))),
    imInv,
      (λx. eqToId
        _
        _
        (imEq
          (imOp (imInv x) x)
          imUnit
          (gInvLH (x .π₁)))), λx. eqToId _ _ (imEq (imOp x (imInv x)) imUnit (gInvRH (x .π₁)))

-- ===== G/ker p  →  im p =====
--
-- The forward map is a descent out of the quotient, and its constancy
-- proof is groupHom.homKillConst at N ≜ ker p — where "kills N" is the
-- identity function, because membership in the kernel IS the equation
-- it has to produce.
def kerKills : (x : El G) → Prf (ker x) → homAp p x ≡ eH using (ker.eq) ≔ λx. λk. k

def toImConst : (a a' : El G) → Prf (cosetRel ker a a') → imIn a ≡ imIn a' using (imIn.eq) ≔
  λa. λa'. λr. imEq _ _ (homKillConst _ p kerKills _ _ r)

def toImMap : El (QGroup g ker) → El Im ≔ λu. qFactor _ _ imIn toImConst u

def toImCls : (a : El G) → toImMap (class a) ≡ imIn a using (quotGroup.QGroup.unfold, toImMap.eq) ≔
  λa. qFactorCls _ _ _ imIn toImConst a

def imInOp : (a b : El G) → imIn (a · b) ≡ imOp (imIn a) (imIn b) using (imIn.eq, imOp.eq) ≔
  λa. λb. imEq _ _ (homLaw p a b)

def toImLawQ : {u v : El (QGroup g ker)}
  → toImMap (qMul _ _ kerIsNormal u v) ≡ imOp (toImMap u) (toImMap v)
  using (quotGroup.QGroup.unfold) ≔
  λu. λv. quot-elim
    (a. quot-elim
      (b. toImMap (qMul _ _ kerIsNormal (class a) (class b))
          ≡⟨ cong (λw. Im) (λw. toImMap w) (qMulCls _ _ kerIsNormal a b) ⟩ toImMap (class (a · b))
          ≡⟨ toImCls (a · b) ⟩ imIn (a · b)
          ≡⟨ imInOp a b ⟩ imOp (imIn a) (imIn b)
          ≡⟨ cong
            (λw. Im)
            (λw. imOp w (imIn b))
            (sym _ _ (toImCls a)) ⟩ imOp (toImMap (class a)) (imIn b)
          ≡⟨ cong
            (λw. Im)
            (λw. imOp (toImMap (class a)) w)
            (sym _ _ (toImCls b)) ⟩ imOp (toImMap (class a)) (toImMap (class b)))
      v)
    u

def imopIsImOp : (u v : El Im) → gop imIsGroup u v ≡ imOp u v
  using (groupTheory.·.eq, imIsGroup.eq) ≔
  λu. λv. ⋆

def toImLaw : (u v : El (QGroup g ker))
  → toImMap
    (gop (qIsGroup _ _ kerIsSubgroup kerIsNormal) u v) ≡ gop imIsGroup (toImMap u) (toImMap v) ≔
  λu. λv. trans
    _
    _
    _
    (cong (λw. Im) (λw. toImMap w) (qopIsQMul _ _ kerIsSubgroup kerIsNormal u v))
    (trans
      (toImMap (qMul _ _ kerIsNormal u v))
      _
      _
      toImLawQ
      (sym _ _ (imopIsImOp (toImMap u) (toImMap v))))

def toIm : El (Hom {} _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) _ imIsGroup) ≔
  homIntro {} _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) _ imIsGroup toImMap toImLaw

-- ===== im p → G/ker p : THE SHOWCASE =====
--
-- Here is why the image had to be defined with the bracket. To send an
-- element of the image back into the quotient one needs a PREIMAGE,
-- as data, and brElim supplies it. What it charges in exchange is
-- fromImConst — and fromImConst is not overhead, it IS the first
-- isomorphism theorem:
--
--   any two preimages of the same y are congruent modulo ker p.
--
-- Two lines: p (x · x'⁻¹) = p x · (p x')⁻¹ = y · y⁻¹ = e. The content
-- is paid exactly where it is used. With ∥·∥ in place of Br there
-- would be no obligation to pay and no map to define — squash-elim
-- reaches only propositions, and this one lands in data.
def fromImConst : (y : El H) (f f' : El (imFib y)) → qcls g ker (f .π₁) ≡ qcls _ _ (f' .π₁)
  using (ker.eq, subgroup.cosetRel.eq, imFib.unfold) ≔
  λy. λf. λf'. qclsEq
    _
    _
    kerIsSubgroup
    _
    _
    (homAp p (f .π₁ · f' .π₁ ⁻¹)
        ≡⟨ homOpInv p (f .π₁) (f' .π₁) ⟩ homAp p (f .π₁) ∙ invH (homAp p (f' .π₁))
        ≡⟨ cong
          (λw. H)
          (λw. w ∙ invH (homAp p (f' .π₁)))
          (idToEq _ _ _ (f .π₂)) ⟩ y ∙ invH (homAp p (f' .π₁))
        ≡⟨ cong (λw. H) (λw. y ∙ invH w) (idToEq _ _ _ (f' .π₂)) ⟩ y ∙ invH y
        ≡⟨ gInvRH y ⟩ eH)

def fromImAt : (y : El H) (w : El (Br (imFib y))) → El (QGroup g ker) using (imFib.unfold) ≔
  λy. λw. brElim (λf. qcls g ker (f .π₁)) (fromImConst y) w

def fromIm : (z : El Im) → El (QGroup g ker) using (Im.unfold) ≔ λz. fromImAt _ (z .π₂)

-- ===== the two round trips =====
def fromImIn : {a : El G} → fromIm (imIn a) ≡ qcls _ _ a
  using (imIn.eq, fromIm.eq, fromImAt.eq, bracket.br.eq, bracket.brElim.eq) ≔
  λa. ⋆

def fromImToIm : (u : El (QGroup g ker)) → fromIm (toImMap u) ≡ u
  using (quotGroup.QGroup.unfold, quotGroup.qcls.eq) ≔
  λu. quot-elim (a. trans _ _ _ (cong (λw. QGroup g ker) (λw. fromIm w) (toImCls a)) fromImIn) u

-- the other round trip, through imEq: only the H-component has to be
-- checked, and a quot-elim over the bracket recovers the preimage's
-- own Id proof to check it with
def toImFromImFst : (y : El H) (w : El (Br (imFib y))) → toImMap (fromImAt _ w) .π₁ ≡ y
  using (Im.unfold,
    imFib.unfold,
    imIn.eq,
    fromImAt.eq,
    bracket.Br.unfold,
    bracket.brElim.eq,
    quotGroup.qcls.eq) ≔
  λy. λw. quot-elim
    (f. trans
      _
      (homAp p (f .π₁))
      _
      (cong (λw. H) (λw. w .π₁) {toImMap (fromImAt y (class f))} {imIn (f .π₁)} (toImCls (f .π₁)))
      (idToEq _ _ _ (f .π₂)))
    w

def toImFromIm : (z : El Im) → toImMap (fromIm z) ≡ z using (Im.unfold, fromIm.eq) ≔
  λz. imEq _ _ (toImFromImFst _ (z .π₂))

-- ===== the canonical factorisation  p = incl ∘ φ ∘ π  =====
def imIncFun : (u : El Im) → El H using (Im.unfold) ≔ λu. u .π₁

def imIncLaw : (u v : El Im) → imIncFun (gop imIsGroup u v) ≡ imIncFun u ∙ imIncFun v
  using (imIncFun.eq, imOp.eq) ≔
  λu. λv. trans _ _ _ (cong (λw. H) (λw. imIncFun w) (imopIsImOp u v)) ⋆

def imInc : El (Hom {} _ imIsGroup _ h) ≔ homIntro {} _ imIsGroup _ h imIncFun imIncLaw

def imIncAp : (u : El Im) → homAp {} _ imIsGroup _ h imInc u ≡ imIncFun u using (imInc.eq) ≔
  λu. homIntroAp {} _ _ _ _ imIncFun imIncLaw u

def toImAp : {u : El (QGroup g ker)}
  → homAp {} _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) _ imIsGroup toIm u ≡ toImMap u
  using (toIm.eq) ≔
  λu. homIntroAp {} _ _ _ _ toImMap toImLaw u

-- φ ∘ π is p, followed into the image
def toImOfProj : {a : El G}
  → homAp {}
    _
    (qIsGroup _ _ kerIsSubgroup kerIsNormal)
    _
    imIsGroup
    toIm
    (homAp {} _ g _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) qProj a) ≡ imIn a
  using (quotGroup.qcls.eq) ≔
  λa. trans
    _
    _
    _
    (cong
      (λw. Im)
      (λw. homAp {} _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) Im imIsGroup toIm w)
      {homAp {} _ g _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) qProj a}
      {qcls g ker a}
      qProjAp)
    (trans
      (homAp {} _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) _ imIsGroup toIm (qcls g ker a))
      (toImMap (qcls g ker a))
      _
      toImAp
      (toImCls a))

-- ...and the inclusion sends it back to p a: the factorisation, closed
def firstIsoFactors : (a : El G)
  → homAp {}
    _
    imIsGroup
    _
    h
    imInc
    (homAp {}
      _
      (qIsGroup _ _ kerIsSubgroup kerIsNormal)
      _
      imIsGroup
      toIm
      (homAp {} _ g _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) qProj a)) ≡ homAp p a
  using (imIn.eq, imIncFun.eq) ≔
  λa. trans
    _
    _
    _
    (cong
      (λw. H)
      (λw. homAp {} _ imIsGroup H h imInc w)
      {homAp {}
        _
        (qIsGroup _ _ kerIsSubgroup kerIsNormal)
        _
        imIsGroup
        toIm
        (homAp {} _ g _ (qIsGroup _ _ kerIsSubgroup kerIsNormal) qProj a)}
      {imIn a}
      toImOfProj)
    (imIncAp (imIn a))
