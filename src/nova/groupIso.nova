-- KERNEL, IMAGE, AND THE FIRST ISOMORPHISM THEOREM.
--
-- The kernel is an Ω-valued predicate — it has to be, to be quotiented
-- by — and it is an EQUATION, which is the cheapest kind of Ω-valued
-- predicate there is: every membership proof is ⋆ and every membership
-- fact is reflected into a judgemental equality on the spot.

import id (Id, idToEq, eqToId, refl)
import prelude (funext)
import bracket (Br, br, brElim, brIsProp, brBeta, brOutConst)
import monoid (IsMonoid)
import group (IsGroup)
import groupTheory (gop, ge, ginv, gAssoc, gUnitL, gUnitR, gInvL, gInvR, gCancelInner, gCancelInnerInv, gCancelOuter, gCancelOuterInv, gInvUniq, gInvInv, gInvUnit, gOpInv, gCancelL, gCancelR, gEqOfOpInvUnit)
import subgroup (IsSubgroup, IsNormal, sgIntro, sgUnit, sgOp, sgInv, nmIntro, nmConj, nmConjInv, cosetRel, cosetRefl, cosetSymm, cosetTrans)
import quotGroup (QGroup, qcls, qclsEq, qclsEffective, qMul, qMulCls, qInv, qInvCls, qUnit, qIsGroup, qFactor, qFactorCls, qFactorUnique)
import groupHom (IsHom, Hom, homAp, homIntro, homLaw, homIntroAp, homUnit, homInv, homOpInv, qopIsQMul, qeIsQUnit, qinvIsQInv, qProj, qProjAp, homKillConst, homQuotMap, homQuotMapCls, homQuot, homQuotFactors, homQuotUnique)
import equality (transportP, transport, sym, trans, cong, sigmaEq2)

def ker : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → El G → Ω ≔
  λG. λg. λH. λh. λp. λx. homAp _ _ _ _ p x ≡ ge h

def kerOp : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (x y : El G)
  → Prf (ker _ _ _ _ p x) → Prf (ker _ _ _ _ p y) → Prf (ker _ _ _ _ p (gop _ g x y))
  using (ker.eq) ≔
  λG. λg. λH. λh. λp. λx. λy. λhx. λhy. homAp _ _ _ _ p (gop _ g x y)
      ≡⟨ homLaw _ _ _ _ p x y ⟩ gop _ h (homAp _ _ _ _ p x) (homAp _ _ _ _ p y)
      ≡⟨ cong (λw. H) (λw. gop H h w (homAp _ _ _ _ p y)) hx ⟩ gop _ h (ge h) (homAp _ _ _ _ p y)
      ≡⟨ cong (λw. H) (λw. gop H h (ge h) w) hy ⟩ gop _ h (ge h) (ge h)
      ≡⟨ gUnitL _ h (ge h) ⟩ ge h

def kerInv : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (x : El G)
  → Prf (ker _ _ _ _ p x) → Prf (ker _ _ _ _ p (ginv _ g x))
  using (ker.eq) ≔
  λG. λg. λH. λh. λp. λx. λhx. homAp _ _ _ _ p (ginv _ g x)
      ≡⟨ homInv _ _ _ _ p x ⟩ ginv _ h (homAp _ _ _ _ p x)
      ≡⟨ cong (λw. H) (λw. ginv H h w) hx ⟩ ginv _ h (ge h)
      ≡⟨ gInvUnit _ h ⟩ ge h

def kerIsSubgroup : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → Prf (IsSubgroup _ g (ker _ _ _ _ p))
  using (ker.eq) ≔
  λG. λg. λH. λh. λp. sgIntro (homUnit _ _ _ _ p) (kerOp _ _ _ _ p) (kerInv _ _ _ _ p)

-- normality, with no case analysis at all: f (x·n·x⁻¹) = f x · e · f x⁻¹
-- and the two outer factors annihilate
def kerIsNormal : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → Prf (IsNormal _ g (ker _ _ _ _ p))
  using (ker.eq) ≔
  λG. λg. λH. λh. λp. nmIntro
    (λx. λn. λhn. homAp _ _ _ _ p (gop _ g x (gop _ g n (ginv _ g x)))
        ≡⟨ homLaw
          _
          _
          _
          _
          p
          x
          (gop
            _
            g
            n
            (ginv _ g x)) ⟩ gop _ h (homAp _ _ _ _ p x) (homAp _ _ _ _ p (gop _ g n (ginv _ g x)))
        ≡⟨ cong
          (λw. H)
          (λw. gop H h (homAp _ _ _ _ p x) w)
          (homLaw
            _
            _
            _
            _
            p
            n
            (ginv
              _
              g
              x)) ⟩ gop
          _
          h
          (homAp _ _ _ _ p x)
          (gop _ h (homAp _ _ _ _ p n) (homAp _ _ _ _ p (ginv _ g x)))
        ≡⟨ cong
          (λw. H)
          (λw. gop H h (homAp _ _ _ _ p x) (gop _ h w (homAp _ _ _ _ p (ginv _ g x))))
          hn ⟩ gop _ h (homAp _ _ _ _ p x) (gop _ h (ge h) (homAp _ _ _ _ p (ginv _ g x)))
        ≡⟨ cong
          (λw. H)
          (λw. gop H h (homAp _ _ _ _ p x) w)
          (gUnitL
            _
            h
            (homAp
              _
              _
              _
              _
              p
              (ginv _ g x))) ⟩ gop _ h (homAp _ _ _ _ p x) (homAp _ _ _ _ p (ginv _ g x))
        ≡⟨ cong
          (λw. H)
          (λw. gop H h (homAp _ _ _ _ p x) w)
          (homInv _ _ _ _ p x) ⟩ gop _ h (homAp _ _ _ _ p x) (ginv _ h (homAp _ _ _ _ p x))
        ≡⟨ gInvR _ h (homAp _ _ _ _ p x) ⟩ ge h)

-- ===== the image, with the BRACKET =====
--
-- This is the choice the whole theorem turns on. The obvious spelling
--
--   im p ≜ ((y : El H) ⨯ ∥(x : El G) ⨯ Id H (p x) y∥)
--
-- is unusable: ∥·∥ lives in Ω, el-squash-e-prf reaches only further
-- PROPOSITIONS, and the inverse map G/ker p ← im p has to land in
-- DATA. With that definition the first isomorphism theorem is simply
-- not provable, and that is not a defect — it is the constructive
-- content of the statement.
--
-- bracket.nova's Br is the other truncation: Br a ≜ a / (x y. ∥𝟙∥),
-- a 𝕌-CODE whose `class` RETAINS its representative, so brElim lands
-- in an arbitrary type at the price of a constancy proof. Defining
--
--   Im p ≜ ((y : H) ⨯ Br ((x : G) ⨯ Id H (p x) y))
--
-- makes the inverse map writable, and the constancy obligation brElim
-- charges for it is EXACTLY "any two preimages of y agree modulo
-- ker p" — the mathematical content of the theorem, paid at the point
-- where it is used rather than assumed at the point where the image is
-- defined. See fromImAt below; that one obligation is the proof.
--
-- Br is also a DEFINITIONAL subsingleton (brIsProp concludes ≐), so
-- two elements of Im with equal first components are equal outright,
-- and every law of Im reduces to the corresponding law of H.
def imFib : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (y : El H)
  → 𝕌 ≔
  λG. λg. λH. λh. λp. λy. (x : G) ⨯ Id _ (homAp _ _ _ _ p x) y

def Im : (G : 𝕌) (g : El (IsGroup G)) (H : 𝕌) (h : El (IsGroup H)) (p : El (Hom _ g _ h)) → 𝕌 ≔
  λG. λg. λH. λh. λp. (y : H) ⨯ Br (imFib _ _ _ _ p y)

-- an element of the image is determined by its H-component
def imEq : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u v : El (Im _ _ _ _ p))
  → (u .π₁ ≡ v .π₁) → u ≡ v
  using (Im.unfold) ≔
  λG. λg. λH. λh. λp. λu. λv. λe. sigmaEq2
    _
    (λy. Br (imFib _ _ _ _ p y))
    _
    _
    e
    (brIsProp _ (u .π₂) (v .π₂))

def imIn : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (x : El G)
  → El (Im _ _ _ _ p)
  using (Im.unfold, imFib.unfold, id.Id.eq) ≔
  λG. λg. λH. λh. λp. λx. homAp _ _ _ _ p x, br (x, refl H (homAp _ _ _ _ p x))

-- ===== the fibres are closed under the group operations =====
def imFibOp : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {y1 y2 : El H}
  (f1 : El (imFib _ _ _ _ p y1))
  (f2 : El (imFib _ _ _ _ p y2))
  → El (imFib _ _ _ _ p (gop _ h y1 y2))
  using (imFib.unfold) ≔
  λG. λg. λH. λh. λp. λy1. λy2. λf1. λf2. gop
    _
    g
    (f1 .π₁)
    (f2 .π₁),
    eqToId
      _
      _
      (homAp _ _ _ _ p (gop _ g (f1 .π₁) (f2 .π₁))
          ≡⟨ homLaw
            _
            _
            _
            _
            p
            (f1 .π₁)
            (f2 .π₁) ⟩ gop _ h (homAp _ _ _ _ p (f1 .π₁)) (homAp _ _ _ _ p (f2 .π₁))
          ≡⟨ cong
            (λw. H)
            (λw. gop H h w (homAp _ _ _ _ p (f2 .π₁)))
            (idToEq _ _ _ (f1 .π₂)) ⟩ gop _ h y1 (homAp _ _ _ _ p (f2 .π₁))
          ≡⟨ cong (λw. H) (λw. gop H h y1 w) (idToEq _ _ _ (f2 .π₂)) ⟩ gop _ h y1 y2)

def imFibInv : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {y : El H}
  (f : El (imFib _ _ _ _ p y))
  → El (imFib _ _ _ _ p (ginv _ h y))
  using (imFib.unfold) ≔
  λG. λg. λH. λh. λp. λy. λf. ginv
    _
    g
    (f .π₁),
    eqToId
      _
      _
      (homAp _ _ _ _ p (ginv _ g (f .π₁))
          ≡⟨ homInv _ _ _ _ p (f .π₁) ⟩ ginv _ h (homAp _ _ _ _ p (f .π₁))
          ≡⟨ cong (λw. H) (λw. ginv H h w) (idToEq _ _ _ (f .π₂)) ⟩ ginv _ h y)

-- ...and the same, one bracket up. Every constancy proof here is
-- brIsProp: the target is itself a bracket, so nothing is owed
def imOpBrAt : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {y1 y2 : El H}
  (f1 : El (imFib _ _ _ _ p y1))
  (w2 : El (Br (imFib _ _ _ _ p y2)))
  → El (Br (imFib _ _ _ _ p (gop _ h y1 y2))) ≔
  λG. λg. λH. λh. λp. λy1. λy2. λf1. λw2. brElim
    _
    (λf2. br (imFibOp f1 f2))
    (λf2. λf2'. brIsProp _ (br (imFibOp f1 f2)) (br (imFibOp f1 f2')))
    w2

def imOpBr : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {y1 y2 : El H}
  (w1 : El (Br (imFib _ _ _ _ p y1)))
  (w2 : El (Br (imFib _ _ _ _ p y2)))
  → El (Br (imFib _ _ _ _ p (gop _ h y1 y2))) ≔
  λG. λg. λH. λh. λp. λy1. λy2. λw1. λw2. brElim
    _
    (λf1. imOpBrAt f1 w2)
    (λf1. λf1'. brIsProp _ (imOpBrAt f1 w2) (imOpBrAt f1' w2))
    w1

def imInvBr : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {y : El H}
  (w : El (Br (imFib _ _ _ _ p y)))
  → El (Br (imFib _ _ _ _ p (ginv _ h y))) ≔
  λG. λg. λH. λh. λp. λy. λw. brElim
    _
    (λf. br (imFibInv f))
    (λf. λf'. brIsProp _ (br (imFibInv f)) (br (imFibInv f')))
    w

-- ===== the image is a group =====
def imOp : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → El (Im _ _ _ _ p) → El (Im _ _ _ _ p) → El (Im _ _ _ _ p)
  using (Im.unfold) ≔
  λG. λg. λH. λh. λp. λu. λv. gop _ h (u .π₁) (v .π₁), imOpBr (u .π₂) (v .π₂)

def imUnit : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → El (Im _ _ _ _ p)
  using (Im.unfold, imFib.unfold) ≔
  λG. λg. λH. λh. λp. ge h, br (ge g, eqToId _ _ (homUnit _ _ _ _ p))

def imInv : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → El (Im _ _ _ _ p) → El (Im _ _ _ _ p)
  using (Im.unfold) ≔
  λG. λg. λH. λh. λp. λu. ginv _ h (u .π₁), imInvBr (u .π₂)

def imIsGroup : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → El (IsGroup (Im _ _ _ _ p))
  using (group.IsGroup.unfold, monoid.IsMonoid.unfold, Im.unfold, imOp.eq, imUnit.eq, imInv.eq) ≔
  λG. λg. λH. λh. λp. (imOp
    _
    _
    _
    _
    _,
    imUnit
      _
      _
      _
      _
      _,
      (λx. λy. λz. eqToId
        _
        _
        (imEq
          _
          _
          _
          _
          _
          (imOp _ _ _ _ _ (imOp _ _ _ _ _ x y) z)
          (imOp _ _ _ _ _ x (imOp _ _ _ _ _ y z))
          (gAssoc
            _
            h
            (x .π₁)
            (y .π₁)
            (z .π₁)))),
        (λx. eqToId
          _
          _
          (imEq
            _
            _
            _
            _
            _
            (imOp _ _ _ _ _ (imUnit _ _ _ _ p) x)
            _
            (gUnitL
              _
              h
              (x .π₁)))),
          λx. eqToId
            _
            _
            (imEq
              _
              _
              _
              _
              _
              (imOp _ _ _ _ _ x (imUnit _ _ _ _ p))
              _
              (gUnitR
                _
                h
                (x .π₁)))),
    imInv
      _
      _
      _
      _
      _,
      (λx. eqToId
        (imOp _ _ _ _ _ (imInv _ _ _ _ _ x) x)
        (imUnit _ _ _ _ p)
        (imEq
          _
          _
          _
          _
          _
          (imOp _ _ _ _ _ (imInv _ _ _ _ _ x) x)
          (imUnit _ _ _ _ p)
          (gInvL
            _
            h
            (x .π₁)))),
        λx. eqToId
          (imOp _ _ _ _ _ x (imInv _ _ _ _ _ x))
          (imUnit _ _ _ _ p)
          (imEq
            _
            _
            _
            _
            _
            (imOp _ _ _ _ _ x (imInv _ _ _ _ _ x))
            (imUnit _ _ _ _ p)
            (gInvR _ h (x .π₁)))

-- ===== G/ker p  →  im p =====
--
-- The forward map is a descent out of the quotient, and its constancy
-- proof is groupHom.homKillConst at N ≜ ker p — where "kills N" is the
-- identity function, because membership in the kernel IS the equation
-- it has to produce.
def kerKills : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (x : El G)
  → Prf (ker _ _ _ _ p x) → homAp _ _ _ _ p x ≡ ge h
  using (ker.eq) ≔
  λG. λg. λH. λh. λp. λx. λk. k

def toImConst : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (a a' : El G)
  → Prf (cosetRel _ g (ker _ _ _ _ p) a a') → imIn _ _ _ _ p a ≡ imIn _ _ _ _ _ a'
  using (imIn.eq) ≔
  λG. λg. λH. λh. λp. λa. λa'. λr. imEq
    _
    _
    _
    _
    _
    _
    _
    (homKillConst _ _ _ _ _ p (kerKills _ _ _ _ p) _ _ r)

def toImMap : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  → El (QGroup _ g (ker _ _ _ _ p)) → El (Im _ _ _ _ p) ≔
  λG. λg. λH. λh. λp. λu. qFactor _ _ _ (imIn _ _ _ _ p) (toImConst _ _ _ _ p) u

def toImCls : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (a : El G)
  → toImMap _ _ _ _ p (class a) ≡ imIn _ _ _ _ _ a
  using (quotGroup.QGroup.unfold, toImMap.eq) ≔
  λG. λg. λH. λh. λp. λa. qFactorCls _ _ _ _ (imIn _ _ _ _ p) (toImConst _ _ _ _ p) a

def imInOp : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (a b : El G)
  → imIn _ _ _ _ p (gop _ g a b) ≡ imOp _ _ _ _ _ (imIn _ _ _ _ p a) (imIn _ _ _ _ p b)
  using (imIn.eq, imOp.eq) ≔
  λG. λg. λH. λh. λp. λa. λb. imEq _ _ _ _ _ _ _ (homLaw _ _ _ _ p a b)

def toImLawQ : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {u v : El (QGroup _ g (ker _ _ _ _ p))}
  → toImMap
    _
    _
    _
    _
    _
    (qMul
      _
      _
      _
      (kerIsNormal _ _ _ _ p)
      u
      v) ≡ imOp _ _ _ _ _ (toImMap _ _ _ _ _ u) (toImMap _ _ _ _ _ v)
  using (quotGroup.QGroup.unfold) ≔
  λG. λg. λH. λh. λp. λu. λv. quot-elim
    (a. quot-elim
      (b. toImMap _ _ _ _ _ (qMul _ _ _ (kerIsNormal _ _ _ _ p) (class a) (class b))
          ≡⟨ cong
            (λw. Im _ _ _ _ p)
            (λw. toImMap _ _ _ _ _ w)
            (qMulCls _ _ _ (kerIsNormal _ _ _ _ p) a b) ⟩ toImMap _ _ _ _ _ (class (gop _ g a b))
          ≡⟨ toImCls _ _ _ _ p (gop _ g a b) ⟩ imIn _ _ _ _ _ (gop _ g a b)
          ≡⟨ imInOp _ _ _ _ p a b ⟩ imOp _ _ _ _ _ (imIn _ _ _ _ p a) (imIn _ _ _ _ p b)
          ≡⟨ cong
            (λw. Im _ _ _ _ p)
            (λw. imOp _ _ _ _ _ w (imIn _ _ _ _ p b))
            (sym
              _
              _
              _
              (toImCls
                _
                _
                _
                _
                p
                a)) ⟩ imOp _ _ _ _ _ (toImMap _ _ _ _ p (class a)) (imIn _ _ _ _ p b)
          ≡⟨ cong
            (λw. Im _ _ _ _ p)
            (λw. imOp _ _ _ _ _ (toImMap _ _ _ _ p (class a)) w)
            (sym
              _
              _
              _
              (toImCls
                _
                _
                _
                _
                p
                b)) ⟩ imOp _ _ _ _ _ (toImMap _ _ _ _ p (class a)) (toImMap _ _ _ _ p (class b)))
      v)
    u

def imopIsImOp : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u v : El (Im _ _ _ _ p))
  → gop _ (imIsGroup _ _ _ _ p) u v ≡ imOp _ _ _ _ _ u v
  using (groupTheory.gop.eq, imIsGroup.eq) ≔
  λG. λg. λH. λh. λp. λu. λv. ⋆

def toImLaw : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u v : El (QGroup _ g (ker _ _ _ _ p)))
  → toImMap
    _
    _
    _
    _
    _
    (gop
      _
      (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
      u
      v) ≡ gop _ (imIsGroup _ _ _ _ p) (toImMap _ _ _ _ _ u) (toImMap _ _ _ _ _ v) ≔
  λG. λg. λH. λh. λp. λu. λv. trans
    _
    _
    _
    _
    (cong
      (λw. Im _ _ _ _ p)
      (λw. toImMap _ _ _ _ _ w)
      (qopIsQMul _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p) u v))
    (trans
      _
      (toImMap _ _ _ _ _ (qMul _ _ _ (kerIsNormal _ _ _ _ p) u v))
      _
      _
      toImLawQ
      (sym _ _ _ (imopIsImOp _ _ _ _ _ (toImMap _ _ _ _ _ u) (toImMap _ _ _ _ _ v))))

def toIm : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  → El (Hom
    _
    (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
    _
    (imIsGroup _ _ _ _ p)) ≔
  λG. λg. λH. λh. λp. homIntro (toImMap _ _ _ _ p) (toImLaw _ _ _ _ p)

-- ===== im p → G/ker p : THE SHOWCASE =====
--
-- Here is why the image had to be defined with the bracket. To send an
-- element of the image back into the quotient one needs a PREIMAGE,
-- as data, and brElim supplies it. What it charges in exchange is
-- fromImConst — and fromImConst is not overhead, it IS the first
-- isomorphism theorem:
--
--   any two preimages of the same y are congruent modulo ker p.
--
-- Two lines: p (x · x'⁻¹) = p x · (p x')⁻¹ = y · y⁻¹ = e. The content
-- is paid exactly where it is used. With ∥·∥ in place of Br there
-- would be no obligation to pay and no map to define — squash-elim
-- reaches only propositions, and this one lands in data.
def fromImConst : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (y : El H)
  (f f' : El (imFib _ _ _ _ p y))
  → qcls _ g (ker _ _ _ _ p) (f .π₁) ≡ qcls _ _ _ (f' .π₁)
  using (ker.eq, subgroup.cosetRel.eq, imFib.unfold) ≔
  λG. λg. λH. λh. λp. λy. λf. λf'. qclsEq
    (kerIsSubgroup _ _ _ _ p)
    _
    _
    (homAp _ _ _ _ p (gop _ g (f .π₁) (ginv _ g (f' .π₁)))
        ≡⟨ homOpInv
          _
          _
          _
          _
          p
          (f .π₁)
          (f' .π₁) ⟩ gop _ h (homAp _ _ _ _ p (f .π₁)) (ginv _ h (homAp _ _ _ _ p (f' .π₁)))
        ≡⟨ cong
          (λw. H)
          (λw. gop H h w (ginv _ h (homAp _ _ _ _ p (f' .π₁))))
          (idToEq _ _ _ (f .π₂)) ⟩ gop _ h y (ginv _ h (homAp _ _ _ _ p (f' .π₁)))
        ≡⟨ cong
          (λw. H)
          (λw. gop H h y (ginv _ h w))
          (idToEq _ _ _ (f' .π₂)) ⟩ gop _ h y (ginv _ h y)
        ≡⟨ gInvR _ h y ⟩ ge h)

def fromImAt : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  (y : El H)
  (w : El (Br (imFib _ _ _ _ p y)))
  → El (QGroup _ g (ker _ _ _ _ p))
  using (imFib.unfold) ≔
  λG. λg. λH. λh. λp. λy. λw. brElim
    _
    (λf. qcls _ g (ker _ _ _ _ p) (f .π₁))
    (fromImConst _ _ _ _ p y)
    w

def fromIm : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  (z : El (Im _ _ _ _ p))
  → El (QGroup _ g (ker _ _ _ _ p))
  using (Im.unfold) ≔
  λG. λg. λH. λh. λp. λz. fromImAt _ (z .π₂)

-- ===== the two round trips =====
def fromImIn : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {a : El G}
  → fromIm (imIn _ _ _ _ p a) ≡ qcls _ _ _ a
  using (imIn.eq, fromIm.eq, fromImAt.eq, bracket.br.eq, bracket.brElim.eq) ≔
  λG. λg. λH. λh. λp. λa. ⋆

def fromImToIm : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u : El (QGroup _ g (ker _ _ _ _ p)))
  → fromIm (toImMap _ _ _ _ _ u) ≡ u
  using (quotGroup.QGroup.unfold, quotGroup.qcls.eq) ≔
  λG. λg. λH. λh. λp. λu. quot-elim
    (a. trans
      _
      _
      _
      _
      (cong (λw. QGroup _ g (ker _ _ _ _ p)) (λw. fromIm w) (toImCls _ _ _ _ p a))
      fromImIn)
    u

-- the other round trip, through imEq: only the H-component has to be
-- checked, and a quot-elim over the bracket recovers the preimage's
-- own Id proof to check it with
def toImFromImFst : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (y : El H)
  (w : El (Br (imFib _ _ _ _ p y)))
  → toImMap _ _ _ _ _ (fromImAt _ w) .π₁ ≡ y
  using (Im.unfold,
    imFib.unfold,
    imIn.eq,
    fromImAt.eq,
    bracket.Br.unfold,
    bracket.brElim.eq,
    quotGroup.qcls.eq) ≔
  λG. λg. λH. λh. λp. λy. λw. quot-elim
    (f. trans
      _
      _
      (homAp _ _ _ _ p (f .π₁))
      _
      (cong
        (λw. H)
        (λw. w .π₁)
        {toImMap G g H h p (fromImAt y (class f))}
        {imIn _ _ _ _ p (f .π₁)}
        (toImCls _ _ _ _ p (f .π₁)))
      (idToEq _ _ _ (f .π₂)))
    w

def toImFromIm : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (z : El (Im _ _ _ _ p))
  → toImMap _ _ _ _ _ (fromIm z) ≡ z
  using (Im.unfold, fromIm.eq) ≔
  λG. λg. λH. λh. λp. λz. imEq _ _ _ _ _ _ _ (toImFromImFst _ _ _ _ _ _ (z .π₂))

-- ===== the canonical factorisation  p = incl ∘ φ ∘ π  =====
def imIncFun : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u : El (Im _ _ _ _ p))
  → El H
  using (Im.unfold) ≔
  λG. λg. λH. λh. λp. λu. u .π₁

def imIncLaw : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u v : El (Im _ _ _ _ p))
  → imIncFun
    _
    _
    _
    _
    _
    (gop _ (imIsGroup _ _ _ _ p) u v) ≡ gop _ h (imIncFun _ _ _ _ _ u) (imIncFun _ _ _ _ _ v)
  using (imIncFun.eq, imOp.eq) ≔
  λG. λg. λH. λh. λp. λu. λv. trans
    _
    _
    _
    _
    (cong (λw. H) (λw. imIncFun _ _ H _ _ w) (imopIsImOp _ _ _ _ _ u v))
    ⋆

def imInc : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  → El (Hom _ (imIsGroup _ _ _ _ p) _ h) ≔
  λG. λg. λH. λh. λp. homIntro (imIncFun _ _ _ _ p) (imIncLaw _ _ _ _ p)

def imIncAp : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (u : El (Im _ _ _ _ p))
  → homAp _ (imIsGroup _ _ _ _ p) _ h imInc u ≡ imIncFun _ _ _ _ _ u
  using (imInc.eq) ≔
  λG. λg. λH. λh. λp. λu. homIntroAp _ _ _ _ (imIncFun _ _ _ _ p) (imIncLaw _ _ _ _ p) u

def toImAp : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {u : El (QGroup _ g (ker _ _ _ _ p))}
  → homAp
    _
    (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
    _
    (imIsGroup _ _ _ _ p)
    toIm
    u ≡ toImMap _ _ _ _ _ u
  using (toIm.eq) ≔
  λG. λg. λH. λh. λp. λu. homIntroAp _ _ _ _ (toImMap _ _ _ _ p) (toImLaw _ _ _ _ p) u

-- φ ∘ π is p, followed into the image
def toImOfProj : {G : 𝕌}
  {g : El (IsGroup G)}
  {H : 𝕌}
  {h : El (IsGroup H)}
  {p : El (Hom _ g _ h)}
  {a : El G}
  → homAp
    _
    (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
    _
    (imIsGroup _ _ _ _ p)
    toIm
    (homAp
      _
      g
      _
      (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
      qProj
      a) ≡ imIn _ _ _ _ _ a
  using (quotGroup.qcls.eq) ≔
  λG. λg. λH. λh. λp. λa. trans
    _
    _
    _
    _
    (cong
      (λw. Im _ _ _ _ p)
      (λw. homAp
        _
        (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
        (Im _ _ _ _ p)
        (imIsGroup _ _ _ _ p)
        toIm
        w)
      {homAp _ g _ (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p)) qProj a}
      {qcls _ g (ker _ _ _ _ p) a}
      qProjAp)
    (trans
      _
      (homAp
        _
        (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
        _
        (imIsGroup _ _ _ _ p)
        toIm
        (qcls _ g (ker _ _ _ _ p) a))
      (toImMap _ _ _ _ _ (qcls _ g (ker _ _ _ _ p) a))
      _
      toImAp
      (toImCls _ _ _ _ p a))

-- ...and the inclusion sends it back to p a: the factorisation, closed
def firstIsoFactors : (G : 𝕌)
  (g : El (IsGroup G))
  (H : 𝕌)
  (h : El (IsGroup H))
  (p : El (Hom _ g _ h))
  (a : El G)
  → homAp
    _
    (imIsGroup _ _ _ _ p)
    _
    h
    imInc
    (homAp
      _
      (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
      _
      (imIsGroup _ _ _ _ p)
      toIm
      (homAp
        _
        g
        _
        (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
        qProj
        a)) ≡ homAp _ _ _ _ p a
  using (imIn.eq, imIncFun.eq) ≔
  λG. λg. λH. λh. λp. λa. trans
    _
    _
    _
    _
    (cong
      (λw. H)
      (λw. homAp _ (imIsGroup _ _ _ _ p) H h imInc w)
      {homAp
        _
        (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p))
        _
        (imIsGroup _ _ _ _ p)
        toIm
        (homAp _ g _ (qIsGroup _ _ _ (kerIsSubgroup _ _ _ _ p) (kerIsNormal _ _ _ _ p)) qProj a)}
      {imIn _ _ _ _ p a}
      toImOfProj)
    (imIncAp _ _ _ _ _ (imIn _ _ _ _ p a))
