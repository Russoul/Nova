-- Normalization of difference-pair integers: cancel the common part.
-- Canonical representatives for difference-pair integers.
def plus : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
def plusZeroId : (n : ℕ) → plus n Z ≡ n ∈ ℕ ≔ λn. Refl
def plusSucId : (n : ℕ) (m : ℕ) → plus n (S m) ≡ S (plus n m) ∈ ℕ ≔ λn. λm. Refl
def zeroPlusId : (n : ℕ) → plus Z n ≡ n ∈ ℕ ≔ λn. ℕ-elim (k. plus Z k ≡ k ∈ ℕ) Refl (k ih. Refl) n

-- the canonical representative: strip successors pairwise
def normPair : ℕ → ℕ → ℕ ⨯ ℕ ≔
  λa. ℕ-elim (k. ℕ → ℕ ⨯ ℕ)
        (λb. (Z , b))
        (n ih. λb. ℕ-elim (k. ℕ ⨯ ℕ) (S n , Z) (m ihb. ih m) b)
        a

-- normPair a b is R-related to (a, b)
def normSound : (a : ℕ) → (b : ℕ) →
  (plus ((normPair a b) .π₁) b ≡ plus ((normPair a b) .π₂) a ∈ ℕ) ≔
  λa.
    ℕ-elim (k. (b : ℕ) → (plus ((normPair k b) .π₁) b ≡ plus ((normPair k b) .π₂) k ∈ ℕ))
      (λb. Refl)
      (n ih. λb.
        ℕ-elim (m. plus ((normPair (S n) m) .π₁) m ≡ plus ((normPair (S n) m) .π₂) (S n) ∈ ℕ)
          Refl
          (m ihb. Refl)
          b)
      a

type Int ≔ (ℕ ⨯ ℕ) / (p q. plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ)

-- at the quotient, normalization is invisible
def normClass : (a : ℕ) (b : ℕ) → class (normPair a b) ≡ class (a , b) ∈ Int ≔ λa. λb. Refl

def intNormalize : Int → Int ≔
  λz. quot-elim (w. Int) (rep. class (normPair (rep .π₁) (rep .π₂))) z

def intNormalizeTest1 : intNormalize (class (S Z , Z)) ≡ class (S Z , Z) ∈ Int ≔ Refl
def intNormalizeTest2 : intNormalize (class (S Z , S (S Z))) ≡ class (Z , S Z) ∈ Int ≔ Refl
