-- Multiplication of integers as difference pairs:
--   (a₁,a₂) · (b₁,b₂) ≔ (a₁b₁ + a₂b₂, a₁b₂ + a₂b₁)
-- Unlike addition, both well-definedness obligations need real work:
-- the cross-sum identity has to be regrouped by DISTRIBUTIVITY before
-- the relatedness hypothesis can fire.
-- ===== nat lemmas, in the orientation the engine can use =====
--
-- Rewriting is oriented and size-decreasing, so nat.nova's
-- distributivity — stated in the size-INCREASING direction — never
-- fires as a rewrite rule. Its flips do; each is proved by ⋆, the
-- original firing by whole-equation match on the flipped goal.

import nat (+, *, plusZeroId, plusSucId, zeroPlusId, sucPlus, plusComm, plusAssoc, swapLeft, multZeroId, multSucId, zeroMult, sucMult, multComm, multDistrib, multAssoc)
import integer (Int, intZero, intOne, intNeg)
import integerAdd (intAdd, intAddComm, intAddAssoc)
import equality (trans, cong, sym)

def distribBack : {n m k : ℕ} → n * m + n * k ≡ n * (m + k) using (multDistrib) ≔ λn. λm. λk. ⋆

-- right distributivity: nat.nova has only the left law, so this is
-- multComm on each factor, distribBack in the middle, multComm back
def distribBackR : (m k n : ℕ) → m * n + k * n ≡ (m + k) * n using (distribBack) ≔
  λm. λk. λn. trans
    ℕ
    (m * n + k * n)
    (n * m + n * k)
    ((m + k) * n)
    (trans
      ℕ
      (m * n + k * n)
      (n * m + k * n)
      (n * m + n * k)
      (cong ℕ (λu. ℕ) (λw. w + k * n) (m * n) (n * m) (multComm n m))
      (cong ℕ (λu. ℕ) (λw. n * m + w) (k * n) (n * k) (multComm n k)))
    (trans ℕ (n * m + n * k) (n * (m + k)) ((m + k) * n) distribBack (multComm (m + k) n))

-- the two exchanges of a four-term sum
def swap4 : (p q r s : ℕ) → p + q + (r + s) ≡ p + r + (q + s)
  using (hyp.rw, nat.swapMid, nat.swapMid.rw, plusAssoc, plusAssoc.rw, swapLeft, swapLeft.rw) ≔
  λp. λq. λr. λs. ⋆

def swap4b : {p q r s : ℕ} → p + q + (r + s) ≡ p + s + (q + r)
  using (integerAdd.intAddCross, swap4, plusAssoc) ≔
  λp. λq. λr. λs. p + q + (r + s)
      ≡⟨ plusComm s r ⟩ p + q + (s + r)
      ≡⟨ swap4 p q s r ⟩ p + s + (q + r)

-- congruence of + in each argument: with h reflected the two sides
-- are judgemental, so each is one ⋆ (and unlike a rewrite step, a
-- lemma application is unconstrained by the position it lands in)
def plusCongL : {x y z : ℕ} → (x ≡ y) → x + z ≡ y + z using (hyp.rw) ≔ λx. λy. λz. λh. ⋆

def plusCongR : {x y z : ℕ} → (y ≡ z) → x + y ≡ x + z ≔ λx. λy. λz. λh. ⋆

-- x*y*z + x*u*v ≡ x*(y*z + u*v): reassociate both products, then
-- collect the common left factor
def collectL : (x y z u v : ℕ) → x * y * z + x * u * v ≡ x * (y * z + u * v)
  using (distribBack, multAssoc) ≔
  λx. λy. λz. λu. λv. trans
    ℕ
    (x * y * z + x * u * v)
    (x * (y * z) + x * (u * v))
    (x * (y * z + u * v))
    (trans
      ℕ
      (x * y * z + x * u * v)
      (x * (y * z) + x * u * v)
      (x * (y * z) + x * (u * v))
      (plusCongL (multAssoc x y z))
      (plusCongR (multAssoc x u v)))
    distribBack

-- the representative-level associativity identity, one component of
-- it; the other component is this one with c₁ and c₂ swapped.
-- A CALC CHAIN (docs/SearchlessElaboration.md §5.2): expand both
-- products by right distributivity, exchange the middle two summands,
-- then collect a₁ and a₂ back out — each link a named sub-equation,
-- its position and orientation found by the link-scoped engine (no
-- sym, no cong wrappers, no repeated midpoints)
def assocRep : (a1 a2 b1 b2 c1 c2 : ℕ)
  → (a1
    * b1
    + a2 * b2) * c1 + (a1 * b2 + a2 * b1) * c2 ≡ a1 * (b1 * c1 + b2 * c2) + a2 * (b1 * c2 + b2 * c1)
  using (hyp.rw) ≔
  λa1. λa2. λb1. λb2. λc1. λc2. (a1 * b1 + a2 * b2) * c1 + (a1 * b2 + a2 * b1) * c2
      ≡⟨ distribBackR
        (a1 * b1)
        (a2 * b2)
        c1 ⟩ a1 * b1 * c1 + a2 * b2 * c1 + (a1 * b2 + a2 * b1) * c2
      ≡⟨ distribBackR
        (a1 * b2)
        (a2 * b1)
        c2 ⟩ a1 * b1 * c1 + a2 * b2 * c1 + (a1 * b2 * c2 + a2 * b1 * c2)
      ≡⟨ swap4
        (a1 * b1 * c1)
        (a2 * b2 * c1)
        (a1 * b2 * c2)
        (a2 * b1 * c2) ⟩ a1 * b1 * c1 + a1 * b2 * c2 + (a2 * b2 * c1 + a2 * b1 * c2)
      ≡⟨ collectL a1 b1 c1 b2 c2 ⟩ a1 * (b1 * c1 + b2 * c2) + (a2 * b2 * c1 + a2 * b1 * c2)
      ≡⟨ collectL a2 b2 c1 b1 c2 ⟩ a1 * (b1 * c1 + b2 * c2) + a2 * (b2 * c1 + b1 * c2)
      ≡⟨ plusComm (b1 * c2) (b2 * c1) ⟩ a1 * (b1 * c1 + b2 * c2) + a2 * (b1 * c2 + b2 * c1)

-- regroup a cross-sum by the LEFT factor: this is the shape the inner
-- well-definedness goal takes, and once regrouped the relatedness
-- hypothesis makes the two sides judgementally equal
def sum4Distrib : (a1 a2 b1 b2 c1 c2 : ℕ)
  → a1 * b1 + a2 * b2 + (a1 * c2 + a2 * c1) ≡ a1 * (b1 + c2) + a2 * (b2 + c1)
  using (distribBack, plusAssoc) ≔
  λa1. λa2. λb1. λb2. λc1. λc2. trans
    ℕ
    (a1 * b1 + a2 * b2 + (a1 * c2 + a2 * c1))
    (a1 * b1 + a1 * c2 + (a2 * b2 + a2 * c1))
    (a1 * (b1 + c2) + a2 * (b2 + c1))
    (swap4 (a1 * b1) (a2 * b2) (a1 * c2) (a2 * c1))
    (trans
      ℕ
      (a1 * b1 + a1 * c2 + (a2 * b2 + a2 * c1))
      (a1 * (b1 + c2) + (a2 * b2 + a2 * c1))
      (a1 * (b1 + c2) + a2 * (b2 + c1))
      (cong
        ℕ
        (λu. ℕ)
        (λw. w + (a2 * b2 + a2 * c1))
        (a1 * b1 + a1 * c2)
        (a1 * (b1 + c2))
        distribBack)
      (cong ℕ (λu. ℕ) (λw. a1 * (b1 + c2) + w) (a2 * b2 + a2 * c1) (a2 * (b2 + c1)) distribBack))

-- and by the RIGHT factor: the shape of the OUTER well-definedness goal
def sum4DistribR : (x1 x2 y1 y2 c1 c2 : ℕ)
  → x1 * c1 + x2 * c2 + (y1 * c2 + y2 * c1) ≡ (x1 + y2) * c1 + (x2 + y1) * c2
  using (distribBackR, plusAssoc) ≔
  λx1. λx2. λy1. λy2. λc1. λc2. trans
    ℕ
    (x1 * c1 + x2 * c2 + (y1 * c2 + y2 * c1))
    (x1 * c1 + y2 * c1 + (x2 * c2 + y1 * c2))
    ((x1 + y2) * c1 + (x2 + y1) * c2)
    swap4b
    (trans
      ℕ
      (x1 * c1 + y2 * c1 + (x2 * c2 + y1 * c2))
      ((x1 + y2) * c1 + (x2 * c2 + y1 * c2))
      ((x1 + y2) * c1 + (x2 + y1) * c2)
      (cong
        ℕ
        (λu. ℕ)
        (λw. w + (x2 * c2 + y1 * c2))
        (x1 * c1 + y2 * c1)
        ((x1 + y2) * c1)
        (distribBackR x1 y2 c1))
      (cong
        ℕ
        (λu. ℕ)
        (λw. (x1 + y2) * c1 + w)
        (x2 * c2 + y1 * c2)
        ((x2 + y1) * c2)
        (distribBackR x2 y1 c2)))

-- ===== the two well-definedness lemmas =====
-- inner: y varies. Both sides regroup to a₁·t + a₂·t′ with t and t′
-- interchanged, and h makes t ≐ t′.
def intMulWD : (a1 a2 b1 b2 c1 c2 : ℕ)
  (h : Prf (b1 + c2 ≡ b2 + c1))
  → a1 * b1 + a2 * b2 + (a1 * c2 + a2 * c1) ≡ a1 * b2 + a2 * b1 + (a1 * c1 + a2 * c2)
  using (distribBack, distribBackR, hyp.rw, plusAssoc, sum4Distrib) ≔
  λa1. λa2. λb1. λb2. λc1. λc2. λh. trans
    ℕ
    (a1 * b1 + a2 * b2 + (a1 * c2 + a2 * c1))
    (a1 * (b1 + c2) + a2 * (b2 + c1))
    (a1 * b2 + a2 * b1 + (a1 * c1 + a2 * c2))
    (sum4Distrib a1 a2 b1 b2 c1 c2)
    (sym
      ℕ
      (a1 * b2 + a2 * b1 + (a1 * c1 + a2 * c2))
      (a1 * (b2 + c1) + a2 * (b1 + c2))
      (sum4Distrib a1 a2 b2 b1 c2 c1))

-- outer: x varies; the same regrouping, by the right factor
def intMulWDRep : (a1 a2 b1 b2 c1 c2 : ℕ)
  (h : Prf (a1 + b2 ≡ a2 + b1))
  → a1 * c1 + a2 * c2 + (b1 * c2 + b2 * c1) ≡ a1 * c2 + a2 * c1 + (b1 * c1 + b2 * c2)
  using (distribBack, hyp.rw, plusAssoc, plusComm, sum4DistribR) ≔
  λa1. λa2. λb1. λb2. λc1. λc2. λh. trans
    ℕ
    (a1 * c1 + a2 * c2 + (b1 * c2 + b2 * c1))
    ((a1 + b2) * c1 + (a2 + b1) * c2)
    (a1 * c2 + a2 * c1 + (b1 * c1 + b2 * c2))
    (sum4DistribR a1 a2 b1 b2 c1 c2)
    (sym
      ℕ
      (a1 * c2 + a2 * c1 + (b1 * c1 + b2 * c2))
      ((a1 + b2) * c2 + (a2 + b1) * c1)
      (sum4DistribR a1 a2 b1 b2 c2 c1))

-- the outer well-definedness, in the quot-elim shape the elaborator
-- actually asks for (integerAdd.nova's intAddWDOuter, one level up):
-- eliminate the remaining argument and the goal becomes the nat
-- relation intMulWDRep proves
def intMulWDOuter : (a b : ℕ ⨯ ℕ)
  (h : Prf (a .π₁ + b .π₂ ≡ a .π₂ + b .π₁))
  (zy : El Int)
  → quot-elim (z. El Int)
    (x. class (a .π₁ * x .π₁ + a .π₂ * x .π₂, a .π₁ * x .π₂ + a .π₂ * x .π₁))
    zy ≡ quot-elim (x. class (b .π₁ * x .π₁ + b .π₂ * x .π₂, b .π₁ * x .π₂ + b .π₂ * x .π₁)) zy
  using (distribBack,
    distribBackR,
    integer.Int.unfold,
    integerMul.intMulWD,
    integerMul.intMulWDRep,
    multDistrib,
    plusAssoc,
    plusComm,
    sum4Distrib,
    sum4DistribR) ≔
  λa. λb. λh. λzy. quot-elim (q. quot-elim (z. El Int)
    (x. class (a .π₁ * x .π₁ + a .π₂ * x .π₂, a .π₁ * x .π₂ + a .π₂ * x .π₁))
    q ≡ quot-elim (x. class (b .π₁ * x .π₁ + b .π₂ * x .π₂, b .π₁ * x .π₂ + b .π₂ * x .π₁)) q)
    (c. ⋆)
    zy

-- ===== multiplication =====
def intMul : El Int → El Int → El Int
  using (distribBackR,
    intMulWDOuter,
    integer.Int.unfold,
    integerMul.intMulWD,
    plusAssoc,
    sum4Distrib) ≔
  λx. λy. quot-elim
    (a. quot-elim (b. class (a .π₁ * b .π₁ + a .π₂ * b .π₂, a .π₁ * b .π₂ + a .π₂ * b .π₁)) y)
    x

-- 2 · 3 = 6 and (−2) · 3 = −6
def intMulTest1 : intMul (class (2, Z)) (class (3, Z)) ≡ class (6, Z)
  using (integer.Int.unfold, integerMul.intMul.eq, nat.*.eq, nat.+.eq) ≔
  ⋆

def intMulTest2 : intMul (class (Z, 2)) (class (3, Z)) ≡ class (Z, 6)
  using (integer.Int.unfold, integerMul.intMul.eq, nat.*.eq, nat.+.eq) ≔
  ⋆

-- ===== the ring laws =====
-- Σ-η. Stated GENERICALLY: the engine's matching is first-order and
-- would happily fire a ℕ ⨯ ℕ-specific version at a pair of ANY type,
-- and the kernel then rejects the certificate — so the lemma has to
-- be true at the type it gets used at.
def pairEta : (A B : 𝕌) (p : El (A ⨯ B)) → (p .π₁, p .π₂) ≡ p using (sigma.eta) ≔ λA. λB. λp. ⋆

def classPairEta : (p : ℕ ⨯ ℕ) → class (p .π₁, p .π₂) ≡ class p ∈ El Int
  using (integer.Int.unfold) ≔
  λp. cong (ℕ ⨯ ℕ) (λu. Int) (λr. class r) (p .π₁, p .π₂) p (pairEta ℕ ℕ p)

def oneMult : (m : ℕ) → S Z * m ≡ m using (multComm) ≔
  λm. S Z * m ≡⟨ sucMult Z m ⟩ m + Z * m ≡⟨ zeroMult m ⟩ m + Z ≡⟨ plusZeroId m ⟩ m

-- class (u₁,u₂) ≡ class (v₁,v₂) from the two component equations:
-- reflection makes the components judgemental, so this is one ⋆
def classCong2 : {u1 u2 v1 v2 : ℕ}
  → (u1 ≡ v1) → (u2 ≡ v2) → class (u1, u2) ≡ class (v1, v2) ∈ El Int
  using (hyp.rw, integer.Int.unfold) ≔
  λu1. λu2. λv1. λv2. λh1. λh2. ⋆

-- multiplication by 1 on the LEFT does not compute (nat.nova's * is
-- recursive in its SECOND argument), so oneMult/zeroMult have to fire
-- before Σ-η can close it; on the right it is all β (intMulOneR)
def intMulOneL : (z : El Int) → intMul intOne z ≡ z
  using (classPairEta,
    integer.Int.unfold,
    integer.intOne.eq,
    integerMul.intMul.eq,
    oneMult,
    oneMult.rw,
    plusZeroId,
    plusZeroId.rw,
    zeroMult,
    zeroMult.rw) ≔
  λz. quot-elim
    (p. trans Int (class (p .π₁, p .π₂)) (class (p .π₁, p .π₂)) (class p) ⋆ (classPairEta p))
    z

def intMulOneR : (z : El Int) → intMul z intOne ≡ z
  using (classPairEta,
    integer.Int.unfold,
    integer.intOne.eq,
    integerMul.intMul.eq,
    multSucId,
    multSucId.rw,
    multZeroId,
    multZeroId.rw,
    plusZeroId,
    plusZeroId.rw,
    zeroPlusId,
    zeroPlusId.rw) ≔
  λz. quot-elim (p. classPairEta p) z

def intMulZeroL : (z : El Int) → intMul intZero z ≡ intZero
  using (distribBack,
    distribBack.rw,
    hyp.rw,
    intMul.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intZero.eq,
    zeroMult,
    zeroMult.rw) ≔
  λz. quot-elim (p. ⋆) z

def intMulZeroR : {z : El Int} → intMul z intZero ≡ intZero
  using (integer.Int.unfold, integer.intZero.eq, integerMul.intMul.eq) ≔
  λz. quot-elim (p. ⋆) z

-- u₁v₁ + u₂v₂ ≡ v₁u₁ + v₂u₂: multComm is permutative, so it never
-- rewrites — each factor has to be commuted by an explicit cong
def mulComm2 : (u1 u2 v1 v2 : ℕ) → u1 * v1 + u2 * v2 ≡ v1 * u1 + v2 * u2 ≔
  λu1. λu2. λv1. λv2. trans
    ℕ
    (u1 * v1 + u2 * v2)
    (v1 * u1 + u2 * v2)
    (v1 * u1 + v2 * u2)
    (cong ℕ (λw. ℕ) (λw. w + u2 * v2) (u1 * v1) (v1 * u1) (multComm v1 u1))
    (cong ℕ (λw. ℕ) (λw. v1 * u1 + w) (u2 * v2) (v2 * u2) (multComm v2 u2))

def intMulComm : (x y : El Int) → intMul x y ≡ intMul y x
  using (integer.Int.unfold, integerMul.intMul.eq, plusAssoc) ≔
  λx. λy. quot-elim
    (a. quot-elim
      (b. classCong2
        (mulComm2 (a .π₁) (a .π₂) (b .π₁) (b .π₂))
        (trans
          ℕ
          (a .π₁ * b .π₂ + a .π₂ * b .π₁)
          (b .π₂ * a .π₁ + b .π₁ * a .π₂)
          (b .π₁ * a .π₂ + b .π₂ * a .π₁)
          (mulComm2 (a .π₁) (a .π₂) (b .π₂) (b .π₁))
          (plusComm (b .π₁ * a .π₂) (b .π₂ * a .π₁))))
      y)
    x

def intMulAssoc : (x y z : El Int) → intMul (intMul x y) z ≡ intMul x (intMul y z)
  using (assocRep, integer.Int.unfold, integerMul.intMul.eq) ≔
  λx. λy. λz. quot-elim
    (a. quot-elim
      (b. quot-elim
        (c. classCong2
          (assocRep (a .π₁) (a .π₂) (b .π₁) (b .π₂) (c .π₁) (c .π₂))
          (assocRep (a .π₁) (a .π₂) (b .π₁) (b .π₂) (c .π₂) (c .π₁)))
        z)
      y)
    x

def intMulDistribL : (x y z : El Int) → intMul x (intAdd y z) ≡ intAdd (intMul x y) (intMul x z)
  using (hyp.rw,
    intMul.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integerAdd.intAdd.eq,
    plusAssoc,
    plusAssoc.rw,
    sum4Distrib,
    sum4Distrib.rw) ≔
  λx. λy. λz. quot-elim (a. quot-elim (b. quot-elim (c. ⋆) z) y) x

-- congruence in both arguments, for building chains: reflection makes
-- the hypotheses judgemental, so each is one ⋆
def intAddCong2 : (x y u v : El Int) → (x ≡ u) → (y ≡ v) → intAdd x y ≡ intAdd u v
  using (hyp.rw, integer.Int.unfold) ≔
  λx. λy. λu. λv. λh1. λh2. ⋆

def intMulCong2 : (x y u v : El Int) → (x ≡ u) → (y ≡ v) → intMul x y ≡ intMul u v
  using (hyp.rw, integer.Int.unfold) ≔
  λx. λy. λu. λv. λh1. λh2. ⋆

-- distributivity on the right, from the left law by commuting thrice
def intMulDistribR : (x y z : El Int) → intMul (intAdd x y) z ≡ intAdd (intMul x z) (intMul y z) ≔
  λx. λy. λz. trans
    Int
    (intMul (intAdd x y) z)
    (intAdd (intMul z x) (intMul z y))
    (intAdd (intMul x z) (intMul y z))
    (trans
      Int
      (intMul (intAdd x y) z)
      (intMul z (intAdd x y))
      (intAdd (intMul z x) (intMul z y))
      (intMulComm (intAdd x y) z)
      (intMulDistribL z x y))
    (intAddCong2
      (intMul z x)
      (intMul z y)
      (intMul x z)
      (intMul y z)
      (intMulComm z x)
      (intMulComm z y))

-- ===== negation =====
def intNegNeg : (z : El Int) → intNeg (intNeg z) ≡ z
  using (classPairEta, integer.Int.unfold, integer.intNeg.eq) ≔
  λz. quot-elim (p. classPairEta p) z

-- z + (−z) = 0: on representatives the relation is p₁+p₂ ≡ p₂+p₁
def intAddNegR : (z : El Int) → intAdd z (intNeg z) ≡ intZero
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    integer.zeroEq,
    integerAdd.intAdd.eq,
    plusComm,
    plusZeroId,
    plusZeroId.rw) ≔
  λz. quot-elim (p. ⋆) z

def intAddNegL : (z : El Int) → intAdd (intNeg z) z ≡ intZero
  using (integer.Int.unfold,
    integer.intNeg.eq,
    integer.intZero.eq,
    integer.zeroEq,
    integerAdd.intAdd.eq,
    plusComm,
    plusZeroId,
    plusZeroId.rw) ≔
  λz. quot-elim (p. ⋆) z

-- (−x)·y = −(x·y): the two representatives differ by plusComm in each
-- component
def intMulNegL : (x y : El Int) → intMul (intNeg x) y ≡ intNeg (intMul x y)
  using (integer.Int.unfold, integer.intNeg.eq, integerMul.intMul.eq) ≔
  λx. λy. quot-elim
    (a. quot-elim
      (b. classCong2
        (plusComm (a .π₁ * b .π₂) (a .π₂ * b .π₁))
        (plusComm (a .π₁ * b .π₁) (a .π₂ * b .π₂)))
      y)
    x

def intMulNegR : (x y : El Int) → intMul x (intNeg y) ≡ intNeg (intMul x y) using (intMulNegL) ≔
  λx. λy. trans
    Int
    (intMul x (intNeg y))
    (intMul (intNeg y) x)
    (intNeg (intMul x y))
    (intMulComm x (intNeg y))
    (trans
      Int
      (intMul (intNeg y) x)
      (intNeg (intMul y x))
      (intNeg (intMul x y))
      (intMulNegL y x)
      (cong Int (λu. Int) intNeg (intMul y x) (intMul x y) (intMulComm y x)))
