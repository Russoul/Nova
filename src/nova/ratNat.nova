-- ℕ INSIDE ℚ, and the order bridge in BOTH directions. The reflecting
-- direction is the one that matters: it makes a natural-valued
-- function of a rational unique once its defining inequalities are
-- fixed, and that is what will let `qNatBound` descend to the quotient
-- without any case analysis on pairs of representatives.
--
-- Everything reduces to one observation: the difference of two
-- natural-valued rationals is the integer `class (b , a)`, whose sign
-- is nonnegative exactly when a ≤ b.

import nat (+, *, plusZeroId, zeroPlusId, sucPlus, plusComm, plusAssoc)
import natOrder (≤, leRefl, leOfEq, leZero, leSucMono)
import integer (Int, IntR, intZero, intOne, intNeg)
import integerAdd (+)
import integerMul (*, intMulOneR)
import intOrder (intOfNat, intOfNatPlus, intOfNatMul)
import intEffective (intEffective)
import rational (NZ, nzOne, nzMul, nzMulOneL, nzPos, nzToInt, Rat, mkRat, intScale, intScaleOne)
import rationalQ (Q, qcls, +, *, qNeg, qZero, qOne, clsEqOfRel, ratMul, qMulCls, qDistribR, qMulOneL)
import rationalOrder (Sign, sZero, sPos, sgnQ, intSgn, intSgnZero, NonNegS, ≤, intSgnZeroView, intSgnPosView)
import ratArch (intSgnOfNatNonNeg)
import equality (trans, sym, cong, transport)
import id (Id, idToEq, eqToId)

def qOfNat : ℕ → Q using (rationalQ.Q.unfold) ≔ λk. qcls (mkRat (intOfNat k) nzOne)

def qOfNatZero : qOfNat Z ≡ qZero
  using (intOrder.intOfNat.eq,
    integer.intZero.eq,
    ratNat.qOfNat.eq,
    rational.mkRat.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  ⋆

def qOfNatOne : qOfNat (S Z) ≡ qOne
  using (intOrder.intOfNat.eq,
    integer.intOne.eq,
    ratNat.qOfNat.eq,
    rational.mkRat.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.Q.unfold,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ===== the difference of two naturals, in ℤ =====
-- the flipped reading of the hypothesis, as its own lemma: the engine
-- cannot commute a FIRST argument, so state the exact relation shape
def natDiffRel : (a b k : ℕ) → (a + k ≡ b) → k + a ≡ b ≔
  λa. λb. λk. λh. trans _ _ _ (plusComm a k) h

def natDiffClass : {a b k : ℕ} → (a + k ≡ b) → intOfNat k ≡ class (b, a)
  using (intOrder.intOfNat.eq, integer.Int.unfold, natDiffRel, zeroPlusId.rw) ≔
  λa. λb. λk. λh. ⋆

-- effectivity of the ℤ quotient reads the two verdicts back as ℕ facts
def natEqOfClassZero : {a b : ℕ} → (class (b, a) ≡ intZero) → b ≡ a
  using (integer.Int.unfold, integer.IntR.eq, integer.intZero.eq, nat.plusZeroId) ≔
  λa. λb. λh. intEffective h

def natSucOfClassPos : {a b j : ℕ} → (class (S j, Z) ≡ class (b, a) ∈ Int) → a + S j ≡ b
  using (integer.Int.unfold, integer.IntR.eq) ≔
  λa. λb. λj. λh. trans _ _ _ (plusComm (S j) a) (trans _ _ _ (intEffective h) (zeroPlusId b))

def nonNegSgnOfLe : {a b : ℕ} → (a ≤ b) → NonNegS (intSgn (class (b, a)))
  using (integer.Int.unfold, natOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λle. transport
    NonNegS
    (cong (λv. Sign) (λv. intSgn v) (natDiffClass (idToEq _ _ _ (le .π₂))))
    intSgnOfNatNonNeg

def leOfNonNegSgn : {a b : ℕ} → NonNegS (intSgn (class (b, a))) → (a ≤ b)
  using (id.Id.unfold,
    integer.Int.unfold,
    natOrder.≤.unfold,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalOrder.NonNegS.unfold) ≔
  λa. λb. λnn. ⊎-elim
    (h0. leOfEq (sym _ _ (natEqOfClassZero (intSgnZeroView _ (idToEq _ _ _ h0)))))
    (hp. let v ≔ intSgnPosView
      _
      (idToEq _ _ _ hp) in S (v .π₁), eqToId _ _ (natSucOfClassPos (v .π₂)))
    nn

-- ===== the order bridge =====
-- the difference of the two embeddings, computed
def qOfNatDiffNum : {a b : ℕ}
  → intScale nzOne (intOfNat b) + intScale nzOne (intNeg (intOfNat a)) ≡ class (b, a)
  using (intOrder.intOfNat.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integerAdd.+.eq,
    plusComm,
    plusZeroId.rw,
    zeroPlusId.rw) ≔
  λa. λb. trans
    _
    _
    _
    (trans
      _
      _
      _
      (cong
        (λv. Int)
        (λv. v + intScale nzOne (intNeg (intOfNat a)))
        {intScale nzOne (intOfNat b)}
        {intOfNat b}
        intScaleOne)
      (cong
        (λv. Int)
        (λv. intOfNat b + v)
        {intScale nzOne (intNeg (intOfNat a))}
        {intNeg (intOfNat a)}
        intScaleOne))
    ⋆

def sgnQOfNatDiff : (a b : ℕ) → sgnQ (qOfNat b + qNeg (qOfNat a)) ≡ intSgn (class (b, a))
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    intOrder.intOfNat.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intNeg.eq,
    integer.intOne.eq,
    integer.intZero.eq,
    integerAdd.+.eq,
    integerMul.classPairEta.eq,
    integerMul.*.eq,
    integerNormalize.normPair.eq,
    nat.*.eq,
    nat.+.eq,
    ratNat.qOfNat.eq,
    rational.den.eq,
    rational.denInt.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    rationalQ.qcls.eq) ≔
  λa. λb. trans
    _
    _
    _
    (cong
      (λv. Sign)
      (λv. intSgn (v * intOne))
      {intScale nzOne (intOfNat b) + intScale nzOne (intNeg (intOfNat a))}
      {class (b, a)}
      qOfNatDiffNum)
    (cong (λv. Sign) (λv. intSgn v) (intMulOneR (class (b, a))))

def leQOfNat : {a b : ℕ} → (a ≤ b) → (qOfNat a ≤ qOfNat b)
  using (id.Id.unfold,
    integer.Int.unfold,
    natOrder.≤.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold) ≔
  λa. λb. λle. transport NonNegS (sym _ _ (sgnQOfNatDiff a b)) (nonNegSgnOfLe le)

def leNOfQ : {a b : ℕ} → (qOfNat a ≤ qOfNat b) → (a ≤ b)
  using (integer.Int.unfold,
    natOrder.≤.unfold,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold) ≔
  λa. λb. λh. leOfNonNegSgn (transport NonNegS (sgnQOfNatDiff a b) h)

-- the embedding is additive
def qOfNatAdd : (a b : ℕ) → qOfNat a + qOfNat b ≡ qOfNat (a + b)
  using (intOrder.intOfNat.eq,
    integer.intNeg.eq,
    integerAdd.+.eq,
    nat.*.eq,
    nat.+.eq,
    ratNat.qOfNat.eq,
    rational.den.eq,
    rational.intScale.eq,
    rational.intScaleN.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.ratAdd.eq,
    rationalQ.+.eq,
    rationalQ.qcls.eq) ≔
  λa. λb. trans
    _
    _
    _
    (trans
      (qOfNat a + qOfNat b)
      _
      _
      (cong
        (λv. Q)
        (λv. qcls (mkRat (v + intScale nzOne (intOfNat b)) nzOne))
        {intScale nzOne (intOfNat a)}
        {intOfNat a}
        intScaleOne)
      (cong
        (λv. Q)
        (λv. qcls (mkRat (intOfNat a + v) nzOne))
        {intScale nzOne (intOfNat b)}
        {intOfNat b}
        intScaleOne))
    (cong (λv. Q) (λv. qcls (mkRat v nzOne)) (intOfNatPlus a b))

-- ...and the same for the product. Both denominators are 1, so ratMul
-- is just intMul on the numerators once nzMul nzOne nzOne collapses.
def ratMulUnit : (x y : Int)
  → ratMul (mkRat x nzOne) (mkRat y nzOne) ≡ mkRat (x * y) (nzMul nzOne nzOne)
  using (rationalQ.ratMul.eq, rational.mkRat.eq, rational.num.eq, rational.den.eq) ≔
  λx. λy. ⋆

def qOfNatMul : (a b : ℕ) → qOfNat a * qOfNat b ≡ qOfNat (a * b) using (ratNat.qOfNat.eq) ≔
  λa. λb. qOfNat a * qOfNat b
      ≡⟨ qMulCls
        (mkRat (intOfNat a) nzOne)
        (mkRat
          (intOfNat b)
          nzOne) ⟩ qcls (ratMul (mkRat (intOfNat a) nzOne) (mkRat (intOfNat b) nzOne))
      ≡⟨ cong
        (λv. Q)
        (λv. qcls v)
        (ratMulUnit
          (intOfNat a)
          (intOfNat b)) ⟩ qcls (mkRat (intOfNat a * intOfNat b) (nzMul nzOne nzOne))
      ≡⟨ cong
        (λv. Q)
        (λv. qcls (mkRat v (nzMul nzOne nzOne)))
        (intOfNatMul a b) ⟩ qcls (mkRat (intOfNat (a * b)) (nzMul nzOne nzOne))
      ≡⟨ cong
        (λv. Q)
        (λv. qcls (mkRat (intOfNat (a * b)) v))
        {nzMul nzOne nzOne}
        {nzOne}
        nzMulOneL ⟩ qcls (mkRat (intOfNat (a * b)) nzOne)

-- S c as a rational is c + 1. Written c + S Z, not S Z + c: `+`
-- recurses on its SECOND argument, so c + S Z reduces to S c on the
-- nose and the other order would owe zeroPlusId.
def addOneNat : (c : ℕ) → c + S Z ≡ S c using (nat.+.eq) ≔ λc. ⋆

def qOfNatSuc : (c : ℕ) → qOfNat (S c) ≡ qOfNat c + qOne ≔
  λc. qOfNat (S c)
      ≡⟨ cong (λw. Q) (λw. qOfNat w) (sym _ _ (addOneNat c)) ⟩ qOfNat (c + S Z)
      ≡⟨ sym _ _ (qOfNatAdd c (S Z)) ⟩ qOfNat c + qOfNat (S Z)
      ≡⟨ cong (λw. Q) (λw. qOfNat c + w) qOfNatOne ⟩ qOfNat c + qOne

def qMulSucNat : (c : ℕ) (x : Q) → qOfNat (S c) * x ≡ qOfNat c * x + x ≔
  λc. λx. qOfNat (S c) * x
      ≡⟨ cong (λw. Q) (λw. w * x) (qOfNatSuc c) ⟩ (qOfNat c + qOne) * x
      ≡⟨ qDistribR x (qOfNat c) qOne ⟩ qOfNat c * x + qOne * x
      ≡⟨ cong (λw. Q) (λw. qOfNat c * x + w) (qMulOneL x) ⟩ qOfNat c * x + x
