-- MULTIPLICATION on ℝ. Like addition it samples deeper than the index
-- asked for, but where addition's factor is the constant 2, the
-- product's is a BOUND on the two factors:
--
--   (x ⊗ y)_m ≔ x_{φ m} · y_{φ m},   φ m + 1 = C·(m + 1),  C = A + B
--
-- with A, B the naturals realBound.nova computes for the two regular
-- sequences. The estimate is the classical one,
--
--   |x_a y_a − x_b y_b| ≤ |x_a|·|y_a − y_b| + |y_b|·|x_a − x_b|
--                       ≤ (A + B)·rBound a b
--
-- and C·rBound (φ m) (φ n) is rBound m n on the nose — the sampling
-- depth is chosen to make that an equality, exactly as qInvHalf makes
-- addition's an equality.
-- ===== the sampling index =====
-- φ with S (φ c m) = (c+1)·(m+1)

import nat (+, *, plusZeroId, zeroPlusId, sucPlus, plusSucId, plusComm, sucMult, multComm)
import integer (Int, intOne)
import integerMul (intMul, intMulOneL, intMulOneR)
import intOrder (intOfNat, intOfNatMul)
import rational (NZ, nzOne, nzPos, nzToInt, nzMul, nzMulOneL, Rat, mkRat)
import rationalQ (Q, qcls, qAdd, qMul, qNeg, qZero, qOne, qAddComm, qAddAssoc, qMulComm, qMulCls, qDistribL, qDistribR, clsEqOfRel, RatR, ratMul)
import rationalOrder (LeQ, leQRefl, qPairSwap, qSubSplit)
import ratBound (Bnd, bndAdd, bndEq, bndEqB, bndWeaken, bndVia)
import ratAbs (bndMul, qNegMulR)
import ratNat (qOfNat, qOfNatAdd, leQOfNat)
import ratCeil (qNatBound)
import ratArch (bndOfArch)
import real (qInvNat, rBound, leQZeroBound, Regular, RSeq, REq, Real, constReg, realOfQ)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, realEqOfREq)
import realSeq (rseqEq, wdOuterOfComm, realEqOfSeqEq)
import realBound (seqBound, bndSeqBound, seqBoundPos)
import equality (trans, sym, cong, transport, transportP)

def mulIdx : ℕ → ℕ → ℕ ≔ λc. λm. m + c * S m

def sucMulIdx : (c m : ℕ) → S (mulIdx c m) ≡ S c * S m ∈ ℕ
  using (nat.*.eq, nat.+.eq, realMul.mulIdx.eq) ≔
  λc. λm. trans
    ℕ
    (S (m + c * S m))
    (S m + c * S m)
    (S c * S m)
    (sym ℕ (S m + c * S m) (S (m + c * S m)) (sucPlus m (c * S m)))
    (sym ℕ (S c * S m) (S m + c * S m) (sucMult c (S m)))

-- (c+1) · 1/((c+1)(m+1)) = 1/(m+1) : cross-multiplication is the
-- successor identity above. Split into the two sides, because a
-- single nested term at this depth is unreadable and easy to
-- mis-parenthesise.
def qMulIdxNum : {c m : ℕ}
  → intMul (intMul (intOfNat (S c)) intOne) (nzToInt (nzPos m)) ≡ intOfNat (S c * S m) ∈ El Int
  using (ratHalf.nzPosInt) ≔
  λc. λm. trans
    Int
    (intMul (intMul (intOfNat (S c)) intOne) (nzToInt (nzPos m)))
    (intMul (intOfNat (S c)) (intOfNat (S m)))
    (intOfNat (S c * S m))
    (cong
      Int
      (λv. Int)
      (λv. intMul v (nzToInt (nzPos m)))
      (intMul (intOfNat (S c)) intOne)
      (intOfNat (S c))
      (intMulOneR (intOfNat (S c))))
    (intOfNatMul (S c) (S m))

def qMulIdxDen : (c m : ℕ)
  → intMul intOne (nzToInt (nzMul nzOne (nzPos (mulIdx c m)))) ≡ intOfNat (S c * S m) ∈ El Int
  using (ratHalf.nzPosInt) ≔
  λc. λm. trans
    Int
    (intMul intOne (nzToInt (nzMul nzOne (nzPos (mulIdx c m)))))
    (intOfNat (S (mulIdx c m)))
    (intOfNat (S c * S m))
    (trans
      Int
      (intMul intOne (nzToInt (nzMul nzOne (nzPos (mulIdx c m)))))
      (nzToInt (nzMul nzOne (nzPos (mulIdx c m))))
      (intOfNat (S (mulIdx c m)))
      (intMulOneL (nzToInt (nzMul nzOne (nzPos (mulIdx c m)))))
      (cong
        NZ
        (λv. Int)
        (λv. nzToInt v)
        (nzMul nzOne (nzPos (mulIdx c m)))
        (nzPos (mulIdx c m))
        nzMulOneL))
    (cong ℕ (λu. Int) (λw. intOfNat w) (S (mulIdx c m)) (S c * S m) (sucMulIdx c m))

def qMulIdxRel : (c m : ℕ)
  → Prf (RatR
    (ratMul (mkRat (intOfNat (S c)) nzOne) (mkRat intOne (nzPos (mulIdx c m))))
    (mkRat intOne (nzPos m)))
  using (intOrder.intOfNat.eq,
    integer.Int.eq,
    integer.intOne.eq,
    integerMul.intMul.eq,
    nat.*.eq,
    nat.+.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzNeg.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq,
    realMul.mulIdx.eq) ≔
  λc. λm. trans
    Int
    (intMul (intMul (intOfNat (S c)) intOne) (nzToInt (nzPos m)))
    (intOfNat (S c * S m))
    (intMul intOne (nzToInt (nzMul nzOne (nzPos (mulIdx c m)))))
    qMulIdxNum
    (sym
      Int
      (intMul intOne (nzToInt (nzMul nzOne (nzPos (mulIdx c m)))))
      (intOfNat (S c * S m))
      (qMulIdxDen c m))

def qMulInvIdx : {c m : ℕ} → qMul (qOfNat (S c)) (qInvNat (mulIdx c m)) ≡ qInvNat m ∈ El Q
  using (intOrder.intOfNat.eq,
    integer.intOne.eq,
    ratNat.qOfNat.eq,
    rational.mkRat.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rationalQ.qMul.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq,
    real.qInvNat.eq,
    realMul.mulIdx.eq) ≔
  λc. λm. trans
    Q
    (qMul (qOfNat (S c)) (qInvNat (mulIdx c m)))
    (qcls (ratMul (mkRat (intOfNat (S c)) nzOne) (mkRat intOne (nzPos (mulIdx c m)))))
    (qInvNat m)
    (qMulCls (mkRat (intOfNat (S c)) nzOne) (mkRat intOne (nzPos (mulIdx c m))))
    (clsEqOfRel
      (ratMul (mkRat (intOfNat (S c)) nzOne) (mkRat intOne (nzPos (mulIdx c m))))
      (mkRat intOne (nzPos m))
      (qMulIdxRel c m))

-- the same, with the factor given as a natural and its successor
-- shape as an explicit equation. Without this the elaborator has to
-- CONVERT `qOfNat (S (mulPred p q))` to `qOfNat (seqBound p + seqBound q)`
-- at every use, and those terms unfold through divN's fuel recursion:
-- the item stops finishing. As an argument the equation is proved once,
-- generically, where every symbol is a variable.
def qMulInvIdxC : {C c m : ℕ}
  → (C ≡ S c ∈ ℕ) → qMul (qOfNat C) (qInvNat (mulIdx c m)) ≡ qInvNat m ∈ El Q ≔
  λC. λc. λm. λh. transportP
    ℕ
    (λw. qMul (qOfNat w) (qInvNat (mulIdx c m)) ≡ qInvNat m ∈ El Q)
    (S c)
    C
    (sym ℕ C (S c) h)
    qMulInvIdx

-- ...so the factor turns the deep bound into the shallow one exactly
def qMulRBoundIdx : (c m n : ℕ)
  → qMul (qOfNat (S c)) (rBound (mulIdx c m) (mulIdx c n)) ≡ rBound m n ∈ El Q
  using (rationalQ.qAdd.eq, real.qInvNat.eq, real.rBound.eq, realMul.mulIdx.eq) ≔
  λc. λm. λn. trans
    Q
    (qMul (qOfNat (S c)) (rBound (mulIdx c m) (mulIdx c n)))
    (qAdd (qMul (qOfNat (S c)) (qInvNat (mulIdx c m))) (qMul (qOfNat (S c)) (qInvNat (mulIdx c n))))
    (rBound m n)
    (qDistribL (qOfNat (S c)) (qInvNat (mulIdx c m)) (qInvNat (mulIdx c n)))
    (trans
      Q
      (qAdd
        (qMul (qOfNat (S c)) (qInvNat (mulIdx c m)))
        (qMul (qOfNat (S c)) (qInvNat (mulIdx c n))))
      (qAdd (qInvNat m) (qMul (qOfNat (S c)) (qInvNat (mulIdx c n))))
      (rBound m n)
      (cong
        Q
        (λw. Q)
        (λw. qAdd w (qMul (qOfNat (S c)) (qInvNat (mulIdx c n))))
        (qMul (qOfNat (S c)) (qInvNat (mulIdx c m)))
        (qInvNat m)
        qMulInvIdx)
      (cong
        Q
        (λw. Q)
        (λw. qAdd (qInvNat m) w)
        (qMul (qOfNat (S c)) (qInvNat (mulIdx c n)))
        (qInvNat n)
        qMulInvIdx))

-- ===== the product-difference identity =====
def qMulSubL : (x y y' : El Q)
  → qMul x (qAdd y (qNeg y')) ≡ qAdd (qMul x y) (qNeg (qMul x y')) ∈ El Q ≔
  λx. λy. λy'. trans
    Q
    (qMul x (qAdd y (qNeg y')))
    (qAdd (qMul x y) (qMul x (qNeg y')))
    (qAdd (qMul x y) (qNeg (qMul x y')))
    (qDistribL x y (qNeg y'))
    (cong Q (λw. Q) (λw. qAdd (qMul x y) w) (qMul x (qNeg y')) (qNeg (qMul x y')) (qNegMulR x y'))

def qMulSubR : {y' x x' : El Q}
  → qMul y' (qAdd x (qNeg x')) ≡ qAdd (qMul x y') (qNeg (qMul x' y')) ∈ El Q ≔
  λy'. λx. λx'. trans
    Q
    (qMul y' (qAdd x (qNeg x')))
    (qAdd (qMul y' x) (qMul y' (qNeg x')))
    (qAdd (qMul x y') (qNeg (qMul x' y')))
    (qDistribL y' x (qNeg x'))
    (trans
      Q
      (qAdd (qMul y' x) (qMul y' (qNeg x')))
      (qAdd (qMul x y') (qMul y' (qNeg x')))
      (qAdd (qMul x y') (qNeg (qMul x' y')))
      (cong Q (λw. Q) (λw. qAdd w (qMul y' (qNeg x'))) (qMul y' x) (qMul x y') (qMulComm y' x))
      (cong
        Q
        (λw. Q)
        (λw. qAdd (qMul x y') w)
        (qMul y' (qNeg x'))
        (qNeg (qMul x' y'))
        (trans
          Q
          (qMul y' (qNeg x'))
          (qNeg (qMul y' x'))
          (qNeg (qMul x' y'))
          (qNegMulR y' x')
          (cong Q (λw. Q) (λw. qNeg w) (qMul y' x') (qMul x' y') (qMulComm y' x')))))

-- x·y − x′·y′ ≡ x·(y − y′) + y′·(x − x′)
def qMulDiff : (x y x' y' : El Q)
  → qAdd
    (qMul x (qAdd y (qNeg y')))
    (qMul y' (qAdd x (qNeg x'))) ≡ qAdd (qMul x y) (qNeg (qMul x' y')) ∈ El Q ≔
  λx. λy. λx'. λy'. trans
    Q
    (qAdd (qMul x (qAdd y (qNeg y'))) (qMul y' (qAdd x (qNeg x'))))
    (qAdd (qAdd (qMul x y) (qNeg (qMul x y'))) (qAdd (qMul x y') (qNeg (qMul x' y'))))
    (qAdd (qMul x y) (qNeg (qMul x' y')))
    (trans
      Q
      (qAdd (qMul x (qAdd y (qNeg y'))) (qMul y' (qAdd x (qNeg x'))))
      (qAdd (qAdd (qMul x y) (qNeg (qMul x y'))) (qMul y' (qAdd x (qNeg x'))))
      (qAdd (qAdd (qMul x y) (qNeg (qMul x y'))) (qAdd (qMul x y') (qNeg (qMul x' y'))))
      (cong
        Q
        (λw. Q)
        (λw. qAdd w (qMul y' (qAdd x (qNeg x'))))
        (qMul x (qAdd y (qNeg y')))
        (qAdd (qMul x y) (qNeg (qMul x y')))
        (qMulSubL x y y'))
      (cong
        Q
        (λw. Q)
        (λw. qAdd (qAdd (qMul x y) (qNeg (qMul x y'))) w)
        (qMul y' (qAdd x (qNeg x')))
        (qAdd (qMul x y') (qNeg (qMul x' y')))
        qMulSubR))
    (qSubSplit (qMul x' y') (qMul x y') (qMul x y))

-- ===== the factor and the sequence =====
-- C − 1, written so that S (mulPred p q) IS seqBound p + seqBound q
def mulPred : El RSeq → El RSeq → ℕ ≔ λp. λq. seqBound p + S (qNatBound (seqOf q Z))

def mulSeq : El RSeq → El RSeq → El (ℕ → Q) ≔
  λp. λq. λm. qMul (seqOf p (mulIdx (mulPred p q) m)) (seqOf q (mulIdx (mulPred p q) m))

def qMulSumBound : (A B : ℕ)
  (r : El Q)
  → qAdd (qMul (qOfNat A) r) (qMul (qOfNat B) r) ≡ qMul (qOfNat (A + B)) r ∈ El Q ≔
  λA. λB. λr. sym
    Q
    (qMul (qOfNat (A + B)) r)
    (qAdd (qMul (qOfNat A) r) (qMul (qOfNat B) r))
    (trans
      Q
      (qMul (qOfNat (A + B)) r)
      (qMul (qAdd (qOfNat A) (qOfNat B)) r)
      (qAdd (qMul (qOfNat A) r) (qMul (qOfNat B) r))
      (cong
        Q
        (λw. Q)
        (λw. qMul w r)
        (qOfNat (A + B))
        (qAdd (qOfNat A) (qOfNat B))
        (sym Q (qAdd (qOfNat A) (qOfNat B)) (qOfNat (A + B)) (qOfNatAdd A B)))
      (qDistribR r (qOfNat A) (qOfNat B)))

-- PRODUCTS OF CLOSE, BOUNDED RATIONALS ARE CLOSE. Everything the ring
-- laws need about multiplication factors through this one estimate:
-- if |x| ≤ A, |y'| ≤ B, and both |y − y'| and |x − x'| are under d,
-- then |xy − x'y'| is under (A + B)·d. The modulus d is arbitrary —
-- it is rBound a b for regularity, but the ring laws need it to be a
-- multiple of rBound m m instead.
-- ...with the two differences allowed DIFFERENT moduli and the two
-- bounds arbitrary rationals. Associativity needs both: the bound on
-- the left factor is a product of two ceilings, and the left
-- difference is itself a product-difference, so it carries a bigger
-- modulus than the right one.
def bndMulSubQ : {x y x' y' a b d e : El Q}
  → El (Bnd
    a
    x)
    → El (Bnd
      b
      y')
      → El (Bnd
        d
        (qAdd
          y
          (qNeg
            y')))
        → El (Bnd
          e
          (qAdd
            x
            (qNeg
              x')))
          → El (LeQ
            qZero
            a)
            → El (LeQ
              qZero
              b)
              → El (LeQ
                qZero
                d)
                → El (LeQ
                  qZero
                  e) → El (Bnd (qAdd (qMul a d) (qMul b e)) (qAdd (qMul x y) (qNeg (qMul x' y')))) ≔
  λx. λy. λx'. λy'. λa. λb. λd. λe. λhx. λhy'. λhd. λhe. λha. λhb. λhd0. λhe0. bndEq
    (qAdd (qMul x (qAdd y (qNeg y'))) (qMul y' (qAdd x (qNeg x'))))
    (qAdd (qMul x y) (qNeg (qMul x' y')))
    (qMulDiff x y x' y')
    (bndAdd (bndMul ha hd0 hx hd) (bndMul hb he0 hy' he))

def bndMulSub : {x y x' y' : El Q}
  {A B : ℕ}
  {d : El Q}
  → El (Bnd
    (qOfNat A)
    x)
    → El (Bnd
      (qOfNat B)
      y')
      → El (Bnd
        d
        (qAdd
          y
          (qNeg
            y')))
        → El (Bnd
          d
          (qAdd
            x
            (qNeg
              x')))
          → El (LeQ
            qZero
            (qOfNat
              A))
            → El (LeQ
              qZero
              (qOfNat
                B))
              → El (LeQ
                qZero
                d) → El (Bnd (qMul (qOfNat (A + B)) d) (qAdd (qMul x y) (qNeg (qMul x' y')))) ≔
  λx. λy. λx'. λy'. λA. λB. λd. λhx. λhy'. λhg. λhf. λhA. λhB. λhd. bndEqB
    (qAdd (qMul (qOfNat A) d) (qMul (qOfNat B) d))
    (qMul (qOfNat (A + B)) d)
    (qAdd (qMul x y) (qNeg (qMul x' y')))
    (qMulSumBound A B d)
    (bndMulSubQ hx hy' hg hf hA hB hd hd)

-- the estimate, at two arbitrary indices and with EVERYTHING abstract:
-- |x_a y_a − x_b y_b| ≤ (A + B)·rBound a b. Abstract because `seqBound`
-- unfolds through divN's fuel recursion, and an item that mentions it
-- twenty times does not finish elaborating (D-3, for speed).
def bndMulDiffGen : (f g : El (ℕ → Q))
  (A B a b : ℕ)
  → El (Bnd
    (qOfNat A)
    (f
      a))
    → El (Bnd
      (qOfNat B)
      (g
        b))
      → El (Bnd
        (rBound a b)
        (qAdd
          (g a)
          (qNeg
            (g
              b))))
        → El (Bnd
          (rBound a b)
          (qAdd
            (f a)
            (qNeg
              (f
                b))))
          → El (LeQ
            qZero
            (qOfNat
              A))
            → El (LeQ
              qZero
              (qOfNat
                B))
              → El (Bnd
                (qMul (qOfNat (A + B)) (rBound a b))
                (qAdd (qMul (f a) (g a)) (qNeg (qMul (f b) (g b))))) ≔
  λf. λg. λA. λB. λa. λb. λhfa. λhgb. λhg. λhf. λhA. λhB. bndMulSub
    hfa
    hgb
    hg
    hf
    hA
    hB
    (leQZeroBound a b)

def bndMulDiff : (p q : El RSeq)
  (a b : ℕ)
  → El (Bnd
    (qMul (qOfNat (seqBound p + seqBound q)) (rBound a b))
    (qAdd (qMul (seqOf p a) (seqOf q a)) (qNeg (qMul (seqOf p b) (seqOf q b))))) ≔
  λp. λq. λa. λb. bndMulDiffGen
    (seqOf p)
    (seqOf q)
    (seqBound p)
    (seqBound q)
    a
    b
    (bndSeqBound p a)
    (bndSeqBound q b)
    (regBnd (seqOf q) (regOf q) a b)
    (regBnd (seqOf p) (regOf p) a b)
    seqBoundPos
    seqBoundPos

-- ...and at the product's own sampling indices the factor cancels
def mulReg : {p q : El RSeq} → El (Regular (mulSeq p q))
  using (nat.+.eq,
    ratNat.qOfNat.eq,
    rationalQ.qAdd.eq,
    rationalQ.qMul.eq,
    rationalQ.qNeg.eq,
    real.rBound.eq,
    realBound.seqBound.eq,
    realMul.mulIdx.eq,
    realMul.mulPred.eq,
    realMul.mulSeq.eq,
    realNeg.seqOf.eq) ≔
  λp. λq. bndReg
    (λm. λn. bndEqB
      (qMul
        (qOfNat (seqBound p + seqBound q))
        (rBound (mulIdx (mulPred p q) m) (mulIdx (mulPred p q) n)))
      (rBound m n)
      (qAdd
        (qMul (seqOf p (mulIdx (mulPred p q) m)) (seqOf q (mulIdx (mulPred p q) m)))
        (qNeg (qMul (seqOf p (mulIdx (mulPred p q) n)) (seqOf q (mulIdx (mulPred p q) n)))))
      (qMulRBoundIdx (mulPred p q) m n)
      (bndMulDiff p q (mulIdx (mulPred p q) m) (mulIdx (mulPred p q) n)))

def rMul : El RSeq → El RSeq → El RSeq using (real.RSeq.unfold) ≔ λp. λq. mulSeq p q, mulReg

-- ===== well-definedness =====
--
-- Two representatives of the same real get DIFFERENT sampling depths
-- (the bound is computed from the representative), so the two products
-- cannot be compared index by index. The comparison runs through a
-- third, deeper index j and the slack — everything proportional to
-- 1/(j+1) — is driven below every 1/(k+1) by ratArch's leQOfArch,
-- exactly as REq's transitivity was.
-- (a + p) + (r + (s + a)) ≡ (a + a) + (p + (r + s))
def qRearr5 : (a p r s : El Q)
  → qAdd (qAdd a p) (qAdd r (qAdd s a)) ≡ qAdd (qAdd a a) (qAdd p (qAdd r s)) ∈ El Q ≔
  λa. λp. λr. λs. qAdd (qAdd a p) (qAdd r (qAdd s a))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qAdd (qAdd a p) w)
        (qAdd r (qAdd s a))
        (qAdd (qAdd r s) a)
        (sym
          Q
          (qAdd (qAdd r s) a)
          (qAdd r (qAdd s a))
          (qAddAssoc r s a)) ⟩ qAdd (qAdd a p) (qAdd (qAdd r s) a)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qAdd (qAdd a p) w)
        (qAdd (qAdd r s) a)
        (qAdd a (qAdd r s))
        (qAddComm (qAdd r s) a) ⟩ qAdd (qAdd a p) (qAdd a (qAdd r s))
      ≡⟨ qPairSwap a p a (qAdd r s) ⟩ qAdd (qAdd a a) (qAdd p (qAdd r s))

-- C·t + ((A·t + A·t) + C″·t) ≡ (C + ((A + A) + C″))·t
def qTailSum : {C A D : ℕ}
  {t : El Q}
  → qAdd
    (qMul (qOfNat C) t)
    (qAdd
      (qAdd (qMul (qOfNat A) t) (qMul (qOfNat A) t))
      (qMul (qOfNat D) t)) ≡ qMul (qOfNat (C + (A + A + D))) t ∈ El Q ≔
  λC. λA. λD. λt. trans
    Q
    (qAdd
      (qMul (qOfNat C) t)
      (qAdd (qAdd (qMul (qOfNat A) t) (qMul (qOfNat A) t)) (qMul (qOfNat D) t)))
    (qAdd (qMul (qOfNat C) t) (qMul (qOfNat (A + A + D)) t))
    (qMul (qOfNat (C + (A + A + D))) t)
    (cong
      Q
      (λw. Q)
      (λw. qAdd (qMul (qOfNat C) t) w)
      (qAdd (qAdd (qMul (qOfNat A) t) (qMul (qOfNat A) t)) (qMul (qOfNat D) t))
      (qMul (qOfNat (A + A + D)) t)
      (trans
        Q
        (qAdd (qAdd (qMul (qOfNat A) t) (qMul (qOfNat A) t)) (qMul (qOfNat D) t))
        (qAdd (qMul (qOfNat (A + A)) t) (qMul (qOfNat D) t))
        (qMul (qOfNat (A + A + D)) t)
        (cong
          Q
          (λw. Q)
          (λw. qAdd w (qMul (qOfNat D) t))
          (qAdd (qMul (qOfNat A) t) (qMul (qOfNat A) t))
          (qMul (qOfNat (A + A)) t)
          (qMulSumBound A A t))
        (qMulSumBound (A + A) D t)))
    (qMulSumBound C (A + A + D) t)

-- the bound arithmetic of the three-leg comparison, stated abstractly:
-- two of the three factors collapse against the shallow index, and the
-- rest is one multiple of the deep unit fraction
def wdBoundEq : {C A E n a b t k : ℕ}
  → (qMul
    (qOfNat C)
    (qInvNat
      a) ≡ qInvNat
    n ∈ El Q)
    → (qMul
      (qOfNat E)
      (qInvNat
        b) ≡ qInvNat
      n ∈ El Q)
      → (qMul
        (qOfNat (C + (A + A + E)))
        (qInvNat
          t) ≡ qInvNat
        k ∈ El Q)
        → qAdd
          (qMul (qOfNat C) (rBound a t))
          (qAdd
            (qMul (qOfNat A) (rBound t t))
            (qMul (qOfNat E) (rBound t b))) ≡ qAdd (rBound n n) (qInvNat k) ∈ El Q
  using (ratNat.qOfNat.eq, rationalQ.qAdd.eq, rationalQ.qMul.eq, real.qInvNat.eq, real.rBound.eq) ≔
  λC. λA. λE. λn. λa. λb. λt. λk. λh1. λh2. λh3. trans
    Q
    (qAdd
      (qMul (qOfNat C) (rBound a t))
      (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat E) (rBound t b))))
    (qAdd
      (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
      (qAdd
        (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
        (qAdd (qMul (qOfNat E) (qInvNat t)) (qInvNat n))))
    (qAdd (rBound n n) (qInvNat k))
    (trans
      Q
      (qAdd
        (qMul (qOfNat C) (rBound a t))
        (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat E) (rBound t b))))
      (qAdd
        (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
        (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat E) (rBound t b))))
      (qAdd
        (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
        (qAdd
          (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
          (qAdd (qMul (qOfNat E) (qInvNat t)) (qInvNat n))))
      (cong
        Q
        (λw. Q)
        (λw. qAdd w (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat E) (rBound t b))))
        (qMul (qOfNat C) (rBound a t))
        (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
        (trans
          Q
          (qMul (qOfNat C) (rBound a t))
          (qAdd (qMul (qOfNat C) (qInvNat a)) (qMul (qOfNat C) (qInvNat t)))
          (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
          (qDistribL (qOfNat C) (qInvNat a) (qInvNat t))
          (cong
            Q
            (λw. Q)
            (λw. qAdd w (qMul (qOfNat C) (qInvNat t)))
            (qMul (qOfNat C) (qInvNat a))
            (qInvNat n)
            h1)))
      (trans
        Q
        (qAdd
          (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
          (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat E) (rBound t b))))
        (qAdd
          (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
          (qAdd
            (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
            (qMul (qOfNat E) (rBound t b))))
        (qAdd
          (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
          (qAdd
            (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
            (qAdd (qMul (qOfNat E) (qInvNat t)) (qInvNat n))))
        (cong
          Q
          (λw. Q)
          (λw. qAdd
            (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
            (qAdd w (qMul (qOfNat E) (rBound t b))))
          (qMul (qOfNat A) (rBound t t))
          (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
          (qDistribL (qOfNat A) (qInvNat t) (qInvNat t)))
        (cong
          Q
          (λw. Q)
          (λw. qAdd
            (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
            (qAdd (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t))) w))
          (qMul (qOfNat E) (rBound t b))
          (qAdd (qMul (qOfNat E) (qInvNat t)) (qInvNat n))
          (trans
            Q
            (qMul (qOfNat E) (rBound t b))
            (qAdd (qMul (qOfNat E) (qInvNat t)) (qMul (qOfNat E) (qInvNat b)))
            (qAdd (qMul (qOfNat E) (qInvNat t)) (qInvNat n))
            (qDistribL (qOfNat E) (qInvNat t) (qInvNat b))
            (cong
              Q
              (λw. Q)
              (λw. qAdd (qMul (qOfNat E) (qInvNat t)) w)
              (qMul (qOfNat E) (qInvNat b))
              (qInvNat n)
              h2)))))
    (trans
      Q
      (qAdd
        (qAdd (qInvNat n) (qMul (qOfNat C) (qInvNat t)))
        (qAdd
          (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
          (qAdd (qMul (qOfNat E) (qInvNat t)) (qInvNat n))))
      (qAdd
        (qAdd (qInvNat n) (qInvNat n))
        (qAdd
          (qMul (qOfNat C) (qInvNat t))
          (qAdd
            (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
            (qMul (qOfNat E) (qInvNat t)))))
      (qAdd (rBound n n) (qInvNat k))
      (qRearr5
        (qInvNat n)
        (qMul (qOfNat C) (qInvNat t))
        (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
        (qMul (qOfNat E) (qInvNat t)))
      (cong
        Q
        (λw. Q)
        (λw. qAdd (rBound n n) w)
        (qAdd
          (qMul (qOfNat C) (qInvNat t))
          (qAdd
            (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
            (qMul (qOfNat E) (qInvNat t))))
        (qInvNat k)
        (trans
          Q
          (qAdd
            (qMul (qOfNat C) (qInvNat t))
            (qAdd
              (qAdd (qMul (qOfNat A) (qInvNat t)) (qMul (qOfNat A) (qInvNat t)))
              (qMul (qOfNat E) (qInvNat t))))
          (qMul (qOfNat (C + (A + A + E))) (qInvNat t))
          (qInvNat k)
          qTailSum
          h3)))

-- the deep index: its factor is everything the three legs spend
def wdIdx : El RSeq → El RSeq → El RSeq → ℕ ≔
  λp. λq. λq'. seqBound p + seqBound q + (seqBound p + seqBound p + mulPred p q')

-- The three-leg comparison, abstract in the sequences, their bounds
-- and every index. Two representatives of the same real get different
-- sampling depths, so the two products are compared through a third,
-- deeper index t, and everything proportional to 1/(t+1) is the slack.
def rMulWDGen : (f g g' : El (ℕ → Q))
  (A B B' : ℕ)
  (hfB : (j : ℕ) → El (Bnd (qOfNat A) (f j)))
  (hgB : (j : ℕ) → El (Bnd (qOfNat B) (g j)))
  (hg'B : (j : ℕ) → El (Bnd (qOfNat B') (g' j)))
  (hfR : (i j : ℕ) → El (Bnd (rBound i j) (qAdd (f i) (qNeg (f j)))))
  (hgR : (i j : ℕ) → El (Bnd (rBound i j) (qAdd (g i) (qNeg (g j)))))
  (hg'R : (i j : ℕ) → El (Bnd (rBound i j) (qAdd (g' i) (qNeg (g' j)))))
  (hq : (j : ℕ) → El (Bnd (rBound j j) (qAdd (g j) (qNeg (g' j)))))
  (hA : El (LeQ qZero (qOfNat A)))
  (hB : El (LeQ qZero (qOfNat B)))
  (hB' : El (LeQ qZero (qOfNat B')))
  (n k a b t : ℕ)
  → (qMul
    (qOfNat (A + B))
    (qInvNat
      a) ≡ qInvNat
    n ∈ El Q)
    → (qMul
      (qOfNat (A + B'))
      (qInvNat
        b) ≡ qInvNat
      n ∈ El Q)
      → (qMul
        (qOfNat (A + B + (A + A + (A + B'))))
        (qInvNat
          t) ≡ qInvNat
        k ∈ El Q)
        → El (Bnd
          (qAdd (rBound n n) (qInvNat k))
          (qAdd (qMul (f a) (g a)) (qNeg (qMul (f b) (g' b))))) ≔
  λf. λg. λg'. λA. λB. λB'. λhfB. λhgB. λhg'B. λhfR. λhgR. λhg'R. λhq. λhA. λhB. λhB'. λn. λk. λa. λb. λt. λh1. λh2. λh3. bndEqB
    (qAdd
      (qMul (qOfNat (A + B)) (rBound a t))
      (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat (A + B')) (rBound t b))))
    (qAdd (rBound n n) (qInvNat k))
    (qAdd (qMul (f a) (g a)) (qNeg (qMul (f b) (g' b))))
    (wdBoundEq h1 h2 h3)
    (bndVia
      (qMul (qOfNat (A + B)) (rBound a t))
      (qAdd (qMul (qOfNat A) (rBound t t)) (qMul (qOfNat (A + B')) (rBound t b)))
      (qMul (f a) (g a))
      (qMul (f t) (g t))
      (qMul (f b) (g' b))
      (bndMulDiffGen f g A B a t (hfB a) (hgB t) (hgR a t) (hfR a t) hA hB)
      (bndVia
        (qMul (qOfNat A) (rBound t t))
        (qMul (qOfNat (A + B')) (rBound t b))
        (qMul (f t) (g t))
        (qMul (f t) (g' t))
        (qMul (f b) (g' b))
        (bndEq
          (qMul (f t) (qAdd (g t) (qNeg (g' t))))
          (qAdd (qMul (f t) (g t)) (qNeg (qMul (f t) (g' t))))
          (qMulSubL (f t) (g t) (g' t))
          (bndMul hA (leQZeroBound t t) (hfB t) (hq t)))
        (bndMulDiffGen f g' A B' t b (hfB t) (hg'B b) (hg'R t b) (hfR t b) hA hB')))

-- the two successor identities the factors satisfy, each definitional
def facEqPair : (p q : El RSeq) → seqBound p + seqBound q ≡ S (mulPred p q) ∈ ℕ
  using (nat.+.eq, realBound.seqBound.eq, realMul.mulPred.eq) ≔
  λp. λq. ⋆

def facEqDeep : (p q q' : El RSeq)
  → seqBound
    p + seqBound q + (seqBound p + seqBound p + (seqBound p + seqBound q')) ≡ S (wdIdx p q q') ∈ ℕ
  using (nat.+.eq,
    ratCeil.qNatBound.eq,
    realBound.seqBound.eq,
    realMul.mulPred.eq,
    realMul.wdIdx.eq,
    realNeg.seqOf.eq) ≔
  λp. λq. λq'. ⋆

def rMulWDStep : (p q q' : El RSeq)
  (hq : (j : ℕ) → El (Bnd (rBound j j) (qAdd (seqOf q j) (qNeg (seqOf q' j)))))
  (n k : ℕ)
  → El (Bnd (qAdd (rBound n n) (qInvNat k)) (qAdd (mulSeq p q n) (qNeg (mulSeq p q' n))))
  using (rationalQ.qAdd.eq,
    rationalQ.qMul.eq,
    rationalQ.qNeg.eq,
    realMul.mulIdx.eq,
    realMul.mulPred.eq,
    realMul.mulSeq.eq,
    realNeg.seqOf.eq) ≔
  λp. λq. λq'. λhq. λn. λk. rMulWDGen
    (seqOf p)
    (seqOf q)
    (seqOf q')
    (seqBound p)
    (seqBound q)
    (seqBound q')
    (bndSeqBound p)
    (bndSeqBound q)
    (bndSeqBound q')
    (regBnd (seqOf p) (regOf p))
    (regBnd (seqOf q) (regOf q))
    (regBnd (seqOf q') (regOf q'))
    hq
    seqBoundPos
    seqBoundPos
    seqBoundPos
    n
    k
    (mulIdx (mulPred p q) n)
    (mulIdx (mulPred p q') n)
    (mulIdx (wdIdx p q q') k)
    (qMulInvIdxC (facEqPair p q))
    (qMulInvIdxC (facEqPair p q'))
    (qMulInvIdxC (facEqDeep p q q'))

def rMulWDInner : (p : El RSeq) {q q' : El RSeq} → Prf (REq q q') → Prf (REq (rMul p q) (rMul p q'))
  using (ratBound.Bnd.eq,
    rationalOrder.LeQ.eq,
    rationalQ.qAdd.eq,
    rationalQ.qNeg.eq,
    real.REq.unfold,
    real.rBound.eq,
    realMul.mulSeq.eq,
    realMul.rMul.eq,
    realNeg.seqOf.eq) ≔
  λp. λq. λq'. λh. squash-elim h (u. reqOf
    (rMul p q)
    (rMul p q')
    (λn. bndOfArch (qAdd (mulSeq p q n) (qNeg (mulSeq p q' n))) (λk. rMulWDStep p q q' u n k)))

-- ===== the descent =====
--
-- Under the strict engine this is the ordinary quot-elim descent, the
-- same shape realAdd uses, and the whole module elaborates in ~2 s.
-- It was NOT ordinary under the old engine. There, every type
-- mentioning `rMul p q` normalised both mulReg's proof term and
-- seqBound's unfolding through divN's fuel recursion, and these items
-- cost 3.5 minutes (rMulWDInnerCls), >6 minutes (rMulComm) and, for
-- the descent itself, more than ten — the module shipped without them.
-- Naming the δ is what made them cheap: with the unfolds licensed
-- rather than ambient, conversion only walks what is cited. B-16 in
-- docs/ProvingFeedback.md has the before/after.
--
-- One item still had to be reshaped rather than licensed: rMulComm's
-- pointwise step goes through `mulSeqCommAt`, abstract in both
-- sequences and both depths. Written inline it is 8.5 s even under the
-- strict engine, because the cong motive puts the two ceilings in the
-- conversion; abstracted, it is free and the call site cites three
-- unfolds. D-3 still earns its keep.
def rMulWDInnerCls : (p q q' : El RSeq)
  (h : Prf (REq q q'))
  → class (rMul p q) ≡ class (rMul p q') ∈ El Real
  using (real.REq.unfold, real.RSeq.unfold, real.Real.unfold) ≔
  λp. λq. λq'. λh. realEqOfREq (rMul p q) (rMul p q') (rMulWDInner p h)

-- ===== the sampling depth is symmetric =====
--
-- `mulPred p q` is seqBound p + S (qNatBound (seqOf q Z)) and seqBound
-- is S (S (qNatBound ·)), so both depths are a + b + 3 — but only up
-- to plusComm, not on the nose. Proved once at two naturals, so the
-- ceilings never have to be looked at.
def ssAddComm : {a b : ℕ} → S (S a) + S b ≡ S (S b) + S a ∈ ℕ ≔
  λa. λb. S (S a) + S b
      ≡⟨ sucPlus (S a) (S b) ⟩ S (S a + S b)
      ≡⟨ cong ℕ (λw. ℕ) (λw. S w) (S a + S b) (S (a + S b)) (sucPlus a (S b)) ⟩ S (S (a + S b))
      ≡⟨ cong ℕ (λw. ℕ) (λw. S (S w)) (a + S b) (S (a + b)) (plusSucId a b) ⟩ S (S (S (a + b)))
      ≡⟨ cong ℕ (λw. ℕ) (λw. S (S (S w))) (a + b) (b + a) (plusComm b a) ⟩ S (S (S (b + a)))
      ≡⟨ sym
        ℕ
        (S (S (b + S a)))
        (S (S (S (b + a))))
        (cong ℕ (λw. ℕ) (λw. S (S w)) (b + S a) (S (b + a)) (plusSucId b a)) ⟩ S (S (b + S a))
      ≡⟨ sym
        ℕ
        (S (S b + S a))
        (S (S (b + S a)))
        (cong ℕ (λw. ℕ) (λw. S w) (S b + S a) (S (b + S a)) (sucPlus b (S a))) ⟩ S (S b + S a)
      ≡⟨ sym ℕ (S (S b) + S a) (S (S b + S a)) (sucPlus (S b) (S a)) ⟩ S (S b) + S a

def mulPredComm : {p q : El RSeq} → mulPred p q ≡ mulPred q p ∈ ℕ
  using (realBound.seqBound.eq, realMul.mulPred.eq) ≔
  λp. λq. ssAddComm

-- the pointwise step, at abstract sequences and abstract depths: the
-- two products differ by qMulComm and by the depth, and the depth
-- difference is an argument. Keeping it abstract is what keeps the
-- ceilings out of the conversion (D-3).
def mulSeqCommAt : (f g : El (ℕ → Q))
  (c d n : ℕ)
  → (c ≡ d ∈ ℕ)
    → qMul (f (mulIdx c n)) (g (mulIdx c n)) ≡ qMul (g (mulIdx d n)) (f (mulIdx d n)) ∈ El Q ≔
  λf. λg. λc. λd. λn. λh. qMul (f (mulIdx c n)) (g (mulIdx c n))
      ≡⟨ qMulComm (f (mulIdx c n)) (g (mulIdx c n)) ⟩ qMul (g (mulIdx c n)) (f (mulIdx c n))
      ≡⟨ cong
        ℕ
        (λw. Q)
        (λw. qMul (g (mulIdx w n)) (f (mulIdx w n)))
        c
        d
        h ⟩ qMul (g (mulIdx d n)) (f (mulIdx d n))

-- ...and hence the product itself commutes ON REPRESENTATIVES: the two
-- sequences are pointwise equal, which rseqEq lifts to RSeq because
-- RSeq is a set
def rMulComm : {x y : El RSeq} → rMul x y ≡ rMul y x ∈ El RSeq
  using (realMul.mulSeq.eq, realMul.rMul.eq, realNeg.seqOf.eq) ≔
  λx. λy. rseqEq (λn. mulSeqCommAt (seqOf x) (seqOf y) (mulPred x y) (mulPred y x) n mulPredComm)

-- outer well-definedness, spent in one line against commutativity
def rMulWDOuterCls : {x x' c : El RSeq}
  (h : Prf (REq x x'))
  → class (rMul x c) ≡ class (rMul x' c) ∈ El Real
  using (real.REq.unfold, real.RSeq.unfold, real.Real.unfold) ≔
  wdOuterOfComm rMul (rMulComm {}) rMulWDInnerCls

def rMulWDOuter : (x x' : El RSeq)
  (h : Prf (REq x x'))
  (v : El Real)
  → quot-elim (w. El Real)
    (q. class (rMul x q))
    v ≡ quot-elim (w. El Real) (q. class (rMul x' q)) v ∈ El Real
  using (rMulWDInnerCls, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold) ≔
  λx. λx'. λh. λv. quot-elim (w. quot-elim (z. El Real)
    (q. class (rMul x q))
    w ≡ quot-elim (z. El Real) (q. class (rMul x' q)) w ∈ El Real)
    (c. rMulWDOuterCls h)
    v

-- ===== multiplication on ℝ =====
def realMul : El Real → El Real → El Real
  using (rMulWDInnerCls,
    rMulWDOuter,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold) ≔
  λu. λv. quot-elim (w. El Real) (p. quot-elim (w. El Real) (q. class (rMul p q)) v) u

def realMulCls : {x : El RSeq}
  (y : El RSeq)
  → realMul (class x) (class y) ≡ class (rMul x y) ∈ El Real
  using (real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realMul.rMul.eq,
    realMul.realMul.eq) ≔
  λx. λy. ⋆

def realMulComm : (u v : El Real) → realMul u v ≡ realMul v u ∈ El Real
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realMul.realMul.eq) ≔
  λu. λv. quot-elim (w. realMul w v ≡ realMul v w ∈ El Real)
    (p. quot-elim (w. realMul (class p) w ≡ realMul w (class p) ∈ El Real)
      (q. cong RSeq (λw. Real) (λw. class w) (rMul p q) (rMul q p) rMulComm)
      v)
    u

-- the embedding of ℚ is a homomorphism: both products are the constant
-- sequence at a·b, at every sampling depth
def realMulOfQ : (a b : El Q) → realMul (realOfQ a) (realOfQ b) ≡ realOfQ (qMul a b) ∈ El Real
  using (rationalQ.Q.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.constReg.eq,
    real.realOfQ.eq,
    realMul.mulSeq.eq,
    realMul.rMul.eq,
    realMul.realMul.eq,
    realNeg.seqOf.eq) ≔
  λa. λb. realEqOfSeqEq
    (rMul ((λn. a), constReg) ((λn. b), constReg))
    ((λn. qMul a b), constReg)
    (λn. ⋆)
