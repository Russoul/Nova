-- ORDER FACTS ABOUT ℚ's RECIPROCAL.
--
-- rationalAlgInv gives qInv and the one equation qMulInvR: u · u⁻¹ = 1
-- for u ≠ 0. It says nothing about ORDER, and the reciprocal's
-- convergence estimate is entirely about order — |1/a − 1/b| is small
-- because a and b are bounded AWAY from zero. This module supplies
-- the missing half.
--
-- The chain has to be walked in the right order, because the obvious
-- route is circular: cancelling by a positive c wants 0 ≤ c⁻¹, and the
-- usual proof of 0 ≤ c⁻¹ wants cancellation. It is broken by proving
-- 0 ≤ c⁻¹ directly from a SIGN case split: if c⁻¹ were negative then
-- c · c⁻¹ would be ≤ 0, and it is 1.

import prop (⊥, ¬, ⊃, impIntro, impApply, absurdP)
import rationalQ (Q, qAdd, qMul, qNeg, qZero, qOne, qAddZeroL, qAddZeroR, qAddComm, qAddAssoc, qAddNegR, qNegNeg, qMulComm, qMulAssoc, qMulOneL, qMulOneR, qDistribR)
import rationalOrder (Sign, sPos, sNeg, sZero, sgnQ, NonNegS, LeQ, sgnCases, leQTrans, leQMulMono, leQAntisym, leQOfEq, sZeroNotPos)
import ratBound (leQNegFlip, leQZeroOfNonNeg, leQZeroOfPos, qNegZeroQ)
import ratAbs (leQZeroMul, qNegMulR, sgnQNegOfNeg)
import ratLt (sgnQAddPosNonNeg)
import ratSqrt (qMulSwap3)
import rationalAlgInv (qInv, qMulInvR, qInvUniqueVal)
import real (qInvNat, qInvNatPos)
import equality (trans, sym, cong, transport, transportP)
import id (Id, idToEq, eqToId)

def sgnQZeroEq : sgnQ qZero ≡ sZero using (rationalOrder.sgnQZero) ≔ ⋆

-- qOne IS qInvNat Z, so its sign comes from real.qInvNatPos
def qInvNatZeroEq : qInvNat Z ≡ qOne
  using (real.qInvNat.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq,
    rational.mkRat.eq,
    integer.intOne.eq,
    rational.nzPos.eq,
    rational.ratOne.eq,
    rational.ratOfInt.eq,
    rational.nzOne.eq) ≔
  ⋆

def sgnQOneEq : sgnQ qOne ≡ sPos ≔
  transportP Q (λw. sgnQ w ≡ sPos) (qInvNat Z) qOne qInvNatZeroEq (qInvNatPos Z)

def leQZeroOne : El (LeQ qZero qOne) ≔ leQZeroOfPos qOne sgnQOneEq

def qNeZeroOfPos : {u : El Q} → (sgnQ u ≡ sPos) → Prf (¬ (u ≡ qZero)) using (prop.¬.eq) ≔
  λu. λhp. impIntro
    (u ≡ qZero)
    ⊥
    (λhz. 𝟘-elim (sZeroNotPos
      (trans
        Sign
        sZero
        (sgnQ u)
        sPos
        (sym
          Sign
          (sgnQ u)
          sZero
          (trans
            Sign
            (sgnQ u)
            (sgnQ qZero)
            sZero
            (cong Q (λw. Sign) (λw. sgnQ w) u qZero hz)
            sgnQZeroEq))
        hp)))

def qMulInvPos : {c : El Q} → (sgnQ c ≡ sPos) → qMul c (qInv c) ≡ qOne ≔
  λc. λhp. qMulInvR (qNeZeroOfPos hp)

-- a negative sign is a value at most zero
def leQZeroOfNeg : {u : El Q} → El (Id Sign (sgnQ u) sNeg) → El (LeQ u qZero)
  using (rationalOrder.LeQ.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λhn. transport
    Q
    (λw. NonNegS (sgnQ w))
    (qNeg u)
    (qAdd qZero (qNeg u))
    (sym Q (qAdd qZero (qNeg u)) (qNeg u) (qAddZeroL (qNeg u)))
    (inj₂ (eqToId (sgnQ (qNeg u)) sPos (sgnQNegOfNeg hn)))

-- nonnegative times nonpositive is nonpositive
def leQMulNonPos : {a b : El Q} → El (LeQ qZero a) → El (LeQ b qZero) → El (LeQ (qMul a b) qZero) ≔
  λa. λb. λha. λhb. transport
    Q
    (λw. LeQ w qZero)
    (qNeg (qNeg (qMul a b)))
    (qMul a b)
    (qNegNeg (qMul a b))
    (transport
      Q
      (λw. LeQ (qNeg w) qZero)
      (qMul a (qNeg b))
      (qNeg (qMul a b))
      (qNegMulR a b)
      (transport
        Q
        (λw. LeQ (qNeg (qMul a (qNeg b))) w)
        (qNeg qZero)
        qZero
        qNegZeroQ
        (leQNegFlip
          qZero
          (qMul a (qNeg b))
          (leQZeroMul
            ha
            (transport
              Q
              (λw. LeQ w (qNeg b))
              (qNeg qZero)
              qZero
              qNegZeroQ
              (leQNegFlip b qZero hb))))))

-- THE circle-breaker: the reciprocal of a positive is nonnegative.
-- If it were negative, c · c⁻¹ would be ≤ 0; but it is 1, and 0 ≤ 1,
-- so 1 = 0 and the signs collide.
def leQZeroInv : {c : El Q} → (sgnQ c ≡ sPos) → El (LeQ qZero (qInv c))
  using (rationalOrder.LeQ.unfold, rationalOrder.NonNegS.unfold) ≔
  λc. λhp. ⊎-elim
    (nn. leQZeroOfNonNeg (qInv c) nn)
    (hn. 𝟘-elim (sZeroNotPos
      (trans
        Sign
        sZero
        (sgnQ qOne)
        sPos
        (sym
          Sign
          (sgnQ qOne)
          sZero
          (trans
            Sign
            (sgnQ qOne)
            (sgnQ qZero)
            sZero
            (cong
              Q
              (λw. Sign)
              (λw. sgnQ w)
              qOne
              qZero
              (leQAntisym
                (transport
                  Q
                  (λw. LeQ w qZero)
                  (qMul c (qInv c))
                  qOne
                  (qMulInvPos hp)
                  (leQMulNonPos
                    (leQZeroOfNonNeg c (inj₂ (eqToId (sgnQ c) sPos hp)))
                    (leQZeroOfNeg hn)))
                leQZeroOne))
            sgnQZeroEq))
        sgnQOneEq)))
    (sgnCases (sgnQ (qInv c)))

-- ===== cancellation, and what follows =====
def cancelR : {z c : El Q} → (sgnQ c ≡ sPos) → qMul (qMul z c) (qInv c) ≡ z ≔
  λz. λc. λhp. trans
    Q
    (qMul (qMul z c) (qInv c))
    (qMul z (qMul c (qInv c)))
    z
    (qMulAssoc z c (qInv c))
    (trans
      Q
      (qMul z (qMul c (qInv c)))
      (qMul z qOne)
      z
      (cong Q (λw. Q) (λw. qMul z w) (qMul c (qInv c)) qOne (qMulInvPos hp))
      (qMulOneR z))

def leQMulCancel : {x y : El Q}
  (c : El Q)
  → (sgnQ c ≡ sPos) → El (LeQ (qMul x c) (qMul y c)) → El (LeQ x y) ≔
  λx. λy. λc. λhp. λh. transport
    Q
    (λw. LeQ w y)
    (qMul (qMul x c) (qInv c))
    x
    (cancelR hp)
    (transport
      Q
      (λw. LeQ (qMul (qMul x c) (qInv c)) w)
      (qMul (qMul y c) (qInv c))
      y
      (cancelR hp)
      (leQMulMono (qMul x c) (qMul y c) h (leQZeroInv hp)))

def qAddSubCancel : {c u : El Q} → qAdd c (qAdd u (qNeg c)) ≡ u ≔
  λc. λu. trans
    Q
    (qAdd c (qAdd u (qNeg c)))
    (qAdd u (qAdd c (qNeg c)))
    u
    (trans
      Q
      (qAdd c (qAdd u (qNeg c)))
      (qAdd (qAdd c u) (qNeg c))
      (qAdd u (qAdd c (qNeg c)))
      (sym Q (qAdd (qAdd c u) (qNeg c)) (qAdd c (qAdd u (qNeg c))) (qAddAssoc c u (qNeg c)))
      (trans
        Q
        (qAdd (qAdd c u) (qNeg c))
        (qAdd (qAdd u c) (qNeg c))
        (qAdd u (qAdd c (qNeg c)))
        (cong Q (λw. Q) (λw. qAdd w (qNeg c)) (qAdd c u) (qAdd u c) (qAddComm c u))
        (qAddAssoc u c (qNeg c))))
    (trans
      Q
      (qAdd u (qAdd c (qNeg c)))
      (qAdd u qZero)
      u
      (cong Q (λw. Q) (λw. qAdd u w) (qAdd c (qNeg c)) qZero (qAddNegR c))
      (qAddZeroR u))

-- anything above a positive is positive
def sgnQPosOfLe : (c : El Q) {u : El Q} → (sgnQ c ≡ sPos) → El (LeQ c u) → sgnQ u ≡ sPos
  using (rationalOrder.LeQ.unfold) ≔
  λc. λu. λhp. λh. transportP
    Q
    (λw. sgnQ w ≡ sPos)
    (qAdd c (qAdd u (qNeg c)))
    u
    qAddSubCancel
    (sgnQAddPosNonNeg hp h)

-- the reciprocal is antitone on the positives: cancel by c, then by u
def leQInvAnti : {c u : El Q} → (sgnQ c ≡ sPos) → El (LeQ c u) → El (LeQ (qInv u) (qInv c)) ≔
  λc. λu. λhp. λh. leQMulCancel
    c
    hp
    (transport
      Q
      (λw. LeQ (qMul (qInv u) c) w)
      qOne
      (qMul (qInv c) c)
      (sym
        Q
        (qMul (qInv c) c)
        qOne
        (trans Q (qMul (qInv c) c) (qMul c (qInv c)) qOne (qMulComm (qInv c) c) (qMulInvPos hp)))
      (leQMulCancel
        u
        (sgnQPosOfLe c hp h)
        (transport
          Q
          (λw. LeQ w (qMul qOne u))
          c
          (qMul (qMul (qInv u) c) u)
          (sym
            Q
            (qMul (qMul (qInv u) c) u)
            c
            (trans
              Q
              (qMul (qMul (qInv u) c) u)
              (qMul (qMul (qInv u) u) c)
              c
              (qMulSwap3 (qInv u) c u)
              (trans
                Q
                (qMul (qMul (qInv u) u) c)
                (qMul qOne c)
                c
                (cong
                  Q
                  (λw. Q)
                  (λw. qMul w c)
                  (qMul (qInv u) u)
                  qOne
                  (trans
                    Q
                    (qMul (qInv u) u)
                    (qMul u (qInv u))
                    qOne
                    (qMulComm (qInv u) u)
                    (qMulInvPos (sgnQPosOfLe c hp h))))
                (qMulOneL c))))
          (transport Q (λw. LeQ c w) u (qMul qOne u) (sym Q (qMul qOne u) u (qMulOneL u)) h))))

-- ...so a reciprocal is bounded by any M inverse to a lower bound
def leQInvBound : (c : El Q)
  {u M : El Q}
  → (sgnQ c ≡ sPos) → El (LeQ c u) → (qMul c M ≡ qOne) → El (LeQ (qInv u) M) ≔
  λc. λu. λM. λhp. λh. λhm. transport
    Q
    (λw. LeQ (qInv u) w)
    (qInv c)
    M
    (sym Q M (qInv c) (qInvUniqueVal c hm (qMulInvPos hp)))
    (leQInvAnti hp h)

-- ===== the difference identity =====
--
--   1/a − 1/b = (b − a)·(1/a)·(1/b)
--
-- This is what turns "a and b are close and bounded away from zero"
-- into "their reciprocals are close": the factor (b − a) carries the
-- closeness and the two reciprocals carry the bound.
def negMulL : {x y : El Q} → qMul (qNeg x) y ≡ qNeg (qMul x y) ≔
  λx. λy. trans
    Q
    (qMul (qNeg x) y)
    (qMul y (qNeg x))
    (qNeg (qMul x y))
    (qMulComm (qNeg x) y)
    (trans
      Q
      (qMul y (qNeg x))
      (qNeg (qMul y x))
      (qNeg (qMul x y))
      (qNegMulR y x)
      (cong Q (λw. Q) (λw. qNeg w) (qMul y x) (qMul x y) (qMulComm y x)))

def invFirst : (a b : El Q) → (sgnQ b ≡ sPos) → qMul (qMul b (qInv a)) (qInv b) ≡ qInv a ≔
  λa. λb. λhb. trans
    Q
    (qMul (qMul b (qInv a)) (qInv b))
    (qMul (qMul b (qInv b)) (qInv a))
    (qInv a)
    (qMulSwap3 b (qInv a) (qInv b))
    (trans
      Q
      (qMul (qMul b (qInv b)) (qInv a))
      (qMul qOne (qInv a))
      (qInv a)
      (cong Q (λw. Q) (λw. qMul w (qInv a)) (qMul b (qInv b)) qOne (qMulInvPos hb))
      (qMulOneL (qInv a)))

def invSecond : (a b : El Q)
  → (sgnQ a ≡ sPos) → qMul (qMul (qNeg a) (qInv a)) (qInv b) ≡ qNeg (qInv b) ≔
  λa. λb. λha. trans
    Q
    (qMul (qMul (qNeg a) (qInv a)) (qInv b))
    (qMul (qNeg qOne) (qInv b))
    (qNeg (qInv b))
    (cong
      Q
      (λw. Q)
      (λw. qMul w (qInv b))
      (qMul (qNeg a) (qInv a))
      (qNeg qOne)
      (trans
        Q
        (qMul (qNeg a) (qInv a))
        (qNeg (qMul a (qInv a)))
        (qNeg qOne)
        negMulL
        (cong Q (λw. Q) (λw. qNeg w) (qMul a (qInv a)) qOne (qMulInvPos ha))))
    (trans
      Q
      (qMul (qNeg qOne) (qInv b))
      (qNeg (qMul qOne (qInv b)))
      (qNeg (qInv b))
      negMulL
      (cong Q (λw. Q) (λw. qNeg w) (qMul qOne (qInv b)) (qInv b) (qMulOneL (qInv b))))

def qInvDiff : {a b : El Q}
  → (sgnQ
    a ≡ sPos)
    → (sgnQ
      b ≡ sPos) → qMul (qMul (qAdd b (qNeg a)) (qInv a)) (qInv b) ≡ qAdd (qInv a) (qNeg (qInv b)) ≔
  λa. λb. λha. λhb. qMul (qMul (qAdd b (qNeg a)) (qInv a)) (qInv b)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qMul w (qInv b))
        (qMul (qAdd b (qNeg a)) (qInv a))
        (qAdd (qMul b (qInv a)) (qMul (qNeg a) (qInv a)))
        (qDistribR
          (qInv a)
          b
          (qNeg a)) ⟩ qMul (qAdd (qMul b (qInv a)) (qMul (qNeg a) (qInv a))) (qInv b)
      ≡⟨ qDistribR
        (qInv b)
        (qMul b (qInv a))
        (qMul
          (qNeg a)
          (qInv
            a)) ⟩ qAdd (qMul (qMul b (qInv a)) (qInv b)) (qMul (qMul (qNeg a) (qInv a)) (qInv b))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qAdd w (qMul (qMul (qNeg a) (qInv a)) (qInv b)))
        (qMul (qMul b (qInv a)) (qInv b))
        (qInv a)
        (invFirst a b hb) ⟩ qAdd (qInv a) (qMul (qMul (qNeg a) (qInv a)) (qInv b))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qAdd (qInv a) w)
        (qMul (qMul (qNeg a) (qInv a)) (qInv b))
        (qNeg (qInv b))
        (invSecond a b ha) ⟩ qAdd (qInv a) (qNeg (qInv b))
