-- ORDER FACTS ABOUT ℚ's RECIPROCAL.
--
-- rationalAlgInv gives qInv and the one equation qMulInvR: u · u⁻¹ = 1
-- for u ≠ 0. It says nothing about ORDER, and the reciprocal's
-- convergence estimate is entirely about order — |1/a − 1/b| is small
-- because a and b are bounded AWAY from zero. This module supplies
-- the missing half.
--
-- The chain has to be walked in the right order, because the obvious
-- route is circular: cancelling by a positive c wants 0 ≤ c⁻¹, and the
-- usual proof of 0 ≤ c⁻¹ wants cancellation. It is broken by proving
-- 0 ≤ c⁻¹ directly from a SIGN case split: if c⁻¹ were negative then
-- c · c⁻¹ would be ≤ 0, and it is 1.

import prop (⊥, ¬, ⊃, impIntro, impApply, absurdP)
import rationalQ (Q, +, *, qNeg, qZero, qOne, qAddZeroL, qAddZeroR, qAddComm, qAddAssoc, qAddNegR, qNegNeg, qMulComm, qMulAssoc, qMulOneL, qMulOneR, qDistribR)
import rationalOrder (Sign, sPos, sNeg, sZero, sgnQ, NonNegS, ≤, sgnCases, leQTrans, leQMulMono, leQAntisym, leQOfEq, sZeroNotPos)
import ratBound (leQNegFlip, leQZeroOfNonNeg, leQZeroOfPos, qNegZeroQ)
import ratAbs (leQZeroMul, qNegMulR, sgnQNegOfNeg)
import ratLt (sgnQAddPosNonNeg)
import ratSqrt (qMulSwap3)
import rationalAlgInv (qInv, qMulInvR, qInvUniqueVal)
import real (qInvNat, qInvNatPos)
import equality (trans, sym, cong, transport, transportP)
import id (Id, idToEq, eqToId)

def sgnQZeroEq : sgnQ qZero ≡ sZero using (rationalOrder.sgnQZero) ≔ ⋆

-- qOne IS qInvNat Z, so its sign comes from real.qInvNatPos
def qInvNatZeroEq : qInvNat Z ≡ qOne
  using (real.qInvNat.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq,
    rational.mkRat.eq,
    integer.intOne.eq,
    rational.nzPos.eq,
    rational.ratOne.eq,
    rational.ratOfInt.eq,
    rational.nzOne.eq) ≔
  ⋆

def sgnQOneEq : sgnQ qOne ≡ sPos ≔ transportP (λw. sgnQ w ≡ sPos) qInvNatZeroEq (qInvNatPos Z)

def leQZeroOne : qZero ≤ qOne ≔ leQZeroOfPos _ sgnQOneEq

def qNeZeroOfPos : {u : Q} → (sgnQ u ≡ sPos) → ¬ (u ≡ qZero) using (prop.¬.eq) ≔
  λu. λhp. impIntro
    {u ≡ qZero}
    {⊥}
    (λhz. 𝟘-elim (sZeroNotPos
      (trans _ _ _ (sym _ _ (trans _ _ _ (cong (λw. Sign) (λw. sgnQ w) hz) sgnQZeroEq)) hp)))

def qMulInvPos : {c : Q} → (sgnQ c ≡ sPos) → c * qInv c ≡ qOne ≔ λc. λhp. qMulInvR (qNeZeroOfPos hp)

-- a negative sign is a value at most zero
def leQZeroOfNeg : {u : Q} → Id _ (sgnQ u) sNeg → u ≤ qZero
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λu. λhn. transport
    (λw. NonNegS (sgnQ w))
    (sym _ _ (qAddZeroL (qNeg u)))
    (inj₂ (eqToId _ _ (sgnQNegOfNeg hn)))

-- nonnegative times nonpositive is nonpositive
def leQMulNonPos : {a b : Q} → qZero ≤ a → b ≤ qZero → a * b ≤ qZero ≔
  λa. λb. λha. λhb. transport
    (λw. w ≤ qZero)
    (qNegNeg (a * b))
    (transport
      (λw. qNeg w ≤ qZero)
      (qNegMulR a b)
      (transport
        (λw. qNeg (a * qNeg b) ≤ w)
        qNegZeroQ
        (leQNegFlip
          _
          _
          (leQZeroMul ha (transport (λw. w ≤ qNeg b) qNegZeroQ (leQNegFlip _ _ hb))))))

-- THE circle-breaker: the reciprocal of a positive is nonnegative.
-- If it were negative, c · c⁻¹ would be ≤ 0; but it is 1, and 0 ≤ 1,
-- so 1 = 0 and the signs collide.
def leQZeroInv : {c : Q} → (sgnQ c ≡ sPos) → qZero ≤ qInv c
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λc. λhp. ⊎-elim
    (nn. leQZeroOfNonNeg _ nn)
    (hn. 𝟘-elim (sZeroNotPos
      (trans
        _
        _
        _
        (sym
          _
          _
          (trans
            _
            _
            _
            (cong
              (λw. Sign)
              (λw. sgnQ w)
              (leQAntisym
                (transport
                  (λw. w ≤ qZero)
                  (qMulInvPos hp)
                  (leQMulNonPos (leQZeroOfNonNeg c (inj₂ (eqToId _ _ hp))) (leQZeroOfNeg hn)))
                leQZeroOne))
            sgnQZeroEq))
        sgnQOneEq)))
    (sgnCases (sgnQ (qInv c)))

-- ===== cancellation, and what follows =====
def cancelR : {z c : Q} → (sgnQ c ≡ sPos) → z * c * qInv c ≡ z ≔
  λz. λc. λhp. trans
    _
    _
    _
    (qMulAssoc z c (qInv c))
    (trans _ _ _ (cong (λw. Q) (λw. z * w) (qMulInvPos hp)) (qMulOneR z))

def leQMulCancel : {x y : Q} (c : Q) → (sgnQ c ≡ sPos) → x * c ≤ y * c → x ≤ y ≔
  λx. λy. λc. λhp. λh. transport
    {Q}
    (λw. w ≤ y)
    {x * c * qInv c}
    {x}
    (cancelR hp)
    (transport
      {Q}
      (λw. x * c * qInv c ≤ w)
      {y * c * qInv c}
      {y}
      (cancelR hp)
      (leQMulMono _ _ h (leQZeroInv hp)))

def qAddSubCancel : {c u : Q} → c + (u + qNeg c) ≡ u ≔
  λc. λu. trans
    _
    _
    _
    (trans
      _
      _
      _
      (sym _ _ (qAddAssoc c u (qNeg c)))
      (trans _ _ _ (cong (λw. Q) (λw. w + qNeg c) (qAddComm c u)) (qAddAssoc u c (qNeg c))))
    (trans _ _ _ (cong (λw. Q) (λw. u + w) (qAddNegR c)) (qAddZeroR u))

-- anything above a positive is positive
def sgnQPosOfLe : (c : Q) {u : Q} → (sgnQ c ≡ sPos) → c ≤ u → sgnQ u ≡ sPos
  using (rationalOrder.≤.unfold) ≔
  λc. λu. λhp. λh. transportP
    {Q}
    (λw. sgnQ w ≡ sPos)
    {c + (u + qNeg c)}
    {u}
    qAddSubCancel
    (sgnQAddPosNonNeg hp h)

-- the reciprocal is antitone on the positives: cancel by c, then by u
def leQInvAnti : {c u : Q} → (sgnQ c ≡ sPos) → c ≤ u → qInv u ≤ qInv c ≔
  λc. λu. λhp. λh. leQMulCancel
    _
    hp
    (transport
      (λw. qInv u * c ≤ w)
      (sym _ _ (trans _ _ _ (qMulComm (qInv c) c) (qMulInvPos hp)))
      (leQMulCancel
        _
        (sgnQPosOfLe _ hp h)
        (transport
          (λw. w ≤ qOne * u)
          (sym
            _
            _
            (trans
              _
              _
              _
              (qMulSwap3 (qInv u) c u)
              (trans
                _
                _
                _
                (cong
                  (λw. Q)
                  (λw. w * c)
                  (trans _ _ _ (qMulComm (qInv u) u) (qMulInvPos (sgnQPosOfLe _ hp h))))
                (qMulOneL c))))
          (transport (λw. c ≤ w) (sym _ _ (qMulOneL u)) h))))

-- ...so a reciprocal is bounded by any M inverse to a lower bound
def leQInvBound : (c : Q) {u M : Q} → (sgnQ c ≡ sPos) → c ≤ u → (c * M ≡ qOne) → qInv u ≤ M ≔
  λc. λu. λM. λhp. λh. λhm. transport
    (λw. qInv u ≤ w)
    (sym _ _ (qInvUniqueVal _ hm (qMulInvPos hp)))
    (leQInvAnti hp h)

-- ===== the difference identity =====
--
--   1/a − 1/b = (b − a)·(1/a)·(1/b)
--
-- This is what turns "a and b are close and bounded away from zero"
-- into "their reciprocals are close": the factor (b − a) carries the
-- closeness and the two reciprocals carry the bound.
def negMulL : {x y : Q} → qNeg x * y ≡ qNeg (x * y) ≔
  λx. λy. trans
    _
    _
    _
    (qMulComm (qNeg x) y)
    (trans _ _ _ (qNegMulR y x) (cong (λw. Q) (λw. qNeg w) (qMulComm y x)))

def invFirst : (a b : Q) → (sgnQ b ≡ sPos) → b * qInv a * qInv b ≡ qInv a ≔
  λa. λb. λhb. trans
    _
    _
    _
    (qMulSwap3 b (qInv a) (qInv b))
    (trans _ _ _ (cong (λw. Q) (λw. w * qInv a) (qMulInvPos hb)) (qMulOneL (qInv a)))

def invSecond : (a b : Q) → (sgnQ a ≡ sPos) → qNeg a * qInv a * qInv b ≡ qNeg (qInv b) ≔
  λa. λb. λha. trans
    _
    _
    _
    (cong
      (λw. Q)
      (λw. w * qInv b)
      (trans (qNeg a * qInv a) _ _ negMulL (cong (λw. Q) (λw. qNeg w) (qMulInvPos ha))))
    (trans (qNeg qOne * qInv b) _ _ negMulL (cong (λw. Q) (λw. qNeg w) (qMulOneL (qInv b))))

def qInvDiff : {a b : Q}
  → (sgnQ a ≡ sPos) → (sgnQ b ≡ sPos) → (b + qNeg a) * qInv a * qInv b ≡ qInv a + qNeg (qInv b) ≔
  λa. λb. λha. λhb. (b + qNeg a) * qInv a * qInv b
      ≡⟨ cong
        (λw. Q)
        (λw. w * qInv b)
        (qDistribR (qInv a) b (qNeg a)) ⟩ (b * qInv a + qNeg a * qInv a) * qInv b
      ≡⟨ qDistribR
        (qInv b)
        (b * qInv a)
        (qNeg a * qInv a) ⟩ b * qInv a * qInv b + qNeg a * qInv a * qInv b
      ≡⟨ cong
        (λw. Q)
        (λw. w + qNeg a * qInv a * qInv b)
        (invFirst a _ hb) ⟩ qInv a + qNeg a * qInv a * qInv b
      ≡⟨ cong (λw. Q) (λw. qInv a + w) (invSecond _ b ha) ⟩ qInv a + qNeg (qInv b)
