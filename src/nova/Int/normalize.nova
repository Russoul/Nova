-- the canonical representative: strip successors pairwise

import Natural (+, plusZeroId, plusSucId, zeroPlusId)
import Int (Int)
import Core.equality (sym)

normPair : ℕ → ℕ → ℕ × ℕ
normPair = λa. ℕ-elim (λb. Z, b) (n ih. λb. ℕ-elim (S n, Z) (m ihb. ih m) b) a

-- the three defining equations of normPair, in folded vocabulary, so
-- they can fire as rewrite rules without unfolding normPair in goals
normPairZero : (b : ℕ) → normPair Z b ≡ (Z, b) using (Int.normalize.normPair.eq)
normPairZero = λb. ⋆

normPairSucZero : (n : ℕ) → normPair (S n) Z ≡ (S n, Z) using (Int.normalize.normPair.eq)
normPairSucZero = λn. ⋆

normPairSucSuc : (n m : ℕ) → normPair (S n) (S m) ≡ normPair n m using (Int.normalize.normPair.eq)
normPairSucSuc = λn m. ⋆

-- normPair a b is R-related to (a, b)
normSound : (a b : ℕ) → normPair a b .π₁ + b ≡ normPair a b .π₂ + a
normSound =
  λa. ℕ-elim
    λb. let claim9 = normPairZero b in let claim10 = zeroPlusId b in let claim11 = plusZeroId b in ⋆
    n ih. λb. ℕ-elim
      let claim6 = normPairSucZero n
          claim7 = plusZeroId (S n)
          claim8 = zeroPlusId (S n)
          ⋆
      m ihb. let claim2 = normPairSucSuc n m
                 claim3 = plusSucId (normPair n m .π₁) m
                 claim4 = ih m
                 claim5 = plusSucId (normPair n m .π₂) n
                 ⋆
      b
    a

-- at the quotient, normalization is invisible
normClass : (a b : ℕ) → class (normPair a b) ≡ class (a, b) ∈ Int using (Int.Int.unfold)
normClass = λa b. let claim1 = normSound a b in ⋆

intNormalize : Int → Int using (Int.Int.unfold, Int.IntR.unfold)
intNormalize =
  λz. let wd : (rep rep' : ℕ × ℕ)
            (h : rep .π₁ + rep' .π₂ ≡ rep .π₂ + rep' .π₁)
            → class (normPair (rep .π₁) (rep .π₂)) ≡ class (normPair (rep' .π₁) (rep' .π₂)) ∈ Int
            = λrep rep' h. class (normPair (rep .π₁) (rep .π₂))
              ≡⟨ normClass (rep .π₁) (rep .π₂) ⟩ class (rep .π₁, rep .π₂)
              ≡⟨ (⋆ : class (rep .π₁, rep .π₂) ≡ class (rep' .π₁, rep' .π₂) ∈ Int) ⟩
                class (rep' .π₁, rep' .π₂)
              ≡⟨ sym _ _ (normClass (rep' .π₁) (rep' .π₂)) ⟩ class (normPair (rep' .π₁) (rep' .π₂))
          quot-elim (rep. class (normPair (rep .π₁) (rep .π₂))) z

intNormalizeTest1 : intNormalize (class (S Z, Z)) ≡ class (S Z, Z)
  using (Int.Int.unfold, Int.normalize.intNormalize.eq, Int.normalize.normPair.eq)
intNormalizeTest1 = ⋆

intNormalizeTest2 : intNormalize (class (S Z, 2)) ≡ class (Z, S Z)
  using (Int.Int.unfold, Int.normalize.intNormalize.eq, Int.normalize.normPair.eq)
intNormalizeTest2 = ⋆
