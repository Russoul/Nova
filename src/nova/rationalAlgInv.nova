-- intNonZero FIRST: it fixes the elaboration order of the transitive
-- imports, and integerNormalize's own well-definedness proof only
-- survives if it is elaborated before rationalQ's clsEqOfRel enters
-- the store (docs/ProvingFeedback.md B-3/B-5)
-- The ALGORITHMIC inverse: a total function qInv : El Q → El Q that
-- computes a multiplicative inverse (and returns 0 at 0), together
-- with the non-erased existence statement
--
--   (u : El Q) (h : Prf (u ≢ 0)) → (v : El Q) ⨯ Prf (qMul u v ≡ qOne)
--
-- whose first component IS the inverse, not a squashed promise.
--
-- What makes this possible is intNonZero.nova's DATA-valued view
-- nzOfInt: the numerator's sign is decided by a function, so the
-- inverse can branch on it. The price is that qInv's descent to the
-- quotient needs ℤ to have no zero divisors — for related p, p′ the
-- numerators are not equal, so the two branches must be shown to agree,
-- and the mixed case (one numerator zero, the other not) is refuted
-- exactly by intNoZeroDiv.
-- ===== the inverse on representatives =====
-- taking the view as an argument (rather than calling nzOfInt inside)
-- is what lets the proofs below case-split on it: they eliminate the
-- same scrutinee under a motive mentioning invRepAt

import intNonZero (nzOfInt, nzToIntNonZero, intNoZeroDiv)
import nat (+, *, plusComm, plusAssoc, multComm)
import integer (Int, intZero, intOne)
import integerMul (*, intMulComm, intMulOneL, intMulOneR, intMulZeroL, intMulZeroR, intMulCong2)
import prop (¬, ⊥, absurdP)
import rational (NZ, nzPos, nzToInt, nzMul, Rat, mkRat, num, den, ratZero, ratOne, ratEta, half, third)
import rationalQ (Q, qcls, qZero, qOne, *, ratMul, RatR, clsEqOfRel, dInt, nzToIntMul, mulCongL, mulCongR, NZQ, qOfNzq, qMulOneL, qMulOneR, qMulComm, qMulAssoc)
import rationalInv (notIntro, notApply, numNonZero)
import equality (trans, sym, cong)

def invRepAt : (p : El Rat)
  → ((e : El NZ) ⨯ Prf (nzToInt e ≡ num p)) ⊎ Prf (num p ≡ intZero) → El Rat
  using (rational.Rat.unfold) ≔
  λp. λv. ⊎-elim (u. mkRat (dInt p) (u .π₁)) (u. ratZero) v

def invRep : El Rat → El Rat using (rational.Rat.unfold) ≔ λp. invRepAt _ (nzOfInt (num p))

-- ===== well-definedness =====
-- both numerators non-zero: the goal IS the hypothesis, commuted
-- p′'s numerator is zero, p's is not: impossible, by no zero divisors
-- p's numerator is zero, p′'s is not: impossible, symmetrically
-- both zero: both inverses are the junk value
def invRepWDAt : {p p' : El Rat}
  (h : Prf (RatR p p'))
  (v : ((e : El NZ) ⨯ Prf (nzToInt e ≡ num p)) ⊎ Prf (num p ≡ intZero))
  (v' : ((e : El NZ) ⨯ Prf (nzToInt e ≡ num p')) ⊎ Prf (num p' ≡ intZero))
  → num (invRepAt _ v) * dInt (invRepAt _ v') ≡ num (invRepAt _ v') * dInt (invRepAt _ v)
  using (intMulOneR,
    intMulZeroL,
    integer.Int.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzToInt.eq,
    rationalAlgInv.invRepAt.eq,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λp'. λh. λv. λv'. ⊎-elim
    (ex. ⊎-elim
      (ey. trans
        (dInt p * nzToInt (ey .π₁))
        _
        (dInt p' * nzToInt (ex .π₁))
        (mulCongR (dInt p) _ _ (ey .π₂))
        (trans
          _
          _
          _
          (trans
            _
            _
            _
            (intMulComm (dInt p) (num p'))
            (trans
              _
              _
              _
              (sym (num p * dInt p') (num p' * dInt p) h)
              (intMulComm (num p) (dInt p'))))
          (mulCongR (dInt p') _ _ (sym _ _ (ex .π₂)))))
      (ey. absurdP
        _
        (notApply
          _
          (nzToIntNonZero (ex .π₁))
          (trans
            _
            _
            _
            (ex .π₂)
            (intNoZeroDiv
              _
              (trans
                (num p * dInt p')
                _
                _
                h
                (trans _ _ _ (mulCongL _ _ (dInt p) ey) (intMulZeroL (dInt p))))
              (nzToIntNonZero (den p'))))))
      v')
    (ex. ⊎-elim
      (ey. absurdP
        _
        (notApply
          _
          (nzToIntNonZero (ey .π₁))
          (trans
            _
            _
            _
            (ey .π₂)
            (intNoZeroDiv
              _
              (trans
                _
                _
                _
                (sym (num p * dInt p') (num p' * dInt p) h)
                (trans _ _ _ (mulCongL _ _ (dInt p') ex) (intMulZeroL (dInt p'))))
              (nzToIntNonZero (den p))))))
      (ey. ⋆)
      v')
    v

def invRepWD : {p p' : El Rat}
  (h : Prf (RatR p p'))
  → num (invRep p) * dInt (invRep p') ≡ num (invRep p') * dInt (invRep p)
  using (intNonZero.nzOfInt.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.num.eq,
    rationalAlgInv.invRep.eq,
    rationalAlgInv.invRepAt.eq,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq) ≔
  λp. λp'. λh. invRepWDAt h (nzOfInt (num p)) (nzOfInt (num p'))

-- ===== the inverse on ℚ =====
def invRepWDCls : (p p' : El Rat)
  (h : Prf (RatR p p'))
  → class (invRep p) ≡ class (invRep p') ∈ El Q
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.RatR.unfold) ≔
  λp. λp'. λh. clsEqOfRel _ _ (invRepWD h)

def qInv : El Q → El Q
  using (integer.Int.unfold,
    invRepWDCls,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold) ≔
  λu. quot-elim (p. class (invRep p)) u

def qInvCls : (p : El Rat) → qInv (qcls p) ≡ qcls (invRep p)
  using (integer.Int.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rationalAlgInv.invRep.eq,
    rationalAlgInv.qInv.eq,
    rationalQ.Q.unfold,
    rationalQ.qcls.eq) ≔
  λp. ⋆

-- junk at zero, by construction
def qInvZero : qInv qZero ≡ qZero
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalAlgInv.invRep.eq,
    rationalAlgInv.invRepAt.eq,
    rationalAlgInv.qInv.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalQ.Q.unfold,
    rationalQ.dInt.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ===== correctness =====
-- at a representative with a non-zero numerator: p · (D/e) is
-- (n·D)/(d·e), and cross-multiplying against 1/1 leaves n·D ≡ D·n
def invRepRel : {p : El Rat}
  {e : El NZ}
  (he : Prf (nzToInt e ≡ num p))
  → num
    (ratMul p (mkRat (dInt p) e)) * dInt ratOne ≡ num ratOne * dInt (ratMul p (mkRat (dInt p) e))
  using (integer.Int.unfold,
    integer.intOne.eq,
    integerMul.*.eq,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalQ.dInt.eq,
    rationalQ.ratMul.eq) ≔
  λp. λe. λhe. trans
    _
    _
    _
    (intMulOneR (num p * dInt p))
    (trans
      _
      _
      _
      (trans _ _ _ (intMulComm (num p) (dInt p)) (mulCongR (dInt p) _ _ (sym _ _ he)))
      (trans
        (dInt p * nzToInt e)
        (dInt (ratMul p (mkRat (dInt p) e)))
        (num ratOne * dInt (ratMul p (mkRat (dInt p) e)))
        (sym _ _ (nzToIntMul (den p) e))
        (sym _ _ (intMulOneL (dInt (ratMul p (mkRat (dInt p) e)))))))

def invRepCorrectAt : {p : El Rat}
  (hnz : Prf (¬ (num p ≡ intZero)))
  (v : ((e : El NZ) ⨯ Prf (nzToInt e ≡ num p)) ⊎ Prf (num p ≡ intZero))
  → class (ratMul p (invRepAt _ v)) ≡ qOne
  using (intMulZeroR,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intOne.eq,
    integerMul.*.eq,
    prop.¬.unfold,
    prop.⊃.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMulOneR,
    rational.ratOfInt.eq,
    rational.ratOne.eq,
    rationalAlgInv.invRepAt.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.eq,
    rationalQ.dInt.eq,
    rationalQ.qOne.eq,
    rationalQ.qcls.eq,
    rationalQ.ratMul.eq) ≔
  λp. λhnz. λv. ⊎-elim
    (ex. clsEqOfRel (ratMul p (mkRat (dInt p) (ex .π₁))) ratOne (invRepRel (ex .π₂)))
    (ex. absurdP _ (notApply _ hnz ex))
    v

def qMulInvR : {u : El Q} (h : Prf (¬ (u ≡ qZero))) → u * qInv u ≡ qOne
  using (eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    integer.Int.unfold,
    integerMul.*.eq,
    pi.eta,
    prop.¬.unfold,
    prop.⊃.unfold,
    rational.NZ.unfold,
    rational.Rat.unfold,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.ratZero.eq,
    rationalAlgInv.invRep.eq,
    rationalAlgInv.invRepAt.eq,
    rationalAlgInv.qInv.eq,
    rationalInv.intCanonProdZero.eq,
    rationalQ.Q.unfold,
    rationalQ.RatR.unfold,
    rationalQ.dInt.eq,
    rationalQ.*.eq,
    rationalQ.ratMul.eq) ≔
  λu. quot-elim (p. λh. invRepCorrectAt (numNonZero h) (nzOfInt (num p))) u

-- ===== the non-erased existence statement =====
--
-- a Σ-TYPE, not a squash: the first component is the inverse itself
def qInvExistsD : (u : El Q) (h : Prf (¬ (u ≡ qZero))) → (v : El Q) ⨯ Prf (u * v ≡ qOne) ≔
  λu. λh. qInv u, qMulInvR h

-- and it computes: (⅓)⁻¹ = 3
def qInvThird : qInv (qcls third) ≡ qcls (mkRat (class (3, Z)) (nzPos Z))
  using (eqInt.classNormPairEq.eq,
    eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    equality.sym.eq,
    equality.trans.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    intNonZero.nzOfPairD.eq,
    integer.Int.eq,
    integer.Int.unfold,
    integer.intOne.eq,
    integer.intZero.eq,
    integerMul.classPairEta.eq,
    integerNormalize.normPair.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rational.third.eq,
    rationalAlgInv.invRep.eq,
    rationalAlgInv.invRepAt.eq,
    rationalAlgInv.qInv.eq,
    rationalInv.intCanonProdZero.eq,
    rationalInv.normProdZero.eq,
    rationalQ.Q.unfold,
    rationalQ.dInt.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- ===== the inverse type is a proposition =====
--
-- Inverses are unique, so ((v : El Q) ⨯ Prf (qMul u v ≡ qOne)) has at
-- most one element: it is an h-prop, even though it is not a Prf.
-- (See docs/ProvingFeedback.md A-5 on what an eliminator into such
-- types would and would not buy.)
def qInvUniqueVal : (u : El Q)
  {v v' : El Q}
  (h : Prf (u * v ≡ qOne))
  (h' : Prf (u * v' ≡ qOne))
  → v ≡ v' ≔
  λu. λv. λv'. λh. λh'. trans
    _
    _
    _
    (sym _ _ (qMulOneR v))
    (trans
      _
      _
      _
      (cong (λx. Q) (λx. v * x) (sym _ _ h'))
      (trans
        _
        _
        _
        (sym _ _ (qMulAssoc v u v'))
        (trans
          _
          _
          _
          (cong (λx. Q) (λx. x * v') (qMulComm v u))
          (trans _ _ _ (cong (λx. Q) (λx. x * v') h) (qMulOneL v')))))

-- packaging: with the two values equal (and the two proofs equal by
-- proof irrelevance) the pairs are equal. Note trans/sym/cong are
-- 𝕌-INDEXED, so none of them apply at this Σ — it carries a Prf and is
-- therefore not a code. Everything here has to be a bare ⋆.
-- Packaging it as "the inverse type is an h-prop" runs into the fact
-- that equality.nova's trans/sym/cong are 𝕌-INDEXED: this Σ carries a
-- Prf, so it is not a code and none of them apply. What is available
-- without them is the pair-congruence form — no Σ-η needed, since both
-- sides are literal pairs.
def invPairCong : {u a a' : El Q}
  {b : Prf (u * a ≡ qOne)}
  {b' : Prf (u * a' ≡ qOne)}
  (h : Prf (a ≡ a'))
  → (a, b) ≡ (a', b') ∈ (v : El Q) ⨯ Prf (u * v ≡ qOne)
  using (hyp.rw, rationalQ.Q.unfold, sigma.eta) ≔
  λu. λa. λa'. λb. λb'. λh. ⋆

-- so any two inverse-witnesses are equal, given as pairs
def qInvWitnessUnique : (u a a' : El Q)
  (b : Prf (u * a ≡ qOne))
  (b' : Prf (u * a' ≡ qOne))
  → (a, b) ≡ (a', b') ∈ (v : El Q) ⨯ Prf (u * v ≡ qOne) ≔
  λu. λa. λa'. λb. λb'. invPairCong (qInvUniqueVal _ b b')
