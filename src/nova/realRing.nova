-- THE RING LAWS for ℝ, on top of realMul.nova's product.
--
-- The two unit laws split cleanly. `u · 0 = 0` is POINTWISE: whatever
-- depth the product samples at, every value is x·0 = 0, so the two
-- sequences are literally equal and rseqEq closes it. `u · 1 = u` is
-- not pointwise — the product still samples at depth φ m ≥ m, so it
-- is p DEEPENED, and a deepening is only REq to the original. That is
-- the one estimate this half of the file needs, and it comes down to
--
--   1/(φ m + 1) ≤ 1/(m + 1)   whenever   φ m = mulIdx c m
--
-- which realMul.nova already proved as an EQUATION: the factor S c
-- turns 1/(φ m + 1) into 1/(m + 1) exactly (qMulInvIdx). Multiplying a
-- nonnegative by S c ≥ 1 only grows it, so the inequality follows
-- without any new arithmetic on fractions.
-- ===== the two constant representatives =====

import nat (+, *)
import rationalQ (Q, +, *, qNeg, qZero, qOne, qAddComm, qAddAssoc, qMulComm, qMulAssoc, qMulZeroR, qMulOneR, qMulOneL, qDistribL, qDistribR)
import rationalOrder (≤, leQPlusMono, leQPlusMonoL, leQTrans, qSubSplit, qPairSwap, qNegAdd)
import ratBound (Bnd, bndAdd, bndEq, bndEqB, bndWeaken, bndVia, leQAdd, leQSelfAdd, leQSelfAddL)
import ratAbs (bndMul, leQZeroMul)
import ratNat (qOfNat, qOfNatAdd, qOfNatMul, qOfNatOne, qOfNatSuc, qMulSucNat)
import ratCeil (leQZeroNat)
import ratArch (bndOfArch)
import ratHalf (dbl, leQZeroInvNat, leQInvDbl)
import real (qInvNat, rBound, leQZeroBound, Regular, RSeq, REq, Real, constReg, realOfQ, realZero, realOne)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, realEqOfREq, realEqOfPointwise, realNeg)
import realSeq (rseqEq, realEqOfSeqEq)
import realMul (mulIdx, mulPred, mulSeq, rMul, qMulInvIdx, qRearr5, bndMulSub, qMulSumBound, bndMulSubQ, *, realMulCls, realMulComm)
import realAdd (rAdd, +, realAddCls, realAddComm, realAddNegR)
import realGroup (realAddGroup, realNegUnique)
import ring (IsCommRing)
import id (eqToId)
import realBound (seqBound, bndSeqBound, seqBoundPos)
import equality (trans, sym, cong, transport)

def rZero : El RSeq using (real.RSeq.unfold) ≔ (λn. qZero), constReg

def rOne : El RSeq using (real.RSeq.unfold) ≔ (λn. qOne), constReg

-- ===== u · 0 = 0, pointwise =====
def rMulZeroR : {p : El RSeq} → rMul p rZero ≡ rZero
  using (rZero.eq, realMul.mulSeq.eq, realMul.rMul.eq, realNeg.seqOf.eq) ≔
  λp. rseqEq (λn. qMulZeroR (seqOf p (mulIdx (mulPred p rZero) n)))

def realMulZeroR : {u : El Real} → u * realZero ≡ realZero
  using (rZero.eq, real.Real.unfold, real.realOfQ.eq, real.realZero.eq) ≔
  λu. quot-elim
    (p. trans
      Real
      (class p * realZero)
      (class (rMul p rZero))
      realZero
      (realMulCls rZero)
      (cong RSeq (λw. Real) (λw. class w) (rMul p rZero) rZero rMulZeroR))
    u

def realMulZeroL : {u : El Real} → realZero * u ≡ realZero ≔
  λu. trans Real (realZero * u) (u * realZero) realZero (realMulComm realZero u) realMulZeroR

-- ===== the deepening inequality =====
-- multiplying a nonnegative by S c ≥ 1 only grows it
def leQSelfMulNat : {c : ℕ} {x : El Q} → El (qZero ≤ x) → El (x ≤ qOfNat (S c) * x) ≔
  λc. λx. λhx. transport
    Q
    (λw. x ≤ w)
    (qOfNat c * x + x)
    (qOfNat (S c) * x)
    (sym Q (qOfNat (S c) * x) (qOfNat c * x + x) (qMulSucNat c x))
    (leQSelfAddL (leQZeroMul (leQZeroNat c) hx))

-- ...so sampling deeper gives a smaller harmonic bound. The EQUATION
-- qMulInvIdx is what makes this free: the factor is exact, so the
-- inequality is just "times S c is not smaller".
def leQInvIdx : (c m : ℕ) → El (qInvNat (mulIdx c m) ≤ qInvNat m) ≔
  λc. λm. transport
    Q
    (λw. qInvNat (mulIdx c m) ≤ w)
    (qOfNat (S c) * qInvNat (mulIdx c m))
    (qInvNat m)
    qMulInvIdx
    (leQSelfMulNat (leQZeroInvNat (mulIdx c m)))

def leQRBoundIdx : (c m : ℕ) → El (rBound (mulIdx c m) m ≤ rBound m m) using (real.rBound.eq) ≔
  λc. λm. leQPlusMono (qInvNat m) (leQInvIdx c m)

-- ===== u · 1 = u =====
-- the product's value at the deep index IS the original's, since the
-- second factor is 1 at every index
def mulOneAt : (x y : El Q) → x + qNeg y ≡ x * qOne + qNeg y ≔
  λx. λy. cong Q (λw. Q) (λw. w + qNeg y) x (x * qOne) (sym Q (x * qOne) x (qMulOneR x))

def rMulOneWD : (p : El RSeq) → Prf (REq (rMul p rOne) p)
  using (rOne.eq, realMul.mulSeq.eq, realMul.rMul.eq, realNeg.seqOf.eq) ≔
  λp. reqOf
    (rMul p rOne)
    p
    (λn. bndWeaken
      (rBound (mulIdx (mulPred p rOne) n) n)
      (rBound n n)
      (mulSeq p rOne n + qNeg (seqOf p n))
      (leQRBoundIdx (mulPred p rOne) n)
      (bndEq
        (seqOf p (mulIdx (mulPred p rOne) n) + qNeg (seqOf p n))
        (mulSeq p rOne n + qNeg (seqOf p n))
        (mulOneAt (seqOf p (mulIdx (mulPred p rOne) n)) (seqOf p n))
        (regBnd (seqOf p) (regOf p) (mulIdx (mulPred p rOne) n) n)))

def realMulOneR : (u : El Real) → u * realOne ≡ u
  using (rOne.eq, real.Real.unfold, real.realOfQ.eq, real.realOne.eq) ≔
  λu. quot-elim
    (p. trans
      Real
      (class p * realOne)
      (class (rMul p rOne))
      (class p)
      (realMulCls rOne)
      (realEqOfREq (rMul p rOne) p (rMulOneWD p)))
    u

def realMulOneL : (u : El Real) → realOne * u ≡ u ≔
  λu. trans Real (realOne * u) (u * realOne) u (realMulComm realOne u) (realMulOneR u)

-- ===== the closeness criterion =====
--
-- THE tool for the remaining laws. Two representatives name the same
-- real as soon as they are within K·rBound n n at every index — for
-- ANY constant K, not just K = 1. That is much weaker than REq itself
-- and it is what a ring law can actually deliver: the two sides sample
-- at different depths, so the honest estimate carries a constant built
-- from the factors' bounds.
--
-- The slack is removed once, here, instead of once per law. Chaining
-- through a deep index N gives
--
--   |u_n − v_n| ≤ rBound n N + K·rBound N N + rBound N n
--               = rBound n n + (2K + 2)/(N + 1)
--
-- and (2K + 2)/(N + 1) is EXACTLY 1/(l + 1) at N = mulIdx (S (K+K)) l,
-- because the factor S (S (K+K)) is 2K + 2 and qMulInvIdx makes it exact.
-- Written S (K + K) rather than dbl K on purpose: citing dbl.eq to see
-- through the abbreviation unfolds the goal past the point where
-- qMulSucNat still matches (the poison rule).
-- No inequality between fractions is needed anywhere — only that one
-- equation.
def kkY : (K : ℕ) (y : El Q) → qOfNat (K + K) * y ≡ qOfNat K * (y + y) ≔
  λK. λy. qOfNat (K + K) * y
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. v * y)
        (qOfNat (K + K))
        (qOfNat K + qOfNat K)
        (sym Q (qOfNat K + qOfNat K) (qOfNat (K + K)) (qOfNatAdd K K)) ⟩ (qOfNat K + qOfNat K) * y
      ≡⟨ qDistribR y (qOfNat K) (qOfNat K) ⟩ qOfNat K * y + qOfNat K * y
      ≡⟨ sym
        Q
        (qOfNat K * (y + y))
        (qOfNat K * y + qOfNat K * y)
        (qDistribL (qOfNat K) y y) ⟩ qOfNat K * (y + y)

-- y + (K·(y + y) + y) is (2K + 2)·y
def twoKTwo : (K : ℕ) (y : El Q) → y + (qOfNat K * (y + y) + y) ≡ qOfNat (S (S (K + K))) * y ≔
  λK. λy. y + (qOfNat K * (y + y) + y)
      ≡⟨ qAddComm y (qOfNat K * (y + y) + y) ⟩ qOfNat K * (y + y) + y + y
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. v + y + y)
        (qOfNat K * (y + y))
        (qOfNat (K + K) * y)
        (sym Q (qOfNat (K + K) * y) (qOfNat K * (y + y)) (kkY K y)) ⟩ qOfNat (K + K) * y + y + y
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. v + y)
        (qOfNat (K + K) * y + y)
        (qOfNat (S (K + K)) * y)
        (sym
          Q
          (qOfNat (S (K + K)) * y)
          (qOfNat (K + K) * y + y)
          (qMulSucNat (K + K) y)) ⟩ qOfNat (S (K + K)) * y + y
      ≡⟨ sym
        Q
        (qOfNat (S (S (K + K))) * y)
        (qOfNat (S (K + K)) * y + y)
        (qMulSucNat (S (K + K)) y) ⟩ qOfNat (S (S (K + K))) * y

-- (x + y) + (K·(y + y) + (y + x)) ≡ (x + x) + w, given w = (2K + 2)·y.
-- The factor equation is an ARGUMENT: at the call site w is 1/(l + 1)
-- and the equation is qMulInvIdx, so the deep index never has to be
-- looked at (B-16).
def closeBoundEq : (x : El Q)
  {y : El Q}
  {K : ℕ}
  {w : El Q}
  → (qOfNat (S (S (K + K))) * y ≡ w) → x + y + (qOfNat K * (y + y) + (y + x)) ≡ x + x + w ≔
  λx. λy. λK. λw. λhw. x + y + (qOfNat K * (y + y) + (y + x))
      ≡⟨ qRearr5 x y (qOfNat K * (y + y)) y ⟩ x + x + (y + (qOfNat K * (y + y) + y))
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. x + x + v)
        (y + (qOfNat K * (y + y) + y))
        (qOfNat (S (S (K + K))) * y)
        (twoKTwo K y) ⟩ x + x + qOfNat (S (S (K + K))) * y
      ≡⟨ cong Q (λv. Q) (λv. x + x + v) (qOfNat (S (S (K + K))) * y) w hw ⟩ x + x + w

-- the three-leg chain, abstract in the sequences and the deep index
def closeStepGen : (f g : El (ℕ → Q))
  (K n N : ℕ)
  (w : El Q)
  → El (Bnd
    (rBound n N)
    (f
      n
      + qNeg
        (f
          N)))
    → El (Bnd
      (qOfNat K * rBound N N)
      (f
        N
        + qNeg
          (g
            N)))
      → El (Bnd
        (rBound N n)
        (g
          N
          + qNeg
            (g
              n)))
        → (qOfNat (S (S (K + K))) * qInvNat N ≡ w) → El (Bnd (rBound n n + w) (f n + qNeg (g n)))
  using (real.rBound.eq) ≔
  λf. λg. λK. λn. λN. λw. λh1. λh2. λh3. λhw. bndEqB
    (rBound n N + (qOfNat K * rBound N N + rBound N n))
    (rBound n n + w)
    (f n + qNeg (g n))
    (closeBoundEq (qInvNat n) hw)
    (bndVia
      (rBound n N)
      (qOfNat K * rBound N N + rBound N n)
      (f n)
      (f N)
      (g n)
      h1
      (bndVia (qOfNat K * rBound N N) (rBound N n) (f N) (g N) (g n) h2 h3))

def reqOfClose : {u v : El RSeq}
  (K : ℕ)
  → ((n : ℕ) → El (Bnd (qOfNat K * rBound n n) (seqOf u n + qNeg (seqOf v n)))) → Prf (REq u v) ≔
  λu. λv. λK. λh. reqOf
    u
    v
    (λn. bndOfArch
      (seqOf u n + qNeg (seqOf v n))
      (λl. closeStepGen
        (seqOf u)
        (seqOf v)
        K
        n
        (mulIdx (S (K + K)) l)
        (qInvNat l)
        (regBnd (seqOf u) (regOf u) n (mulIdx (S (K + K)) l))
        (h (mulIdx (S (K + K)) l))
        (regBnd (seqOf v) (regOf v) (mulIdx (S (K + K)) l) n)
        qMulInvIdx))

-- ===== distributivity =====
--
-- With reqOfClose the law is a POINTWISE estimate and nothing more.
-- At index m the two sides read
--
--   left   =  p_i · (q_{2i} + r_{2i})
--   right  =  p_j · q_j  +  p_k · r_k
--
-- with i, 2i, j, k four different depths, all of them at least m.
-- Split the difference into two product-differences, bound each by
-- bndMulSub at the COMMON modulus rBound m m, and add. The constant
-- that comes out is (A + B) + (A + C), which is exactly what
-- reqOfClose is willing to absorb.
def qSubPair : (a b c d : El Q) → a + qNeg c + (b + qNeg d) ≡ a + b + qNeg (c + d) ≔
  λa. λb. λc. λd. a + qNeg c + (b + qNeg d)
      ≡⟨ qPairSwap a (qNeg c) b (qNeg d) ⟩ a + b + (qNeg c + qNeg d)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. a + b + v)
        (qNeg c + qNeg d)
        (qNeg (c + d))
        (sym Q (qNeg (c + d)) (qNeg c + qNeg d) (qNegAdd c d)) ⟩ a + b + qNeg (c + d)

-- two samples of one regular sequence, both at least as deep as m,
-- differ by at most rBound m m
def bndDeep : (f : El (ℕ → Q))
  → ((a b : ℕ)
    → El (Bnd
      (rBound a b)
      (f
        a
        + qNeg
          (f
            b))))
    → (a b m : ℕ)
      → El (qInvNat
        a ≤ qInvNat m) → El (qInvNat b ≤ qInvNat m) → El (Bnd (rBound m m) (f a + qNeg (f b)))
  using (real.rBound.eq) ≔
  λf. λhf. λa. λb. λm. λha. λhb. bndWeaken
    (rBound a b)
    (rBound m m)
    (f a + qNeg (f b))
    (leQAdd (qInvNat a) (qInvNat m) (qInvNat b) (qInvNat m) ha hb)
    (hf a b)

def distribStepGen : (f g h : El (ℕ → Q))
  (A B C m i t j k : ℕ)
  → ((a : ℕ)
    → El (Bnd
      (qOfNat A)
      (f
        a)))
    → ((a : ℕ)
      → El (Bnd
        (qOfNat B)
        (g
          a)))
      → ((a : ℕ)
        → El (Bnd
          (qOfNat C)
          (h
            a)))
        → ((a b : ℕ)
          → El (Bnd
            (rBound a b)
            (f
              a
              + qNeg
                (f
                  b))))
          → ((a b : ℕ)
            → El (Bnd
              (rBound a b)
              (g
                a
                + qNeg
                  (g
                    b))))
            → ((a b : ℕ)
              → El (Bnd
                (rBound a b)
                (h
                  a
                  + qNeg
                    (h
                      b))))
              → El (qInvNat
                i
                ≤ qInvNat
                  m)
                → El (qInvNat
                  t
                  ≤ qInvNat
                    m)
                  → El (qInvNat
                    j
                    ≤ qInvNat
                      m)
                    → El (qInvNat
                      k
                      ≤ qInvNat
                        m)
                      → El (qZero
                        ≤ qOfNat
                          A)
                        → El (qZero
                          ≤ qOfNat
                            B)
                          → El (qZero
                            ≤ qOfNat
                              C)
                            → El (Bnd
                              (qOfNat (A + B + (A + C)) * rBound m m)
                              (f i * (g t + h t) + qNeg (f j * g j + f k * h k))) ≔
  λf. λg. λh. λA. λB. λC. λm. λi. λt. λj. λk. λhfB. λhgB. λhhB. λhfR. λhgR. λhhR. λdi. λdt. λdj. λdk. λhA. λhB. λhC. bndEq
    (f i * g t + qNeg (f j * g j) + (f i * h t + qNeg (f k * h k)))
    (f i * (g t + h t) + qNeg (f j * g j + f k * h k))
    (f i * g t + qNeg (f j * g j) + (f i * h t + qNeg (f k * h k))
        ≡⟨ qSubPair
          (f i * g t)
          (f i * h t)
          (f j * g j)
          (f k * h k) ⟩ f i * g t + f i * h t + qNeg (f j * g j + f k * h k)
        ≡⟨ cong
          Q
          (λv. Q)
          (λv. v + qNeg (f j * g j + f k * h k))
          (f i * g t + f i * h t)
          (f i * (g t + h t))
          (sym
            Q
            (f i * (g t + h t))
            (f i * g t + f i * h t)
            (qDistribL (f i) (g t) (h t))) ⟩ f i * (g t + h t) + qNeg (f j * g j + f k * h k))
    (bndEqB
      (qOfNat (A + B) * rBound m m + qOfNat (A + C) * rBound m m)
      (qOfNat (A + B + (A + C)) * rBound m m)
      (f i * g t + qNeg (f j * g j) + (f i * h t + qNeg (f k * h k)))
      (qMulSumBound (A + B) (A + C) (rBound m m))
      (bndAdd
        (bndMulSub
          (hfB i)
          (hgB j)
          (bndDeep g hgR t j m dt dj)
          (bndDeep f hfR i j m di dj)
          hA
          hB
          (leQZeroBound m m))
        (bndMulSub
          (hfB i)
          (hhB k)
          (bndDeep h hhR t k m dt dk)
          (bndDeep f hfR i k m di dk)
          hA
          hC
          (leQZeroBound m m))))

def rDistrib : (p q r : El RSeq) → Prf (REq (rMul p (rAdd q r)) (rAdd (rMul p q) (rMul p r)))
  using (realAdd.addSeq.eq, realAdd.rAdd.eq, realMul.mulSeq.eq, realMul.rMul.eq, realNeg.seqOf.eq) ≔
  λp. λq. λr. reqOfClose
    (seqBound p + seqBound q + (seqBound p + seqBound r))
    (λm. distribStepGen
      (seqOf p)
      (seqOf q)
      (seqOf r)
      (seqBound p)
      (seqBound q)
      (seqBound r)
      m
      (mulIdx (mulPred p (rAdd q r)) m)
      (dbl (mulIdx (mulPred p (rAdd q r)) m))
      (mulIdx (mulPred p q) (dbl m))
      (mulIdx (mulPred p r) (dbl m))
      (bndSeqBound p)
      (bndSeqBound q)
      (bndSeqBound r)
      (regBnd (seqOf p) (regOf p))
      (regBnd (seqOf q) (regOf q))
      (regBnd (seqOf r) (regOf r))
      (leQInvIdx (mulPred p (rAdd q r)) m)
      (leQTrans
        (qInvNat (dbl (mulIdx (mulPred p (rAdd q r)) m)))
        (qInvNat (mulIdx (mulPred p (rAdd q r)) m))
        (qInvNat m)
        (leQInvDbl (mulIdx (mulPred p (rAdd q r)) m))
        (leQInvIdx (mulPred p (rAdd q r)) m))
      (leQTrans
        (qInvNat (mulIdx (mulPred p q) (dbl m)))
        (qInvNat (dbl m))
        (qInvNat m)
        (leQInvIdx (mulPred p q) (dbl m))
        (leQInvDbl m))
      (leQTrans
        (qInvNat (mulIdx (mulPred p r) (dbl m)))
        (qInvNat (dbl m))
        (qInvNat m)
        (leQInvIdx (mulPred p r) (dbl m))
        (leQInvDbl m))
      seqBoundPos
      seqBoundPos
      seqBoundPos)

def realDistribL : (u v w : El Real) → u * (v + w) ≡ u * v + u * w
  using (real.Real.unfold, realAdd.+.eq, realMul.*.eq) ≔
  λu. λv. λw. quot-elim
    (p. quot-elim
      (q. quot-elim
        (r. realEqOfREq (rMul p (rAdd q r)) (rAdd (rMul p q) (rMul p r)) (rDistrib p q r))
        w)
      v)
    u

-- ===== associativity =====
--
-- At index m the two sides read
--
--   left   =  (p_a · q_a) · r_i
--   right  =  p_j · (q_b · r_b)
--
-- with a nested under i and b nested under j, so FOUR depths again,
-- all at least m. Reassociate the right side and it is one outer
-- product-difference whose left factor is itself a product:
--
--   |p_a q_a| ≤ A·B          (a product of ceilings, not a sum)
--   |p_a q_a − p_j q_b| ≤ A·rBound m m + B·rBound m m
--
-- so the outer estimate needs the two moduli to differ — bndMulSubQ.
-- The constant that falls out is A·B + C·(A + B), a natural, which is
-- all reqOfClose asks for.
def leQZeroAdd : {u v : El Q} → El (qZero ≤ u) → El (qZero ≤ v) → El (qZero ≤ u + v) ≔
  λu. λv. λhu. λhv. leQTrans qZero u (u + v) hu (leQSelfAdd u hv)

-- α·β + γ·(α + β), as a rational, is the natural A·B + C·(A + B)
def kappaEq : (A B C : ℕ)
  → qOfNat A * qOfNat B + qOfNat C * (qOfNat A + qOfNat B) ≡ qOfNat (A * B + C * (A + B)) ≔
  λA. λB. λC. qOfNat A * qOfNat B + qOfNat C * (qOfNat A + qOfNat B)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. qOfNat A * qOfNat B + qOfNat C * v)
        (qOfNat A + qOfNat B)
        (qOfNat (A + B))
        (qOfNatAdd A B) ⟩ qOfNat A * qOfNat B + qOfNat C * qOfNat (A + B)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. v + qOfNat C * qOfNat (A + B))
        (qOfNat A * qOfNat B)
        (qOfNat (A * B))
        (qOfNatMul A B) ⟩ qOfNat (A * B) + qOfNat C * qOfNat (A + B)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. qOfNat (A * B) + v)
        (qOfNat C * qOfNat (A + B))
        (qOfNat (C * (A + B)))
        (qOfNatMul C (A + B)) ⟩ qOfNat (A * B) + qOfNat (C * (A + B))
      ≡⟨ qOfNatAdd (A * B) (C * (A + B)) ⟩ qOfNat (A * B + C * (A + B))

-- (αβ)d + γ(αd + βd) ≡ κ·d, with κ = αβ + γ(α + β) given as an
-- argument (the factor, parameterised — B-16 again)
def assocBoundEq : {al be ga : El Q}
  (d : El Q)
  {kp : El Q}
  → (al * be + ga * (al + be) ≡ kp) → al * be * d + ga * (al * d + be * d) ≡ kp * d ≔
  λal. λbe. λga. λd. λkp. λhk. al * be * d + ga * (al * d + be * d)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. al * be * d + ga * v)
        (al * d + be * d)
        ((al + be) * d)
        (sym
          Q
          ((al + be) * d)
          (al * d + be * d)
          (qDistribR d al be)) ⟩ al * be * d + ga * ((al + be) * d)
      ≡⟨ cong
        Q
        (λv. Q)
        (λv. al * be * d + v)
        (ga * ((al + be) * d))
        (ga * (al + be) * d)
        (sym
          Q
          (ga * (al + be) * d)
          (ga * ((al + be) * d))
          (qMulAssoc ga (al + be) d)) ⟩ al * be * d + ga * (al + be) * d
      ≡⟨ sym
        Q
        ((al * be + ga * (al + be)) * d)
        (al * be * d + ga * (al + be) * d)
        (qDistribR d (al * be) (ga * (al + be))) ⟩ (al * be + ga * (al + be)) * d
      ≡⟨ cong Q (λv. Q) (λv. v * d) (al * be + ga * (al + be)) kp hk ⟩ kp * d

def assocStepGen : (f g h : El (ℕ → Q))
  (A B C m a i j b : ℕ)
  → ((z : ℕ)
    → El (Bnd
      (qOfNat A)
      (f
        z)))
    → ((z : ℕ)
      → El (Bnd
        (qOfNat B)
        (g
          z)))
      → ((z : ℕ)
        → El (Bnd
          (qOfNat C)
          (h
            z)))
        → ((z w : ℕ)
          → El (Bnd
            (rBound z w)
            (f
              z
              + qNeg
                (f
                  w))))
          → ((z w : ℕ)
            → El (Bnd
              (rBound z w)
              (g
                z
                + qNeg
                  (g
                    w))))
            → ((z w : ℕ)
              → El (Bnd
                (rBound z w)
                (h
                  z
                  + qNeg
                    (h
                      w))))
              → El (qInvNat
                a
                ≤ qInvNat
                  m)
                → El (qInvNat
                  i
                  ≤ qInvNat
                    m)
                  → El (qInvNat
                    j
                    ≤ qInvNat
                      m)
                    → El (qInvNat
                      b
                      ≤ qInvNat
                        m)
                      → El (qZero
                        ≤ qOfNat
                          A)
                        → El (qZero
                          ≤ qOfNat
                            B)
                          → El (qZero
                            ≤ qOfNat
                              C)
                            → El (Bnd
                              (qOfNat (A * B + C * (A + B)) * rBound m m)
                              (f a * g a * h i + qNeg (f j * (g b * h b)))) ≔
  λf. λg. λh. λA. λB. λC. λm. λa. λi. λj. λb. λhfB. λhgB. λhhB. λhfR. λhgR. λhhR. λda. λdi. λdj. λdb. λhA. λhB. λhC. bndEq
    (f a * g a * h i + qNeg (f j * g b * h b))
    (f a * g a * h i + qNeg (f j * (g b * h b)))
    (cong
      Q
      (λv. Q)
      (λv. f a * g a * h i + qNeg v)
      (f j * g b * h b)
      (f j * (g b * h b))
      (qMulAssoc (f j) (g b) (h b)))
    (bndEqB
      (qOfNat
        A * qOfNat B * rBound m m + qOfNat C * (qOfNat A * rBound m m + qOfNat B * rBound m m))
      (qOfNat (A * B + C * (A + B)) * rBound m m)
      (f a * g a * h i + qNeg (f j * g b * h b))
      (assocBoundEq (rBound m m) (kappaEq A B C))
      (bndMulSubQ
        (bndMul hA hB (hfB a) (hgB a))
        (hhB b)
        (bndDeep h hhR i b m di db)
        (bndMulSubQ
          (hfB a)
          (hgB b)
          (bndDeep g hgR a b m da db)
          (bndDeep f hfR a j m da dj)
          hA
          hB
          (leQZeroBound m m)
          (leQZeroBound m m))
        (leQZeroMul hA hB)
        hC
        (leQZeroBound m m)
        (leQZeroAdd (leQZeroMul hA (leQZeroBound m m)) (leQZeroMul hB (leQZeroBound m m)))))

def rAssoc : (p q r : El RSeq) → Prf (REq (rMul (rMul p q) r) (rMul p (rMul q r)))
  using (realMul.mulSeq.eq, realMul.rMul.eq, realNeg.seqOf.eq) ≔
  λp. λq. λr. reqOfClose
    (seqBound p * seqBound q + seqBound r * (seqBound p + seqBound q))
    (λm. assocStepGen
      (seqOf p)
      (seqOf q)
      (seqOf r)
      (seqBound p)
      (seqBound q)
      (seqBound r)
      m
      (mulIdx (mulPred p q) (mulIdx (mulPred (rMul p q) r) m))
      (mulIdx (mulPred (rMul p q) r) m)
      (mulIdx (mulPred p (rMul q r)) m)
      (mulIdx (mulPred q r) (mulIdx (mulPred p (rMul q r)) m))
      (bndSeqBound p)
      (bndSeqBound q)
      (bndSeqBound r)
      (regBnd (seqOf p) (regOf p))
      (regBnd (seqOf q) (regOf q))
      (regBnd (seqOf r) (regOf r))
      (leQTrans
        (qInvNat (mulIdx (mulPred p q) (mulIdx (mulPred (rMul p q) r) m)))
        (qInvNat (mulIdx (mulPred (rMul p q) r) m))
        (qInvNat m)
        (leQInvIdx (mulPred p q) (mulIdx (mulPred (rMul p q) r) m))
        (leQInvIdx (mulPred (rMul p q) r) m))
      (leQInvIdx (mulPred (rMul p q) r) m)
      (leQInvIdx (mulPred p (rMul q r)) m)
      (leQTrans
        (qInvNat (mulIdx (mulPred q r) (mulIdx (mulPred p (rMul q r)) m)))
        (qInvNat (mulIdx (mulPred p (rMul q r)) m))
        (qInvNat m)
        (leQInvIdx (mulPred q r) (mulIdx (mulPred p (rMul q r)) m))
        (leQInvIdx (mulPred p (rMul q r)) m))
      seqBoundPos
      seqBoundPos
      seqBoundPos)

def realMulAssoc : (u v w : El Real) → u * v * w ≡ u * (v * w)
  using (real.Real.unfold, realMul.*.eq) ≔
  λu. λv. λw. quot-elim
    (p. quot-elim
      (q. quot-elim (r. realEqOfREq (rMul (rMul p q) r) (rMul p (rMul q r)) (rAssoc p q r)) w)
      v)
    u

-- ===== the remaining laws, and the structure =====
-- right distributivity, by commuting into the left one
def realDistribR : (u v w : El Real) → (v + w) * u ≡ v * u + w * u ≔
  λu. λv. λw. trans
    Real
    ((v + w) * u)
    (u * (v + w))
    (v * u + w * u)
    (realMulComm (v + w) u)
    (trans
      Real
      (u * (v + w))
      (u * v + u * w)
      (v * u + w * u)
      (realDistribL u v w)
      (trans
        Real
        (u * v + u * w)
        (v * u + u * w)
        (v * u + w * u)
        (cong Real (λz. Real) (λz. z + u * w) (u * v) (v * u) (realMulComm u v))
        (cong Real (λz. Real) (λz. v * u + z) (u * w) (w * u) (realMulComm u w))))

-- (−u)·v = −(u·v), a RING consequence: (−u)·v is an additive inverse
-- of u·v, and inverses are unique. No estimate, no representatives.
def realMulNeg : {u v : El Real} → realNeg u * v ≡ realNeg (u * v) ≔
  λu. λv. realNegUnique
    (u * v)
    (realNeg u * v)
    (trans
      Real
      (u * v + realNeg u * v)
      ((u + realNeg u) * v)
      realZero
      (sym Real ((u + realNeg u) * v) (u * v + realNeg u * v) (realDistribR v u (realNeg u)))
      (trans
        Real
        ((u + realNeg u) * v)
        (realZero * v)
        realZero
        (cong Real (λz. Real) (λz. z * v) (u + realNeg u) realZero (realAddNegR u))
        realMulZeroL))

def realMulNegR : (u v : El Real) → u * realNeg v ≡ realNeg (u * v) ≔
  λu. λv. trans
    Real
    (u * realNeg v)
    (realNeg v * u)
    (realNeg (u * v))
    (realMulComm u (realNeg v))
    (trans
      Real
      (realNeg v * u)
      (realNeg (v * u))
      (realNeg (u * v))
      realMulNeg
      (cong Real (λz. Real) (λz. realNeg z) (v * u) (u * v) (realMulComm v u)))

-- ...so ℝ is a commutative ring, and the laws above are exactly its
-- components
def realCommRing : El (IsCommRing Real) using (realGroup.realAddGroup.eq, ring.IsCommRing.unfold) ≔
  realAddGroup,
    (*),
      realOne,
        (λx. λy. λz. eqToId
          (x * y * z)
          (x * (y * z))
          (realMulAssoc
            x
            y
            z)),
          (λx. λy. eqToId
            (x * y)
            (y * x)
            (realMulComm
              x
              y)),
            (λx. eqToId
              (x * realOne)
              x
              (realMulOneR
                x)),
              (λx. λy. eqToId
                (x + y)
                (y + x)
                (realAddComm
                  x
                  y)), λx. λy. λz. eqToId (x * (y + z)) (x * y + x * z) (realDistribL x y z)
