-- MAX and MIN on ℚ, from the same sign decision `qAbs` uses. Both are
-- 1-Lipschitz in each argument — `bndMaxSub` — which is exactly what a
-- pointwise definition on regular sequences needs, and is proved from
-- the lattice characterisation (least upper bound / greatest lower
-- bound) with no case analysis beyond the two the definitions make.

import rationalQ (Q, +, qNeg, qZero, qAddComm, qNegNeg)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, sgnQNegFlip, sgnCases, NonNegS, ≤, leQRefl, leQTrans, leQPlusMono, leQAntisym, qSubNeg, qPlusNegCancelR)
import ratBound (Bnd, bndNeg, bndEq, bndSubSym, bndOfBothLe, leQNegFlip, qSubFlip)
import ratAbs (sgnQNegOfNeg, leQSubOfLeAdd)
import ratArch (leQSubShift, leQAddShift)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

def qMax : El Q → El Q → El Q using (rationalQ.Q.unfold) ≔
  λu. λv. ⊎-elim (nn. v) (hn. u) (sgnCases (sgnQ (v + qNeg u)))

-- ===== the lattice characterisation =====
def leQMaxL : (u v : El Q) → El (u ≤ qMax u v)
  using (id.Id.eq,
    ratMax.qMax.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. ⊎-elim (w. El (u ≤ ⊎-elim (nn. v) (hn. u) w))
    (nn. nn)
    (hn. leQRefl _)
    (sgnCases (sgnQ (v + qNeg u)))

-- v < u : the flipped difference is positive, and u − v IS the
-- negation of v − u
def leQMaxR : (u v : El Q) → El (v ≤ qMax u v)
  using (id.Id.eq,
    ratMax.qMax.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. ⊎-elim (w. El (v ≤ ⊎-elim (nn. v) (hn. u) w))
    (nn. leQRefl _)
    (hn. inj₂ (eqToId
      (sgnQ (u + qNeg v))
      _
      (trans
        _
        _
        sPos
        (cong (λw. Sign) (λw. sgnQ w) {u + qNeg v} {qNeg (v + qNeg u)} qSubNeg)
        (sgnQNegOfNeg hn))))
    (sgnCases (sgnQ (v + qNeg u)))

def qMaxLub : {u v w : El Q} → El (u ≤ w) → El (v ≤ w) → El (qMax u v ≤ w)
  using (id.Id.eq,
    ratMax.qMax.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. λw. λh1. λh2. ⊎-elim (t. El (⊎-elim (nn. v) (hn. u) t ≤ w))
    (nn. h2)
    (hn. h1)
    (sgnCases (sgnQ (v + qNeg u)))

-- ===== Lipschitz =====
-- a two-sided bound on a difference is a pair of shifted ≤'s
def leQAddOfBnd : {b u v : El Q} → El (Bnd b (u + qNeg v)) → El (u ≤ v + b)
  using (ratBound.Bnd.unfold, rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λb. λu. λv. λh. leQAddShift _ (h .π₂)

def bndMaxSub : (b a c a' c' : El Q)
  → El (Bnd b (a + qNeg c)) → El (Bnd b (a' + qNeg c')) → El (Bnd b (qMax a a' + qNeg (qMax c c')))
  using (ratBound.Bnd.unfold) ≔
  λb. λa. λc. λa'. λc'. λh1. λh2. bndOfBothLe
    _
    _
    (leQSubShift
      _
      _
      (qMaxLub
        (leQTrans _ _ _ (leQAddOfBnd h1) (leQPlusMono b (leQMaxL c c')))
        (leQTrans _ _ _ (leQAddOfBnd h2) (leQPlusMono b (leQMaxR c c')))))
    (leQSubShift
      _
      _
      (qMaxLub
        (leQTrans _ _ _ (leQAddOfBnd (bndSubSym _ _ _ h1)) (leQPlusMono b (leQMaxL a a')))
        (leQTrans _ _ _ (leQAddOfBnd (bndSubSym _ _ _ h2)) (leQPlusMono b (leQMaxR a a')))))

def qMaxSelf : (u : El Q) → qMax u u ≡ u ≔
  λu. leQAntisym (qMaxLub (leQRefl u) (leQRefl u)) (leQMaxL u u)

def qMaxComm : (u v : El Q) → qMax u v ≡ qMax v u ≔
  λu. λv. leQAntisym (qMaxLub (leQMaxR v u) (leQMaxL v u)) (qMaxLub (leQMaxR u v) (leQMaxL u v))

-- ===== the dual =====
def qMin : El Q → El Q → El Q using (rationalQ.Q.unfold) ≔ λu. λv. qNeg (qMax (qNeg u) (qNeg v))

def leQMinL : (u v : El Q) → El (qMin u v ≤ u)
  using (id.Id.eq,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. transport (λw. qMin u v ≤ w) (qNegNeg u) (leQNegFlip _ _ (leQMaxL (qNeg u) (qNeg v)))

def leQMinR : (u v : El Q) → El (qMin u v ≤ v)
  using (id.Id.eq,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. transport (λw. qMin u v ≤ w) (qNegNeg v) (leQNegFlip _ _ (leQMaxR (qNeg u) (qNeg v)))

def qMinGlb : {u v w : El Q} → El (w ≤ u) → El (w ≤ v) → El (w ≤ qMin u v)
  using (id.Id.eq,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λu. λv. λw. λh1. λh2. transport
    (λt. t ≤ qMin u v)
    (qNegNeg w)
    (leQNegFlip _ _ (qMaxLub (leQNegFlip _ _ h1) (leQNegFlip _ _ h2)))

def qMinComm : (u v : El Q) → qMin u v ≡ qMin v u
  using (ratMax.qMax.eq, ratMax.qMin.eq, rationalQ.Q.unfold, rationalQ.qNeg.eq) ≔
  λu. λv. cong (λw. Q) (λw. qNeg w) (qMaxComm (qNeg u) (qNeg v))

-- (−a) − (−c) ≡ c − a : the difference of negations is reversed
def qNegDiff : (a c : El Q) → qNeg a + qNeg (qNeg c) ≡ c + qNeg a ≔
  λa. λc. trans _ _ _ (cong (λw. Q) (λw. qNeg a + w) (qNegNeg c)) (qAddComm (qNeg a) c)

-- min is 1-Lipschitz because max is: the negations cancel
def bndMinSub : (b a c a' c' : El Q)
  → El (Bnd b (a + qNeg c)) → El (Bnd b (a' + qNeg c')) → El (Bnd b (qMin a a' + qNeg (qMin c c')))
  using (ratBound.Bnd.unfold,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq) ≔
  λb. λa. λc. λa'. λc'. λh1. λh2. bndEq
    (qNeg (qMax (qNeg a) (qNeg a') + qNeg (qMax (qNeg c) (qNeg c'))))
    _
    (trans
      _
      _
      (qNeg (qMax (qNeg a) (qNeg a')) + qNeg (qNeg (qMax (qNeg c) (qNeg c'))))
      (qSubFlip (qMax (qNeg a) (qNeg a')) (qMax (qNeg c) (qNeg c')))
      (sym _ _ (qNegDiff (qMax (qNeg a) (qNeg a')) (qMax (qNeg c) (qNeg c')))))
    (bndNeg
      _
      _
      (bndMaxSub
        _
        _
        _
        _
        _
        (bndEq _ _ (sym _ _ (qNegDiff a c)) (bndSubSym _ _ _ h1))
        (bndEq _ _ (sym _ _ (qNegDiff a' c')) (bndSubSym _ _ _ h2))))

-- a shifted greatest-lower-bound: w ≤ a + r and w ≤ b + r give
-- w ≤ min a b + r. (The max side needs no such lemma — qMaxLub's
-- target is already an upper bound.)
def qMinGlbShift : (a b w r : El Q) → El (w ≤ a + r) → El (w ≤ b + r) → El (w ≤ qMin a b + r)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λa. λb. λw. λr. λh1. λh2. transport
    (λt. t ≤ qMin a b + r)
    (qPlusNegCancelR w r)
    (leQPlusMono r (qMinGlb (leQSubOfLeAdd h1) (leQSubOfLeAdd h2)))
