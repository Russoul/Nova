import rationalQ (Q, qAdd, qNeg, qZero, qAddComm, qNegNeg)
import rationalOrder (Sign, sZero, sPos, sNeg, sgnFlip, sgnQ, sgnQNegFlip, sgnCases,
                      NonNegS, LeQ, leQRefl, leQTrans, leQPlusMono, leQAntisym,
                      qSubNeg, qPlusNegCancelR)
import ratBound (Bnd, bndNeg, bndEq, bndSubSym, bndOfBothLe, leQNegFlip, qSubFlip)
import ratAbs (sgnQNegOfNeg, leQSubOfLeAdd)
import ratArch (leQSubShift, leQAddShift)
import equality (trans, sym, cong, transport)
import id (Id, eqToId, idToEq)

-- MAX and MIN on ℚ, from the same sign decision `qAbs` uses. Both are
-- 1-Lipschitz in each argument — `bndMaxSub` — which is exactly what a
-- pointwise definition on regular sequences needs, and is proved from
-- the lattice characterisation (least upper bound / greatest lower
-- bound) with no case analysis beyond the two the definitions make.

def qMax : El Q → El Q → El Q ≔
  λu. λv. ⊎-elim (w. El Q) (nn. v) (hn. u) (sgnCases (sgnQ (qAdd v (qNeg u))))

-- ===== the lattice characterisation =====

def leQMaxL : (u : El Q) (v : El Q) → El (LeQ u (qMax u v)) ≔
  λu. λv.
    ⊎-elim (w. El (LeQ u (⊎-elim (t. El Q) (nn. v) (hn. u) w)))
      (nn. nn)
      (hn. leQRefl u)
      (sgnCases (sgnQ (qAdd v (qNeg u))))

def leQMaxR : (u : El Q) (v : El Q) → El (LeQ v (qMax u v)) ≔
  λu. λv.
    ⊎-elim (w. El (LeQ v (⊎-elim (t. El Q) (nn. v) (hn. u) w)))
      (nn. leQRefl v)
      -- v < u : the flipped difference is positive, and u − v IS the
      -- negation of v − u
      (hn. inj₂ (eqToId Sign (sgnQ (qAdd u (qNeg v))) sPos
                   (trans Sign (sgnQ (qAdd u (qNeg v)))
                          (sgnQ (qNeg (qAdd v (qNeg u)))) sPos
                      (cong Q (λw. Sign) (λw. sgnQ w) (qAdd u (qNeg v))
                         (qNeg (qAdd v (qNeg u))) (qSubNeg u v))
                      (sgnQNegOfNeg (qAdd v (qNeg u)) hn))))
      (sgnCases (sgnQ (qAdd v (qNeg u))))

def qMaxLub : (u : El Q) (v : El Q) (w : El Q) →
  El (LeQ u w) → El (LeQ v w) → El (LeQ (qMax u v) w) ≔
  λu. λv. λw. λh1. λh2.
    ⊎-elim (t. El (LeQ (⊎-elim (s. El Q) (nn. v) (hn. u) t) w))
      (nn. h2)
      (hn. h1)
      (sgnCases (sgnQ (qAdd v (qNeg u))))

-- ===== Lipschitz =====

-- a two-sided bound on a difference is a pair of shifted ≤'s
def leQAddOfBnd : (b : El Q) (u : El Q) (v : El Q) →
  El (Bnd b (qAdd u (qNeg v))) → El (LeQ u (qAdd v b)) ≔
  λb. λu. λv. λh. leQAddShift u v b (h .π₂)

def bndMaxSub : (b : El Q) (a : El Q) (c : El Q) (a' : El Q) (c' : El Q) →
  El (Bnd b (qAdd a (qNeg c))) → El (Bnd b (qAdd a' (qNeg c'))) →
  El (Bnd b (qAdd (qMax a a') (qNeg (qMax c c')))) ≔
  λb. λa. λc. λa'. λc'. λh1. λh2.
    bndOfBothLe b (qMax a a') (qMax c c')
      (leQSubShift (qMax a a') (qMax c c') b
         (qMaxLub a a' (qAdd (qMax c c') b)
            (leQTrans a (qAdd c b) (qAdd (qMax c c') b)
               (leQAddOfBnd b a c h1)
               (leQPlusMono c (qMax c c') b (leQMaxL c c')))
            (leQTrans a' (qAdd c' b) (qAdd (qMax c c') b)
               (leQAddOfBnd b a' c' h2)
               (leQPlusMono c' (qMax c c') b (leQMaxR c c')))))
      (leQSubShift (qMax c c') (qMax a a') b
         (qMaxLub c c' (qAdd (qMax a a') b)
            (leQTrans c (qAdd a b) (qAdd (qMax a a') b)
               (leQAddOfBnd b c a (bndSubSym b a c h1))
               (leQPlusMono a (qMax a a') b (leQMaxL a a')))
            (leQTrans c' (qAdd a' b) (qAdd (qMax a a') b)
               (leQAddOfBnd b c' a' (bndSubSym b a' c' h2))
               (leQPlusMono a' (qMax a a') b (leQMaxR a a')))))

def qMaxSelf : (u : El Q) → qMax u u ≡ u ∈ El Q ≔
  λu. leQAntisym (qMax u u) u (qMaxLub u u u (leQRefl u) (leQRefl u)) (leQMaxL u u)

def qMaxComm : (u : El Q) (v : El Q) → qMax u v ≡ qMax v u ∈ El Q ≔
  λu. λv.
    leQAntisym (qMax u v) (qMax v u)
      (qMaxLub u v (qMax v u) (leQMaxR v u) (leQMaxL v u))
      (qMaxLub v u (qMax u v) (leQMaxR u v) (leQMaxL u v))

-- ===== the dual =====

def qMin : El Q → El Q → El Q ≔
  λu. λv. qNeg (qMax (qNeg u) (qNeg v))

def leQMinL : (u : El Q) (v : El Q) → El (LeQ (qMin u v) u) ≔
  λu. λv.
    transport Q (λw. LeQ (qMin u v) w) (qNeg (qNeg u)) u (qNegNeg u)
      (leQNegFlip (qNeg u) (qMax (qNeg u) (qNeg v)) (leQMaxL (qNeg u) (qNeg v)))

def leQMinR : (u : El Q) (v : El Q) → El (LeQ (qMin u v) v) ≔
  λu. λv.
    transport Q (λw. LeQ (qMin u v) w) (qNeg (qNeg v)) v (qNegNeg v)
      (leQNegFlip (qNeg v) (qMax (qNeg u) (qNeg v)) (leQMaxR (qNeg u) (qNeg v)))

def qMinGlb : (u : El Q) (v : El Q) (w : El Q) →
  El (LeQ w u) → El (LeQ w v) → El (LeQ w (qMin u v)) ≔
  λu. λv. λw. λh1. λh2.
    transport Q (λt. LeQ t (qMin u v)) (qNeg (qNeg w)) w (qNegNeg w)
      (leQNegFlip (qMax (qNeg u) (qNeg v)) (qNeg w)
         (qMaxLub (qNeg u) (qNeg v) (qNeg w)
            (leQNegFlip w u h1) (leQNegFlip w v h2)))

def qMinComm : (u : El Q) (v : El Q) → qMin u v ≡ qMin v u ∈ El Q ≔
  λu. λv.
    cong Q (λw. Q) (λw. qNeg w)
      (qMax (qNeg u) (qNeg v)) (qMax (qNeg v) (qNeg u))
      (qMaxComm (qNeg u) (qNeg v))

-- (−a) − (−c) ≡ c − a : the difference of negations is reversed
def qNegDiff : (a : El Q) (c : El Q) →
  qAdd (qNeg a) (qNeg (qNeg c)) ≡ qAdd c (qNeg a) ∈ El Q ≔
  λa. λc.
    trans Q (qAdd (qNeg a) (qNeg (qNeg c))) (qAdd (qNeg a) c) (qAdd c (qNeg a))
      (cong Q (λw. Q) (λw. qAdd (qNeg a) w) (qNeg (qNeg c)) c (qNegNeg c))
      (qAddComm (qNeg a) c)

-- min is 1-Lipschitz because max is: the negations cancel
def bndMinSub : (b : El Q) (a : El Q) (c : El Q) (a' : El Q) (c' : El Q) →
  El (Bnd b (qAdd a (qNeg c))) → El (Bnd b (qAdd a' (qNeg c'))) →
  El (Bnd b (qAdd (qMin a a') (qNeg (qMin c c')))) ≔
  λb. λa. λc. λa'. λc'. λh1. λh2.
    bndEq b
      (qNeg (qAdd (qMax (qNeg a) (qNeg a'))
                  (qNeg (qMax (qNeg c) (qNeg c')))))
      (qAdd (qMin a a') (qNeg (qMin c c')))
      (trans Q
         (qNeg (qAdd (qMax (qNeg a) (qNeg a'))
                     (qNeg (qMax (qNeg c) (qNeg c')))))
         (qAdd (qMax (qNeg c) (qNeg c')) (qNeg (qMax (qNeg a) (qNeg a'))))
         (qAdd (qNeg (qMax (qNeg a) (qNeg a')))
               (qNeg (qNeg (qMax (qNeg c) (qNeg c')))))
         (qSubFlip (qMax (qNeg a) (qNeg a')) (qMax (qNeg c) (qNeg c')))
         (sym Q (qAdd (qNeg (qMax (qNeg a) (qNeg a')))
                      (qNeg (qNeg (qMax (qNeg c) (qNeg c')))))
                (qAdd (qMax (qNeg c) (qNeg c'))
                      (qNeg (qMax (qNeg a) (qNeg a'))))
            (qNegDiff (qMax (qNeg a) (qNeg a')) (qMax (qNeg c) (qNeg c')))))
      (bndNeg b
         (qAdd (qMax (qNeg a) (qNeg a'))
               (qNeg (qMax (qNeg c) (qNeg c'))))
         (bndMaxSub b (qNeg a) (qNeg c) (qNeg a') (qNeg c')
            (bndEq b (qAdd c (qNeg a))
               (qAdd (qNeg a) (qNeg (qNeg c)))
               (sym Q (qAdd (qNeg a) (qNeg (qNeg c))) (qAdd c (qNeg a))
                  (qNegDiff a c))
               (bndSubSym b a c h1))
            (bndEq b (qAdd c' (qNeg a'))
               (qAdd (qNeg a') (qNeg (qNeg c')))
               (sym Q (qAdd (qNeg a') (qNeg (qNeg c'))) (qAdd c' (qNeg a'))
                  (qNegDiff a' c'))
               (bndSubSym b a' c' h2))))

-- a shifted greatest-lower-bound: w ≤ a + r and w ≤ b + r give
-- w ≤ min a b + r. (The max side needs no such lemma — qMaxLub's
-- target is already an upper bound.)
def qMinGlbShift : (a : El Q) (b : El Q) (w : El Q) (r : El Q) →
  El (LeQ w (qAdd a r)) → El (LeQ w (qAdd b r)) →
  El (LeQ w (qAdd (qMin a b) r)) ≔
  λa. λb. λw. λr. λh1. λh2.
    transport Q (λt. LeQ t (qAdd (qMin a b) r))
      (qAdd (qAdd w (qNeg r)) r) w (qPlusNegCancelR w r)
      (leQPlusMono (qAdd w (qNeg r)) (qMin a b) r
         (qMinGlb a b (qAdd w (qNeg r))
            (leQSubOfLeAdd w a r h1)
            (leQSubOfLeAdd w b r h2)))
