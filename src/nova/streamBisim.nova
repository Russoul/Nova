-- Observational equality, restated CORECURSIVELY: two streams are
-- bisimilar iff SOME relation relates them, agrees on heads, and is
-- preserved by tails — the union of all post-fixed points of the
-- one-observation-step operator, i.e. the greatest fixed point by
-- Knaster–Tarski, landed in Ω by impredicative squash (the dual of
-- Foundation's least-relations-by-intersection note). The
-- coinduction principle is DEFINITIONAL here: to prove bisim s t,
-- exhibit an invariant and its one-step closure — no ℕ index
-- anywhere. Below: intro/unfold laws, a direct corecursive proof
-- (reflexivity via the equality invariant), and equivalence with the
-- ℕ-indexed obsEq.

import prelude (id, ∘)
import equality (cong)
import stream (stream, hd, tl, map)
import streamEq (tlN, nth, obsEq, obsEqRefl, nthMap, mapIdObsEq, mapFuseObsEq)

def bisim : {a : 𝕌} → stream a → stream a → Ω ≔
  λa. λs. λt. ∥(r : stream a → stream a → Ω)
    × ((x y : stream a) → r x y → (hd x ≡ hd y) × r (tl x) (tl y)) × r s t∥

-- UNFOLD, head half: bisimilar streams agree at the head
def bisimHd : {a : 𝕌} {s t : stream a} → bisim s t → hd s ≡ hd t using (streamBisim.bisim.unfold) ≔
  λa. λs. λt. λh. squash-elim h (w. w .π₂ .π₁ s t (w .π₂ .π₂) .π₁)

-- UNFOLD, tail half: bisimilarity is preserved by observation —
-- the SAME invariant relates the tails
def bisimTl : {a : 𝕌} {s t : stream a} → bisim s t → bisim (tl s) (tl t)
  using (streamBisim.bisim.unfold) ≔
  λa. λs. λt. λh. squash-elim h (w. ⋆ (w .π₁, w .π₂ .π₁, w .π₂ .π₁ s t (w .π₂ .π₂) .π₂))

-- a DIRECT corecursive proof: reflexivity, with judgemental equality
-- itself as the invariant — heads by cong at hd, tails by cong at tl
def bisimRefl : {a : 𝕌} (s : stream a) → bisim s s using (streamBisim.bisim.unfold) ≔
  λa. λs. ⋆ ((λx. λy. x ≡ y),
    (λx. λy. λp. cong (λv. a) (λv. hd {} a v) p, cong (λv. stream a) (λv. tl v) p), ⋆)

-- obsEq ⊃ bisim: the ℕ-indexed relation is ITSELF a bisimulation —
-- heads are observation 0, and shifting the index moves under one
-- tail (nth n (tl x) ≐ nth (S n) x, judgementally)
def obsEqBisim : {a : 𝕌} {s t : stream a} → obsEq s t → bisim s t
  using (stream.hd.eq,
    stream.stream.unfold,
    stream.tl.eq,
    streamBisim.bisim.unfold,
    streamEq.nth.eq,
    streamEq.obsEq.unfold,
    streamEq.tlN.eq) ≔
  λa. λs. λt. λh. ⋆ ((λx. λy. obsEq
    x
    y), (λx. λy. λp. squash-elim p (w. w Z), squash-elim p (w. ⋆ (λn. w (S n)))), h)

-- bisim ⊃ obsEq: unfold n times, by ℕ-induction over the depth
def bisimObsEq : {a : 𝕌} {s t : stream a} → bisim s t → obsEq s t
  using (stream.hd.eq,
    stream.stream.unfold,
    stream.tl.eq,
    streamBisim.bisim.unfold,
    streamEq.nth.eq,
    streamEq.obsEq.unfold,
    streamEq.tlN.eq) ≔
  λa. λs. λt. λh. ⋆ (λn. (ℕ-elim (m. (x y : stream a) → bisim x y → nth m x ≡ nth m y)
    (λx. λy. λg. bisimHd g)
    (m ih. λx. λy. λg. ih (tl x) (tl y) (bisimTl g))
    n)
    s
    t
    h)

-- interop corollary: map-identity, now in the corecursive spelling
def mapIdBisim : {a : 𝕌} (s : stream a) → bisim (map (id {a}) s) s
  using (streamBisim.bisim.unfold, prelude.id.eq) ≔
  λa. λs. obsEqBisim (mapIdObsEq s)

-- THE REFLECTION: bisimilarity implies equality — el-nu-coind's
-- surface form, with bisim ITSELF as the invariant and the unfold
-- laws as the one-step closure (the relator's hole is up to
-- equality, so the tail half re-enters the invariant through inj₁).
-- This is the theorem that upgrades every observational result
-- below it to a judgemental equation.
def bisimReflect : {a : 𝕌} {s t : stream a} → bisim s t → s ≡ t
  using (bisim.eq,
    hyp.rw,
    stream.hd.eq,
    stream.stream.eq,
    stream.stream.unfold,
    stream.tl.eq,
    streamBisim.bisim.unfold) ≔
  λa. λs. λt. λh. coind (x y. bisim x y) h (x y hb. ⋆ (bisimHd hb, ⋆ (inj₁ (bisimTl hb))))

def obsEqReflect : {a : 𝕌} {s t : stream a} → obsEq s t → s ≡ t ≔
  λa. λs. λt. λh. bisimReflect (obsEqBisim h)

-- the η-needing equalities, now judgemental theorems
def mapIdEq : (a : 𝕌) (s : stream a) → map (id {a}) s ≡ s using (prelude.id.eq) ≔
  λa. λs. bisimReflect (mapIdBisim s)

def mapFuseEq : (a b c : 𝕌)
  (f : a → b)
  (g : b → c)
  (s : stream a)
  → map g (map f s) ≡ map (g ∘ f) s ≔
  λa. λb. λc. λf. λg. λs. obsEqReflect (mapFuseObsEq f g s)
