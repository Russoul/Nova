-- (ℤ, +, ·, 0, 1) is a commutative ring. The additive component is
-- intGroup.intAddGroup wholesale — IsCommRing takes an IsGroup, so
-- nothing additive is restated — and each remaining law is an existing
-- integerMul.nova lemma across the Id bridge, exactly as
-- realRing.realCommRing assembles ℝ's.
--
-- A gap worth closing on its own: ℤ had a group but no ring, and every
-- ring-level statement about ℤ had to be made in terms of intMul
-- directly.

import integer (Int, intZero, intOne, intNeg)
import integerAdd (+, intAddComm)
import integerMul (*, intMulAssoc, intMulComm, intMulOneR, intMulDistribL)
import intGroup (intAddGroup)
import id (Id, eqToId)
import monoid (IsMonoid)
import group (IsGroup)
import ring (IsCommRing)

def intCommRing : IsCommRing Int using (intGroup.intAddGroup.eq, ring.IsCommRing.unfold) ≔
  intAddGroup,
    (*),
      intOne,
        (λx. λy. λz. eqToId
          _
          _
          (intMulAssoc
            x
            y
            z)),
          (λx. λy. eqToId
            _
            _
            (intMulComm
              x
              y)),
            (λx. eqToId
              _
              _
              (intMulOneR
                x)),
              (λx. λy. eqToId
                (x + y)
                (y + x)
                (intAddComm
                  x
                  y)), λx. λy. λz. eqToId (x * (y + z)) (x * y + x * z) (intMulDistribL x y z)
