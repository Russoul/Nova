-- The non-dependent sum ⊎ (disjoint union) — Agda's notation: inj₁,
-- inj₂, and the dependent motive-first eliminator ⊎-elim (like
-- ℕ-elim). β on each injection is judgemental (el-sum-beta₁/₂); the
-- uniqueness law (el-sum-eta) is stated judgementally in the theory
-- and derivable here, propositionally, by case analysis at an
-- equality motive. Injection injectivity and disjointness need no
-- rules — both are derivable below, exactly as Foundation's
-- injectivity notes say.
-- case analysis at a constant motive: the canonical swap

import equality (cong, transport)

def swap : {a b : 𝕌} → El (a ⊎ b) → El (b ⊎ a) ≔ λa. λb. λt. ⊎-elim (x. inj₂ x) (y. inj₁ y) t

-- β on each injection, by computation
def swapBeta1 : (a b : 𝕌) (x : El a) → swap (inj₁ x) ≡ inj₂ x ∈ El (b ⊎ a) using (sum.swap.eq) ≔
  λa. λb. λx. ⋆

def swapBeta2 : (a b : 𝕌) (y : El b) → swap (inj₂ y) ≡ inj₁ y ∈ El (b ⊎ a) using (sum.swap.eq) ≔
  λa. λb. λy. ⋆

-- swap is an involution: case analysis with an equality motive, both
-- cases closing by β
def swapInvol : (a b : 𝕌) (t : El (a ⊎ b)) → swap (swap t) ≡ t ∈ El a ⊎ El b using (sum.swap.eq) ≔
  λa. λb. λt. ⊎-elim (x. ⋆) (y. ⋆) t

-- the uniqueness (η) law, propositionally: any map out of a ⊎ b IS
-- the eliminator over its own injection images (el-sum-eta's content,
-- derived by ⊎-elim at an equality motive)
def sumEta : (a b c : 𝕌)
  (f : El (a ⊎ b) → El c)
  (t : El (a ⊎ b))
  → ⊎-elim (w. El c) (x. f (inj₁ x)) (y. f (inj₂ y)) t ≡ f t ≔
  λa. λb. λc. λf. λt. ⊎-elim (w. ⊎-elim (v. El c) (x. f (inj₁ x)) (y. f (inj₂ y)) w ≡ f w)
    (x. ⋆)
    (y. ⋆)
    t

-- the ⊎ TYPE former and its code agree: El (a ⊎ b) ≐ El a ⊎ El b
-- (ty-el-sum), so the conversions between them are the identity
-- case analysis
def toCode : {a b : 𝕌} → El a ⊎ El b → El (a ⊎ b) ≔ λa. λb. λt. ⊎-elim (x. inj₁ x) (y. inj₂ y) t

def fromCode : {a b : 𝕌} → El (a ⊎ b) → El a ⊎ El b ≔ λa. λb. λt. ⊎-elim (x. inj₁ x) (y. inj₂ y) t

def toFromId : (a b : 𝕌) (t : El (a ⊎ b)) → toCode (fromCode t) ≡ t ∈ El a ⊎ El b
  using (sum.fromCode.eq, sum.toCode.eq) ≔
  λa. λb. λt. ⊎-elim (w. toCode (fromCode w) ≡ w) (x. ⋆) (y. ⋆) t

-- inj₁ is injective — DERIVABLE, no rule needed: a ⊎-elim retraction
-- at constant motive El a whose right case returns a fixed default
-- (the compared element itself serves), then congruence
def outl : (a b : 𝕌) → El a → El (a ⊎ b) → El a ≔ λa. λb. λd. λt. ⊎-elim (x. x) (y. d) t

def inj1Injective : (a b : 𝕌) (x x' : El a) → (inj₁ x ≡ inj₁ x' ∈ El (a ⊎ b)) → x ≡ x'
  using (sum.outl.eq) ≔
  λa. λb. λx. λx'. λh. cong (λw. a) (outl _ b x) h

-- inj₁ and inj₂ are disjoint — also derivable: transport the
-- "is-left" code along the bad equation and land a 𝟙-witness in 𝟘
def isLeftCode : (a b : 𝕌) → El (a ⊎ b) → 𝕌 ≔ λa. λb. λt. ⊎-elim (x. 𝟙) (y. 𝟘) t

def inj1NotInj2 : (a b : 𝕌) (x : El a) (y : El b) → (inj₁ x ≡ inj₂ y ∈ El (a ⊎ b)) → 𝟘
  using (sum.isLeftCode.unfold) ≔
  λa. λb. λx. λy. λh. transport (isLeftCode a b) h ()

-- the mirror image of outl/inj1Injective, for the right injection
def outr : (a b : 𝕌) → El b → El (a ⊎ b) → El b ≔ λa. λb. λd. λt. ⊎-elim (x. d) (y. y) t

def inj2Injective : (a b : 𝕌) (y y' : El b) → (inj₂ y ≡ inj₂ y' ∈ El (a ⊎ b)) → y ≡ y'
  using (sum.outr.eq) ≔
  λa. λb. λy. λy'. λh. cong (λw. b) (outr a _ y) h
