import nat (+, *)
import natOrder (LeN)
import natSqrt (isqrt, isqrtLtOfLt, sqSumStrict)
import rationalQ (Q, qAdd, qMul, qNeg, qZero, qOne, qMulZeroL, qAddComm, qAddAssoc,
                  qMulComm, qMulAssoc, qMulOneL, qMulOneR, qDistribR)
import rationalOrder (LeQ, leQTrans, leQOfEq, leQMulMono, leQPlusMonoL)
import ratBound (Bnd, bndOfBothLe, bndSubSym, leQSelfAddL, leQAdd)
import ratHalf (dbl, qInvHalf, leQZeroInvNat)
import ratArch (leQSubShift)
import ratMax (leQAddOfBnd, qMax, qMaxSelf)
import ratAbs (leQZeroMul)
import ratNat (qOfNat, qOfNatAdd, qOfNatMul, leQOfNat)
import ratCeil (leQZeroNat, qFloor)
import ratSqrt (sqNat, qSqrtAt, qMulInvNat, qInvNatMulIdx,
                leQSqrtStep, qMulSwap3, qMulLeftComm)
import natSqrt (isqrtAux)
import real (qInvNat, rBound, leQZeroBound, Regular, RSeq, REq, Real,
             constReg, realZero, realOfQ)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, rBoundSym, realEqOfREq)
import realMul (mulIdx)
import realRing (leQInvIdx)
import realPos (PosR, PosPayload, posMk, posRep, posK, posBound, posBoundRep,
                posRepEq, posSampleNN, reqOfClassEq)
import bracket (Br, br, brElim, brIsProp)
import realSeq (rseqEq)
import realOrder (LeR)
import realEq (reqTrans)

import equality (trans, sym, cong, transport, transportP)
import prelude (funext)

-- THE SQUARE ROOT of a POSITIVE real.
--
--   realSqrt : (x : El Real) → El (PosR x) → El Real
--
-- There is no total √ here and no truncation anywhere. The witness is
-- realPos.PosR — positivity carrying its modulus in a BRACKET rather
-- than a squash — and the modulus is genuinely used: it sets the
-- sampling depth, and it is what makes every sample of the
-- representative provably nonnegative, which is what the floor
-- estimate needs. `qPos` is gone from the ℚ layer as a result.
--
-- On representatives, with modulus k:
--
--   (√p)_n ≔ qSqrtAt (p_{j}) (D n),   D n = 2n+1,
--            φ n = mulIdx (D n) (D n),   j = mulIdx (dbl k) (φ n)
--
-- The approximation depth is DOUBLE the index, the sampling depth is
-- its SQUARE, and the modulus deepens the sample once more. The first
-- two are forced, and exactly:
--
--   * 1/(D n + 1) = 1/(2(n+1)), so two of them make 1/(n+1) — qInvHalf.
--     The comparison spends one on each side, and rBound m n has
--     exactly two to give.
--   * (φ n + 1) = (D n + 1)², so the gap between two samples of p,
--     scaled by (D m + 1)²(D n + 1)², is the natural
--     (D n + 1)² + (D m + 1)². That is the T fed to isqrt, and
--     sqSumStrict gives isqrt T + 1 ≤ (D n + 1) + (D m + 1), which is
--     precisely the remaining budget.
--
-- The third factor, (2k+2), is pure slack for the estimate — it only
-- makes 1/(j+1) smaller — and is exactly what buys 2/(j+1) ≤ 1/(k+1),
-- hence p_j ≥ 0. The quadratic sampling is the price of √ not being
-- Lipschitz; the modulus factor is the price of not truncating.
--
-- Regularity, well-definedness in the representative, and
-- independence of the modulus are all instances of ONE estimate
-- (sqrtDirGen). The last of these is the obligation brElim charges
-- for reaching into data, and it is what makes √ a function of x
-- rather than a family indexed by the rate.

def sqrtDepth : ℕ → ℕ ≔ λk. dbl k

def sqrtIdx : ℕ → ℕ ≔ λk. mulIdx (dbl k) (dbl k)

-- the sample is deepened by the MODULUS: j + 1 = (2k+2)·(φ n + 1), so
-- 2/(j+1) ≤ 1/(k+1) and the sample is provably nonnegative
-- (realPos.posSampleNN), while 1/(j+1) ≤ 1/(φ n + 1) keeps the
-- estimate intact.
def sqrtIdxK : ℕ → ℕ → ℕ ≔ λk. λn. mulIdx (dbl k) (sqrtIdx n)

def sqrtSeqK : El RSeq → ℕ → El (ℕ → Q) ≔
  λp. λk. λn. qSqrtAt (seqOf p (sqrtIdxK k n)) (sqrtDepth n)

def deepK : (k : ℕ) (n : ℕ) →
  El (LeQ (qInvNat (sqrtIdxK k n)) (qInvNat (sqrtIdx n)))
  using (sqrtIdxK.eq) ≔
  λk. λn. leQInvIdx (dbl k) (sqrtIdx n)

def sqrtT : ℕ → ℕ → ℕ ≔
  λm. λn. sqNat (sqrtDepth n) + sqNat (sqrtDepth m)

-- ===== the scaling is exact =====

def qMulSq : (x : El Q) (y : El Q) →
  qMul (qMul x y) (qMul x y) ≡ qMul (qMul x x) (qMul y y) ∈ El Q ≔
  λx. λy.
    (qMul (qMul x y) (qMul x y)
       ≡⟨ qMulAssoc x y (qMul x y) ⟩
     qMul x (qMul y (qMul x y))
       ≡⟨ cong Q (λw. Q) (λw. qMul x w) (qMul y (qMul x y)) (qMul x (qMul y y))
            (qMulLeftComm y x y) ⟩
     qMul x (qMul x (qMul y y))
       ≡⟨ sym Q (qMul (qMul x x) (qMul y y)) (qMul x (qMul x (qMul y y)))
            (qMulAssoc x x (qMul y y)) ⟩
     qMul (qMul x x) (qMul y y))

def invNatOne : (a : ℕ) → qMul (qInvNat a) (qOfNat (S a)) ≡ qOne ∈ El Q ≔
  λa.
    trans Q (qMul (qInvNat a) (qOfNat (S a)))
            (qMul (qOfNat (S a)) (qInvNat a)) qOne
      (qMulComm (qInvNat a) (qOfNat (S a)))
      (qMulInvNat a)

def qOfNatSq : (a : ℕ) →
  qOfNat (sqNat a) ≡ qMul (qOfNat (S a)) (qOfNat (S a)) ∈ El Q
  using (ratSqrt.sqNat.eq) ≔
  λa.
    sym Q (qMul (qOfNat (S a)) (qOfNat (S a))) (qOfNat (S a * S a))
      (qOfNatMul (S a) (S a))

-- 1/(D+1)² · (D+1)² is one
def invSqCancel : (a : ℕ) →
  qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a)) ≡ qOne ∈ El Q ≔
  λa.
    (qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a))
       ≡⟨ cong Q (λw. Q) (λw. qMul w (qOfNat (sqNat a)))
            (qInvNat (mulIdx a a)) (qMul (qInvNat a) (qInvNat a))
            (qInvNatMulIdx a a) ⟩
     qMul (qMul (qInvNat a) (qInvNat a)) (qOfNat (sqNat a))
       ≡⟨ cong Q (λw. Q) (λw. qMul (qMul (qInvNat a) (qInvNat a)) w)
            (qOfNat (sqNat a)) (qMul (qOfNat (S a)) (qOfNat (S a)))
            (qOfNatSq a) ⟩
     qMul (qMul (qInvNat a) (qInvNat a)) (qMul (qOfNat (S a)) (qOfNat (S a)))
       ≡⟨ sym Q (qMul (qMul (qInvNat a) (qOfNat (S a)))
                      (qMul (qInvNat a) (qOfNat (S a))))
                (qMul (qMul (qInvNat a) (qInvNat a))
                      (qMul (qOfNat (S a)) (qOfNat (S a))))
            (qMulSq (qInvNat a) (qOfNat (S a))) ⟩
     qMul (qMul (qInvNat a) (qOfNat (S a))) (qMul (qInvNat a) (qOfNat (S a)))
       ≡⟨ cong Q (λw. Q) (λw. qMul w (qMul (qInvNat a) (qOfNat (S a))))
            (qMul (qInvNat a) (qOfNat (S a))) qOne (invNatOne a) ⟩
     qMul qOne (qMul (qInvNat a) (qOfNat (S a)))
       ≡⟨ qMulOneL (qMul (qInvNat a) (qOfNat (S a))) ⟩
     qMul (qInvNat a) (qOfNat (S a))
       ≡⟨ invNatOne a ⟩
     qOne)

-- the gap between two samples, scaled, is exactly the natural T
def scaleEq : (a : ℕ) (b : ℕ) →
  qMul (qMul (rBound (mulIdx a a) (mulIdx b b)) (qOfNat (sqNat a)))
       (qOfNat (sqNat b))
    ≡ qOfNat (sqNat b + sqNat a) ∈ El Q ≔
  λa. λb.
    (qMul (qMul (qAdd (qInvNat (mulIdx a a)) (qInvNat (mulIdx b b)))
                (qOfNat (sqNat a)))
          (qOfNat (sqNat b))
       ≡⟨ cong Q (λw. Q) (λw. qMul w (qOfNat (sqNat b)))
            (qMul (qAdd (qInvNat (mulIdx a a)) (qInvNat (mulIdx b b)))
                  (qOfNat (sqNat a)))
            (qAdd (qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a)))
                  (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a))))
            (qDistribR (qOfNat (sqNat a)) (qInvNat (mulIdx a a))
                       (qInvNat (mulIdx b b))) ⟩
     qMul (qAdd (qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a)))
                (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a))))
          (qOfNat (sqNat b))
       ≡⟨ qDistribR (qOfNat (sqNat b))
            (qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a)))
            (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a))) ⟩
     qAdd (qMul (qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a)))
                (qOfNat (sqNat b)))
          (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a)))
                (qOfNat (sqNat b)))
       ≡⟨ cong Q (λw. Q)
            (λw. qAdd (qMul w (qOfNat (sqNat b)))
                      (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a)))
                            (qOfNat (sqNat b))))
            (qMul (qInvNat (mulIdx a a)) (qOfNat (sqNat a))) qOne
            (invSqCancel a) ⟩
     qAdd (qMul qOne (qOfNat (sqNat b)))
          (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a)))
                (qOfNat (sqNat b)))
       ≡⟨ cong Q (λw. Q)
            (λw. qAdd w (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a)))
                              (qOfNat (sqNat b))))
            (qMul qOne (qOfNat (sqNat b))) (qOfNat (sqNat b))
            (qMulOneL (qOfNat (sqNat b))) ⟩
     qAdd (qOfNat (sqNat b))
          (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a)))
                (qOfNat (sqNat b)))
       ≡⟨ cong Q (λw. Q) (λw. qAdd (qOfNat (sqNat b)) w)
            (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat a)))
                  (qOfNat (sqNat b)))
            (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat b)))
                  (qOfNat (sqNat a)))
            (qMulSwap3 (qInvNat (mulIdx b b)) (qOfNat (sqNat a))
                       (qOfNat (sqNat b))) ⟩
     qAdd (qOfNat (sqNat b))
          (qMul (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat b)))
                (qOfNat (sqNat a)))
       ≡⟨ cong Q (λw. Q) (λw. qAdd (qOfNat (sqNat b)) (qMul w (qOfNat (sqNat a))))
            (qMul (qInvNat (mulIdx b b)) (qOfNat (sqNat b))) qOne
            (invSqCancel b) ⟩
     qAdd (qOfNat (sqNat b)) (qMul qOne (qOfNat (sqNat a)))
       ≡⟨ cong Q (λw. Q) (λw. qAdd (qOfNat (sqNat b)) w)
            (qMul qOne (qOfNat (sqNat a))) (qOfNat (sqNat a))
            (qMulOneL (qOfNat (sqNat a))) ⟩
     qAdd (qOfNat (sqNat b)) (qOfNat (sqNat a))
       ≡⟨ qOfNatAdd (sqNat b) (sqNat a) ⟩
     qOfNat (sqNat b + sqNat a))

-- ===== the slack fits =====

def cancelMid : (D : ℕ) (e : El Q) →
  qMul (qOfNat (S D)) (qMul e (qInvNat D)) ≡ e ∈ El Q ≔
  λD. λe.
    (qMul (qOfNat (S D)) (qMul e (qInvNat D))
       ≡⟨ qMulLeftComm (qOfNat (S D)) e (qInvNat D) ⟩
     qMul e (qMul (qOfNat (S D)) (qInvNat D))
       ≡⟨ cong Q (λw. Q) (λw. qMul e w) (qMul (qOfNat (S D)) (qInvNat D)) qOne
            (qMulInvNat D) ⟩
     qMul e qOne
       ≡⟨ qMulOneR e ⟩
     e)

-- ((Dn+1) + (Dm+1))·(1/(Dm+1)·1/(Dn+1)) is 1/(Dm+1) + 1/(Dn+1)
def slackEq : (Dm : ℕ) (Dn : ℕ) →
  qMul (qOfNat (S Dn + S Dm)) (qMul (qInvNat Dm) (qInvNat Dn))
    ≡ qAdd (qInvNat Dm) (qInvNat Dn) ∈ El Q ≔
  λDm. λDn.
    (qMul (qOfNat (S Dn + S Dm)) (qMul (qInvNat Dm) (qInvNat Dn))
       ≡⟨ cong Q (λw. Q) (λw. qMul w (qMul (qInvNat Dm) (qInvNat Dn)))
            (qOfNat (S Dn + S Dm))
            (qAdd (qOfNat (S Dn)) (qOfNat (S Dm)))
            (sym Q (qAdd (qOfNat (S Dn)) (qOfNat (S Dm)))
                   (qOfNat (S Dn + S Dm)) (qOfNatAdd (S Dn) (S Dm))) ⟩
     qMul (qAdd (qOfNat (S Dn)) (qOfNat (S Dm)))
          (qMul (qInvNat Dm) (qInvNat Dn))
       ≡⟨ qDistribR (qMul (qInvNat Dm) (qInvNat Dn))
            (qOfNat (S Dn)) (qOfNat (S Dm)) ⟩
     qAdd (qMul (qOfNat (S Dn)) (qMul (qInvNat Dm) (qInvNat Dn)))
          (qMul (qOfNat (S Dm)) (qMul (qInvNat Dm) (qInvNat Dn)))
       ≡⟨ cong Q (λw. Q)
            (λw. qAdd w (qMul (qOfNat (S Dm))
                              (qMul (qInvNat Dm) (qInvNat Dn))))
            (qMul (qOfNat (S Dn)) (qMul (qInvNat Dm) (qInvNat Dn)))
            (qInvNat Dm)
            (cancelMid Dn (qInvNat Dm)) ⟩
     qAdd (qInvNat Dm) (qMul (qOfNat (S Dm))
                             (qMul (qInvNat Dm) (qInvNat Dn)))
       ≡⟨ cong Q (λw. Q) (λw. qAdd (qInvNat Dm) (qMul (qOfNat (S Dm)) w))
            (qMul (qInvNat Dm) (qInvNat Dn))
            (qMul (qInvNat Dn) (qInvNat Dm))
            (qMulComm (qInvNat Dm) (qInvNat Dn)) ⟩
     qAdd (qInvNat Dm) (qMul (qOfNat (S Dm))
                             (qMul (qInvNat Dn) (qInvNat Dm)))
       ≡⟨ cong Q (λw. Q) (λw. qAdd (qInvNat Dm) w)
            (qMul (qOfNat (S Dm)) (qMul (qInvNat Dn) (qInvNat Dm)))
            (qInvNat Dn)
            (cancelMid Dm (qInvNat Dn)) ⟩
     qAdd (qInvNat Dm) (qInvNat Dn))

def sqrtSlack : (m : ℕ) (n : ℕ) →
  El (LeQ (qMul (qOfNat (S (isqrt (sqrtT m n))))
                (qMul (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n))))
          (qAdd (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n)))) using (ratSqrt.sqNat.eq, sqrtT.eq) ≔
  λm. λn.
    transport Q
      (λw. LeQ (qMul (qOfNat (S (isqrt (sqrtT m n))))
                     (qMul (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n)))) w)
      (qMul (qOfNat (S (sqrtDepth n) + S (sqrtDepth m)))
            (qMul (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n))))
      (qAdd (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n)))
      (slackEq (sqrtDepth m) (sqrtDepth n))
      (leQMulMono (qOfNat (S (isqrt (sqrtT m n))))
                  (qOfNat (S (sqrtDepth n) + S (sqrtDepth m)))
                  (qMul (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n)))
         (leQOfNat (S (isqrt (sqrtT m n)))
                   (S (sqrtDepth n) + S (sqrtDepth m))
            (isqrtLtOfLt (sqrtT m n) (S (sqrtDepth n) + S (sqrtDepth m))
               (sqSumStrict (sqrtDepth n) (sqrtDepth m))))
         (leQZeroMul (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n))
            (leQZeroInvNat (sqrtDepth m)) (leQZeroInvNat (sqrtDepth n))))

-- y + (x + y) ≤ (x + x) + (y + y), for nonnegative x
def slackFits : (x : El Q) (y : El Q) → El (LeQ qZero x) →
  El (LeQ (qAdd y (qAdd x y)) (qAdd (qAdd x x) (qAdd y y))) ≔
  λx. λy. λhx.
    transport Q (λw. LeQ w (qAdd (qAdd x x) (qAdd y y)))
      (qAdd x (qAdd y y)) (qAdd y (qAdd x y))
      (sym Q (qAdd y (qAdd x y)) (qAdd x (qAdd y y))
         (trans Q (qAdd y (qAdd x y)) (qAdd (qAdd y x) y) (qAdd x (qAdd y y))
            (sym Q (qAdd (qAdd y x) y) (qAdd y (qAdd x y)) (qAddAssoc y x y))
            (trans Q (qAdd (qAdd y x) y) (qAdd (qAdd x y) y)
                     (qAdd x (qAdd y y))
               (cong Q (λw. Q) (λw. qAdd w y) (qAdd y x) (qAdd x y)
                  (qAddComm y x))
               (qAddAssoc x y y))))
      (transport Q (λw. LeQ (qAdd x (qAdd y y)) w)
         (qAdd x (qAdd x (qAdd y y))) (qAdd (qAdd x x) (qAdd y y))
         (sym Q (qAdd (qAdd x x) (qAdd y y)) (qAdd x (qAdd x (qAdd y y)))
            (qAddAssoc x x (qAdd y y)))
         (leQSelfAddL (qAdd x (qAdd y y)) x hx))

-- ===== regularity =====

def rBoundHalves : (m : ℕ) (n : ℕ) →
  qAdd (qAdd (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth m)))
       (qAdd (qInvNat (sqrtDepth n)) (qInvNat (sqrtDepth n)))
    ≡ rBound m n ∈ El Q
  using (real.rBound.eq, sqrtDepth.eq) ≔
  λm. λn.
    trans Q (qAdd (qAdd (qInvNat (dbl m)) (qInvNat (dbl m)))
                  (qAdd (qInvNat (dbl n)) (qInvNat (dbl n))))
            (qAdd (qInvNat m) (qAdd (qInvNat (dbl n)) (qInvNat (dbl n))))
            (qAdd (qInvNat m) (qInvNat n))
      (cong Q (λw. Q) (λw. qAdd w (qAdd (qInvNat (dbl n)) (qInvNat (dbl n))))
         (qAdd (qInvNat (dbl m)) (qInvNat (dbl m))) (qInvNat m) (qInvHalf m))
      (cong Q (λw. Q) (λw. qAdd (qInvNat m) w)
         (qAdd (qInvNat (dbl n)) (qInvNat (dbl n))) (qInvNat n) (qInvHalf n))


-- ===== one comparison, three uses =====
--
-- Regularity, well-definedness in the representative, and
-- independence of the modulus are the SAME estimate: two samples, of
-- possibly different representatives, each at least as deep as φ of
-- its index. Stating it once with the sample indices abstract covers
-- all three, and is why the modulus costs so little.

def sqrtDirGen : (p : El RSeq) (p' : El RSeq) (a : ℕ) (b : ℕ) (m : ℕ) (n : ℕ) →
  El (LeQ qZero (seqOf p a)) →
  El (LeQ (qInvNat a) (qInvNat (sqrtIdx m))) →
  El (LeQ (qInvNat b) (qInvNat (sqrtIdx n))) →
  El (Bnd (rBound a b) (qAdd (seqOf p a) (qNeg (seqOf p' b)))) →
  El (LeQ (qSqrtAt (seqOf p a) (sqrtDepth m))
          (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n)) (rBound m n))) using (real.rBound.eq, sqrtDepth.eq, sqrtIdx.eq, sqrtT.eq) ≔
  λp. λp'. λa. λb. λm. λn. λnn. λda. λdb. λgap.
    leQTrans (qSqrtAt (seqOf p a) (sqrtDepth m))
             (qAdd (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                         (qInvNat (sqrtDepth n)))
                   (qMul (qOfNat (S (isqrt (sqrtT m n))))
                         (qMul (qInvNat (sqrtDepth m))
                               (qInvNat (sqrtDepth n)))))
             (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n)) (rBound m n))
      (leQSqrtStep (seqOf p a) (seqOf p' b) (sqrtDepth m) (sqrtDepth n)
                   (sqrtT m n) (rBound a b)
         nn
         (leQAddOfBnd (rBound a b) (seqOf p a) (seqOf p' b) gap)
         (leQTrans (qMul (qMul (rBound a b) (qOfNat (sqNat (sqrtDepth m))))
                         (qOfNat (sqNat (sqrtDepth n))))
                   (qMul (qMul (rBound (sqrtIdx m) (sqrtIdx n))
                               (qOfNat (sqNat (sqrtDepth m))))
                         (qOfNat (sqNat (sqrtDepth n))))
                   (qOfNat (sqrtT m n))
            (leQMulMono (qMul (rBound a b) (qOfNat (sqNat (sqrtDepth m))))
                        (qMul (rBound (sqrtIdx m) (sqrtIdx n))
                              (qOfNat (sqNat (sqrtDepth m))))
                        (qOfNat (sqNat (sqrtDepth n)))
               (leQMulMono (rBound a b) (rBound (sqrtIdx m) (sqrtIdx n))
                           (qOfNat (sqNat (sqrtDepth m)))
                  (leQAdd (qInvNat a) (qInvNat (sqrtIdx m))
                          (qInvNat b) (qInvNat (sqrtIdx n)) da db)
                  (leQZeroNat (sqNat (sqrtDepth m))))
               (leQZeroNat (sqNat (sqrtDepth n))))
            (leQOfEq (qMul (qMul (rBound (sqrtIdx m) (sqrtIdx n))
                                 (qOfNat (sqNat (sqrtDepth m))))
                           (qOfNat (sqNat (sqrtDepth n))))
                     (qOfNat (sqrtT m n))
               (scaleEq (sqrtDepth m) (sqrtDepth n)))))
      (leQTrans (qAdd (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                            (qInvNat (sqrtDepth n)))
                      (qMul (qOfNat (S (isqrt (sqrtT m n))))
                            (qMul (qInvNat (sqrtDepth m))
                                  (qInvNat (sqrtDepth n)))))
                (qAdd (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                            (qInvNat (sqrtDepth n)))
                      (qAdd (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n))))
                (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n)) (rBound m n))
         (leQPlusMonoL (qMul (qOfNat (S (isqrt (sqrtT m n))))
                             (qMul (qInvNat (sqrtDepth m))
                                   (qInvNat (sqrtDepth n))))
                       (qAdd (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n)))
                       (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                             (qInvNat (sqrtDepth n)))
            (sqrtSlack m n))
         (transport Q
            (λw. LeQ w (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                             (rBound m n)))
            (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                  (qAdd (qInvNat (sqrtDepth n))
                        (qAdd (qInvNat (sqrtDepth m))
                              (qInvNat (sqrtDepth n)))))
            (qAdd (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                        (qInvNat (sqrtDepth n)))
                  (qAdd (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n))))
            (sym Q (qAdd (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                               (qInvNat (sqrtDepth n)))
                         (qAdd (qInvNat (sqrtDepth m))
                               (qInvNat (sqrtDepth n))))
                   (qAdd (qSqrtAt (seqOf p' b) (sqrtDepth n))
                         (qAdd (qInvNat (sqrtDepth n))
                               (qAdd (qInvNat (sqrtDepth m))
                                     (qInvNat (sqrtDepth n)))))
               (qAddAssoc (qSqrtAt (seqOf p' b) (sqrtDepth n))
                          (qInvNat (sqrtDepth n))
                          (qAdd (qInvNat (sqrtDepth m))
                                (qInvNat (sqrtDepth n)))))
            (leQPlusMonoL (qAdd (qInvNat (sqrtDepth n))
                                (qAdd (qInvNat (sqrtDepth m))
                                      (qInvNat (sqrtDepth n))))
                          (rBound m n)
                          (qSqrtAt (seqOf p' b) (sqrtDepth n))
               (transport Q
                  (λw. LeQ (qAdd (qInvNat (sqrtDepth n))
                                 (qAdd (qInvNat (sqrtDepth m))
                                       (qInvNat (sqrtDepth n)))) w)
                  (qAdd (qAdd (qInvNat (sqrtDepth m))
                              (qInvNat (sqrtDepth m)))
                        (qAdd (qInvNat (sqrtDepth n))
                              (qInvNat (sqrtDepth n))))
                  (rBound m n)
                  (rBoundHalves m n)
                  (slackFits (qInvNat (sqrtDepth m)) (qInvNat (sqrtDepth n))
                     (leQZeroInvNat (sqrtDepth m)))))))

-- ===== use 1: regularity =====

def sqrtRegAtK : (p : El RSeq) (k : ℕ)
  (hp : Prf (LeR (realOfQ (qInvNat k)) (class p))) (m : ℕ) (n : ℕ) →
  El (Bnd (rBound m n) (qAdd (sqrtSeqK p k m) (qNeg (sqrtSeqK p k n)))) using (real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, sqrtIdxK.eq, sqrtSeqK.eq) ≔
  λp. λk. λhp. λm. λn.
    bndOfBothLe (rBound m n) (sqrtSeqK p k m) (sqrtSeqK p k n)
      (leQSubShift (sqrtSeqK p k m) (sqrtSeqK p k n) (rBound m n)
         (sqrtDirGen p p (sqrtIdxK k m) (sqrtIdxK k n) m n
            (posSampleNN p k hp (sqrtIdx m)) (deepK k m) (deepK k n)
            (regBnd (seqOf p) (regOf p) (sqrtIdxK k m) (sqrtIdxK k n))))
      (transport Q (λw. LeQ (qAdd (sqrtSeqK p k n) (qNeg (sqrtSeqK p k m))) w)
         (rBound n m) (rBound m n) (rBoundSym n m)
         (leQSubShift (sqrtSeqK p k n) (sqrtSeqK p k m) (rBound n m)
            (sqrtDirGen p p (sqrtIdxK k n) (sqrtIdxK k m) n m
               (posSampleNN p k hp (sqrtIdx n)) (deepK k n) (deepK k m)
               (regBnd (seqOf p) (regOf p) (sqrtIdxK k n) (sqrtIdxK k m)))))

def sqrtRegK : (p : El RSeq) (k : ℕ)
  (hp : Prf (LeR (realOfQ (qInvNat k)) (class p))) →
  El (Regular (sqrtSeqK p k)) using (real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, sqrtIdxK.eq, sqrtSeqK.eq) ≔
  λp. λk. λhp. bndReg (sqrtSeqK p k) (sqrtRegAtK p k hp)

def rSqrtK : (p : El RSeq) (k : ℕ)
  (hp : Prf (LeR (realOfQ (qInvNat k)) (class p))) → El RSeq using (real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, sqrtIdxK.eq, sqrtSeqK.eq) ≔
  λp. λk. λhp. (sqrtSeqK p k , sqrtRegK p k hp)

-- ===== use 2: well-definedness in the representative =====

def rSqrtWDK : (p : El RSeq) (p' : El RSeq) (k : ℕ)
  (hp : Prf (LeR (realOfQ (qInvNat k)) (class p)))
  (hp' : Prf (LeR (realOfQ (qInvNat k)) (class p'))) →
  Prf (REq p p') → Prf (REq (rSqrtK p k hp) (rSqrtK p' k hp')) using (rSqrtK.eq, ratBound.Bnd.unfold, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, realNeg.seqOf.eq, sqrtIdxK.eq, sqrtSeqK.eq) ≔
  λp. λp'. λk. λhp. λhp'. λh.
    squash-elim h
      (u. reqOf (rSqrtK p k hp) (rSqrtK p' k hp')
            (λn.
              bndOfBothLe (rBound n n) (sqrtSeqK p k n) (sqrtSeqK p' k n)
                (leQSubShift (sqrtSeqK p k n) (sqrtSeqK p' k n) (rBound n n)
                   (sqrtDirGen p p' (sqrtIdxK k n) (sqrtIdxK k n) n n
                      (posSampleNN p k hp (sqrtIdx n))
                      (deepK k n) (deepK k n) (u (sqrtIdxK k n))))
                (leQSubShift (sqrtSeqK p' k n) (sqrtSeqK p k n) (rBound n n)
                   (sqrtDirGen p' p (sqrtIdxK k n) (sqrtIdxK k n) n n
                      (posSampleNN p' k hp' (sqrtIdx n))
                      (deepK k n) (deepK k n)
                      (bndSubSym (rBound (sqrtIdxK k n) (sqrtIdxK k n))
                                 (seqOf p (sqrtIdxK k n))
                                 (seqOf p' (sqrtIdxK k n))
                         (u (sqrtIdxK k n)))))))

-- ===== use 3: the modulus does not matter =====
--
-- This is the obligation brElim charges for reaching into data, and
-- it is the theorem that makes √ a function of x rather than a family
-- indexed by the rate.

def rSqrtConstK : (p : El RSeq) (k : ℕ) (k' : ℕ)
  (hp : Prf (LeR (realOfQ (qInvNat k)) (class p)))
  (hp' : Prf (LeR (realOfQ (qInvNat k')) (class p))) →
  Prf (REq (rSqrtK p k hp) (rSqrtK p k' hp')) using (rSqrtK.eq, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold, realNeg.seqOf.eq, sqrtIdxK.eq, sqrtSeqK.eq) ≔
  λp. λk. λk'. λhp. λhp'.
    reqOf (rSqrtK p k hp) (rSqrtK p k' hp')
      (λn.
        bndOfBothLe (rBound n n) (sqrtSeqK p k n) (sqrtSeqK p k' n)
          (leQSubShift (sqrtSeqK p k n) (sqrtSeqK p k' n) (rBound n n)
             (sqrtDirGen p p (sqrtIdxK k n) (sqrtIdxK k' n) n n
                (posSampleNN p k hp (sqrtIdx n))
                (deepK k n) (deepK k' n)
                (regBnd (seqOf p) (regOf p) (sqrtIdxK k n) (sqrtIdxK k' n))))
          (leQSubShift (sqrtSeqK p k' n) (sqrtSeqK p k n) (rBound n n)
             (sqrtDirGen p p (sqrtIdxK k' n) (sqrtIdxK k n) n n
                (posSampleNN p k' hp' (sqrtIdx n))
                (deepK k' n) (deepK k n)
                (regBnd (seqOf p) (regOf p) (sqrtIdxK k' n) (sqrtIdxK k n)))))

-- ===== the descent =====
--
-- ONE elimination. The witness carries the representative, so there is
-- no quot-elim on x and no dependent motive — which matters, because
-- the motive would have to convert PosPayload (class p) to
-- PosPayload (class p'), a rewrite underneath prfC that the kernel
-- will not replay.
--
-- brElim's obligation is that the result not depend on the witness.
-- Two witnesses differ in BOTH the representative and the modulus, so
-- the obligation is rSqrtWDK followed by rSqrtConstK — the two
-- theorems the bracket exists to charge for.

def posBoundAt : (p : El RSeq) (p' : El RSeq) (h : Prf (REq p p')) (k : ℕ) →
  Prf (LeR (realOfQ (qInvNat k)) (class p)) →
  Prf (LeR (realOfQ (qInvNat k)) (class p'))
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold) ≔
  λp. λp'. λh. λk. λhp.
    transportP Real (λv. LeR (realOfQ (qInvNat k)) v) (class p) (class p')
      (realEqOfREq p p' h) hp

def sqrtFromPayload : (x : El Real) → El (PosPayload x) → El Real
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold) ≔
  λx. λd. class (rSqrtK (posRep x d) (posK x d) (posBoundRep x d))

def sqrtPayloadConst : (x : El Real) (d : El (PosPayload x))
  (d' : El (PosPayload x)) →
  sqrtFromPayload x d ≡ sqrtFromPayload x d' ∈ El Real
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold,
         sqrtFromPayload.eq) ≔
  λx. λd. λd'.
    realEqOfREq (rSqrtK (posRep x d) (posK x d) (posBoundRep x d))
                (rSqrtK (posRep x d') (posK x d') (posBoundRep x d'))
      (reqTrans (rSqrtK (posRep x d) (posK x d) (posBoundRep x d))
                (rSqrtK (posRep x d') (posK x d)
                   (posBoundAt (posRep x d) (posRep x d')
                      (reqOfClassEq (posRep x d) (posRep x d')
                         (trans Real (class (posRep x d)) x
                                     (class (posRep x d'))
                            (posRepEq x d)
                            (sym Real (class (posRep x d')) x
                               (posRepEq x d'))))
                      (posK x d) (posBoundRep x d)))
                (rSqrtK (posRep x d') (posK x d') (posBoundRep x d'))
         (rSqrtWDK (posRep x d) (posRep x d') (posK x d)
            (posBoundRep x d)
            (posBoundAt (posRep x d) (posRep x d')
               (reqOfClassEq (posRep x d) (posRep x d')
                  (trans Real (class (posRep x d)) x (class (posRep x d'))
                     (posRepEq x d)
                     (sym Real (class (posRep x d')) x (posRepEq x d'))))
               (posK x d) (posBoundRep x d))
            (reqOfClassEq (posRep x d) (posRep x d')
               (trans Real (class (posRep x d)) x (class (posRep x d'))
                  (posRepEq x d)
                  (sym Real (class (posRep x d')) x (posRepEq x d')))))
         (rSqrtConstK (posRep x d') (posK x d) (posK x d')
            (posBoundAt (posRep x d) (posRep x d')
               (reqOfClassEq (posRep x d) (posRep x d')
                  (trans Real (class (posRep x d)) x (class (posRep x d'))
                     (posRepEq x d)
                     (sym Real (class (posRep x d')) x (posRepEq x d'))))
               (posK x d) (posBoundRep x d))
            (posBoundRep x d')))

def realSqrt : (x : El Real) → El (PosR x) → El Real
  using (PosR.eq) ≔
  λx. λw.
    brElim (PosPayload x) Real (sqrtFromPayload x) (sqrtPayloadConst x) w

-- the computation rule: on a witness that is literally a payload, √
-- reduces to the sequence built from that payload's representative
-- and modulus
def realSqrtRep : (x : El Real) (d : El (PosPayload x)) →
  realSqrt x (br (PosPayload x) d)
    ≡ class (rSqrtK (posRep x d) (posK x d) (posBoundRep x d)) ∈ El Real
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold,
         PosR.eq, bracket.br.eq, bracket.brElim.eq, sqrtFromPayload.eq,
         realSqrt.realSqrt.eq) ≔
  λx. λd. ⋆
