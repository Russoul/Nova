-- THE SQUARE ROOT of a NONNEGATIVE real.
--
--   realSqrt : (x : El Real) → El (NonNegR x) → El Real
--
-- No total √, and no truncation inside it. The witness is
-- realPos.NonNegR — x together with a POINTWISE NONNEGATIVE
-- representative, bracketed — and that is exactly what the floor
-- estimate needs, at every sample, with no clamping and no modulus.
--
-- Nonnegativity rather than positivity is the right hypothesis here.
-- √ never needs separation from zero; it needs its samples to be
-- nonnegative, and a nonnegative presentation says precisely that.
-- Strict positivity (realPos.PosR) would also do it — deepen the
-- sample by the modulus and p_j ≥ 1/(2(k+1)) — but it excludes 0,
-- which is in √'s domain. PosR is kept for division, where 0 really
-- is outside and the modulus really is needed.
--
-- On a nonnegative representative:
--
--   (√p)_n ≔ qSqrtAt (p_{φ n}) (D n),  D n = 2n+1,  φ n = mulIdx (D n) (D n)
--
-- The approximation depth is DOUBLE the index and the sampling depth
-- is its SQUARE. Both are forced, and exactly:
--
--   * 1/(D n + 1) = 1/(2(n+1)), so two of them make 1/(n+1) — qInvHalf.
--     The comparison spends one on each side, and rBound m n has
--     exactly two to give.
--   * (φ n + 1) = (D n + 1)², so the gap between two samples of p,
--     scaled by (D m + 1)²(D n + 1)², is the natural
--     (D n + 1)² + (D m + 1)². That is the T fed to isqrt, and
--     sqSumStrict gives isqrt T + 1 ≤ (D n + 1) + (D m + 1), which is
--     precisely the remaining budget.
--
-- The quadratic sampling is the price of √ not being Lipschitz: its
-- modulus of continuity is √.
--
-- Regularity and well-definedness are instances of ONE estimate
-- (sqrtDirGen). The second is the obligation brElim charges for
-- reaching into data: any two nonnegative presentations of x give the
-- same root.

import nat (+, *)
import natOrder (≤)
import natSqrt (isqrt, isqrtLtOfLt, sqSumStrict)
import rationalQ (Q, +, *, qNeg, qZero, qOne, qMulZeroL, qAddComm, qAddAssoc, qMulComm, qMulAssoc, qMulOneL, qMulOneR, qDistribR)
import rationalOrder (≤, leQRefl, leQTrans, leQOfEq, leQMulMono, leQPlusMonoL)
import ratBound (Bnd, bndOfBothLe, bndSubSym, leQSelfAddL, leQAdd)
import ratHalf (dbl, qInvHalf, leQZeroInvNat)
import ratArch (leQSubShift)
import ratMax (leQAddOfBnd, qMax, qMaxSelf)
import ratAbs (leQZeroMul)
import ratNat (qOfNat, qOfNatAdd, qOfNatMul, qOfNatZero, leQOfNat)
import ratCeil (leQZeroNat, qFloor)
import ratSqrt (sqNat, qSqrtAt, qMulInvNat, qInvNatMulIdx, leQSqrtStep, qMulSwap3, qMulLeftComm)
import natSqrt (isqrtAux)
import real (qInvNat, rBound, leQZeroBound, Regular, RSeq, REq, Real, constReg, realZero, realOfQ)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, rBoundSym, realEqOfREq)
import realMul (mulIdx)
import realRing (leQInvIdx)
import realPos (NonNegR, NonNegPayload, nonNegMk, nnRep, nnAt, nnRepEq, reqOfClassEq)
import bracket (Br, br, brElim, brIsProp)
import realSeq (rseqEq)
import realOrder (≤)
import realEq (reqTrans)
import equality (trans, sym, cong, transport, transportP)
import prelude (funext)

def sqrtDepth : ℕ → ℕ ≔ λk. dbl k

def sqrtIdx : ℕ → ℕ ≔ λk. mulIdx (dbl k) (dbl k)

def sqrtT : ℕ → ℕ → ℕ ≔ λm. λn. sqNat (sqrtDepth n) + sqNat (sqrtDepth m)

-- ===== the scaling is exact =====
def qMulSq : (x y : El Q) → x * y * (x * y) ≡ x * x * (y * y) ≔
  λx. λy. x * y * (x * y)
      ≡⟨ qMulAssoc x y (x * y) ⟩ x * (y * (x * y))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. x * w)
        (y * (x * y))
        (x * (y * y))
        (qMulLeftComm y x y) ⟩ x * (x * (y * y))
      ≡⟨ sym Q (x * x * (y * y)) (x * (x * (y * y))) (qMulAssoc x x (y * y)) ⟩ x * x * (y * y)

def invNatOne : (a : ℕ) → qInvNat a * qOfNat (S a) ≡ qOne ≔
  λa. trans
    Q
    (qInvNat a * qOfNat (S a))
    (qOfNat (S a) * qInvNat a)
    qOne
    (qMulComm (qInvNat a) (qOfNat (S a)))
    qMulInvNat

def qOfNatSq : (a : ℕ) → qOfNat (sqNat a) ≡ qOfNat (S a) * qOfNat (S a) using (ratSqrt.sqNat.eq) ≔
  λa. sym Q (qOfNat (S a) * qOfNat (S a)) (qOfNat (S a * S a)) (qOfNatMul (S a) (S a))

-- 1/(D+1)² · (D+1)² is one
def invSqCancel : (a : ℕ) → qInvNat (mulIdx a a) * qOfNat (sqNat a) ≡ qOne ≔
  λa. qInvNat (mulIdx a a) * qOfNat (sqNat a)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * qOfNat (sqNat a))
        (qInvNat (mulIdx a a))
        (qInvNat a * qInvNat a)
        qInvNatMulIdx ⟩ qInvNat a * qInvNat a * qOfNat (sqNat a)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qInvNat a * qInvNat a * w)
        (qOfNat (sqNat a))
        (qOfNat (S a) * qOfNat (S a))
        (qOfNatSq a) ⟩ qInvNat a * qInvNat a * (qOfNat (S a) * qOfNat (S a))
      ≡⟨ sym
        Q
        (qInvNat a * qOfNat (S a) * (qInvNat a * qOfNat (S a)))
        (qInvNat a * qInvNat a * (qOfNat (S a) * qOfNat (S a)))
        (qMulSq (qInvNat a) (qOfNat (S a))) ⟩ qInvNat a * qOfNat (S a) * (qInvNat a * qOfNat (S a))
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * (qInvNat a * qOfNat (S a)))
        (qInvNat a * qOfNat (S a))
        qOne
        (invNatOne a) ⟩ qOne * (qInvNat a * qOfNat (S a))
      ≡⟨ qMulOneL (qInvNat a * qOfNat (S a)) ⟩ qInvNat a * qOfNat (S a)
      ≡⟨ invNatOne a ⟩ qOne

-- the gap between two samples, scaled, is exactly the natural T
def scaleEq : (a b : ℕ)
  → rBound
    (mulIdx a a)
    (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b) ≡ qOfNat (sqNat b + sqNat a) ≔
  λa. λb. (qInvNat (mulIdx a a) + qInvNat (mulIdx b b)) * qOfNat (sqNat a) * qOfNat (sqNat b)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * qOfNat (sqNat b))
        ((qInvNat (mulIdx a a) + qInvNat (mulIdx b b)) * qOfNat (sqNat a))
        (qInvNat (mulIdx a a) * qOfNat (sqNat a) + qInvNat (mulIdx b b) * qOfNat (sqNat a))
        (qDistribR
          (qOfNat (sqNat a))
          (qInvNat (mulIdx a a))
          (qInvNat
            (mulIdx
              b
              b))) ⟩ (qInvNat
        (mulIdx
          a
          a) * qOfNat (sqNat a) + qInvNat (mulIdx b b) * qOfNat (sqNat a)) * qOfNat (sqNat b)
      ≡⟨ qDistribR
        (qOfNat (sqNat b))
        (qInvNat (mulIdx a a) * qOfNat (sqNat a))
        (qInvNat
          (mulIdx
            b
            b)
          * qOfNat
            (sqNat
              a)) ⟩ qInvNat
        (mulIdx
          a
          a)
        * qOfNat
          (sqNat a) * qOfNat (sqNat b) + qInvNat (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * qOfNat (sqNat b) + qInvNat (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b))
        (qInvNat (mulIdx a a) * qOfNat (sqNat a))
        qOne
        (invSqCancel
          a) ⟩ qOne * qOfNat (sqNat b) + qInvNat (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w + qInvNat (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b))
        (qOne * qOfNat (sqNat b))
        (qOfNat (sqNat b))
        (qMulOneL
          (qOfNat
            (sqNat
              b))) ⟩ qOfNat (sqNat b) + qInvNat (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qOfNat (sqNat b) + w)
        (qInvNat (mulIdx b b) * qOfNat (sqNat a) * qOfNat (sqNat b))
        (qInvNat (mulIdx b b) * qOfNat (sqNat b) * qOfNat (sqNat a))
        (qMulSwap3
          (qInvNat (mulIdx b b))
          (qOfNat (sqNat a))
          (qOfNat
            (sqNat
              b))) ⟩ qOfNat (sqNat b) + qInvNat (mulIdx b b) * qOfNat (sqNat b) * qOfNat (sqNat a)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qOfNat (sqNat b) + w * qOfNat (sqNat a))
        (qInvNat (mulIdx b b) * qOfNat (sqNat b))
        qOne
        (invSqCancel b) ⟩ qOfNat (sqNat b) + qOne * qOfNat (sqNat a)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qOfNat (sqNat b) + w)
        (qOne * qOfNat (sqNat a))
        (qOfNat (sqNat a))
        (qMulOneL (qOfNat (sqNat a))) ⟩ qOfNat (sqNat b) + qOfNat (sqNat a)
      ≡⟨ qOfNatAdd (sqNat b) (sqNat a) ⟩ qOfNat (sqNat b + sqNat a)

-- ===== the slack fits =====
def cancelMid : (D : ℕ) (e : El Q) → qOfNat (S D) * (e * qInvNat D) ≡ e ≔
  λD. λe. qOfNat (S D) * (e * qInvNat D)
      ≡⟨ qMulLeftComm (qOfNat (S D)) e (qInvNat D) ⟩ e * (qOfNat (S D) * qInvNat D)
      ≡⟨ cong Q (λw. Q) (λw. e * w) (qOfNat (S D) * qInvNat D) qOne qMulInvNat ⟩ e * qOne
      ≡⟨ qMulOneR e ⟩ e

-- ((Dn+1) + (Dm+1))·(1/(Dm+1)·1/(Dn+1)) is 1/(Dm+1) + 1/(Dn+1)
def slackEq : {Dm Dn : ℕ}
  → qOfNat (S Dn + S Dm) * (qInvNat Dm * qInvNat Dn) ≡ qInvNat Dm + qInvNat Dn ≔
  λDm. λDn. qOfNat (S Dn + S Dm) * (qInvNat Dm * qInvNat Dn)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w * (qInvNat Dm * qInvNat Dn))
        (qOfNat (S Dn + S Dm))
        (qOfNat (S Dn) + qOfNat (S Dm))
        (sym
          Q
          (qOfNat (S Dn) + qOfNat (S Dm))
          (qOfNat (S Dn + S Dm))
          (qOfNatAdd (S Dn) (S Dm))) ⟩ (qOfNat (S Dn) + qOfNat (S Dm)) * (qInvNat Dm * qInvNat Dn)
      ≡⟨ qDistribR
        (qInvNat Dm * qInvNat Dn)
        (qOfNat (S Dn))
        (qOfNat
          (S Dm)) ⟩ qOfNat
        (S Dn) * (qInvNat Dm * qInvNat Dn) + qOfNat (S Dm) * (qInvNat Dm * qInvNat Dn)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. w + qOfNat (S Dm) * (qInvNat Dm * qInvNat Dn))
        (qOfNat (S Dn) * (qInvNat Dm * qInvNat Dn))
        (qInvNat Dm)
        (cancelMid Dn (qInvNat Dm)) ⟩ qInvNat Dm + qOfNat (S Dm) * (qInvNat Dm * qInvNat Dn)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qInvNat Dm + qOfNat (S Dm) * w)
        (qInvNat Dm * qInvNat Dn)
        (qInvNat Dn * qInvNat Dm)
        (qMulComm
          (qInvNat Dm)
          (qInvNat Dn)) ⟩ qInvNat Dm + qOfNat (S Dm) * (qInvNat Dn * qInvNat Dm)
      ≡⟨ cong
        Q
        (λw. Q)
        (λw. qInvNat Dm + w)
        (qOfNat (S Dm) * (qInvNat Dn * qInvNat Dm))
        (qInvNat Dn)
        (cancelMid Dm (qInvNat Dn)) ⟩ qInvNat Dm + qInvNat Dn

def sqrtSlack : (m n : ℕ)
  → El (qOfNat
    (S (isqrt
      (sqrtT
        m
        n)))
    * (qInvNat
      (sqrtDepth m) * qInvNat (sqrtDepth n)) ≤ qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n))
  using (ratSqrt.sqNat.eq, sqrtT.eq) ≔
  λm. λn. transport
    Q
    (λw. qOfNat (S (isqrt (sqrtT m n))) * (qInvNat (sqrtDepth m) * qInvNat (sqrtDepth n)) ≤ w)
    (qOfNat (S (sqrtDepth n) + S (sqrtDepth m)) * (qInvNat (sqrtDepth m) * qInvNat (sqrtDepth n)))
    (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n))
    slackEq
    (leQMulMono
      (qOfNat (S (isqrt (sqrtT m n))))
      (qOfNat (S (sqrtDepth n) + S (sqrtDepth m)))
      (leQOfNat (isqrtLtOfLt (sqrtT m n) (sqSumStrict (sqrtDepth n) (sqrtDepth m))))
      (leQZeroMul (leQZeroInvNat (sqrtDepth m)) (leQZeroInvNat (sqrtDepth n))))

-- y + (x + y) ≤ (x + x) + (y + y), for nonnegative x
def slackFits : {x y : El Q} → El (qZero ≤ x) → El (y + (x + y) ≤ x + x + (y + y)) ≔
  λx. λy. λhx. transport
    Q
    (λw. w ≤ x + x + (y + y))
    (x + (y + y))
    (y + (x + y))
    (sym
      Q
      (y + (x + y))
      (x + (y + y))
      (trans
        Q
        (y + (x + y))
        (y + x + y)
        (x + (y + y))
        (sym Q (y + x + y) (y + (x + y)) (qAddAssoc y x y))
        (trans
          Q
          (y + x + y)
          (x + y + y)
          (x + (y + y))
          (cong Q (λw. Q) (λw. w + y) (y + x) (x + y) (qAddComm y x))
          (qAddAssoc x y y))))
    (transport
      Q
      (λw. x + (y + y) ≤ w)
      (x + (x + (y + y)))
      (x + x + (y + y))
      (sym Q (x + x + (y + y)) (x + (x + (y + y))) (qAddAssoc x x (y + y)))
      (leQSelfAddL hx))

-- ===== regularity =====
def rBoundHalves : {m n : ℕ}
  → qInvNat
    (sqrtDepth
      m) + qInvNat (sqrtDepth m) + (qInvNat (sqrtDepth n) + qInvNat (sqrtDepth n)) ≡ rBound m n
  using (real.rBound.eq, sqrtDepth.eq) ≔
  λm. λn. trans
    Q
    (qInvNat (dbl m) + qInvNat (dbl m) + (qInvNat (dbl n) + qInvNat (dbl n)))
    (qInvNat m + (qInvNat (dbl n) + qInvNat (dbl n)))
    (qInvNat m + qInvNat n)
    (cong
      Q
      (λw. Q)
      (λw. w + (qInvNat (dbl n) + qInvNat (dbl n)))
      (qInvNat (dbl m) + qInvNat (dbl m))
      (qInvNat m)
      (qInvHalf m))
    (cong
      Q
      (λw. Q)
      (λw. qInvNat m + w)
      (qInvNat (dbl n) + qInvNat (dbl n))
      (qInvNat n)
      (qInvHalf n))

-- ===== one comparison, three uses =====
--
-- Regularity, well-definedness in the representative, and
-- independence of the modulus are the SAME estimate: two samples, of
-- possibly different representatives, each at least as deep as φ of
-- its index. Stating it once with the sample indices abstract covers
-- all three, and is why the modulus costs so little.
def sqrtDirGen : {p : El RSeq}
  (p' : El RSeq)
  {a b m n : ℕ}
  → El (qZero
    ≤ seqOf
      p
      a)
    → El (qInvNat
      a
      ≤ qInvNat
        (sqrtIdx
          m))
      → El (qInvNat
        b
        ≤ qInvNat
          (sqrtIdx
            n))
        → El (Bnd
          (rBound a b)
          (seqOf
            p
            a
            + qNeg
              (seqOf
                p'
                b)))
          → El (qSqrtAt (seqOf p a) (sqrtDepth m) ≤ qSqrtAt (seqOf p' b) (sqrtDepth n) + rBound m n)
  using (real.rBound.eq, sqrtDepth.eq, sqrtIdx.eq, sqrtT.eq) ≔
  λp. λp'. λa. λb. λm. λn. λnn. λda. λdb. λgap. leQTrans
    (qSqrtAt (seqOf p a) (sqrtDepth m))
    (qSqrtAt
      (seqOf p' b)
      (sqrtDepth
        n)
      + qInvNat
        (sqrtDepth
          n) + qOfNat (S (isqrt (sqrtT m n))) * (qInvNat (sqrtDepth m) * qInvNat (sqrtDepth n)))
    (qSqrtAt (seqOf p' b) (sqrtDepth n) + rBound m n)
    (leQSqrtStep
      (rBound a b)
      nn
      (leQAddOfBnd gap)
      (leQTrans
        (rBound a b * qOfNat (sqNat (sqrtDepth m)) * qOfNat (sqNat (sqrtDepth n)))
        (rBound
          (sqrtIdx m)
          (sqrtIdx n) * qOfNat (sqNat (sqrtDepth m)) * qOfNat (sqNat (sqrtDepth n)))
        (qOfNat (sqrtT m n))
        (leQMulMono
          (rBound a b * qOfNat (sqNat (sqrtDepth m)))
          (rBound (sqrtIdx m) (sqrtIdx n) * qOfNat (sqNat (sqrtDepth m)))
          (leQMulMono
            (rBound a b)
            (rBound (sqrtIdx m) (sqrtIdx n))
            (leQAdd (qInvNat a) (qInvNat (sqrtIdx m)) (qInvNat b) (qInvNat (sqrtIdx n)) da db)
            (leQZeroNat (sqNat (sqrtDepth m))))
          (leQZeroNat (sqNat (sqrtDepth n))))
        (leQOfEq
          (rBound
            (sqrtIdx m)
            (sqrtIdx n) * qOfNat (sqNat (sqrtDepth m)) * qOfNat (sqNat (sqrtDepth n)))
          (qOfNat (sqrtT m n))
          (scaleEq (sqrtDepth m) (sqrtDepth n)))))
    (leQTrans
      (qSqrtAt
        (seqOf p' b)
        (sqrtDepth
          n)
        + qInvNat
          (sqrtDepth
            n) + qOfNat (S (isqrt (sqrtT m n))) * (qInvNat (sqrtDepth m) * qInvNat (sqrtDepth n)))
      (qSqrtAt
        (seqOf p' b)
        (sqrtDepth n) + qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n)))
      (qSqrtAt (seqOf p' b) (sqrtDepth n) + rBound m n)
      (leQPlusMonoL
        (qOfNat (S (isqrt (sqrtT m n))) * (qInvNat (sqrtDepth m) * qInvNat (sqrtDepth n)))
        (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n))
        (qSqrtAt (seqOf p' b) (sqrtDepth n) + qInvNat (sqrtDepth n))
        (sqrtSlack m n))
      (transport
        Q
        (λw. w ≤ qSqrtAt (seqOf p' b) (sqrtDepth n) + rBound m n)
        (qSqrtAt
          (seqOf p' b)
          (sqrtDepth n) + (qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n))))
        (qSqrtAt
          (seqOf p' b)
          (sqrtDepth n) + qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n)))
        (sym
          Q
          (qSqrtAt
            (seqOf p' b)
            (sqrtDepth n) + qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n)))
          (qSqrtAt
            (seqOf p' b)
            (sqrtDepth
              n) + (qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n))))
          (qAddAssoc
            (qSqrtAt (seqOf p' b) (sqrtDepth n))
            (qInvNat (sqrtDepth n))
            (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n))))
        (leQPlusMonoL
          (qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n)))
          (rBound m n)
          (qSqrtAt (seqOf p' b) (sqrtDepth n))
          (transport
            Q
            (λw. qInvNat (sqrtDepth n) + (qInvNat (sqrtDepth m) + qInvNat (sqrtDepth n)) ≤ w)
            (qInvNat
              (sqrtDepth
                m) + qInvNat (sqrtDepth m) + (qInvNat (sqrtDepth n) + qInvNat (sqrtDepth n)))
            (rBound m n)
            rBoundHalves
            (slackFits (leQZeroInvNat (sqrtDepth m)))))))

-- ===== use 1: regularity =====
def sqrtSeqNN : El RSeq → El (ℕ → Q) ≔ λp. λn. qSqrtAt (seqOf p (sqrtIdx n)) (sqrtDepth n)

def sqrtRegAtNN : (p : El RSeq)
  (nn : (n : ℕ) → El (qZero ≤ seqOf p n))
  (m n : ℕ)
  → El (Bnd (rBound m n) (sqrtSeqNN p m + qNeg (sqrtSeqNN p n)))
  using (sqrtSeqNN.eq) ≔
  λp. λnn. λm. λn. bndOfBothLe
    (sqrtSeqNN p m)
    (sqrtSeqNN p n)
    (leQSubShift
      (sqrtSeqNN p m)
      (sqrtSeqNN p n)
      (sqrtDirGen
        p
        (nn (sqrtIdx m))
        (leQRefl (qInvNat (sqrtIdx m)))
        (leQRefl (qInvNat (sqrtIdx n)))
        (regBnd (seqOf p) (regOf p) (sqrtIdx m) (sqrtIdx n))))
    (transport
      Q
      (λw. sqrtSeqNN p n + qNeg (sqrtSeqNN p m) ≤ w)
      (rBound n m)
      (rBound m n)
      (rBoundSym n m)
      (leQSubShift
        (sqrtSeqNN p n)
        (sqrtSeqNN p m)
        (sqrtDirGen
          p
          (nn (sqrtIdx n))
          (leQRefl (qInvNat (sqrtIdx n)))
          (leQRefl (qInvNat (sqrtIdx m)))
          (regBnd (seqOf p) (regOf p) (sqrtIdx n) (sqrtIdx m)))))

def rSqrtNN : (p : El RSeq) → ((n : ℕ) → El (qZero ≤ seqOf p n)) → El RSeq
  using (real.RSeq.unfold) ≔
  λp. λnn. sqrtSeqNN p, bndReg (sqrtRegAtNN p nn)

-- ===== use 2: any two nonnegative presentations agree =====
--
-- This is the whole of brElim's obligation now. With the modulus gone
-- there is nothing else to be independent of.
def rSqrtWDNN : {p p' : El RSeq}
  (nn : (n : ℕ) → El (qZero ≤ seqOf p n))
  (nn' : (n : ℕ) → El (qZero ≤ seqOf p' n))
  → Prf (REq p p') → Prf (REq (rSqrtNN p nn) (rSqrtNN p' nn'))
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    ratBound.Bnd.unfold,
    realNeg.seqOf.eq,
    rSqrtNN.eq,
    sqrtSeqNN.eq) ≔
  λp. λp'. λnn. λnn'. λh. squash-elim h (u. reqOf
    (rSqrtNN p nn)
    (rSqrtNN p' nn')
    (λn. bndOfBothLe
      (sqrtSeqNN p n)
      (sqrtSeqNN p' n)
      (leQSubShift
        (sqrtSeqNN p n)
        (sqrtSeqNN p' n)
        (sqrtDirGen
          p'
          (nn (sqrtIdx n))
          (leQRefl (qInvNat (sqrtIdx n)))
          (leQRefl (qInvNat (sqrtIdx n)))
          (u (sqrtIdx n))))
      (leQSubShift
        (sqrtSeqNN p' n)
        (sqrtSeqNN p n)
        (sqrtDirGen
          p
          (nn' (sqrtIdx n))
          (leQRefl (qInvNat (sqrtIdx n)))
          (leQRefl (qInvNat (sqrtIdx n)))
          (bndSubSym
            (rBound (sqrtIdx n) (sqrtIdx n))
            (seqOf p (sqrtIdx n))
            (seqOf p' (sqrtIdx n))
            (u (sqrtIdx n)))))))

-- ===== the descent =====
def sqrtFromNN : (x : El Real) → El (NonNegPayload x) → El Real
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold) ≔
  λx. λd. class (rSqrtNN (nnRep x d) (nnAt x d))

def sqrtNNConst : (x : El Real) (d d' : El (NonNegPayload x)) → sqrtFromNN x d ≡ sqrtFromNN x d'
  using (real.Real.unfold, real.RSeq.unfold, real.Regular.unfold, sqrtFromNN.eq) ≔
  λx. λd. λd'. realEqOfREq
    (rSqrtNN (nnRep x d) (nnAt x d))
    (rSqrtNN (nnRep x d') (nnAt x d'))
    (rSqrtWDNN
      (nnAt x d)
      (nnAt x d')
      (reqOfClassEq
        (trans
          Real
          (class (nnRep x d))
          x
          (class (nnRep x d'))
          (nnRepEq x d)
          (sym Real (class (nnRep x d')) x (nnRepEq x d')))))

def realSqrt : (x : El Real) → El (NonNegR x) → El Real using (NonNegR.eq) ≔
  λx. λw. brElim (NonNegPayload x) (sqrtFromNN x) (sqrtNNConst x) w

def realSqrtRep : {x : El Real}
  {d : El (NonNegPayload x)}
  → realSqrt x (br d) ≡ class (rSqrtNN (nnRep x d) (nnAt x d))
  using (real.Real.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    NonNegR.eq,
    bracket.br.eq,
    bracket.brElim.eq,
    sqrtFromNN.eq,
    realSqrt.realSqrt.eq) ≔
  λx. λd. ⋆

-- ===== it computes: √0 = 0 =====
--
-- Statable again, because 0 is in the domain: it has a nonnegative
-- presentation (the zero sequence) even though it has no modulus.
-- Stated for an ARBITRARY witness — brIsProp makes them all equal, so
-- there is nothing to choose.
def qFloorZero : qFloor qZero ≡ Z
  using (ratCeil.qFloor.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq,
    rational.ratZero.eq,
    rational.ratOfInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.den.eq,
    integer.intZero.eq,
    intAbs.intMag.eq,
    intAbs.magPair.eq,
    intAbs.nzMag.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    natDiv.divN.eq,
    natDiv.dmAux.eq,
    natDiv.natCase.eq,
    natMore.∸.eq,
    nat.+.eq) ≔
  ⋆

def isqrtZero : isqrt Z ≡ Z using (natSqrt.isqrt.eq, natSqrt.isqrtAux.eq) ≔ ⋆

def qSqrtAtZero : {D : ℕ} → qSqrtAt qZero D ≡ qZero
  using (ratSqrt.qSqrtAt.eq, ratSqrt.qSqrtNum.eq, ratSqrt.qFl.eq, ratSqrt.qScaled.eq) ≔
  λD. trans
    Q
    (qOfNat (isqrt (qFloor (qZero * qOfNat (sqNat D)))) * qInvNat D)
    (qOfNat Z * qInvNat D)
    qZero
    (cong
      ℕ
      (λw. Q)
      (λw. qOfNat w * qInvNat D)
      (isqrt (qFloor (qZero * qOfNat (sqNat D))))
      Z
      (trans
        ℕ
        (isqrt (qFloor (qZero * qOfNat (sqNat D))))
        (isqrt Z)
        Z
        (cong
          ℕ
          (λw. ℕ)
          (λw. isqrt w)
          (qFloor (qZero * qOfNat (sqNat D)))
          Z
          (trans
            ℕ
            (qFloor (qZero * qOfNat (sqNat D)))
            (qFloor qZero)
            Z
            (cong Q (λw. ℕ) (λw. qFloor w) (qZero * qOfNat (sqNat D)) qZero qMulZeroL)
            qFloorZero))
        isqrtZero))
    (trans
      Q
      (qOfNat Z * qInvNat D)
      (qZero * qInvNat D)
      qZero
      (cong Q (λw. Q) (λw. w * qInvNat D) (qOfNat Z) qZero qOfNatZero)
      qMulZeroL)

def zeroRep : El RSeq using (real.RSeq.unfold) ≔ (λn. qZero), constReg

def zeroNN : (n : ℕ) → El (qZero ≤ seqOf zeroRep n)
  using (real.RSeq.unfold, zeroRep.eq, realNeg.seqOf.eq) ≔
  λn. leQRefl qZero

def rSqrtZeroSeq : rSqrtNN zeroRep zeroNN ≡ zeroRep
  using (real.RSeq.unfold, rSqrtNN.eq, sqrtSeqNN.eq, zeroRep.eq, realNeg.seqOf.eq) ≔
  rseqEq (λn. qSqrtAtZero)

def clsZeroRep : class zeroRep ≡ realZero
  using (real.Real.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.realZero.eq,
    real.realOfQ.eq,
    zeroRep.eq) ≔
  ⋆

def realSqrtZero : (w : El (NonNegR realZero)) → realSqrt realZero w ≡ realZero
  using (real.Real.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    NonNegR.eq,
    bracket.Br.unfold,
    bracket.br.eq) ≔
  λw. quot-elim
    (d. trans
      Real
      (realSqrt realZero (br d))
      (class (rSqrtNN (nnRep realZero d) (nnAt realZero d)))
      realZero
      realSqrtRep
      (trans
        Real
        (class (rSqrtNN (nnRep realZero d) (nnAt realZero d)))
        (class (rSqrtNN zeroRep zeroNN))
        realZero
        (realEqOfREq
          (rSqrtNN (nnRep realZero d) (nnAt realZero d))
          (rSqrtNN zeroRep zeroNN)
          (rSqrtWDNN
            (nnAt realZero d)
            zeroNN
            (reqOfClassEq
              (trans
                Real
                (class (nnRep realZero d))
                realZero
                (class zeroRep)
                (nnRepEq realZero d)
                (sym Real (class zeroRep) realZero clsZeroRep)))))
        (trans
          Real
          (class (rSqrtNN zeroRep zeroNN))
          (class zeroRep)
          realZero
          (cong RSeq (λw. Real) (λw. class w) (rSqrtNN zeroRep zeroNN) zeroRep rSqrtZeroSeq)
          clsZeroRep)))
    w
