-- MAX and MIN on ℝ, POINTWISE. Like |·| (realAbs.nova) and unlike +,
-- the lattice operations are 1-Lipschitz in each argument, so they
-- preserve the regularity modulus and closeness on the nose: no
-- doubled index, no Archimedean argument. ratMax.nova's bndMaxSub is
-- the whole content; everything here is plumbing plus the two
-- order laws.
-- ===== max =====

import rationalQ (Q, +, qNeg, qZero)
import rationalOrder (≤, leQTrans)
import ratBound (Bnd, bndSubEq)
import ratMax (qMax, qMin, leQMaxL, leQMaxR, qMaxLub, leQMinL, leQMinR, qMinGlb, bndMaxSub, bndMinSub, leQAddOfBnd, qMinGlbShift, qMaxComm, qMinComm)
import ratArch (leQSubShift, leQAddShift)
import real (rBound, leQZeroBound, Regular, RSeq, REq, Real, constReg, realOfQ, realZero)
import realNeg (seqOf, regOf, regBnd, bndReg, reqOf, realEqOfREq)
import realSeq (rseqEq, wdOuterOfComm)
import realOrder (RLeP, rleOf, ≤, leQSubZero)
import equality (trans, sym, cong, transport)

def maxSeq : (ℕ → Q) → (ℕ → Q) → ℕ → Q using (rationalQ.Q.unfold) ≔ λf. λg. λn. qMax (f n) (g n)

def maxReg : {f g : ℕ → Q} → Regular f → Regular g → Regular (maxSeq f g)
  using (id.Id.eq,
    ratBound.Bnd.unfold,
    ratMax.qMax.eq,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.Regular.unfold,
    real.rBound.eq,
    realLattice.maxSeq.eq) ≔
  λf. λg. λhf. λhg. bndReg (λm. λn. bndMaxSub _ _ _ _ _ (regBnd _ hf m n) (regBnd _ hg m n))

def rMax : RSeq → RSeq → RSeq using (real.RSeq.unfold) ≔
  λx. λy. maxSeq (seqOf x) (seqOf y), maxReg (regOf x) (regOf y)

def rMaxWDInner : (x : RSeq) {y y' : RSeq} → REq y y' → REq (rMax x y) (rMax x y')
  using (id.Id.eq,
    ratBound.Bnd.unfold,
    ratMax.qMax.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.maxSeq.eq,
    realLattice.rMax.eq,
    realNeg.seqOf.eq) ≔
  λx. λy. λy'. λh. squash-elim h (u. reqOf
    _
    _
    (λn. bndMaxSub
      _
      _
      _
      (seqOf y n)
      (seqOf y' n)
      (bndSubEq _ (seqOf x n) (seqOf x n) (leQZeroBound n n) ⋆)
      (u n)))

def rMaxWDInnerCls : (x y y' : RSeq) (h : REq y y') → class (rMax x y) ≡ class (rMax x y') ∈ Real
  using (real.Real.unfold) ≔
  λx. λy. λy'. λh. realEqOfREq _ _ (rMaxWDInner x h)

-- max on representatives is commutative on the nose, so the outer
-- descent is the inner one with the arguments swapped
def rMaxComm : (x y : RSeq) → rMax x y ≡ rMax y x
  using (ratMax.qMax.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    realLattice.maxSeq.eq,
    realLattice.rMax.eq,
    realNeg.seqOf.eq) ≔
  λx. λy. rseqEq (λn. qMaxComm (seqOf x n) (seqOf y n))

def rMaxWDOuterCls : {x x' c : RSeq} (h : REq x x') → class (rMax x c) ≡ class (rMax x' c) ∈ Real
  using (real.Real.unfold) ≔
  wdOuterOfComm rMax rMaxComm rMaxWDInnerCls

def rMaxWDOuter : (x x' : RSeq)
  (h : REq x x')
  (v : Real)
  → quot-elim (w. Real) (q. class (rMax x q)) v ≡ quot-elim (q. class (rMax x' q)) v
  using (rMaxWDInnerCls, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold) ≔
  λx. λx'. λh. λv. quot-elim (w. quot-elim (z. Real)
    (q. class (rMax x q))
    w ≡ quot-elim (q. class (rMax x' q)) w)
    (c. rMaxWDOuterCls h)
    v

def realMax : Real → Real → Real
  using (rMaxWDInnerCls,
    rMaxWDOuter,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold) ≔
  λu. λv. quot-elim (p. quot-elim (q. class (rMax p q)) v) u

def realMaxCls : (x y : RSeq) → realMax (class x) (class y) ≡ class (rMax x y)
  using (real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMax.eq,
    realLattice.realMax.eq) ≔
  λx. λy. ⋆

-- ===== min =====
def minSeq : (ℕ → Q) → (ℕ → Q) → ℕ → Q using (rationalQ.Q.unfold) ≔ λf. λg. λn. qMin (f n) (g n)

def minReg : {f g : ℕ → Q} → Regular f → Regular g → Regular (minSeq f g)
  using (id.Id.eq,
    ratBound.Bnd.unfold,
    ratMax.qMin.eq,
    rationalOrder.Sign.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.Q.unfold,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.Regular.unfold,
    real.rBound.eq,
    realLattice.minSeq.eq) ≔
  λf. λg. λhf. λhg. bndReg (λm. λn. bndMinSub _ _ _ _ _ (regBnd _ hf m n) (regBnd _ hg m n))

def rMin : RSeq → RSeq → RSeq using (real.RSeq.unfold) ≔
  λx. λy. minSeq (seqOf x) (seqOf y), minReg (regOf x) (regOf y)

def rMinWDInner : (x : RSeq) {y y' : RSeq} → REq y y' → REq (rMin x y) (rMin x y')
  using (id.Id.eq,
    ratBound.Bnd.unfold,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.eq,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.minSeq.eq,
    realLattice.rMin.eq,
    realNeg.seqOf.eq) ≔
  λx. λy. λy'. λh. squash-elim h (u. reqOf
    _
    _
    (λn. bndMinSub
      _
      _
      _
      (seqOf y n)
      (seqOf y' n)
      (bndSubEq _ (seqOf x n) (seqOf x n) (leQZeroBound n n) ⋆)
      (u n)))

def rMinWDInnerCls : (x y y' : RSeq) (h : REq y y') → class (rMin x y) ≡ class (rMin x y') ∈ Real
  using (real.Real.unfold) ≔
  λx. λy. λy'. λh. realEqOfREq _ _ (rMinWDInner x h)

def rMinComm : (x y : RSeq) → rMin x y ≡ rMin y x
  using (ratMax.qMax.eq,
    ratMax.qMin.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    realLattice.minSeq.eq,
    realLattice.rMin.eq,
    realNeg.seqOf.eq) ≔
  λx. λy. rseqEq (λn. qMinComm (seqOf x n) (seqOf y n))

def rMinWDOuterCls : {x x' c : RSeq} (h : REq x x') → class (rMin x c) ≡ class (rMin x' c) ∈ Real
  using (real.Real.unfold) ≔
  wdOuterOfComm rMin rMinComm rMinWDInnerCls

def rMinWDOuter : (x x' : RSeq)
  (h : REq x x')
  (v : Real)
  → quot-elim (w. Real) (q. class (rMin x q)) v ≡ quot-elim (q. class (rMin x' q)) v
  using (rMinWDInnerCls, real.REq.unfold, real.RSeq.unfold, real.Real.unfold, real.Regular.unfold) ≔
  λx. λx'. λh. λv. quot-elim (w. quot-elim (z. Real)
    (q. class (rMin x q))
    w ≡ quot-elim (q. class (rMin x' q)) w)
    (c. rMinWDOuterCls h)
    v

def realMin : Real → Real → Real
  using (rMinWDInnerCls,
    rMinWDOuter,
    real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold) ≔
  λu. λv. quot-elim (p. quot-elim (q. class (rMin p q)) v) u

def realMinCls : (x y : RSeq) → realMin (class x) (class y) ≡ class (rMin x y)
  using (real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMin.eq,
    realLattice.realMin.eq) ≔
  λx. λy. ⋆

-- ===== the lattice laws =====
def rleMaxL : {x y : RSeq} → RLeP x (rMax x y)
  using (id.Id.eq,
    ratMax.qMax.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.maxSeq.eq,
    realLattice.rMax.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. rleOf
    _
    _
    (λn. leQTrans
      (seqOf x n + qNeg (qMax (seqOf x n) (seqOf y n)))
      _
      _
      (leQSubZero (leQMaxL (seqOf x n) (seqOf y n)))
      (leQZeroBound n n))

def rleMaxR : {x y : RSeq} → RLeP y (rMax x y)
  using (id.Id.eq,
    ratMax.qMax.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.maxSeq.eq,
    realLattice.rMax.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. rleOf
    _
    _
    (λn. leQTrans
      (seqOf y n + qNeg (qMax (seqOf x n) (seqOf y n)))
      _
      _
      (leQSubZero (leQMaxR (seqOf x n) (seqOf y n)))
      (leQZeroBound n n))

-- least upper bound: the two shifted ≤'s combine by qMaxLub and shift back
def rMaxLub : {x y z : RSeq} → RLeP x z → RLeP y z → RLeP (rMax x y) z
  using (id.Id.eq,
    ratMax.qMax.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnCases.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.maxSeq.eq,
    realLattice.rMax.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. λz. λh1. λh2. squash-elim h1 (u. squash-elim h2 (v. rleOf
    _
    _
    (λn. leQSubShift
      (qMax (seqOf x n) (seqOf y n))
      _
      (qMaxLub (leQAddShift _ (u n)) (leQAddShift _ (v n))))))

def rleMinL : {x y : RSeq} → RLeP (rMin x y) x
  using (id.Id.eq,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.minSeq.eq,
    realLattice.rMin.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. rleOf
    _
    _
    (λn. leQTrans
      (qMin (seqOf x n) (seqOf y n) + qNeg (seqOf x n))
      _
      _
      (leQSubZero (leQMinL (seqOf x n) (seqOf y n)))
      (leQZeroBound n n))

def rleMinR : {x y : RSeq} → RLeP (rMin x y) y
  using (id.Id.eq,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.minSeq.eq,
    realLattice.rMin.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. rleOf
    _
    _
    (λn. leQTrans
      (qMin (seqOf x n) (seqOf y n) + qNeg (seqOf y n))
      _
      _
      (leQSubZero (leQMinR (seqOf x n) (seqOf y n)))
      (leQZeroBound n n))

def rMinGlb : {x y z : RSeq} → RLeP z x → RLeP z y → RLeP z (rMin x y)
  using (id.Id.eq,
    ratMax.qMax.eq,
    ratMax.qMin.eq,
    rational.ratAdd.eq,
    rational.ratNeg.eq,
    rationalOrder.≤.unfold,
    rationalOrder.NonNegS.unfold,
    rationalOrder.Sign.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.+.eq,
    rationalQ.qNeg.eq,
    real.RSeq.unfold,
    real.Regular.unfold,
    real.qInvNat.eq,
    real.rBound.eq,
    realLattice.minSeq.eq,
    realLattice.rMin.eq,
    realNeg.seqOf.eq,
    realOrder.RLeP.unfold) ≔
  λx. λy. λz. λh1. λh2. squash-elim h1 (u. squash-elim h2 (v. rleOf
    _
    _
    (λn. leQSubShift
      _
      (qMin (seqOf x n) (seqOf y n))
      (qMinGlbShift _ _ _ _ (leQAddShift _ (u n)) (leQAddShift _ (v n))))))

-- ===== lifted to ℝ =====
def leRMaxL : (u v : Real) → (u ≤ realMax u v)
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMax.eq,
    realLattice.realMax.eq,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.eq) ≔
  λu. λv. quot-elim (x. quot-elim (y. rleMaxL) v) u

def leRMaxR : (u v : Real) → (v ≤ realMax u v)
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMax.eq,
    realLattice.realMax.eq,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.eq) ≔
  λu. λv. quot-elim (x. quot-elim (y. rleMaxR) v) u

def leRMinL : (u v : Real) → (realMin u v ≤ u)
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMin.eq,
    realLattice.realMin.eq,
    realLattice.realMin.unfold,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.eq) ≔
  λu. λv. quot-elim (x. quot-elim (y. rleMinL) v) u

def leRMinR : (u v : Real) → (realMin u v ≤ v)
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMin.eq,
    realLattice.realMin.eq,
    realLattice.realMin.unfold,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.eq) ≔
  λu. λv. quot-elim (x. quot-elim (y. rleMinR) v) u

def leRMaxLub : (u v w : Real) → (u ≤ w) → (v ≤ w) → (realMax u v ≤ w)
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMax.eq,
    realLattice.rMaxLub.eq,
    realLattice.realMax.eq,
    realLattice.realMax.unfold,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.eq,
    realOrder.RLeP.unfold,
    realOrder.leRCls) ≔
  λu. λv. λw. quot-elim (x. quot-elim (y. quot-elim (z. λp. λq. rMaxLub p q) w) v) u

def leRMinGlb : (u v w : Real) → (w ≤ u) → (w ≤ v) → (w ≤ realMin u v)
  using (real.REq.unfold,
    real.RSeq.unfold,
    real.Real.unfold,
    real.Regular.unfold,
    realLattice.rMin.eq,
    realLattice.rMinGlb.eq,
    realLattice.realMin.eq,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.eq,
    realOrder.RLeP.unfold,
    realOrder.leRCls) ≔
  λu. λv. λw. quot-elim (x. quot-elim (y. quot-elim (z. λp. λq. rMinGlb p q) w) v) u
