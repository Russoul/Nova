-- The constructive reals: REGULAR sequences of rationals (Bishop),
-- quotiented by eventual closeness. Everything below the quotient is
-- DATA — the modulus is baked into regularity (|x_m − x_n| bounded by
-- 1/(m+1) + 1/(n+1)), stated two-sidedly so no absolute value is
-- needed, with LeQ-codes as the bounds. A bound IS its witness, so no
-- choice principle enters anywhere downstream.
-- 1/(n+1), and its positivity (the nz layer computes the sign)

import integer (Int, intOne)
import integerMul (*)
import rational (NZ, nzPos, nzOne, nzMul, nzToInt, mkRat, Rat)
import rationalQ (Q, qcls, +, qNeg, qZero, qOne, qAddNegR, qNegNeg, nzToIntMul)
import rationalOrder (Sign, sPos, sZero, nzSgn, intSgn, intSgnNz, sgnQ, sgnQZero, NonNegS, ≤, sgnQAddPos)
import equality (trans, sym, cong, transport)
import id (Id, eqToId)

def qInvNat : ℕ → El Q using (rationalQ.Q.unfold) ≔ λn. qcls (mkRat intOne (nzPos n))

def qInvNatPos : (n : ℕ) → sgnQ (qInvNat n) ≡ sPos
  using (eqInt.intCanon.eq,
    eqInt.intCanonClass.eq,
    intNonZero.nzOfInt.eq,
    intNonZero.nzOfIntAt.eq,
    integer.intOne.eq,
    integerMul.*.eq,
    rational.denInt.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.nzMul.eq,
    rational.nzOne.eq,
    rational.nzPos.eq,
    rational.nzToInt.eq,
    rationalInv.intCanonProdZero.eq,
    rationalOrder.Sign.unfold,
    rationalOrder.intSgn.eq,
    rationalOrder.nzSgn.eq,
    rationalOrder.ratSgn.eq,
    rationalOrder.sNeg.eq,
    rationalOrder.sPos.eq,
    rationalOrder.sZero.eq,
    rationalOrder.sgnQ.eq,
    rationalQ.qcls.eq,
    real.qInvNat.eq) ≔
  λn. trans
    Sign
    (sgnQ (qInvNat n))
    (intSgn (nzToInt (nzMul nzOne (nzPos n))))
    sPos
    (cong
      Int
      (λv. Sign)
      (λv. intSgn v)
      (nzToInt nzOne * nzToInt (nzPos n))
      (nzToInt (nzMul nzOne (nzPos n)))
      (sym
        Int
        (nzToInt (nzMul nzOne (nzPos n)))
        (nzToInt nzOne * nzToInt (nzPos n))
        (nzToIntMul nzOne (nzPos n))))
    (trans
      Sign
      (intSgn (nzToInt (nzMul nzOne (nzPos n))))
      (nzSgn (nzMul nzOne (nzPos n)))
      sPos
      (intSgnNz (nzMul nzOne (nzPos n)))
      ⋆)

-- the regularity bound 1/(m+1) + 1/(n+1), positive
def rBound : ℕ → ℕ → El Q using (rationalQ.Q.unfold) ≔ λm. λn. qInvNat m + qInvNat n

def rBoundPos : {m n : ℕ} → sgnQ (rBound m n) ≡ sPos
  using (rationalQ.+.eq, real.qInvNat.eq, real.rBound.eq) ≔
  λm. λn. sgnQAddPos (qInvNat m) (qInvNat n) (qInvNatPos m) (qInvNatPos n)

def qNegZero : qNeg qZero ≡ qZero
  using (integer.intNeg.eq,
    integer.intZero.eq,
    rational.den.eq,
    rational.mkRat.eq,
    rational.num.eq,
    rational.ratNeg.eq,
    rational.ratOfInt.eq,
    rational.ratZero.eq,
    rationalQ.Q.unfold,
    rationalQ.qNeg.eq,
    rationalQ.qZero.eq,
    rationalQ.qcls.eq) ≔
  ⋆

-- −(bound) ≤ 0 ≤ bound
def leQNegBoundZero : {m n : ℕ} → El (qNeg (rBound m n) ≤ qZero)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λm. λn. inj₂ (eqToId
    (sgnQ (qZero + qNeg (qNeg (rBound m n))))
    sPos
    (trans
      Sign
      (sgnQ (qZero + qNeg (qNeg (rBound m n))))
      (sgnQ (rBound m n))
      sPos
      (cong
        Q
        (λv. Sign)
        (λv. sgnQ v)
        (qZero + qNeg (qNeg (rBound m n)))
        (rBound m n)
        (trans
          Q
          (qZero + qNeg (qNeg (rBound m n)))
          (qNeg (qNeg (rBound m n)))
          (rBound m n)
          (rationalQ.qAddZeroL (qNeg (qNeg (rBound m n))))
          (qNegNeg (rBound m n))))
      rBoundPos))

def leQZeroBound : (m n : ℕ) → El (qZero ≤ rBound m n)
  using (rationalOrder.≤.unfold, rationalOrder.NonNegS.unfold) ≔
  λm. λn. inj₂ (eqToId
    (sgnQ (rBound m n + qNeg qZero))
    sPos
    (trans
      Sign
      (sgnQ (rBound m n + qNeg qZero))
      (sgnQ (rBound m n))
      sPos
      (cong
        Q
        (λv. Sign)
        (λv. sgnQ v)
        (rBound m n + qNeg qZero)
        (rBound m n)
        (trans
          Q
          (rBound m n + qNeg qZero)
          (rBound m n + qZero)
          (rBound m n)
          (cong Q (λv. Q) (λv. rBound m n + v) (qNeg qZero) qZero qNegZero)
          (rationalQ.qAddZeroR (rBound m n))))
      rBoundPos))

-- ===== the carrier =====
-- regularity, two-sided: −(1/(m+1)+1/(n+1)) ≤ f m − f n ≤ ⋯
def Regular : El (ℕ → Q) → 𝕌 ≔
  λf. (m n : ℕ) → qNeg (rBound m n) ≤ f m + qNeg (f n) ⨯ f m + qNeg (f n) ≤ rBound m n

def RSeq : 𝕌 ≔ (f : ℕ → Q) ⨯ Regular f

-- eventual closeness: |x_n − y_n| ≤ 2/(n+1), squashed — the relation
-- is a PROPOSITION (Ω), as a quotient's must be
def REq : El RSeq → El RSeq → Ω using (real.RSeq.unfold) ≔
  λx. λy. ∥El ((n : ℕ)
    → qNeg (rBound n n) ≤ x .π₁ n + qNeg (y .π₁ n) ⨯ x .π₁ n + qNeg (y .π₁ n) ≤ rBound n n)∥

def Real : 𝕌 ≔ RSeq / (x y. REq x y)

-- ===== ℚ embeds =====
-- a constant sequence is regular: its differences are zero, and the
-- zero-bounds transport along q − q ≡ 0
def constReg : {q : El Q} → El (Regular (λn. q)) using (real.Regular.unfold) ≔
  λq. λm. λn. transport
    Q
    (λw. qNeg (rBound m n) ≤ w)
    qZero
    (q + qNeg q)
    (sym Q (q + qNeg q) qZero (qAddNegR q))
    leQNegBoundZero,
    transport
      Q
      (λw. w ≤ rBound m n)
      qZero
      (q + qNeg q)
      (sym Q (q + qNeg q) qZero (qAddNegR q))
      (leQZeroBound m n)

def realOfQ : El Q → El Real using (real.RSeq.unfold, real.Real.unfold) ≔
  λq. class ((λn. q), constReg)

def realZero : El Real using (real.Real.unfold) ≔ realOfQ qZero

def realOne : El Real using (real.Real.unfold) ≔ realOfQ qOne
