import integer (Int, intOne)
import integerMul (intMul)
import rational (NZ, nzPos, nzOne, nzMul, nzToInt, mkRat, Rat)
import rationalQ (Q, qcls, qAdd, qNeg, qZero, qOne, qAddNegR, qNegNeg, nzToIntMul)
import rationalOrder (Sign, sPos, sZero, nzSgn, intSgn, intSgnNz, sgnQ, sgnQZero,
                      NonNegS, LeQ, sgnQAddPos)
import equality (trans, sym, cong, transport)
import id (Id, eqToId)

-- The constructive reals: REGULAR sequences of rationals (Bishop),
-- quotiented by eventual closeness. Everything below the quotient is
-- DATA — the modulus is baked into regularity (|x_m − x_n| bounded by
-- 1/(m+1) + 1/(n+1)), stated two-sidedly so no absolute value is
-- needed, with LeQ-codes as the bounds. A bound IS its witness, so no
-- choice principle enters anywhere downstream.

-- 1/(n+1), and its positivity (the nz layer computes the sign)
def qInvNat : ℕ → El Q ≔ λn. qcls (mkRat intOne (nzPos n))

def qInvNatPos : (n : ℕ) → sgnQ (qInvNat n) ≡ sPos ∈ El Sign
  using (eqInt.intCanon.eq, eqInt.intCanonClass.eq, intNonZero.nzOfInt.eq, intNonZero.nzOfIntAt.eq, integer.intOne.eq, integerMul.intMul.eq, rational.denInt.eq, rational.mkRat.eq, rational.num.eq, rational.nzMul.eq, rational.nzOne.eq, rational.nzPos.eq, rational.nzToInt.eq, rationalInv.intCanonProdZero.eq, rationalOrder.intSgn.eq, rationalOrder.nzSgn.eq, rationalOrder.ratSgn.eq, rationalOrder.sNeg.eq, rationalOrder.sPos.eq, rationalOrder.sZero.eq, rationalOrder.sgnQ.eq, rationalQ.qcls.eq, real.qInvNat.eq) ≔
  λn.
    trans Sign (sgnQ (qInvNat n)) (intSgn (nzToInt (nzMul nzOne (nzPos n)))) sPos
      (cong Int (λv. Sign) (λv. intSgn v)
         (intMul (nzToInt nzOne) (nzToInt (nzPos n)))
         (nzToInt (nzMul nzOne (nzPos n)))
         (sym Int (nzToInt (nzMul nzOne (nzPos n)))
              (intMul (nzToInt nzOne) (nzToInt (nzPos n)))
              (nzToIntMul nzOne (nzPos n))))
      (trans Sign (intSgn (nzToInt (nzMul nzOne (nzPos n))))
             (nzSgn (nzMul nzOne (nzPos n))) sPos
         (intSgnNz (nzMul nzOne (nzPos n)))
         ⋆)

-- the regularity bound 1/(m+1) + 1/(n+1), positive
def rBound : ℕ → ℕ → El Q ≔ λm. λn. qAdd (qInvNat m) (qInvNat n)

def rBoundPos : (m : ℕ) (n : ℕ) → sgnQ (rBound m n) ≡ sPos ∈ El Sign
  using (rationalQ.qAdd.eq, real.qInvNat.eq, real.rBound.eq) ≔
  λm. λn. sgnQAddPos (qInvNat m) (qInvNat n) (qInvNatPos m) (qInvNatPos n)

def qNegZero : qNeg qZero ≡ qZero ∈ El Q using (integer.intNeg.eq, integer.intZero.eq, rational.den.eq, rational.mkRat.eq, rational.num.eq, rational.ratNeg.eq, rational.ratOfInt.eq, rational.ratZero.eq, rationalQ.qNeg.eq, rationalQ.qZero.eq, rationalQ.qcls.eq) ≔ ⋆

-- −(bound) ≤ 0 ≤ bound
def leQNegBoundZero : (m : ℕ) (n : ℕ) →
  El (LeQ (qNeg (rBound m n)) qZero) ≔
  λm. λn.
    inj₂ (eqToId Sign (sgnQ (qAdd qZero (qNeg (qNeg (rBound m n))))) sPos
      (trans Sign (sgnQ (qAdd qZero (qNeg (qNeg (rBound m n)))))
             (sgnQ (rBound m n)) sPos
         (cong Q (λv. Sign) (λv. sgnQ v)
            (qAdd qZero (qNeg (qNeg (rBound m n)))) (rBound m n)
            (trans Q (qAdd qZero (qNeg (qNeg (rBound m n))))
                   (qNeg (qNeg (rBound m n))) (rBound m n)
               (rationalQ.qAddZeroL (qNeg (qNeg (rBound m n))))
               (qNegNeg (rBound m n))))
         (rBoundPos m n)))

def leQZeroBound : (m : ℕ) (n : ℕ) →
  El (LeQ qZero (rBound m n)) ≔
  λm. λn.
    inj₂ (eqToId Sign (sgnQ (qAdd (rBound m n) (qNeg qZero))) sPos
      (trans Sign (sgnQ (qAdd (rBound m n) (qNeg qZero))) (sgnQ (rBound m n)) sPos
         (cong Q (λv. Sign) (λv. sgnQ v)
            (qAdd (rBound m n) (qNeg qZero)) (rBound m n)
            (trans Q (qAdd (rBound m n) (qNeg qZero)) (qAdd (rBound m n) qZero)
                   (rBound m n)
               (cong Q (λv. Q) (λv. qAdd (rBound m n) v) (qNeg qZero) qZero
                  qNegZero)
               (rationalQ.qAddZeroR (rBound m n))))
         (rBoundPos m n)))

-- ===== the carrier =====

-- regularity, two-sided: −(1/(m+1)+1/(n+1)) ≤ f m − f n ≤ ⋯
def Regular : El (ℕ → Q) → 𝕌 ≔
  λf. ((m : ℕ) (n : ℕ) →
        (LeQ (qNeg (rBound m n)) (qAdd (f m) (qNeg (f n)))
         ⨯ LeQ (qAdd (f m) (qNeg (f n))) (rBound m n)))

def RSeq : 𝕌 ≔ ((f : ℕ → Q) ⨯ Regular f)

-- eventual closeness: |x_n − y_n| ≤ 2/(n+1), squashed — the relation
-- is a PROPOSITION (Ω), as a quotient's must be
def REq : El RSeq → El RSeq → Ω ≔
  λx. λy.
    ∥El ((n : ℕ) →
      (LeQ (qNeg (rBound n n)) (qAdd (x .π₁ n) (qNeg (y .π₁ n)))
       ⨯ LeQ (qAdd (x .π₁ n) (qNeg (y .π₁ n))) (rBound n n)))∥

def Real : 𝕌 ≔ RSeq / (x y. REq x y)

-- ===== ℚ embeds =====

-- a constant sequence is regular: its differences are zero, and the
-- zero-bounds transport along q − q ≡ 0
def constReg : (q : El Q) → El (Regular (λn. q)) ≔
  λq. λm. λn.
    (transport Q (λw. LeQ (qNeg (rBound m n)) w) qZero (qAdd q (qNeg q))
       (sym Q (qAdd q (qNeg q)) qZero (qAddNegR q))
       (leQNegBoundZero m n) ,
     transport Q (λw. LeQ w (rBound m n)) qZero (qAdd q (qNeg q))
       (sym Q (qAdd q (qNeg q)) qZero (qAddNegR q))
       (leQZeroBound m n))

def realOfQ : El Q → El Real ≔ λq. class ((λn. q) , constReg q)

def realZero : El Real ≔ realOfQ qZero
def realOne : El Real ≔ realOfQ qOne
