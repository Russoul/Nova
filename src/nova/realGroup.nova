-- (ℝ, +, −, 0) as a GROUP, in group.nova's vocabulary, plus the
-- rearrangement lemmas every later ℝ argument needs. These mirror
-- rationalOrder.nova's ℚ block one level up: the proofs are the same
-- chains, and they have to be redone because the corpus has no
-- group-generic algebra — the laws live behind Id, and instantiating
-- them costs more than reproving them.

import real (Real, realOfQ, realZero, realOne)
import realNeg (realNeg, realNegNeg)
import realAdd (+, realAddComm, realAddAssoc, realAddZeroL, realAddZeroR, realAddNegL, realAddNegR)
import monoid (IsMonoid)
import group (IsGroup)
import equality (trans, sym, cong)
import id (Id, eqToId, idToEq)

def realAddGroup : El (IsGroup Real) using (group.IsGroup.unfold, monoid.IsMonoid.unfold) ≔
  ((+),
    realZero,
      (λx. λy. λz. eqToId
        _
        _
        (realAddAssoc
          x
          y
          z)),
        (λx. eqToId
          _
          _
          (realAddZeroL
            x)),
          λx. eqToId
            _
            _
            (realAddZeroR
              x)),
    realNeg,
      (λx. eqToId
        (realNeg x + x)
        realZero
        (realAddNegL x)), λx. eqToId (x + realNeg x) realZero (realAddNegR x)

-- ===== rearrangement =====
def realLeftSwap : (b c d : El Real) → b + (c + d) ≡ c + (b + d) ≔
  λb. λc. λd. b + (c + d)
      ≡⟨ sym _ _ _ (realAddAssoc b c d) ⟩ b + c + d
      ≡⟨ cong (λv. Real) (λv. v + d) (realAddComm b c) ⟩ c + b + d
      ≡⟨ realAddAssoc c b d ⟩ c + (b + d)

def realPairSwap : (a b c d : El Real) → a + b + (c + d) ≡ a + c + (b + d) ≔
  λa. λb. λc. λd. a + b + (c + d)
      ≡⟨ realAddAssoc a b (c + d) ⟩ a + (b + (c + d))
      ≡⟨ cong (λv. Real) (λv. a + v) (realLeftSwap b c d) ⟩ a + (c + (b + d))
      ≡⟨ sym _ _ _ (realAddAssoc a c (b + d)) ⟩ a + c + (b + d)

-- ===== inverses =====
def realNegPlusCancel : (u v : El Real) → realNeg u + (u + v) ≡ v ≔
  λu. λv. realNeg u + (u + v)
      ≡⟨ sym _ _ _ (realAddAssoc (realNeg u) u v) ⟩ realNeg u + u + v
      ≡⟨ cong (λw. Real) (λw. w + v) (realAddNegL u) ⟩ realZero + v
      ≡⟨ realAddZeroL v ⟩ v

-- explicit trans, not a chain: a chain step here lands at a
-- type-undetermined position inside realAdd's quot-elim (B-1)
def realNegUnique : (u v : El Real) → (u + v ≡ realZero) → v ≡ realNeg u ≔
  λu. λv. λh. trans
    _
    _
    _
    _
    (sym _ _ _ (realNegPlusCancel u v))
    (trans _ _ _ (realNeg u) (cong (λw. Real) (λw. realNeg u + w) h) (realAddZeroR (realNeg u)))

def realNegAdd : (a b : El Real) → realNeg (a + b) ≡ realNeg a + realNeg b ≔
  λa. λb. sym
    _
    _
    _
    (realNegUnique
      (a + b)
      (realNeg a + realNeg b)
      (a + b + (realNeg a + realNeg b)
          ≡⟨ realPairSwap a b (realNeg a) (realNeg b) ⟩ a + realNeg a + (b + realNeg b)
          ≡⟨ cong (λw. Real) (λw. w + (b + realNeg b)) (realAddNegR a) ⟩ realZero + (b + realNeg b)
          ≡⟨ realAddZeroL (b + realNeg b) ⟩ b + realNeg b
          ≡⟨ realAddNegR b ⟩ realZero))

-- ===== subtraction =====
infixl 6 -
def - : El Real → El Real → El Real using (real.Real.unfold) ≔ λu. λv. u + realNeg v

def realSubSelf : {u : El Real} → u - u ≡ realZero
  using (real.Real.unfold, realAdd.+.eq, realGroup.-.eq, realNeg.realNeg.eq) ≔
  λu. realAddNegR u

def realSubZero : (u : El Real) → u - realZero ≡ u
  using (real.Real.unfold, real.realZero.eq, realAdd.+.eq, realGroup.-.eq, realNeg.realNeg.eq) ≔
  λu. trans _ _ (u + realZero) _ (cong (λw. Real) (λw. u + w) realNeg.realNegZero) (realAddZeroR u)

-- (u − v) + (v − w) ≡ u − w : the three-term split
def realSubVia : {u v w : El Real} → u - v + (v - w) ≡ u - w ≔
  λu. λv. λw. u + realNeg v + (v + realNeg w)
      ≡⟨ realAddAssoc u (realNeg v) (v + realNeg w) ⟩ u + (realNeg v + (v + realNeg w))
      ≡⟨ cong (λz. Real) (λz. u + z) (realNegPlusCancel v (realNeg w)) ⟩ u + realNeg w

-- −(u − v) ≡ v − u
def realNegSub : {u v : El Real} → realNeg (u - v) ≡ v - u ≔
  λu. λv. realNeg (u + realNeg v)
      ≡⟨ realNegAdd u (realNeg v) ⟩ realNeg u + realNeg (realNeg v)
      ≡⟨ cong (λz. Real) (λz. realNeg u + z) (realNegNeg v) ⟩ realNeg u + v
      ≡⟨ realAddComm (realNeg u) v ⟩ v + realNeg u

-- (u − v) + v ≡ u, and hence a zero difference is an equality
def realSubPlusCancel : (u v : El Real) → u - v + v ≡ u ≔
  λu. λv. u + realNeg v + v
      ≡⟨ realAddAssoc u (realNeg v) v ⟩ u + (realNeg v + v)
      ≡⟨ cong (λw. Real) (λw. u + w) (realAddNegL v) ⟩ u + realZero
      ≡⟨ realAddZeroR u ⟩ u

def realSubZeroInv : {u v : El Real} → (u - v ≡ realZero) → u ≡ v ≔
  λu. λv. λh. trans
    _
    _
    _
    _
    (sym _ _ _ (realSubPlusCancel u v))
    (trans _ _ _ v (cong (λw. Real) (λw. w + v) h) (realAddZeroL v))
