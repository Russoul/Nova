-- ℤ/nℤ — the abstract machinery, run on a real group.
--
-- Everything above this file is stated at an abstract (G , g); this is
-- the check that it can be INSTANTIATED, and it is short because the
-- only things an instance has to supply are three bridges and three
-- closure proofs.
--
-- The bridges say what intGroup.intAddGroup's projections are. Naming
-- them once means no later item ever normalises through a spine of
-- .π₁s to find out that gop Int intAddGroup is intAdd.

import id (Id, idToEq, eqToId)
import integer (Int, intZero, intOne, intNeg, intNegZero)
import integerAdd (+, intAddComm, intAddAssoc)
import integerMul (*, intMulZeroR, intMulOneR, intMulDistribL, intMulNegR, intMulAssoc, intMulComm)
import rational (intAddZeroL, intAddZeroR)
import intGroup (intAddGroup, intAddMonoid)
import monoid (IsMonoid)
import group (IsGroup)
import groupTheory (gop, ge, ginv)
import subgroup (IsSubgroup, IsNormal, sgIntro, sgUnit, sgOp, sgInv, abelianNormal, cosetRel)
import quotGroup (QGroup, qcls, qclsEq, qclsEffective, qMul, qMulCls, qInv, qUnit, qIsGroup)
import ring (IsCommRing)
import ringTheory (raddGroup, rmul, rone)
import ideal (IsIdeal, idIntro, idSub, idScale, idNormal)
import intRing (intCommRing)
import quotRing (QRing, qrCls, qrMul, qrOne, qrAdd, qrAddGroup, qrIsCommRing)
import equality (transportP, sym, trans, cong)

def intGop : (x y : El Int) → gop Int intAddGroup x y ≡ x + y
  using (groupTheory.gop.eq, intGroup.intAddGroup.eq) ≔
  λx. λy. ⋆

def intGe : ge intAddGroup ≡ intZero using (groupTheory.ge.eq, intGroup.intAddGroup.eq) ≔ ⋆

def intGinv : (x : El Int) → ginv Int intAddGroup x ≡ intNeg x
  using (groupTheory.ginv.eq, intGroup.intAddGroup.eq) ≔
  λx. ⋆

-- ℤ is abelian, in the group-theoretic vocabulary
def intGopComm : (x y : El Int) → gop Int intAddGroup x y ≡ gop Int intAddGroup y x ≔
  λx. λy. trans
    Int
    (gop Int intAddGroup x y)
    (x + y)
    (gop Int intAddGroup y x)
    (intGop x y)
    (trans
      Int
      (x + y)
      (y + x)
      (gop Int intAddGroup y x)
      (intAddComm x y)
      (sym Int (gop Int intAddGroup y x) (y + x) (intGop y x)))

-- ===== nℤ =====
--
-- "x is a multiple of n", with the witness under an Ω-squash: the
-- predicate a quotient's relation must be Ω-valued (ty-quot), and
-- nothing below ever needs the multiplier back as data — the three
-- closure proofs each unpack their hypotheses and repackage a new
-- witness, which is exactly what el-squash-e-prf allows.
def nZfib : El Int → El Int → 𝕌 ≔ λn. λx. (k : Int) ⨯ Id Int (n * k) x

def nZ : El Int → El Int → Ω ≔ λn. λx. ∥El (nZfib n x)∥

def nZIntro : (n x k : El Int) → (n * k ≡ x) → Prf (nZ n x) using (nZ.eq, nZfib.unfold) ≔
  λn. λx. λk. λe. ⋆ (k, eqToId (n * k) x e)

-- 0 = n · 0
def nZUnit : (n : El Int) → Prf (nZ n (ge intAddGroup)) ≔
  λn. nZIntro
    n
    (ge intAddGroup)
    intZero
    (trans
      Int
      (n * intZero)
      intZero
      (ge intAddGroup)
      intMulZeroR
      (sym Int (ge intAddGroup) intZero intGe))

-- n·k₁ + n·k₂ = n·(k₁+k₂)
def nZOp : (n x y : El Int) → Prf (nZ n x) → Prf (nZ n y) → Prf (nZ n (gop Int intAddGroup x y))
  using (nZ.eq, nZfib.unfold) ≔
  λn. λx. λy. λhx. λhy. squash-elim hx (u. squash-elim hy (v. nZIntro
    n
    (gop Int intAddGroup x y)
    (u .π₁ + v .π₁)
    (n * (u .π₁ + v .π₁)
        ≡⟨ intMulDistribL n (u .π₁) (v .π₁) ⟩ n * u .π₁ + n * v .π₁
        ≡⟨ cong
          Int
          (λw. Int)
          (λw. w + n * v .π₁)
          (n * u .π₁)
          x
          (idToEq Int (n * u .π₁) x (u .π₂)) ⟩ x + n * v .π₁
        ≡⟨ cong Int (λw. Int) (λw. x + w) (n * v .π₁) y (idToEq Int (n * v .π₁) y (v .π₂)) ⟩ x + y
        ≡⟨ sym Int (gop Int intAddGroup x y) (x + y) (intGop x y) ⟩ gop Int intAddGroup x y)))

-- n·(−k) = −(n·k)
def nZInv : (n x : El Int) → Prf (nZ n x) → Prf (nZ n (ginv Int intAddGroup x))
  using (nZ.eq, nZfib.unfold) ≔
  λn. λx. λhx. squash-elim hx (u. nZIntro
    n
    (ginv Int intAddGroup x)
    (intNeg (u .π₁))
    (n * intNeg (u .π₁)
        ≡⟨ intMulNegR n (u .π₁) ⟩ intNeg (n * u .π₁)
        ≡⟨ cong
          Int
          (λw. Int)
          (λw. intNeg w)
          (n * u .π₁)
          x
          (idToEq Int (n * u .π₁) x (u .π₂)) ⟩ intNeg x
        ≡⟨ sym Int (ginv Int intAddGroup x) (intNeg x) (intGinv x) ⟩ ginv Int intAddGroup x))

def nZIsSubgroup : (n : El Int) → Prf (IsSubgroup Int intAddGroup (nZ n)) ≔
  λn. sgIntro (nZUnit n) (nZOp n) (nZInv n)

-- ...and normal for free, ℤ being abelian
def nZIsNormal : {n : El Int} → Prf (IsNormal Int intAddGroup (nZ n)) ≔ λn. abelianNormal intGopComm

-- ===== ℤ/nℤ =====
def IntMod : El Int → 𝕌 ≔ λn. QGroup Int intAddGroup (nZ n)

def intModGroup : (n : El Int) → El (IsGroup (IntMod n)) using (IntMod.eq) ≔
  λn. qIsGroup Int intAddGroup (nZ n) (nZIsSubgroup n) nZIsNormal

def intModCls : {n : El Int} → El Int → El (IntMod n) using (IntMod.eq) ≔
  λn. qcls Int intAddGroup (nZ n)

-- every multiple of n is zero in ℤ/nℤ — the defining property, at
-- abstract n and k, with no numeral in sight
def intModMulZero : {n k : El Int} → intModCls (n * k) ≡ intModCls intZero ∈ El (IntMod n)
  using (intModCls.eq, subgroup.cosetRel.eq) ≔
  λn. λk. qclsEq
    (nZIsSubgroup n)
    (n * k)
    intZero
    (nZIntro
      n
      (gop Int intAddGroup (n * k) (ginv Int intAddGroup intZero))
      k
      (n * k
          ≡⟨ sym Int (n * k + intZero) (n * k) (intAddZeroR (n * k)) ⟩ n * k + intZero
          ≡⟨ cong
            Int
            (λw. Int)
            (λw. n * k + w)
            intZero
            (ginv Int intAddGroup intZero)
            (sym
              Int
              (ginv Int intAddGroup intZero)
              intZero
              (trans
                Int
                (ginv Int intAddGroup intZero)
                (intNeg intZero)
                intZero
                (intGinv intZero)
                intNegZero)) ⟩ n * k + ginv Int intAddGroup intZero
          ≡⟨ sym
            Int
            (gop Int intAddGroup (n * k) (ginv Int intAddGroup intZero))
            (n * k + ginv Int intAddGroup intZero)
            (intGop
              (n * k)
              (ginv
                Int
                intAddGroup
                intZero)) ⟩ gop Int intAddGroup (n * k) (ginv Int intAddGroup intZero)))

-- the instance in the smallest concrete case: n is zero in ℤ/nℤ
def intModSelf : (n : El Int) → intModCls n ≡ intModCls intZero ∈ El (IntMod n) ≔
  λn. trans
    (IntMod n)
    (intModCls n)
    (intModCls (n * intOne))
    (intModCls intZero)
    (cong
      Int
      (λw. IntMod n)
      (λw. intModCls w)
      n
      (n * intOne)
      (sym Int (n * intOne) n (intMulOneR n)))
    intModMulZero

-- ===== ...and ℤ/nℤ is a RING =====
--
-- nℤ is not just a subgroup: it is an IDEAL, because a·(n·k) = n·(a·k).
-- One bridge (raddGroup Int intCommRing is intAddGroup, by β) and one
-- closure proof, and quotRing.nova supplies the rest.
def intRaddGroup : raddGroup intCommRing ≡ intAddGroup
  using (ringTheory.raddGroup.eq, intRing.intCommRing.eq) ≔
  ⋆

def intRmul : (x y : El Int) → rmul Int intCommRing x y ≡ x * y
  using (ringTheory.rmul.eq, intRing.intCommRing.eq) ≔
  λx. λy. ⋆

-- a·(n·k) = n·(a·k): one associativity and one commutation
def nZScaleAlg : (n a k : El Int) → a * (n * k) ≡ n * (a * k) ≔
  λn. λa. λk. a * (n * k)
      ≡⟨ sym Int (a * n * k) (a * (n * k)) (intMulAssoc a n k) ⟩ a * n * k
      ≡⟨ cong Int (λw. Int) (λw. w * k) (a * n) (n * a) (intMulComm a n) ⟩ n * a * k
      ≡⟨ intMulAssoc n a k ⟩ n * (a * k)

def nZScale : (n a x : El Int) → Prf (nZ n x) → Prf (nZ n (rmul Int intCommRing a x))
  using (nZ.eq, nZfib.unfold) ≔
  λn. λa. λx. λhx. squash-elim hx (u. nZIntro
    n
    (rmul Int intCommRing a x)
    (a * u .π₁)
    (n * (a * u .π₁)
        ≡⟨ sym Int (a * (n * u .π₁)) (n * (a * u .π₁)) (nZScaleAlg n a (u .π₁)) ⟩ a * (n * u .π₁)
        ≡⟨ cong Int (λw. Int) (λw. a * w) (n * u .π₁) x (idToEq Int (n * u .π₁) x (u .π₂)) ⟩ a * x
        ≡⟨ sym Int (rmul Int intCommRing a x) (a * x) (intRmul a x) ⟩ rmul Int intCommRing a x))

def nZIsIdeal : (n : El Int) → Prf (IsIdeal Int intCommRing (nZ n)) using (intRaddGroup.rw) ≔
  λn. idIntro (nZIsSubgroup n) (nZScale n)

-- ℤ/nℤ, as a commutative ring
def intModRing : (n : El Int) → El (IsCommRing (IntMod n))
  using (IntMod.eq, quotRing.QRing.eq, ringTheory.raddGroup.eq, intRing.intCommRing.eq) ≔
  λn. qrIsCommRing (nZIsIdeal n)
