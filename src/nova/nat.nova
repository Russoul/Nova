-- Natural-number addition and multiplication (both recursing on the
-- second argument) and their basic equational theory. The operators
-- ARE the definitions' names (docs/NovaElaboration.txt).
infixl 6 +
def + : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim (n. _) x (n ih. S ih) y
infixl 7 *
def * : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim (n. _) Z (n ih. x + ih) y

def plusZeroId : (n : ℕ) → n + Z ≡ n ∈ _ ≔ λn. ⋆
def plusSucId : (n : ℕ) (m : ℕ) → n + S m ≡ S (n + m) ∈ _ ≔ λn. λm. ⋆
def zeroPlusId : (n : ℕ) → Z + n ≡ n ∈ ℕ ≔ λn. ℕ-elim (k. Z + k ≡ k ∈ _) ⋆ (k ih. ⋆) n
def sucPlus : (n : ℕ) (m : ℕ) → S n + m ≡ S (n + m) ∈ ℕ ≔ λn. λm. ℕ-elim (k. S n + k ≡ S (n + k) ∈ _) ⋆ (k ih. ⋆) m
def plusComm : (n : ℕ) (m : ℕ) → m + n ≡ n + m ∈ ℕ using (sucPlus, zeroPlusId) ≔ λn. λm. ℕ-elim (k. k + n ≡ n + k ∈ _) ⋆ (k ih. ⋆) m
def plusAssoc : (n : ℕ) (m : ℕ) (k : ℕ) → n + m + k ≡ n + (m + k) ∈ _ ≔
  λn. λm. λk. ℕ-elim (j. n + m + j ≡ n + (m + j) ∈ _) ⋆ (j ih. ⋆) k

-- a + (b + c) ≡ b + (a + c) — permutative, used by whole-equation match
def swapLeft : (a : ℕ) (b : ℕ) (c : ℕ) → a + (b + c) ≡ b + (a + c) ∈ _ using (plusComm) ≔
  λa. λb. λc. ℕ-elim (k. a + (b + k) ≡ b + (a + k) ∈ _) ⋆ (k ih. ⋆) c

-- congruence in each summand — one ⋆ each: reflecting the hypothesis
-- makes the two sides the same term
def plusCongL : (a : ℕ) (b : ℕ) (c : ℕ) → (a ≡ b ∈ ℕ) → a + c ≡ b + c ∈ ℕ ≔
  λa. λb. λc. λh. ⋆
def plusCongR : (a : ℕ) (b : ℕ) (c : ℕ) → (b ≡ c ∈ ℕ) → a + b ≡ a + c ∈ ℕ ≔
  λa. λb. λc. λh. ⋆

-- (x+y)+(z+w) ≡ (x+w)+(z+y) — the inner summands swap. Discharged by
-- whole-equation matching against plusAssoc/plusComm/swapLeft above
def swapMid : (x : ℕ) (y : ℕ) (z : ℕ) (w : ℕ) →
  (x + y) + (z + w) ≡ (x + w) + (z + y) ∈ ℕ using (plusAssoc, plusComm, swapLeft) ≔
  λx. λy. λz. λw. ⋆

-- S is injective — the kernel's suc selector, named. Bare ⋆: reflecting
-- the hypothesis gives S n ≐ S m, whose suc-component the selector
-- reads off (docs/NovaKernel.txt §5)
def sucInj : (n : ℕ) (m : ℕ) → (S n ≡ S m ∈ ℕ) → n ≡ m ∈ ℕ ≔ λn. λm. λh. ⋆

-- CANCELLATION: (· + k) is injective, i.e. a common right summand
-- cancels. Induction on the cancelled summand — each step peels one
-- successor off both sides (n + S j ≜ S (n + j)) and hands it to sucInj
def plusCancel : (n : ℕ) (m : ℕ) (k : ℕ) → (n + k ≡ m + k ∈ ℕ) → n ≡ m ∈ ℕ ≔
  λn. λm. λk. ℕ-elim (j. (n + j ≡ m + j ∈ ℕ) → n ≡ m ∈ ℕ)
    (λh. ⋆)
    (j ih. λh. ih (sucInj (n + j) (m + j) h))
    k

def multZeroId : (n : ℕ) → n * Z ≡ Z ∈ _ ≔ λn. ⋆
def multSucId : (n : ℕ) (m : ℕ) → n * S m ≡ n + n * m ∈ _ ≔ λn. λm. ⋆
def zeroMult : (n : ℕ) → Z * n ≡ Z ∈ ℕ using (zeroPlusId) ≔ λn. ℕ-elim (k. Z * k ≡ Z ∈ _) ⋆ (k ih. ⋆) n
def sucMult : (n : ℕ) (m : ℕ) → S n * m ≡ m + n * m ∈ _ using (plusCongR, sucPlus, swapLeft) ≔
  λn. λm. ℕ-elim (k. S n * k ≡ k + n * k ∈ _) ⋆ (k ih. ⋆) m
def multComm : (n : ℕ) (m : ℕ) → m * n ≡ n * m ∈ _ using (sucMult, zeroMult) ≔
  λn. λm. ℕ-elim (k. k * n ≡ n * k ∈ _) ⋆ (k ih. ⋆) m
def multDistrib : (n : ℕ) (m : ℕ) (k : ℕ) → n * (m + k) ≡ n * m + n * k ∈ _ using (plusCongR, swapLeft) ≔
  λn. λm. λk. ℕ-elim (j. n * (m + j) ≡ n * m + n * j ∈ _) ⋆ (j ih. ⋆) k
def multAssoc : (n : ℕ) (m : ℕ) (k : ℕ) → n * m * k ≡ n * (m * k) ∈ _ using (multDistrib) ≔
  λn. λm. λk. ℕ-elim (j. n * m * j ≡ n * (m * j) ∈ _) ⋆ (j ih. ⋆) k
