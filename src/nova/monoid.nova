-- The type of (small) monoids: a carrier CODE M : 𝕌 with a binary
-- operation and a unit, packaged as a dependent pair type. The
-- structure itself cannot be a 𝕌-code — its laws are Prf-types and Ω
-- has no code — so it is a `type` item, and a concrete monoid is an
-- ordinary def of this type.
--
-- Law orientations follow the corpus's conventions (plusAssoc,
-- zeroPlusId, plusZeroId): assoc reassociates to the right, units
-- cancel toward the bare element — so the ℕ/ℤ/ℚ lemmas slot in as
-- components verbatim.
type Monoid ≔
  (M : 𝕌)
  (op : El M → El M → El M)
  (e : El M)
  (assoc : (x : El M) (y : El M) (z : El M) →
             op (op x y) z ≡ op x (op y z) ∈ El M)
  (unitL : (x : El M) → op e x ≡ x ∈ El M) ⨯
  ((x : El M) → op x e ≡ x ∈ El M)
