-- THE QUOTIENT RING R/I.
--
-- The additive group is already done: an ideal is a normal subgroup of
-- (R , +) (ideal.idNormal), so quotGroup.nova supplies the carrier,
-- the addition, the negation and IsGroup outright. What is new is the
-- MULTIPLICATION, and it descends by the same nested quot-elim, owing
-- the same two well-definedness proofs.
--
-- The contrast with quotGroup.nova is the point of this module. There,
-- the outer half could not be got by commuting and the two halves were
-- genuinely different statements — the inner one needed normality, the
-- outer one nothing. Here BOTH halves are the ideal's single closure
-- law, applied on different sides:
--
--   INNER   a·b − a·b' = a·(b − b')   —  idScale  (a on the left)
--   OUTER   a·b − a'·b = (a − a')·b   —  idScaleR (b on the right)
--
-- and idScaleR is idScale composed with rMulComm. So commutativity does
-- pay for the outer half after all — but as a fact about the IDEAL,
-- not as realSeq.wdOuterOfComm's trick on the operation. In a
-- non-commutative ring the two would be the two halves of "two-sided
-- ideal", and neither would follow from the other.

import id (Id, idToEq, eqToId)
import monoid (IsMonoid)
import group (IsGroup)
import ring (IsCommRing)
import groupTheory (gop, ge, ginv, gAssoc, gUnitL, gUnitR, gInvL, gInvR)
import ringTheory (raddGroup, rmul, rone, rMulAssoc, rMulComm, rMulOne, rAddComm, rDistribL, rDistribR, rMulZero, rMulNeg, rMulSub)
import subgroup (IsSubgroup, IsNormal, cosetRel, cosetRefl, cosetSymm, cosetTrans)
import ideal (IsIdeal, idSub, idScale, idScaleR, idNormal)
import quotGroup (QGroup, qcls, qclsEq, qclsEffective, qMul, qMulCls, qInv, qUnit, qIsGroup, qAssoc, qUnitL, qUnitR)
import quotEffective (classEqOfRel)
import equality (transportP, sym, trans, cong)

def QRing : (R : 𝕌) (r : El (IsCommRing R)) (I : El R → Ω) → 𝕌 ≔
  λR. λr. λI. QGroup _ (raddGroup r) I

def qrCls : {R : 𝕌} {r : El (IsCommRing R)} {I : El R → Ω} → El R → El (QRing _ r I)
  using (QRing.eq) ≔
  λR. λr. λI. qcls _ (raddGroup r) I

-- ===== the two well-definedness proofs =====
def qrMulWDInner : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  → Prf (IsIdeal
    _
    r
    I)
    → {a b b' : El R}
      → Prf (cosetRel
        _
        (raddGroup r)
        I
        b
        b') → Prf (cosetRel _ (raddGroup r) I (rmul _ r a b) (rmul _ r a b'))
  using (subgroup.cosetRel.eq) ≔
  λR. λr. λI. λid. λa. λb. λb'. λh. transportP
    _
    I
    _
    _
    (sym _ _ _ (rMulSub _ r a b b'))
    (idScale _ _ _ id a (gop _ (raddGroup r) b (ginv _ (raddGroup r) b')) h)

def qrMulWDOuter : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  → Prf (IsIdeal
    _
    r
    I)
    → {a a' b : El R}
      → Prf (cosetRel
        _
        (raddGroup r)
        I
        a
        a') → Prf (cosetRel _ (raddGroup r) I (rmul _ r a b) (rmul _ r a' b))
  using (subgroup.cosetRel.eq) ≔
  λR. λr. λI. λid. λa. λa'. λb. λh. transportP
    R
    I
    (rmul _ r (gop _ (raddGroup r) a (ginv _ (raddGroup r) a')) b)
    (gop _ (raddGroup r) (rmul _ r a b) (ginv _ (raddGroup r) (rmul _ r a' b)))
    (rmul _ r (gop _ (raddGroup r) a (ginv _ (raddGroup r) a')) b
        ≡⟨ rMulComm
          _
          r
          (gop _ (raddGroup r) a (ginv _ (raddGroup r) a'))
          b ⟩ rmul _ r b (gop _ (raddGroup r) a (ginv _ (raddGroup r) a'))
        ≡⟨ sym
          _
          _
          _
          (rMulSub
            _
            r
            b
            a
            a') ⟩ gop _ (raddGroup r) (rmul _ r b a) (ginv _ (raddGroup r) (rmul _ r b a'))
        ≡⟨ cong
          R
          (λw. R)
          (λw. gop R (raddGroup r) w (ginv _ (raddGroup r) (rmul _ r b a')))
          _
          _
          (rMulComm
            _
            r
            b
            a) ⟩ gop _ (raddGroup r) (rmul _ r a b) (ginv _ (raddGroup r) (rmul _ r b a'))
        ≡⟨ cong
          R
          (λw. R)
          (λw. gop R (raddGroup r) (rmul _ r a b) (ginv _ (raddGroup r) w))
          _
          _
          (rMulComm
            _
            r
            b
            a') ⟩ gop _ (raddGroup r) (rmul _ r a b) (ginv _ (raddGroup r) (rmul _ r a' b)))
    (idScaleR _ _ _ id b (gop _ (raddGroup r) a (ginv _ (raddGroup r) a')) h)

-- ===== the descent, in qrCls vocabulary (B-21) =====
def qrMulWDInnerCls : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  → Prf (IsIdeal
    _
    r
    I)
    → (a b b' : El R)
      → Prf (cosetRel
        _
        (raddGroup r)
        I
        b
        b') → qrCls (rmul _ r a b) ≡ qrCls (rmul _ r a b') ∈ El (QRing _ r I)
  using (qrCls.eq, quotGroup.qcls.eq) ≔
  λR. λr. λI. λid. λa. λb. λb'. λh. classEqOfRel
    _
    (cosetRel _ (raddGroup r) I)
    (rmul _ r a b)
    (rmul _ r a b')
    (qrMulWDInner id h)

def qrMulWDOuterCls : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  → Prf (IsIdeal
    _
    r
    I)
    → {a a' b : El R}
      → Prf (cosetRel
        _
        (raddGroup r)
        I
        a
        a') → qrCls (rmul _ r a b) ≡ qrCls (rmul _ r a' b) ∈ El (QRing _ r I)
  using (qrCls.eq, quotGroup.qcls.eq) ≔
  λR. λr. λI. λid. λa. λa'. λb. λh. classEqOfRel
    _
    (cosetRel _ (raddGroup r) I)
    (rmul _ r a b)
    (rmul _ r a' b)
    (qrMulWDOuter id h)

def qrMulWDOuterElim : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  → Prf (IsIdeal
    _
    r
    I)
    → (x x' : El R)
      → Prf (cosetRel
        _
        (raddGroup r)
        I
        x
        x')
        → (v : El (QRing _ r I))
          → quot-elim (w. El (QRing _ r I))
            (q. qrCls (rmul _ r x q))
            v ≡ quot-elim (q. qrCls (rmul _ r x' q)) v
  using (QRing.eq, quotGroup.QGroup.unfold, qrMulWDInnerCls) ≔
  λR. λr. λI. λid. λx. λx'. λh. λv. quot-elim (w. quot-elim (z. El (QRing _ r I))
    (q. qrCls (rmul _ r x q))
    w ≡ quot-elim (q. qrCls (rmul _ r x' q)) w)
    (c. qrMulWDOuterCls id h)
    v

def qrMul : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  → Prf (IsIdeal _ r I) → El (QRing _ r I) → El (QRing _ r I) → El (QRing _ r I)
  using (QRing.eq, quotGroup.QGroup.unfold, qrMulWDInnerCls, qrMulWDOuterElim) ≔
  λR. λr. λI. λid. λu. λv. quot-elim (p. quot-elim (q. qrCls (rmul _ r p q)) v) u

def qrMulCls : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  (id : Prf (IsIdeal _ r I))
  (a b : El R)
  → qrMul R r I id (class a) (class b) ≡ class (rmul _ r a b)
  using (QRing.eq, qrCls.eq, quotGroup.QGroup.unfold, quotGroup.qcls.eq, qrMul.eq) ≔
  λR. λr. λI. λid. λa. λb. ⋆

def qrOne : {R : 𝕌} {r : El (IsCommRing R)} {I : El R → Ω} → El (QRing _ r I)
  using (QRing.eq, quotGroup.QGroup.unfold) ≔
  λR. λr. λI. class (rone r)

-- ===== the additive side, renamed =====
--
-- quotGroup.nova already built it; these three names only put it in
-- ring vocabulary and bridge qIsGroup's projections once.
def qrAddGroup : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  → Prf (IsIdeal _ r I) → El (IsGroup (QRing _ r I))
  using (QRing.eq) ≔
  λR. λr. λI. λid. qIsGroup _ _ _ (idSub id) (idNormal _ r I)

def qrAdd : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  → Prf (IsIdeal _ r I) → El (QRing _ r I) → El (QRing _ r I) → El (QRing _ r I)
  using (QRing.eq) ≔
  λR. λr. λI. λid. qMul _ _ _ (idNormal _ r I)

def qrGop : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  (id : Prf (IsIdeal _ r I))
  (u v : El (QRing _ r I))
  → gop _ (qrAddGroup id) u v ≡ qrAdd id u v
  using (qrAddGroup.eq, qrAdd.eq, groupTheory.gop.eq, quotGroup.qIsGroup.eq) ≔
  λR. λr. λI. λid. λu. λv. ⋆

def qrAddCls : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  (id : Prf (IsIdeal _ r I))
  (a b : El R)
  → qrAdd id (class a) (class b) ≡ class (gop _ (raddGroup r) a b) ∈ El (QRing _ r I)
  using (QRing.eq, qrAdd.eq, quotGroup.QGroup.unfold) ≔
  λR. λr. λI. λid. λa. λb. qMulCls _ _ _ (idNormal _ r I) a b

-- ===== the multiplicative laws, each a descent into Ω =====
def qrMulAssoc : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  (id : Prf (IsIdeal _ r I))
  (u v w : El (QRing _ r I))
  → qrMul _ _ _ id (qrMul _ _ _ id u v) w ≡ qrMul _ _ _ id u (qrMul _ _ _ id v w)
  using (QRing.eq, quotGroup.QGroup.unfold, qrMulCls.rw) ≔
  λR. λr. λI. λid. λu. λv. λw. quot-elim
    (a. quot-elim
      (b. quot-elim
        (c. trans
          _
          _
          (class (rmul _ r (rmul _ r a b) c))
          _
          ⋆
          (trans
            (QRing _ r I)
            _
            (class (rmul _ r a (rmul _ r b c)))
            (qrMul R r I id (class a) (qrMul R r I id (class b) (class c)))
            (cong
              R
              (λz. QRing _ r I)
              (λz. class z)
              (rmul _ r (rmul _ r a b) c)
              (rmul _ r a (rmul _ r b c))
              rMulAssoc)
            ⋆))
        w)
      v)
    u

def qrMulComm : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  (id : Prf (IsIdeal _ r I))
  (u v : El (QRing _ r I))
  → qrMul _ _ _ id u v ≡ qrMul _ _ _ id v u
  using (QRing.eq, quotGroup.QGroup.unfold, qrMulCls.rw) ≔
  λR. λr. λI. λid. λu. λv. quot-elim
    (a. quot-elim
      (b. trans
        _
        _
        (class (rmul _ r a b))
        _
        ⋆
        (trans
          (QRing _ r I)
          _
          (class (rmul _ r b a))
          (qrMul R r I id (class b) (class a))
          (cong R (λz. QRing _ r I) (λz. class z) _ _ (rMulComm _ r a b))
          ⋆))
      v)
    u

def qrMulOne : (R : 𝕌)
  (r : El (IsCommRing R))
  (I : El R → Ω)
  (id : Prf (IsIdeal _ r I))
  (u : El (QRing _ r I))
  → qrMul R r I id u qrOne ≡ u
  using (QRing.eq, quotGroup.QGroup.unfold, qrOne.eq, qrMulCls.rw) ≔
  λR. λr. λI. λid. λu. quot-elim
    (a. trans
      _
      _
      (class (rmul _ r a (rone r)))
      _
      ⋆
      (cong R (λz. QRing _ r I) (λz. class z) (rmul _ r a (rone r)) a rMulOne))
    u

def qrAddComm : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  {id : Prf (IsIdeal _ r I)}
  {u v : El (QRing _ r I)}
  → qrAdd id u v ≡ qrAdd id v u
  using (QRing.eq, quotGroup.QGroup.unfold, qrAddCls.rw) ≔
  λR. λr. λI. λid. λu. λv. quot-elim
    (a. quot-elim
      (b. trans
        _
        _
        (class (gop _ (raddGroup r) a b))
        _
        ⋆
        (trans
          (QRing _ r I)
          _
          (class (gop _ (raddGroup r) b a))
          (qrAdd id (class b) (class a))
          (cong R (λz. QRing _ r I) (λz. class z) _ _ (rAddComm _ r a b))
          ⋆))
      v)
    u

def qrDistribL : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  {id : Prf (IsIdeal _ r I)}
  {u v w : El (QRing _ r I)}
  → qrMul _ _ _ id u (qrAdd id v w) ≡ qrAdd id (qrMul _ _ _ id u v) (qrMul _ _ _ id u w)
  using (QRing.eq, quotGroup.QGroup.unfold, qrMulCls.rw, qrAddCls.rw) ≔
  λR. λr. λI. λid. λu. λv. λw. quot-elim
    (a. quot-elim
      (b. quot-elim
        (c. trans
          _
          _
          (class (rmul _ r a (gop _ (raddGroup r) b c)))
          _
          ⋆
          (trans
            (QRing _ r I)
            _
            (class (gop _ (raddGroup r) (rmul _ r a b) (rmul _ r a c)))
            (qrAdd id (qrMul R r I id (class a) (class b)) (qrMul R r I id (class a) (class c)))
            (cong R (λz. QRing _ r I) (λz. class z) _ _ (rDistribL _ r a b c))
            ⋆))
        w)
      v)
    u

-- ===== R/I is a commutative ring =====
def qrIsCommRing : {R : 𝕌}
  {r : El (IsCommRing R)}
  {I : El R → Ω}
  → Prf (IsIdeal _ r I) → El (IsCommRing (QRing _ r I))
  using (ring.IsCommRing.unfold, groupTheory.gop.eq) ≔
  λR. λr. λI. λid. qrAddGroup
    id,
    qrMul
      _
      _
      _
      id,
      qrOne,
        (λx. λy. λz. eqToId
          _
          _
          (qrMulAssoc
            _
            _
            _
            id
            x
            y
            z)),
          (λx. λy. eqToId
            _
            _
            (qrMulComm
              _
              _
              _
              id
              x
              y)),
            (λx. eqToId
              _
              _
              (qrMulOne
                _
                _
                _
                id
                x)),
              (λx. λy. eqToId
                (gop _ (qrAddGroup id) x y)
                (gop _ (qrAddGroup id) y x)
                (trans
                  _
                  _
                  _
                  _
                  (qrGop _ _ _ id x y)
                  (trans
                    (QRing _ r I)
                    (qrAdd id x y)
                    (qrAdd id y x)
                    _
                    qrAddComm
                    (sym
                      _
                      _
                      _
                      (qrGop
                        _
                        _
                        _
                        id
                        y
                        x))))),
                λx. λy. λz. eqToId
                  (qrMul _ _ _ id x (gop _ (qrAddGroup id) y z))
                  (gop _ (qrAddGroup id) (qrMul _ _ _ id x y) (qrMul _ _ _ id x z))
                  (trans
                    _
                    _
                    _
                    (gop _ (qrAddGroup id) (qrMul _ _ _ id x y) (qrMul _ _ _ id x z))
                    (cong
                      (QRing _ r I)
                      (λz2. QRing _ r I)
                      (λz2. qrMul _ _ _ id x z2)
                      _
                      _
                      (qrGop _ _ _ id y z))
                    (trans
                      (QRing _ r I)
                      (qrMul _ _ _ id x (qrAdd id y z))
                      (qrAdd id (qrMul _ _ _ id x y) (qrMul _ _ _ id x z))
                      _
                      qrDistribL
                      (sym _ _ _ (qrGop _ _ _ id (qrMul _ _ _ id x y) (qrMul _ _ _ id x z)))))
