-- The STRICT order on ℝ. Bishop states it on representatives — some
-- index where y_n beats x_n by more than the modulus — and then owes a
-- proof that the statement survives REq. Stating it one level UP
-- instead,
--
--   u < v  ≜  ∃k. u + 1/(k+1) ≤ v
--
-- makes invariance free: everything on the right already lives on ℝ.
-- The existential is squashed, which is exactly right — the witness k
-- is not determined by u and v — and costs nothing, because LtR is
-- itself a proposition, so squash-elimination always lands where it is
-- allowed.
--
-- The two nontrivial facts are irreflexivity, which needs ℝ's group
-- structure to strip u and then ℚ ↪ ℝ's order-reflection to reach a
-- contradiction in ℚ, and ltROfQ, which is where ratArch.nova's
-- Archimedean witness is spent.

import rationalQ (Q, +, qNeg, qZero, qOne, qAddComm)
import rationalOrder (Sign, sPos, sgnQ, ≤, leQAntisym, leQPlusMono, qPlusNegCancelR)
import ratLt (<, sgnOfLtQ, ltQOfSgn, leQOfLtQ)
import ratHalf (leQZeroInvNat)
import ratArch (ArchWit, qArch, qInvNatNotZero)
import real (qInvNat, Real, realOfQ, realZero, realOne)
import realAdd (+, realAddComm, realAddAssoc, realAddZeroR, realAddNegR, realAddOfQ)
import realNeg (realNeg)
import realOrder (≤, leRRefl, leRTrans, leRAddMono, leROfQ, leQOfLeR, leQZeroOne)
import prop (⊥)
import equality (trans, sym, cong, transport, transportP)

infixl 4 <
def < : El Real → El Real → Ω ≔ λu. λv. ∥(k : ℕ) ⨯ Prf (u + realOfQ (qInvNat k) ≤ v)∥

def ltROf : (u v : El Real) (k : ℕ) → Prf (u + realOfQ (qInvNat k) ≤ v) → Prf (u < v)
  using (realLt.<.unfold) ≔
  λu. λv. λk. λh. ⋆ (k, h)

-- ===== ℝ group algebra the proofs need =====
def realAddNegCancel : (u q : El Real) → u + q + realNeg u ≡ q using (real.Real.unfold) ≔
  λu. λq. u + q + realNeg u
      ≡⟨ cong
        Real
        (λw. Real)
        (λw. w + realNeg u)
        (u + q)
        (q + u)
        (realAddComm u q) ⟩ q + u + realNeg u
      ≡⟨ realAddAssoc q u (realNeg u) ⟩ q + (u + realNeg u)
      ≡⟨ cong Real (λw. Real) (λw. q + w) (u + realNeg u) realZero (realAddNegR u) ⟩ q + realZero
      ≡⟨ realAddZeroR q ⟩ q

def realAddSwapR : (u q w : El Real) → u + q + w ≡ u + w + q using (real.Real.unfold) ≔
  λu. λq. λw. u + q + w
      ≡⟨ realAddAssoc u q w ⟩ u + (q + w)
      ≡⟨ cong Real (λv. Real) (λv. u + v) (q + w) (w + q) (realAddComm q w) ⟩ u + (w + q)
      ≡⟨ sym Real (u + w + q) (u + (w + q)) (realAddAssoc u w q) ⟩ u + w + q

-- 0 ≤ 1/(k+1), lifted
def leRZeroInv : (k : ℕ) → Prf (realZero ≤ realOfQ (qInvNat k))
  using (rationalQ.qZero.eq,
    real.qInvNat.eq,
    real.realOfQ.eq,
    real.realOfQ.unfold,
    real.realZero.eq,
    real.realZero.unfold,
    realOrder.≤.eq,
    realOrder.≤.unfold,
    realOrder.RLeP.unfold) ≔
  λk. leROfQ qZero (qInvNat k) (leQZeroInvNat k)

-- u ≤ u + 1/(k+1)
def leRSelfInv : (u : El Real) (k : ℕ) → Prf (u ≤ u + realOfQ (qInvNat k))
  using (realOrder.≤.unfold) ≔
  λu. λk. transportP
    Real
    (λw. w ≤ u + realOfQ (qInvNat k))
    (realZero + u)
    u
    (realAdd.realAddZeroL u)
    (transportP
      Real
      (λw. realZero + u ≤ w)
      (realOfQ (qInvNat k) + u)
      (u + realOfQ (qInvNat k))
      (realAddComm (realOfQ (qInvNat k)) u)
      (leRAddMono (leRZeroInv k)))

-- ===== the order laws =====
def leROfLtR : (u v : El Real) → Prf (u < v) → Prf (u ≤ v)
  using (realLt.<.unfold, realOrder.≤.unfold) ≔
  λu. λv. λh. squash-elim h (w. leRTrans
    u
    (u + realOfQ (qInvNat (w .π₁)))
    v
    (leRSelfInv u (w .π₁))
    (w .π₂))

def ltRTrans : (u v t : El Real) → Prf (u < v) → Prf (v < t) → Prf (u < t) using (realLt.<.unfold) ≔
  λu. λv. λt. λh1. λh2. squash-elim h1 (w. ltROf
    u
    t
    (w .π₁)
    (leRTrans (u + realOfQ (qInvNat (w .π₁))) v t (w .π₂) (leROfLtR v t h2)))

def leRLtTrans : (u v t : El Real) → Prf (u ≤ v) → Prf (v < t) → Prf (u < t)
  using (realLt.<.unfold) ≔
  λu. λv. λt. λh1. λh2. squash-elim h2 (w. ltROf
    u
    t
    (w .π₁)
    (leRTrans
      (u + realOfQ (qInvNat (w .π₁)))
      (v + realOfQ (qInvNat (w .π₁)))
      t
      (leRAddMono h1)
      (w .π₂)))

def ltRLeTrans : (u v t : El Real) → Prf (u < v) → Prf (v ≤ t) → Prf (u < t)
  using (realLt.<.unfold) ≔
  λu. λv. λt. λh1. λh2. squash-elim h1 (w. ltROf
    u
    t
    (w .π₁)
    (leRTrans (u + realOfQ (qInvNat (w .π₁))) v t (w .π₂) h2))

-- irreflexivity: strip u from both sides, then read the result off in ℚ
def ltRIrrefl : (u : El Real) → Prf (u < u) → Prf ⊥
  using (prop.⊥.unfold,
    rationalQ.qZero.eq,
    real.Real.unfold,
    real.realOfQ.eq,
    real.realZero.eq,
    realAdd.+.unfold,
    realLt.<.unfold,
    realOrder.≤.unfold) ≔
  λu. λh. squash-elim h (w. ⋆ (qInvNatNotZero
    (w .π₁)
    (leQAntisym
      (leQOfLeR
        qZero
        (transportP
          Real
          (λt. t ≤ realZero)
          (u + realOfQ (qInvNat (w .π₁)) + realNeg u)
          (realOfQ (qInvNat (w .π₁)))
          (realAddNegCancel u (realOfQ (qInvNat (w .π₁))))
          (transportP
            Real
            (λt. u + realOfQ (qInvNat (w .π₁)) + realNeg u ≤ t)
            (u + realNeg u)
            realZero
            (realAddNegR u)
            (leRAddMono (w .π₂)))))
      (leQZeroInvNat (w .π₁)))))

-- ===== ℚ ↪ ℝ preserves and reflects the strict order =====
-- p < q in ℚ: the Archimedean witness supplies the index, and the
-- squash it comes in is absorbed by LtR's own
def ltROfQ : {p q : El Q} → El (p < q) → Prf (realOfQ p < realOfQ q)
  using (ratArch.ArchWit.unfold, realLt.<.unfold) ≔
  λp. λq. λh. squash-elim (qArch
    (q + qNeg p)
    (sgnOfLtQ
      h)) (w. ltROf
    (realOfQ p)
    (realOfQ q)
    (w .π₁)
    (transportP
      Real
      (λt. t ≤ realOfQ q)
      (realOfQ (p + qInvNat (w .π₁)))
      (realOfQ p + realOfQ (qInvNat (w .π₁)))
      (sym
        Real
        (realOfQ p + realOfQ (qInvNat (w .π₁)))
        (realOfQ (p + qInvNat (w .π₁)))
        (realAddOfQ p (qInvNat (w .π₁))))
      (leROfQ
        (p + qInvNat (w .π₁))
        q
        (transport
          Q
          (λt. t ≤ q)
          (qInvNat (w .π₁) + p)
          (p + qInvNat (w .π₁))
          (qAddComm (qInvNat (w .π₁)) p)
          (transport
            Q
            (λt. qInvNat (w .π₁) + p ≤ t)
            (q + qNeg p + p)
            q
            (qPlusNegCancelR q p)
            (leQPlusMono p (w .π₂)))))))

def ltRZeroOne : Prf (realZero < realOne)
  using (ratBound.qNegZeroQ.rw,
    rationalOrder.Sign.unfold,
    rationalQ.qAddZeroR.rw,
    real.realOfQ.eq,
    real.realOne.eq,
    real.realZero.eq,
    realLt.<.eq,
    realLt.<.unfold,
    realOrder.sgnQOnePos) ≔
  ltROfQ (ltQOfSgn qZero qOne ⋆)

-- ===== compatibility with addition =====
def ltRAddMono : (u v t : El Real) → Prf (u < v) → Prf (u + t < v + t) using (realLt.<.unfold) ≔
  λu. λv. λt. λh. squash-elim h (w. ltROf
    (u + t)
    (v + t)
    (w .π₁)
    (transportP
      Real
      (λs. s ≤ v + t)
      (u + realOfQ (qInvNat (w .π₁)) + t)
      (u + t + realOfQ (qInvNat (w .π₁)))
      (realAddSwapR u (realOfQ (qInvNat (w .π₁))) t)
      (leRAddMono (w .π₂))))
