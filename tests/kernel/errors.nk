-- one rejection per rule, each naming the rule and its place

Z-at-unit : 𝟙 := Z
unit-at-nat : ℕ := ()
class-at-nat : ℕ := class Z
squash-at-nat : ℕ := squash Z
lam-at-nat : ℕ := λx. x
pair-at-nat : ℕ := (Z, Z)
inj-at-nat : ℕ := inj₁ Z
proj-of-nat : ℕ := switch ((Z : ℕ) .π₂)
app-of-nat : ℕ := switch ((Z : ℕ) Z)
motive-sort : ℕ := switch (ℕ-elim Ω (_. ℕ) Z (k ih. k) Z)
sum-motive-sort : ℕ := switch (⊎-elim Ω (_. ℕ) (a. Z) (b. Z) ((inj₁ Z) : ℕ ⊎ ℕ))
lift-at-nat : ℕ := lift Z
conv-not-a-type-equation : ℕ := conv Z (refl (Z : ℕ))
reflect-not-eq : ℕ := switch (reflect (Z : ℕ))
unsquash-not-squash : ∥ℕ∥ := switch (unsquash ∥ℕ∥ (n. squash n) (Z : ℕ))
unsquash-target-not-prop : ℕ := switch (unsquash ℕ (n. n) (Z : ℕ))
irrel-at-nat : Z ≡ Z ∈ ℕ := switch (refl ((irrel Z Z) : ℕ))
prop-irrel-not-prop : Z ≡ Z ∈ ℕ := switch (refl (prop-irrel ℕ Z Z))
propext-not-prop : ℕ ≡ ℕ ∈ Ω := switch (propext ℕ ℕ (x. x) (y. y))
eta-not-pi : ℕ := (η→ Z ; Z)
context-not-a-type (x : (Z : ℕ)) : ℕ := Z
type-not-a-type : (Z : ℕ) := Z
var-out-of-scope : ℕ := switch (((λx. y) : ℕ → ℕ) Z)
pi-domain-not-a-type : 𝕌0 := (Z : ℕ) → ℕ
eq-type-not-a-type : Ω := Z ≡ Z ∈ (Z : ℕ)
refl-needs-synthesis : Z ≡ Z ∈ ℕ := switch (refl Z)
