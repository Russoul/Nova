-- ℕ: plus by recursion on its second argument, and facts by unfolding

plus (n : ℕ) (m : ℕ) : ℕ :=
  ℕ-elim 𝕌0
    _. ℕ
    n
    k ih. S ih
    m

two : ℕ := plus[S Z, S Z]

-- unfold two, then plus, then compute
two-is-SSZ : two ≡ S (S Z) ∈ ℕ :=
  reify
    δ two
      ; δ plus[S Z, S Z]
      : ℕ

-- without the leaves, two is stuck
two-stuck : two ≡ S (S Z) ∈ ℕ := ⌜two : ℕ⌝

-- a reflected hypothesis under a congruence
S-cong (n : ℕ) (h : n ≡ Z ∈ ℕ) : S n ≡ S Z ∈ ℕ := ⌜S ⌞h⌟ : ℕ⌝

-- 0 + 3 ≡ 3: two β and four ι steps
plus-0-3 : plus[Z, S (S (S Z))] ≡ S (S (S Z)) ∈ ℕ := ⌜δ plus[Z, S (S (S Z))] : ℕ⌝

-- n + 0 ≡ n is computation: plus recurses on its second argument
plus-n-0 (n : ℕ) : plus[n, Z] ≡ n ∈ ℕ := ⌜δ plus[n, Z] : ℕ⌝

-- 0 + n ≡ n is INDUCTION: ℕ-elim into the equation, at Ω; the step
-- unfolds plus at S k, and rewrites under S with the hypothesis after
-- unfolding plus at k so that the hypothesis' side is the computed one
plus-0-n (n : ℕ) : plus[Z, n] ≡ n ∈ ℕ :=
  ℕ-elim Ω
    k. plus[Z, k] ≡ k ∈ ℕ
    ⌜δ plus[Z, Z] : ℕ⌝
    k ih. reify
      δ plus[Z, S k]
        ; S (δ plus[Z, k]⁻¹ ; ⌞ih⌟)
        : ℕ
    n

-- the step without unfolding plus at k: the hypothesis' side is stuck
plus-0-n-stuck (n : ℕ) : plus[Z, n] ≡ n ∈ ℕ :=
  ℕ-elim Ω
    k. plus[Z, k] ≡ k ∈ ℕ
    ⌜δ plus[Z, Z] : ℕ⌝
    k ih. reify
      δ plus[Z, S k]
        ; S ⌞ih⌟
        : ℕ
    n
