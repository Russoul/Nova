-- Σ: a subset type as a dependent pair, its projections and their
-- computation; the sort of a product is the join, never Ω

Zeros : 𝕌0 := (n : ℕ) × (n ≡ Z ∈ ℕ)
zero-witness : (n : ℕ) × (n ≡ Z ∈ ℕ) := (Z, refl (Z : ℕ))
first : ℕ := switch (zero-witness .π₁)
second : zero-witness .π₁ ≡ Z ∈ ℕ := switch (zero-witness .π₂)
first-is-Z : zero-witness .π₁ ≡ Z ∈ ℕ := switch (refl (switch ((δ zero-witness) .π₁) : ℕ))

-- the same element at the item Zeros: converted across Zeros' unfolding,
-- and projected only after converting back
at-Zeros : Zeros := conv zero-witness (((δ Zeros)⁻¹) : 𝕌0)
first-at-Zeros : ℕ := switch (((conv at-Zeros (δ Zeros)) : (n : ℕ) × (n ≡ Z ∈ ℕ)) .π₁)
first-at-Zeros-stuck : ℕ := switch (at-Zeros .π₁)

-- a pair against a non-Σ type, and a projection of a non-pair type
not-a-pair : ℕ := (Z, Z)
not-a-sigma : ℕ := switch ((Z : ℕ) .π₁)

-- products of propositions are small types, not propositions
prod-of-props : 𝕌0 := (Z ≡ Z ∈ ℕ) × (Z ≡ Z ∈ ℕ)
prod-of-props-at-omega : Ω := (Z ≡ Z ∈ ℕ) × (Z ≡ Z ∈ ℕ)
