-- declarations: assumed types, elements, functions and equations,
-- used like any item; a declaration has no definiens to unfold

A : 𝕌0
a : A
f : A → A
ax : a ≡ f a ∈ A

fa : A := f a
use-ax : f a ≡ f (f a) ∈ A := refl (f (reflect ax))
no-delta : A := δ A
twice : A → A := λx. f (f x)
twice-a : twice a ≡ f (f a) ∈ A := refl ((δ twice) a : A)

-- a declared PROPOSITION and a declared proof of it
p : Ω
h : p
h-serves : h ≡ h ∈ p := refl (prop-irrel p h h)

-- an item may not be declared twice
A : 𝕌0
