accepted plus (n : ℕ) (m : ℕ) : ℕ := ℕ-elim ☐₁ (.. S ☐₀) ☐₀
accepted pred (n : ℕ) : ℕ := ℕ-elim Z (.. ☐₁) ☐₀
accepted apply-twice (f : ℕ → ℕ) (x : ℕ) : ℕ := ☐₁ (☐₁ ☐₀)
accepted twice : (ℕ → ℕ) → ℕ → ℕ := λ. λ. ☐₁ (☐₁ ☐₀)
accepted plusSucId (n : ℕ) (m : ℕ) : plus[☐₁, S ☐₀] ≡ S plus[☐₁, ☐₀] ∈ ℕ := ⋆
accepted long-type : 𝕌₀ → (☐₀ → 𝕌₀) → (☐₁ → ☐₁ ☐₀) → ☐₂ → ☐₂ ☐₀ := λ. λ. λ. λ. ☐₁ ☐₀
exit 0
