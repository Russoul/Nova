accepted qeq : class Z ≡ class (S Z) ∈ (ℕ / (.. ∥𝟙∥)) := ⋆
accepted coe (A : 𝕌0) (B : 𝕌0) (h : ☐1 ≡ ☐0 ∈ 𝕌0) (a : ☐2) : ☐2 := ☐0
accepted chain (n : ℕ) : plus[☐0, S Z] ≡ S plus[☐0, Z] ∈ ℕ := ⋆
accepted lam-app : ℕ := (λ. ☐0) Z
accepted pair-proj : ℕ := (Z, S Z) .π₂
accepted let-in : ℕ := let (S Z) (.. S Z)
accepted absurd (e : 𝟘) : ℕ := 𝟘-elim ☐0
accepted eta (f : ℕ → ℕ) : ☐0 ≡ (λ. ☐1 ☐0) ∈ (ℕ → ℕ) := ⋆
