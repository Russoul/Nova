accepted plus (n : ℕ) (m : ℕ) : ℕ := ℕ-elim ☐1 (.. S ☐0) ☐0
accepted sum-case (s : ℕ ⊎ 𝟙) : ℕ := ⊎-elim (. ☐0) (. Z) ☐0
accepted Q : 𝕌0 := ℕ / (.. ∥𝟙∥)
accepted q-const (q : Q) : ℕ := quot-elim (. Z) ☐0
accepted unsq (h : ∥ℕ∥) : ∥𝟙∥ := ⋆
