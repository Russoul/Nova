accepted inj : ℕ ⊎ 𝟙 := inj₁ (S Z)
accepted lifted : 𝕌1 := ℕ
accepted sym-app (n : ℕ) (h : plus[☐0, Z] ≡ ☐0 ∈ ℕ) : ☐1 ≡ plus[☐1, Z] ∈ ℕ := ⋆
