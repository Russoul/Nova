#!/bin/sh
# a let's bindings form a block at the first binding's column; the scope
# is the last block item, or follows `in`
"$1" run surface-elem "let x = Z
    y = S x
    (x, y)"
"$1" run surface-elem "let x = Z in let y = S x in (x, y)"
"$1" run surface-elem "let
  x = Z
  y = S x
  (x, y)"
"$1" run surface-elem "let x : ℕ = Z
    y = S x in (x, y)"
# a binding's own argument lines stand deeper than the block
"$1" run surface-elem "let f = S
      Z
    f"
# the scope is positional: a block ending in a binding has none
"$1" run surface-elem "let x = Z
    y = S x"
