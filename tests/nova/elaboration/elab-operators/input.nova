plus : ℕ → ℕ → ℕ
plus = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
mult : ℕ → ℕ → ℕ
mult = λx. λy. ℕ-elim (n. ℕ) Z (n ih. plus x ih) y

infixl 6 +
+ : ℕ → ℕ → ℕ
+ = plus
infixl 7 *
* : ℕ → ℕ → ℕ
* = mult

-- precedence (* over +), mention form, and an obligation to lock the
-- infix printer's output
opTest : (n : ℕ) (m : ℕ) → n + m * Z ≡ n ∈ ℕ using (*.eq, +.eq, mult.eq, plus.eq)
opTest = λn. λm. ⋆
mention : ℕ → ℕ → ℕ
mention = (+)
needsLemma : (n : ℕ) → Z + n ≡ n ∈ ℕ
needsLemma = λn. ⋆
