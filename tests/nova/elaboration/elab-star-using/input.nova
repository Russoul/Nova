-- ⋆: the site's licences (`.eq`, `.unfold`, the η rules);
-- a lemma's NAME places no instance — the instance is stated
infixl 6 +
+ : ℕ → ℕ → ℕ
+ = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
plusZeroId : (n : ℕ) → n + Z ≡ n ∈ ℕ using (+.eq)
plusZeroId = λn. ⋆
plusSucId : (n : ℕ) (m : ℕ) → n + S m ≡ S (n + m) ∈ ℕ using (+.eq)
plusSucId = λn. λm. ⋆
zeroPlusId : (n : ℕ) → Z + n ≡ n ∈ ℕ using (+.eq)
zeroPlusId = λn. ℕ-elim (k. Z + k ≡ k ∈ ℕ) ⋆ (k ih. ⋆) n
sucPlus : (n : ℕ) (m : ℕ) → S n + m ≡ S (n + m) ∈ ℕ using (+.eq)
sucPlus =
  λn. λm. ℕ-elim (k. S n + k ≡ S (n + k) ∈ ℕ) ⋆ (k ih. ⋆) m
plusComm : (n : ℕ) (m : ℕ) → m + n ≡ n + m ∈ ℕ
plusComm =
  λn. λm. ℕ-elim (k. k + n ≡ n + k ∈ ℕ)
    (Z + n ≡⟨ zeroPlusId n ⟩ n ≡⟨ plusZeroId n ⟩ n + Z)
    (k ih.
      (S k + n ≡⟨ sucPlus k n ⟩ S (k + n) ≡⟨ ih ⟩ S (n + k) ≡⟨ plusSucId n k ⟩ n + S k))
    m

-- the instance stated: plusComm b a
scopedGood : (a : ℕ) (b : ℕ) → a + b ≡ b + a ∈ ℕ
scopedGood = λa. λb. plusComm b a
-- two facts at one site: a chain
scopedList : (a : ℕ) (b : ℕ) → (a + b) + Z ≡ b + a ∈ ℕ
scopedList =
  λa. λb. ((a + b) + Z ≡⟨ plusZeroId (a + b) ⟩ a + b ≡⟨ plusComm b a ⟩ b + a)
-- a ⋆ naming a lemma places no instance: the site is an obligation
scopedBad : (a : ℕ) (b : ℕ) → a + b ≡ b + a ∈ ℕ
scopedBad = λa. λb. ⋆
-- hypotheses are facts in scope: the ⋆ closes by them, unlicensed
scopedHyp : (a : ℕ) (b : ℕ) (c : ℕ) → (a ≡ b ∈ ℕ) → a + c ≡ b + c ∈ ℕ
scopedHyp =
  λa. λb. λc. λh. ⋆
