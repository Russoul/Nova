-- Regression: an ETA-APPLIED hole occurrence (Miller pattern). The
-- relation argument of qlift is elided; the pinning equation arrives
-- from Pi-domain decomposition as  r v w ≐ _h[Γ] v w : Ω  under two
-- fresh binders, and must solve as _h ≔ λλ r ☐₁ ☐₀.
data [a : 𝕌] [r : El a → El a → Ω]
     ( Q : U
     ; cls : (x : El a) → El Q
     ; qeq : (x : El a) (y : El a) (h : Prf (r x y)) → cls x ≡ cls y ∈ El Q )

def qlift : (a : 𝕌) (r : El a → El a → Ω) (b : 𝕌)
            (f : El a → El b)
            (resp : (x : El a) (y : El a) → Prf (r x y) → f x ≡ f y ∈ _)
            → El (Q _ r) → El b ≔
  λa. λr. λb. λf. λresp. λq.
    QElim a r (λw. b) (λx. f x) (λx. λy. λh. resp x y h) q

def qliftBeta : (a : 𝕌) (r : El a → El a → Ω) (b : 𝕌)
                (f : El a → El b)
                (resp : (x : El a) (y : El a) → Prf (r x y) → f x ≡ f y ∈ El b)
                (x : El a) → qlift _ _ _ f resp (cls _ r x) ≡ f x ∈ El b ≔
  λa. λr. λb. λf. λresp. λx. ⋆
