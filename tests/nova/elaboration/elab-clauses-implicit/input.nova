-- IMPLICIT COLUMNS of a clausal item (docs/NovaElaboration.txt,
-- Defining equations): an implicit binder of the signature is a
-- column a clause may leave out — auto-bound to the binder's name —
-- or write as {p}.

-- auto-bound, elided in the recursive call
len : {a : 𝕌} (n : ℕ) → a → ℕ
len Z x = Z
len (S m) x = S (len m x)

-- written at the column, renamed, and passed in the recursive call
len' : {a : 𝕌} (n : ℕ) → a → ℕ
len' {b} Z x = Z
len' {b} (S m) x = S (len' {b} m x)

-- the split column is the implicit one
half : {n : ℕ} → 𝟙 → ℕ
half {Z} u = Z
half {S m} u = S (half {m} u)

-- shadowing: the written x wins, the auto-bound column is unnameable
sh : {x : 𝕌} (x' : ℕ) → x' ≡ x' ∈ ℕ
sh x = ⋆

-- the generated lemmas are stated with overrides at the implicit
-- columns and cited like any other
useLen : (x : ℕ) → len 2 x ≡ 2 using (len.eq)
useLen = λx. ⋆
