-- ADMISSION IS THE ITEM'S OWN QUESTION (docs/NovaPipeline.txt). An
-- item that leaves something open cannot be admitted as a definition,
-- and the items after it are not at fault for that: each is put the
-- same question — does it re-check from kernel Σ alone — and admitted
-- if it answers.
--
-- The conaturals below are the case that shows it. Their relator is a
-- stuck ⊎-elim at motive Ω (the SUM clause of lift_𝔽), and nothing
-- but the kernel can say that is a proposition, so `coind`'s closure
-- needs conat/cinf/csucc PRESENT in kernel Σ. Skipping every item
-- after the first open one left them absent, and infSucc failed with
-- a structural error about a goal that was never the problem.
def stuck : ℕ ≔ ?h

def conat : 𝕌 ≔ ν (K 𝟙 ⊎ 𝕏)

def cinf : conat using (conat.unfold) ≔ corec (s : 𝟙. inj₂ s) ()

def csucc : conat → conat using (conat.unfold) ≔
  λn. corec (p : 𝟙 ⊎ conat. inj₂ (⊎-elim (u. inj₁ u) (m. out m) p)) (out n)

def outInf : out cinf ≡ inj₂ cinf ∈ 𝟙 ⊎ conat
  using (cinf.eq, conat.eq, hyp.rw, conat.unfold) ≔ ⋆

def outSuccInf : out (csucc cinf) ≡ inj₂ (csucc cinf) ∈ 𝟙 ⊎ conat
  using (cinf.eq, conat.eq, csucc.eq, hyp.rw, conat.unfold) ≔ ⋆

def infSucc : cinf ≡ csucc cinf using (cinf.eq, csucc.eq, hyp.rw, conat.unfold) ≔
  coind (x y. ∥(x ≡ cinf ∈ conat) × (y ≡ csucc cinf ∈ conat)∥)
        (⋆ (⋆, ⋆))
        (x y h. squash-elim h (w. ⋆ (⋆, ⋆)))
