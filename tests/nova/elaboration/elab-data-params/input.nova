-- Parameterized QIITs: the literal lives over an ambient telescope
-- (Foundation's Γ ⊦ 𝒮 qsig); every generated def abstracts over it.
data [a : 𝕌] ( Bag : U
             ; nil : El Bag
             ; ins : (x : El a) (m : El Bag) → El Bag
             ; swp : (x : El a) (y : El a) (m : El Bag) → ins x (ins y m) ≡ ins y (ins x m) ∈ El Bag )

-- instantiate at ℕ: the imposed equation, both routes
def swapN : ins ℕ Z (ins ℕ (S Z) (nil ℕ)) ≡ ins ℕ (S Z) (ins ℕ Z (nil ℕ)) ∈ El (Bag ℕ) ≔
  swp ℕ Z (S Z) (nil ℕ)

def swapN' : ins ℕ Z (ins ℕ (S Z) (nil ℕ)) ≡ ins ℕ (S Z) (ins ℕ Z (nil ℕ)) ∈ El (Bag ℕ) ≔ Refl

-- polymorphic size, defined once for every a
def sizeP : (a : 𝕌) → El (Bag a) → ℕ ≔
  λa. λm. BagElim a (λb. ℕ) Z (λx. λr. λih. S ih) (λx. λy. λr. λih. Refl) m

def sizeTwoN : sizeP ℕ (ins ℕ Z (ins ℕ (S Z) (nil ℕ))) ≡ S (S Z) ∈ ℕ ≔ Refl

-- a second instantiation: bags of units
def oneU : El (Bag 𝟙) ≔ ins 𝟙 () (nil 𝟙)
def sizeU : sizeP 𝟙 oneU ≡ S Z ∈ ℕ ≔ Refl
