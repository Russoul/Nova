-- calc chains (SearchlessElaboration.md §5.2): midpoints once, each
-- link a named sub-equation; adjacency positions/orientations found
-- by the LINK-SCOPED engine (never the global store), the composite
-- certificate stitched from the adjacency certificates
infixl 6 +
infixl 7 *
+ : ℕ → ℕ → ℕ
+ = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
* : ℕ → ℕ → ℕ
* = λx. λy. ℕ-elim (n. ℕ) Z (n ih. x + ih) y
plusZeroId : (n : ℕ) → n + Z ≡ n ∈ ℕ using (+.eq)
plusZeroId = λn. ⋆
plusSucId : (n : ℕ) (m : ℕ) → n + S m ≡ S (n + m) ∈ ℕ using (+.eq)
plusSucId = λn. λm. ⋆
zeroPlusId : (n : ℕ) → Z + n ≡ n ∈ ℕ using (+.eq, plusZeroId)
zeroPlusId = λn. ℕ-elim (k. Z + k ≡ k ∈ ℕ) ⋆ (k ih. ⋆) n
sucPlus : (n : ℕ) (m : ℕ) → S n + m ≡ S (n + m) ∈ ℕ using (+.eq)
sucPlus =
  λn. λm. ℕ-elim (k. S n + k ≡ S (n + k) ∈ ℕ) ⋆ (k ih. ⋆) m
plusComm : (n : ℕ) (m : ℕ) → m + n ≡ n + m ∈ ℕ
plusComm =
  λn. λm. ℕ-elim (k. k + n ≡ n + k ∈ ℕ)
    (Z + n ≡⟨ zeroPlusId n ⟩ n ≡⟨ plusZeroId n ⟩ n + Z)
    (k ih.
      (S k + n ≡⟨ sucPlus k n ⟩ S (k + n) ≡⟨ ih ⟩ S (n + k) ≡⟨ plusSucId n k ⟩ n + S k))
    m
plusAssoc : (n : ℕ) (m : ℕ) (k : ℕ) → n + m + k ≡ n + (m + k) ∈ ℕ using (+.eq)
plusAssoc =
  λn. λm. λk. ℕ-elim (j. n + m + j ≡ n + (m + j) ∈ ℕ) ⋆ (j ih. ⋆) k
swapLeft : (a : ℕ) (b : ℕ) (c : ℕ) → a + (b + c) ≡ b + (a + c) ∈ ℕ using (plusComm)
swapLeft =
  λa. λb. λc. ℕ-elim (k. a + (b + k) ≡ b + (a + k) ∈ ℕ)
    (a + (b + Z) ≡⟨ plusZeroId b ⟩ a + b ≡⟨ plusComm b a ⟩ b + a ≡⟨ plusZeroId a ⟩ b + (a + Z))
    (k ih. ⋆ using (+.eq)) c
multZeroId : (n : ℕ) → n * Z ≡ Z ∈ ℕ using (*.eq)
multZeroId = λn. ⋆
multSucId : (n : ℕ) (m : ℕ) → n * S m ≡ n + n * m ∈ ℕ using (*.eq, +.eq)
multSucId = λn. λm. ⋆
zeroMult : (n : ℕ) → Z * n ≡ Z ∈ ℕ using (multZeroId)
zeroMult =
  λn. ℕ-elim (k. Z * k ≡ Z ∈ ℕ) ⋆
    (k ih. (Z * S k ≡⟨ multSucId Z k ⟩ Z + Z * k ≡⟨ ih ⟩ Z + Z ≡⟨ zeroPlusId Z ⟩ Z))
    n
sucMult : (n : ℕ) (m : ℕ) → S n * m ≡ m + n * m ∈ ℕ
sucMult =
  λn. λm. ℕ-elim (k. S n * k ≡ k + n * k ∈ ℕ)
    (S n * Z ≡⟨ multZeroId (S n) ⟩ Z ≡⟨ multZeroId n ⟩ n * Z ≡⟨ zeroPlusId (n * Z) ⟩ Z + n * Z)
    (k ih.
      (S n * S k
         ≡⟨ multSucId (S n) k ⟩
       S n + S n * k
         ≡⟨ ih ⟩
       S n + (k + n * k)
         ≡⟨ swapLeft (S n) k (n * k) ⟩
       k + (S n + n * k)
         ≡⟨ sucPlus n (n * k) ⟩
       k + S (n + n * k)
         ≡⟨ plusSucId k (n + n * k) ⟩
       S (k + (n + n * k))
         ≡⟨ sucPlus k (n + n * k) ⟩
       S k + (n + n * k)
         ≡⟨ multSucId n k ⟩
       S k + n * S k))
    m
multComm : (n : ℕ) (m : ℕ) → m * n ≡ n * m ∈ ℕ
multComm =
  λn. λm. ℕ-elim (k. k * n ≡ n * k ∈ ℕ)
    (Z * n ≡⟨ zeroMult n ⟩ Z ≡⟨ multZeroId n ⟩ n * Z)
    (k ih.
      (S k * n ≡⟨ sucMult k n ⟩ n + k * n ≡⟨ ih ⟩ n + n * k ≡⟨ multSucId n k ⟩ n * S k))
    m

-- each multComm link is a SUB-equation applied at an inner position
-- (the second summand — the strict engine's congruence descent covers
-- second arguments; a first-argument rewrite would need explicit
-- cong), the plusComm links whole-side permutative matches in both
-- orientations — no cong, no sym
mulComm2 : (u1 : ℕ) (u2 : ℕ) (v1 : ℕ) (v2 : ℕ) →
  u1 * v1 + u2 * v2 ≡ v1 * u1 + v2 * u2 ∈ ℕ
mulComm2 =
  λu1. λu2. λv1. λv2.
    u1 * v1 + u2 * v2
      ≡⟨ multComm v2 u2 ⟩ u1 * v1 + v2 * u2
      ≡⟨ plusComm (v2 * u2) (u1 * v1) ⟩ v2 * u2 + u1 * v1
      ≡⟨ multComm v1 u1 ⟩ v2 * u2 + v1 * u1
      ≡⟨ plusComm (v1 * u1) (v2 * u2) ⟩ v1 * u1 + v2 * u2
