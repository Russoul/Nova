-- deferred intro-form arguments: a λ (or pair) at a still-holey
-- domain waits for the joint solve — cong's first argument is
-- recoverable even though the dependent λ at B precedes the
-- type-determining proof in the spine

cong2 : (A : 𝕌)
  (B : A → 𝕌)
  (f : (x : A) → (B x))
  (a b : A) → (a ≡ b) → f a ≡ f b ∈ (B b)
  using (hyp.rw)
cong2 = λA. λB. λf. λa. λb. λh. ⋆

double : ℕ → ℕ
double = λn. ℕ-elim Z (k ih. S (S ih)) n

useCong : (n m : ℕ) → (n ≡ m) → double n ≡ double m
useCong = λn. λm. λh. cong2 _ (λu. ℕ) (λx. double x) _ _ h

-- and the failure mode: every argument is an intro (the ⋆ defers
-- too), so nothing ever binds A — the unsolvability is reported at
-- the blank, not blamed on the λ
bad : (n : ℕ) → double n ≡ double n
bad = λn. cong2 _ (λu. ℕ) (λx. double x) _ _ ⋆
