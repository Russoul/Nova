-- ν formation, corec introduction, out observation; both β-lemmas
-- close by computation (el-nu-beta)
stream : 𝕌 → 𝕌
stream = λa. ν (K a × 𝕏)
iterate : (a : 𝕌) → (a → a) → a → (stream a) using (stream.unfold)
iterate =
  λa. λf. λx. corec (s : a. (s , f s)) x
hd : (a : 𝕌) → (stream a) → a using (stream.unfold)
hd = λa. λt. (out t) .π₁
tl : (a : 𝕌) → (stream a) → (stream a) using (stream.unfold)
tl = λa. λt. (out t) .π₂
hdIter : (a : 𝕌) (f : a → a) (x : a) → hd a (iterate a f x) ≡ x ∈ a using (hd.eq, iterate.eq)
hdIter =
  λa. λf. λx. ⋆
hdTlIter : (a : 𝕌) (f : a → a) (x : a) → hd a (tl a (iterate a f x)) ≡ f x ∈ a using (hd.eq, iterate.eq, tl.eq)
hdTlIter =
  λa. λf. λx. ⋆
