-- unsquash: the ∥∥ VARIABLE elimination (docs/NovaElaboration.txt,
-- e-unsquash). The body is elaborated where the variable is GONE and
-- a witness of the squashee stands innermost instead. The witness's
-- position is forced — el-squash-e-prf binds it there, and Π-closing
-- to move it earlier would make the goal a Π, which is never a prop.
P : ℕ → Ω
P = λn. n ≡ n ∈ ℕ

-- the plain case: the variable goes, the witness arrives
plain : (w : ∥ℕ∥) → Z ≡ Z ∈ ℕ
plain = λw. unsquash (x. ⋆) w

-- entries on both sides of the variable, none naming it
around : (n : ℕ) (w : ∥ℕ∥) (h : P n) → P n using (P.eq)
around =
  λn. λw. λh. unsquash (x. h) w

-- the witness is usable, and the rest of the family takes it from there
viaSum : (a b : Ω) (w : ∥a ⊎ b∥) → ∥b ⊎ a∥
viaSum =
  λa. λb. λw. unsquash (x. ⋆ (sum-elim (l. inj₂ l) (r. inj₁ r) x)) w

-- nested, reaching an outer binder
nested : (p : ℕ × ℕ) (w : ∥ℕ∥) → Z ≡ Z ∈ ℕ
nested = λp. λw. sigma-elim (a b. unsquash (x. ⋆) w) p
nestedTwice : (w : ∥ℕ∥) (v : ∥ℕ∥) (n : ℕ) → n ≡ n ∈ ℕ
nestedTwice = λw. λv. λn. unsquash (x. unsquash (y. ⋆) v) w

-- a HOLE: its goal is stated where the variable is gone
hole : (n : ℕ) (w : ∥ℕ∥) (h : P n) → P n
hole = λn. λw. λh. unsquash (x. ?g) w
