plus : ℕ → ℕ → ℕ
plus Z n = n
plus (S m) n = S (plus m n)

plusZr : (n : ℕ) → plus n Z ≡ n ∈ ℕ using (plus.eq, plusZ)
plusZr = λn. ℕ-elim (x. plus x Z ≡ x ∈ ℕ) ⋆ (k ih. ⋆) n

plusByHand : ℕ → ℕ → ℕ
plusByHand = λm. λn. ℕ-elim (x. ℕ) n (k ih. S ih) m
byHandIsPlus : (m : ℕ) (n : ℕ) → plusByHand m n ≡ plus m n ∈ ℕ using (plusByHand.eq)
byHandIsPlus = λm. λn. plusEta plusByHand (λx. ⋆) (λk. λx. ⋆) m n

addAcc : ℕ → ℕ → ℕ
addAcc Z n = n
addAcc (S m) n = addAcc m (S n)

swap : ℕ ⊎ 𝟙 → 𝟙 ⊎ ℕ
swap (inj₁ n) = inj₂ n
swap (inj₂ u) = inj₁ u

double : ℕ → ℕ
double n = plus n n

infixl 6 ⊞
⊞ : ℕ → ℕ → ℕ [oplusEta]
Z ⊞ n = n [oplusZ]
S m ⊞ n = S (m ⊞ n) [oplusS]
