-- el-quot-eq at an ARBITRARY Ω-valued relation: the witness is supplied
-- (e-star-quot-wit), so the relation need not be ∥𝟙∥- or ≡-shaped — here
-- it is an opaque relation variable.
classEqOfRel : (A : 𝕌) (r : A → A → Ω) (x : A) (y : A) →
  (r x y) → class x ≡ class y ∈ (A / (u v. r u v))
classEqOfRel =
  λA. λr. λx. λy. λh. ⋆ h
