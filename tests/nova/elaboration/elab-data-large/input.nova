-- A LARGE signature (an external domain neither 𝕌- nor Ω-typed): the sort
-- still forms a perfectly good TYPE (emitted as a type item), it just
-- has no universe code — the ty-pi/code-pi divide, load-bearing
-- (code-qiit's smallness prevents the type-in-type retract).
data ( W : U
     ; mkW : (f : 𝕌 → 𝟙) → El W )
def wit : W using (W.unfold) ≔ mkW (λu. ())
