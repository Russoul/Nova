import nat (plus, zeroPlusId)

-- opened names bare, unopened ones qualified; the imported lemma
-- store discharges the local ⋆
two : ℕ
two = plus (S Z) (S Z)
useQualified : (n : ℕ) → nat.plus n Z ≡ n ∈ ℕ
useQualified = λn. nat.plusZeroId n
needsLemma : (n : ℕ) → plus Z n ≡ n ∈ ℕ using (zeroPlusId, zeroPlusId.rw)
needsLemma = λn. ⋆
