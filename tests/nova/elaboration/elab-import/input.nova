import nat (plus, zeroPlusId)

-- opened names bare, unopened ones qualified; an imported lemma's
-- instance is stated where it is used
two : ℕ
two = plus (S Z) (S Z)
useQualified : (n : ℕ) → nat.plus n Z ≡ n ∈ ℕ
useQualified = λn. nat.plusZeroId n
needsLemma : (n : ℕ) → plus Z n ≡ n ∈ ℕ
needsLemma = λn. zeroPlusId n
