import nat (plus, zeroPlusId)

-- opened names bare, unopened ones qualified; the imported lemma
-- store discharges the local ⋆
def two : ℕ ≔ plus (S Z) (S Z)
def useQualified : (n : ℕ) → nat.plus n Z ≡ n ∈ ℕ ≔ λn. nat.plusZeroId n
def needsLemma : (n : ℕ) → plus Z n ≡ n ∈ ℕ using (zeroPlusId) ≔ λn. ⋆
