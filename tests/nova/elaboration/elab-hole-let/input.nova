-- el-let leaves TWO entries in the context — the value and its
-- unfolding equation — where the source wrote ONE binding, so the
-- report folds the pair back into an annotated let (The report,
-- conventions). Nested lets fold one binding each; unfolded, they
-- would double the context of every goal after them.
f : (n : ℕ) → ℕ
f = λn. let m = n in ?goal

g : (n : ℕ) → ℕ
g = λn. let m = n in let k = m in ?deep

-- The fold is by SHAPE and by ANONYMITY. A NAMED hypothesis of the
-- let shape is a hypothesis the operator introduced, and stays one.
named : (n : ℕ) (m : ℕ) → (m ≡ n ∈ ℕ) → ℕ
named = λn. λm. λp. ?keep

-- An ANONYMOUS one folds, which states exactly what it says: m is
-- this context's name for n.
anon : (n : ℕ) (m : ℕ) → (m ≡ n ∈ ℕ) → ℕ
anon = λn. λm. λ_. ?fold
