-- Regression: general Miller patterns from impredicative-closure
-- transitivity. The relation-instantiation holes are pinned as
-- _R v w ≐ R v w under THREE binders (v w applied, u not — the
-- non-innermost shape needing true inversion), and the middle-point
-- hole is pinned only after the internal rerun beta-normalizes the
-- carried solutions inside the equal-head spine walk.
def clos : (A : 𝕌) → (El A → El A → Ω) → El A → El A → Ω ≔
  λA. λr. λa. λb. ∥ (R : El A → El A → Ω)
    → ((x : El A) (y : El A) (z : El A) → Prf (R x y) → Prf (R y z) → Prf (R x z))
    → Prf (R a b) ∥

def ctrans : (A : 𝕌) (r : El A → El A → Ω) (a : El A) (b : El A) (c : El A) →
  Prf (clos _ r a b) → Prf (clos _ r b c) → Prf (clos _ r a c) ≔
  λA. λr. λa. λb. λc. λhab. λhbc.
    squash-elim hab (uab.
      squash-elim hbc (ubc.
        ⋆ (λR. λtrans.
            trans _ _ _ (uab _ trans) (ubc _ trans))))
