-- the WITNESS of a quotient elimination: (x x' h. p) between the case
-- and the scrutinee states the case's well-definedness; the
-- eliminator fixes the binders, the relation and both sides
infixl 6 +
+ : ℕ → ℕ → ℕ
+ = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
symN : (a b : ℕ) → (a ≡ b ∈ ℕ) → b ≡ a ∈ ℕ
symN = λa. λb. λh. ⋆

-- pairs modulo the difference relation; swapping a pair respects it
Q : 𝕌
Q = (ℕ × ℕ) / (x y. x .π₁ + y .π₂ ≡ x .π₂ + y .π₁ ∈ ℕ)
swapWD : (x x' : ℕ × ℕ) → (x .π₁ + x' .π₂ ≡ x .π₂ + x' .π₁ ∈ ℕ) → x .π₂ + x' .π₁ ≡ x .π₁ + x' .π₂ ∈ ℕ
swapWD = λx. λx'. λh. symN _ _ h

-- the witness is an INFERENCE form: its statement is the fact — here
-- the relation the class equation follows from
neg : Q → Q  using (Q.unfold)
neg = λq. quot-elim (x. class (x .π₂, x .π₁)) (x x' h. swapWD x x' h) q

-- the witness is a CHECKED form: a chain at the case equation, its
-- one step by the fact stated as a claim
neg' : Q → Q  using (Q.unfold)
neg' =
  λq. quot-elim
    x. class (x .π₂, x .π₁)
    x x' h. class (x .π₂, x .π₁)
              ≡⟨ (let c = swapWD x x' h in (⋆ : class (x .π₂, x .π₁) ≡ class (x' .π₂, x' .π₁) ∈ Q)) ⟩ class (x' .π₂, x' .π₁)
    q

-- a witness that does not close the case equation (doubling needs
-- arithmetic the hypothesis alone does not give): the obligation
-- stands at the eliminator, as without a witness
bad : Q → Q  using (Q.unfold)
bad = λq. quot-elim (x. class (x .π₁ + x .π₁, x .π₂ + x .π₂)) (x x' h. h) q

-- an Ω-valued motive owes nothing; a witness given anyway is
-- elaborated and set aside
triv : Q → Ω  using (Q.unfold)
triv = λq. quot-elim (z. Ω) (x. x .π₁ ≡ x .π₁ ∈ ℕ) (x x' h. h) q
