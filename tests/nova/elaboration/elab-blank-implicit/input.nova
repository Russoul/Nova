-- a blank never binds to an implicit position: it defers past the
-- inserted hole to the next EXPLICIT position
propId : {A : 𝕌} (B : 𝕌) → B → A → A
propId = λA. λB. λb. λa. a

use : ℕ → 𝟙 → ℕ
use = λn. λu. propId _ u n

-- and composes with overloads: the blank contributes no type, the
-- other arguments select the candidate
infixl 6 +
+ : ℕ → ℕ → ℕ
+ = λx. λy. ℕ-elim x (n ih. S ih) y

dup : (n : ℕ) → ℕ
dup = λn. n + n

cst : (A B : 𝕌) → A → B → A
cst = λA. λB. λa. λb. a

blankInOp : ℕ → ℕ
blankInOp = λn. cst _ _ n () + n
