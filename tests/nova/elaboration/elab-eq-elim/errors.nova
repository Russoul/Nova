-- the scrutinee must be a VARIABLE ...
notVar : (x : ℕ) (w : x ≡ Z) → ℕ
notVar = λx. λw. ≡-elim Z (S x) w
-- ... and so must the equation
notHyp : (x : ℕ) (w : x ≡ Z) → ℕ
notHyp = λx. λw. ≡-elim Z x ⋆
-- the equation must stand INSIDE the variable it names
outside : (w : Z ≡ Z) (x : ℕ) → ℕ
outside = λw. λx. ≡-elim Z x w
-- ... and must have that variable on a side
offSide : (x : ℕ) (n : ℕ) (w : n ≡ Z) → ℕ
offSide = λx. λn. λw. ≡-elim Z x w
-- ... and be an equation at all
notEq : (x : ℕ) (w : ℕ) → ℕ
notEq = λx. λw. ≡-elim Z x w
-- the other side must stand OUTSIDE the variable's own entry
notOutside : (x : ℕ) (w : x ≡ S x) → ℕ
notOutside = λx. λw. ≡-elim Z x w
-- the proof may not name what it eliminates (see scope.nova)
-- BLOCKED: the entry that would have to be crossed names the variable
-- itself, so no order of the context puts the other side first
blocked : (u : ℕ) (k : ℕ ≡ u ∈ 𝕌) (v : ℕ) (w : u ≡ S v) → ℕ
blocked = λu. λk. λv. λw. ≡-elim Z u w
