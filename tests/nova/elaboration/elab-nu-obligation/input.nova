-- coinduction with a NON-closing invariant: the closure's head
-- component is Z ≐ S Z, which stays an OBLIGATION (not an error) —
-- the coind payload composes with the ordinary obligation loop
def stream : 𝕌 → 𝕌 ≔ λa. ν (K a ⨯ 𝕏)
def zeros : El (stream ℕ) ≔ corec (s : 𝟙. (Z , s)) ()
def ones : El (stream ℕ) ≔ corec (s : 𝟙. (S Z , s)) ()
def bad : zeros ≡ ones ∈ El (stream ℕ) ≔
  coind (x y. ∥(x ≡ zeros ∈ El (stream ℕ)) ⨯ (y ≡ ones ∈ El (stream ℕ))∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ ((⋆ , ⋆))))))
