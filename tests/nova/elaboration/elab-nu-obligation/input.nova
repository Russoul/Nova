-- a bisimulation-shaped equation needs el-nu-eta, which has no kernel
-- certificate (NovaKernel.txt, A5): it stays an OBLIGATION, not an error
def stream : 𝕌 → 𝕌 ≔ λa. ν (K a ⨯ 𝕏)
def cons : (a : 𝕌) → El a → El (stream a) → El (stream a) ≔
  λa. λx. λs. corec (p : a ⨯ stream a. ((p .π₁) , out (p .π₂))) (x , s)
def tl : (a : 𝕌) → El (stream a) → El (stream a) ≔ λa. λt. (out t) .π₂
def tlCons : (a : 𝕌) (x : El a) (s : El (stream a)) → tl _ (cons _ x s) ≡ s ∈ El (stream a) ≔
  λa. λx. λs. ⋆
