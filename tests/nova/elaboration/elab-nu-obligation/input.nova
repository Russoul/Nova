-- coinduction with a NON-closing invariant: the closure's head
-- component is Z ≐ S Z, which stays an OBLIGATION (not an error) —
-- the coind payload composes with the ordinary obligation loop
stream : 𝕌 → 𝕌
stream = λa. ν (K a × 𝕏)
zeros : (stream ℕ) using (stream.unfold)
zeros = corec (s : 𝟙. (Z , s)) ()
ones : (stream ℕ) using (stream.unfold)
ones = corec (s : 𝟙. (S Z , s)) ()
bad : zeros ≡ ones ∈ (stream ℕ) using (hyp.rw, stream.unfold, zeros.eq, ones.eq, stream.eq)
bad =
  coind (x y. ∥(x ≡ zeros ∈ (stream ℕ)) × (y ≡ ones ∈ (stream ℕ))∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ ((⋆ , ⋆))))))
