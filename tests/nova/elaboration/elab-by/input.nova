-- e-by: p by f₁, …, fₙ — the proof under the facts; the facts
-- inferred (their statements propositions), the proof checked under them
infixl 6 +
+ : ℕ → ℕ → ℕ
+ = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
plusZeroId : (n : ℕ) → n + Z ≡ n ∈ ℕ  using (+.eq)
plusZeroId = λn. ⋆
plusSucId : (n : ℕ) (m : ℕ) → n + S m ≡ S (n + m) ∈ ℕ  using (+.eq)
plusSucId = λn. λm. ⋆
zeroPlusId : (n : ℕ) → Z + n ≡ n ∈ ℕ  using (+.eq)
zeroPlusId = λn. ℕ-elim (k. Z + k ≡ k ∈ ℕ) ⋆ (k ih. ⋆) n
sucPlus : (n : ℕ) (m : ℕ) → S n + m ≡ S (n + m) ∈ ℕ  using (+.eq)
sucPlus = λn. λm. ℕ-elim (k. S n + k ≡ S (n + k) ∈ ℕ) ⋆ (k ih. ⋆) m

-- two facts and the proof: commutativity's step case by the three
-- equations it rewrites with
plusComm : (n : ℕ) (m : ℕ) → m + n ≡ n + m ∈ ℕ
plusComm =
  λn. λm. ℕ-elim (k. k + n ≡ n + k ∈ ℕ)
    (⋆ by zeroPlusId n, plusZeroId n)
    (k ih. ⋆ by sucPlus k n, ih, plusSucId n k)
    m

-- the proof a lemma's instance, by one fact
plusCommZ : (n : ℕ) → Z + n ≡ n + Z ∈ ℕ
plusCommZ = λn. plusZeroId n by zeroPlusId n

-- a fact must state a proposition
notAFact : (n : ℕ) → n + Z ≡ n ∈ ℕ
notAFact = λn. plusZeroId n by n

-- facts that do not reach the proposition: the obligation stands,
-- the facts in its context
short : (n : ℕ) (m : ℕ) → m + n ≡ n + m ∈ ℕ
short = λn. λm. ⋆ by plusZeroId n, plusZeroId m

-- a chain step by a fact: the justification infers under it
plusCommC : (n : ℕ) → Z + n ≡ n + Z ∈ ℕ
plusCommC = λn. (Z + n ≡⟨ zeroPlusId n ⟩ n ≡⟨ plusZeroId n by zeroPlusId n ⟩ n + Z)
