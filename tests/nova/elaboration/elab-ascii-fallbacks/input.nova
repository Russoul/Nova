-- Every token's ASCII FALLBACK (docs/NovaElaboration.txt). The whole
-- file is ASCII; `nova distill` renders it back in Unicode, which is
-- the pairing's normal form. Includes the two spellings that had to be
-- reserved (-> and ==; the definiens token is = itself) and the \x / lambda-binding-x collision.
infixl 6 +
+ : Nat -> Nat -> Nat
+ = \x. \y. Nat-elim x (n ih. S ih) y

id : {A : Set} (x : A) -> A
id = \A. \x. x
idP : {A : Prop} (x : A) -> A
idP = \A. \x. x
absurd : {A : Set} -> Void -> A
absurd = \A. \v. Void-elim v
unit : Unit
unit = ()

prod : Set -> Set -> Set
prod = \a. \b. a \x b
uncurry : Nat \x Nat -> Nat
uncurry = \p. p .1 + p .2
sum : Set -> Set -> Set
sum = \a. \b. a \/ b
swap : {a b : Set} -> a \/ b -> b \/ a
swap =
  \a. \b. \s. \/-elim (z. b \/ a) (u. inj2 u) (v. inj1 v) s

squash : Set -> Prop
squash = \a. ||a||
plusZ : (n : Nat) -> n + Z == n \in Nat using (+.eq)
plusZ = \n. \star
four : Nat
four = 2 + 2

chain : (n : Nat) -> Z + n == n \in Nat using (+.eq)
chain =
  \n. Nat-elim \star (k ih. \star) n

-- a lambda binding exactly `x` still wins over the \x product token:
-- lambda is tried first and demands its `.`
lamX : Nat -> Nat
lamX = \x. x
prodX : Nat \x Nat -> Nat
prodX = \p. p .1

-- identifiers merely STARTING with a reserved constant are unaffected
NatAlg : Set
NatAlg = Nat
Setoid : Set
Setoid = Nat
