-- the scrutinee must be a VARIABLE — ⊎-elim is the form that takes any
notVar : (w : ℕ ⊎ ℕ) → ℕ
notVar = λw. sum-elim (a. a) (b. b) (inj₁ Z)
-- ... of a ⊎ type
notSum : (n : ℕ) → ℕ
notSum = λn. sum-elim (a. a) (b. b) n
-- and it infers nothing: the branches meet only at the expected type
infers : (w : ℕ ⊎ ℕ) → ℕ
infers = λw. (sum-elim (a. λn. n) (b. λn. n) w) Z
