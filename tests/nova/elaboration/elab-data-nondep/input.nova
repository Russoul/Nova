-- Non-dependent Π syntax in data entries: a bare domain binds an
-- anonymous binder (cls : El a → El Q), mixing freely with named
-- groups and arrows between groups; external and Prf domains may
-- stand bare mid-telescope too.
data [a : 𝕌] [r : El a → El a → Ω]
     ( Q : U
     ; cls : El a → El Q
     ; qeq : (x : El a) (y : El a) → Prf (r x y) → cls x ≡ cls y ∈ El Q )

data ( V : El ℕ → U
     ; vnil : El (V Z)
     ; vcons : (n : El ℕ) → El (V n) → El (V (S n)) )

def two : El (V (S (S Z))) ≔ vcons (S Z) (vcons Z vnil)
def q1 : (x : El ℕ) → El (Q ℕ (λv. λw. ∥𝟙∥)) ≔ λx. cls ℕ (λv. λw. ∥𝟙∥) x
