stream : 𝕌 → 𝕌
stream = λa. ν (K a × 𝕏)
zerosA : (stream ℕ) using (stream.unfold)
zerosA = corec (s : 𝟙. (Z , s)) ()
zerosB : (stream ℕ) using (stream.unfold)
zerosB = corec (s : ℕ. (Z , s)) Z

-- pipeline smoke: coinduction with equality itself as the invariant
triv : zerosB ≡ zerosB ∈ (stream ℕ) using (hyp.rw, stream.unfold)
triv =
  coind (x y. x ≡ y ∈ (stream ℕ)) ⋆ (x y h. ⋆ ((⋆ , ⋆)))

-- the real thing: two different carriers, same behavior
zerosEq : zerosA ≡ zerosB ∈ (stream ℕ) using (hyp.rw, stream.unfold, zerosA.eq, zerosB.eq, stream.eq)
zerosEq =
  coind (x y. ∥(x ≡ zerosA ∈ (stream ℕ)) × (y ≡ zerosB ∈ (stream ℕ))∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ ((⋆ , ⋆))))))
