-- The VARIABLE-ELIMINATING forms nested inside one another. Each of
-- them REPLACES a context entry rather than extending the context, so
-- the parser's reindexing must descend COMPOSED with the inner node's
-- own — otherwise an outer binder named from an inner branch is
-- silently mis-shifted and the result is a well-typed WRONG term.
--
-- Elaborating is therefore not enough to test it: each value is pinned
-- by an equation, which is what fails when the wrong variable is
-- picked up.

-- inner body is the OUTER binder `a`, so f (m,n) (u,v) must be m
def f : (p : ℕ × ℕ) (q : ℕ × ℕ) → ℕ
  ≔ λp. λq. sigma-elim (a b. sigma-elim (c d. a) q) p
def fPins : f (1, 0) (0, 0) ≡ 1 using (f.eq) ≔ ⋆

-- a sum-elim nested in a sigma-elim's body, reaching the outer binders
def g : (p : ℕ × ℕ) (w : ℕ ⊎ ℕ) → ℕ
  ≔ λp. λw. sigma-elim (a b. sum-elim (u. a) (v. b) w) p
def gPinsL : g (1, 2) (inj₁ 0) ≡ 1 using (g.eq) ≔ ⋆
def gPinsR : g (1, 2) (inj₂ 0) ≡ 2 using (g.eq) ≔ ⋆

-- a sigma-elim nested in a sum-elim's branch, reaching the branch binder
def h : (w : ℕ ⊎ ℕ) (p : ℕ × ℕ) → ℕ
  ≔ λw. λp. sum-elim (u. sigma-elim (a b. u) p) (v. v) w
def hPins : h (inj₁ 7) (0, 0) ≡ 7 using (h.eq) ≔ ⋆

-- an ≡-elim nested inside a sigma-elim's body
def k : (p : ℕ × ℕ) (x : ℕ) (w : x ≡ Z) → ℕ
  ≔ λp. λx. λw. sigma-elim (a b. ≡-elim a x w) p
def kPins : k (5, 0) Z ⋆ ≡ 5 using (k.eq) ≔ ⋆

-- AND THE POSITION'S OWN TYPE. A goal component may stand under a
-- binder the replay descends through — the SECOND component of a Σ is
-- the everyday case — and the child types the kernel reads off a
-- neutral subterm there are read at shifted indices. Resolving them
-- against Γ as if the binder were not crossed picks a different entry,
-- and the step is refused against a type that was never the
-- position's. Both spellings below are the same equation; only the
-- side of the × differs.
def st : 𝕌 → 𝕌 ≔ λa. ν (K a × 𝕏)
def underSnd : {a : 𝕌} (v : st a) (u : st a)
  (e : u ≡ corec (p : a × st a. p .π₁, out (p .π₂)) (out v) ∈ st a)
  → ∥𝟙 × (out u .π₂ ≡ corec (p : a × st a. p .π₁, out (p .π₂)) (out (out v .π₂)) ∈ st a)∥
  using (st.unfold) ≔
  λa. λv. λu. λe. ≡-elim (⋆ ((), ⋆)) u e

def underFst : {a : 𝕌} (v : st a) (u : st a)
  (e : u ≡ corec (p : a × st a. p .π₁, out (p .π₂)) (out v) ∈ st a)
  → ∥(out u .π₂ ≡ corec (p : a × st a. p .π₁, out (p .π₂)) (out (out v .π₂)) ∈ st a) × 𝟙∥
  using (st.unfold) ≔
  λa. λv. λu. λe. ≡-elim (⋆ (⋆, ())) u e
