-- SHAPE-DEMANDING POSITIONS. A hole has no type to infer, but each of
-- these positions already fixes the type's FORMER, so the hole is
-- minted at that former and every component the position leaves open
-- becomes a derived type hole (`?h/role`). Nothing is solved: the
-- conversions that follow surface as obligations saying what each
-- component would have to be.
proj  : ℕ
proj = ?p .π₁
proj2 : ℕ
proj2 = ?q .π₂
sums  : ℕ
sums = ⊎-elim (z. ℕ) (a. Z) (b. Z) ?s
app   : ℕ
app = ?f Z
quotE : ℕ
quotE = quot-elim (z. ℕ) (a. Z) ?c

-- the motivating case: the scrutinee fixes ∥-∥, so the BODY's hole
-- still gets its real goal, under a hypothetical inhabitant of the
-- (open) squashee
squashE : (n : ℕ) → ∥ℕ∥
squashE = λn. squash-elim ?e (w. ?body)
