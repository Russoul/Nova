defined plus
defined lemma [+1 hole]
defined f [+1 hole]
defined mixed [+1 obligation, +1 hole]
open obligations (1):
  [1] (n : ℕ) ⊢ ?k ≐ S n : ℕ
      at: def mixed: checking ⋆
      from composite: (n : ℕ) ⊢ S ?k ≐ S (S n) : ℕ
open holes (3):
  [?base] (n : ℕ) ⊢ ? : plus Z n ≡ n ∈ ℕ
      at: def lemma
  [?T] ⊢ ? type
      at: def f
  [?k] (n : ℕ) ⊢ ? : ℕ
      at: def mixed
