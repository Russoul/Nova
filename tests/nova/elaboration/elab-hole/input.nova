-- A named hole reports its goal: the ambient context, with binder
-- names, and the type the checking position expects.
double : ℕ → ℕ
double = λn. ?body

useSum : (n : ℕ) → n ≡ n ∈ ℕ
useSum = λn. ?refl

-- two holes of one item, each at its own goal
pair : (n : ℕ) → ℕ × ℕ
pair = λn. (?left, ?right)
