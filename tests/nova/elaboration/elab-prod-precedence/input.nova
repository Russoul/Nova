-- × IS TWO OPERATORS (docs/NovaElaboration.txt, T{1} and T{1¾}).
-- Each definition below is inhabited by a term that ONLY typechecks
-- under the intended reading, so the test pins the shape, not just
-- the fact that it parses.

-- NON-DEPENDENT × binds tighter than →: the uncurrying shape, bare.
uncurry : 𝟙 × 𝟙 → 𝟙
uncurry = λp. ()

-- ...and tighter than ⊎: product before sum, as * before + .
sumOfProd : 𝟙 ⊎ 𝟙 × 𝟙
sumOfProd = inj₂ ((), ())
prodThenSum : 𝟙 × 𝟙 ⊎ 𝟙
prodThenSum = inj₁ ((), ())

-- ...and right-associates.
prodAssoc : 𝟙 × 𝟙 × 𝟙
prodAssoc = (), (), ()

-- The BINDER form stays at →'s level: its body is still maximal, so
-- the Σ-as-record idiom keeps a trailing law/equation unparenthesized.
binderBodyArrow : (z : 𝟙) × 𝟙 → 𝟙
binderBodyArrow = (), λx. x
binderBodyEq : (z : 𝟙) × z ≡ () ∈ 𝟙
binderBodyEq = (), ⋆

-- A binder group beats the ≡ branch's ascription reading: this is a Σ
-- over an equation, not an equation between (z : 𝟙) × z and ().
binderBeatsAscription : Ω
binderBeatsAscription = ∥(z : 𝟙) × z ≡ () ∈ 𝟙∥

-- A genuine ascription still reaches the ≡ branch.
ascription : Ω
ascription = (() : 𝟙) ≡ () ∈ 𝟙
