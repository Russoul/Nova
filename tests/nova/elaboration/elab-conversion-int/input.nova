def plus : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
type Int ≔ (ℕ ⨯ ℕ) / (p q. ∥plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ∥)
-- Int and its unfolding interchange with no coercion syntax
def viaDef : (z : Int) →
  (ℕ ⨯ ℕ) / (p q. ∥plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ∥) using (Int.unfold) ≔
  λz. z
def viaUnfolding : (z : (ℕ ⨯ ℕ) / (p q. ∥plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ∥)) → Int using (Int.unfold) ≔ λz. z
