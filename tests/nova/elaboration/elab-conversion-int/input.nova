plus : ℕ → ℕ → ℕ
plus = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
Int : 𝕌
Int = (ℕ × ℕ) / (p q. ∥plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ∥)
-- Int and its unfolding interchange with no coercion syntax
viaDef : (z : Int) →
  (ℕ × ℕ) / (p q. ∥plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ∥) using (Int.unfold)
viaDef =
  λz. z
viaUnfolding : (z : (ℕ × ℕ) / (p q. ∥plus (p .π₁) (q .π₂) ≡ plus (p .π₂) (q .π₁) ∈ ℕ∥)) → Int using (Int.unfold)
viaUnfolding = λz. z
