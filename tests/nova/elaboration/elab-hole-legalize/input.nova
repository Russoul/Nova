-- Regression: a solvable hole (_p) pinned through legalize's
-- imitation twins; the internal rerun must carry unsolved twin
-- DECLS alongside solved defs, and the kernel mirror must copy
-- solutions in signature order (dependencies first). This file
-- used to crash with a dangling twin reference.
def ⊥ : Ω ≔ ∥𝟘∥
infixr 3 ⊃
def ⊃ : Ω → Ω → Ω ≔ λp. λq. ∥Prf p → Prf q∥
def ¬ : Ω → Ω ≔ λp. p ⊃ ⊥
infixr 4 ∨
def ∨ : Ω → Ω → Ω ≔ λp. λq. ∥(r : Ω) → (Prf p → Prf r) → (Prf q → Prf r) → Prf r∥
def impIntro : (p : Ω) (q : Ω) → (Prf p → Prf q) → Prf (p ⊃ q) ≔
  λp. λq. λf. ⋆ f
def impApply : (p : Ω) (q : Ω) → Prf (p ⊃ q) → Prf p → Prf q ≔
  λp. λq. λh. λx. squash-elim h (f. f x)
def orInl : (p : Ω) (q : Ω) → Prf p → Prf (p ∨ q) ≔
  λp. λq. λx. ⋆ (λr. λf. λg. f x)
def orInr : (p : Ω) (q : Ω) → Prf q → Prf (p ∨ q) ≔
  λp. λq. λy. ⋆ (λr. λf. λg. g y)

def notNotLem : (p : Ω) → Prf (¬ (¬ (p ∨ ¬ p))) ≔
  λp. impIntro _ _ (λk.
    impApply _ _ k
      (orInr _p (¬ p) (impIntro _ _ (λhp.
        impApply _ _ k (orInl p (¬ p) hp)))))
