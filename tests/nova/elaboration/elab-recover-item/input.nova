-- ITEM RECOVERY: `broken` fails, is reported at its own item, falls
-- back to a DECLARATION of its signature, and the run continues —
-- so `later`'s goal is still reached and `uses` still resolves the
-- broken name.
broken : ℕ
broken = noSuchName

later : ℕ → ℕ
later = λn. ?goal

uses : ℕ
uses = broken
