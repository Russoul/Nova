-- an ABSTRACT INTERFACE: a declared carrier with declared laws; the
-- laws register as lemmas (their stuck references reflect), so code
-- against the interface checks — acceptance stays blocked until the
-- declarations are given definientia
vect : ℕ → 𝕌 → 𝕌
vectS : (n : ℕ) (A : 𝕌) → vect (S n) A ≡ (A × vect n A) ∈ 𝕌
two : 𝕌
two = vect (S (S Z)) ℕ
twoIsPair : two ≡ (ℕ × vect (S Z) ℕ) ∈ 𝕌  using (two.eq)
twoIsPair = vectS (S Z) ℕ
