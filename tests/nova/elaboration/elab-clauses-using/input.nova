-- `using` on a signature with defining equations scopes every item of
-- the expansion; a clause's own `using` adds to its equation lemma's
-- scope alone (docs/NovaElaboration.txt, Defining equations — SCOPES).
plus : ℕ → ℕ → ℕ
plus Z n = n
plus (S m) n = S (plus m n)

-- successor in the second argument, by induction on the first
sucPlusR : (n m : ℕ) → plus n (S m) ≡ S (plus n m) using (plus.eq)
sucPlusR = λn. λm. ℕ-elim ⋆ (k ih. ⋆) n

-- the WITNESS tier: each clause's equation is a rewrite or two away
-- from the witness's computation. Named at the signature, the lemmas
-- reach the clause lemmas AND the uniqueness proof: accepted outright
dbl : ℕ → ℕ using (plusZ, plusS.rw, sucPlusR.rw)
dbl = λn. plus n n
dbl Z = Z
dbl (S m) = S (S (dbl m))

useDblS : (m : ℕ) → dbl (S m) ≡ S (S (dbl m)) using (dblS)
useDblS = λm. ⋆

-- named at the CLAUSES, the lemmas close each clause lemma and reach
-- nothing else: the uniqueness proof never sees plusZ or sucPlusR —
-- it closes through the clause lemmas dbl'Z and dbl'S themselves,
-- which are in the store once accepted
dbl' : ℕ → ℕ
dbl' = λn. plus n n
dbl' Z using (plusZ) = Z
dbl' (S m) using (plusS.rw, sucPlusR.rw) = S (S (dbl' m))
