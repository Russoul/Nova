-- `using` on a signature with defining equations scopes every item of
-- the expansion; a clause's own `using` adds to its equation lemma's
-- scope alone (docs/NovaElaboration.txt, Defining equations — SCOPES).
plus : ℕ → ℕ → ℕ
plus Z n = n
plus (S m) n = S (plus m n)

-- successor in the second argument, by induction on the first
sucPlusR : (n m : ℕ) → plus n (S m) ≡ S (plus n m) using (plus.eq)
sucPlusR = λn. λm. ℕ-elim ⋆ (k ih. ⋆) n

-- the WITNESS tier: each clause's equation is the witness's
-- computation under the licences. Named at the signature, the licence
-- reaches the clause lemmas AND the uniqueness proof: accepted outright
dbl : ℕ → ℕ using (plus.eq)
dbl = λn. plus n n
dbl Z = Z
dbl (S m) = S (plus m (S m))

useDblS : (m : ℕ) → dbl (S m) ≡ S (plus m (S m))
useDblS = λm. dblS m

-- named at the CLAUSES, the licence reaches each clause lemma and
-- nothing else: the uniqueness proof never unfolds plus — it closes
-- through the clause lemmas dbl'Z and dbl'S themselves, facts in
-- scope once accepted
dbl' : ℕ → ℕ
dbl' = λn. plus n n
dbl' Z  using (plus.eq) = Z
dbl' (S m)  using (plus.eq) = S (plus m (S m))
