plus : ℕ → ℕ → ℕ
plus = λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
plusZr : (n : ℕ) → plus n Z ≡ n ∈ ℕ using (plus.eq)
plusZr = λn. ⋆
zeroPlusId : (n : ℕ) → plus Z n ≡ n ∈ ℕ using (plus.eq)
zeroPlusId = λn. ℕ-elim (k. plus Z k ≡ k ∈ ℕ) ⋆ (k ih. ⋆) n
-- discharged by the prepended lemmas, NAMED at the sites (the
-- searchless default: store use is spelled, never searched)
uses : (n : ℕ) → plus n Z ≡ plus Z n ∈ ℕ
uses =
  λn. (plus n Z ≡⟨ plusZr n ⟩ n ≡⟨ zeroPlusId n ⟩ plus Z n)
