-- sum clause: conat, the classic ∞ = ∞ + 1
conat : 𝕌
conat = ν (K 𝟙 ⊎ 𝕏)
cinf : conat using (conat.unfold)
cinf = corec (s : 𝟙. inj₂ s) ()
csucc : conat → conat using (conat.unfold)
csucc =
  λn. corec (p : 𝟙 ⊎ conat. inj₂ (⊎-elim (w. 𝟙 ⊎ conat) (u. inj₁ u) (m. out m) p)) (out n)
infSucc : cinf ≡ csucc cinf ∈ conat using (hyp.rw, conat.unfold, conat.eq, cinf.eq, csucc.eq)
infSucc =
  coind (x y. ∥(x ≡ cinf ∈ conat) × (y ≡ csucc cinf ∈ conat)∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆))))

-- exponent clause: Moore machines, constant machines over two carriers
moore : 𝕌
moore = ν (K ℕ × ((i : ℕ) → 𝕏))
m1 : moore using (moore.unfold)
m1 = corec (s : 𝟙. (Z , λi. s)) ()
m2 : moore using (moore.unfold)
m2 = corec (s : ℕ. (Z , λi. s)) Z
mEq : m1 ≡ m2 ∈ moore using (hyp.rw, moore.unfold, moore.eq, m1.eq, m2.eq)
mEq =
  coind (x y. ∥(x ≡ m1 ∈ moore) × (y ≡ m2 ∈ moore)∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ (λi. ⋆ ((⋆ , ⋆)))))))

-- dependent-pair clause: a binder polynomial
dep : 𝕌
dep = ν ((n : ℕ) × 𝕏)
d1 : dep using (dep.unfold)
d1 = corec (s : 𝟙. (Z , s)) ()
d2 : dep using (dep.unfold)
d2 = corec (s : ℕ. (Z , s)) Z
dEq : d1 ≡ d2 ∈ dep using (hyp.rw, dep.unfold, dep.eq, d1.eq, d2.eq)
dEq =
  coind (x y. ∥(x ≡ d1 ∈ dep) × (y ≡ d2 ∈ dep)∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ ((⋆ , ⋆))))))
