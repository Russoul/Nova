-- sum clause: conat, the classic ∞ = ∞ + 1
def conat : 𝕌 ≔ ν (K 𝟙 ⊎ 𝕏)
def cinf : conat using (conat.unfold) ≔ corec (s : 𝟙. inj₂ (inj₂ s)) ()
def csucc : conat → conat using (conat.unfold) ≔
  λn. corec (p : 𝟙 ⊎ conat. inj₂ (inj₂ (⊎-elim (w. 𝟙 ⊎ conat) (u. inj₁ u) (m. out m) p))) (out n)
def infSucc : cinf ≡ csucc cinf ∈ conat using (hyp.rw, conat.unfold, conat.eq, cinf.eq, csucc.eq) ≔
  coind (x y. ∥(x ≡ cinf ∈ conat) × (y ≡ csucc cinf ∈ conat)∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((inj₁ (⋆ ((⋆ , ⋆)))))))

-- exponent clause: Moore machines, constant machines over two carriers
def moore : 𝕌 ≔ ν (K ℕ × ((i : ℕ) → 𝕏))
def m1 : moore using (moore.unfold) ≔ corec (s : 𝟙. (Z , λi. inj₂ s)) ()
def m2 : moore using (moore.unfold) ≔ corec (s : ℕ. (Z , λi. inj₂ s)) Z
def mEq : m1 ≡ m2 ∈ moore using (hyp.rw, moore.unfold, moore.eq, m1.eq, m2.eq) ≔
  coind (x y. ∥(x ≡ m1 ∈ moore) × (y ≡ m2 ∈ moore)∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ (λi. ⋆ ((inj₁ (⋆ ((⋆ , ⋆))))))))))

-- dependent-pair clause: a binder polynomial
def dep : 𝕌 ≔ ν ((n : ℕ) × 𝕏)
def d1 : dep using (dep.unfold) ≔ corec (s : 𝟙. (Z , inj₂ s)) ()
def d2 : dep using (dep.unfold) ≔ corec (s : ℕ. (Z , inj₂ s)) Z
def dEq : d1 ≡ d2 ∈ dep using (hyp.rw, dep.unfold, dep.eq, d1.eq, d2.eq) ≔
  coind (x y. ∥(x ≡ d1 ∈ dep) × (y ≡ d2 ∈ dep)∥)
        (⋆ ((⋆ , ⋆)))
        (x y h. squash-elim h (w. ⋆ ((⋆ , ⋆ ((inj₁ (⋆ ((⋆ , ⋆)))))))))
