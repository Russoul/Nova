def plus : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
-- a solvable hole pinned by its equation: the decl→def flip
-- (kernel-checked against the prefix), then discharge by beta
def solved : S _m ≡ S (S Z) ∈ ℕ ≔ ⋆
-- the solution is a real definition: it unfolds downstream
def uses : plus _m Z ≡ S Z ∈ ℕ ≔ ⋆
-- a solvable TYPE hole pinned through a coercion site
def x : _T ≔ Z
def y : ℕ ≔ x
-- within one item: the first conjunct's equation is assumed (stuck
-- eliminator, not a pattern), the second solves the hole, item-end
-- deletion clears the first, and the item is kernel-admitted
def d : (plus Z _k ≡ S Z ∈ ℕ) ⨯ (_k ≡ S Z ∈ ℕ) ≔ ⋆ , ⋆
