two : ℕ
two = 2
id2 : {A : 𝕌} (a : A) → A
id2 = λA. λa. a
useId : ℕ
useId = id2 two
useOverride : ℕ
useOverride = id2 {ℕ} two
constF : ℕ → ℕ
constF = id2 (λx. x)
sym2 : {A : 𝕌} {a b : A} → (a ≡ b ∈ A) → b ≡ a ∈ A
sym2 = λA. λa. λb. λh. ⋆
flip2 : (C : 𝕌) (x y : C) → (x ≡ y ∈ C) → y ≡ x ∈ C
flip2 =
  λC. λx. λy. λh. sym2 h
flipFlip : (C : 𝕌) (x y : C) → (x ≡ y ∈ C) → x ≡ y ∈ C
flipFlip =
  λC. λx. λy. λh. sym2 (sym2 h)
allImp : {A : 𝕌} {a : A} → a ≡ a ∈ A
allImp = λA. λa. ⋆
useAllImp : two ≡ two ∈ ℕ
useAllImp = allImp
useIns : 2 ≡ 2 ∈ ℕ
useIns = (allImp : 2 ≡ 2 ∈ ℕ)
takeFn : (f : (A : 𝕌) → (a : A) → a ≡ a ∈ A) → 1 ≡ 1 ∈ ℕ
takeFn = λf. f ℕ 1
passFn : 1 ≡ 1 ∈ ℕ
passFn = takeFn (allImp {})
