def two : ℕ ≔ 2
def id2 : {A : 𝕌} (a : El A) → El A ≔ λA. λa. a
def useId : ℕ ≔ id2 two
def useOverride : ℕ ≔ id2 {ℕ} two
def constF : ℕ → ℕ ≔ id2 (λx. x)
def sym2 : {A : 𝕌} {a b : El A} → (a ≡ b ∈ El A) → b ≡ a ∈ El A ≔ λA. λa. λb. λh. ⋆
def flip2 : (C : 𝕌) (x y : El C) → (x ≡ y ∈ El C) → y ≡ x ∈ El C ≔
  λC. λx. λy. λh. sym2 h
def flipFlip : (C : 𝕌) (x y : El C) → (x ≡ y ∈ El C) → x ≡ y ∈ El C ≔
  λC. λx. λy. λh. sym2 (sym2 h)
def allImp : {A : 𝕌} {a : El A} → a ≡ a ∈ El A ≔ λA. λa. ⋆
def useAllImp : two ≡ two ∈ ℕ ≔ allImp
def useIns : 2 ≡ 2 ∈ ℕ ≔ (allImp : 2 ≡ 2 ∈ ℕ)
def takeFn : (f : (A : 𝕌) → (a : El A) → a ≡ a ∈ El A) → 1 ≡ 1 ∈ ℕ ≔ λf. f ℕ 1
def passFn : 1 ≡ 1 ∈ ℕ ≔ takeFn (allImp {})
