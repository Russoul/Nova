-- an APPLIED no-insert head — `f {} a b …` — is positional
-- application over the FULL telescope: insertion off, every
-- position explicit, blanks legal anywhere (the manual
-- implicitization form)

cst : {A : 𝕌} (a : A) {B : 𝕌} (b : B) → A
cst = λA. λa. λB. λb. a

use : ℕ → 𝟙 → ℕ
use = λn. λu. cst {} _ n _ u

-- and blanks still solve from later positional arguments
use2 : ℕ → 𝟙 → ℕ
use2 = λn. λu. cst {} ℕ n _ u
