-- distill golden: a code standing as a type is printed by the ONE term
-- printer, at the level its position parses at — spine steps
-- (arguments, implicit overrides, the no-insert marker, projections)
-- and infix applications all stand bare, because a type position is
-- an ordinary element position (THE TERM GRAMMAR MERGE)

infixl 4 ≤

P : 𝕌 × 𝕌
P = ℕ , 𝟙

-- both written parenthesized; the spine reads them back bare
f : (P .π₁) → (P .π₁)
f = λx. x

Vec : {a : 𝕌} → ℕ → 𝕌
Vec = λa. λn. ℕ

g : (Vec {ℕ} 3) → ℕ using (Vec.eq)
g = λx. x

-- an operator application needs no parentheses either: with the type
-- and term grammars merged there is no level between them to lose
≤ : ℕ → ℕ → 𝕌
≤ = λa. λb. ℕ

h : (Z ≤ Z) → ℕ using (≤.eq)
h = λx. x
