-- distill golden: a CODE standing as a type is bracketed by the TYPE
-- grammar (T{2}), which reads an atom head with argument and
-- PROJECTION steps and nothing else. So the projection prints bare
-- and the implicit override keeps its parentheses — the parens are
-- what re-enters the element grammar, since `{` opens an implicit
-- BINDER group at that position

def P : 𝕌 × 𝕌 ≔ ℕ , 𝟙

-- written parenthesized; the projection spine reads it back bare
def f : (P .π₁) → (P .π₁) ≔ λx. x

def Vec : {a : 𝕌} → ℕ → 𝕌 ≔ λa. λn. ℕ

def g : (Vec {ℕ} 3) → ℕ using (Vec.eq) ≔ λx. x
