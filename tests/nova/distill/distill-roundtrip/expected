def + : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim x (n ih. S ih) y

def plusZeroId : (n : ℕ) → n + Z ≡ n using (+.eq) ≔ λn. ⋆

def plusSucId : (n m : ℕ) → n + S m ≡ S (n + m) using (+.eq) ≔ λn. λm. ⋆

def zeroPlusId : (n : ℕ) → Z + n ≡ n using (+.eq, plusZeroId) ≔ λn. ℕ-elim ⋆ (k ih. ⋆) n

def sucPlus : (n m : ℕ) → S n + m ≡ S (n + m) using (+.eq) ≔ λn. λm. ℕ-elim ⋆ (k ih. ⋆) m

def plusComm : (n m : ℕ) → m + n ≡ n + m ≔
  λn. λm. ℕ-elim
    (Z + n ≡⟨ zeroPlusId n ⟩ n ≡⟨ plusZeroId n ⟩ n + Z)
    (k ih. S k + n ≡⟨ sucPlus k n ⟩ S (k + n) ≡⟨ ih ⟩ S (n + k) ≡⟨ plusSucId n k ⟩ n + S k)
    m

def swapLeft : (a b c : ℕ) → a + (b + c) ≡ b + (a + c) using (plusComm) ≔
  λa. λb. λc. ℕ-elim
    (a + (b + Z) ≡⟨ plusZeroId b ⟩ a + b ≡⟨ plusComm b a ⟩ b + a ≡⟨ plusZeroId a ⟩ b + (a + Z))
    (k ih. ⋆ using (+.eq))
    c

