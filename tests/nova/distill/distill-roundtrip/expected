+ : ℕ → ℕ → ℕ
(+) = λx y. ℕ-elim x (n ih. S ih) y

plusZeroId : (n : ℕ) → n + Z ≡ n using (+.eq)
plusZeroId = λn. ⋆

plusSucId : (n m : ℕ) → n + S m ≡ S (n + m) using (+.eq)
plusSucId = λn m. ⋆

zeroPlusId : (n : ℕ) → Z + n ≡ n using (+.eq, plusZeroId)
zeroPlusId = λn. ℕ-elim ⋆ (k ih. ⋆) n

sucPlus : (n m : ℕ) → S n + m ≡ S (n + m) using (+.eq)
sucPlus = λn m. ℕ-elim ⋆ (k ih. ⋆) m

plusComm : (n m : ℕ) → m + n ≡ n + m
plusComm =
  λn m. ℕ-elim
    Z + n ≡⟨ zeroPlusId n ⟩ n ≡⟨ plusZeroId n ⟩ n + Z
    k ih. S k + n ≡⟨ sucPlus k n ⟩ S (k + n) ≡⟨ ih ⟩ S (n + k) ≡⟨ plusSucId n k ⟩ n + S k
    m

swapLeft : (a b c : ℕ) → a + (b + c) ≡ b + (a + c) using (plusComm)
swapLeft =
  λa b c. ℕ-elim
    a + (b + Z) ≡⟨ plusZeroId b ⟩ a + b ≡⟨ plusComm b a ⟩ b + a ≡⟨ plusZeroId a ⟩ b + (a + Z)
    k ih. ⋆ using (+.eq)
    c

