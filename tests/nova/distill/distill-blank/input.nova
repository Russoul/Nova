-- distill golden: blank EMISSION — recoverable explicit arguments
-- print as `_`, verified as one joint per-spine recovery, iterated
-- to the corpus fixpoint

trans3 : (A : 𝕌) (x y z : A) → (x ≡ y) → (y ≡ z) → x ≡ z
trans3 = λA. λx. λy. λz. λp. λq. x ≡⟨ p ⟩ y ≡⟨ q ⟩ z

useTrans : (A : 𝕌) (a b c : A) → (a ≡ b) → (b ≡ c) → a ≡ c
useTrans = λA. λa. λb. λc. λp. λq. trans3 A a b c p q

cst : (A B : 𝕌) → A → B → A
cst = λA. λB. λa. λb. a

-- both indices recover from the written arguments' inferred types;
-- the data arguments n and u themselves stay written
useCst : ℕ → 𝟙 → ℕ
useCst = λn. λu. cst ℕ 𝟙 n u
