-- survey golden: sym-style lemma (indices recoverable from the proof
-- argument), a data-carrying binder that must stay explicit, and a
-- checking-position use recoverable from the expected type
id2 : (A : 𝕌) (a : A) → A
id2 = λA. λa. a
use : (B : 𝕌) (b : B) → B
use = λB. λb. id2 B b
sym2 : (A : 𝕌) (a b : A) → (a ≡ b ∈ A) → b ≡ a ∈ A
sym2 = λA. λa. λb. λh. ⋆
refl2 : (A : 𝕌) (a : A) → a ≡ a ∈ A
refl2 = λA. λa. ⋆
useSym : (C : 𝕌) (x y : C) → (x ≡ y ∈ C) → x ≡ y ∈ C
useSym =
  λC. λx. λy. λh. sym2 C y x (sym2 C x y h)
