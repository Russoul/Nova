#!/bin/sh
"$1" eliminate input.nova 9:9 n --name k --name rec | sed -n "9p"
"$1" eliminate input.nova 9:9 n --label base --label step | sed -n "9p"
"$1" eliminate input.nova 13:9 x --name fst --name snd | sed -n "13,15p"
echo "--- a safe rename of the closed hypothesis:"
"$1" eliminate input.nova 19:17 n --name "" --name "" --name hyp | sed -n "19,22p"
echo "--- and one that would capture:"
"$1" eliminate input.nova 19:17 n --name "" --name "" --name m
echo "--- a name that is not in the context:"
"$1" eliminate input.nova 13:9 nosuch
echo "--- a variable with no eliminator and no equation:"
"$1" eliminate input.nova 24:9 g
