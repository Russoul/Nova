-- A hypothesis AFTER the variable depends on it, so it joins the
-- dependency-closed suffix: the motive Π-closes it, each branch
-- λ-abstracts it, the result is re-applied. `k` depends on nothing
-- and stays where it is. The IH is then a FUNCTION over what the
-- motive closed.
def P : ℕ → 𝕌 ≔ λn. ℕ

def dep : (n : ℕ) → (h : P n) → (k : ℕ) → P n ≔ λn. λh. λk. ((ℕ-elim (n. (h : (P n)) → (P n))
                                                             (λh. ?goalZ)
                                                             (n ih. λh. ?goalS)
                                                             n) h)

-- re-applying the closure makes an APPLICATION, and a hole is an
-- ATOM, so the whole thing takes one more pair of parentheses — here
-- the hole sits in an argument position, where a bare re-application
-- would re-associate into the enclosing spine
def use : (f : ℕ → ℕ) → (n : ℕ) → (h : P n) → ℕ ≔ λf. λn. λh. f ?arg
