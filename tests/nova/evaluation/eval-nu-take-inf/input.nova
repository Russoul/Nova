-- take from an INFINITE colist: the naturals as an always-cons
-- colist; three observations, no padding path taken
clist : 𝕌
clist = ν (K 𝟙 ⊎ (K ℕ × 𝕏))
cnil : clist using (clist.unfold)
cnil = corec (s : 𝟙. inj₁ s) ()
cnats : clist using (clist.unfold)
cnats = corec (s : ℕ. inj₂ (s , S s)) Z
vecc : ℕ → 𝕌
vecc = λn. ℕ-elim (m. 𝕌) 𝟙 (m ih. ℕ × ih) n
take : (n : ℕ) → clist → (vecc n) using (clist.unfold, vecc.unfold, vecc.eq)
take =
  λn. ℕ-elim (m. clist → (vecc m)) (λt. ())
        (m ih. λt. ⊎-elim (w. (vecc (S m))) (u. (Z , ih cnil)) (q. ((q .π₁) , ih (q .π₂))) (out t))
        n
val : (vecc (S (S (S Z)))) using (vecc.unfold)
val = take (S (S (S Z))) cnats
