-- take the first N elements of a COLIST, padding with Z past its
-- end: ℕ-elim drives N observations (one el-nu-beta each, through
-- ⊎-elim on the colist's step), the result a nested pair at an
-- ℕ-elim-defined vector code
def clist : 𝕌 ≔ ν (K 𝟙 ⊎ (K ℕ × 𝕏))
def cnil : clist using (clist.unfold) ≔ corec (s : 𝟙. inj₁ s) ()
-- ccons as a ONE-STOP machine: emit the stored head, stop at the
-- stored tail (primitive corecursion releases it bare)
def ccons : ℕ → clist → clist using (clist.unfold) ≔
  λx. λt. corec (u : 𝟙. inj₂ (x , inj₁ t)) ()
def vecc : ℕ → 𝕌 ≔ λn. ℕ-elim (m. 𝕌) 𝟙 (m ih. ℕ × ih) n
def take : (n : ℕ) → clist → (vecc n) using (clist.unfold, vecc.unfold, vecc.eq) ≔
  λn. ℕ-elim (m. clist → (vecc m)) (λt. ())
        (m ih. λt. ⊎-elim (w. (vecc (S m))) (u. (Z , ih cnil)) (q. ((q .π₁) , ih (q .π₂))) (out t))
        n
-- [1, 2] taken to depth 4: two elements, then two Z-pads
def val : (vecc (S (S (S (S Z))))) using (vecc.unfold) ≔
  take (S (S (S (S Z)))) (ccons (S Z) (ccons (S (S Z)) cnil))
