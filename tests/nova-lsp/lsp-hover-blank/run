#!/bin/sh
# hovering a blank shows the recovered value in def shape plus the
# SOURCE that bound it: the expected type, or a written argument's
# inferred type. The first hover's content carries a
# supplementary-plane 𝕌 — the surrogate-pair path
DIR="$(cd "$(dirname "$0")" && pwd)"
"$1" lsp "$NOVA_LSP_BIN" "$DIR/fixture.nova" "_ _ n u"
"$1" lsp "$NOVA_LSP_BIN" "$DIR/fixture.nova" "_ n u"
"$1" lsp "$NOVA_LSP_BIN" "$DIR/fixture.nova" "_ _ p q"
