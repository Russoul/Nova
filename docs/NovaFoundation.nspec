--------------------------------------- (qtm-sub-var-wk)
Γ ; Φ ▷ 𝔄 ⊦ ⬡ᵢ[⇑] ≐ ⬡ᵢ₊₁ : (Φ‖ᵢ)[⇑]

Γ ⊦ ς : Φ₀ ⇒ Φ₁      Γ ; Φ₀ ⊦ 𝕥 : 𝔄[ς]
---------------------------------------- (qtm-sub-var-hit)
Γ ; Φ₀ ⊦ ⬡₀[ς, 𝕥] ≐ 𝕥 : 𝔄[ς]

Γ ⊦ ς : Φ₀ ⇒ Φ₁      Γ ; Φ₀ ⊦ 𝕥 : 𝔄[ς]      Γ ; Φ₁ ⊦ ⬡ᵢ : 𝔅
----------------------------------------------------------- (qtm-sub-var-miss)
Γ ; Φ₀ ⊦ ⬡ᵢ₊₁[ς, 𝕥] ≐ ⬡ᵢ[ς] : 𝔅[ς]

Γ ; Φ₂ ⊦ ⬡ᵢ : 𝔄      Γ ⊦ τ : Φ₁ ⇒ Φ₂      Γ ⊦ ς : Φ₀ ⇒ Φ₁
---------------------------------------------------------- (qtm-sub-var-comp)
Γ ; Φ₀ ⊦ ⬡ᵢ[τ ∘ ς] ≐ ⬡ᵢ[τ][ς] : 𝔄[τ][ς]

Γ ; Φ₁ ⊦ 𝕥 : A ⇛ 𝔄      Γ ⊦ t : A      Γ ⊦ ς : Φ₀ ⇒ Φ₁
------------------------------------------------------- (qtm-sub-app-ext)
Γ ; Φ₀ ⊦ (𝕥 t)[ς] ≐ 𝕥[ς] t : 𝔄[id, t][ς]

Γ ; Φ₁ ⊦ 𝕥 : El 𝕦 ⇛ 𝔄      Γ ; Φ₁ ⊦ 𝕥′ : El 𝕦      Γ ⊦ ς : Φ₀ ⇒ Φ₁
------------------------------------------------------------------ (qtm-sub-app-ind)
Γ ; Φ₀ ⊦ (𝕥 𝕥′)[ς] ≐ 𝕥[ς] 𝕥′[ς] : 𝔄[𝕚𝕕, 𝕥′][ς]

Γ ▷ A ; Φ₁[↑] ⊦ 𝕥 : 𝔄      Γ ⊦ ς : Φ₀ ⇒ Φ₁
---------------------------------------------- (qtm-sub-lam-ext)
Γ ; Φ₀ ⊦ (λ 𝕥)[ς] ≐ λ (𝕥[ς[↑]]) : A ⇛ 𝔄[ς[↑]]

Γ ; Φ₁ ⊦ 𝕥₀ : El 𝕦      Γ ; Φ₁ ⊦ 𝕥₁ : El 𝕦      Γ ⊦ ς : Φ₀ ⇒ Φ₁
---------------------------------------------------------------- (qtm-sub-eq)
Γ ; Φ₀ ⊦ (𝕥₀ ≡ 𝕥₁)[ς] ≐ 𝕥₀[ς] ≡ 𝕥₁[ς] : U

### Nova substitution

// σ through ToS syntax (-nsub).

Γ ⊦ Φ qctx      σ : Θ ⇒ Γ
-------------------------- (qctx-nsub)
