package nova-tests
version = 0.1.0

depends = contrib, just-a-parser, test, lsp-lib

modules = Nova.Kernel.Syntax
        , Nova.Kernel.Subst
        , Nova.Kernel
        , Nova.Kernel.QIIT
        , Nova.Kernel.Dormant.Beta
        , Nova.Kernel.Dormant.Derivation
        , Nova.Kernel.Dormant.Tests
        , Nova.Compute
        , Nova.Elaboration.Beta
        , Nova.Elaboration.Named
        , Nova.Kernel.Parser
        , Nova.Elaboration
        , Nova.Elaboration.Surface
        , Nova.Elaboration.Clauses
        , Nova.Elaboration.Parser
        , Nova.Elaboration.Loader
        , Nova.Distill
        , Nova.Recovery
        , Nova.Implicitize

        , Nova.LSP.TestClient

sourcedir = "src/idris"

main = Nova.Test
executable = nova-tests
