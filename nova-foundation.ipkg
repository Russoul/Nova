package nova-foundation
version = 0.1.0

depends = contrib, just-a-parser

executable = nova-foundation-app
main = Nova.Foundation.Application

modules = Nova.Foundation.Syntax
        , Nova.Foundation.Subst
        , Nova.Foundation.Beta
        , Nova.Foundation.Derivation
        , Nova.Foundation.Elaboration
        , Nova.Foundation.Elaboration.Surface
        , Nova.Foundation.Elaboration.Parser
        , Nova.Foundation.Parser
        , Nova.Foundation.Derivation.Parser
        , Nova.Foundation.Derivation.NamedParser
        , Nova.Foundation.Derivation.NamedPretty
        , Nova.Foundation.Derivation.NamedRejectionPretty
        , Nova.Foundation.Pretty
        , Nova.Foundation.Rejection.Pretty
        , Nova.Foundation.Session
        , Nova.Foundation.Application

        , Solver.CommutativeMonoid
        , Solver.CommutativeMonoid.Evaluation
        , Solver.CommutativeMonoid.Language
        , Solver.CommutativeMonoid.Normalisation
        , Solver.CommutativeMonoid.Parser
        , Solver.CommutativeMonoid.Quotation
        , Solver.CommutativeMonoid.Value

        , Data.Util

        , Control.Monad.EitherSt
        , Control.Monad.IOEither
        , Control.Monad.Id
        , Control.Monad.MaybeSt
        , Control.Monad.Reader
        , Control.Monad.St
        , Control.Monad.StEither

sourcedir = "src/idris"
