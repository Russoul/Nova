- ctx-emp
- ty-nat ε ⊦ ℕ
- ctx-ext ε ᐅ n:ℕ
- ctx-ext ε ᐅ n:ℕ ᐅ m:ℕ
- ty-one ε ᐅ n:ℕ ᐅ m:ℕ ⊦ 𝟙
- ty-quotient ε ⊦ ℕ / (n x. 𝟙)
- el-zero ε ⊦ Z
- el-class ε ⊦ class Z : ℕ / (n x. 𝟙)
- el-suc ε ⊦ S Z
- el-one ε ⊦ ()
- el-quot-eq ε ⊦ class Z ≐ class (S Z) : ℕ / (n x. 𝟙) via ()
- ctx-ext ε ᐅ x:ℕ / (n x. 𝟙)
- ctx-ext ε ᐅ n:ℕ ᐅ m:ℕ ᐅ x:𝟙
- el-quot-elim ε ⊦ quot-elim (_. Z) (class Z : ℕ / (n x. 𝟙)) motive (x. ℕ)
