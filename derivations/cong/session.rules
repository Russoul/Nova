- ctx C2 ≔ ε ᐅ A:𝕌 ᐅ x:El A → 𝕌 ᐅ y:(v:El A) → El (x v) ᐅ v:El A ᐅ w:El A
- ctx C3 ≔ C2 ᐅ z:v ≡ w ∈ El A
- el-reflect C3 ⊦ z : (v ≡ w ∈ El A) reflect
- el-app-cong C3 ⊦ (y ≐ y : (u:El A) → El (x u)) v ≐ w
- el-app-cong C3 ⊦ (x ≐ x : El A → 𝕌) v ≐ w
- ty-el-cong C3 ⊦ El (x v) ≐ El (x w)
- el-ty-coe-eq C3 ⊦ y v ≐ y v : El (x v) ↝ El (x w)
- ty-eq-cong C3 ⊦ y v ≡ y v ∈ El (x v) ≐ y v ≡ y w ∈ El (x w)
- el-ty-coe C3 ⊦ Refl : y v ≡ y v ∈ El (x v) ↝ y v ≡ y w ∈ El (x w)
- el-pi-i C2 ⊦ λz. Refl : (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- el-pi-i ε ᐅ A:𝕌 ᐅ x:El A → 𝕌 ᐅ y:(v:El A) → El (x v) ᐅ v:El A ⊦ λz. (λw. Refl) : (w:El A) → (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- el-pi-i ε ᐅ A:𝕌 ᐅ x:El A → 𝕌 ᐅ y:(v:El A) → El (x v) ⊦ λz. (λw. (λv. Refl)) : (v:El A) → (w:El A) → (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- el-pi-i ε ᐅ A:𝕌 ᐅ x:El A → 𝕌 ⊦ λy. (λz. (λw. (λv. Refl))) : (y:(v:El A) → El (x v)) → (v:El A) → (w:El A) → (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- el-pi-i ε ᐅ A:𝕌 ⊦ λx. (λy. (λz. (λw. (λv. Refl)))) : (x:El A → 𝕌) → (y:(v:El A) → El (x v)) → (v:El A) → (w:El A) → (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- el-pi-i ε ⊦ λx. (λy. (λz. (λw. (λv. (λx1. Refl))))) : (A:𝕌) → (x:El A → 𝕌) → (y:(v:El A) → El (x v)) → (v:El A) → (w:El A) → (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- sig ε ⊦ cong ≔ λx. (λy. (λz. (λw. (λv. (λx1. Refl))))) : (A:𝕌) → (x:El A → 𝕌) → (y:(v:El A) → El (x v)) → (v:El A) → (w:El A) → (v ≡ w ∈ El A) → (y v ≡ y w ∈ El (x w))
- sig-var ε ⊦ cong[]
