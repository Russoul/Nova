depends: plus, vect
- ctx C1 ≔ ε ᐅ n:ℕ ᐅ A:𝕌 ᐅ m:ℕ ᐅ k:ℕ
- ctx C2 ≔ ε ᐅ A:𝕌 ᐅ n:ℕ ᐅ v:El (vect[] Z A)
- ctx C3 ≔ ε ᐅ n:ℕ ᐅ A:𝕌 ᐅ m:ℕ ᐅ v:El (vect[] Z A)
- ctx C4 ≔ ε ᐅ n:ℕ ᐅ A:𝕌 ᐅ m:ℕ ᐅ v:El (vect[] (S n) A)
- ctx C5 ≔ C2 ᐅ w:El (vect[] n A)
- ctx C6 ≔ C3 ᐅ w:El (vect[] m A)
- ctx C7 ≔ C4 ᐅ w:El (vect[] m A)
- ctx C9 ≔ C1 ᐅ x:El (vect[] k A) → El (vect[] m A) → El (vect[] (plus[] k m) A)
- ctx C10 ≔ C9 ᐅ v:El (vect[] (S k) A) ᐅ w:El (vect[] m A)
- el-reflect C6 ⊦ zeroPlusId[m] : (plus[] Z m ≡ m ∈ ℕ) reflect
- el-app-cong C6 ⊦ (vect[] ≐ vect[] : ℕ → 𝕌 → 𝕌) (plus[] Z m) ≐ m
- el-app-cong C6 ⊦ (vect[] (plus[] Z m) ≐ vect[] m : 𝕌 → 𝕌) A ≐ A
- ty-el-cong C6 ⊦ El (vect[] (plus[] Z m) A) ≐ El (vect[] m A)
- el-ty-coe C6 ⊦ w : El (vect[] m A) ↝ El (vect[] (plus[] Z m) A)
- el-pi-i C3 ⊦ λx. x : El (vect[] m A) → El (vect[] (plus[] Z m) A)
- el-pi-i ε ᐅ n:ℕ ᐅ A:𝕌 ᐅ m:ℕ ⊦ λx. (λy. y) : El (vect[] Z A) → El (vect[] m A) → El (vect[] (plus[] Z m) A)
- el-pi-e C1 ⊦ vect[] k A
- el-pi-e C1 ⊦ vect[] m A
- el-pi-e C1 ⊦ vect[] (plus[] k m) A
- el-reflect C10 ⊦ sucPlus[k, m] : (plus[] (S k) m ≡ S (plus[] k m) ∈ ℕ) reflect
- el-app-cong C10 ⊦ (vect[] ≐ vect[] : ℕ → 𝕌 → 𝕌) (plus[] (S k) m) ≐ (S (plus[] k m))
- el-app-cong C10 ⊦ (vect[] (plus[] (S k) m) ≐ vect[] (S (plus[] k m)) : 𝕌 → 𝕌) A ≐ A
- ty-el-cong C10 ⊦ El (vect[] (plus[] (S k) m) A) ≐ El (vect[] (S (plus[] k m)) A)
- el-ty-coe C10 ⊦ v .π₁, x (v .π₂) w : El A ⨯ El (vect[] (plus[] k m) A) ↝ El (vect[] (plus[] (S k) m) A)
- el-pi-i C9 ᐅ v:El (vect[] (S k) A) ⊦ λy. (v .π₁, x (v .π₂) y) : El (vect[] m A) → El (vect[] (plus[] (S k) m) A)
- el-pi-i C9 ⊦ λy. (λz. (y .π₁, x (y .π₂) z)) : El (vect[] (S k) A) → El (vect[] m A) → El (vect[] (plus[] (S k) m) A)
- el-nat-e ε ᐅ n:ℕ ᐅ A:𝕌 ᐅ m:ℕ ⊦ ℕ-elim (λx. (λy. y)) (k ih. (λx. (λy. (x .π₁, ih (x .π₂) y)))) n motive (k ih. El (vect[] k A) → El (vect[] m A) → El (vect[] (plus[] k m) A))
- el-pi-i ε ᐅ n:ℕ ᐅ A:𝕌 ⊦ λx. (ℕ-elim (λy. (λz. z)) (m ih. (λy. (λz. (y .π₁, ih (y .π₂) z)))) n) : (m:ℕ) → El (vect[] n A) → El (vect[] m A) → El (vect[] (plus[] n m) A)
- el-pi-i ε ᐅ n:ℕ ⊦ λx. (λy. (ℕ-elim (λz. (λw. w)) (m ih. (λz. (λw. (z .π₁, ih (z .π₂) w)))) n)) : (A:𝕌) → (m:ℕ) → El (vect[] n A) → El (vect[] m A) → El (vect[] (plus[] n m) A)
- el-pi-i ε ⊦ λx. (λy. (λz. (ℕ-elim (λw. (λv. v)) (n ih. (λw. (λv. (w .π₁, ih (w .π₂) v)))) x))) : (n:ℕ) → (A:𝕌) → (m:ℕ) → El (vect[] n A) → El (vect[] m A) → El (vect[] (plus[] n m) A)
- sig ε ⊦ vappend ≔ λx. (λy. (λz. (ℕ-elim (λw. (λv. v)) (n ih. (λw. (λv. (w .π₁, ih (w .π₂) v)))) x))) : (n:ℕ) → (A:𝕌) → (m:ℕ) → El (vect[] n A) → El (vect[] m A) → El (vect[] (plus[] n m) A)
- el-pi-e C2 ⊦ vect[] n A
- el-reflect C5 ⊦ zeroPlusId[n] : (plus[] Z n ≡ n ∈ ℕ) reflect
- el-app-cong C5 ⊦ (vect[] ≐ vect[] : ℕ → 𝕌 → 𝕌) (plus[] Z n) ≐ n
- el-app-cong C5 ⊦ (vect[] (plus[] Z n) ≐ vect[] n : 𝕌 → 𝕌) A ≐ A
- ty-el-cong C5 ⊦ El (vect[] (plus[] Z n) A) ≐ El (vect[] n A)
- el-ty-coe C5 ⊦ vappend[] Z A n v w : El (vect[] (plus[] Z n) A) ↝ El (vect[] n A)
- sig C5 ⊦ vappendZ ≔ Refl : vappend[] Z A n v w ≡ w ∈ El (vect[] n A)
- el-pi-e C4 ⊦ vect[] m A
- el-sigma-i C7 ⊦ v .π₁, vappend[] n A m (v .π₂) w : El A ⨯ El (vect[] (plus[] n m) A)
- el-refl C7 ⊦ Refl : (vappend[] (S n) A m v w) ∈ El (vect[] (plus[] (S n) m) A)
- el-reflect C7 ⊦ sucPlus[n, m] : (plus[] (S n) m ≡ S (plus[] n m) ∈ ℕ) reflect
- el-app-cong C7 ⊦ (vect[] ≐ vect[] : ℕ → 𝕌 → 𝕌) (plus[] (S n) m) ≐ (S (plus[] n m))
- el-app-cong C7 ⊦ (vect[] (plus[] (S n) m) ≐ vect[] (S (plus[] n m)) : 𝕌 → 𝕌) A ≐ A
- ty-el-cong C7 ⊦ El (vect[] (plus[] (S n) m) A) ≐ El (vect[] (S (plus[] n m)) A)
- el-ty-coe C7 ⊦ v .π₁, vappend[] n A m (v .π₂) w : El A ⨯ El (vect[] (plus[] n m) A) ↝ El (vect[] (plus[] (S n) m) A)
- sig C7 ⊦ vappendS ≔ Refl : vappend[] (S n) A m v w ≡ (v .π₁, vappend[] n A m (v .π₂) w) ∈ El (vect[] (plus[] (S n) m) A)
- sig-var ε ⊦ vappend[]
