-- Vector append, its computation laws, and the length arithmetic they
-- ride on. Restates derivations/vect-append.
def plus : ℕ → ℕ → ℕ ≔ λx. λy. ℕ-elim (n. ℕ) x (n ih. S ih) y
def plusZeroId (n : ℕ) : plus[] n Z ≡ n ∈ ℕ ≔ Refl
def zeroPlusId (n : ℕ) : plus[] Z n ≡ n ∈ ℕ ≔
  ℕ-elim (k. plus[] Z k ≡ k ∈ ℕ) Refl (k ih. Refl) n
def sucPlus (n : ℕ) (m : ℕ) : plus[] (S n) m ≡ S (plus[] n m) ∈ ℕ ≔
  ℕ-elim (k. plus[] (S n) k ≡ S (plus[] n k) ∈ ℕ) Refl (k ih. Refl) m

def vect : ℕ → 𝕌 → 𝕌 ≔ λx. λy. ℕ-elim (n. 𝕌) 𝟙 (n ih. y ⨯ ih) x

def vappend : (n : ℕ) → (A : 𝕌) → (m : ℕ) → El (vect[] n A) → El (vect[] m A) → El (vect[] (plus[] n m) A) ≔
  λn. λA. λm.
    ℕ-elim (k. El (vect[] k A) → El (vect[] m A) → El (vect[] (plus[] k m) A))
      (λv. λw. w)
      (k ih. λv. λw. (v .π₁ , ih (v .π₂) w))
      n

def vappendZ (A : 𝕌) (n : ℕ) (v : El (vect[] Z A)) (w : El (vect[] n A)) :
  vappend[] Z A n v w ≡ w ∈ El (vect[] n A) ≔ Refl
def vappendS (n : ℕ) (A : 𝕌) (m : ℕ) (v : El (vect[] (S n) A)) (w : El (vect[] m A)) :
  vappend[] (S n) A m v w ≡ (v .π₁ , vappend[] n A m (v .π₂) w) ∈ El (vect[] (plus[] (S n) m) A) ≔ Refl
